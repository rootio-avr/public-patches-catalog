+package com.rabbitmq.tools.jsonrpc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression test for CVE-2026-63337 (CWE-470, unsafe reflection).
+ *
+ * When a JSON-RPC service description declares an arbitrary Java class as its
+ * return type, ProcedureDescription must load that class WITHOUT initializing
+ * it (i.e. without running its static initializer). Initializing an
+ * attacker-controlled class name could trigger arbitrary code execution.
+ */
+public class Cve202663337RegressionTest {
+
+    /** Flag flipped by the static initializer of {@link SideEffect}. */
+    static volatile boolean INITIALIZED = false;
+
+    public static class SideEffect {
+        static {
+            INITIALIZED = true;
+        }
+    }
+
+    @Test
+    public void loadingReturnTypeClassMustNotInitializeIt() {
+        assertFalse(INITIALIZED, "precondition: SideEffect must not be initialized yet");
+
+        ProcedureDescription description = new ProcedureDescription();
+        description.setJavaReturnType(SideEffect.class.getName());
+
+        // The class is resolved for the declared return type ...
+        assertEquals(SideEffect.class, description.getReturnType());
+        // ... but its static initializer must NOT have run.
+        assertFalse(INITIALIZED,
+            "loading the return type class must not initialize it (CVE-2026-63337)");
+    }
+
+    @Test
+    public void primitiveReturnTypesStillResolve() {
+        ProcedureDescription description = new ProcedureDescription();
+        description.setJavaReturnType("int");
+        assertEquals(Integer.TYPE, description.getReturnType());
+    }
+}
