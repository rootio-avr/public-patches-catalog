+package com.rabbitmq.tools.jsonrpc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression test for CVE-2026-63337 (CWE-470).
+ *
+ * When resolving the Java return type of a JSON-RPC procedure,
+ * {@link ProcedureDescription} loads the class named by an externally-supplied
+ * {@code javaReturnType} string. Before the fix it used
+ * {@code Class.forName(name)}, which eagerly *initializes* the resolved class,
+ * running its static initializer. A caller able to influence the return-type
+ * name could therefore trigger arbitrary static-initializer code merely by
+ * loading a class descriptor.
+ *
+ * The fix loads the class with {@code initialize=false} using the current
+ * thread's context class loader, so the class is resolved but NOT initialized.
+ * This test asserts that resolving a return type does not run the target
+ * class's static initializer while still producing the correct Class object.
+ */
+public class Cve202663337RegressionTest {
+
+    /** Flag flipped by {@link SideEffect}'s static initializer. */
+    static volatile boolean sideEffectTriggered = false;
+
+    /** Helper whose static initializer records that it ran. */
+    static class SideEffect {
+        static {
+            sideEffectTriggered = true;
+        }
+    }
+
+    @Test
+    public void resolvingReturnTypeMustNotInitializeClass() {
+        sideEffectTriggered = false;
+
+        ProcedureDescription description = new ProcedureDescription();
+        description.setJavaReturnType(SideEffect.class.getName());
+
+        // The class is resolved to the correct type ...
+        assertEquals(SideEffect.class, description.getReturnType());
+        // ... but its static initializer must NOT have been executed.
+        assertFalse(
+            sideEffectTriggered,
+            "loading a JSON-RPC return type must not initialize the class (CVE-2026-63337)");
+    }
+
+    @Test
+    public void primitiveReturnTypesStillResolve() {
+        ProcedureDescription description = new ProcedureDescription();
+        description.setJavaReturnType("int");
+        assertEquals(Integer.TYPE, description.getReturnType());
+    }
+}
