+++ b/org.hl7.fhir.r5/src/test/java/org/hl7/fhir/r5/fhirpath/CVE202645367RegressionTest.java
@@ -0,0 +1,87 @@
+package org.hl7.fhir.r5.fhirpath;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.TimeoutException;
+import java.util.regex.Pattern;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Regression test for CVE-2026-45367 (CWE-1333, ReDoS in FHIRPathEngine regex functions).
+ *
+ * <p>The FHIRPath matches(), matchesFull() and replaceMatches() functions evaluate
+ * user-controlled regular expressions. Before the fix these used unbounded
+ * Pattern/Matcher/String.replaceAll calls, so a catastrophic-backtracking pattern
+ * (e.g. {@code ((a+)+)+b}) against a crafted input could consume CPU indefinitely.</p>
+ *
+ * <p>The fix routes those evaluations through a timeout-guarded wrapper that aborts
+ * with a {@link TimeoutException} once the configured budget is exceeded, while
+ * benign inputs keep returning correct results.</p>
+ *
+ * <p>Grounded on upstream RegexTimeoutTests from fix commit
+ * 275d015c680ce9f90cbe285596e50118e472bf24.</p>
+ */
+public class CVE202645367RegressionTest {
+
+  private static final String NORMAL_STRING = repeat("a", 10) + "!";
+  // Catastrophic backtracking for full-string matches().
+  private static final String EVIL_STRING = repeat("a", 50) + "!";
+  private static final String BAD_REGEX = "((a+)+)+";
+  // Requires a trailing 'b' that never appears -> forces exhaustive backtracking for find/replace too.
+  private static final String BAD_SUFFIX_REGEX = "((a+)+)+b";
+  private static final String EVIL_NO_SUFFIX = repeat("a", 50);
+
+  private static final long SHORT_TIMEOUT = 500;
+
+  private static String repeat(String s, int n) {
+    StringBuilder sb = new StringBuilder();
+    for (int i = 0; i < n; i++) {
+      sb.append(s);
+    }
+    return sb.toString();
+  }
+
+  // matches() -> full-string match, guards funcMatchesFull()
+  @Test
+  void badRegex_matches_evilString_timesOut() {
+    assertThrows(TimeoutException.class,
+        () -> RegexTimeout.matches(EVIL_STRING, BAD_REGEX, SHORT_TIMEOUT));
+  }
+
+  @Test
+  void badRegex_matches_normalString_returnsCorrectResult() throws TimeoutException {
+    boolean actual = RegexTimeout.matches(NORMAL_STRING, BAD_REGEX, SHORT_TIMEOUT);
+    assertEquals(NORMAL_STRING.matches(BAD_REGEX), actual);
+    assertFalse(actual);
+  }
+
+  // find() -> guards funcMatches()
+  @Test
+  void badRegex_find_evilString_timesOut() {
+    assertThrows(TimeoutException.class,
+        () -> RegexTimeout.find(EVIL_NO_SUFFIX, BAD_SUFFIX_REGEX, SHORT_TIMEOUT));
+  }
+
+  @Test
+  void badRegex_find_normalString_returnsCorrectResult() throws TimeoutException {
+    boolean actual = RegexTimeout.find(NORMAL_STRING, BAD_REGEX, SHORT_TIMEOUT);
+    assertEquals(Pattern.compile(BAD_REGEX).matcher(NORMAL_STRING).find(), actual);
+    assertTrue(actual);
+  }
+
+  // replaceAll() -> guards funcReplaceMatches()
+  @Test
+  void badRegex_replaceAll_evilString_timesOut() {
+    assertThrows(TimeoutException.class,
+        () -> RegexTimeout.replaceAll(EVIL_NO_SUFFIX, BAD_SUFFIX_REGEX, "X", SHORT_TIMEOUT));
+  }
+
+  @Test
+  void normalRegex_replaceAll_returnsCorrectResult() throws TimeoutException {
+    assertEquals("X X", RegexTimeout.replaceAll("hello world", "\\w+", "X", SHORT_TIMEOUT));
+  }
+}

