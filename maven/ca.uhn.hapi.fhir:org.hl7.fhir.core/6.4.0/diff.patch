+package org.hl7.fhir.utilities.http;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression test for CVE-2026-34361.
+ *
+ * <p>ManagedWebAccessBuilder.getServer() historically matched a request URL to
+ * a configured server (and thus attached that server's stored credentials)
+ * using a naive {@code url.startsWith(t.getUrl())} prefix check. An attacker who
+ * controls a host whose URL merely shares a textual prefix with a configured
+ * server (e.g. {@code https://packages.fhir.org.malicious.com}) could therefore
+ * receive the stored authentication token.
+ *
+ * <p>These tests pin the fixed origin-based matching behaviour on the
+ * pre-refactor analog present at this version, mirroring the upstream
+ * ManagedWebAccessUtilsTests assertions.
+ */
+public class ManagedWebAccessBuilderRegressionTest {
+
+  @Test
+  public void matchesGenuineSameOriginRequest() {
+    assertThat(ManagedWebAccessBuilder.urlMatchesOrigin(
+        "https://packages.fhir.org/packages", "https://packages.fhir.org")).isTrue();
+  }
+
+  @Test
+  public void doesNotMatchMaliciousPrefixHost() {
+    // The core CVE-2026-34361 case: a prefix-matching but different host must NOT match.
+    assertThat(ManagedWebAccessBuilder.urlMatchesOrigin(
+        "https://packages.fhir.org.malicious.com", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void doesNotMatchDifferentProtocol() {
+    assertThat(ManagedWebAccessBuilder.urlMatchesOrigin(
+        "http://packages.fhir.org/packages", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void doesNotMatchDifferentPort() {
+    assertThat(ManagedWebAccessBuilder.urlMatchesOrigin(
+        "https://packages.fhir.org:8443/packages", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void doesNotMatchMalformedUrl() {
+    assertThat(ManagedWebAccessBuilder.urlMatchesOrigin(
+        "not a url", "https://packages.fhir.org")).isFalse();
+  }
+}

