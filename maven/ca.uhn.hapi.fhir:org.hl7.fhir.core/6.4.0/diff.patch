+package org.hl7.fhir.utilities.regex;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.TimeoutException;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+/**
+ * Regression test for CVE-2026-49485.
+ *
+ * FHIRPathEngine's regex-based functions (matches/matchesFull/replaceMatches)
+ * previously used {@link String#replaceAll(String, String)} directly, allowing a
+ * crafted regex/input pair to trigger catastrophic backtracking (ReDoS) and hang
+ * a CPU core. The fix routes regex evaluation through {@link RegexTimeout}, which
+ * runs the operation on an interruptible worker and aborts with a
+ * {@link TimeoutException} once the default timeout elapses.
+ */
+class RegexTimeoutTests {
+
+  // Requires a trailing 'b' that never appears, forcing exhaustive backtracking
+  // for replaceAll on the evil input below.
+  static final String BAD_SUFFIX_REGEX = "((a+)+)+b";
+  static final String EVIL_NO_SUFFIX = "a".repeat(50);
+
+  @Test
+  void test_BadRegex_ReplaceAll_EvilString_TimesOut() {
+    assertThrows(TimeoutException.class,
+        () -> RegexTimeout.replaceAll(EVIL_NO_SUFFIX, BAD_SUFFIX_REGEX, "X"));
+  }
+
+  @Test
+  void test_NormalRegex_ReplaceAll_StillWorks() throws TimeoutException {
+    assertEquals("X X", RegexTimeout.replaceAll("hello world", "\\w+", "X"));
+  }
+}

