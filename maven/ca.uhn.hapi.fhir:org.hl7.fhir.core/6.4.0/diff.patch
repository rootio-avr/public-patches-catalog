+package org.hl7.fhir.utilities.http;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression tests for CVE-2026-34359 (CWE-346, Origin Validation Error).
+ *
+ * <p>Before the fix, origin/prefix matching used {@link String#startsWith(String)},
+ * so a look-alike host such as {@code https://packages.fhir.org.malicious.com}
+ * matched the configured prefix {@code https://packages.fhir.org} and the client
+ * would leak its credentials to the attacker. These tests pin the anchored
+ * scheme+host+port+path matching behaviour.</p>
+ */
+public class ManagedWebAccessUtilsTests {
+
+  @Test
+  public void matchesSameOriginWithAnchoredPath() {
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://packages.fhir.org/packages", "https://packages.fhir.org")).isTrue();
+  }
+
+  @Test
+  public void doesNotMatchLookAlikeSuffixDomain() {
+    // The core CVE-2026-34359 exploit: attacker registers a subdomain of the
+    // configured host as a prefix-collision. startsWith() matched this; the
+    // origin check must not.
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://packages.fhir.org.malicious.com", "https://packages.fhir.org")).isFalse();
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://packages.fhir.org.malicious.com/packages", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void doesNotMatchDifferentHost() {
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://example.org/packages", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void doesNotMatchDifferentScheme() {
+    // No TLS downgrade: http must not match a configured https origin.
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "http://packages.fhir.org/packages", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void doesNotMatchDifferentExplicitPort() {
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://packages.fhir.org:8443/packages", "https://packages.fhir.org")).isFalse();
+  }
+
+  @Test
+  public void infersDefaultPortSoImplicitAndExplicitMatch() {
+    // https://host and https://host:443 are the same origin.
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://packages.fhir.org/packages", "https://packages.fhir.org:443")).isTrue();
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "http://packages.fhir.org/packages", "http://packages.fhir.org:80")).isTrue();
+  }
+
+  @Test
+  public void doesNotMatchUnanchoredPath() {
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "https://packages.fhir.org/other", "https://packages.fhir.org/packages")).isFalse();
+  }
+
+  @Test
+  public void malformedUrlsDoNotMatch() {
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(
+      "not a url", "https://packages.fhir.org")).isFalse();
+    assertThat(ManagedWebAccessUtils.urlMatchesOrigin(null, "https://packages.fhir.org")).isFalse();
+  }
+}

