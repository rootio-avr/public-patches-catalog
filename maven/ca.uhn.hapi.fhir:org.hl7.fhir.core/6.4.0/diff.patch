+package org.hl7.fhir.utilities.http;
+
+import java.net.MalformedURLException;
+import java.net.URL;
+
+/**
+ * Utility methods for matching request URLs against configured server / allowed
+ * origins.
+ *
+ * <p>Historically this matching was done with a bare {@link String#startsWith(String)}
+ * check (see {@code ManagedWebAccessBuilder.getServer(String)} and
+ * {@code ManagedWebAccess.inAllowedPaths(String)}). That is an Origin Validation
+ * Error (CWE-346): an attacker controlled host such as
+ * {@code http://tx.fhir.org.attacker.com} matches the configured prefix
+ * {@code http://tx.fhir.org}, causing the client to leak its credentials
+ * (e.g. an {@code Authorization: Bearer} token) to the attacker's server.</p>
+ *
+ * <p>These helpers parse both URLs and only treat them as the same origin when
+ * the scheme, host and (explicit-or-inferred) port match exactly, and the
+ * request path is anchored under the configured path prefix.</p>
+ */
+public class ManagedWebAccessUtils {
+
+  private ManagedWebAccessUtils() {
+    // utility class
+  }
+
+  /**
+   * @return true when {@code requestUrlString} shares the same origin
+   *   (scheme + host + port) as {@code serverUrlString} and its path is anchored
+   *   under the server URL's path. Returns false if either string is not a valid
+   *   URL.
+   */
+  public static boolean urlMatchesOrigin(String requestUrlString, String serverUrlString) {
+    if (requestUrlString == null || serverUrlString == null) {
+      return false;
+    }
+    try {
+      URL requestUrl = new URL(requestUrlString);
+      URL serverUrl = new URL(serverUrlString);
+      return urlMatchesOrigin(requestUrl, serverUrl);
+    } catch (MalformedURLException e) {
+      return false;
+    }
+  }
+
+  public static boolean urlMatchesOrigin(URL requestUrl, URL serverUrl) {
+    return requestUrl.getProtocol().equals(serverUrl.getProtocol())
+      && requestUrl.getHost().equals(serverUrl.getHost())
+      && getExplicitOrInferredPort(requestUrl) == getExplicitOrInferredPort(serverUrl)
+      && requestUrl.getPath().startsWith(serverUrl.getPath());
+  }
+
+  private static int getExplicitOrInferredPort(URL url) {
+    int port = url.getPort();
+    if (port != -1) {
+      return port;
+    }
+    if (url.getProtocol().equals("https")) {
+      return 443;
+    }
+    if (url.getProtocol().equals("http")) {
+      return 80;
+    }
+    return port;
+  }
+}
