+ * paths.
+ */
+class Cve202645367RegressionTest {
+
+  // A pathological "evil" regex that triggers catastrophic backtracking for a
+  // full-string match against a run of 'a' characters that ends with a
+  // non-matching character.
+  private static final String EVIL_REGEX = "((a+)+)+";
+  private static final String EVIL_INPUT = repeat("a", 50) + "!";
+
+  private static String repeat(String s, int n) {
+    StringBuilder b = new StringBuilder();
+    for (int i = 0; i < n; i++) {
+      b.append(s);
+    }
+    return b.toString();
+  }
+
+  private FHIRPathEngine newEngine() {
+    FHIRPathEngine engine = new FHIRPathEngine(null);
+    // Keep the test fast and deterministic; the vulnerable code would run for
+    // many seconds/minutes on EVIL_INPUT without the timeout guard.
+    engine.setRegexTimeoutMillis(200);
+    return engine;
+  }
+
+  @Test
+  void matches_withEvilRegex_timesOutInsteadOfHanging() {
+    FHIRPathEngine engine = newEngine();
+    long start = System.currentTimeMillis();
+    assertThrows(PathEngineException.class,
+        () -> engine.evaluate(new StringType(EVIL_INPUT), "matches('" + EVIL_REGEX + "')"));
+    long elapsed = System.currentTimeMillis() - start;
+    // Must bail out promptly rather than backtracking indefinitely.
+    assertTrue(elapsed < 5000, "matches() with an evil regex should time out quickly, took " + elapsed + "ms");
+  }
+
+  @Test
+  void replaceMatches_withEvilRegex_timesOutInsteadOfHanging() {
+    FHIRPathEngine engine = newEngine();
+    long start = System.currentTimeMillis();
+    assertThrows(PathEngineException.class,
+        () -> engine.evaluate(new StringType(EVIL_INPUT), "replaceMatches('" + EVIL_REGEX + "', 'X')"));
+    long elapsed = System.currentTimeMillis() - start;
+    assertTrue(elapsed < 5000, "replaceMatches() with an evil regex should time out quickly, took " + elapsed + "ms");
+  }
+
+  @Test
+  void matches_withNormalRegex_stillWorks() {
+    FHIRPathEngine engine = newEngine();
+    List<Base> result = engine.evaluate(new StringType("hello"), "matches('h.*o')");
+    assertEquals("true", engine.convertToString(result));
+  }
+
+  @Test
+  void replaceMatches_withNormalRegex_stillWorks() {
+    FHIRPathEngine engine = newEngine();
+    List<Base> result = engine.evaluate(new StringType("hello world"), "replaceMatches('o', '0')");
+    assertEquals("hell0 w0rld", engine.convertToString(result));
+  }
+}

