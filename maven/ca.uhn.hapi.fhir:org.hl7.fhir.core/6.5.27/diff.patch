+package org.hl7.fhir.utilities.regex;
+
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+
+/**
+ * Regression test for CVE-2026-49485.
+ *
+ * FHIRPath's {@code matches()} and {@code replaceMatches()} functions delegated
+ * regular-expression evaluation straight to {@link String#matches(String)} /
+ * {@link String#replaceAll(String, String)}, which have no execution bound. A
+ * catastrophically-backtracking (ReDoS) pattern against attacker-controlled input
+ * could therefore hang the evaluating thread indefinitely.
+ *
+ * The fix routes those calls through {@link RegexTimeout}, which caps evaluation
+ * at a bounded timeout and raises {@link TimeoutException} instead of hanging.
+ */
+public class RegexTimeoutTest {
+
+  // A classic catastrophic-backtracking pattern + non-matching input.
+  private static final String EVIL_REGEX = "(a+)+$";
+  private static final String EVIL_INPUT = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!";
+
+  @Test
+  @DisplayName("matches() returns normally for a benign pattern")
+  void matchesBenign() throws TimeoutException {
+    Assertions.assertTrue(RegexTimeout.matches("hello", "h.*o"));
+    Assertions.assertFalse(RegexTimeout.matches("hello", "z.*z"));
+  }
+
+  @Test
+  @DisplayName("replaceAll() returns normally for a benign pattern")
+  void replaceAllBenign() throws TimeoutException {
+    Assertions.assertEquals("hXllX", RegexTimeout.replaceAll("hello", "[eo]", "X"));
+  }
+
+  @Test
+  @DisplayName("matches() aborts a catastrophic-backtracking regex instead of hanging")
+  @Timeout(value = 10, unit = TimeUnit.SECONDS)
+  void matchesTimesOutOnReDoS() {
+    Assertions.assertThrows(TimeoutException.class,
+        () -> RegexTimeout.matches(EVIL_INPUT, EVIL_REGEX, 200));
+  }
+
+  @Test
+  @DisplayName("replaceAll() aborts a catastrophic-backtracking regex instead of hanging")
+  @Timeout(value = 10, unit = TimeUnit.SECONDS)
+  void replaceAllTimesOutOnReDoS() {
+    Assertions.assertThrows(TimeoutException.class,
+        () -> RegexTimeout.replaceAll(EVIL_INPUT, EVIL_REGEX, "x", 200));
+  }
+}

