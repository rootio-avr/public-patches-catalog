+package org.hl7.fhir.dstu2.utils;
+
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.concurrent.TimeoutException;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+/**
+ * Regression test for CVE-2026-45367 (ReDoS in FHIRPath matches()/replaceMatches()).
+ *
+ * The upstream fix (org.hl7.fhir.core@275d015c) validated the mitigation via
+ * RegexTimeoutTests against a private/utility RegexTimeout helper. That helper lives
+ * in the org.hl7.fhir.utilities module which is not available at this dstu2 target
+ * version, so the mitigation was vendored as a private nested RegexTimeout inside
+ * FHIRPathEngine. This test reaches that helper reflectively and asserts the same
+ * behavior the upstream test did: a catastrophic-backtracking ("evil") regex aborts
+ * with a TimeoutException instead of consuming CPU indefinitely, while a normal
+ * evaluation still returns the correct result.
+ */
+class CVE202645367RegressionTest {
+
+  // Classic evil regex. For full-string matches() the trailing '!' can never be
+  // consumed, forcing exhaustive backtracking. For subsequence ops (replaceAll)
+  // a trailing 'b' that never appears is required to force the same behavior --
+  // this mirrors the upstream RegexTimeoutTests BAD_REGEX / BAD_SUFFIX_REGEX split.
+  private static final String BAD_REGEX = "((a+)+)+";
+  private static final String BAD_SUFFIX_REGEX = "((a+)+)+b";
+  private static final String EVIL_STRING = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!"; // 30 a's + '!'
+  private static final String EVIL_NO_SUFFIX = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; // 30 a's
+  private static final String NORMAL_STRING = "aaaaaaaaaa!"; // 10 a's + '!'
+  private static final long TIMEOUT_MILLIS = 500;
+
+  private Method regexTimeoutMethod(String name, Class<?>... argTypes) throws Exception {
+    for (Class<?> inner : FHIRPathEngine.class.getDeclaredClasses()) {
+      if (inner.getSimpleName().equals("RegexTimeout")) {
+        Method m = inner.getDeclaredMethod(name, argTypes);
+        m.setAccessible(true);
+        return m;
+      }
+    }
+    throw new NoSuchMethodException("RegexTimeout." + name + " not found on FHIRPathEngine");
+  }
+
+  private Throwable unwrap(Throwable t) {
+    return (t instanceof InvocationTargetException && t.getCause() != null) ? t.getCause() : t;
+  }
+
+  @Test
+  void evilRegex_matches_timesOut() throws Exception {
+    Method matches = regexTimeoutMethod("matches", String.class, String.class, long.class);
+    Throwable thrown = assertThrows(Throwable.class,
+      () -> {
+        try {
+          matches.invoke(null, EVIL_STRING, BAD_REGEX, TIMEOUT_MILLIS);
+        } catch (InvocationTargetException e) {
+          throw e.getCause();
+        }
+      });
+    assertEquals(TimeoutException.class, unwrap(thrown).getClass(),
+      "evil regex must abort with a TimeoutException rather than backtracking forever");
+  }
+
+  @Test
+  void normalRegex_matches_returnsResult() throws Exception {
+    Method matches = regexTimeoutMethod("matches", String.class, String.class, long.class);
+    Object result = matches.invoke(null, NORMAL_STRING, BAD_REGEX, TIMEOUT_MILLIS);
+    assertFalse((Boolean) result, "normal-length input must evaluate quickly and match String#matches");
+  }
+
+  @Test
+  void evilRegex_replaceAll_timesOut() throws Exception {
+    Method replaceAll = regexTimeoutMethod("replaceAll", String.class, String.class, String.class, long.class);
+    Throwable thrown = assertThrows(Throwable.class,
+      () -> {
+        try {
+          replaceAll.invoke(null, EVIL_NO_SUFFIX, BAD_SUFFIX_REGEX, "X", TIMEOUT_MILLIS);
+        } catch (InvocationTargetException e) {
+          throw e.getCause();
+        }
+      });
+    assertEquals(TimeoutException.class, unwrap(thrown).getClass(),
+      "evil regex in replaceMatches() must abort with a TimeoutException");
+  }
+}

