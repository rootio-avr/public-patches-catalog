+package org.hl7.fhir.utilities.regex;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.TimeoutException;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+/**
+ * Regression test for CVE-2026-55470.
+ *
+ * <p>Residual of CVE-2026-49485: the FHIRPath {@code matches} functions still called
+ * {@link String#matches(String)} / {@link java.util.regex.Matcher#find()} directly, so a
+ * catastrophic-backtracking pattern supplied through {@code matches()} kept the
+ * denial-of-service vector open even after {@code replaceMatches} had been bounded.</p>
+ *
+ * <p>The fix routes those calls through {@link RegexTimeout#matches(CharSequence, String)}
+ * and {@link RegexTimeout#find(CharSequence, String)}, which abort with a
+ * {@link TimeoutException} once the default time budget elapses.</p>
+ */
+class Cve202655470RegressionTest {
+
+  static final String BAD_REGEX = "((a+)+)+";
+  static final String BAD_SUFFIX_REGEX = "((a+)+)+b";
+  static final String EVIL_STRING = "a".repeat(50) + "!";
+  static final String EVIL_NO_SUFFIX = "a".repeat(50);
+
+  @Test
+  void test_BadRegex_Matches_EvilString_TimesOut() {
+    assertThrows(TimeoutException.class, () -> RegexTimeout.matches(EVIL_STRING, BAD_REGEX));
+  }
+
+  @Test
+  void test_BadRegex_Find_EvilString_TimesOut() {
+    assertThrows(TimeoutException.class, () -> RegexTimeout.find(EVIL_NO_SUFFIX, BAD_SUFFIX_REGEX));
+  }
+
+  @Test
+  void test_NormalRegex_Matches_Succeeds() throws TimeoutException {
+    assertTrue(RegexTimeout.matches("abc", "[a-c]+"));
+    assertFalse(RegexTimeout.matches("abd", "[a-c]+"));
+  }
+
+  @Test
+  void test_NormalRegex_Find_Succeeds() throws TimeoutException {
+    assertTrue(RegexTimeout.find("hello world", "wor"));
+    assertFalse(RegexTimeout.find("hello world", "^world"));
+  }
+}

