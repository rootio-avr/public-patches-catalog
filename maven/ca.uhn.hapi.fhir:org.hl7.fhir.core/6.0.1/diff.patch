+package org.hl7.fhir.utilities.regex;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.TimeoutException;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+/**
+ * Regression test for CVE-2026-49485.
+ *
+ * <p>The FHIRPath {@code replaceMatches} function evaluated a caller-supplied regular
+ * expression against caller-supplied input via a direct {@link String#replaceAll(String, String)}
+ * call with no time bound. A catastrophic-backtracking ("ReDoS") pattern such as
+ * {@code ((a+)+)+b} applied to a long run of {@code a}'s hangs the evaluating thread
+ * indefinitely, giving an attacker a denial-of-service vector.</p>
+ *
+ * <p>The fix routes those regex calls through {@link RegexTimeout}, which aborts and
+ * throws {@link TimeoutException} once the default timeout elapses. These assertions
+ * mirror the upstream RegexTimeoutTests behaviour (translated to plain JUnit 5, since
+ * assertj is not available in this module at this version): evil input times out,
+ * benign input still produces the correct result.</p>
+ */
+class RegexTimeoutCVE202649485Test {
+
+  // A trailing 'b' that never appears forces exhaustive backtracking for replaceAll.
+  static final String BAD_SUFFIX_REGEX = "((a+)+)+b";
+  static final String EVIL_NO_SUFFIX = "a".repeat(50);
+
+  @Test
+  void test_BadRegex_ReplaceAll_EvilString_TimesOut() {
+    assertThrows(TimeoutException.class,
+        () -> RegexTimeout.replaceAll(EVIL_NO_SUFFIX, BAD_SUFFIX_REGEX, "X"));
+  }
+
+  @Test
+  void test_NormalRegex_ReplaceAll_Succeeds() throws TimeoutException {
+    assertEquals("X X", RegexTimeout.replaceAll("hello world", "\\w+", "X"));
+  }
+
+  @Test
+  void test_BadRegex_Matches_EvilString_TimesOut() {
+    assertThrows(TimeoutException.class,
+        () -> RegexTimeout.matches("a".repeat(50) + "!", "((a+)+)+"));
+  }
+
+  @Test
+  void test_NormalRegex_Split_Succeeds() throws TimeoutException {
+    assertArrayEquals(new String[]{"a", "b", "c"}, RegexTimeout.split("a,b,c", ","));
+  }
+}
