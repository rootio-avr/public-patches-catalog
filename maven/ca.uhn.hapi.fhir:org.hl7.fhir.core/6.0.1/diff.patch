+  public void differentSchemeIsNotSameOrigin() throws Exception {
+    assertFalse(SimpleHTTPClient.sameOrigin(
+        new URL("http://tx.fhir.org/a"),
+        new URL("https://tx.fhir.org/a")));
+  }
+
+  @Test
+  public void differentPortIsNotSameOrigin() throws Exception {
+    assertFalse(SimpleHTTPClient.sameOrigin(
+        new URL("https://tx.fhir.org:8443/a"),
+        new URL("https://tx.fhir.org/a")));
