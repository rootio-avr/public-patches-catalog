@@ -0,0 +1,52 @@
+package org.hl7.fhir.utilities.xml;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import javax.xml.XMLConstants;
+import javax.xml.transform.Transformer;
+import javax.xml.transform.TransformerException;
+import javax.xml.transform.TransformerFactory;
+import javax.xml.transform.stream.StreamResult;
+import javax.xml.transform.stream.StreamSource;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.StringReader;
+import java.nio.charset.StandardCharsets;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression test for CVE-2024-45294 (XXE / external resource resolution in
+ * TransformerFactory). {@link XMLUtil#newXXEProtectedTransformerFactory()} must
+ * disable resolution of external DTDs and stylesheets by setting the
+ * ACCESS_EXTERNAL_* attributes to the empty string, so an attacker-controlled
+ * XSLT / XML document cannot pull in external resources.
+ */
+public class XMLUtilXXETest {
+
+  @Test
+  public void newXXEProtectedTransformerFactory_disablesExternalAccess() {
+    TransformerFactory factory = XMLUtil.newXXEProtectedTransformerFactory();
+    assertEquals("", factory.getAttribute(XMLConstants.ACCESS_EXTERNAL_DTD));
+    assertEquals("", factory.getAttribute(XMLConstants.ACCESS_EXTERNAL_STYLESHEET));
+  }
+
+  @Test
+  public void newXXEProtectedTransformerFactory_rejectsExternalStylesheetImport() {
+    // A stylesheet that tries to pull in an external stylesheet resource.
+    String maliciousXslt =
+        "<?xml version=\"1.0\"?>"
+      + "<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\">"
+      + "  <xsl:import href=\"file:///etc/passwd\"/>"
+      + "  <xsl:template match=\"/\"><out/></xsl:template>"
+      + "</xsl:stylesheet>";
+
+    TransformerFactory factory = XMLUtil.newXXEProtectedTransformerFactory();
+    // With ACCESS_EXTERNAL_STYLESHEET locked down, building a transformer that
+    // resolves the external import must fail rather than fetch the resource.
+    assertThrows(TransformerException.class, () ->
+        factory.newTransformer(new StreamSource(new StringReader(maliciousXslt))));
+  }
+}

