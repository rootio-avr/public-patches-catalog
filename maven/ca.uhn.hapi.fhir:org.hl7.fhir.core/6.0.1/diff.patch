+package org.hl7.fhir.utilities.xml;
+
+import org.junit.jupiter.api.Test;
+import org.w3c.dom.Document;
+import org.xml.sax.SAXException;
+
+import javax.xml.parsers.DocumentBuilder;
+import javax.xml.parsers.ParserConfigurationException;
+import javax.xml.transform.Source;
+import javax.xml.transform.Transformer;
+import javax.xml.transform.TransformerException;
+import javax.xml.transform.TransformerFactory;
+import javax.xml.transform.dom.DOMSource;
+import javax.xml.transform.stream.StreamResult;
+import javax.xml.transform.stream.StreamSource;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.StringWriter;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Regression test for CVE-2026-55471 (CWE-611, XXE via the Saxon TransformerFactory).
+ *
+ * <p>Before the fix, {@code XsltUtilities} instantiated a Saxon
+ * {@code net.sf.saxon.TransformerFactoryImpl} directly, without disabling external
+ * DTD / stylesheet access, so a malicious stylesheet using the XPath
+ * {@code document('...')} function could read arbitrary external resources. The fix
+ * routes all Saxon transformer creation through
+ * {@link XMLUtil#newXXEProtectedSaxonTransformerFactory()}, which sets
+ * {@code ACCESS_EXTERNAL_DTD} and {@code ACCESS_EXTERNAL_STYLESHEET} to the empty
+ * string so any external access attempt fails.</p>
+ *
+ * <p>The fixtures live under {@code xml/cve202655471/} so this test stays independent
+ * of the CVE-2024-52007 XXE fixtures in {@code xml/}.</p>
+ */
+public class XMLUtilSaxonXXETests {
+
+  @Test
+  public void testSaxonTransformerFactoryThrowsExceptionForExternalEntity()
+      throws ParserConfigurationException, IOException, SAXException, TransformerException {
+    DocumentBuilder builder = XMLUtil.newXXEProtectedDocumentBuilderFactory().newDocumentBuilder();
+
+    File file = new File("src/test/resources/xml/cve202655471/resource.xml");
+    Document document = builder.parse(file);
+    StringWriter sw = new StringWriter();
+
+    TransformerFactory tf = XMLUtil.newXXEProtectedSaxonTransformerFactory();
+
+    File templateFile = new File("src/test/resources/xml/cve202655471/evil-transform.xslt");
+    Source xsltSource = new StreamSource(templateFile);
+    Transformer transformer = tf.newTransformer(xsltSource);
+
+    // The stylesheet calls document('jackpot.xml'), which exists next to it: with
+    // external access disabled the transform must fail rather than read the file.
+    TransformerException e = assertThrows(TransformerException.class,
+        () -> transformer.transform(new DOMSource(document), new StreamResult(sw)));
+
+    // The exact Saxon message text varies across Saxon versions, so assert on the
+    // stable substring that indicates external file access was refused.
+    String message = e.getMessage() == null ? "" : e.getMessage();
+    assertTrue(message.contains("URIs using protocol file are not permitted")
+            || message.toLowerCase().contains("not permitted")
+            || message.toLowerCase().contains("not allowed"),
+        "Expected external-access-denied error but got: " + message);
+  }
+}
