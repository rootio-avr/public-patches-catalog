+    assertTrue(SimpleHTTPClient.sameOrigin(
+        new URL("https://TX.FHIR.ORG/a"),
+        new URL("https://tx.fhir.org/b")));
+  }
+
+  @Test
+  public void sameOriginTrueWhenExplicitPortMatchesDefault() throws Exception {
+    assertTrue(SimpleHTTPClient.sameOrigin(
+        new URL("https://tx.fhir.org:443/a"),
+        new URL("https://tx.fhir.org/b")));
+  }
+
