+  public void differentHostSuffixIsNotSameOrigin() throws Exception {
+    assertFalse(SimpleHTTPClient.sameOrigin(
+        new URL("https://tx.fhir.org.attacker.com/steal"),
+        new URL("https://tx.fhir.org/r4")));
+  }
+
