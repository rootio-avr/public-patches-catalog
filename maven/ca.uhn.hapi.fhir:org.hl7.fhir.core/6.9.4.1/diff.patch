+package org.hl7.fhir.dstu2.test;
+
+import org.hl7.fhir.dstu2.model.StringType;
+import org.hl7.fhir.dstu2.utils.FHIRPathEngine;
+import org.hl7.fhir.exceptions.PathEngineException;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+import java.time.Duration;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTimeoutPreemptively;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Regression test for CVE-2026-55470 (CWE-1333, ReDoS).
+ *
+ * FHIRPath's matches() function compiled and evaluated a caller-supplied
+ * regular expression against the focus string with no time bound. A crafted
+ * "evil" regex combined with a non-matching input triggers catastrophic
+ * backtracking that hangs the evaluation thread indefinitely.
+ *
+ * The runtime leftover (funcMatches via RegexTimeout.matches) is applied by
+ * CVE-2026-45367. This file is the leftover test only — replaying the engine
+ * hunk after that advisory fails.
+ */
+class Cve202655470RegressionTest {
+
+  // Classic catastrophic-backtracking pattern.
+  private static final String EVIL_REGEX = "(a+)+$";
+  // Input that forces exponential backtracking (many 'a's that ultimately fail to match).
+  private static final String EVIL_INPUT =
+      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!";
+
+  @Test
+  @DisplayName("matches() with a catastrophic regex aborts instead of hanging (ReDoS)")
+  void evilRegexTimesOutRatherThanHanging() {
+    FHIRPathEngine engine = new FHIRPathEngine(null);
+
+    // The whole evaluation must complete (via the built-in regex timeout ->
+    // PathEngineException) well within this wall-clock budget; before the fix
+    // it would hang indefinitely on catastrophic backtracking.
+    assertTimeoutPreemptively(Duration.ofSeconds(30), () ->
+        assertThrows(PathEngineException.class, () ->
+            engine.evaluate(new StringType(EVIL_INPUT), "matches('" + EVIL_REGEX + "')")));
+  }
+
+  @Test
+  @DisplayName("matches() still evaluates a benign regex correctly")
+  void benignRegexStillWorks() throws Exception {
+    FHIRPathEngine engine = new FHIRPathEngine(null);
+    assertTrue(engine.evaluateToBoolean((org.hl7.fhir.dstu2.model.Resource) null,
+        new StringType("hello"), "matches('h.*o')"));
+  }
+}

CVE-2026-55471: XXE hardening for Saxon-based XSLT transformation in org.hl7.fhir.utilities

The saxonTransform(...) methods in XsltUtilities instantiated a bare
net.sf.saxon.TransformerFactoryImpl() without setting ACCESS_EXTERNAL_DTD or
ACCESS_EXTERNAL_STYLESHEET restrictions, allowing XML External Entity (XXE)
processing (CWE-611): local file disclosure and blind SSRF. Route all Saxon
transformer creation through a new hardened XMLUtil.newXXEProtectedSaxonTransformerFactory()
helper that disables external DTD and stylesheet access.

Backported from upstream org.hl7.fhir.core commit
01ca2ecdefec9b33204d2495fe78af8c0dc52298 (fixed in 6.9.10).

Build note: also removes two root-pom lint/compliance plugins that are not
published in the Root.io codeartifact maven mirror and abort the aggregator
reactor before the org.hl7.fhir.utilities module builds:
