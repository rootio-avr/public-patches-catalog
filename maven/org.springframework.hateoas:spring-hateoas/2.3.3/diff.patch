+	@Test // CVE-2026-41007 - cache must stay bounded to avoid unbounded heap growth
+	void cacheDoesNotGrowBeyondBound() throws Exception {
+
+		Field cacheField = StringLinkRelation.class.getDeclaredField("CACHE");
+		cacheField.setAccessible(true);
+
+		Object cache = cacheField.get(null);
+
+		assertThat(cache).isInstanceOf(ConcurrentLruCache.class);
+
+		// Feed many distinct relations, as an attacker would to exhaust the heap.
+		for (int i = 0; i < 10_000; i++) {
+			StringLinkRelation.of("rel-" + i);
+		}
+
+		int size = ((ConcurrentLruCache<?, ?>) cache).size();
+
+		assertThat(size).isLessThanOrEqualTo(256);
