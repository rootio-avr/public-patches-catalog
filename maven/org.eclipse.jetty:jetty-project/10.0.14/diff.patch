+    /**
+     * Regression test for CVE-2026-2332 (GHSA-355h-qmc2-wpwf).
+     *
+     * A chunk-extension value that opens a quoted-string but embeds a CRLF before closing the
+     * quote must be rejected. Previously Jetty terminated chunk-header parsing at the embedded
+     * CRLF, so the bytes after it were parsed as an independent, smuggled HTTP request.
+     */
+    @Test
+    public void testChunkExtQuotedStringSmuggling()
+    {
+        ByteBuffer buffer = BufferUtil.toBuffer(
+            "POST /chunk HTTP/1.1\r\n" +
+                "Host: localhost\r\n" +
+                "Transfer-Encoding: chunked\r\n" +
+                "\r\n" +
+                "1;a=\"\r\n" +
+                "GET /smuggled HTTP/1.1\r\n" +
+                "Host: localhost\r\n" +
+                "\r\n" +
+                "\"\r\n" +
+                "X\r\n" +
+                "0\r\n" +
+                "\r\n");
+        HttpParser.RequestHandler handler = new Handler();
+        HttpParser parser = new HttpParser(handler);
+        parseAll(parser, buffer);
+
+        // The embedded CRLF inside the (unterminated) quoted-string must be treated as a parse
+        // error, NOT as the end of the chunk-size line; the smuggled request must never be parsed.
+        assertThat(_bad, Matchers.notNullValue());
+        assertThat(_uriOrStatus, is("/chunk"));
+    }
+
