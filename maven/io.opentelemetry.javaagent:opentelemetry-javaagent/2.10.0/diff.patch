+/*
+ * Copyright The OpenTelemetry Authors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package io.opentelemetry.javaagent.instrumentation.rmi.context;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.lang.reflect.Field;
+import java.util.HashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression test for CVE-2026-33701.
+ *
+ * <p>Before the fix, {@link ContextPayload#read} used {@code ObjectInput.readObject()}, which
+ * deserializes arbitrary attacker-controlled objects off an RMI stream (CWE-502, unbounded
+ * deserialization / remote code execution). The fix replaces object serialization with an explicit
+ * bounded key/value string protocol and rejects oversized payloads.
+ */
+class ContextPayloadRegressionTest {
+
+  @SuppressWarnings("unchecked")
+  private static Map<String, String> contextOf(ContextPayload payload) throws Exception {
+    Field field = ContextPayload.class.getDeclaredField("context");
+    field.setAccessible(true);
+    return (Map<String, String>) field.get(payload);
+  }
+
+  @Test
+  void roundTripsWithoutObjectSerialization() throws Exception {
+    Map<String, String> entries = new HashMap<>();
+    entries.put("traceparent", "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01");
+    entries.put("baggage", "key=value");
+
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+      new ContextPayload(entries).write(out);
+    }
+
+    // The new wire format starts with an int length prefix, not a serialized object stream.
+    try (ObjectInputStream in =
+        new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      ContextPayload read = ContextPayload.read(in);
+      assertThat(read).isNotNull();
+      assertThat(contextOf(read)).isEqualTo(entries);
+    }
+  }
+
+  @Test
+  void rejectsOversizedPayload() throws Exception {
+    // A malicious peer advertising a huge entry count must be rejected rather than allocated.
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+      out.writeInt(Integer.MAX_VALUE);
+    }
+
+    try (ObjectInputStream in =
+        new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      assertThat(ContextPayload.read(in)).isNull();
+    }
+  }
+
+  @Test
+  void doesNotDeserializeArbitraryObjects() throws Exception {
+    // Simulate an attacker who places a serialized gadget object on the stream where the old code
+    // called readObject(). The fixed code reads an int length prefix first and never invokes
+    // readObject(), so the gadget is never instantiated. Reading here must not construct the
+    // arbitrary object; at most it returns null or a bounded map.
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+      Map<String, String> gadget = new HashMap<>();
+      gadget.put("evil", "payload");
+      out.writeObject(gadget);
+    }
+
+    try (ObjectInputStream in =
+        new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+      // Interpreting the object-stream bytes as the new length-prefixed protocol must not
+      // deserialize the embedded object graph. It either rejects (null) or reads bounded strings.
+      ContextPayload read;
+      try {
+        read = ContextPayload.read(in);
+      } catch (java.io.IOException expected) {
+        // Reading a malformed/foreign stream as the string protocol may fail cleanly - acceptable.
+        return;
+      }
+      if (read != null) {
+        assertThat(contextOf(read).size()).isLessThanOrEqualTo(1000);
+      }
+    }
+  }
+}
