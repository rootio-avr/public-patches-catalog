+package com.hazelcast.internal.serialization.impl.compact;
+
+import com.hazelcast.config.ClassFilter;
+
+import javax.annotation.Nonnull;
+
+/**
+ * Decides which classes must never be handled by the reflective (zero-config)
+ * Compact serializer. A class can be named by the remote peer (as the type
+ * name of a Compact schema) and is then loaded and instantiated reflectively,
+ * so JDK classes and internal classes that give access to raw memory or to
+ * internals of the member must be excluded.
+ */
+public final class ReflectiveClassFilter {
+
+    private static final ClassFilter BLOCK_LIST = new ClassFilter()
+            .addPrefixes("java.", "javax.", "com.sun.", "sun.", "jdk.", "com.hazelcast.shaded.", "org.jctools.")
+            .addPackages("org.jctools.queues")
+            .addClasses(
+                    "com.hazelcast.internal.serialization.impl.HeapData",
+                    "com.hazelcast.internal.nio.Packet",
+                    "com.hazelcast.internal.serialization.impl.UnsafeObjectDataInput",
+                    "org.agrona.concurrent.status.AtomicCounter"
+            );
+
+    private ReflectiveClassFilter() {
+    }
+
+    /**
+     * A class is restricted from direct reflective serialization if it is on
+     * the block list, or if it is a primitive, an array or {@code Void}.
+     *
+     * @param clazz The class to test
+     * @return Whether the class is restricted
+     */
+    public static boolean isRestricted(@Nonnull Class<?> clazz) {
+        // The package is null for primitives, arrays and Void. These are never
+        // directly associated with a reflective serializer.
+        return clazz.getPackage() == null || BLOCK_LIST.isListed(clazz.getName());
+    }
+}
