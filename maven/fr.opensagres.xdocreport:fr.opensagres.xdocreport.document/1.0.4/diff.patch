+    public void testExternalEntityNotResolved()
+        throws Exception
+    {
+        File secret = File.createTempFile( "xdocreport-xxe", ".txt" );
+        try
+        {
+            FileWriter fw = new FileWriter( secret );
+            fw.write( "TOP_SECRET_XXE_CONTENT" );
+            fw.close();
+
+            String xml =
+                "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" + "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \""
+                    + secret.toURI().toString() + "\">]><p>&xxe;</p>";
+            MockSAXXDocPreprocessor preprocessor = new MockSAXXDocPreprocessor();
+            InputStream stream = IOUtils.toInputStream( xml );
+            StringWriter writer = new StringWriter();
+            try
+            {
+                preprocessor.preprocess( "test", stream, writer, null, null, null );
+            }
+            catch ( Exception e )
+            {
+                // parsing may be rejected, the external entity must anyway not be resolved
+            }
+            assertFalse( "External entity must not be resolved (XXE).",
+                         writer.toString().contains( "TOP_SECRET_XXE_CONTENT" ) );
+        }
+        finally
+        {
+            secret.delete();
+        }
