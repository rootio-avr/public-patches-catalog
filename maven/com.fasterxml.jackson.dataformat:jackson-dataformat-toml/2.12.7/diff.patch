+++ b/toml/src/test/java/com/fasterxml/jackson/dataformat/toml/NestingDepthTest.java
@@ -0,0 +1,63 @@
+package com.fasterxml.jackson.dataformat.toml;
+
+import com.fasterxml.jackson.core.exc.StreamReadException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Regression test for CVE-2023-3894: deeply nested TOML documents must not
+ * trigger a {@link StackOverflowError}. Instead the parser enforces a maximum
+ * nesting depth and reports a normal parse exception.
+ *
+ * <p>The upstream fix (jackson-dataformats-text 5dd5f740) relies on the
+ * jackson-core 2.15 {@code StreamReadConstraints} API, which is not available
+ * in the 2.12.x baseline. This test therefore exercises the self-contained
+ * nesting-depth counter added to the TOML lexer.
+ */
+public class NestingDepthTest {
+    private final ObjectMapper TOML_MAPPER = new TomlMapper();
+
+    @Test
+    public void testDeeplyNestedInlineTables() throws Exception {
+        StringBuilder input = new StringBuilder();
+        input.append("a=");
+        for (int i = 0; i < 9999; i++) {
+            input.append("{b=");
+        }
+        try {
+            TOML_MAPPER.readTree(input.toString());
+            Assert.fail("Should not pass: deeply nested input must be rejected");
+        } catch (StreamReadException e) {
+            verifyException(e, "exceeds the maximum allowed nesting depth");
+        }
+    }
+
+    @Test
+    public void testDeeplyNestedArrays() throws Exception {
+        StringBuilder input = new StringBuilder();
+        input.append("a=");
+        for (int i = 0; i < 9999; i++) {
+            input.append('[');
+        }
+        try {
+            TOML_MAPPER.readTree(input.toString());
+            Assert.fail("Should not pass: deeply nested input must be rejected");
+        } catch (StreamReadException e) {
+            verifyException(e, "exceeds the maximum allowed nesting depth");
+        }
+    }
+
+    private void verifyException(Throwable e, String... matches) {
+        String msg = e.getMessage();
+        String lmsg = (msg == null) ? "" : msg.toLowerCase();
+        for (String match : matches) {
+            if (lmsg.indexOf(match.toLowerCase()) >= 0) {
+                return;
+            }
+        }
+        Assert.fail("Expected an exception containing one of "
+                + java.util.Arrays.asList(matches) + ", got: \"" + msg + "\"");
+    }
+}
