+package com.fasterxml.jackson.dataformat.toml;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Regression test for CVE-2023-3894 (OSS-Fuzz 50083): deeply nested TOML input
+ * used to trigger unbounded recursion in the jflex-generated lexer/parser and
+ * exhaust the JVM stack (StackOverflowError / DoS). The fix enforces a maximum
+ * nesting depth in the lexer.
+ *
+ * <p>Ported from upstream {@code FuzzTomlReadTest.testStackOverflow50083}. Since
+ * jackson-core 2.13 has no {@code StreamReadConstraints}/{@code
+ * StreamConstraintsException}, the backport enforces the limit locally and
+ * surfaces it as a {@link TomlStreamReadException} instead of a
+ * {@code StreamConstraintsException}.
+ */
+public class CVE20233894RegressionTest
+{
+    private final ObjectMapper TOML_MAPPER = new TomlMapper();
+
+    @Test
+    public void testStackOverflow50083() throws Exception
+    {
+        StringBuilder input = new StringBuilder();
+        for (int i = 0; i < 9999; i++) {
+            input.append("a={");
+        }
+        try {
+            TOML_MAPPER.readTree(input.toString());
+            Assert.fail("Should not pass");
+        } catch (TomlStreamReadException e) {
+            verifyException(e, "exceeds the maximum allowed nesting depth (1000)");
+        }
+    }
+
+    protected void verifyException(Throwable e, String... matches)
+    {
+        String msg = e.getMessage();
+        String lmsg = (msg == null) ? "" : msg.toLowerCase();
+        for (String match : matches) {
+            String lmatch = match.toLowerCase();
+            if (lmsg.indexOf(lmatch) >= 0) {
+                return;
+            }
+        }
+        Assert.fail("Expected an exception with one of substrings ("
+                + java.util.Arrays.asList(matches) + "): got one with message \"" + msg + "\"");
+    }
+}
