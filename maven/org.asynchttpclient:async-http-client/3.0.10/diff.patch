+                // Addressed to A. If the replay left B's socket pooled under A's key, this is served by B.
+                client.prepareGet("http://127.0.0.1:" + a.port() + "/admin")
+                        .setRealm(realmForA())
+                        .execute().get(30, TimeUnit.SECONDS);
+            }
