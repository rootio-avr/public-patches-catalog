+package org.asynchttpclient.netty.channel;
+
+import org.asynchttpclient.Realm;
+import org.asynchttpclient.Realm.AuthScheme;
+import org.asynchttpclient.proxy.ProxyServer;
+import org.asynchttpclient.proxy.ProxyType;
+import org.asynchttpclient.uri.Uri;
+import org.testng.annotations.Test;
+
+import static org.testng.Assert.assertEquals;
+import static org.testng.Assert.assertFalse;
+import static org.testng.Assert.assertNotEquals;
+import static org.testng.Assert.assertSame;
+import static org.testng.Assert.assertTrue;
+
+/**
+ * CVE-2026-107230: a pooled connection authenticated as one identity must never be handed to another.
+ */
+public class PrincipalScopedPartitionKeyTest {
+
+  private static final Object BASE = "http://example.com:80";
+
+  private static Realm ntlm(String user, String password, String domain) {
+    return new Realm.Builder(user, password).setScheme(AuthScheme.NTLM).setNtlmDomain(domain).build();
+  }
+
+  private static Realm negotiate(String user, String password) {
+    return new Realm.Builder(user, password).setScheme(AuthScheme.SPNEGO).build();
+  }
+
+  @Test
+  public void requestAuthenticatedSchemesKeepTheBaseKey() {
+    Realm basic = new Realm.Builder("alice", "pw").setScheme(AuthScheme.BASIC).build();
+    Realm digest = new Realm.Builder("alice", "pw").setScheme(AuthScheme.DIGEST).build();
+    assertSame(PrincipalScopedPartitionKey.scope(BASE, null, null, false), BASE);
+    assertSame(PrincipalScopedPartitionKey.scope(BASE, basic, null, false), BASE);
+    assertSame(PrincipalScopedPartitionKey.scope(BASE, digest, null, false), BASE);
+  }
+
+  @Test
+  public void sameIdentityShareAKey() {
+    assertEquals(PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "pw", "CORP"), null, false),
+            PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "pw", "CORP"), null, false));
+  }
+
+  @Test
+  public void differentDomainsDoNotShareAKey() {
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "pw", "CORP"), null, false),
+            PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "pw", "OTHER"), null, false));
+  }
+
+  @Test
+  public void differentPasswordsDoNotShareAKey() {
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "one", "CORP"), null, false),
+            PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "two", "CORP"), null, false));
+  }
+
+  @Test
+  public void noPrincipalLoginIsStillScoped() {
+    Realm ambient = new Realm.Builder(null, null).setScheme(AuthScheme.SPNEGO).build();
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, ambient, null, false), BASE);
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, ambient, null, false),
+            PrincipalScopedPartitionKey.scope(BASE, negotiate("alice", "pw"), null, false));
+  }
+
+  @Test
+  public void loginContextAndServicePrincipalAreIdentityFields() {
+    Realm a = new Realm.Builder("alice", "pw").setScheme(AuthScheme.SPNEGO).setLoginContextName("ctxA").build();
+    Realm b = new Realm.Builder("alice", "pw").setScheme(AuthScheme.SPNEGO).setLoginContextName("ctxB").build();
+    Realm c = new Realm.Builder("alice", "pw").setScheme(AuthScheme.SPNEGO).setServicePrincipalName("HTTP/a").build();
+    Realm d = new Realm.Builder("alice", "pw").setScheme(AuthScheme.SPNEGO).setServicePrincipalName("HTTP/b").build();
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, a, null, false), PrincipalScopedPartitionKey.scope(BASE, b, null, false));
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, c, null, false), PrincipalScopedPartitionKey.scope(BASE, d, null, false));
+  }
+
+  @Test
+  public void proxyLoginScopesTheTunnel() {
+    Realm basicProxyUserA = new Realm.Builder("a", "pw").setScheme(AuthScheme.BASIC).build();
+    Realm basicProxyUserB = new Realm.Builder("b", "pw").setScheme(AuthScheme.BASIC).build();
+    // CONNECT tunnel: even Basic proxy credentials authenticate the socket.
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, null, basicProxyUserA, true),
+            PrincipalScopedPartitionKey.scope(BASE, null, basicProxyUserB, true));
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, null, basicProxyUserA, true), BASE);
+    // Plain HTTP through an HTTP proxy carries the credentials on every request.
+    assertSame(PrincipalScopedPartitionKey.scope(BASE, null, basicProxyUserA, false), BASE);
+  }
+
+  @Test
+  public void proxySchemeIsPartOfTheIdentity() {
+    Realm proxyNtlm = ntlm("alice", "pw", "CORP");
+    Realm proxyNegotiate = negotiate("alice", "pw");
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, null, proxyNtlm, false),
+            PrincipalScopedPartitionKey.scope(BASE, null, proxyNegotiate, false));
+  }
+
+  @Test
+  public void originAndProxyIdentitiesAreNotInterchangeable() {
+    Realm alice = ntlm("alice", "pw", "CORP");
+    assertNotEquals(PrincipalScopedPartitionKey.scope(BASE, alice, null, false),
+            PrincipalScopedPartitionKey.scope(BASE, null, alice, false));
+  }
+
+  @Test
+  public void toStringDoesNotLeakTheCredentials() {
+    String printed = PrincipalScopedPartitionKey.scope(BASE, ntlm("alice", "s3cret", "CORP"), null, false).toString();
+    assertFalse(printed.contains("s3cret"));
+  }
+
+  @Test
+  public void socksProxyHopIsPerConnectionAndUsesItsOwnRealm() {
+    Realm socksRealm = new Realm.Builder("sock", "pw").setScheme(AuthScheme.BASIC).build();
+    ProxyServer socks = new ProxyServer.Builder("localhost", 1080).setProxyType(ProxyType.SOCKS_V5).setRealm(socksRealm).build();
+    ProxyServer http = new ProxyServer.Builder("localhost", 3128).build();
+    Uri plain = Uri.create("http://example.com/");
+    Uri secure = Uri.create("https://example.com/");
+
+    assertTrue(PrincipalScopedPartitionKey.proxyHopIsPerConnection(socks, plain));
+    assertFalse(PrincipalScopedPartitionKey.proxyHopIsPerConnection(http, plain));
+    assertTrue(PrincipalScopedPartitionKey.proxyHopIsPerConnection(http, secure));
+    assertFalse(PrincipalScopedPartitionKey.proxyHopIsPerConnection(null, secure));
+
+    // A redirect may clear the future's proxy realm; the SOCKS handshake still authenticates with the proxy's own.
+    assertSame(PrincipalScopedPartitionKey.proxyLogin(null, socks), socksRealm);
+    assertSame(PrincipalScopedPartitionKey.proxyLogin(null, http), null);
+  }
+}
