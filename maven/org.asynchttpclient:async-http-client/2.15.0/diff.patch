+/**
+ * CVE-2026-107230: the cached Kerberos logins must not collide for distinct identities.
+ */
+public class SpnegoEngineInstanceTest {
+
+  private static String unique() {
+    return "user-" + UUID.randomUUID();
+  }
+
+  @Test
+  public void sameLoginSharesTheEngine() {
+    String user = unique();
+    assertSame(SpnegoEngine.instance(user, "pw", null, "REALM", true, null, null),
+            SpnegoEngine.instance(user, "pw", null, "REALM", true, null, null));
+  }
+
+  @Test
+  public void differentRealmNamesDoNotShareTheEngine() {
+    String user = unique();
+    assertNotSame(SpnegoEngine.instance(user, "pw", null, "REALM-A", true, null, null),
+            SpnegoEngine.instance(user, "pw", null, "REALM-B", true, null, null));
+  }
+
+  @Test
+  public void differentServicePrincipalsDoNotShareTheEngine() {
+    String user = unique();
+    assertNotSame(SpnegoEngine.instance(user, "pw", "HTTP/a", "REALM", true, null, null),
+            SpnegoEngine.instance(user, "pw", "HTTP/b", "REALM", true, null, null));
+  }
+
+  @Test
+  public void canonicalHostnameFlagIsPartOfTheKey() {
+    String user = unique();
+    assertNotSame(SpnegoEngine.instance(user, "pw", null, "REALM", true, null, null),
+            SpnegoEngine.instance(user, "pw", null, "REALM", false, null, null));
+  }
+
+  @Test
+  public void delimiterLookalikesDoNotCollide() {
+    // Without length prefixes these two logins would concatenate to the same key.
+    SpnegoEngine one = SpnegoEngine.instance("ab", "pw", null, "c", true, null, null);
+    SpnegoEngine two = SpnegoEngine.instance("a", "pw", null, "bc", true, null, null);
+    assertNotSame(one, two);
+  }
+
+  @Test
+  public void customLoginConfigOrderDoesNotMatter() {
+    String user = unique();
+    Map<String, String> first = new LinkedHashMap<>();
+    first.put("a", "1");
+    first.put("b", "2");
+    Map<String, String> second = new LinkedHashMap<>();
+    second.put("b", "2");
+    second.put("a", "1");
+    assertSame(SpnegoEngine.instance(user, "pw", null, "REALM", true, first, null),
+            SpnegoEngine.instance(user, "pw", null, "REALM", true, second, null));
+    assertNotSame(SpnegoEngine.instance(user, "pw", null, "REALM", true, first, null),
+            SpnegoEngine.instance(user, "pw", null, "REALM", true, Collections.singletonMap("a", "1"), null));
+  }
+
+  @Test
+  public void changedPasswordReplacesTheEngine() {
+    String user = unique();
+    SpnegoEngine old = SpnegoEngine.instance(user, "one", null, "REALM", true, null, null);
+    SpnegoEngine renewed = SpnegoEngine.instance(user, "two", null, "REALM", true, null, null);
+    assertNotSame(old, renewed);
+    assertSame(renewed, SpnegoEngine.instance(user, "two", null, "REALM", true, null, null));
+  }
+}

