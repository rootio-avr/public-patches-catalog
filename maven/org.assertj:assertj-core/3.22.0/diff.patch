+package org.assertj.core.util.xml;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.catchThrowable;
+import static org.assertj.core.util.xml.XmlStringPrettyFormatter.xmlPrettyFormat;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.xml.sax.SAXParseException;
+
+/**
+ * Regression test for CVE-2026-24400 (CWE-611 XML External Entity).
+ * <p>
+ * {@link XmlStringPrettyFormatter#xmlPrettyFormat(String)} must not process DOCTYPE declarations or
+ * external entities: the hardened {@code DocumentBuilderFactory} disables DTDs, so any input carrying
+ * a DOCTYPE must be rejected instead of resolving external entities such as {@code file:///etc/hosts}.
+ */
+class XmlStringPrettyFormatter_CVE_2026_24400_Test {
+
+  @ParameterizedTest
+  @ValueSource(strings = {
+      // Injection into document content (general entity)
+      "<?xml version=\"1.0\"?>\n"
+          + "<!DOCTYPE root [\n"
+          + "  <!ENTITY xxe SYSTEM \"file:///etc/hosts\">\n"
+          + "]>\n"
+          + "<root>&xxe;</root>",
+      // Injection during document parsing (parameter entity)
+      "<?xml version=\"1.0\"?>\n"
+          + "<!DOCTYPE root [\n"
+          + "  <!ENTITY % xxe SYSTEM \"file:///etc/hosts\">\n"
+          + "  %xxe;\n"
+          + "]>\n"
+          + "<root>foo</root>"
+  })
+  void should_reject_doctype_declaration_to_prevent_xxe(String input) {
+    // WHEN
+    Throwable thrown = catchThrowable(() -> xmlPrettyFormat(input));
+    // THEN
+    assertThat(thrown).isInstanceOf(RuntimeException.class)
+                      .hasMessage("Unable to format XML string");
+    assertThat(thrown.getCause()).isInstanceOf(SAXParseException.class)
+                                 .hasMessageContaining("DOCTYPE is disallowed");
+  }
+
+  @Test
+  void should_still_format_plain_xml_prettily() {
+    // GIVEN
+    String xmlString = "<rss version=\"2.0\"><channel><title>ok</title></channel></rss>";
+    // WHEN
+    String result = xmlPrettyFormat(xmlString);
+    // THEN
+    assertThat(result).contains("<title>ok</title>");
+  }
+}
