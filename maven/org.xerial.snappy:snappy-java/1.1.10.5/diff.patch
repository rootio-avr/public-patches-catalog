+package org.xerial.snappy;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+
+import org.junit.Test;
+
+/**
+ * Regression test for CVE-2026-108106: the uncompressed length declared in a
+ * compressed header must be validated before it is trusted.
+ */
+public class SnappyUncompressedLengthTest
+{
+    // varint header declaring 0x7FFFFFFF (~2GB) uncompressed bytes, followed by a single literal byte
+    private static final byte[] OVERSIZED_HEADER = new byte[] {
+            (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, (byte) 0xFF, 0x07, 0x00, 0x41
+    };
+
+    @Test
+    public void roundTripStillWorks() throws IOException
+    {
+        byte[] input = new byte[10000];
+        byte[] compressed = Snappy.compress(input);
+        assertEquals(input.length, Snappy.uncompressedLength(compressed));
+        assertEquals(input.length, Snappy.uncompressedLength(compressed, 0, compressed.length));
+        assertEquals(input.length, Snappy.uncompress(compressed).length);
+    }
+
+    @Test
+    public void oversizedDeclaredLengthIsRejected() throws IOException
+    {
+        try {
+            Snappy.uncompressedLength(OVERSIZED_HEADER);
+            fail("expected SnappyIOException");
+        }
+        catch (SnappyIOException e) {
+            assertEquals(SnappyErrorCode.PARSING_ERROR, e.getErrorCode());
+        }
+        try {
+            Snappy.uncompress(OVERSIZED_HEADER);
+            fail("expected SnappyIOException");
+        }
+        catch (SnappyIOException e) {
+            assertEquals(SnappyErrorCode.PARSING_ERROR, e.getErrorCode());
+        }
+    }
+
+    @Test
+    public void oversizedDeclaredLengthIsRejectedForDirectBuffer() throws IOException
+    {
+        ByteBuffer buf = ByteBuffer.allocateDirect(OVERSIZED_HEADER.length);
+        buf.put(OVERSIZED_HEADER);
+        buf.flip();
+        try {
+            Snappy.uncompressedLength(buf);
+            fail("expected SnappyIOException");
+        }
+        catch (SnappyIOException e) {
+            assertEquals(SnappyErrorCode.PARSING_ERROR, e.getErrorCode());
+        }
+    }
+
+    @Test
+    public void outOfRangeOffsetIsRejected() throws IOException
+    {
+        byte[] compressed = Snappy.compress(new byte[100]);
+        try {
+            Snappy.uncompressedLength(compressed, 1, compressed.length);
+            fail("expected IllegalArgumentException");
+        }
+        catch (IllegalArgumentException expected) {
+            // ok
+        }
+    }
+}
