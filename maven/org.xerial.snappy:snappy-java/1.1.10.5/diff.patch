+package org.xerial.snappy;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+import java.io.IOException;
+
+import org.junit.Test;
+
+/**
+ * Regression test: the typed-array uncompress APIs must reject an uncompressed length that is not a multiple of the
+ * element size, instead of allocating an under-sized array that the native code then overflows.
+ */
+public class SnappyElementAlignmentTest
+{
+    private interface Call
+    {
+        void run(byte[] compressed) throws IOException;
+    }
+
+    private static void expectRejected(byte[] compressed, Call call)
+    {
+        try {
+            call.run(compressed);
+            fail("expected IOException for misaligned uncompressed length");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void rejectsMisalignedLength() throws Exception
+    {
+        // 7 is not a multiple of 2, 4 or 8
+        byte[] compressed = Snappy.compress(new byte[] {1, 2, 3, 4, 5, 6, 7});
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressCharArray(c); } });
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressShortArray(c); } });
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressIntArray(c); } });
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressFloatArray(c); } });
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressLongArray(c); } });
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressDoubleArray(c); } });
+    }
+
+    @Test
+    public void rejectsLengthAlignedToSmallerElementOnly() throws Exception
+    {
+        // 12 bytes: multiple of 2 and 4, but not of 8
+        byte[] compressed = Snappy.compress(new byte[12]);
+        assertEquals(6, Snappy.uncompressShortArray(compressed).length);
+        assertEquals(3, Snappy.uncompressIntArray(compressed).length);
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressLongArray(c); } });
+        expectRejected(compressed, new Call() { public void run(byte[] c) throws IOException { Snappy.uncompressDoubleArray(c); } });
+    }
+
+    @Test
+    public void acceptsAlignedLength() throws Exception
+    {
+        int[] data = {1, 2, 3, 4};
+        assertEquals(4, Snappy.uncompressIntArray(Snappy.compress(data)).length);
+        long[] ldata = {1L, 2L};
+        assertEquals(2, Snappy.uncompressLongArray(Snappy.compress(ldata)).length);
+    }
+}

