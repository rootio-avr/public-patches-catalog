+/**
+ * Typed-array uncompression must reject a declared uncompressed length that is not a multiple of the element size,
+ * instead of letting the native code write past the end of the Java array.
+ */
+public class SnappyElementAlignmentTest
+{
+    private static byte[] compressed(int byteLength)
+            throws IOException
+    {
+        return Snappy.compress(new byte[byteLength]);
+    }
+
+    @Test
+    public void misalignedCharArray()
+            throws Exception
+    {
+        try {
+            Snappy.uncompressCharArray(compressed(7));
+            fail("misaligned length must be rejected");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void misalignedShortArray()
+            throws Exception
+    {
+        try {
+            Snappy.uncompressShortArray(compressed(7));
+            fail("misaligned length must be rejected");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void misalignedIntArray()
+            throws Exception
+    {
+        try {
+            Snappy.uncompressIntArray(compressed(7));
+            fail("misaligned length must be rejected");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void misalignedFloatArray()
+            throws Exception
+    {
+        try {
+            Snappy.uncompressFloatArray(compressed(7));
+            fail("misaligned length must be rejected");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void misalignedLongArray()
+            throws Exception
+    {
+        try {
+            Snappy.uncompressLongArray(compressed(15));
+            fail("misaligned length must be rejected");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void misalignedDoubleArray()
+            throws Exception
+    {
+        try {
+            Snappy.uncompressDoubleArray(compressed(15));
+            fail("misaligned length must be rejected");
+        }
+        catch (IOException e) {
+            // expected
+        }
+    }
+
+    @Test
+    public void alignedArraysStillWork()
+            throws Exception
+    {
+        double[] d = {1.0, 2.5, -3.25};
+        assertArrayEquals(d, Snappy.uncompressDoubleArray(Snappy.compress(d)), 0.0);
+        long[] l = {1L, 2L, Long.MAX_VALUE};
+        assertArrayEquals(l, Snappy.uncompressLongArray(Snappy.compress(l)));
+        int[] i = {1, 2, 3};
+        assertArrayEquals(i, Snappy.uncompressIntArray(Snappy.compress(i)));
+        float[] f = {1f, 2f};
+        assertArrayEquals(f, Snappy.uncompressFloatArray(Snappy.compress(f)), 0f);
+        short[] s = {1, 2, 3};
+        assertArrayEquals(s, Snappy.uncompressShortArray(Snappy.compress(s)));
+        char[] c = {'a', 'b', 'c'};
+        assertArrayEquals(c, Snappy.uncompressCharArray(Snappy.compress(c)));
+    }
