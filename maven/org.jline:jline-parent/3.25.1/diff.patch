+/*
+ * Copyright (c) 2026, the original author(s).
+ *
+ * This software is distributable under the BSD license. See the terms of the
+ * BSD license in the documentation provided with this software.
+ *
+ * https://opensource.org/licenses/BSD-3-Clause
+ */
+package org.jline.builtins;
+
+import java.util.regex.Pattern;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Regression test for CVE-2026-77422: catastrophic backtracking (ReDoS) in the
+ * regex matching performed by jline-builtins commands (grep/less/nano/history).
+ *
+ * <p>A malicious pattern with nested quantifiers applied to crafted non-matching
+ * input can force Java's backtracking regex engine into exponential time. The
+ * fix routes matching through {@link SafeRegex}, which enforces a wall-clock
+ * deadline and returns {@code false} instead of hanging.</p>
+ */
+public class SafeRegexRegressionTest {
+
+    /**
+     * The classic ReDoS pattern: {@code (a+)+$}. Against a long run of 'a'
+     * characters terminated by a non-matching char, an unguarded matcher would
+     * backtrack for effectively unbounded time. The overall JUnit timeout
+     * asserts the guarded call returns promptly.
+     */
+    @Test
+    @Timeout(10)
+    public void findReturnsInsteadOfHangingOnCatastrophicBacktracking() {
+        Pattern evil = Pattern.compile("(a+)+$");
+        StringBuilder input = new StringBuilder();
+        for (int i = 0; i < 60; i++) {
+            input.append('a');
+        }
+        input.append('!'); // forces the engine to explore every backtracking path
+        // Without the SafeRegex deadline this call would not return in time.
+        assertFalse(SafeRegex.find(evil, input.toString()));
+    }
+
+    @Test
+    @Timeout(10)
+    public void matchesReturnsInsteadOfHangingOnCatastrophicBacktracking() {
+        Pattern evil = Pattern.compile("(a+)+");
+        StringBuilder input = new StringBuilder();
+        for (int i = 0; i < 60; i++) {
+            input.append('a');
+        }
+        input.append('!');
+        // matches() requires the whole input to match; the trailing '!' guarantees
+        // failure, so the engine backtracks exhaustively unless the deadline fires.
+        assertFalse(SafeRegex.matches(evil, input.toString()));
+    }
+
+    /** Normal input still matches correctly through the guarded API. */
+    @Test
+    @Timeout(10)
+    public void findStillMatchesNormalInput() {
+        Pattern p = Pattern.compile("wor");
+        assertTrue(SafeRegex.find(p, "hello world"));
+        assertFalse(SafeRegex.find(p, "hello there"));
+    }
+
+    /**
+     * compileGlob treats only '*' as special and escapes regex metacharacters,
+     * so it cannot be abused to inject an unsafe nested-quantifier regex and it
+     * matches literals literally.
+     */
+    @Test
+    @Timeout(10)
+    public void compileGlobEscapesMetacharactersAndHonorsStar() {
+        Pattern glob = SafeRegex.compileGlob("a.c*");
+        assertTrue(SafeRegex.matches(glob, "a.cXYZ"));
+        // '.' is a literal, not "any char": "aXc..." must not match.
+        assertFalse(SafeRegex.matches(glob, "aXcXYZ"));
+    }
+}
