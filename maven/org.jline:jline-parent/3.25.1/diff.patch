+package org.jline.builtins.telnet;
+
+import java.lang.reflect.Field;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Regression test for CVE-2026-56740 (GHSA-47qp-hqvx-6r3f).
+ *
+ * <p>A malicious telnet client could send an unbounded number of NEW-ENVIRON
+ * variables, or NAWS window-geometry values with absurdly large width/height,
+ * causing excessive memory/CPU consumption (denial of service). The fix in
+ * {@link TelnetIO} caps the accepted NEW-ENVIRON variable count and clamps the
+ * window geometry to believable upper bounds.
+ *
+ * <p>This test asserts the hardening constants introduced by the fix are
+ * present and sane, so a regression that removes the bounds is caught.
+ */
+public class Cve202656740RegressionTest {
+
+    private static int intConstant(String name) throws Exception {
+        Field f = TelnetIO.class.getDeclaredField(name);
+        f.setAccessible(true);
+        return f.getInt(null);
+    }
+
+    @Test
+    public void newEnvironVariableCountIsBounded() throws Exception {
+        // The fix introduces NE_VAR_COUNT_MAX to cap the number of NEW-ENVIRON
+        // variables read from a single subnegotiation.
+        int max = intConstant("NE_VAR_COUNT_MAX");
+        assertTrue(max > 0, "NE_VAR_COUNT_MAX must be a positive upper bound");
+        assertEquals(100, max, "NE_VAR_COUNT_MAX should match the hardened upstream value");
+    }
+
+    @Test
+    public void windowGeometryHasUpperBounds() throws Exception {
+        // The fix introduces LARGEST_BELIEVABLE_WIDTH/HEIGHT so that oversized
+        // NAWS geometry is rejected and falls back to defaults.
+        int largestWidth = intConstant("LARGEST_BELIEVABLE_WIDTH");
+        int largestHeight = intConstant("LARGEST_BELIEVABLE_HEIGHT");
+        int smallestWidth = intConstant("SMALLEST_BELIEVABLE_WIDTH");
+        int smallestHeight = intConstant("SMALLEST_BELIEVABLE_HEIGHT");
+
+        assertTrue(
+                largestWidth > smallestWidth,
+                "LARGEST_BELIEVABLE_WIDTH must exceed SMALLEST_BELIEVABLE_WIDTH");
+        assertTrue(
+                largestHeight > smallestHeight,
+                "LARGEST_BELIEVABLE_HEIGHT must exceed SMALLEST_BELIEVABLE_HEIGHT");
+        assertEquals(500, largestWidth, "LARGEST_BELIEVABLE_WIDTH should match the hardened upstream value");
+        assertEquals(500, largestHeight, "LARGEST_BELIEVABLE_HEIGHT should match the hardened upstream value");
+    }
+}

