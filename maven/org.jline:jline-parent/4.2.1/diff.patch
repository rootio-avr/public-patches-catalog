+package org.jline.utils;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Regression test for CVE-2026-77422: catastrophic regex backtracking (ReDoS).
+ */
+class SafeRegexTest {
+
+    private static String evilInput() {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 40; i++) {
+            sb.append('a');
+        }
+        return sb.append('!').toString();
+    }
+
+    @Test
+    void catastrophicPatternTimesOut() {
+        Pattern p = Pattern.compile("(a+)+b");
+        long start = System.nanoTime();
+        assertThrows(RegexTimeoutException.class, () -> SafeRegex.matcher(p, evilInput(), 200)
+                .find());
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000;
+        assertTrue(elapsedMs < 10_000, "matching must be aborted quickly, took " + elapsedMs + "ms");
+    }
+
+    @Test
+    void booleanHelpersReturnFalseOnTimeout() {
+        Pattern p = Pattern.compile("(a+)+b");
+        assertFalse(SafeRegex.find(p, evilInput()));
+        assertFalse(SafeRegex.matches(p, evilInput()));
+    }
+
+    @Test
+    void normalMatchingStillWorks() {
+        Pattern p = Pattern.compile("(a+)+b");
+        Matcher m = SafeRegex.matcher(p, "aaab");
+        assertTrue(m.matches());
+        assertTrue(SafeRegex.find(Pattern.compile("foo"), "xxfooxx"));
+        assertFalse(SafeRegex.matches(Pattern.compile("foo"), "xxfooxx"));
+    }
+}
