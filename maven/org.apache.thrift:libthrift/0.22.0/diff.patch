+package org.apache.thrift.transport;
+
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import javax.net.ssl.SSLSocket;
+
+/**
+ * Regression check for CVE-2026-41603: TSSLTransportFactory clients must verify the hostname.
+ *
+ * <p>Framework-free on purpose: the published libthrift POM has no JUnit dependency, so this class
+ * must compile with the plain JDK. Run it with {@code java ...TestTSSLTransportFactoryHostnameVerification}.
+ */
+public class TestTSSLTransportFactoryHostnameVerification {
+
+  public static void main(String[] args) throws Exception {
+    clientSocketEnablesHttpsEndpointIdentification();
+  }
+
+  public static void clientSocketEnablesHttpsEndpointIdentification() throws Exception {
+    // The TLS handshake is lazy, so a plain listening socket is enough to
+    // obtain the client socket and inspect its SSL parameters.
+    try (ServerSocket listener = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+      TSocket client =
+          TSSLTransportFactory.getClientSocket(
+              InetAddress.getLoopbackAddress().getHostAddress(), listener.getLocalPort(), 1000);
+      try {
+        if (!(client.getSocket() instanceof SSLSocket)) {
+          throw new AssertionError("client socket is not an SSLSocket");
+        }
+        SSLSocket sslSocket = (SSLSocket) client.getSocket();
+        String algo = sslSocket.getSSLParameters().getEndpointIdentificationAlgorithm();
+        if (!"HTTPS".equals(algo)) {
+          throw new AssertionError("expected HTTPS endpoint identification but was " + algo);
+        }
+      } finally {
+        client.close();
+      }
+    }
+  }
+}
