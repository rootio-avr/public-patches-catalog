+package net.minidev.json.test;
+
+import net.minidev.json.JSONArray;
+import net.minidev.json.JSONValue;
+import net.minidev.json.parser.ParseException;
+
+import junit.framework.TestCase;
+
+/**
+ * Regression test for CVE-2023-1370.
+ *
+ * Deeply nested JSON must be rejected with ERROR_UNEXPECTED_JSON_DEPTH instead
+ * of triggering an unbounded recursion / StackOverflowError, while legitimate
+ * arrays of up to MAX_DEPTH sibling elements must still parse successfully
+ * (the depth counter is decremented on unstack).
+ */
+public class CVE20231370RegressionTest extends TestCase {
+	public void testDeeplyNestedThrowsDepthError() throws Exception {
+		int size = 10000;
+		StringBuilder sb = new StringBuilder(10 + size * 4);
+		for (int i = 0; i < size; i++) {
+			sb.append("{a:");
+		}
+		sb.append("true");
+		for (int i = 0; i < size; i++) {
+			sb.append("}");
+		}
+		try {
+			JSONValue.parseWithException(sb.toString());
+			fail("Expected ParseException for excessive JSON depth");
+		} catch (ParseException e) {
+			assertEquals(ParseException.ERROR_UNEXPECTED_JSON_DEPTH, e.getErrorType());
+		}
+	}
+
+	public void testArrayWith400ElementsParses() throws Exception {
+		int size = 400;
+		StringBuilder sb = new StringBuilder();
+		sb.append("[");
+		for (int i = 0; i < size; i++) {
+			sb.append("{a:true}");
+			if (i + 1 < size) {
+				sb.append(",");
+			}
+		}
+		sb.append("]");
+		JSONArray array = (JSONArray) JSONValue.parseWithException(sb.toString());
+		assertEquals(size, array.size());
+	}
+}
