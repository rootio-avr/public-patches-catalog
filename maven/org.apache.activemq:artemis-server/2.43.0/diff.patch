+package org.apache.activemq.artemis.core.config.impl;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import java.util.Properties;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Regression test for CVE-2026-27446.
+ *
+ * The fix adds a {@code federationDownstreamAuthorization} configuration
+ * parameter that is used to authorize unauthenticated/unauthorized Core
+ * downstream federation connect requests. This test verifies that the new
+ * configuration accessor exists and that the authorization role list is
+ * populated correctly from broker properties, which is the configuration
+ * surface the CORE-protocol authorization check relies on.
+ */
+public class CVE202627446RegressionTest {
+
+   @Test
+   public void testDownstreamAuthorizationDefaultsEmpty() {
+      ConfigurationImpl configuration = new ConfigurationImpl();
+      assertTrue(configuration.getFederationDownstreamAuthorization().isEmpty(),
+                 "downstream authorization must default to empty (deny-by-default when security is enabled)");
+   }
+
+   @Test
+   public void testAddDownstreamAuthorizationRole() {
+      ConfigurationImpl configuration = new ConfigurationImpl();
+      configuration.addFederationDownstreamAuthorization("a")
+                   .addFederationDownstreamAuthorization("b");
+      assertEquals(List.of("a", "b"), configuration.getFederationDownstreamAuthorization());
+   }
+
+   @Test
+   public void testParseDownstreamAuthorization() throws Exception {
+      Properties properties = new Properties();
+      properties.put("federationDownstreamAuthorization", "a,b,c,d,e");
+      ConfigurationImpl configuration = new ConfigurationImpl();
+      configuration.parsePrefixedProperties(properties, null);
+      assertEquals(5, configuration.getFederationDownstreamAuthorization().size());
+      assertEquals(List.of("a", "b", "c", "d", "e"), configuration.getFederationDownstreamAuthorization());
+   }
+}
