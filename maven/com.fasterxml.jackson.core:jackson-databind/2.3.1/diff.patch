+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.JavaType;
+import com.fasterxml.jackson.databind.jsontype.impl.ClassNameIdResolver;
+import com.fasterxml.jackson.databind.type.TypeFactory;
+
+/**
+ * Regression test for CVE-2018-7489 (incomplete fix for CVE-2017-7525).
+ *
+ * jackson-databind 2.3.1 resolves attacker-controlled class names to Class
+ * instances during default-typing deserialization with no denylist. The patch
+ * adds a defensive gadget-class denylist in
+ * {@link ClassNameIdResolver#_typeFromId} (which also covers
+ * MinimalClassNameIdResolver, since it delegates to super). These tests assert
+ * that (a) known gadget class names are rejected and (b) legitimate class names
+ * still resolve.
+ */
+public class TestCVE_2018_7489 extends BaseMapTest
+{
+    private ClassNameIdResolver resolver()
+    {
+        TypeFactory tf = TypeFactory.defaultInstance();
+        JavaType base = tf.constructType(Object.class);
+        return new ClassNameIdResolver(base, tf);
+    }
+
+    // (a) c3p0 DataSource gadget (the CVE-2018-7489 payload) must be blocked.
+    public void testC3p0DataSourceGadgetBlocked()
+    {
+        try {
+            resolver().typeFromId("com.mchange.v2.c3p0.WrapperConnectionPoolDataSource");
+            fail("Expected deserialization of c3p0 gadget class to be blocked");
+        } catch (IllegalArgumentException e) {
+            verifyException(e, "prevented for security reasons");
+        }
+    }
+
+    // (a) an exact-match nasty class (CVE-2017-7525 root) must be blocked too.
+    public void testTemplatesImplGadgetBlocked()
+    {
+        try {
+            resolver().typeFromId("com.sun.org.apache.xalan.internal.xsltc.trax.TemplatesImpl");
+            fail("Expected deserialization of TemplatesImpl gadget class to be blocked");
+        } catch (IllegalArgumentException e) {
+            verifyException(e, "prevented for security reasons");
+        }
+    }
+
+    // (b) a legitimate, benign class name must still resolve normally.
+    public void testLegitimateTypeStillResolves()
+    {
+        JavaType t = resolver().typeFromId("java.util.ArrayList");
+        assertNotNull(t);
+        assertEquals(java.util.ArrayList.class, t.getRawClass());
+    }
+}

