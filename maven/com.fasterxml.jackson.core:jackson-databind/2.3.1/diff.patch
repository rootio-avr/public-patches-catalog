+package com.fasterxml.jackson.databind.jsontype;
+
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.ObjectMapper.DefaultTyping;
+
+/**
+ * Regression test for CVE-2020-10673 (CWE-502): the caucho-quercus gadget class
+ * {@code com.caucho.config.types.ResourceRef} must not be resolved/deserialized
+ * via polymorphic default typing. jackson-databind 2.3.1 predates the
+ * SubTypeValidator denylist, so ClassNameIdResolver enforces an equivalent guard
+ * that rejects the blocked type id before the class is loaded.
+ */
+public class TestCVE202010673 extends BaseMapTest
+{
+    // Exact CVE gadget class name (present on caucho-quercus classpath in a
+    // vulnerable deployment). We assert on rejection of the *type id*, so the
+    // class need not be on the test classpath.
+    private static final String GADGET = "com.caucho.config.types.ResourceRef";
+
+    private ObjectMapper defaultTypingMapper() {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping(DefaultTyping.NON_FINAL);
+        return mapper;
+    }
+
+    // (a) previously-vulnerable input must no longer be deserialized
+    public void testBlockedGadgetTypeIdIsRejected() throws Exception
+    {
+        ObjectMapper mapper = defaultTypingMapper();
+        String payload = "[\"" + GADGET + "\",{}]";
+        try {
+            mapper.readValue(payload, Object.class);
+            fail("Expected deserialization of blocked gadget type '" + GADGET
+                    + "' to be rejected for CVE-2020-10673");
+        } catch (Exception e) {
+            // Guard raises IllegalArgumentException; Jackson may wrap it in a
+            // JsonMappingException. Either way the blocked class name must be
+            // referenced and the class must not have been resolved as a valid type.
+            Throwable t = e;
+            boolean mentioned = false;
+            while (t != null) {
+                String msg = t.getMessage();
+                if (msg != null && msg.contains(GADGET)) {
+                    mentioned = true;
+                    break;
+                }
+                t = t.getCause();
+            }
+            assertTrue("Rejection should reference the blocked class '" + GADGET
+                    + "', got: " + e, mentioned);
+        }
+    }
+
+    // (b) normal polymorphic input still works after the guard is added
+    public void testNormalTypeIdStillDeserializes() throws Exception
+    {
+        ObjectMapper mapper = defaultTypingMapper();
+        // A benign, always-present JDK type id round-trips as before.
+        String payload = "[\"java.util.ArrayList\",[\"x\",\"y\"]]";
+        Object result = mapper.readValue(payload, Object.class);
+        assertNotNull(result);
+        assertTrue("Expected a java.util.List, got: "
+                + (result == null ? "null" : result.getClass().getName()),
+                result instanceof java.util.List);
+        assertEquals(2, ((java.util.List<?>) result).size());
+    }
+}

