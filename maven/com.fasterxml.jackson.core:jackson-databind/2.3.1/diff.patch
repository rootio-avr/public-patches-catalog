+import com.fasterxml.jackson.databind.JavaType;
+import com.fasterxml.jackson.databind.jsontype.impl.ClassNameIdResolver;
+import com.fasterxml.jackson.databind.type.TypeFactory;
+
+/**
+ * Regression test for CVE-2020-10673 (CWE-502): the caucho-quercus gadget
+ * {@code com.caucho.config.types.ResourceRef} must be rejected at type-id
+ * resolution. 2.3.1 predates SubTypeValidator, so the name is added to the
+ * existing ClassNameIdResolver / BeanDeserializerFactory denylist.
+ */
