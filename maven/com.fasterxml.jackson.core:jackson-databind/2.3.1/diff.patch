+package com.fasterxml.jackson.databind.jsontype;
+
+import java.util.List;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Regression test for CVE-2021-20190: jackson-databind allowed the
+ * {@code javax.swing.JTextPane} (and related) gadget classes to be resolved as
+ * polymorphic subtypes when default typing is enabled, enabling SSRF / DoS via
+ * crafted type ids.
+ *<p>
+ * The 2.3.x branch predates upstream SubTypeValidator, so the fix is enforced by
+ * the inline gadget denylist consulted during type-id resolution: the dangerous
+ * class is blocked while legitimate polymorphic types continue to deserialize
+ * normally.
+ */
+public class CVE202120190RegressionTest
+{
+    // Base holder that triggers polymorphic (default typing) deserialization
+    static class Holder {
+        public Object value;
+    }
+
+    /**
+     * The gadget class must be rejected during default-typed deserialization.
+     */
+    @Test
+    public void testJTextPaneGadgetBlocked() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping();
+        String json = "[\"javax.swing.JTextPane\",{}]";
+        try {
+            mapper.readValue(json, Object.class);
+            fail("Expected deserialization of javax.swing.JTextPane to be blocked");
+        } catch (Exception e) {
+            String msg = String.valueOf(e.getMessage());
+            assertTrue("Expected security-related rejection, got: " + msg,
+                    msg.contains("prevented for security reasons")
+                    || msg.contains("javax.swing.JTextPane"));
+        }
+    }
+
+    /**
+     * The sibling gadget javax.swing.JEditorPane must also be rejected.
+     */
+    @Test
+    public void testJEditorPaneGadgetBlocked() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping();
+        String json = "[\"javax.swing.JEditorPane\",{}]";
+        try {
+            mapper.readValue(json, Object.class);
+            fail("Expected deserialization of javax.swing.JEditorPane to be blocked");
+        } catch (Exception e) {
+            String msg = String.valueOf(e.getMessage());
+            assertTrue("Expected security-related rejection, got: " + msg,
+                    msg.contains("prevented for security reasons")
+                    || msg.contains("javax.swing.JEditorPane"));
+        }
+    }
+
+    /**
+     * Legitimate polymorphic types must still round-trip normally: the denylist
+     * must not break unrelated default-typed deserialization.
+     */
+    @Test
+    public void testLegitimateTypeStillWorks() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping();
+        List<?> input = java.util.Arrays.asList("a", "b", "c");
+        String json = mapper.writeValueAsString(input);
+        Object out = mapper.readValue(json, Object.class);
+        assertTrue("Expected a List to be deserialized, got: "
+                + (out == null ? "null" : out.getClass().getName()),
+                out instanceof List);
+        assertEquals(3, ((List<?>) out).size());
+    }
+}

