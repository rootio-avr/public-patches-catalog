+package com.fasterxml.jackson.databind.interop;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.JsonMappingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Regression test guarding CVE-2020-24750 (CWE-502): polymorphic deserialization
+ * of the {@code com.pastdev.httpcomponents.configuration.JndiConfiguration} gadget
+ * (and other well-known "nasty" gadget classes) must be rejected with a security
+ * error rather than instantiated. The denylist and enforcement live in the
+ * CVE-2020-36181 backport (BeanDeserializerFactory.DEFAULT_NO_DESER_CLASS_NAMES /
+ * validateSubType), which already covers this gadget class; this patch only adds
+ * the regression test since the upstream test for [databind#2798] is not shipped
+ * in this target version's source tree.
+ */
+public class IllegalTypesCheckTest extends BaseMapTest
+{
+    static class PolyWrapper {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.CLASS,
+                include = JsonTypeInfo.As.WRAPPER_ARRAY)
+        public Object v;
+    }
+
+    // The CVE-2020-24750 gadget class name; blocking is name-based so the class
+    // does not need to be present on the test classpath.
+    private final static String GADGET_2798 =
+            "com.pastdev.httpcomponents.configuration.JndiConfiguration";
+
+    /**
+     * Primary regression: the JndiConfiguration gadget named by CVE-2020-24750
+     * must be blocked before a bean deserializer is built for it.
+     */
+    public void testJndiConfigurationGadget2798() throws Exception
+    {
+        _testIllegalType(GADGET_2798);
+    }
+
+    /**
+     * Sanity check that the broader denylist backport still rejects a
+     * classic gadget as well, so the mechanism is not JndiConfiguration-only.
+     */
+    public void testTemplatesImplGadget() throws Exception
+    {
+        _testIllegalType("com.sun.org.apache.xalan.internal.xsltc.trax.TemplatesImpl");
+    }
+
+    /**
+     * Guard against over-blocking: ordinary POJO deserialization must still work.
+     */
+    public void testPlainPojoStillDeserializes() throws Exception
+    {
+        ObjectMapper mapper = new ObjectMapper();
+        SimplePojo p = mapper.readValue("{\"name\":\"ok\",\"value\":7}", SimplePojo.class);
+        assertNotNull(p);
+        assertEquals("ok", p.name);
+        assertEquals(7, p.value);
+    }
+
+    static class SimplePojo {
+        public String name;
+        public int value;
+    }
+
+    private void _testIllegalType(String clsName) throws Exception
+    {
+        // While usually exploited via default typing, the name-based check applies
+        // regardless; use an explicit polymorphic wrapper to trigger construction.
+        String json = aposToQuotes("{'v':['"+clsName+"',{}]}");
+        ObjectMapper mapper = new ObjectMapper();
+        try {
+            mapper.readValue(json, PolyWrapper.class);
+            fail("Should not pass: expected security rejection of "+clsName);
+        } catch (JsonMappingException e) {
+            verifyException(e, "Illegal type");
+            verifyException(e, "prevented for security reasons");
+            verifyException(e, clsName);
+        }
+    }
+}

