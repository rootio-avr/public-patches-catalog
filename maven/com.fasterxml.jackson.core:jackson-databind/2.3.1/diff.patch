+package com.fasterxml.jackson.databind.interop;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.JsonMappingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Regression test for CVE-2020-24750 (CWE-502): polymorphic deserialization
+ * of {@code com.pastdev.httpcomponents.configuration.JndiConfiguration} must
+ * be rejected. The class is added to the shared denylist by CVE-2020-36181;
+ * this file only adds the regression test (IllegalTypesCheckTest already
+ * exists from CVE-2017-15095).
+ */
+public class TestCVE202024750 extends BaseMapTest
+{
+    static class PolyWrapper {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.CLASS,
+                include = JsonTypeInfo.As.WRAPPER_ARRAY)
+        public Object v;
+    }
+
+    private final static String GADGET_2798 =
+            "com.pastdev.httpcomponents.configuration.JndiConfiguration";
+
+    public void testJndiConfigurationGadget2798() throws Exception
+    {
+        _testIllegalType(GADGET_2798);
+    }
+
+    public void testPlainPojoStillDeserializes() throws Exception
+    {
+        ObjectMapper mapper = new ObjectMapper();
+        SimplePojo p = mapper.readValue("{\"name\":\"ok\",\"value\":7}", SimplePojo.class);
+        assertNotNull(p);
+        assertEquals("ok", p.name);
+        assertEquals(7, p.value);
+    }
+
+    static class SimplePojo {
+        public String name;
+        public int value;
+    }
+
+    private void _testIllegalType(String clsName) throws Exception
+    {
+        String json = aposToQuotes("{'v':['"+clsName+"',{}]}");
+        ObjectMapper mapper = new ObjectMapper();
+        try {
+            mapper.readValue(json, PolyWrapper.class);
+            fail("Should not pass: expected security rejection of "+clsName);
+        } catch (JsonMappingException e) {
+            verifyException(e, "Illegal type");
+            verifyException(e, "prevented for security reasons");
+            verifyException(e, clsName);
+        }
+    }
+}

