+package com.fasterxml.jackson.databind.deser;
+
+import java.util.List;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+import com.fasterxml.jackson.annotation.JsonTypeInfo;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+/**
+ * Regression test for CVE-2020-36182: polymorphic deserialization must refuse
+ * to construct the {@code org.apache.tomcat.dbcp.dbcp2.cpdsadapter.DriverAdapterCPDS}
+ * gadget (and its siblings) even when default typing / an Object base is used.
+ * The denylist and enforcement live in the CVE-2020-36181 backport
+ * (BeanDeserializerFactory.DEFAULT_NO_DESER_CLASS_NAMES / validateSubType),
+ * which already covers these gadget class names; this patch only adds the
+ * regression test.
+ */
+public class CVE202036182RegressionTest
+{
+    public static class Wrapper {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.CLASS)
+        public Object payload;
+    }
+
+    @Test
+    public void gadgetTypeIsBlocked() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        String json = "{\"payload\":[\"org.apache.tomcat.dbcp.dbcp2.cpdsadapter.DriverAdapterCPDS\","
+                + "{\"description\":\"x\"}]}";
+        try {
+            mapper.readValue(json, Wrapper.class);
+            fail("Expected deserialization of blocked gadget type to be rejected");
+        } catch (Exception e) {
+            assertTrue("Expected security rejection message, got: " + e.getMessage(),
+                    String.valueOf(e.getMessage()).contains("prevented for security reasons"));
+        }
+    }
+
+    @Test
+    public void benignTypeStillWorks() throws Exception {
+        ObjectMapper mapper = new ObjectMapper();
+        List<?> value = mapper.readValue("[1,2,3]", List.class);
+        assertEquals(3, value.size());
+    }
+}

