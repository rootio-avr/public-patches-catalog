+package com.fasterxml.jackson.databind.interop;
+
+import java.lang.reflect.Field;
+import java.util.Set;
+
+import com.fasterxml.jackson.databind.BaseMapTest;
+import com.fasterxml.jackson.databind.JsonMappingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.deser.BeanDeserializerFactory;
+
+/**
+ * Regression test for CVE-2019-14439 (databind#2389).
+ *<p>
+ * The fix extends the polymorphic-deserialization denylist
+ * ({@code DEFAULT_NO_DESER_CLASS_NAMES} / {@code checkIllegalTypes}) so that
+ * dangerous gadget classes can no longer be instantiated via default typing.
+ * The specific gadget reported for this CVE is
+ * {@code ch.qos.logback.core.db.JNDIConnectionSource}.
+ *<p>
+ * The upstream fix commit shipped no test, so this is a grounded replacement:
+ * it asserts (1) the CVE gadget string is registered in the denylist and
+ * (2) the {@code checkIllegalTypes} guard actually rejects a denied,
+ * JDK-bundled class under default typing.
+ */
+public class CVE201914439RegressionTest extends BaseMapTest
+{
+    /**
+     * The gadget class named by CVE-2019-14439. Logback is not on the test
+     * classpath, so we assert on the registered name rather than the type.
+     */
+    private final static String CVE_GADGET = "ch.qos.logback.core.db.JNDIConnectionSource";
+
+    /**
+     * JDK-bundled class that is also present in the denylist -- lets us drive
+     * the deserialization path without pulling in a 3rd-party dependency.
+     */
+    private final static String JDK_DENIED = "java.util.logging.FileHandler";
+
+    @SuppressWarnings("unchecked")
+    public void testCveGadgetIsBlacklisted() throws Exception
+    {
+        Field f = BeanDeserializerFactory.class.getDeclaredField("DEFAULT_NO_DESER_CLASS_NAMES");
+        f.setAccessible(true);
+        Set<String> denied = (Set<String>) f.get(null);
+        assertTrue("CVE-2019-14439 gadget must be denylisted: " + CVE_GADGET,
+                denied.contains(CVE_GADGET));
+    }
+
+    public void testDeniedTypeRejectedUnderDefaultTyping() throws Exception
+    {
+        ObjectMapper mapper = new ObjectMapper();
+        mapper.enableDefaultTyping(ObjectMapper.DefaultTyping.NON_FINAL);
+        String json = "[\"" + JDK_DENIED + "\",{}]";
+        try {
+            mapper.readValue(json, Object.class);
+            fail("Should not pass; expected a JsonMappingException for denied type " + JDK_DENIED);
+        } catch (JsonMappingException e) {
+            verifyException(e, "prevented for security reasons");
+        }
+    }
+}

