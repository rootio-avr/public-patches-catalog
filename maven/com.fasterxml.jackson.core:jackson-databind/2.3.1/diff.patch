+    /**
+     * Helper method used to check whether given type is one of "nasty classes"
+     * whose deserialization is prevented for security reasons (potential for
+     * remote code execution or similar attacks via polymorphic/default typing).
+     * Backport of the block-list validation introduced upstream in
+     * {@code SubTypeValidator} to address CVE-2020-36179/36180/36181/36182 and
+     * related gadget-chain CVEs.
+     */
+    protected void validateSubType(DeserializationContext ctxt, JavaType type)
+        throws JsonMappingException
+    {
+        // There are certain nasty classes that could cause problems, mostly
+        // via default typing -- catch them here.
+        final Class<?> raw = type.getRawClass();
+        final String full = raw.getName();
+
+        main_check:
+        do {
+            if (DEFAULT_NO_DESER_CLASS_NAMES.contains(full)) {
+                break;
+            }
+            // As per [databind#1855], need bit more sophisticated handling for
+            // some Spring framework types; only applies to classes, not interfaces
+            if (raw.isInterface()) {
+                ;
+            } else if (full.startsWith(PREFIX_SPRING)) {
+                for (Class<?> cls = raw; (cls != null) && (cls != Object.class); cls = cls.getSuperclass()) {
+                    String name = cls.getSimpleName();
+                    // looking for "AbstractBeanFactoryPointcutAdvisor" but no point to allow any
+                    if ("AbstractPointcutAdvisor".equals(name)
+                            // ditto for "FileSystemXmlApplicationContext": block all ApplicationContexts
+                            || "AbstractApplicationContext".equals(name)) {
+                        break main_check;
+                    }
+                }
+            } else if (full.startsWith(PREFIX_C3P0)) {
+                // [databind#1737], [databind#1931]: more 3rd party
+                if (full.endsWith("DataSource")) {
+                    break main_check;
+                }
+            }
+            return;
+        } while (false);
+
+        throw ctxt.mappingException(String.format(
+                "Illegal type (%s) to deserialize: prevented for security reasons", full));
     }
 
