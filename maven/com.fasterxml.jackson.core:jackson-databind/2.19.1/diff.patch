+        @JsonCreator
+        public CountingId(String value) { _value = value; }
+
+        @JsonValue
+        public String value() { return _value; }
+
+        @Override
+        public boolean equals(Object o) {
+            EQUALS_CALLS.incrementAndGet();
+            return (o instanceof CountingId) && _value.equals(((CountingId) o)._value);
+        }
