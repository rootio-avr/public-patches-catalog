+package graphql.parser
+
+import spock.lang.Specification
+
+/**
+ * Regression test for CVE-2022-37734.
+ *
+ * graphql-java before the fix would let the ANTLR lexer/parser eagerly consume an
+ * unbounded number of tokens for hostile input (a "billion laughs" / large-whitespace
+ * denial of service).  The fix bounds the number of grammar tokens (maxTokens) and
+ * whitespace tokens (maxWhitespaceTokens) via {@link ParserOptions} and a
+ * {@link SafeTokenSource} wrapper around the lexer, throwing a
+ * {@link ParseCancelledException} once the limit is exceeded.
+ *
+ * This is a fresh replacement test - the upstream ParserTest.groovy additions from
+ * commit 226aabd9 do not apply cleanly against the 16.2 test file.
+ */
+class CVE_2022_37734_Test extends Specification {
+
+    def "a large grammar-token attack is prevented by default"() {
+        given:
+        // each '@lol' pair produces multiple grammar tokens; 10000 of them blows past MAX_QUERY_TOKENS (15000)
+        def lol = "@lol" * 10000
+        def text = "query { f $lol }"
+
+        when:
+        Parser.parse(text)
+
+        then:
+        def e = thrown(ParseCancelledException)
+        e.getMessage().contains("parsing has been cancelled")
+    }
+
+    def "a large whitespace attack is prevented by default"() {
+        given:
+        def spaces = " " * 300_000
+        def text = "query { f $spaces }"
+
+        when:
+        Parser.parse(text)
+
+        then:
+        def e = thrown(ParseCancelledException)
+        e.getMessage().contains("parsing has been cancelled")
+    }
+
+    def "callers may opt out of the whitespace limit for their own large documents"() {
+        given:
+        def spaces = " " * 300_000
+        def text = "query { f $spaces }"
+        def options = ParserOptions.newParserOptions().maxWhitespaceTokens(Integer.MAX_VALUE).build()
+
+        when:
+        def doc = new Parser().parseDocument(text, options)
+
+        then:
+        doc != null
+    }
+
+    def "normal small queries still parse without being cancelled"() {
+        when:
+        def doc = Parser.parse("query { hello world }")
+
+        then:
+        doc != null
+    }
+
+    def "default query parser options carry the DOS-prevention limits"() {
+        expect:
+        ParserOptions.getDefaultParserOptions().getMaxTokens() == ParserOptions.MAX_QUERY_TOKENS
+        ParserOptions.getDefaultParserOptions().getMaxWhitespaceTokens() == ParserOptions.MAX_WHITESPACE_TOKENS
+        // SDL parsing is not the attack vector, so it is left unbounded
+        ParserOptions.getDefaultSdlParserOptions().getMaxTokens() == Integer.MAX_VALUE
+        ParserOptions.getDefaultSdlParserOptions().getMaxWhitespaceTokens() == Integer.MAX_VALUE
+    }
+}
