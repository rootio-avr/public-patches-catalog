+package graphql.introspection
+
+import graphql.GraphQL
+import graphql.TestUtil
+import spock.lang.Specification
+
+/**
+ * Regression test for CVE-2024-40094.
+ *
+ * A crafted introspection query can explode into an excessive number of normalized fields (ENFs)
+ * during query normalization, allowing a denial of service via modest sized queries.  The fix
+ * normalizes introspection operations under a bounded field-count / depth limit up front and aborts
+ * execution when those good-faith limits are exceeded, while legitimate introspection continues to work.
+ */
+class GoodFaithIntrospectionTest extends Specification {
+
+    def graphQLSchema = TestUtil.schema("""
+            type Query {
+                hello: String
+            }
+        """)
+
+    def graphQL = GraphQL.newGraphQL(graphQLSchema).build()
+
+    def "a normal introspection query is allowed"() {
+        given:
+        def query = IntrospectionQuery.INTROSPECTION_QUERY
+
+        when:
+        def result = graphQL.execute(query)
+
+        then:
+        result.errors.isEmpty()
+        result.data != null
+        result.data["__schema"] != null
+    }
+
+    def "a small explicit introspection query is allowed"() {
+        given:
+        def query = '{ __type(name: "Query") { name kind } }'
+
+        when:
+        def result = graphQL.execute(query)
+
+        then:
+        result.errors.isEmpty()
+        result.data["__type"]["name"] == "Query"
+    }
+
+    def "a deeply nested introspection query is aborted"() {
+        given:
+        // craft a __type query with deeply nested ofType selections that blows past the good faith depth limit
+        StringBuilder sb = new StringBuilder()
+        int depth = 60
+        depth.times { sb.append("ofType { name ") }
+        depth.times { sb.append("} ") }
+        def query = """
+            {
+                __type(name: "Query") {
+                    name
+                    ${sb.toString()}
+                }
+            }
+        """
+
+        when:
+        def result = graphQL.execute(query)
+
+        then:
+        !result.errors.isEmpty()
+        result.errors[0].message.contains("Maximum query depth exceeded")
+    }
+
+    def "a wide introspection query that creates too many fields is aborted"() {
+        given:
+        // craft many aliased __type introspection fields, each expanding into many normalized fields,
+        // so the total number of ENFs exceeds the good faith field-count limit
+        StringBuilder sb = new StringBuilder()
+        sb.append("{\n")
+        200.times { i ->
+            sb.append("  a${i}: __type(name: \"Query\") { name kind fields { name } inputFields { name } interfaces { name } possibleTypes { name } enumValues { name } }\n")
+        }
+        sb.append("}\n")
+        def query = sb.toString()
+
+        when:
+        def result = graphQL.execute(query)
+
+        then:
+        !result.errors.isEmpty()
+        result.errors[0].message.contains("Maximum field count exceeded")
+    }
+}
