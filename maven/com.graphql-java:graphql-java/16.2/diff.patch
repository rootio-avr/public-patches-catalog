+package graphql.parser
+
+import spock.lang.Specification
+
+/**
+ * Regression test for CVE-2023-28867.
+ *
+ * A crafted GraphQL query with deeply nested parser rules used to cause stack
+ * consumption (StackOverflowError) and a denial of service, because the parser
+ * imposed no limit on grammar rule recursion depth. The fix limits the depth of
+ * parser rules (Parser.MAX_RULE_DEPTH) and throws a ParseCancelledTooDeepException
+ * instead of overflowing the stack.
+ *
+ * Grounded on the upstream ParserStressTest "deep query stack overflows are
+ * prevented by limiting the depth of rules" test (commit 8a1c884). The nesting
+ * count is kept well under ParserOptions.MAX_QUERY_TOKENS so the rule-depth guard
+ * trips before the CVE-2022-37734 token-count guard.
+ */
+class Cve202328867RegressionTest extends Specification {
+
+    static String mkDeepQuery(int howMany) {
+        def field = 'f(a:"")'
+        StringBuilder sb = new StringBuilder("query q{")
+        for (int i = 0; i < howMany; i++) {
+            sb.append(field)
+            if (i < howMany - 1) {
+                sb.append("{")
+            }
+        }
+        for (int i = 0; i < howMany - 1; i++) {
+            sb.append("}")
+        }
+        sb.append("}")
+        return sb.toString()
+    }
+
+    def "deeply nested queries are prevented instead of overflowing the stack"() {
+        given:
+        String text = mkDeepQuery(500)
+
+        when:
+        Parser.parse(text)
+
+        then:
+        def e = thrown(ParseCancelledTooDeepException)
+        e.getMessage().contains("parsing has been cancelled")
+    }
+
+    def "normal shallow queries still parse successfully"() {
+        given:
+        String text = "query q { f(a:\"\") { g } }"
+
+        when:
+        def document = Parser.parse(text)
+
+        then:
+        document != null
+        document.definitions.size() == 1
+    }
+}

