+package graphql.parser;
+
+import graphql.Internal;
+import graphql.language.SourceLocation;
+
+/**
+ * Thrown when a GraphQL document is parsed and the depth of the grammar rules
+ * exceeds the configured maximum. This prevents stack consumption (StackOverflowError)
+ * denial-of-service attacks via deeply nested queries (CVE-2023-28867).
+ */
+@Internal
+public class ParseCancelledTooDeepException extends InvalidSyntaxException {
+
+    ParseCancelledTooDeepException(SourceLocation sourceLocation, String offendingToken, int maxDepth) {
+        super(sourceLocation,
+                String.format("More than %d deep 'grammar' rules have been entered. To prevent Denial Of Service attacks, parsing has been cancelled.", maxDepth),
+                null, offendingToken, null);
+    }
+}
