+package graphql.introspection
+
+import graphql.ExecutionInput
+import graphql.GraphQL
+import graphql.TestUtil
+import graphql.execution.CoercedVariables
+import graphql.language.Document
+import graphql.normalized.ExecutableNormalizedOperationFactory
+import graphql.execution.AbortExecutionException
+import spock.lang.Specification
+
+/**
+ * Regression test for CVE-2024-40094 (CWE-770 - unbounded ENF creation via crafted introspection queries).
+ *
+ * The upstream feature test GoodFaithIntrospectionInstrumentationTest.groovy does not exist in this
+ * version, so this replacement test verifies the back-ported mitigation:
+ *   1. ExecutableNormalizedOperationFactory can cap the number of ENFs and the operation depth.
+ *   2. A bad-faith introspection query (asking for __schema more than once) is rejected at execution time.
+ *   3. A normal, good-faith introspection query still succeeds.
+ */
+class GoodFaithIntrospectionTest extends Specification {
+
+    def schema = """
+        type Query {
+            hello: String
+            foo: Foo
+        }
+        type Foo {
+            bar: Bar
+        }
+        type Bar {
+            baz: String
+        }
+    """
+
+    def "factory rejects operations that exceed the maximum field count"() {
+        given:
+        def graphQLSchema = TestUtil.schema(schema)
+        def query = """
+            query {
+                a: hello
+                b: hello
+                c: hello
+            }
+        """
+        Document document = TestUtil.parseQuery(query)
+
+        def options = ExecutableNormalizedOperationFactory.Options.defaultOptions().maxFieldsCount(2)
+
+        when:
+        ExecutableNormalizedOperationFactory.createExecutableNormalizedOperation(
+                graphQLSchema,
+                document.getDefinitionsOfType(graphql.language.OperationDefinition).get(0),
+                [:],
+                CoercedVariables.emptyVariables(),
+                options)
+
+        then:
+        def e = thrown(AbortExecutionException)
+        e.message.contains("Maximum field count exceeded")
+    }
+
+    def "factory rejects operations that exceed the maximum depth"() {
+        given:
+        def graphQLSchema = TestUtil.schema(schema)
+        def query = """
+            query {
+                foo { bar { baz } }
+            }
+        """
+        Document document = TestUtil.parseQuery(query)
+
+        def options = ExecutableNormalizedOperationFactory.Options.defaultOptions().maxChildrenDepth(2)
+
+        when:
+        ExecutableNormalizedOperationFactory.createExecutableNormalizedOperation(
+                graphQLSchema,
+                document.getDefinitionsOfType(graphql.language.OperationDefinition).get(0),
+                [:],
+                CoercedVariables.emptyVariables(),
+                options)
+
+        then:
+        def e = thrown(AbortExecutionException)
+        e.message.contains("Maximum query depth exceeded")
+    }
+
+    def "factory allows operations within the configured limits"() {
+        given:
+        def graphQLSchema = TestUtil.schema(schema)
+        def query = """
+            query {
+                foo { bar { baz } }
+            }
+        """
+        Document document = TestUtil.parseQuery(query)
+
+        def options = ExecutableNormalizedOperationFactory.Options.defaultOptions()
+                .maxFieldsCount(100)
+                .maxChildrenDepth(100)
+
+        when:
+        def operation = ExecutableNormalizedOperationFactory.createExecutableNormalizedOperation(
+                graphQLSchema,
+                document.getDefinitionsOfType(graphql.language.OperationDefinition).get(0),
+                [:],
+                CoercedVariables.emptyVariables(),
+                options)
+
+        then:
+        operation != null
+        !operation.getTopLevelFields().isEmpty()
+    }
+
+    def "bad faith introspection query asking for __schema twice is rejected"() {
+        given:
+        def graphQLSchema = TestUtil.schema(schema)
+        def graphql = GraphQL.newGraphQL(graphQLSchema).build()
+        def query = """
+            query {
+                a: __schema { queryType { name } }
+                b: __schema { queryType { name } }
+            }
+        """
+
+        when:
+        def er = graphql.execute(ExecutionInput.newExecutionInput(query).build())
+
+        then:
+        !er.errors.isEmpty()
+        er.errors[0].message.contains("not asking for introspection in good faith")
+    }
+
+    def "a normal good faith introspection query still works"() {
+        given:
+        def graphQLSchema = TestUtil.schema(schema)
+        def graphql = GraphQL.newGraphQL(graphQLSchema).build()
+        def query = """
+            query {
+                __schema { queryType { name } }
+            }
+        """
+
+        when:
+        def er = graphql.execute(ExecutionInput.newExecutionInput(query).build())
+
+        then:
+        er.errors.isEmpty()
+        er.getData() != null
+    }
+}
