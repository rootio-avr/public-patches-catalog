+        assertTrue(result.value instanceof StringValue);
+        assertNull(result.secret,
+                "[databind#5971] @JsonView(AdminView) creator parameter was populated in PublicView " +
+                "via the external-type-id path. secret = " + result.secret);
+    }
+}
