--- /dev/null
+++ b/scripts/ensure-android-sdk.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Install the Android SDK pieces sentry-java 7.22.6 needs (AGP 7.4.2, compileSdk 34)
+# into $1 when the builder image does not ship an SDK. Idempotent: a second Gradle
+# invocation in the same container skips the download.
+set -eu
+
+SDK_ROOT="${1:-/opt/android-sdk}"
+MARKER_PLATFORM="${SDK_ROOT}/platforms/android-34/android.jar"
+MARKER_BUILD_TOOLS="${SDK_ROOT}/build-tools/34.0.0/source.properties"
+MARKER_NDK="${SDK_ROOT}/ndk/23.1.7779620/source.properties"
+MARKER_CMAKE="${SDK_ROOT}/cmake/3.22.1/bin/cmake"
+
+if [ -f "${MARKER_PLATFORM}" ] && [ -f "${MARKER_BUILD_TOOLS}" ] && [ -f "${MARKER_NDK}" ] && [ -x "${MARKER_CMAKE}" ]; then
+    echo "Android SDK already present at ${SDK_ROOT}"
+    exit 0
+fi
+
+if [ -z "${JAVA_HOME:-}" ] && [ -d /opt/java/openjdk ]; then
+    export JAVA_HOME=/opt/java/openjdk
+    export PATH="${JAVA_HOME}/bin:${PATH}"
+fi
+
+CMD_TOOLS="${SDK_ROOT}/cmdline-tools/latest"
+if [ ! -x "${CMD_TOOLS}/bin/sdkmanager" ]; then
+    echo "Downloading Android command-line tools into ${SDK_ROOT}"
+    tmp="$(mktemp -d)"
+    curl -fsSL --retry 3 --retry-delay 5 \
+        -o "${tmp}/cmdtools.zip" \
+        "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
+    unzip -q "${tmp}/cmdtools.zip" -d "${tmp}"
+    mkdir -p "${SDK_ROOT}/cmdline-tools"
+    rm -rf "${CMD_TOOLS}"
+    mv "${tmp}/cmdline-tools" "${CMD_TOOLS}"
+    rm -rf "${tmp}"
+fi
+
+mkdir -p "${SDK_ROOT}/licenses"
+printf '%s\n' "24333f8a63b6825ea9c5514f83c2829b004d1fee" > "${SDK_ROOT}/licenses/android-sdk-license"
+
+SDKMANAGER="${CMD_TOOLS}/bin/sdkmanager"
+# sdkmanager --licenses reads "y" until EOF and may exit 141 when yes is SIGPIPE'd.
+set +e
+yes | "${SDKMANAGER}" --sdk_root="${SDK_ROOT}" --licenses >/tmp/android-sdk-licenses.log 2>&1
+set -e
+
+echo "Installing Android platform 34, build-tools 34.0.0, NDK 23.1.7779620, CMake 3.22.1"
+"${SDKMANAGER}" --sdk_root="${SDK_ROOT}" \
+    "platforms;android-34" \
+    "build-tools;34.0.0" \
+    "ndk;23.1.7779620" \
+    "cmake;3.22.1"
+
+test -f "${MARKER_PLATFORM}"
+test -f "${MARKER_BUILD_TOOLS}"
+test -f "${MARKER_NDK}"
+test -x "${MARKER_CMAKE}"
+echo "Android SDK ready at ${SDK_ROOT}"
