index 0000000..53ddf0d
--- /dev/null
+++ b/scripts/ensure-android-sdk.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# Install the Android SDK pieces the zstd-jni .aar build needs (AGP 7.4.2, compileSdk 34)
+# into $1 when the builder image does not ship an SDK. Idempotent: a second invocation
+# in the same container skips the download.
+set -eu
+
+SDK_ROOT="${1:-/opt/android-sdk}"
+PLATFORM="android-34"
+BUILD_TOOLS="34.0.0"
+NDK="23.1.7779620"
+CMAKE="3.22.1"
+
+MARKER_PLATFORM="${SDK_ROOT}/platforms/${PLATFORM}/android.jar"
+MARKER_BUILD_TOOLS="${SDK_ROOT}/build-tools/${BUILD_TOOLS}/source.properties"
+MARKER_NDK="${SDK_ROOT}/ndk/${NDK}/source.properties"
+MARKER_CMAKE="${SDK_ROOT}/cmake/${CMAKE}/bin/cmake"
+
+if [ -f "${MARKER_PLATFORM}" ] && [ -f "${MARKER_BUILD_TOOLS}" ] && [ -f "${MARKER_NDK}" ] && [ -x "${MARKER_CMAKE}" ]; then
+    echo "Android SDK already present at ${SDK_ROOT}"
+    exit 0
+fi
+
+CMD_TOOLS="${SDK_ROOT}/cmdline-tools/latest"
+if [ ! -x "${CMD_TOOLS}/bin/sdkmanager" ]; then
+    echo "Downloading Android command-line tools into ${SDK_ROOT}"
+    tmp="$(mktemp -d)"
+    curl -fsSL --retry 3 --retry-delay 5 \
+        -o "${tmp}/cmdtools.zip" \
+        "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
+    unzip -q "${tmp}/cmdtools.zip" -d "${tmp}"
+    mkdir -p "${SDK_ROOT}/cmdline-tools"
+    rm -rf "${CMD_TOOLS}"
+    mv "${tmp}/cmdline-tools" "${CMD_TOOLS}"
+    rm -rf "${tmp}"
+fi
+
+SDKMANAGER="${CMD_TOOLS}/bin/sdkmanager"
+# sdkmanager --licenses reads "y" until EOF and may exit 141 when yes is SIGPIPE'd.
+set +e
+yes | "${SDKMANAGER}" --sdk_root="${SDK_ROOT}" --licenses >/tmp/android-sdk-licenses.log 2>&1
+set -e
+
+echo "Installing Android ${PLATFORM}, build-tools ${BUILD_TOOLS}, NDK ${NDK}, CMake ${CMAKE}"
+"${SDKMANAGER}" --sdk_root="${SDK_ROOT}" \
+    "platforms;${PLATFORM}" \
+    "build-tools;${BUILD_TOOLS}" \
+    "ndk;${NDK}" \
+    "cmake;${CMAKE}"
+
+test -f "${MARKER_PLATFORM}"
+test -f "${MARKER_BUILD_TOOLS}"
+test -f "${MARKER_NDK}"
+test -x "${MARKER_CMAKE}"
+echo "Android SDK ready at ${SDK_ROOT}"
