+package org.apache.log4j.net;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.InvalidClassException;
+import java.io.ObjectOutputStream;
+
+import junit.framework.TestCase;
+
+import org.apache.log4j.Level;
+import org.apache.log4j.Logger;
+import org.apache.log4j.spi.LoggingEvent;
+
+/**
+ * Regression test for CVE-2022-23307 (aka CVE-2020-9493).
+ *
+ * The Chainsaw {@code LoggingReceiver} used to deserialize socket data with a
+ * raw {@link java.io.ObjectInputStream}, allowing an attacker to send a
+ * serialized gadget object and trigger arbitrary code execution
+ * (CWE-502). The fix routes deserialization through
+ * {@link HardenedLoggingEventInputStream}, which only permits a small
+ * whitelist of log4j event classes (plus java.lang / java.util).
+ *
+ * This test asserts the hardened stream's contract directly: an object of a
+ * class that is not on the whitelist must be rejected with an
+ * {@link InvalidClassException}, while a legitimate {@link LoggingEvent}
+ * still round-trips successfully.
+ */
+public class Cve202223307RegressionTest extends TestCase {
+
+    public Cve202223307RegressionTest(String name) {
+        super(name);
+    }
+
+    private static byte[] serialize(Object o) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        ObjectOutputStream oos = new ObjectOutputStream(bos);
+        oos.writeObject(o);
+        oos.flush();
+        oos.close();
+        return bos.toByteArray();
+    }
+
+    /**
+     * A non-whitelisted class (java.io.File) must be refused before it can be
+     * instantiated during deserialization.
+     */
+    public void testUnauthorizedClassIsRejected() throws Exception {
+        byte[] payload = serialize(new File("/tmp/evil"));
+        HardenedLoggingEventInputStream hleis =
+            new HardenedLoggingEventInputStream(new ByteArrayInputStream(payload));
+        try {
+            hleis.readObject();
+            fail("Expected InvalidClassException for non-whitelisted class java.io.File");
+        } catch (InvalidClassException expected) {
+            // correct: hardened stream blocked the unauthorized class
+        } finally {
+            hleis.close();
+        }
+    }
+
+    /**
+     * A legitimate LoggingEvent (a whitelisted class) must still deserialize
+     * so that Chainsaw keeps working for valid traffic.
+     */
+    public void testLoggingEventIsAccepted() throws Exception {
+        Logger logger = Logger.getLogger(Cve202223307RegressionTest.class);
+        LoggingEvent event = new LoggingEvent(
+            Logger.class.getName(), logger, Level.INFO, "hello", null);
+        byte[] payload = serialize(event);
+        HardenedLoggingEventInputStream hleis =
+            new HardenedLoggingEventInputStream(new ByteArrayInputStream(payload));
+        try {
+            Object read = hleis.readObject();
+            assertTrue("expected a LoggingEvent", read instanceof LoggingEvent);
+            assertEquals("hello", ((LoggingEvent) read).getMessage());
+        } finally {
+            hleis.close();
+        }
+    }
+}

