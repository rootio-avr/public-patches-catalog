+package org.apache.log4j.net;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InvalidClassException;
+import java.io.ObjectInputStream;
+import java.io.ObjectStreamClass;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * An {@link ObjectInputStream} that restricts deserialization to a fixed
+ * allow-list of classes. This prevents the remote-code-execution and
+ * denial-of-service attacks described in CVE-2019-17571, where a malicious
+ * peer feeding a log4j {@code SocketNode}/{@code SocketServer} an arbitrary
+ * serialized object graph could trigger deserialization of unexpected
+ * (gadget) classes.
+ *
+ * <p>Only the classes required to reconstruct a {@link
+ * org.apache.log4j.spi.LoggingEvent} (plus the primitive/JDK types those
+ * classes reference) are permitted. Any other class encountered on the wire
+ * causes an {@link InvalidClassException} to be thrown before the class is
+ * resolved.</p>
+ *
+ * <p>Written for JDK 1.1 source compatibility (no generics / enhanced-for),
+ * matching the log4j 1.2 build configuration.</p>
+ */
+public class FilteredObjectInputStream extends ObjectInputStream {
+
+  private static final String[] DEFAULT_WHITELIST = new String[] {
+    "org.apache.log4j.spi.LoggingEvent",
+    "org.apache.log4j.spi.ThrowableInformation",
+    "org.apache.log4j.spi.LocationInfo",
+    "java.util.Hashtable",
+    "java.lang.String",
+    "java.lang.Integer",
+    "java.lang.Long",
+    "java.lang.Short",
+    "java.lang.Byte",
+    "java.lang.Boolean",
+    "java.lang.Character",
+    "java.lang.Number",
+    "java.lang.Object",
+    "[Ljava.lang.Object;",
+    "[Ljava.lang.String;",
+    "[B",
+    "[C",
+    "[I",
+    "[J",
+    "[S",
+    "[Z"
+  };
+
+  private final Set whitelistedClassNames;
+
+  public FilteredObjectInputStream(InputStream in) throws IOException {
+    super(in);
+    this.whitelistedClassNames = new HashSet();
+    this.whitelistedClassNames.addAll(Arrays.asList(DEFAULT_WHITELIST));
+  }
+
+  protected Class resolveClass(ObjectStreamClass desc)
+        throws IOException, ClassNotFoundException {
+    String name = desc.getName();
+    if (!isWhitelisted(name)) {
+      throw new InvalidClassException(
+          "Unauthorized deserialization attempt", name);
+    }
+    return super.resolveClass(desc);
+  }
+
+  private boolean isWhitelisted(String className) {
+    return whitelistedClassNames.contains(className);
+  }
+}
