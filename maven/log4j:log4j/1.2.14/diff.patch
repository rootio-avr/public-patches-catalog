+package org.apache.log4j.net;
+
+import junit.framework.TestCase;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.InvalidClassException;
+import java.io.ObjectOutputStream;
+
+import org.apache.log4j.Level;
+import org.apache.log4j.Logger;
+import org.apache.log4j.spi.LoggingEvent;
+
+/**
+ * Regression test for CVE-2019-17571.
+ *
+ * <p>log4j 1.2's {@code SocketNode}/{@code SocketServer} used a plain
+ * {@link java.io.ObjectInputStream} to read events off the wire, allowing a
+ * remote peer to deserialize arbitrary (gadget) classes. The fix routes that
+ * stream through {@link FilteredObjectInputStream}, which only permits the
+ * classes needed to reconstruct a {@link LoggingEvent} and rejects everything
+ * else.</p>
+ *
+ * <p>This test verifies both sides of that contract: a legitimate
+ * {@code LoggingEvent} still round-trips, while an unauthorized class (here a
+ * {@link java.io.File}) is refused with an {@link InvalidClassException}.</p>
+ */
+public class FilteredObjectInputStreamTest extends TestCase {
+
+  public FilteredObjectInputStreamTest(String name) {
+    super(name);
+  }
+
+  private static byte[] serialize(Object o) throws Exception {
+    ByteArrayOutputStream bos = new ByteArrayOutputStream();
+    ObjectOutputStream oos = new ObjectOutputStream(bos);
+    oos.writeObject(o);
+    oos.flush();
+    oos.close();
+    return bos.toByteArray();
+  }
+
+  /** A legitimate LoggingEvent must still deserialize successfully. */
+  public void testLoggingEventIsAllowed() throws Exception {
+    Logger logger = Logger.getLogger("cve.2019.17571.test");
+    LoggingEvent event = new LoggingEvent(
+        logger.getClass().getName(), logger, Level.INFO, "hello", null);
+
+    byte[] bytes = serialize(event);
+    FilteredObjectInputStream fois =
+        new FilteredObjectInputStream(new ByteArrayInputStream(bytes));
+    Object read = fois.readObject();
+    fois.close();
+
+    assertTrue("expected a LoggingEvent", read instanceof LoggingEvent);
+    assertEquals("hello", ((LoggingEvent) read).getMessage());
+  }
+
+  /** An unauthorized class must be rejected before it is resolved. */
+  public void testUnauthorizedClassIsRejected() throws Exception {
+    byte[] bytes = serialize(new java.io.File("/tmp/attacker"));
+    FilteredObjectInputStream fois =
+        new FilteredObjectInputStream(new ByteArrayInputStream(bytes));
+    try {
+      fois.readObject();
+      fail("expected InvalidClassException for unauthorized class");
+    } catch (InvalidClassException expected) {
+      // CVE-2019-17571 fix: gadget classes are refused on the wire.
+    } finally {
+      fois.close();
+    }
+  }
+}

Description: Fix CVE-2021-4104 — disable JMSAppender JNDI lookups by default
 JMSAppender.activateOptions() performed JNDI InitialContext lookups on
 attacker-controllable configuration values (TopicConnectionFactoryBindingName,
 TopicBindingName, InitialContextFactoryName, ProviderURL). An attacker with
 write access to the log4j configuration could point these at a malicious
 JNDI/RMI/LDAP provider, causing remote object loading and deserialization
 (CWE-502 / JNDI injection) leading to remote code execution, similar to
 CVE-2021-44228.
 .
 This patch makes JMSAppender secure-by-default: all JNDI activity is gated
 behind an explicit opt-in system property
 (org.apache.log4j.net.JMSAppender.enableJndiLookup=true). When the property is
 not set to "true", activateOptions() logs an error and returns before creating
 any InitialContext or performing any lookup, so the vulnerable deserialization
 path is never reached and the appender stays inert (topicConnection remains
 null). Legitimate deployments may deliberately re-enable JNDI via the property.
