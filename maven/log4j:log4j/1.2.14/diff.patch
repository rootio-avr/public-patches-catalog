+package org.apache.log4j.net;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.InvalidClassException;
+import java.io.ObjectOutputStream;
+import java.util.HashMap;
+import java.util.Hashtable;
+
+import junit.framework.TestCase;
+
+/**
+ * Regression test for CVE-2023-26464.
+ *
+ * Chainsaw deserializes through {@link HardenedLoggingEventInputStream} and
+ * SocketNode deserializes through {@link FilteredObjectInputStream}. Both
+ * allow java.util collections (every java.util class, or Hashtable
+ * specifically), so a deeply nested collection is a denial-of-service vector
+ * unless a JEP 290 depth filter rejects it. On JDKs without
+ * ObjectInputFilter the filter is absent and the nested graph still
+ * deserializes.
+ */
+public class Cve202326464Test extends TestCase {
+
+    public Cve202326464Test(String name) {
+        super(name);
+    }
+
+    private static byte[] serialize(Object o) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        ObjectOutputStream oos = new ObjectOutputStream(bos);
+        oos.writeObject(o);
+        oos.flush();
+        oos.close();
+        return bos.toByteArray();
+    }
+
+    private static boolean jep290Available() {
+        try {
+            Class.forName("java.io.ObjectInputFilter");
+            return true;
+        } catch (ClassNotFoundException e) {
+            return false;
+        }
+    }
+
+    private static HashMap nestedMap(int levels) {
+        HashMap root = new HashMap();
+        HashMap current = root;
+        int i;
+        for (i = 0; i < levels; i++) {
+            HashMap child = new HashMap();
+            current.put("next", child);
+            current = child;
+        }
+        return root;
+    }
+
+    private static Hashtable nestedTable(int levels) {
+        Hashtable root = new Hashtable();
+        Hashtable current = root;
+        int i;
+        for (i = 0; i < levels; i++) {
+            Hashtable child = new Hashtable();
+            current.put("next", child);
+            current = child;
+        }
+        return root;
+    }
+
+    public void testHardenedRejectsNonWhitelistedClass() throws Exception {
+        byte[] payload = serialize(new File("/tmp/evil"));
+        HardenedLoggingEventInputStream in =
+            new HardenedLoggingEventInputStream(new ByteArrayInputStream(payload));
+        try {
+            in.readObject();
+            fail("Expected InvalidClassException for java.io.File");
+        } catch (InvalidClassException expected) {
+            // allow-list rejected the class
+        } finally {
+            in.close();
+        }
+    }
+
+    public void testHardenedAcceptsShallowMap() throws Exception {
+        byte[] payload = serialize(nestedMap(1));
+        HardenedLoggingEventInputStream in =
+            new HardenedLoggingEventInputStream(new ByteArrayInputStream(payload));
+        try {
+            HashMap back = (HashMap) in.readObject();
+            assertTrue(back.get("next") instanceof HashMap);
+        } finally {
+            in.close();
+        }
+    }
+
+    public void testHardenedRejectsDeepMap() throws Exception {
+        byte[] payload = serialize(nestedMap(64));
+        HardenedLoggingEventInputStream in =
+            new HardenedLoggingEventInputStream(new ByteArrayInputStream(payload));
+        try {
+            in.readObject();
+            if (jep290Available()) {
+                fail("Expected the depth filter to reject a deeply nested HashMap");
+            }
+        } catch (InvalidClassException expected) {
+            assertTrue(jep290Available());
+        } finally {
+            in.close();
+        }
+    }
+
+    public void testFilteredAcceptsShallowHashtable() throws Exception {
+        byte[] payload = serialize(nestedTable(1));
+        FilteredObjectInputStream in =
+            new FilteredObjectInputStream(new ByteArrayInputStream(payload));
+        try {
+            Hashtable back = (Hashtable) in.readObject();
+            assertTrue(back.get("next") instanceof Hashtable);
+        } finally {
+            in.close();
+        }
+    }
+
+    public void testFilteredRejectsDeepHashtable() throws Exception {
+        byte[] payload = serialize(nestedTable(64));
+        FilteredObjectInputStream in =
+            new FilteredObjectInputStream(new ByteArrayInputStream(payload));
+        try {
+            in.readObject();
+            if (jep290Available()) {
+                fail("Expected the depth filter to reject a deeply nested Hashtable");
+            }
+        } catch (InvalidClassException expected) {
+            assertTrue(jep290Available());
+        } finally {
+            in.close();
+        }
+    }
+}
