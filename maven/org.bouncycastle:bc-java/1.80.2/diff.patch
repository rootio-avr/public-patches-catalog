+    /**
+     * Decrement the remaining nested-construction budget, throwing if it would go negative. This is
+     * used to bound the depth of nested constructed ASN.1 objects (SEQUENCE/SET/...) so that a
+     * crafted, deeply-nested encoding cannot exhaust the Java call stack (CWE-674).
+     *
+     * @param parentDepth remaining depth budget of the enclosing construction.
+     * @return the budget for the next nested level (parentDepth - 1).
+     * @throws IOException if the maximum nested construction level has been reached.
+     */
+    static int decrementDepth(int parentDepth) throws IOException
+    {
+        if (parentDepth <= 0)
+        {
+            throw new ASN1Exception("maximum nested construction level reached");
+        }
+        return parentDepth - 1;
+    }
+
+    /**
