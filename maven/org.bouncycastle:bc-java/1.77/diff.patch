+        if ((protocolVersion & 0xFFFF) != protocolVersion)
+        {
+            throw new IllegalArgumentException("'protocolVersion' must be a 16 bit value");
+        }
+
+        secureRandom = CryptoServicesRegistrar.getSecureRandom(secureRandom);
