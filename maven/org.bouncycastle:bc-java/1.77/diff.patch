+        int bitsOfSecurity = ConstraintUtils.bitsOfSecurityFor(modulus);
+        CryptoServicesRegistrar.checkConstraints(new DefaultServiceProperties("RSA", bitsOfSecurity, privateKey,
+            CryptoServicePurpose.DECRYPTION));
