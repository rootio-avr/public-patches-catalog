+++ b/pg/src/test/java/org/bouncycastle/bcpg/test/AEADChunkSizeCVE20263505Test.java
@@ -0,0 +1,79 @@
+package org.bouncycastle.bcpg.test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+
+import junit.framework.TestCase;
+import org.bouncycastle.bcpg.BCPGInputStream;
+import org.bouncycastle.bcpg.MarkerPacket;
+import org.bouncycastle.bcpg.Packet;
+import org.bouncycastle.bcpg.PacketTags;
+
+/**
+ * Regression test for CVE-2026-3505 (CWE-770, RFC 9580 5.13.2).
+ *
+ * An AEAD Encrypted Data Packet (packet tag 20) carries an attacker-controlled
+ * chunk-size octet that, if parsed without range validation, enables a
+ * pre-authentication resource-exhaustion DoS. bcpg-jdk15on 1.64 does not
+ * implement AEAD decryption, so the defensive fix rejects tag 20 explicitly at
+ * the packet-dispatch boundary (BCPGInputStream.readPacket()) before any
+ * chunk-size octet in the packet body can be consumed.
+ */
+public class AEADChunkSizeCVE20263505Test
+    extends TestCase
+{
+    // New-format packet header: 0xC0 | tag. AEAD_ENC_DATA == 20.
+    private static byte newFormatHeader(int tag)
+    {
+        return (byte)(0x80 | 0x40 | (tag & 0x3f));
+    }
+
+    /**
+     * A crafted AEAD Encrypted Data Packet whose body begins with an
+     * out-of-range chunk-size octet (0x3f) must be rejected deterministically
+     * rather than reaching any chunk-size-driven allocation path.
+     */
+    public void testAeadPacketRejectedBeforeChunkSizeConsumed()
+        throws IOException
+    {
+        assertEquals(20, PacketTags.AEAD_ENC_DATA);
+
+        // header | bodyLen=5 | version=2 | algo=9 | aeadAlgo=2 | chunkSize=0x3f | ...
+        byte[] crafted = new byte[] {
+            newFormatHeader(PacketTags.AEAD_ENC_DATA),
+            (byte)0x05, (byte)0x02, (byte)0x09, (byte)0x02, (byte)0x3f, (byte)0x00
+        };
+
+        BCPGInputStream in = new BCPGInputStream(new ByteArrayInputStream(crafted));
+        try
+        {
+            in.readPacket();
+            fail("AEAD Encrypted Data Packet (tag 20) must be rejected");
+        }
+        catch (IOException expected)
+        {
+            assertTrue("rejection must be attributable to the AEAD guard",
+                expected.getMessage() != null
+                    && expected.getMessage().indexOf("AEAD") >= 0);
+        }
+    }
+
+    /**
+     * A benign, fully-supported packet must still parse after the fix, proving
+     * the guard is narrowly scoped to the AEAD tag.
+     */
+    public void testNormalPacketStillParses()
+        throws IOException
+    {
+        // Marker packet (tag 10), body "PGP".
+        byte[] good = new byte[] {
+            newFormatHeader(PacketTags.MARKER),
+            (byte)0x03, (byte)'P', (byte)'G', (byte)'P'
+        };
+
+        BCPGInputStream in = new BCPGInputStream(new ByteArrayInputStream(good));
+        Packet p = in.readPacket();
+        assertNotNull("benign packet must still parse", p);
+        assertTrue("expected a MarkerPacket", p instanceof MarkerPacket);
+    }
+}
--- Build compatibility (Gradle 8.10.2 in native builder) ---
# CVE-2026-3505: the native maven builder invokes Gradle 8.10.2, which removed the
# pre-Gradle-7 DSL (testCompile/testRuntime/compile configurations, jar.baseName) and
# the never-applied cobertura extension used by bc-java 1.64 scripts. Migrate to
# testImplementation/testRuntimeOnly/implementation + jar.archiveBaseName, drop the
# unregistered cobertura blocks, and add the maven-publish plugin + a publication so the
# builder harvest step 'gradle <module>:publishToMavenLocal' has a task to run. Build/
# packaging only; no change to the shipped bytecode of the security fix.
