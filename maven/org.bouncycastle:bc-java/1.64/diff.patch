+    testRuntimeOnly "org.slf4j:slf4j-log4j12:1.7.5"
+    testRuntimeOnly "log4j:log4j:1.2.17"
   }
 }
 
@@ -50,6 +50,7 @@
 
 subprojects {
   apply plugin: 'eclipse'
+  apply plugin: 'maven-publish'
 
   sourceCompatibility = 1.8
   targetCompatibility = 1.8
@@ -62,37 +63,24 @@
       includeTestsMatching "*AllTests"
     }
   }
+
+  // CVE-2026-3505 build compatibility: the Root.io native maven builder harvests
+  // each module via `gradle <module>:publishToMavenLocal`, but bc-java 1.64 never
+  // applies the maven-publish plugin, so that task does not exist. Register a
+  // publication from the java component so publishToMavenLocal is available; the
+  // artifactId mirrors the module's jar base name (e.g. bcpg-jdk15on).
+  afterEvaluate {
+    publishing {
+      publications {
+        mavenJava(MavenPublication) {
+          from components.java
+          groupId = 'org.bouncycastle'
+          artifactId = tasks.jar.archiveBaseName.get()
+        }
+      }
+    }
+  }
 }
 
