+	static class MapSample {
+		Map<String, String> metadata;
+	}
+
+	@JsonAutoDetect(fieldVisibility = Visibility.ANY)
+	static class WithReadOnlyEmbedded {
+		String name;
+		@JsonProperty(access = Access.READ_ONLY) AuditInfo audit;
+	}
+
+	@JsonAutoDetect(fieldVisibility = Visibility.ANY)
+	static class AuditInfo {
+		String createdBy;
+	}
+
+	@JsonAutoDetect(fieldVisibility = Visibility.ANY)
+	static class WithReadOnlyCollection {
+		String name;
+		@JsonProperty(access = Access.READ_ONLY) List<String> roles;
+	}
+
+	static class MapWrapper {
+		Map<String, Person> people;
+
+		public Map<String, Person> getPeople() {
+			return this.people;
+		}
+
+		public void setPeople(Map<String, Person> people) {
+			this.people = people;
+		}
+	}
+
+	static class Person {
