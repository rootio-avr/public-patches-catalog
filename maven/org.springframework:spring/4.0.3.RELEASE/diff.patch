+		if (name.startsWith("[")) {
+			// Array type: unwrap to the component type.
+			int i = 0;
+			while (i < name.length() && name.charAt(i) == '[') {
+				i++;
+			}
+			name = name.substring(i);
+			if (name.length() > 1 && name.charAt(0) == 'L' && name.charAt(name.length() - 1) == ';') {
