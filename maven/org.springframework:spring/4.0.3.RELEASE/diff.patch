+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Regression test for CVE-2018-1272 (SPR-16635): the multipart boundary
+ * generator in {@link FormHttpMessageConverter} must use a cryptographically
+ * strong {@link SecureRandom} rather than a predictable java.util.Random, so
+ * that multipart boundaries cannot be guessed to mount a multipart injection /
+ * privilege escalation attack.
+ */
+public class Cve20181272RegressionTest {
+
+	@Test
+	public void boundaryRandomSourceIsSecureRandom() throws Exception {
+		FormHttpMessageConverter converter = new FormHttpMessageConverter();
+		Field rndField = FormHttpMessageConverter.class.getDeclaredField("rnd");
+		rndField.setAccessible(true);
+		Object rnd = rndField.get(converter);
+		assertNotNull("boundary random source must not be null", rnd);
+		assertTrue("boundary random source must be a SecureRandom (CVE-2018-1272)",
+				rnd instanceof SecureRandom);
+	}
+
+	@Test
+	public void generatedBoundariesAreWellFormedAndVaried() {
+		FormHttpMessageConverter converter = new FormHttpMessageConverter();
+		byte[] first = invokeBoundary(converter);
+		byte[] second = invokeBoundary(converter);
+		assertNotNull(first);
+		assertNotNull(second);
+		assertTrue("boundary length within expected range", first.length >= 30 && first.length <= 40);
+		// Two independently generated boundaries must not be identical.
+		assertTrue("boundaries must vary", !java.util.Arrays.equals(first, second));
+	}
+
+	private static byte[] invokeBoundary(FormHttpMessageConverter converter) {
+		try {
+			java.lang.reflect.Method m =
+					FormHttpMessageConverter.class.getDeclaredMethod("generateMultipartBoundary");
+			m.setAccessible(true);
+			return (byte[]) m.invoke(converter);
+		}
+		catch (Exception ex) {
+			throw new IllegalStateException(ex);
+		}
+	}
