+package org.springframework.remoting.httpinvoker;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InvalidClassException;
+import java.io.ObjectInputStream;
+import java.io.ObjectStreamClass;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.Set;
+
+/**
+ * Hardened {@link ObjectInputStream} that mitigates unsafe Java deserialization
+ * (CVE-2016-1000027, CWE-502) for Spring's HTTP invoker service exporters.
+ *
+ * <p>This stream enforces a fail-closed <b>class-name allow-list</b>: before any
+ * class is resolved during deserialization, its name is matched against a
+ * conservative baseline of remoting-infrastructure and common JDK value types,
+ * plus any additional names/prefixes explicitly configured by the deploying
+ * application. Any class that is not accepted causes an {@link InvalidClassException}
+ * to be thrown <i>before</i> the object graph is materialized, which prevents
+ * gadget-chain remote code execution through an exposed remoting endpoint.
+ *
+ * <p>The implementation deliberately relies only on {@link #resolveClass} /
+ * {@link #resolveProxyClass} (available since Java 1.2) so it remains compatible
+ * with the Java 8 baseline of the Spring Framework 5.3.x line.
+ *
+ * <p>Applications that legitimately transport custom argument types over HTTP
+ * invoker should add those class names (or {@code "some.package.*"} prefixes)
+ * via the {@code setAcceptedClassNames(...)} configuration on the exporter.
+ *
+ * @author Root.io Novel Patcher
+ * @since 5.3.31 (backported security hardening)
+ */
+class AllowListObjectInputStream extends ObjectInputStream {
+
+	/**
+	 * Baseline set of class names that are always accepted. Kept intentionally
+	 * narrow: remoting envelope types plus immutable/value JDK types and common
+	 * collection containers. None of these are known deserialization gadgets.
+	 */
+	private static final Set<String> DEFAULT_ACCEPTED_CLASS_NAMES;
+
+	private static final Set<String> DEFAULT_ACCEPTED_PACKAGE_PREFIXES;
+
+	static {
+		Set<String> names = new LinkedHashSet<String>();
+		// Spring remoting envelope
+		names.add("org.springframework.remoting.support.RemoteInvocation");
+		names.add("org.springframework.remoting.support.RemoteInvocationResult");
+		// Core immutable / value types
+		names.add("java.lang.String");
+		names.add("java.lang.Boolean");
+		names.add("java.lang.Byte");
+		names.add("java.lang.Character");
+		names.add("java.lang.Short");
+		names.add("java.lang.Integer");
+		names.add("java.lang.Long");
+		names.add("java.lang.Float");
+		names.add("java.lang.Double");
+		names.add("java.lang.Number");
+		names.add("java.lang.Enum");
+		names.add("java.lang.Object");
+		names.add("java.lang.StackTraceElement");
+		names.add("java.math.BigInteger");
+		names.add("java.math.BigDecimal");
+		names.add("java.util.Date");
+		names.add("java.util.UUID");
+		names.add("java.util.Locale");
+		// Common collection containers (elements are checked recursively as they
+		// are themselves resolved through this same stream)
+		names.add("java.util.ArrayList");
+		names.add("java.util.LinkedList");
+		names.add("java.util.HashMap");
+		names.add("java.util.LinkedHashMap");
+		names.add("java.util.TreeMap");
+		names.add("java.util.HashSet");
+		names.add("java.util.LinkedHashSet");
+		names.add("java.util.TreeSet");
+		names.add("java.util.Hashtable");
+		names.add("java.util.Vector");
+		DEFAULT_ACCEPTED_CLASS_NAMES = Collections.unmodifiableSet(names);
+
+		Set<String> prefixes = new LinkedHashSet<String>();
+		// java.time.* value types are all immutable and safe to deserialize
+		prefixes.add("java.time.");
+		DEFAULT_ACCEPTED_PACKAGE_PREFIXES = Collections.unmodifiableSet(prefixes);
+	}
+
+	private final Set<String> acceptedClassNames = new LinkedHashSet<String>(DEFAULT_ACCEPTED_CLASS_NAMES);
+
+	private final Set<String> acceptedPackagePrefixes = new LinkedHashSet<String>(DEFAULT_ACCEPTED_PACKAGE_PREFIXES);
+
+
+	AllowListObjectInputStream(InputStream in) throws IOException {
+		super(in);
+	}
+
+	AllowListObjectInputStream(InputStream in, Set<String> additionalAcceptedClassNames) throws IOException {
+		super(in);
+		if (additionalAcceptedClassNames != null) {
+			for (String name : additionalAcceptedClassNames) {
+				if (name == null) {
+					continue;
+				}
+				String trimmed = name.trim();
+				if (trimmed.isEmpty()) {
+					continue;
+				}
+				if (trimmed.endsWith("*")) {
+					this.acceptedPackagePrefixes.add(trimmed.substring(0, trimmed.length() - 1));
+				}
+				else {
+					this.acceptedClassNames.add(trimmed);
+				}
+			}
+		}
+	}
+
+
+	@Override
+	protected Class<?> resolveClass(ObjectStreamClass desc) throws IOException, ClassNotFoundException {
+		checkAccepted(desc.getName());
+		return super.resolveClass(desc);
+	}
+
+	@Override
+	protected Class<?> resolveProxyClass(String[] interfaces) throws IOException, ClassNotFoundException {
+		// Reject dynamic proxies unless every implemented interface is accepted;
+		// InvocationHandler-based proxies are a common deserialization gadget vector.
+		if (interfaces != null) {
+			for (String itf : interfaces) {
+				checkAccepted(itf);
+			}
+		}
+		return super.resolveProxyClass(interfaces);
+	}
+
+	/**
+	 * Throw {@link InvalidClassException} unless the given (possibly array-encoded)
+	 * class name resolves to an accepted class. Primitive types and arrays of
+	 * primitives are always accepted.
+	 */
+	private void checkAccepted(String className) throws InvalidClassException {
+		String name = className;
+		// Peel array descriptors: e.g. "[[Ljava.lang.String;" -> "java.lang.String".
+		while (name.length() > 0 && name.charAt(0) == '[') {
+			name = name.substring(1);
+		}
+		if (name.length() == 0) {
+			return;
+		}
+		if (name.charAt(0) == 'L' && name.endsWith(";")) {
+			// Object array element type.
+			name = name.substring(1, name.length() - 1);
+		}
+		else if (name.length() == 1) {
+			// Primitive array component descriptor (I, Z, B, C, S, J, F, D) -> safe.
+			return;
+		}
+		if (!isAcceptedClassName(name)) {
+			throw new InvalidClassException(name,
+					"Rejected by HTTP invoker deserialization allow-list (CVE-2016-1000027). " +
+					"If this class is expected, add it via setAcceptedClassNames(...) on the exporter.");
+		}
+	}
+
+	private boolean isAcceptedClassName(String name) {
+		if (this.acceptedClassNames.contains(name)) {
+			return true;
+		}
+		for (String prefix : this.acceptedPackagePrefixes) {
+			if (name.startsWith(prefix)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+}
