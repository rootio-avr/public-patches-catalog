+package org.springframework.remoting.httpinvoker;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.InvalidClassException;
+import java.io.ObjectOutputStream;
+import java.util.Collections;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.remoting.support.RemoteInvocation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+
+/**
+ * Regression test for CVE-2016-1000027 (CWE-502, unsafe JDK deserialization in
+ * Spring HTTP invoker service exporters).
+ *
+ * <p>Verifies that {@link AllowListObjectInputStream} — the hardened stream that
+ * both {@link HttpInvokerServiceExporter} and {@link SimpleHttpInvokerServiceExporter}
+ * now use to read incoming remote invocations — enforces a fail-closed class-name
+ * allow-list: expected remoting/JDK value types deserialize normally, while any
+ * other (potentially gadget) class is rejected before it is materialized.
+ *
+ * @author Root.io Novel Patcher
+ */
+class AllowListObjectInputStreamCve20161000027Tests {
+
+	private static byte[] serialize(Object obj) throws Exception {
+		ByteArrayOutputStream bos = new ByteArrayOutputStream();
+		try (ObjectOutputStream oos = new ObjectOutputStream(bos)) {
+			oos.writeObject(obj);
+		}
+		return bos.toByteArray();
+	}
+
+	@Test
+	void acceptedRemoteInvocationDeserializesNormally() throws Exception {
+		RemoteInvocation invocation = new RemoteInvocation();
+		invocation.setMethodName("toString");
+		byte[] bytes = serialize(invocation);
+
+		try (AllowListObjectInputStream ois =
+				new AllowListObjectInputStream(new ByteArrayInputStream(bytes))) {
+			Object read = ois.readObject();
+			assertThat(read).isInstanceOf(RemoteInvocation.class);
+			assertThat(((RemoteInvocation) read).getMethodName()).isEqualTo("toString");
+		}
+	}
+
+	@Test
+	void acceptedJdkValueTypeDeserializesNormally() throws Exception {
+		byte[] bytes = serialize("hello");
+		try (AllowListObjectInputStream ois =
+				new AllowListObjectInputStream(new ByteArrayInputStream(bytes))) {
+			assertThat(ois.readObject()).isEqualTo("hello");
+		}
+	}
+
+	@Test
+	void disallowedClassIsRejectedBeforeMaterialization() throws Exception {
+		// java.io.File is a stand-in for an arbitrary non-allow-listed class such
+		// as a deserialization gadget: it must be blocked by the allow-list.
+		byte[] bytes = serialize(new java.io.File("/tmp/pwned"));
+		try (AllowListObjectInputStream ois =
+				new AllowListObjectInputStream(new ByteArrayInputStream(bytes))) {
+			assertThatExceptionOfType(InvalidClassException.class)
+					.isThrownBy(ois::readObject);
+		}
+	}
+
+	@Test
+	void explicitlyAcceptedClassNameIsAllowed() throws Exception {
+		byte[] bytes = serialize(new java.io.File("/tmp/ok"));
+		try (AllowListObjectInputStream ois = new AllowListObjectInputStream(
+				new ByteArrayInputStream(bytes),
+				Collections.singleton("java.io.File"))) {
+			assertThat(ois.readObject()).isEqualTo(new java.io.File("/tmp/ok"));
+		}
+	}
+}
