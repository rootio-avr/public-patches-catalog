+/**
+ * Regression test for CVE-2024-38816: path traversal in
+ * {@link PathResourceLookupFunction} used by
+ * {@code RouterFunctions.resources(String, Resource)}. URL-encoded traversal
+ * sequences must not be able to escape the configured resource location.
+ */
+class Cve202438816RegressionTests {
+
+	private final ClassPathResource location =
+			new ClassPathResource("org/springframework/web/servlet/function/");
+
+	private final PathResourceLookupFunction function =
+			new PathResourceLookupFunction("/resources/**", this.location);
+
+	@Test
+	void legitimateResourceIsStillResolved() throws Exception {
+		ServerRequest request = initRequest("GET", "/resources/response.txt");
+
+		Optional<Resource> result = this.function.apply(request);
+
+		assertThat(result).as("normal resource lookup must still succeed").isPresent();
+	}
+
+	@Test
+	void encodedParentTraversalIsRejected() {
+		// %2e%2e%2f decodes to "../" — must not escape the location.
+		ServerRequest request = initRequest("GET", "/resources/%2e%2e%2fresponse.txt");
+
+		Optional<Resource> result = this.function.apply(request);
+
+		assertThat(result).as("encoded '../' traversal must be rejected").isNotPresent();
+	}
+
+	@Test
+	void encodedNestedTraversalIsRejected() {
+		ServerRequest request = initRequest("GET", "/resources/%2e%2e/%2e%2e/response.txt");
+
+		Optional<Resource> result = this.function.apply(request);
+
+		assertThat(result).as("encoded nested traversal must be rejected").isNotPresent();
+	}
+
+	private ServerRequest initRequest(String httpMethod, String requestUri) {
+		return new DefaultServerRequest(
+				PathPatternsTestUtils.initRequest(httpMethod, requestUri, true),
+				Collections.emptyList());
+	}
+
+}

CVE-2024-38819: Path traversal fix for double-encoded static resource paths

This patch addresses a follow-on path traversal vulnerability in Spring
Framework's functional web frameworks (WebMvc.fn and WebFlux.fn) and static
resource handlers. It adds normalizePath/decode handling for double URL
encoding and tightens "../" detection after path normalization.

Must be applied after CVE-2024-38816.

Origin: upstream, https://github.com/spring-projects/spring-framework/commit/3bfbe30a7814c9ea1556d40df9bd87ddb3ba372d
       and https://github.com/spring-projects/spring-framework/commit/fb7890d73975a3d9e0763e0926df2bd0a608e87e
Bug: CVE-2024-38819

