+package org.springframework.remoting.httpinvoker;
+
+import java.io.InvalidClassException;
+
+/**
+ * Class-name filter applied while deserializing HTTP invoker requests
+ * (CVE-2016-1000027 hardening).
+ *
+ * <p>Known deserialization gadget classes are always rejected. In addition, if the
+ * system property {@value #ALLOWED_CLASSES_PROPERTY} is set to a comma-separated list
+ * of class name prefixes, only those classes (plus basic JDK value types and Spring's
+ * own remote invocation classes) may be deserialized.
+ *
+ * @deprecated along with the HTTP invoker exporters that use it
+ */
+@Deprecated
+final class DeserializationClassFilter {
+
+	/**
+	 * System property holding comma-separated class name prefixes that may be
+	 * deserialized. If unset or empty, only the deny list is applied.
+	 */
+	static final String ALLOWED_CLASSES_PROPERTY = "spring.remoting.httpinvoker.allowedClasses";
+
+	private static final String[] DENIED_PREFIXES = {
+			"org.apache.commons.collections.functors.",
+			"org.apache.commons.collections4.functors.",
+			"org.apache.commons.collections.map.LazyMap",
+			"org.apache.commons.collections4.map.LazyMap",
+			"org.apache.commons.collections.keyvalue.TiedMapEntry",
+			"org.apache.commons.collections4.keyvalue.TiedMapEntry",
+			"org.apache.commons.collections4.comparators.TransformingComparator",
+			"org.apache.commons.beanutils.BeanComparator",
+			"org.apache.commons.fileupload.",
+			"org.apache.xalan.xsltc.trax.",
+			"com.sun.org.apache.xalan.internal.xsltc.trax.",
+			"org.apache.xalan.",
+			"com.sun.rowset.",
+			"javax.management.BadAttributeValueExpException",
+			"javax.script.",
+			"org.codehaus.groovy.runtime.",
+			"groovy.lang.",
+			"bsh.",
+			"clojure.",
+			"org.mozilla.javascript.",
+			"com.mchange.v2.c3p0.",
+			"org.hibernate.engine.spi.TypedValue",
+			"org.hibernate.tuple.component.",
+			"org.hibernate.property.access.spi.",
+			"org.jboss.interceptor.",
+			"org.apache.wicket.util.upload.",
+			"org.apache.myfaces.context.servlet.",
+			"com.sun.jndi.",
+			"java.rmi.server.UnicastRemoteObject",
+			"java.rmi.server.RemoteObjectInvocationHandler",
+			"sun.rmi.",
+			"org.springframework.beans.factory.ObjectFactory",
+			"org.springframework.beans.factory.support.",
+			"org.springframework.core.SerializableTypeWrapper$",
+			"org.springframework.aop.framework.JdkDynamicAopProxy",
+			"org.springframework.aop.target.",
+			"org.springframework.jndi.",
+			"org.springframework.transaction.jta.JtaTransactionManager"
+	};
+
+	private static final String[] ALWAYS_ALLOWED_PREFIXES = {
+			"org.springframework.remoting.support.",
+			"java.lang.",
+			"java.math.",
+			"java.util.",
+			"java.time.",
+			"java.sql.Time",
+			"java.sql.Date"
+	};
+
+
+	private DeserializationClassFilter() {
+	}
+
+
+	/**
+	 * Check the given class name (as found in a serialization stream).
+	 * @param className the class name, possibly an array descriptor
+	 * @throws InvalidClassException if the class must not be deserialized
+	 */
+	static void check(String className) throws InvalidClassException {
+		String name = elementName(className);
+		if (name == null) {
+			return;
+		}
+		for (String denied : DENIED_PREFIXES) {
+			if (name.startsWith(denied)) {
+				throw new InvalidClassException(className, "Class is rejected for HTTP invoker deserialization");
+			}
+		}
+		String allowed = System.getProperty(ALLOWED_CLASSES_PROPERTY);
+		if (allowed == null || allowed.trim().isEmpty()) {
+			return;
+		}
+		for (String prefix : ALWAYS_ALLOWED_PREFIXES) {
+			if (name.startsWith(prefix)) {
+				return;
+			}
+		}
+		for (String prefix : allowed.split(",")) {
+			String trimmed = prefix.trim();
+			if (!trimmed.isEmpty() && name.startsWith(trimmed)) {
+				return;
+			}
+		}
+		throw new InvalidClassException(className, "Class is not in the HTTP invoker allowed class list");
+	}
+
+	/**
+	 * Resolve array descriptors to their element class name;
+	 * return {@code null} for primitive element types.
+	 */
+	private static String elementName(String className) {
+		int i = 0;
+		while (i < className.length() && className.charAt(i) == '[') {
+			i++;
+		}
+		if (i == 0) {
+			return className;
+		}
+		if (i < className.length() && className.charAt(i) == 'L' && className.endsWith(";")) {
+			return className.substring(i + 1, className.length() - 1);
+		}
+		return null;
+	}
+
+}
