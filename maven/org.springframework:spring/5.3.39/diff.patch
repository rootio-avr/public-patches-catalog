+package org.springframework.remoting.httpinvoker;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.ObjectStreamClass;
+
+import org.springframework.lang.Nullable;
+import org.springframework.remoting.rmi.CodebaseAwareObjectInputStream;
+
+/**
+ * {@link CodebaseAwareObjectInputStream} that rejects unsafe classes via
+ * {@link DeserializationClassFilter} before they are resolved.
+ *
+ * @deprecated along with the HTTP invoker exporters that use it
+ */
+@Deprecated
+class FilteringObjectInputStream extends CodebaseAwareObjectInputStream {
+
+	FilteringObjectInputStream(InputStream in, @Nullable ClassLoader classLoader, boolean acceptProxyClasses)
+			throws IOException {
+
+		super(in, classLoader, acceptProxyClasses);
+	}
+
+	@Override
+	protected Class<?> resolveClass(ObjectStreamClass classDesc) throws IOException, ClassNotFoundException {
+		DeserializationClassFilter.check(classDesc.getName());
+		return super.resolveClass(classDesc);
+	}
+
+	@Override
+	protected Class<?> resolveProxyClass(String[] interfaces) throws IOException, ClassNotFoundException {
+		for (String name : interfaces) {
+			DeserializationClassFilter.check(name);
+		}
+		return super.resolveProxyClass(interfaces);
+	}
+
+}
