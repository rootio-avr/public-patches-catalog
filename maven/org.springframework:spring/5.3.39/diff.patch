+package org.springframework.remoting.httpinvoker;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InvalidClassException;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.HashMap;
+
+import javax.management.BadAttributeValueExpException;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.remoting.support.RemoteInvocation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+
+/**
+ * Regression tests for CVE-2016-1000027: unsafe deserialization in
+ * {@link HttpInvokerServiceExporter}.
+ */
+@SuppressWarnings("deprecation")
+class HttpInvokerDeserializationFilterTests {
+
+	@Test
+	void gadgetClassIsRejected() throws Exception {
+		byte[] data = serialize(new BadAttributeValueExpException("x"));
+		try (ObjectInputStream ois = createExporterStream(data)) {
+			assertThatExceptionOfType(InvalidClassException.class).isThrownBy(ois::readObject);
+		}
+	}
+
+	@Test
+	void legitimateRemoteInvocationIsAccepted() throws Exception {
+		RemoteInvocation invocation = new RemoteInvocation("toString", new Class<?>[0], new Object[0]);
+		invocation.addAttribute("key", "value");
+		HashMap<String, Integer> argument = new HashMap<>();
+		argument.put("a", 1);
+		invocation.setArguments(new Object[] {argument, new String[] {"x"}, new int[] {1}});
+		try (ObjectInputStream ois = createExporterStream(serialize(invocation))) {
+			RemoteInvocation result = (RemoteInvocation) ois.readObject();
+			assertThat(result.getMethodName()).isEqualTo("toString");
+			assertThat(result.getArguments()[0]).isEqualTo(argument);
+		}
+	}
+
+	@Test
+	void allowListRejectsUnlistedClasses() throws Exception {
+		System.setProperty(DeserializationClassFilter.ALLOWED_CLASSES_PROPERTY, "com.example.");
+		try {
+			DeserializationClassFilter.check("java.util.HashMap");
+			DeserializationClassFilter.check("[Ljava.lang.String;");
+			DeserializationClassFilter.check("[I");
+			DeserializationClassFilter.check("com.example.Dto");
+			assertThatExceptionOfType(InvalidClassException.class)
+					.isThrownBy(() -> DeserializationClassFilter.check("org.other.Unlisted"));
+		}
+		finally {
+			System.clearProperty(DeserializationClassFilter.ALLOWED_CLASSES_PROPERTY);
+		}
+	}
+
+	private static ObjectInputStream createExporterStream(byte[] data) throws Exception {
+		return new TestExporter().open(data);
+	}
+
+	private static byte[] serialize(Object object) throws Exception {
+		ByteArrayOutputStream baos = new ByteArrayOutputStream();
+		try (ObjectOutputStream oos = new ObjectOutputStream(baos)) {
+			oos.writeObject(object);
+		}
+		return baos.toByteArray();
+	}
+
+
+	private static class TestExporter extends HttpInvokerServiceExporter {
+
+		ObjectInputStream open(byte[] bytes) throws IOException {
+			return createObjectInputStream(new ByteArrayInputStream(bytes));
+		}
+	}
+
+}
