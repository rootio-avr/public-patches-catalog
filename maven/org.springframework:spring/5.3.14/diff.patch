+package org.springframework.web.util;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Regression test for CVE-2024-22243 (gh-32211): the USERINFO_PATTERN used by
+ * {@link UriComponentsBuilder} must not treat a bracket ('[') as part of the
+ * userinfo component, otherwise a crafted URL can smuggle the real host past
+ * validation checks (open redirect / SSRF).
+ */
+class Cve202422243RegressionTest {
+
+	@Test
+	void userInfoWithBracketDoesNotHijackHost() {
+		// Attacker embeds the trusted host in userinfo and puts the real
+		// (untrusted) host after a bracket. The host must be parsed as the
+		// untrusted host, not the trusted one before the '@'.
+		UriComponents uri = UriComponentsBuilder
+				.fromUriString("https://trusted.example.com[@evil.example.com/path")
+				.build();
+
+		assertThat(uri.getHost()).isNotEqualTo("trusted.example.com");
+	}
+
+	@Test
+	void plainUserInfoStillParsesHostCorrectly() {
+		UriComponents uri = UriComponentsBuilder
+				.fromUriString("https://user:pwd@example.com/path")
+				.build();
+
+		assertThat(uri.getUserInfo()).isEqualTo("user:pwd");
+		assertThat(uri.getHost()).isEqualTo("example.com");
+	}
+}

