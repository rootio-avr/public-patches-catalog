+package org.springframework.beans;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.beans.testfixture.beans.TestBean;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Regression test for CVE-2022-22965 ("Spring4Shell").
+ *
+ * <p>The fix refines {@code CachedIntrospectionResults} PropertyDescriptor
+ * filtering so that:
+ * <ul>
+ *   <li>only the {@code name}-style properties of {@link Class} are exposed for
+ *       binding (blocking navigation through {@code class.classLoader},
+ *       {@code class.protectionDomain} and {@code class.module.*}); and</li>
+ *   <li>no property of type {@link ClassLoader} or
+ *       {@link java.security.ProtectionDomain} is bindable regardless of the
+ *       declaring bean.</li>
+ * </ul>
+ *
+ * These assertions capture the vulnerable data-binding paths that the fix
+ * closes; before the fix the {@code class.classLoader.*} chain was reachable
+ * and could be used to overwrite Tomcat access-log properties for RCE.
+ */
+public class Cve202222965RegressionTests {
+
+	@Test
+	public void classLoaderPropertyIsNotBindableThroughClassProperty() {
+		BeanWrapper bw = new BeanWrapperImpl(new TestBean());
+
+		// The 'class' property itself and its name variants remain available.
+		assertThat(bw.isReadableProperty("class")).isTrue();
+		assertThat(bw.isReadableProperty("class.name")).isTrue();
+
+		// The dangerous navigation paths must no longer resolve.
+		assertThat(bw.isReadableProperty("class.classLoader")).isFalse();
+		assertThat(bw.isWritableProperty("class.classLoader")).isFalse();
+		assertThat(bw.isReadableProperty("class.protectionDomain")).isFalse();
+
+		// Java 9+ module accessor is likewise not a name variant and is blocked,
+		// closing the 'class.module.classLoader.*' chain.
+		assertThat(bw.isReadableProperty("class.module")).isFalse();
+	}
+
+	@Test
+	public void classIntrospectionOnlyExposesNameVariants() {
+		CachedIntrospectionResults results = CachedIntrospectionResults.forClass(Class.class);
+		for (java.beans.PropertyDescriptor pd : results.getBeanInfo().getPropertyDescriptors()) {
+			String name = pd.getName();
+			assertThat("name".equals(name) || name.endsWith("Name"))
+					.as("Class property '%s' should have been filtered", name)
+					.isTrue();
+		}
+	}
+
+	@Test
+	public void classLoaderTypedPropertiesAreFiltered() {
+		// Any property whose type is a ClassLoader (or ProtectionDomain) must be
+		// filtered out irrespective of the declaring class.
+		CachedIntrospectionResults results = CachedIntrospectionResults.forClass(ClassLoaderHolder.class);
+		assertThat(results.getPropertyDescriptor("loader")).isNull();
+		assertThat(results.getPropertyDescriptor("safe")).isNotNull();
+	}
+
+	@SuppressWarnings("unused")
+	public static class ClassLoaderHolder {
+
+		private ClassLoader loader;
+
+		private String safe;
+
+		public ClassLoader getLoader() {
+			return this.loader;
+		}
+
+		public void setLoader(ClassLoader loader) {
+			this.loader = loader;
+		}
+
+		public String getSafe() {
+			return this.safe;
+		}
+
+		public void setSafe(String safe) {
+			this.safe = safe;
+		}
+	}
+
+}

