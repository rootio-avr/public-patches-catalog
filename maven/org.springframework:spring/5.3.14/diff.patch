+package org.springframework.web.util;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Regression test for CVE-2024-22262.
+ *
+ * <p>{@link UriComponentsBuilder} must not allow a backslash character to
+ * bypass host/userinfo/port validation when parsing an externally supplied
+ * URL. A crafted authority such as {@code example.com\\@attacker.example}
+ * must not be parsed so that the trusted-looking segment is treated as the
+ * host while the real target is smuggled past a validation check
+ * (CWE-601 open redirect / SSRF).
+ */
+class UriComponentsBuilderCve202422262RegressionTest {
+
+	@Test
+	void backslashInAuthorityIsNotAbsorbedIntoHost() {
+		// Before the fix the backslash was allowed inside the host pattern, so
+		// the parsed host could differ from what a naive validator expects.
+		UriComponents uc = UriComponentsBuilder
+				.fromUriString("https://example.com\\@attacker.example/path")
+				.build();
+		String host = uc.getHost();
+		assertThat(host).doesNotContain("\\");
+		assertThat(host).isNotEqualTo("attacker.example");
+	}
+
+	@Test
+	void backslashInUserInfoIsNotAbsorbedIntoHost() {
+		UriComponents uc = UriComponentsBuilder
+				.fromUriString("https://foo\\bar@example.com/path")
+				.build();
+		assertThat(uc.getHost()).doesNotContain("\\");
+	}
+
+	@Test
+	void legitimateUrlStillParsesCorrectly() {
+		UriComponents uc = UriComponentsBuilder
+				.fromUriString("https://user:pwd@example.com:8443/path?q=1#frag")
+				.build();
+		assertThat(uc.getScheme()).isEqualTo("https");
+		assertThat(uc.getUserInfo()).isEqualTo("user:pwd");
+		assertThat(uc.getHost()).isEqualTo("example.com");
+		assertThat(uc.getPort()).isEqualTo(8443);
+		assertThat(uc.getPath()).isEqualTo("/path");
+	}
+}

