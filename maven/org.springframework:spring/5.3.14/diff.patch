+package org.springframework.web.util;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+/**
+ * Regression tests for CVE-2024-22259 (CWE-601 open redirect via malformed URLs).
+ *
+ * <p>The fix extracts a reusable {@code checkSchemeAndHost} method and hardens the
+ * USERINFO/HOST regular expressions so that {@code UriComponentsBuilder} rejects
+ * URLs whose host component contains an unterminated IPv6 literal instead of
+ * silently parsing them into an attacker-controlled authority. Each entry point
+ * ({@code fromUriString}, {@code fromHttpUrl}, {@code fromOriginHeader}) must
+ * reject such input with an {@link IllegalArgumentException}.
+ */
+class CVE202422259RegressionTest {
+
+	@Test
+	void fromUriStringRejectsUnterminatedIPv6Host() {
+		assertThatIllegalArgumentException().isThrownBy(() ->
+				UriComponentsBuilder.fromUriString("http://[1abc:2abc:3abc::5ABC:6abc:8080/resource"));
+	}
+
+	@Test
+	void fromHttpUrlRejectsUnterminatedIPv6Host() {
+		assertThatIllegalArgumentException().isThrownBy(() ->
+				UriComponentsBuilder.fromHttpUrl("http://[1abc:2abc:3abc::5ABC:6abc:8080/resource"));
+	}
+
+	@Test
+	void fromOriginHeaderRejectsUnterminatedIPv6Host() {
+		assertThatIllegalArgumentException().isThrownBy(() ->
+				UriComponentsBuilder.fromOriginHeader("http://[1abc:2abc:3abc::5ABC:6abc:8080"));
+	}
+
+}

