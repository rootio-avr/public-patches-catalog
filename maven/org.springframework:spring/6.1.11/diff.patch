CVE-2024-38819: regression test for double-encoded static resource paths.

The production fix (normalizePath double URL-decode in processPath) is already
applied by AIKIDO-2024-10351, which runs earlier on this version and changes
the same hunks this MR originally targeted on vanilla 6.1.11. Those hunks are
omitted here so this patch applies on top. This file adds the MR regression
test for ResourceHttpRequestHandler.processPath.

Upstream: https://github.com/spring-projects/spring-framework/commit/3bfbe30a7814c9ea1556d40df9bd87ddb3ba372d
       and https://github.com/spring-projects/spring-framework/commit/fb7890d73975a3d9e0763e0926df2bd0a608e87e

--- /dev/null
+++ b/spring-webmvc/src/test/java/org/springframework/web/servlet/resource/Cve202438819RegressionTests.java
@@ -0,0 +1,58 @@
+/*
+ * Copyright 2002-2024 the original author or authors.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.springframework.web.servlet.resource;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Regression test for CVE-2024-38819 (gh-33689).
+ *
+ * <p>Verifies that {@link ResourceHttpRequestHandler#processPath} normalizes
+ * static resource paths early, including paths that are <em>double</em> URL
+ * encoded. This covers the follow-up fix (commit fb7890d7) which decodes the
+ * path twice before checking for a {@code "../"} traversal sequence; the
+ * original fix (commit 3bfbe30a) only decoded once and therefore did not
+ * neutralize double-encoded traversal payloads.
+ */
+class Cve202438819RegressionTests {
+
+	private final ResourceHttpRequestHandler handler = new ResourceHttpRequestHandler();
+
+
+	@Test
+	void singleEncodedTraversalIsNormalized() {
+		// "%2E%2E%2F" decodes once to "../"
+		String result = this.handler.processPath("%2E%2E%2Ftestsecret/secret.txt");
+		assertThat(result).contains("../");
+	}
+
+	@Test
+	void doubleEncodedTraversalIsNormalized() {
+		// "%252E%252E%252F" decodes once to "%2E%2E%2F" and again to "../"
+		String result = this.handler.processPath("%252E%252E%252Ftestsecret/secret.txt");
+		assertThat(result).contains("../");
+	}
+
+	@Test
+	void regularPathIsPreserved() {
+		assertThat(this.handler.processPath("/foo/bar")).isEqualTo("/foo/bar");
+		assertThat(this.handler.processPath("foo/bar")).isEqualTo("foo/bar");
+	}
+
+}

