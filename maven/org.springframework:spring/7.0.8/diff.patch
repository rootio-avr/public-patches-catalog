+	@Test
+	void escapeCarriageReturnInViewFragment() throws Exception {
+		MethodParameter type = on(TestController.class).resolveReturnType(SseEmitter.class);
+
+		SseEmitter emitter = new SseEmitter();
+		this.handler.handleReturnValue(emitter, type, new ModelAndViewContainer(), webRequest);
+
+		// Bare CR would end the current data: line and let the rest be parsed as a new SSE field.
+		ModelAndView mav1 = new ModelAndView("fragment1", Map.of("foo", "Foo\rdata:injected"));
+
+		emitter.send(SseEmitter.event().data(mav1));
+
+		String body = this.response.getContentAsString();
+		assertThat(body).doesNotContain("\r");
+		assertThat(body).isEqualTo(("""
+				event:fragment1
+				data:<p>
+				data:	Hello Foo
+				data:data:injected
+				data:</p>
+
+				"""));
+	}
