@@ -0,0 +1,101 @@
+package org.bouncycastle.crypto.internal;
+
+import org.bouncycastle.util.Arrays;
+
+/**
+ * Factory for zeroization actions suitable for use with {@link SecretZeroizer}. The actions are
+ * static nested classes so that they capture only the secret arrays and never an enclosing instance.
+ */
+public final class Zeroizers
+{
+    private Zeroizers()
+    {
+    }
+
+    public static Runnable forBytes(byte[] secret)
+    {
+        return new BytesZeroizer(secret);
+    }
+
+    public static Runnable forInts(int[]... secrets)
+    {
+        return new IntsZeroizer(secrets);
+    }
+
+    public static Runnable forIntArrays(int[][] secrets)
+    {
+        return new IntArraysZeroizer(secrets);
+    }
+
+    private static final class BytesZeroizer
+        implements Runnable
+    {
+        private final byte[] secret;
+
+        BytesZeroizer(byte[] secret)
+        {
+            this.secret = secret;
+        }
+
+        public void run()
+        {
+            if (secret != null)
+            {
+                Arrays.fill(secret, (byte)0);
+            }
+        }
+    }
+
+    private static final class IntsZeroizer
+        implements Runnable
+    {
+        private final int[][] secrets;
+
+        IntsZeroizer(int[][] secrets)
+        {
+            this.secrets = secrets;
+        }
+
+        public void run()
+        {
+            for (int i = 0; i != secrets.length; i++)
+            {
+                int[] r = secrets[i];
+                if (r != null)
+                {
+                    for (int j = 0; j != r.length; j++)
+                    {
+                        r[j] = 0;
+                    }
+                }
+            }
+        }
+    }
+
+    private static final class IntArraysZeroizer
+        implements Runnable
+    {
+        private final int[][] secrets;
+
+        IntArraysZeroizer(int[][] secrets)
+        {
+            this.secrets = secrets;
+        }
+
+        public void run()
+        {
+            for (int i = 0; i != secrets.length; i++)
+            {
+                int[] r = secrets[i];
+                if (r != null)
+                {
+                    for (int j = 0; j != r.length; j++)
+                    {
+                        r[j] = 0;
+                    }
+                }
+                secrets[i] = null;
+            }
+        }
+    }
+}

