-            {
-                this.params = getParams(((EdDSAParameterSpec)params).getCurveName());
-            }
-            else if (isXDH && params instanceof XDHParameterSpec)
-            {
-                this.params = getParams(((XDHParameterSpec)params).getCurveName());
-            }
-            else
-            {
-                if (params == null)
