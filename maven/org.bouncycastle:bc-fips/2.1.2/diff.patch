+package org.bouncycastle.crypto.internal;
+
+/**
+ * Runs a zeroization action when this holder is garbage collected. Hold an instance in the object
+ * that owns the secret so the two share a lifetime.
+ * <p>
+ * The action must never reference this holder or the object that owns it, only the secret material
+ * itself (or a buffer that holds it).
+ * <p>
+ * This base (JDK 8) version uses {@code finalize()}; a Cleaner-based override is provided for later
+ * JVMs in the multi-release overlay, where finalization is deprecated and can fall arbitrarily far
+ * behind allocation.
+ */
+public final class SecretZeroizer
+{
+    private final Runnable action;
+
+    public SecretZeroizer(Runnable action)
+    {
+        this.action = action;
+    }
+
+    @Override
+    protected void finalize()
+        throws Throwable
+    {
+        try
+        {
+            if (action != null)
+            {
+                action.run();
+            }
+        }
+        finally
+        {
+            super.finalize();
+        }
+    }
+}
