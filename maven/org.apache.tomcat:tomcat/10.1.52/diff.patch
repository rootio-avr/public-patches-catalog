+package org.apache.coyote.http2;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import org.apache.tomcat.util.http.parser.HttpParser;
+
+/**
+ * Regression test for CVE-2026-41293.
+ *
+ * HTTP/2 header field names and values were not validated when decoded from
+ * HPACK, allowing illegal characters (control characters, upper-case field
+ * names, obs-text where not permitted, etc.) to be smuggled into requests.
+ * The fix adds field-vchar / field-content validation predicates to
+ * {@link HttpParser} (growing the backing IS_* tables to cover the 0-255
+ * range) and enforces them, together with the token/lower-case rule for field
+ * names, while decoding both Huffman and literal HPACK strings in
+ * {@link HpackDecoder} and {@link HPackHuffman}.
+ *
+ * This test grounds on the validation predicates introduced by the fix
+ * (mirroring upstream TestHttp2Section_8_2's use of
+ * {@code isToken}/{@code isFieldContent}/{@code isFieldVChar}). It is
+ * self-contained so it does not depend on the HTTP/2 connection test harness.
+ */
+public class TestCve202641293Regression {
+
+    @Test
+    public void testFieldVCharPredicate() {
+        // VCHAR (0x21-0x7E) and obs-text (>0x7F) are field-vchar
+        Assert.assertTrue(HttpParser.isFieldVChar('a'));
+        Assert.assertTrue(HttpParser.isFieldVChar('Z'));
+        Assert.assertTrue(HttpParser.isFieldVChar('~'));
+        Assert.assertTrue(HttpParser.isFieldVChar(0x80)); // obs-text
+        Assert.assertTrue(HttpParser.isFieldVChar(0xFF)); // obs-text
+
+        // SP, HTAB and control characters are NOT field-vchar
+        Assert.assertFalse(HttpParser.isFieldVChar(' '));
+        Assert.assertFalse(HttpParser.isFieldVChar('\t'));
+        Assert.assertFalse(HttpParser.isFieldVChar(0x00));
+        Assert.assertFalse(HttpParser.isFieldVChar('\n'));
+        Assert.assertFalse(HttpParser.isFieldVChar('\r'));
+        Assert.assertFalse(HttpParser.isFieldVChar(0x7F)); // DEL
+    }
+
+    @Test
+    public void testFieldContentPredicate() {
+        // field-content additionally permits interior SP / HTAB
+        Assert.assertTrue(HttpParser.isFieldContent('a'));
+        Assert.assertTrue(HttpParser.isFieldContent(' '));
+        Assert.assertTrue(HttpParser.isFieldContent('\t'));
+        Assert.assertTrue(HttpParser.isFieldContent(0x80));
+
+        // control characters are still rejected
+        Assert.assertFalse(HttpParser.isFieldContent('\n'));
+        Assert.assertFalse(HttpParser.isFieldContent('\r'));
+        Assert.assertFalse(HttpParser.isFieldContent(0x00));
+        Assert.assertFalse(HttpParser.isFieldContent(0x7F));
+    }
+
+    @Test
+    public void testTokenIsAsciiOnly() {
+        // HTTP/2 field names must be tokens; the fix keeps IS_TOKEN within the
+        // ASCII range even though the backing arrays grew to 256 entries, so
+        // obs-text is field-vchar but must never qualify as a token.
+        Assert.assertTrue(HttpParser.isToken('a'));
+        Assert.assertTrue(HttpParser.isToken('-'));
+        Assert.assertFalse(HttpParser.isToken(0x80));
+        Assert.assertFalse(HttpParser.isToken(0xFF));
+        // The combined field-name rule enforced by the decoder is
+        // (isToken && !isUpperCase): lower-case ASCII passes, upper-case fails.
+        Assert.assertTrue(HttpParser.isToken('x') && !Character.isUpperCase('x'));
+        Assert.assertFalse(HttpParser.isToken('X') && !Character.isUpperCase('X'));
+    }
+
+    @Test
+    public void testHighBytesDoNotThrow() {
+        // ARRAY_SIZE grew to 256: predicates must handle bytes 128-255 without
+        // an ArrayIndexOutOfBoundsException and out-of-range values gracefully.
+        for (int c = 0; c < 256; c++) {
+            HttpParser.isFieldVChar(c);
+            HttpParser.isFieldContent(c);
+            HttpParser.isToken(c);
+        }
+        Assert.assertFalse(HttpParser.isFieldVChar(256));
+        Assert.assertFalse(HttpParser.isFieldContent(-1));
+    }
+}

