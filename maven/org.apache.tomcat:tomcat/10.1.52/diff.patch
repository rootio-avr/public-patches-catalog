+            return null;
+        }
+
+        String digest(String username, String algorithm) {
+            return getDigest(username, REALM_NAME, algorithm);
+        }
+    }
+
+    @Test
+    public void testUnknownUserReturnsNullDigest() {
+        TesterRealm realm = new TesterRealm("valid", "password");
+
+        // Unknown user has a null password: getDigest must not fabricate a
+        // digest over a "null" password - it must return null.
+        Assert.assertNull(realm.digest("invalid", "MD5"));
+    }
+
+    @Test
+    public void testKnownUserWithNullPasswordReturnsNullDigest() {
+        TesterRealm realm = new TesterRealm("valid", null);
+
+        // Known user whose stored password is null must also yield null.
+        Assert.assertNull(realm.digest("valid", "MD5"));
+    }
+
+    @Test
+    public void testValidUserStillGetsDigest() {
+        TesterRealm realm = new TesterRealm("valid", "password");
+
+        // A genuine user must still receive a non-null digest so the fix does
+        // not break legitimate DIGEST authentication.
+        Assert.assertNotNull(realm.digest("valid", "MD5"));
+    }
