+package org.apache.catalina.realm;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.security.Principal;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import org.apache.catalina.Context;
+import org.apache.catalina.connector.Request;
+import org.apache.tomcat.util.buf.MessageBytes;
+import org.apache.tomcat.util.descriptor.web.SecurityCollection;
+import org.apache.tomcat.util.descriptor.web.SecurityConstraint;
+
+/**
+ * Regression test for CVE-2026-43515.
+ *
+ * When multiple security collections define an HTTP method constraint for the
+ * same extension ({@code *.html}) pattern, the vulnerable
+ * {@link RealmBase#findSecurityConstraints(Request, Context)} only inspected the
+ * FIRST matching collection. Any method covered by a later collection (here,
+ * POST) was silently treated as unconstrained, allowing an authorization
+ * bypass.
+ *
+ * The fixed implementation evaluates every matching collection, so both the
+ * GET and the POST request must resolve to the guarding constraint.
+ *
+ * This is a self-contained replacement for the upstream
+ * {@code TestRealmBase#testUncoveredMethods} test, which depends on the
+ * {@code org.apache.catalina.startup.Tester*} / {@code org.apache.tomcat.unittest.Tester*}
+ * scaffolding that is not shipped in the tomcat-embed-core source artifact.
+ */
+public class Cve202643515RegressionTest {
+
+    private static final String EXT_PATTERN = "*.html";
+    private static final String URI = "/level1/level2/foo.html";
+
+    /** Minimal RealmBase concrete subclass — no MBean lifecycle required. */
+    private static final class TesterRealm extends RealmBase {
+        @Override
+        protected String getPassword(String username) {
+            return null;
+        }
+
+        @Override
+        protected Principal getPrincipal(String username) {
+            return null;
+        }
+    }
+
+    /** Request that reports a fixed URI and a configurable HTTP method. */
+    private static final class TesterRequest extends Request {
+        private String method;
+
+        TesterRequest() {
+            super(null);
+        }
+
+        void setTestMethod(String method) {
+            this.method = method;
+        }
+
+        @Override
+        public String getMethod() {
+            return method;
+        }
+
+        @Override
+        public MessageBytes getRequestPathMB() {
+            MessageBytes result = MessageBytes.newInstance();
+            result.setString(URI);
+            return result;
+        }
+    }
+
+    /**
+     * Context stub backed by a dynamic proxy — findSecurityConstraints only
+     * consults {@link Context#findConstraints()}.
+     */
+    private static Context newContext(final SecurityConstraint[] constraints) {
+        return (Context) Proxy.newProxyInstance(
+                Context.class.getClassLoader(),
+                new Class<?>[] { Context.class },
+                new InvocationHandler() {
+                    @Override
+                    public Object invoke(Object proxy, Method m, Object[] args) {
+                        if ("findConstraints".equals(m.getName())) {
+                            return constraints;
+                        }
+                        Class<?> rt = m.getReturnType();
+                        if (rt == boolean.class) {
+                            return Boolean.FALSE;
+                        }
+                        if (rt.isPrimitive()) {
+                            return 0;
+                        }
+                        return null;
+                    }
+                });
+    }
+
+    private static SecurityConstraint buildExtensionConstraint() {
+        SecurityConstraint constraint = new SecurityConstraint();
+        constraint.setAuthConstraint(true);
+        constraint.addAuthRole("role1");
+
+        SecurityCollection getCollection = new SecurityCollection();
+        getCollection.addMethod("GET");
+        getCollection.addPatternDecoded(EXT_PATTERN);
+        constraint.addCollection(getCollection);
+
+        SecurityCollection postCollection = new SecurityCollection();
+        postCollection.addMethod("POST");
+        postCollection.addPatternDecoded(EXT_PATTERN);
+        constraint.addCollection(postCollection);
+
+        return constraint;
+    }
+
+    @Test
+    public void testAllExtensionMethodConstraintsAreFound() {
+        SecurityConstraint constraint = buildExtensionConstraint();
+        Context context = newContext(new SecurityConstraint[] { constraint });
+        TesterRealm realm = new TesterRealm();
+
+        TesterRequest getRequest = new TesterRequest();
+        getRequest.setTestMethod("GET");
+        SecurityConstraint[] getResult = realm.findSecurityConstraints(getRequest, context);
+        Assert.assertNotNull("GET on *.html must be constrained", getResult);
+        Assert.assertEquals(1, getResult.length);
+        Assert.assertSame(constraint, getResult[0]);
+
+        // Before the fix, only the first matching collection (GET) was
+        // consulted, so POST leaked through unconstrained (null result).
+        TesterRequest postRequest = new TesterRequest();
+        postRequest.setTestMethod("POST");
+        SecurityConstraint[] postResult = realm.findSecurityConstraints(postRequest, context);
+        Assert.assertNotNull(
+                "POST on *.html must also be constrained (CVE-2026-43515 authz bypass)",
+                postResult);
+        Assert.assertEquals(1, postResult.length);
+        Assert.assertSame(constraint, postResult[0]);
+    }
+}
