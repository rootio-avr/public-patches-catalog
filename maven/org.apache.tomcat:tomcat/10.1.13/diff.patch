+                } else if (HttpParser.isWhiteSpace(c)) {
+                    return State.POST_VALUE;
+                } else if (c == ';') {
+                    return State.PRE_NAME;
+                } else if (c == '\r') {
+                    return State.CR;
+                }
+                break;
+            case QUOTED_VALUE:
+                if (c == '"') {
+                    return State.POST_VALUE;
+                } else if (c == '\\' || c == 127) {
+                    throw new IOException(sm.getString("chunkExtension.invalid"));
