+package org.apache.coyote.http2;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import org.apache.coyote.http2.HpackDecoder.HeaderEmitter;
+
+/**
+ * Regression test for CVE-2026-77762. The connection wide HPACK decoder must not keep emitting header fields into a
+ * stream that has been replaced (recycled).
+ */
+public class TestHpackDecoderEmitterReplacement {
+
+    // Literal header field without indexing, new name: "a" = "b"
+    private static final byte[] LITERAL_A_B = new byte[] { 0x00, 0x01, 0x61, 0x01, 0x62 };
+
+    @Test
+    public void testFieldsNotEmittedToReplacedEmitter() throws Exception {
+        HpackDecoder decoder = new HpackDecoder();
+        RecordingEmitter stale = new RecordingEmitter();
+        decoder.setHeaderEmitter(stale);
+
+        decoder.decode(ByteBuffer.wrap(LITERAL_A_B));
+        Assert.assertEquals(1, stale.names.size());
+
+        HeaderSink sink = new HeaderSink();
+        decoder.compareAndSetHeaderEmitter(stale, sink);
+        Assert.assertSame(sink, decoder.getHeaderEmitter());
+
+        // Further fields (e.g. from a CONTINUATION frame) must not reach the stale emitter
+        decoder.decode(ByteBuffer.wrap(LITERAL_A_B));
+        Assert.assertEquals(1, stale.names.size());
+    }
+
+    @Test
+    public void testOtherEmitterNotReplaced() throws Exception {
+        HpackDecoder decoder = new HpackDecoder();
+        RecordingEmitter current = new RecordingEmitter();
+        RecordingEmitter other = new RecordingEmitter();
+        decoder.setHeaderEmitter(current);
+
+        decoder.compareAndSetHeaderEmitter(other, new HeaderSink());
+        Assert.assertSame(current, decoder.getHeaderEmitter());
+
+        decoder.decode(ByteBuffer.wrap(LITERAL_A_B));
+        Assert.assertEquals(1, current.names.size());
+        Assert.assertEquals(0, other.names.size());
+    }
+
+
+    private static class RecordingEmitter implements HeaderEmitter {
+
+        private final List<String> names = new ArrayList<>();
+
+        @Override
+        public void emitHeader(String name, String value) {
+            names.add(name);
+        }
+
+        @Override
+        public void setHeaderException(StreamException streamException) {
+            // NO-OP
+        }
+
+        @Override
+        public void validateHeaders() throws StreamException {
+            // NO-OP
+        }
+    }
+}

