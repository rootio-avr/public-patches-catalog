+import org.junit.Assert;
+import org.junit.Test;
+
+import org.apache.catalina.Context;
+import org.apache.catalina.startup.Tomcat;
+import org.apache.tomcat.websocket.WebSocketBaseTest;
+
+/*
+ * Regression test for the loss of asynchronous WebSocket write timeouts when two writes have the same timeout expiry.
+ */
+public class TestWsWriteTimeout extends WebSocketBaseTest {
+
+    @Test
+    public void testEndpointsWithSameExpiryAreAllTimedOut() throws Exception {
+        Tomcat tomcat = getTomcatInstance();
+        // No file system docBase required
+        Context ctx = tomcat.addContext("", null);
+        ctx.addApplicationListener(WsContextListener.class.getName());
+        tomcat.start();
+
+        WsServerContainer serverContainer = (WsServerContainer) ctx.getServletContext()
+                .getAttribute(Constants.SERVER_CONTAINER_SERVLET_CONTEXT_ATTRIBUTE);
+        WsWriteTimeout wsWriteTimeout = serverContainer.getTimeout();
+
+        AtomicInteger timeoutCount = new AtomicInteger(0);
+        long expiry = System.currentTimeMillis() - 1000;
+
+        TimeoutEndpoint endpoint1 = new TimeoutEndpoint(serverContainer, expiry, timeoutCount);
+        TimeoutEndpoint endpoint2 = new TimeoutEndpoint(serverContainer, expiry, timeoutCount);
+
+        try {
+            wsWriteTimeout.register(endpoint1);
+            wsWriteTimeout.register(endpoint2);
+
+            wsWriteTimeout.backgroundProcess();
+
+            // Both endpoints must be timed out, even though their timeout expiry is identical
+            Assert.assertEquals(2, timeoutCount.get());
+        } finally {
+            wsWriteTimeout.unregister(endpoint1);
+            wsWriteTimeout.unregister(endpoint2);
+        }
+    }
+
+
+    private static class TimeoutEndpoint extends WsRemoteEndpointImplServer {
+
+        private final long expiry;
+        private final AtomicInteger timeoutCount;
+
+        TimeoutEndpoint(WsServerContainer serverContainer, long expiry, AtomicInteger timeoutCount) {
+            super(null, null, serverContainer, null);
+            this.expiry = expiry;
+            this.timeoutCount = timeoutCount;
+        }
+
+        @Override
+        protected long getTimeoutExpiry() {
+            return expiry;
+        }
+
+        @Override
+        protected void onTimeout(boolean useDispatch, long now) {
+            timeoutCount.incrementAndGet();
+        }
+    }
+}

