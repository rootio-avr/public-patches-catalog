+package org.apache.tomcat.util.http.parser;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Regression test for CVE-2026-41293.
+ *
+ * The fix extends {@link HttpParser} with field-vchar / field-content
+ * classification (RFC 7230) and enlarges the lookup tables to cover the full
+ * 0-255 range. HTTP/2 HPACK decoding relies on these predicates to reject
+ * header field names that are not lower-case tokens and header field values
+ * that contain characters outside the permitted set. This test pins the
+ * classification behaviour the HTTP/2 header filtering builds upon.
+ */
+public class TestCve202641293 {
+
+    @Test
+    public void testFieldVCharAcceptsVisibleAscii() {
+        // VCHAR: visible US-ASCII (0x21-0x7E)
+        Assert.assertTrue(HttpParser.isFieldVChar('a'));
+        Assert.assertTrue(HttpParser.isFieldVChar('Z'));
+        Assert.assertTrue(HttpParser.isFieldVChar('!'));
+        Assert.assertTrue(HttpParser.isFieldVChar('~'));
+    }
+
+    @Test
+    public void testFieldVCharRejectsControlsAndDel() {
+        // Low controls (<= 0x14), HTAB, CR, LF, NUL and DEL are not field-vchar
+        Assert.assertFalse(HttpParser.isFieldVChar('\t'));
+        Assert.assertFalse(HttpParser.isFieldVChar('\r'));
+        Assert.assertFalse(HttpParser.isFieldVChar('\n'));
+        Assert.assertFalse(HttpParser.isFieldVChar(0));
+        Assert.assertFalse(HttpParser.isFieldVChar(0x14));
+        Assert.assertFalse(HttpParser.isFieldVChar(0x7F));
+    }
+
+    @Test
+    public void testFieldVCharAcceptsObsText() {
+        // obs-text: 0x80-0xFF is permitted (tables now cover 0-255)
+        Assert.assertTrue(HttpParser.isFieldVChar(0x80));
+        Assert.assertTrue(HttpParser.isFieldVChar(0xFF));
+    }
+
+    @Test
+    public void testFieldContentAllowsInternalSpAndHtab() {
+        // field-content additionally permits SP and HTAB (used between vchars)
+        Assert.assertTrue(HttpParser.isFieldContent(' '));
+        Assert.assertTrue(HttpParser.isFieldContent('\t'));
+        Assert.assertTrue(HttpParser.isFieldContent('a'));
+        // But still rejects other controls
+        Assert.assertFalse(HttpParser.isFieldContent('\r'));
+        Assert.assertFalse(HttpParser.isFieldContent('\n'));
+        Assert.assertFalse(HttpParser.isFieldContent(0));
+    }
+
+    @Test
+    public void testTokenIsAsciiOnly() {
+        // Field names must be tokens; tokens are strictly < 128 (no obs-text)
+        Assert.assertTrue(HttpParser.isToken('a'));
+        Assert.assertTrue(HttpParser.isToken('-'));
+        Assert.assertFalse(HttpParser.isToken(' '));
+        Assert.assertFalse(HttpParser.isToken(':'));
+        Assert.assertFalse(HttpParser.isToken(0x80));
+        Assert.assertFalse(HttpParser.isToken(0xFF));
+    }
+
+    @Test
+    public void testOutOfRangeIsRejectedGracefully() {
+        // Negative / oversized code points must not throw
+        Assert.assertFalse(HttpParser.isFieldVChar(-1));
+        Assert.assertFalse(HttpParser.isFieldContent(-1));
+        Assert.assertFalse(HttpParser.isFieldVChar(0x100));
+        Assert.assertFalse(HttpParser.isFieldContent(0x100));
+    }
+}
