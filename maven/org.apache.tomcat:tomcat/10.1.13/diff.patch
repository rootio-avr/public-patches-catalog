+
+    private ChunkExtension() {
+        // Tomcat doesn't use this data. It only parses it to ensure that it is correctly formatted.
+    }
+
+
+    public enum State {
+        PRE_NAME,
+        NAME,
+        POST_NAME,
+        EQUALS,
+        VALUE,
+        QUOTED_VALUE,
+        POST_VALUE,
+        CR
+    }
