+package org.apache.catalina.realm;
+
+import java.util.ArrayList;
+import java.util.Hashtable;
+import java.util.List;
+
+import javax.naming.Context;
+import javax.naming.directory.DirContext;
+import javax.naming.directory.InitialDirContext;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import org.apache.tomcat.unittest.TesterContext;
+import org.easymock.Capture;
+import org.easymock.CaptureType;
+import org.easymock.EasyMock;
+
+/**
+ * Verifies that {@link JNDIRealm#bindAsUser} always validates credentials with
+ * a simple bind, regardless of the configured authentication mechanism, and
+ * restores the original mechanism afterwards.
+ */
+public class TestJNDIRealmBindAsUser {
+
+    @Test
+    public void testBindAsUserForcesSimpleBindAndRestores() throws Exception {
+        JNDIRealm realm = new JNDIRealm();
+        realm.setContainer(new TesterContext());
+        realm.setAuthentication("DIGEST-MD5");
+        realm.start();
+
+        Hashtable<String,Object> env = new Hashtable<>();
+        env.put(Context.SECURITY_AUTHENTICATION, "DIGEST-MD5");
+
+        Capture<String> names = EasyMock.newCapture(CaptureType.ALL);
+        Capture<Object> values = EasyMock.newCapture(CaptureType.ALL);
+
+        DirContext dirContext = EasyMock.createNiceMock(InitialDirContext.class);
+        EasyMock.expect(dirContext.getEnvironment()).andReturn(env).anyTimes();
+        EasyMock.expect(dirContext.addToEnvironment(EasyMock.capture(names),
+                EasyMock.capture(values))).andReturn(null).anyTimes();
+        EasyMock.expect(dirContext.removeFromEnvironment(EasyMock.anyString())).andReturn(null)
+                .anyTimes();
+        EasyMock.replay(dirContext);
+
+        List<String> roles = new ArrayList<>();
+        JNDIRealm.User user = new JNDIRealm.User("user", "cn=user", null, roles, null);
+
+        Assert.assertTrue(realm.bindAsUser(dirContext, user, "secret"));
+
+        // The bind must have been performed using "simple" authentication
+        boolean simpleSet = false;
+        for (int i = 0; i < names.getValues().size(); i++) {
+            if (Context.SECURITY_AUTHENTICATION.equals(names.getValues().get(i)) &&
+                    "simple".equals(values.getValues().get(i))) {
+                simpleSet = true;
+            }
+        }
+        Assert.assertTrue(simpleSet);
+
+        // The previously configured mechanism must have been restored
+        int last = -1;
+        for (int i = 0; i < names.getValues().size(); i++) {
+            if (Context.SECURITY_AUTHENTICATION.equals(names.getValues().get(i))) {
+                last = i;
+            }
+        }
+        Assert.assertEquals("DIGEST-MD5", values.getValues().get(last));
+    }
+}
