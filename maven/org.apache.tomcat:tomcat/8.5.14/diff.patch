+package org.apache.catalina.realm;
+
+import java.lang.reflect.Field;
+import java.util.Hashtable;
+
+import javax.naming.NamingException;
+import javax.naming.directory.Attributes;
+import javax.naming.directory.BasicAttributes;
+import javax.naming.directory.InitialDirContext;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import org.apache.tomcat.unittest.TesterContext;
+
+/**
+ * Regression test for CVE-2026-101296. When the JNDI realm validates a user
+ * and password by binding as the user, a simple bind must always be used
+ * regardless of the configured authentication mechanism, and the configured
+ * mechanism and connection credentials must be restored afterwards.
+ */
+public class TestJNDIRealmSimpleBind {
+
+    private static final String CONFIGURED_AUTHENTICATION = "EXTERNAL";
+    private static final String USER_DN = "uid=test-user,ou=people,dc=example,dc=com";
+
+    @Test
+    public void testBindAsUserUsesSimpleBind() throws Exception {
+        JNDIRealm realm = new JNDIRealm();
+        realm.setContainer(new TesterContext());
+        realm.start();
+
+        RecordingDirContext dirContext = new RecordingDirContext();
+        dirContext.addToEnvironment(javax.naming.Context.SECURITY_AUTHENTICATION,
+                CONFIGURED_AUTHENTICATION);
+
+        Field field = JNDIRealm.class.getDeclaredField("context");
+        field.setAccessible(true);
+        field.set(realm, dirContext);
+
+        JNDIRealm.User user = new JNDIRealm.User("test-user", USER_DN, null, null, null);
+        boolean validated = realm.bindAsUser(dirContext, user, "test-password");
+
+        Assert.assertTrue(validated);
+        // The bind must have been performed using the simple mechanism
+        Assert.assertEquals("simple", dirContext.authenticationAtBind);
+        Assert.assertEquals("test-password", dirContext.credentialsAtBind);
+        // The configured mechanism must be restored and credentials removed
+        Assert.assertEquals(CONFIGURED_AUTHENTICATION,
+                dirContext.getEnvironment().get(javax.naming.Context.SECURITY_AUTHENTICATION));
+        Assert.assertNull(dirContext.getEnvironment().get(javax.naming.Context.SECURITY_CREDENTIALS));
+    }
+
+
+    private static class RecordingDirContext extends InitialDirContext {
+
+        private final Hashtable<Object,Object> env = new Hashtable<>();
+        private String authenticationAtBind;
+        private Object credentialsAtBind;
+
+        RecordingDirContext() throws NamingException {
+            super(true);
+        }
+
+        @Override
+        public Hashtable<?,?> getEnvironment() throws NamingException {
+            // Like the real implementation, return a copy
+            return (Hashtable<?,?>) env.clone();
+        }
+
+        @Override
+        public Object addToEnvironment(String propName, Object propVal) throws NamingException {
+            return env.put(propName, propVal);
+        }
+
+        @Override
+        public Object removeFromEnvironment(String propName) throws NamingException {
+            return env.remove(propName);
+        }
+
+        @Override
+        public Attributes getAttributes(String name, String[] attrIds) throws NamingException {
+            authenticationAtBind = (String) env.get(javax.naming.Context.SECURITY_AUTHENTICATION);
+            credentialsAtBind = env.get(javax.naming.Context.SECURITY_CREDENTIALS);
+            return new BasicAttributes();
+        }
+    }
+}
