+     * @return <code>true</code> if the part can be used in a resource name.
+     */
+    private static boolean isSafeLocalePart(String part) {
+        if (part == null) {
+            return true;
+        }
+        for (int i = 0; i < part.length(); i++) {
+            char c = part.charAt(i);
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+                    || (c >= '0' && c <= '9') || c == '_' || c == '-')) {
+                return false;
+            }
+        }
+        return true;
+    }
