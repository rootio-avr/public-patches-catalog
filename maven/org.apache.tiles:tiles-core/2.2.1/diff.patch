+package org.apache.tiles.util;
+
+import java.util.List;
+import java.util.Locale;
+
+import junit.framework.TestCase;
+
+/**
+ * Tests that {@link LocaleUtil} does not build resource name postfixes from
+ * locales containing path traversal sequences (CVE-2023-49735).
+ */
+public class LocaleUtilSafetyTest extends TestCase {
+
+    /**
+     * A locale whose variant tries to escape the definitions directory.
+     */
+    private static final Locale EVIL = new Locale("en", "US",
+            "../../../../etc/passwd");
+
+    /**
+     * Tests {@link LocaleUtil#isSafeLocale(Locale)}.
+     */
+    public void testIsSafeLocale() {
+        assertTrue(LocaleUtil.isSafeLocale(null));
+        assertTrue(LocaleUtil.isSafeLocale(Locale.US));
+        assertTrue(LocaleUtil.isSafeLocale(new Locale("en", "US", "POSIX")));
+        assertFalse(LocaleUtil.isSafeLocale(EVIL));
+        assertFalse(LocaleUtil.isSafeLocale(new Locale("..", "", "")));
+        assertFalse(LocaleUtil.isSafeLocale(new Locale("en", "U/S", "")));
+    }
+
+    /**
+     * Tests {@link LocaleUtil#calculatePostfix(Locale)}.
+     */
+    public void testCalculatePostfixUnsafe() {
+        assertEquals("", LocaleUtil.calculatePostfix(EVIL));
+        assertEquals("_en_US", LocaleUtil.calculatePostfix(Locale.US));
+    }
+
+    /**
+     * Tests {@link LocaleUtil#calculatePostfixes(Locale)}.
+     */
+    public void testCalculatePostfixesUnsafe() {
+        List<String> posts = LocaleUtil.calculatePostfixes(EVIL);
+        assertEquals(1, posts.size());
+        assertEquals("", posts.get(0));
+        assertEquals(3, LocaleUtil.calculatePostfixes(Locale.US).size());
+    }
+}
