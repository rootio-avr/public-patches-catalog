+	@Test
+	void applicationSourceAcceptsAnyHttpUri() {
+		assertThat(this.sender.supports(URI.create("http://127.0.0.1/service"), UriSource.APPLICATION)).isTrue();
+		assertThat(this.sender.supports(URI.create("http://10.0.0.1/service"), UriSource.APPLICATION)).isTrue();
+		assertThat(this.sender.supports(URI.create("http://localhost/service"), UriSource.APPLICATION)).isTrue();
+	}
+
+	@Test
+	void legacySupportsStillAcceptsHttpAndHttps() {
+		assertThat(this.sender.supports(URI.create("http://10.0.0.1/service"))).isTrue();
+		assertThat(this.sender.supports(URI.create("https://example.com/service"))).isTrue();
+		assertThat(this.sender.supports(URI.create("ftp://example.com/service"))).isFalse();
+	}
+
+	@Test
+	void remoteSourceRejectsNonHttpScheme() {
+		assertThat(this.sender.supports(URI.create("ftp://example.com/service"), UriSource.REMOTE)).isFalse();
+	}
