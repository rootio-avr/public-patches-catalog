+					.hasMessage(
+							"The 'fluxFunction' must emit a Message<?> for every element; got: class java.lang.String");
+		}
+		finally {
+			Hooks.resetOnErrorDropped();
+		}
+
+		integrationFlowRegistration.destroy();
