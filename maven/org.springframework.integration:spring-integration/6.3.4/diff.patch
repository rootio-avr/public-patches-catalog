+// spring-plugin-repos.init.gradle
+// Removes Spring-internal and unavailable Gradle plugins from settings.gradle
+// and build.gradle before Gradle evaluates them.
+// None of the removed plugins are required for compiling spring-integration-file.
+//
+// NOTE on regex trailing whitespace: use [ \\t]*\\n? NOT \\s*\\n? —
+// \\s includes newlines and would swallow the next line's indent, causing the
+// next ^-anchored pattern to miss (e.g. kotlin-spring left behind).
+
+// ── Helper: remove a named block using balanced-brace counting ──
+// nextChain: also remove a chained call on the same line, e.g. ".configureEach"
+// between name and '{' MUST be same-line (rejects "javadoc\\n\\npublishing {").
+static String removeNamedBlock(String content, String blockName, String nextChain = null) {
+    def buf = content
+    def pattern = blockName.trim()
+    def idx = buf.indexOf(pattern)
+    while (idx >= 0) {
+        def braceIdx = buf.indexOf('{', idx + pattern.length())
+        if (braceIdx < 0) break
+
+        def betweenRaw = buf.substring(idx + pattern.length(), braceIdx)
+        if (betweenRaw.contains('\n') || betweenRaw.contains('\r')) {
+            idx = buf.indexOf(pattern, idx + 1)
+            continue
+        }
+
+        def between = betweenRaw.trim()
+        if (!between.isEmpty() && !between.matches('[a-zA-Z0-9_\\s\\(\\).,"\':]+')) {
+            idx = buf.indexOf(pattern, idx + 1)
+            continue
+        }
+
+        def depth = 0
+        def end = braceIdx
+        for (def i = braceIdx; i < buf.length(); i++) {
+            if (buf[i] == '{') depth++
+            else if (buf[i] == '}') {
+                depth--
+                if (depth == 0) { end = i; break }
+            }
+        }
+
+        if (nextChain) {
+            def remaining = buf.substring(end + 1)
+            def trimmedRemaining = remaining.replaceAll(/^[\t ]*/, '')
+            if (trimmedRemaining.startsWith(nextChain)) {
+                def chainStart = end + 1 + (remaining.length() - trimmedRemaining.length())
+                def chainBraceIdx = buf.indexOf('{', chainStart + nextChain.length())
+                if (chainBraceIdx >= 0) {
+                    def d2 = 0
+                    def end2 = chainBraceIdx
+                    for (def i = chainBraceIdx; i < buf.length(); i++) {
+                        if (buf[i] == '{') d2++
+                        else if (buf[i] == '}') {
+                            d2--
+                            if (d2 == 0) { end2 = i; break }
+                        }
+                    }
+                    end = end2
+                }
+            }
+        }
+
+        def removeEnd = end + 1
+        if (removeEnd < buf.length() && buf[removeEnd] == '\n') removeEnd++
+        def removeStart = idx
+        while (removeStart > 0 && buf[removeStart - 1] in [' ', '\t']) removeStart--
+
+        buf = buf.substring(0, removeStart) + buf.substring(removeEnd)
+        idx = buf.indexOf(pattern)
+    }
+    return buf
+}
+
+def pluginIdsToRemove = [
+    'io.spring.develocity.conventions',
+    'org.ajoberstar.grgit',
+    'io.spring.nohttp',
+    'org.jetbrains.dokka',
+    'org.antora',
+    'io.spring.antora.generate-antora-yml',
+    'com.github.spotbugs',
+    'io.freefair.aggregate-javadoc',
+    'com.google.protobuf'
+]
+
+beforeSettings { Settings settings ->
+    ['settings.gradle', 'settings.gradle.kts'].each { fn ->
+        def f = new File(settings.settingsDir, fn)
+        if (!f.exists()) return
+        def original = f.text
+        def modified = original
+        // Remove Develocity plugin (Spring private / unavailable)
+        modified = modified.replaceAll(/(?s)plugins\s*\{[^}]*io\.spring\.develocity\.conventions[^}]*\}[\r\n]*/, '')
+        // Maven Central IP-blocked → Google mirror (pluginManagement + any other repos)
+        modified = modified.replaceAll(
+            /(?m)^([ \t]*)mavenCentral\(\)[ \t]*$/,
+            '$1maven { url \'https://maven-central.storage-download.googleapis.com/maven2/\' }'
+        )
+        if (modified != original) {
+            f.text = modified
+            logger.lifecycle("[init-script] Patched ${fn}: removed develocity + mirrored mavenCentral")
+        }
+    }
+}
+
+settingsEvaluated { Settings settings ->
+    ['build.gradle', 'build.gradle.kts'].each { fn ->
+        def f = new File(settings.rootProject.projectDir, fn)
+        if (!f.exists()) return
+        def original = f.text
+        def modified = original
+
+        // 1. Disable CI flag
+        modified = modified.replaceAll(
+            /(?m)(ext\.isCI\s*=\s*)System\.getenv\([^)]+\)/,
+            '$1false'
+        )
+
+        // 2. Replace grgit.status() — consume BOTH .filter{} and .from{} braces
+        modified = modified.replaceAll(
+            /(?s)modifiedFiles\s*=\s*\n?\s*files\(\)\s*\n?\s*\.from\s*\{[^}]*grgit\.status\(\)[^}]*\}[^}]*\}[\r\n]*/,
+            'modifiedFiles = files()\n'
+        )
+
+        // 3. Remove plugin id lines
+        pluginIdsToRemove.each { pluginId ->
+            def escaped = pluginId.replace('.', '\\.').replace('-', '\\-')
+            modified = modified.replaceAll(
+                /(?m)^[ \t]*id\s*[\('"]{1,2}${escaped}['") \t][^\n]*\n?/, ''
+            )
+        }
+
+        // 4. Remove apply plugin lines (blocked plugins + kotlin)
+        pluginIdsToRemove.each { pluginId ->
+            def escaped = pluginId.replace('.', '\\.').replace('-', '\\-')
+            modified = modified.replaceAll(
+                /(?m)^[ \t]*apply\s+plugin:\s*['"]${escaped}['"][ \t]*\n?/, ''
+            )
+        }
+        modified = modified.replaceAll(/(?m)^[ \t]*apply\s+plugin:\s*['"]kotlin[^'"]*['"][ \t]*\n?/, '')
+        modified = modified.replaceAll(/(?m)^[ \t]*apply\s+plugin:\s*['"]org\.jetbrains\.kotlin[^'"]*['"][ \t]*\n?/, '')
+
+        // 5. Remove Kotlin classpath
+        modified = modified.replaceAll(/(?m)^[ \t]*classpath\s+"org\.jetbrains\.kotlin:[^"]+"[ \t]*\n?/, '')
+        modified = modified.replaceAll(/(?m)^[ \t]*classpath\s+'org\.jetbrains\.kotlin:[^']+'[ \t]*\n?/, '')
+
+        // 6. Remove spotbugs-annotations usage
+        modified = modified.replaceAll(/(?m)^[ \t]*def spotbugsAnnotations[^\n]*\n?/, '')
+        modified = modified.replaceAll(/(?m)^[ \t]*(compileOnly|testCompileOnly)\s+spotbugsAnnotations[^\n]*\n?/, '')
+
+        // 7. Remove compileKotlin / protobuf / aggregate-javadoc
+        modified = removeNamedBlock(modified, 'compileKotlin')
+        modified = modified.replaceAll(/(?m)^[ \t]*compileKotlin\.[^\n]*\n?/, '')
+        modified = removeNamedBlock(modified, 'protobuf')
+        modified = modified.replaceAll(
+            /(?s)\n[ \t]*dependencies\s*\{\s*\n[ \t]*javaProjects\.each\s*\{[^}]*javadoc[^}]*\}[^}]*\}\s*\n/,
+            '\n'
+        )
+        modified = modified.replaceAll(/(?s)\s*from\(javadoc\)\s*\{[^}]*\}[\r\n]*/, '')
+        modified = removeNamedBlock(modified, 'javadoc')
+        modified = modified.replaceAll(
+            /(?s)\n[ \t]*tasks\.register\('api'\)\s*\{[^}]*dependsOn\s+javadoc[^}]*\}\s*\n/,
+            '\n'
+        )
+        modified = modified.replaceAll(
+            /(?m)^([ \t]*check\.dependsOn\s+)([^,\n]+),[ \t]*javadoc[ \t]*$/,
+            '$1$2'
+        )
+
+        // 8. Dokka configurations + tasks
+        modified = removeNamedBlock(modified, 'configurations.matching', '.configureEach')
+        modified = modified.replaceAll(/(?m)^[ \t]*dependsOn 'dokkaHtmlMultiModule'[^\n]*\n?/, '')
+        modified = modified.replaceAll(/(?s)\s*from\(dokkaHtmlMultiModule\.outputDirectory\)\s*\{[^}]*\}[\r\n]*/, '')
+        modified = removeNamedBlock(modified, 'dokkaHtmlPartial')
+        modified = removeNamedBlock(modified, 'dokkaHtmlMultiModule')
+
+        // 9. Skip docs.gradle (requires org.antora / generate-antora-yml plugins)
+        modified = modified.replaceAll(
+            /(?m)^[ \t]*apply\s+from:\s*["']\$\{rootDir\}\/gradle\/docs\.gradle["'][ \t]*\n?/,
+            ''
+        )
+
+        // 10. Empty plugins blocks
+        modified = modified.replaceAll(/(?s)plugins\s*\{\s*\}[\r\n]*/, '')
+
+        // 11. Maven Central is IP-blocked (403) in this environment; use Google mirror.
+        //     Keep mavenCentral() name for dependency-management plugin compatibility by
+        //     replacing the repository URL via an explicit maven {} entry.
+        modified = modified.replaceAll(
+            /(?m)^([ \t]*)mavenCentral\(\)[ \t]*$/,
+            '$1maven { url \'https://maven-central.storage-download.googleapis.com/maven2/\' }'
+        )
+
+        if (modified != original) {
+            f.text = modified
+            logger.lifecycle("[init-script] Patched ${fn} in root project: removed unavailable plugin/classpath declarations")
+        }
+    }
+}

