+
+/**
+ * Tests that deeply nested encoded types are rejected with a regular exception rather
+ * than exhausting the stack (StackOverflowError) during decode (CVE-2026-66274).
+ */
+public class DecodeDepthLimitTest extends CodecTestSupport {
+
+    private static final int EXCESSIVE_DEPTH = 20000;
+    private static final int LIST32 = 0xd0;
+    private static final int MAP32 = 0xd1;
+    private static final int ARRAY32 = 0xf0;
+
+    private static void putInt(byte[] target, int offset, int value) {
+        target[offset] = (byte) (value >>> 24);
+        target[offset + 1] = (byte) (value >>> 16);
+        target[offset + 2] = (byte) (value >>> 8);
+        target[offset + 3] = (byte) value;
+    }
+
+    /** Builds a payload of 'depth' list32s each holding the next, innermost holds a null. */
+    private static byte[] nestedLists(int depth) {
+        final int stride = 9; // constructor + size + count
+        final byte[] payload = new byte[depth * stride + 1];
+        for (int i = 0; i < depth; i++) {
+            final int offset = i * stride;
+            payload[offset] = (byte) LIST32;
+            putInt(payload, offset + 1, payload.length - (offset + 5)); // size
+            putInt(payload, offset + 5, 1); // count
+        }
+        payload[payload.length - 1] = 0x40; // null
+        return payload;
+    }
+
+    /** Builds a payload of 'depth' map32s each holding a null key and the next map as the value. */
+    private static byte[] nestedMaps(int depth) {
+        final int stride = 10; // constructor + size + count + null key
+        final byte[] payload = new byte[depth * stride + 1];
+        for (int i = 0; i < depth; i++) {
+            final int offset = i * stride;
+            payload[offset] = (byte) MAP32;
+            putInt(payload, offset + 1, payload.length - (offset + 5)); // size
+            putInt(payload, offset + 5, 2); // count
+            payload[offset + 9] = 0x40; // null key
+        }
+        payload[payload.length - 1] = 0x40; // null value
+        return payload;
+    }
+
+    /** Builds a payload of 'depth' array32s each holding a single array32 element. */
+    private static byte[] nestedArrays(int depth) {
+        final int stride = 9; // size + count + element constructor, with the first constructor leading
+        final byte[] payload = new byte[1 + depth * stride + 1];
+        payload[0] = (byte) ARRAY32;
+        for (int i = 0; i < depth; i++) {
+            final int offset = 1 + i * stride;
+            putInt(payload, offset, payload.length - (offset + 4)); // size
+            putInt(payload, offset + 4, 1); // count
+            payload[offset + 8] = (byte) (i < depth - 1 ? ARRAY32 : 0x50); // element constructor, ubyte innermost
+        }
+        payload[payload.length - 1] = 0x00; // the innermost ubyte element
+        return payload;
+    }
+
+    /** Builds a payload of 'depth' described types (smallulong descriptor) wrapping each other. */
+    private static byte[] nestedDescribed(int depth) {
+        final byte[] payload = new byte[depth * 3 + 1];
+        for (int i = 0; i < depth; i++) {
+            payload[i * 3] = 0x00;
+            payload[i * 3 + 1] = 0x53;
+            payload[i * 3 + 2] = 0x01;
+        }
+        payload[payload.length - 1] = 0x40;
+        return payload;
+    }
+
+    /** Builds a payload where the descriptors themselves are described types. */
+    private static byte[] nestedDescriptors(int depth) {
+        final byte[] payload = new byte[depth + 1];
+        payload[depth] = 0x40;
+        return payload;
+    }
+
+    private void assertDecodeRejected(byte[] payload) {
+        decoder.setByteBuffer(ByteBuffer.wrap(payload));
+        try {
+            decoder.readObject();
+            fail("Expected decode to be rejected");
+        } catch (DecodeException expected) {
+            // expected
+        }
+    }
+
+    private void assertDataDecodeRejected(byte[] payload) {
+        DataImpl data = new DataImpl();
+        try {
+            data.decode(ByteBuffer.wrap(payload));
+            fail("Expected decode to be rejected");
+        } catch (IllegalArgumentException expected) {
+            // expected
+        }
+    }
+
+    @Test
+    public void testDecoderRejectsExcessivelyNestedLists() {
+        assertDecodeRejected(nestedLists(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDecoderRejectsExcessivelyNestedMaps() {
+        assertDecodeRejected(nestedMaps(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDecoderRejectsExcessivelyNestedArrays() {
+        assertDecodeRejected(nestedArrays(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDecoderRejectsNestedDescribedTypes() {
+        assertDecodeRejected(nestedDescribed(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDecoderRejectsNestedDescribedTypeDescriptors() {
+        assertDecodeRejected(nestedDescriptors(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDecoderAllowsNestingWithinConfiguredLimit() {
+        decoder.setMaxDecodeDepth(10);
+        decoder.setByteBuffer(ByteBuffer.wrap(nestedLists(10)));
+
+        Object result = decoder.readObject();
+        assertNotNull(result);
+        assertTrue(result instanceof List);
+    }
+
+    @Test
+    public void testDecoderRejectsNestingBeyondConfiguredLimit() {
+        decoder.setMaxDecodeDepth(10);
+        assertDecodeRejected(nestedLists(11));
+    }
+
+    @Test
+    public void testDecoderDepthUnwindsAfterFailure() {
+        assertDecodeRejected(nestedLists(EXCESSIVE_DEPTH));
+
+        // The same decoder must still be usable for a payload within the limit.
+        decoder.setByteBuffer(ByteBuffer.wrap(nestedLists(decoder.getMaxDecodeDepth())));
+        assertNotNull(decoder.readObject());
+    }
+
+    @Test
+    public void testDataRejectsExcessivelyNestedLists() {
+        assertDataDecodeRejected(nestedLists(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDataRejectsExcessivelyNestedMaps() {
+        assertDataDecodeRejected(nestedMaps(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDataRejectsExcessivelyNestedDescribedTypes() {
+        assertDataDecodeRejected(nestedDescribed(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDataRejectsNestedDescribedTypeDescriptors() {
+        assertDataDecodeRejected(nestedDescriptors(EXCESSIVE_DEPTH));
+    }
+
+    @Test
+    public void testDataAllowsNestingWithinConfiguredLimit() {
+        DataImpl data = new DataImpl();
+        data.setMaxDecodeDepth(10);
+
+        byte[] payload = nestedLists(10);
+        long decoded = data.decode(ByteBuffer.wrap(payload));
+        assertEquals(payload.length, decoded);
+    }
