+package hudson.cli;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.hasItem;
+import static org.hamcrest.Matchers.not;
+
+import hudson.Functions;
+import java.lang.management.ThreadInfo;
+import java.util.Arrays;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.stream.Collectors;
+import jenkins.util.FullDuplexHttpService;
+import org.awaitility.Awaitility;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.jvnet.hudson.test.JenkinsRule;
+
+/**
+ * Regression test for SECURITY-3630 (CVE-2025-67635).
+ *
+ * <p>The HTTP-based Jenkins CLI used to wait indefinitely for the peer side of a
+ * full-duplex connection. A client that opened the download side and then closed
+ * its streams without ever completing the handshake left the server-side handler
+ * thread blocked forever, allowing unauthenticated clients to exhaust server
+ * threads. The fix bounds those waits with {@link FullDuplexHttpService#CONNECTION_TIMEOUT}.
+ *
+ * <p>Grounded on the upstream {@code testIndefiniteWait} case: after the client
+ * abandons the connection, the "Handling POST /jenkins/cli" handler thread must
+ * disappear within the bounded timeout rather than lingering indefinitely.
+ */
+public class Security3630Test {
+
+    @Rule
+    public JenkinsRule j = new JenkinsRule();
+
+    private long originalTimeout;
+
+    @Before
+    public void setup() {
+        originalTimeout = FullDuplexHttpService.CONNECTION_TIMEOUT;
+        FullDuplexHttpService.CONNECTION_TIMEOUT = TimeUnit.SECONDS.toMillis(5);
+    }
+
+    @After
+    public void reset() {
+        FullDuplexHttpService.CONNECTION_TIMEOUT = originalTimeout;
+    }
+
+    @Test
+    public void testIndefiniteWait() throws Exception {
+        FullDuplexHttpStream stream = new FullDuplexHttpStream(j.getURL(), "cli?remoting=false", null);
+        {
+            Set<String> threadNames = Arrays.stream(Functions.getThreadInfos())
+                    .map(ThreadInfo::getThreadName)
+                    .collect(Collectors.toSet());
+            assertThat(threadNames, hasItem(containsString("Handling POST /jenkins/cli")));
+        }
+        stream.getOutputStream().write(new byte[10]);
+        stream.getOutputStream().close();
+        stream.getInputStream().close();
+
+        // Without the fix the handler thread would block on wait() forever;
+        // with the fix it must exit once CONNECTION_TIMEOUT elapses.
+        Awaitility.await().atMost(FullDuplexHttpService.CONNECTION_TIMEOUT * 2, TimeUnit.MILLISECONDS)
+                .untilAsserted(() -> {
+                    Set<String> threadNames = Arrays.stream(Functions.getThreadInfos())
+                            .map(ThreadInfo::getThreadName)
+                            .collect(Collectors.toSet());
+                    assertThat(threadNames, not(hasItem(containsString("Handling POST /jenkins/cli"))));
+                });
+    }
+}

