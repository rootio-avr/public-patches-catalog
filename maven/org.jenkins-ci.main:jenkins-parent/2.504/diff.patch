+/**
+ * Regression test for the stored XSS in the offline cause description rendered
+ * by {@code hudson/slaves/OfflineCause/cause.jelly} (SECURITY-3731 /
+ * CVE-2026-53441).
+ *
+ * <p>An {@link hudson.slaves.OfflineCause.SimpleOfflineCause} backed by a
+ * {@code Localizable} whose arguments contain HTML must be HTML-escaped when
+ * rendered on the node page. Previously {@code cause.jelly} emitted the value
+ * via {@code <j:out value="${it}"/>}, which does not escape and allowed the raw
+ * markup to reach the page; the fix relies on Jelly's default escaping.
+ */
+public class Security3731Test {
+
+    @Rule
+    public JenkinsRule jenkinsRule = new JenkinsRule();
+
+    @Test
+    @Issue("SECURITY-3731")
+    public void postConfigXmlWithNonUserCause() throws Exception {
+        final DumbSlave agent = jenkinsRule.createOnlineSlave();
+
+        String xml = "<?xml version='1.0' encoding='UTF-8'?>\n" +
+                "<slave>\n" +
+                "  <temporaryOfflineCause class=\"hudson.slaves.OfflineCause$SimpleOfflineCause\">\n" +
+                "    <description>\n" +
+                "      <holder>\n" +
+                "        <owner>hudson.slaves.Messages</owner>\n" +
+                "      </holder>\n" +
+                "      <key>SlaveComputer.DisconnectedBy</key>\n" +
+                "      <args>\n" +
+                "        <string>admin</string>\n" +
+                "        <string>&lt;img src=x onerror=alert(1)&gt;</string>\n" +
+                "      </args>\n" +
+                "    </description>\n" +
+                "  </temporaryOfflineCause>\n" +
+                "  <name>" + agent.getNodeName() + "</name>\n" +
+                "  <description></description>\n" +
+                "  <remoteFS>/tmp/foo</remoteFS>\n" +
+                "  <numExecutors>1</numExecutors>\n" +
+                "  <mode>NORMAL</mode>\n" +
+                "  <retentionStrategy class=\"hudson.slaves.RetentionStrategy$Always\"/>\n" +
+                "  <launcher class=\"hudson.slaves.JNLPLauncher\">\n" +
+                "    <workDirSettings>\n" +
+                "      <disabled>false</disabled>\n" +
+                "      <internalDir>remoting</internalDir>\n" +
+                "      <failIfWorkDirIsMissing>false</failIfWorkDirIsMissing>\n" +
+                "    </workDirSettings>\n" +
+                "    <webSocket>false</webSocket>\n" +
+                "  </launcher>\n" +
+                "  <label></label>\n" +
+                "  <nodeProperties/>\n" +
+                "</slave>";
+        agent.toComputer().updateByXml(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8)));
+
+        try (JenkinsRule.WebClient webClient = jenkinsRule.createWebClient()) {
+            final HtmlPage nodePage = webClient.getPage(agent);
+            assertThat(
+                    nodePage.getWebResponse().getContentAsString(),
+                    allOf(
+                            not(containsString("<img src=x onerror=alert(1)>")),
+                            containsString("&lt;img src=x onerror=alert(1)>")));
+        }
+    }
+}

