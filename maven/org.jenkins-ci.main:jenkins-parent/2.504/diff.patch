+package hudson.util;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.contains;
+import static org.hamcrest.Matchers.empty;
+import static org.hamcrest.Matchers.instanceOf;
+import static org.hamcrest.Matchers.not;
+import static org.junit.Assert.assertNotEquals;
+
+import hudson.model.Describable;
+import hudson.model.Descriptor;
+import org.junit.Test;
+import org.jvnet.hudson.test.Issue;
+
+/**
+ * Regression test for CVE-2026-53435 (SECURITY-3707).
+ *
+ * <p>Before the fix, {@link DescribableList}'s XStream converter did not validate that
+ * deserialized list elements matched the list's declared element type. An attacker able to
+ * supply a crafted {@code config.xml} could therefore smuggle arbitrary types into a
+ * {@link DescribableList} field, enabling arbitrary type deserialization (and downstream
+ * user impersonation / RCE). The fix wires the declared element type through
+ * {@link RobustReflectionConverter} into {@link CopyOnWriteList.ConverterImpl}, which now
+ * silently drops any element whose runtime type is not an instance of the declared element
+ * type.
+ *
+ * <p>Grounded on the upstream {@code DescribableListTest.associatedConverterUsed} test added
+ * in commit 345a3190a49d1ac96c4ff1c2e9eef4102c8d63f6, translated to the JUnit 4 idiom used by
+ * the surrounding core test module.
+ */
+public class CVE202653435RegressionTest {
+
+    @Issue("SECURITY-3707")
+    @Test
+    public void invalidElementTypeIsRejectedDuringDeserialization() {
+        XStream2 xstream = new XStream2();
+
+        MyDescribableData data = new MyDescribableData();
+        data.describables = new DescribableList<>();
+        data.describables.add(new MyDescribable());
+        String xml = xstream.toXML(data);
+
+        // Sanity check (normal input): a legitimate element round-trips and is retained.
+        Object roundTripped = xstream.fromXML(xml);
+        assertThat(roundTripped, instanceOf(MyDescribableData.class));
+        assertThat(((MyDescribableData) roundTripped).describables, contains(instanceOf(MyDescribable.class)));
+
+        // Craft a malicious document that substitutes a bare String for the expected element type.
+        String craftedXml = xml.replace(
+                "<hudson.util.CVE202653435RegressionTest_-MyDescribable/>",
+                "<string>42</string>");
+        assertNotEquals("crafted XML must differ from the legitimate serialization", xml, craftedXml);
+
+        Object o = xstream.fromXML(craftedXml);
+        assertThat(o, instanceOf(MyDescribableData.class));
+        DescribableList<MyDescribable, MyDescribable.DescriptorImpl> list = ((MyDescribableData) o).describables;
+        assertThat(list, instanceOf(DescribableList.class));
+        // The invalid (String) element must be dropped rather than smuggled into the list.
+        assertThat(list, empty());
+        assertThat(list, not(contains(instanceOf(String.class))));
+    }
+
+    private static class MyDescribableData {
+        private DescribableList<MyDescribable, MyDescribable.DescriptorImpl> describables;
+    }
+
+    public static class MyDescribable implements Describable<MyDescribable> {
+        @Override
+        public Descriptor<MyDescribable> getDescriptor() {
+            return new DescriptorImpl();
+        }
+
+        public static class DescriptorImpl extends Descriptor<MyDescribable> {
+        }
+    }
+}

