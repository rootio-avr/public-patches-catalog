Description: Fix CVE-2022-31159 partial path traversal in TransferManager.downloadDirectory
 The leavesRoot() guard used String.startsWith on canonical paths without slash
 termination, so a destination prefix-matched sibling directories
 (e.g., "/tmp/foo".startsWith("/tmp/foo-bar") style aliasing). A malicious S3
 object key with ".." components could write files outside the intended
 destination directory. This patch replaces the String-based check with
 java.nio.file.Path.startsWith(Path), which compares whole path elements.
Origin: upstream, https://github.com/aws/aws-sdk-java/commit/cb66c50c885566d9a7fce837a68dc48ddced8a9a
Author: AWS <>
Last-Update: 2022-07-14
Bug: https://github.com/aws/aws-sdk-java/security/advisories/GHSA-c28r-hw5m-5gv3

--- a/aws-java-sdk-s3/src/main/java/com/amazonaws/services/s3/transfer/TransferManager.java
+++ b/aws-java-sdk-s3/src/main/java/com/amazonaws/services/s3/transfer/TransferManager.java
@@ -82,6 +82,7 @@
 import java.io.IOException;
 import java.io.InputStream;
 import java.net.URL;
+import java.nio.file.Path;
 import java.util.ArrayList;
 import java.util.Date;
 import java.util.LinkedList;
@@ -1512,7 +1513,9 @@
 
     private boolean leavesRoot(File localBaseDirectory, String key) {
         try {
-            return !new File(localBaseDirectory, key).getCanonicalPath().startsWith(localBaseDirectory.getCanonicalPath());
+            Path targetPath = new File(localBaseDirectory, key).getCanonicalFile().toPath();
+            Path rootPath = localBaseDirectory.getCanonicalFile().toPath();
+            return !targetPath.startsWith(rootPath);
         } catch (IOException e) {
             throw new RuntimeException("Unable to canonicalize paths",  e);
         }

