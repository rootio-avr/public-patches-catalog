+package io.netty.handler.codec.xml;
+
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.util.CharsetUtil;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+/**
+ * Regression test for CVE-2026-56817.
+ *
+ * {@link XmlDecoder} is backed by the Aalto async XML parser and reads from the
+ * network, so all input must be treated as untrusted. Before the fix, DTDs,
+ * external entities and entity-reference replacement were enabled, allowing XML
+ * External Entity (XXE) attacks such as reading local files or triggering
+ * outbound requests / entity expansion.
+ *
+ * After the fix the decoder disables SUPPORT_DTD,
+ * IS_SUPPORTING_EXTERNAL_ENTITIES and IS_REPLACING_ENTITY_REFERENCES on the
+ * input factory, so feeding a payload that declares an external SYSTEM entity
+ * must not resolve/replace that entity. Feeding the payload must not leak the
+ * contents of the referenced resource into any emitted message.
+ */
+public class Cve202656817RegressionTest {
+
+    // Classic XXE payload: declares an external SYSTEM entity and references it
+    // in the document body.
+    private static final String XXE_PAYLOAD =
+            "<?xml version=\"1.0\"?>" +
+            "<!DOCTYPE root [<!ENTITY xxe SYSTEM \"file:///etc/hostname\">]>" +
+            "<root>&xxe;</root>";
+
+    @Test
+    public void externalEntityMustNotBeResolved() throws Exception {
+        EmbeddedChannel channel = new EmbeddedChannel(new XmlDecoder());
+        try {
+            // Feeding a DTD/external-entity payload must not cause the decoder to
+            // resolve the external entity. With DTD support and entity-reference
+            // replacement disabled, no CHARACTERS message should carry resolved
+            // external content.
+            channel.writeInbound(Unpooled.copiedBuffer(XXE_PAYLOAD, CharsetUtil.UTF_8));
+
+            Object msg;
+            while ((msg = channel.readInbound()) != null) {
+                if (msg instanceof XmlCharacters) {
+                    String text = ((XmlCharacters) msg).data();
+                    // The external entity must never have been expanded into
+                    // resolved external content.
+                    assertFalse(text != null && text.contains("file:///"),
+                            "External entity must not be resolved");
+                }
+            }
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+}

