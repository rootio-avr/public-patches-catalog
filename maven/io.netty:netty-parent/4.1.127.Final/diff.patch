+package io.netty.handler.codec.spdy;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.handler.codec.TooLongFrameException;
+import io.netty.handler.codec.http.DefaultFullHttpResponse;
+import io.netty.handler.codec.http.FullHttpMessage;
+import io.netty.handler.codec.http.HttpResponseStatus;
+import io.netty.handler.codec.http.HttpVersion;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Regression test for CVE-2026-56745: {@link SpdyHttpDecoder} leaked the
+ * {@link ByteBuf} backing a partially-received {@link FullHttpMessage} whenever
+ * a stream was torn down (RST_STREAM) or exceeded {@code maxContentLength}
+ * before the message was fully assembled. The message was removed from the
+ * internal map but never released, allowing a remote peer to exhaust memory
+ * (CWE-400).
+ */
+public class SpdyHttpDecoderCVE202656745RegressionTest {
+
+    /**
+     * Test decoder that pre-populates the partial-message map with a message we
+     * control, so we can assert it is released on stream teardown.
+     */
+    private static final class TestSpdyHttpDecoder extends SpdyHttpDecoder {
+        private final Map<Integer, FullHttpMessage> map;
+
+        TestSpdyHttpDecoder(int maxContentLength, Map<Integer, FullHttpMessage> map) {
+            super(SpdyVersion.SPDY_3_1, maxContentLength, map);
+            this.map = map;
+        }
+
+        void seed(int streamId, FullHttpMessage message) {
+            putMessage(streamId, message);
+        }
+    }
+
+    @Test
+    public void rstStreamReleasesBufferedMessage() {
+        Map<Integer, FullHttpMessage> map = new HashMap<Integer, FullHttpMessage>();
+        TestSpdyHttpDecoder decoder = new TestSpdyHttpDecoder(1024, map);
+        EmbeddedChannel channel = new EmbeddedChannel(decoder);
+
+        int streamId = 1;
+        ByteBuf content = Unpooled.buffer().writeBytes(new byte[64]);
+        FullHttpMessage buffered = new DefaultFullHttpResponse(
+                HttpVersion.HTTP_1_1, HttpResponseStatus.OK, content);
+        decoder.seed(streamId, buffered);
+        Assertions.assertEquals(1, buffered.refCnt());
+
+        // A RST_STREAM for the in-flight stream must drop and release the buffered message.
+        channel.writeInbound(new DefaultSpdyRstStreamFrame(streamId, SpdyStreamStatus.CANCEL));
+
+        Assertions.assertEquals(0, buffered.refCnt(), "buffered message must be released on RST_STREAM");
+        Assertions.assertTrue(map.isEmpty(), "buffered message must be removed from the map");
+        Assertions.assertFalse(channel.finishAndReleaseAll());
+    }
+
+    @Test
+    public void maxContentLengthOverflowReleasesBufferedMessage() {
+        Map<Integer, FullHttpMessage> map = new HashMap<Integer, FullHttpMessage>();
+        TestSpdyHttpDecoder decoder = new TestSpdyHttpDecoder(16, map);
+        EmbeddedChannel channel = new EmbeddedChannel(decoder);
+
+        int streamId = 3;
+        ByteBuf content = Unpooled.buffer().writeBytes(new byte[8]);
+        FullHttpMessage buffered = new DefaultFullHttpResponse(
+                HttpVersion.HTTP_1_1, HttpResponseStatus.OK, content);
+        decoder.seed(streamId, buffered);
+        Assertions.assertEquals(1, buffered.refCnt());
+
+        // A data frame that pushes total content past maxContentLength must
+        // raise TooLongFrameException and release the buffered message.
+        ByteBuf data = Unpooled.buffer().writeBytes(new byte[32]);
+        SpdyDataFrame dataFrame = new DefaultSpdyDataFrame(streamId, data);
+        try {
+            channel.writeInbound(dataFrame);
+            Assertions.fail("expected TooLongFrameException");
+        } catch (TooLongFrameException expected) {
+            // expected
+        }
+
+        Assertions.assertEquals(0, buffered.refCnt(),
+                "buffered message must be released when maxContentLength is exceeded");
+        Assertions.assertTrue(map.isEmpty(), "buffered message must be removed from the map");
+        channel.finishAndReleaseAll();
+    }
+}
