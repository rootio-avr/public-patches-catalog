+        assertOversizedClientHelloRejected(new SniHandler(MAPPING));
+    }
+
+    @Test
+    public void testSniHandlerWithTimeoutRejectsOversizedClientHelloByDefault() {
+        assertOversizedClientHelloRejected(new SniHandler(MAPPING, 5000L));
+    }
+
+    private static void assertOversizedClientHelloRejected(SniHandler handler) {
+        final EmbeddedChannel ch = new EmbeddedChannel(handler);
+        final ByteBuf buffer = ch.alloc().buffer();
+        buffer.writeByte(0x16);            // Content Type: Handshake
+        buffer.writeShort(0x0303);         // TLS 1.2
+        buffer.writeShort(0x0006);         // Record length
+        buffer.writeByte(0x01);            // Client Hello
+        buffer.writeMedium(0xFFFFFF);      // Handshake length (16MiB - 1), larger than default limit
+        buffer.writeShort(0x0303);
+        try {
+            assertThrows(TooLongFrameException.class, new Executable() {
+                @Override
+                public void execute() {
+                    ch.writeInbound(buffer);
+                }
+            });
+        } finally {
+            ch.finishAndReleaseAll();
+        }
+    }
+}

