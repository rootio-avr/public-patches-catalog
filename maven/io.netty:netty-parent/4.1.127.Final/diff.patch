+        assertTrue(AbstractSniHandler.DEFAULT_HANDSHAKE_TIMEOUT_MILLIS > 0);
+        assertTrue(SslClientHelloHandler.DEFAULT_MAX_CLIENT_HELLO_LENGTH
+                < SslClientHelloHandler.MAX_CLIENT_HELLO_LENGTH);
+    }
+
