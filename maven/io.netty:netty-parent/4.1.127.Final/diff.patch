+
+public class DelegatingDecompressorFrameListenerTest {
+
+    @Test
+    public void dataReadAfterDecompressorChannelClosedMustNotLeakBuffer() throws Exception {
+        final EmbeddedChannel[] created = new EmbeddedChannel[1];
+        Http2Connection connection = new DefaultHttp2Connection(true);
+        connection.local().flowController(new DefaultHttp2LocalFlowController(connection));
+        Http2FrameListener delegate = mock(Http2FrameListener.class);
+        final DelegatingDecompressorFrameListener listener = new DelegatingDecompressorFrameListener(
+                connection, delegate) {
+            @Override
+            protected EmbeddedChannel newContentDecompressor(ChannelHandlerContext ctx,
+                                                             CharSequence contentEncoding) throws Http2Exception {
+                EmbeddedChannel channel = super.newContentDecompressor(ctx, contentEncoding);
+                created[0] = channel;
+                return channel;
+            }
+        };
+        final ChannelHandlerContext ctx = mock(ChannelHandlerContext.class);
+        Channel parent = new EmbeddedChannel();
+        when(ctx.channel()).thenReturn(parent);
+
+        final int streamId = 3;
+        connection.remote().createStream(streamId, false);
+        Http2Headers headers = new DefaultHttp2Headers();
+        headers.set(HttpHeaderNames.CONTENT_ENCODING, HttpHeaderValues.GZIP);
+        listener.onHeadersRead(ctx, streamId, headers, 0, false);
+
+        // Simulate the decompressor channel being closed while the stream is still active.
+        created[0].close();
+
+        final ByteBuf data = Unpooled.buffer().writeBytes(new byte[] { 1, 2, 3, 4 });
+        try {
+            assertThrows(Http2Exception.class, new Executable() {
+                @Override
+                public void execute() throws Throwable {
+                    listener.onDataRead(ctx, streamId, data, 0, false);
+                }
+            });
+            // The caller keeps ownership of the buffer so it must not have been retained without release.
+            assertEquals(1, data.refCnt());
+        } finally {
+            while (data.refCnt() > 0) {
+                data.release();
+            }
+            parent.close();
+        }
+    }
+}

