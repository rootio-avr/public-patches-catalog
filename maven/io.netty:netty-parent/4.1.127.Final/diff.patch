+                new Match(CHUNK_EXT_VAL_QUOTED).chars("\""),
+                new Match(CHUNK_EXT_VAL_TOKEN)
+                        .range(0x21, 0x7E)
+                        .chars("(),/:<=>?@[\\]{}", false)),
+        ChunkExtValQuoted(
