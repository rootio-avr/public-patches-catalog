+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.mock;
+
+public class DelegatingDecompressorFrameListenerTest {
+
+    @Test
+    public void dataReadOnStreamWithClosedDecompressorDoesNotLeakBuffer() throws Http2Exception {
+        final Http2Connection connection = new DefaultHttp2Connection(true);
+        connection.local().flowController(new DefaultHttp2LocalFlowController(connection));
+        final AtomicReference<EmbeddedChannel> decompressorChannel = new AtomicReference<EmbeddedChannel>();
+        final Http2FrameListener delegate = mock(Http2FrameListener.class);
+        final ChannelHandlerContext ctx = mock(ChannelHandlerContext.class);
+
+        final DelegatingDecompressorFrameListener listener =
+                new DelegatingDecompressorFrameListener(connection, delegate) {
+                    @Override
+                    protected EmbeddedChannel newContentDecompressor(ChannelHandlerContext ctx,
+                                                                     CharSequence contentEncoding) {
+                        EmbeddedChannel channel = new EmbeddedChannel();
+                        decompressorChannel.set(channel);
+                        return channel;
+                    }
+                };
+
+        final int streamId = 3;
+        connection.remote().createStream(streamId, false);
+        Http2Headers headers = new DefaultHttp2Headers();
+        headers.set(HttpHeaderNames.CONTENT_ENCODING, HttpHeaderValues.GZIP);
+        listener.onHeadersRead(ctx, streamId, headers, 0, false);
+
+        EmbeddedChannel channel = decompressorChannel.get();
+        // Simulate the decompressor channel being closed while the stream is still active.
+        channel.close();
+
+        final ByteBuf data = Unpooled.buffer().writeBytes(new byte[] { 1, 2, 3, 4 });
+        try {
+            assertThrows(Http2Exception.class, new Executable() {
+                @Override
+                public void execute() throws Throwable {
+                    listener.onDataRead(ctx, streamId, data, 0, false);
+                }
+            });
+            // The buffer must not have been retained without being released again.
+            assertEquals(1, data.refCnt());
+        } finally {
+            while (data.refCnt() > 0) {
+                data.release();
+            }
+        }
+    }
+}

