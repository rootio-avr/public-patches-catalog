+/**
+ * Regression test for CVE-2026-56745: partially received messages buffered by {@link SpdyHttpDecoder}
+ * must be released when the stream is reset, replaced, too large or the handler is removed.
+ */
+public class SpdyHttpDecoderLeakTest {
+
+    private static SpdySynStreamFrame synStream(int streamId) {
+        SpdySynStreamFrame frame = new DefaultSpdySynStreamFrame(streamId, 0, (byte) 0);
+        frame.headers().set(METHOD, "POST");
+        frame.headers().set(PATH, "/");
+        frame.headers().set(VERSION, "HTTP/1.1");
+        frame.headers().set(SCHEME, "https");
+        frame.headers().set(HOST, "localhost");
+        return frame;
+    }
+
+    private static FullHttpMessage buffered(Map<Integer, FullHttpMessage> map, int streamId) {
+        FullHttpMessage message = map.get(streamId);
+        assertNotNull(message);
+        return message;
+    }
+
+    @Test
+    public void rstStreamReleasesBufferedMessage() {
+        Map<Integer, FullHttpMessage> map = new HashMap<Integer, FullHttpMessage>();
+        EmbeddedChannel ch = new EmbeddedChannel(new SpdyHttpDecoder(SpdyVersion.SPDY_3_1, 1024, map));
+        assertTrue(!ch.writeInbound(synStream(1)));
+        FullHttpMessage message = buffered(map, 1);
+        assertEquals(1, message.refCnt());
+
+        ch.writeInbound(new DefaultSpdyRstStreamFrame(1, SpdyStreamStatus.CANCEL));
+        assertEquals(0, message.refCnt());
+        assertTrue(map.isEmpty());
+        ch.finishAndReleaseAll();
+    }
+
+    @Test
+    public void duplicateSynStreamReleasesPreviousMessage() {
+        Map<Integer, FullHttpMessage> map = new HashMap<Integer, FullHttpMessage>();
+        EmbeddedChannel ch = new EmbeddedChannel(new SpdyHttpDecoder(SpdyVersion.SPDY_3_1, 1024, map));
+        ch.writeInbound(synStream(1));
+        FullHttpMessage first = buffered(map, 1);
+        // Same stream id again replaces the entry in the map.
+        ch.writeInbound(synStream(1));
+        FullHttpMessage second = buffered(map, 1);
+        assertTrue(first != second);
+        assertEquals(0, first.refCnt());
+        assertEquals(1, second.refCnt());
+        ch.finishAndReleaseAll();
+        assertEquals(0, second.refCnt());
+    }
+
+    @Test
+    public void tooLongContentReleasesBufferedMessage() {
+        Map<Integer, FullHttpMessage> map = new HashMap<Integer, FullHttpMessage>();
+        final EmbeddedChannel ch = new EmbeddedChannel(new SpdyHttpDecoder(SpdyVersion.SPDY_3_1, 8, map));
+        ch.writeInbound(synStream(1));
+        FullHttpMessage message = buffered(map, 1);
+        ch.writeInbound(new DefaultSpdyDataFrame(1, Unpooled.wrappedBuffer(new byte[8])));
+        assertThrows(TooLongFrameException.class, new Executable() {
+            @Override
+            public void execute() {
+                ch.writeInbound(new DefaultSpdyDataFrame(1, Unpooled.wrappedBuffer(new byte[8])));
+            }
+        });
+        assertEquals(0, message.refCnt());
+        assertTrue(map.isEmpty());
+        ch.finishAndReleaseAll();
+    }
+
+    @Test
+    public void handlerRemovedReleasesBufferedMessages() {
+        Map<Integer, FullHttpMessage> map = new HashMap<Integer, FullHttpMessage>();
+        EmbeddedChannel ch = new EmbeddedChannel(new SpdyHttpDecoder(SpdyVersion.SPDY_3_1, 1024, map));
+        ch.writeInbound(synStream(1));
+        FullHttpMessage message = buffered(map, 1);
+        ch.pipeline().remove(SpdyHttpDecoder.class);
+        assertEquals(0, message.refCnt());
+        assertTrue(map.isEmpty());
+        ch.finishAndReleaseAll();
+    }
+}

