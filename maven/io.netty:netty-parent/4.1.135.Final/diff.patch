+package io.netty.handler.codec.spdy;
+
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.handler.codec.http.FullHttpMessage;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import static io.netty.handler.codec.spdy.SpdyHeaders.HttpNames.HOST;
+import static io.netty.handler.codec.spdy.SpdyHeaders.HttpNames.METHOD;
+import static io.netty.handler.codec.spdy.SpdyHeaders.HttpNames.PATH;
+import static io.netty.handler.codec.spdy.SpdyHeaders.HttpNames.SCHEME;
+import static io.netty.handler.codec.spdy.SpdyHeaders.HttpNames.VERSION;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Regression test for CVE-2026-56745.
+ *
+ * The SPDY -> HTTP decoder buffered a {@link FullHttpMessage} in an internal map while waiting for the
+ * remaining data frames of a stream. When that message was removed from the map (for example because the
+ * peer sent a RST_STREAM, because a newer message replaced it, or because the handler was removed) the
+ * decoder failed to release it, leaking the underlying buffer. This test asserts that such buffered
+ * messages are released once they are no longer reachable through the decoder's internal storage.
+ */
+public class SpdyHttpDecoderReleaseTest {
+
+    private static void addRequestHeaders(SpdySynStreamFrame frame) {
+        SpdyHeaders headers = frame.headers();
+        headers.set(METHOD, "GET");
+        headers.set(PATH, "/");
+        headers.set(VERSION, "HTTP/1.1");
+        headers.set(SCHEME, "https");
+        headers.set(HOST, "example.com");
+    }
+
+    @Test
+    public void bufferedMessageReleasedOnRstStream() {
+        Map<Integer, FullHttpMessage> messageMap = new HashMap<Integer, FullHttpMessage>();
+        SpdyHttpDecoder decoder = new SpdyHttpDecoder(SpdyVersion.SPDY_3_1, 1024 * 1024, messageMap) { };
+        EmbeddedChannel channel = new EmbeddedChannel(decoder);
+
+        // A non-last client SYN_STREAM causes the decoder to buffer the request until the data frames arrive.
+        SpdySynStreamFrame synStreamFrame = new DefaultSpdySynStreamFrame(1, 0, (byte) 0);
+        synStreamFrame.setLast(false);
+        addRequestHeaders(synStreamFrame);
+        channel.writeInbound(synStreamFrame);
+
+        FullHttpMessage buffered = messageMap.get(1);
+        assertNotNull(buffered, "SYN_STREAM should be buffered in the internal map");
+        assertEquals(1, buffered.refCnt());
+
+        // A RST_STREAM removes the buffered message from the internal map; it must be released.
+        channel.writeInbound(new DefaultSpdyRstStreamFrame(1, SpdyStreamStatus.CANCEL));
+        assertTrue(messageMap.isEmpty(), "buffered message must be removed from the internal map");
+        assertEquals(0, buffered.refCnt(), "buffered message must be released once removed from storage");
+
+        channel.finishAndReleaseAll();
+    }
+
+    @Test
+    public void bufferedMessageReleasedWhenHandlerRemoved() {
+        Map<Integer, FullHttpMessage> messageMap = new HashMap<Integer, FullHttpMessage>();
+        SpdyHttpDecoder decoder = new SpdyHttpDecoder(SpdyVersion.SPDY_3_1, 1024 * 1024, messageMap) { };
+        EmbeddedChannel channel = new EmbeddedChannel(decoder);
+
+        SpdySynStreamFrame synStreamFrame = new DefaultSpdySynStreamFrame(1, 0, (byte) 0);
+        synStreamFrame.setLast(false);
+        addRequestHeaders(synStreamFrame);
+        channel.writeInbound(synStreamFrame);
+
+        FullHttpMessage buffered = messageMap.get(1);
+        assertNotNull(buffered, "SYN_STREAM should be buffered in the internal map");
+        assertEquals(1, buffered.refCnt());
+
+        // Removing the handler (e.g. by closing the pipeline) must release any outstanding buffered messages.
+        channel.pipeline().remove(decoder);
+        assertEquals(0, buffered.refCnt(), "outstanding message must be released when handler is removed");
+
+        channel.finishAndReleaseAll();
+    }
+}

