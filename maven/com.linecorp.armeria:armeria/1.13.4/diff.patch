+// Unpublished projects (it/*, examples, benchmarks, ...) still emit jars: :core:trimShadedJar
+// depends on every relocate project's shadedJar, and root assemble builds the rest.
+// The publisher scans build/libs and runs <project>:publishToMavenLocal, which these
+// projects do not define. Keep the jars for ProGuard, just outside build/libs.
+allprojects { p ->
+    afterEvaluate {
+        if (p == rootProject || p.hasFlags('publish')) {
+            return
+        }
+        tasks.withType(Jar).configureEach {
+            destinationDirectory.set(file("${buildDir}/not-published"))
+        }
+    }
