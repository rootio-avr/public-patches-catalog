+package org.apache.commons.beanutils.bugs;
+
+import java.beans.PropertyDescriptor;
+
+import org.apache.commons.beanutils.AlphaBean;
+import org.apache.commons.beanutils.BeanUtilsBean;
+import org.apache.commons.beanutils.PropertyUtilsBean;
+
+import junit.framework.TestCase;
+
+/**
+ * Fix CVE: https://nvd.nist.gov/vuln/detail/CVE-2014-0114
+ *
+ * <p>This 1.8.3 backport suppresses the "class" property natively inside
+ * {@link PropertyUtilsBean#getPropertyDescriptors(Class)} because this version
+ * predates the pluggable {@code SuppressPropertiesBeanIntrospector}
+ * architecture. The test therefore only asserts the secure-by-default
+ * behaviour (there is no opt-out API to exercise here).</p>
+ *
+ * @see <a href="https://issues.apache.org/jira/browse/BEANUTILS-520">https://issues.apache.org/jira/browse/BEANUTILS-520</a>
+ */
+public class Jira520TestCase extends TestCase {
+
+    /**
+     * By default access to the "class" property must be denied, otherwise an
+     * attacker could walk to the ClassLoader via crafted request parameters.
+     */
+    public void testSuppressClassPropertyByDefault() throws Exception {
+        final BeanUtilsBean bub = new BeanUtilsBean();
+        final AlphaBean bean = new AlphaBean();
+        try {
+            bub.getProperty(bean, "class");
+            fail("Could access class property!");
+        } catch (final NoSuchMethodException ex) {
+            // expected - the "class" property is suppressed
+        }
+    }
+
+    /**
+     * The "class" property descriptor must not be present in the descriptor
+     * array returned by {@link PropertyUtilsBean}, while normal properties are
+     * still exposed.
+     */
+    public void testClassDescriptorSuppressed() throws Exception {
+        final PropertyUtilsBean pub = new PropertyUtilsBean();
+        final AlphaBean bean = new AlphaBean();
+        final PropertyDescriptor[] descriptors = pub.getPropertyDescriptors(bean);
+        boolean hasClass = false;
+        boolean hasName = false;
+        for (int i = 0; i < descriptors.length; i++) {
+            if ("class".equals(descriptors[i].getName())) {
+                hasClass = true;
+            }
+            if ("name".equals(descriptors[i].getName())) {
+                hasName = true;
+            }
+        }
+        assertFalse("The 'class' property must be suppressed", hasClass);
+        assertTrue("Normal properties must still be exposed", hasName);
+    }
+}
