+	/**
+	 * Reads the entire stream into memory so the raw bytes can be inspected for a
+	 * DOCTYPE declaration before they are handed to the XML pull parser.
+	 */
+	private static byte[] readAllBytes(InputStream stream) throws IOException {
+		ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+		byte[] chunk = new byte[8192];
+		int read;
+		while ((read = stream.read(chunk)) != -1) {
+			buffer.write(chunk, 0, read);
+		}
+		return buffer.toByteArray();
+	}
+
+	/**
+	 * Rejects any XML document that contains a DOCTYPE declaration. DTDs are the
+	 * vehicle for XML External Entity (XXE) attacks (CVE-2024-55887, CWE-611);
+	 * the ucum-essence document does not require one, so their presence is
+	 * treated as a hard error rather than being processed.
+	 */
+	private static void rejectDoctype(byte[] data) throws XmlPullParserException {
+		String text = new String(data, StandardCharsets.UTF_8);
+		int limit = text.length();
+		int i = 0;
+		while (i < limit) {
+			int lt = text.indexOf('<', i);
+			if (lt < 0) {
+				break;
+			}
+			// Skip XML declarations (<?...?>) and comments (<!-- ... -->).
+			if (text.startsWith("<?", lt)) {
+				int end = text.indexOf("?>", lt + 2);
+				i = (end < 0) ? limit : end + 2;
+			} else if (text.startsWith("<!--", lt)) {
+				int end = text.indexOf("-->", lt + 4);
+				i = (end < 0) ? limit : end + 3;
+			} else if (lt + 1 < limit && text.charAt(lt) == '<' && text.charAt(lt + 1) == '!') {
+				int j = lt + 2;
+				while (j < limit && Character.isWhitespace(text.charAt(j))) {
+					j++;
+				}
+				if (j + 7 <= limit && text.regionMatches(true, j, "DOCTYPE", 0, 7)) {
+					throw new XmlPullParserException(
+							"DOCTYPE declarations are not permitted (XXE protection, CVE-2024-55887)");
+				}
+				// First markup declaration that is not a DOCTYPE (e.g. CDATA).
+				break;
+			} else {
+				// First real element reached before a DOCTYPE.
+				break;
+			}
+		}
+	}
