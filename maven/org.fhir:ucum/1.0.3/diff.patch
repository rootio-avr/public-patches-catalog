+package org.fhir.ucum;
+
+/*******************************************************************************
+ * Regression test for CVE-2024-55887 (CWE-611: XML External Entity injection).
+ *
+ * DefinitionParser must refuse to process any XML document that carries a
+ * DOCTYPE declaration, since DTDs are the vehicle used to reference external
+ * entities and exfiltrate local files. This mirrors the upstream v1.0.9 control
+ * (disallow-doctype-decl) adapted to the xpp3 pull-parser used at this version.
+ ******************************************************************************/
+
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+
+import org.junit.Assert;
+import org.junit.Test;
+import org.xmlpull.v1.XmlPullParserException;
+
+public class CVE202455887RegressionTest {
+
+    // An XXE payload: an external general entity declared via a DOCTYPE that
+    // would (without the fix) attempt to read a local file.
+    private static final String XXE_PAYLOAD =
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+        + "<!DOCTYPE root [ <!ENTITY xxe SYSTEM \"file:///etc/passwd\"> ]>\n"
+        + "<root version=\"1\" revision=\"1\" revision-date=\"$Date: 2020-01-01 00:00:00 +0000 $\">"
+        + "&xxe;</root>";
+
+    @Test
+    public void doctypeDeclarationIsRejected() throws Exception {
+        InputStream stream = new ByteArrayInputStream(XXE_PAYLOAD.getBytes(StandardCharsets.UTF_8));
+        try {
+            new DefinitionParser().parse(stream);
+            Assert.fail("Expected XmlPullParserException: DOCTYPE/XXE input must be rejected");
+        } catch (XmlPullParserException e) {
+            Assert.assertTrue(
+                "Rejection message should indicate DOCTYPE is not permitted, was: " + e.getMessage(),
+                e.getMessage() != null && e.getMessage().toUpperCase().contains("DOCTYPE"));
+        }
+    }
+
+    @Test
+    public void externalSystemDtdIsRejected() throws Exception {
+        String ssrfdtd =
+            "<?xml version=\"1.0\"?>\n"
+            + "<!DOCTYPE root SYSTEM \"http://127.0.0.1/evil.dtd\">\n"
+            + "<root version=\"1\" revision=\"1\" revision-date=\"$Date: 2020-01-01 00:00:00 +0000 $\"></root>";
+        InputStream stream = new ByteArrayInputStream(ssrfdtd.getBytes(StandardCharsets.UTF_8));
+        try {
+            new DefinitionParser().parse(stream);
+            Assert.fail("Expected XmlPullParserException: external SYSTEM DTD must be rejected");
+        } catch (XmlPullParserException e) {
+            Assert.assertTrue(
+                "Rejection message should indicate DOCTYPE is not permitted, was: " + e.getMessage(),
+                e.getMessage() != null && e.getMessage().toUpperCase().contains("DOCTYPE"));
+        }
+    }
+
+    @Test
+    public void benignDocumentWithoutDoctypeStillParses() throws Exception {
+        String xml =
+            "<?xml version=\"1.0\"?>\n"
+            + "<root version=\"1\" revision=\"1\" revision-date=\"$Date: 2020-01-01 00:00:00 +0000 $\"></root>";
+        InputStream stream = new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8));
+        Assert.assertNotNull(new DefinitionParser().parse(stream));
+    }
+
+    @Test
+    public void doctypeRejectionDoesNotLeakFileContents() throws Exception {
+        InputStream stream = new ByteArrayInputStream(XXE_PAYLOAD.getBytes(StandardCharsets.UTF_8));
+        try {
+            new DefinitionParser().parse(stream);
+            Assert.fail("Expected the parser to reject the DOCTYPE payload");
+        } catch (XmlPullParserException e) {
+            Assert.assertFalse(
+                "Parser must not expand external entities / leak file contents",
+                String.valueOf(e.getMessage()).contains("root:"));
+        }
+    }
+}
