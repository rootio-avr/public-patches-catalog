+package org.fhir.ucum;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+
+import org.fhir.ucum.utils.XmlUtils;
+import org.junit.jupiter.api.Test;
+import org.xml.sax.SAXParseException;
+
+/**
+ * Regression test for CVE-2024-55887 (CWE-611 XML External Entity / XXE).
+ *
+ * XmlUtils.parseDOM previously used a default DocumentBuilderFactory that
+ * allowed DOCTYPE declarations and XInclude processing, letting a malicious
+ * UCUM definitions document declare external entities and exfiltrate local
+ * files or trigger SSRF. The fix hardens the factory with
+ * disallow-doctype-decl=true and XIncludeAware(false).
+ */
+public class CVE202455887RegressionTest {
+
+  /** A payload containing a DOCTYPE with an external entity must be rejected. */
+  @Test
+  public void doctypeDeclarationIsRejected() {
+    String xxe =
+        "<?xml version=\"1.0\"?>\n"
+            + "<!DOCTYPE foo [\n"
+            + "  <!ENTITY xxe SYSTEM \"file:///etc/passwd\">\n"
+            + "]>\n"
+            + "<root>&xxe;</root>";
+    InputStream in = new ByteArrayInputStream(xxe.getBytes(StandardCharsets.UTF_8));
+    // With disallow-doctype-decl enabled, the parser throws on the DOCTYPE.
+    assertThrows(SAXParseException.class, () -> XmlUtils.parseDOM(in));
+  }
+
+  /** A benign, DOCTYPE-free document must still parse successfully. */
+  @Test
+  public void benignDocumentStillParses() throws Exception {
+    String xml = "<?xml version=\"1.0\"?><root><child>value</child></root>";
+    InputStream in = new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8));
+    assertNotNull(XmlUtils.parseDOM(in));
+  }
+}
