+package org.jsoup.helper;
+
+import org.jsoup.Jsoup;
+import org.jsoup.parser.Parser;
+import org.junit.jupiter.api.Test;
+import org.w3c.dom.Element;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+/**
+ * Regression test for CVE-2026-75140: W3CDom.W3CBuilder must not copy the whole inherited namespace map for every
+ * node (quadratic time / memory for deeply nested, uniquely namespaced XML), and namespace scoping must be preserved.
+ */
+public class W3CDomNamespaceScopeTest {
+    @Test void deeplyNestedUniqueNamespacesConvert() {
+        int depth = 3000;
+        StringBuilder xml = new StringBuilder();
+        for (int i = 0; i < depth; i++)
+            xml.append("<p").append(i).append(":e xmlns:p").append(i).append("=\"urn:").append(i).append("\">");
+        for (int i = depth - 1; i >= 0; i--)
+            xml.append("</p").append(i).append(":e>");
+
+        org.jsoup.nodes.Document jdoc = Jsoup.parse(xml.toString(), "", Parser.xmlParser());
+        org.w3c.dom.Document w3 = new W3CDom().fromJsoup(jdoc);
+
+        Element el = w3.getDocumentElement();
+        assertEquals("urn:0", el.getNamespaceURI());
+        int seen = 1;
+        while (el.getFirstChild() instanceof Element) {
+            el = (Element) el.getFirstChild();
+            assertEquals("urn:" + seen, el.getNamespaceURI());
+            seen++;
+        }
+        assertEquals(depth, seen);
+    }
+
+    @Test void namespaceScopeIsRestoredAfterElementCloses() {
+        String xml = "<root xmlns:a=\"urn:one\"><a:x xmlns:a=\"urn:two\"><a:y/></a:x><a:z/></root>";
+        org.jsoup.nodes.Document jdoc = Jsoup.parse(xml, "", Parser.xmlParser());
+        org.w3c.dom.Document w3 = new W3CDom().fromJsoup(jdoc);
+
+        Element root = w3.getDocumentElement();
+        assertNull(root.getNamespaceURI());
+        Element x = (Element) root.getFirstChild();
+        assertEquals("urn:two", x.getNamespaceURI());
+        assertEquals("urn:two", ((Element) x.getFirstChild()).getNamespaceURI());
+        Element z = (Element) x.getNextSibling();
+        assertEquals("urn:one", z.getNamespaceURI()); // outer binding restored once the inner scope closed
+    }
+
+    @Test void defaultNamespaceDoesNotLeakToSiblings() {
+        String xml = "<root><a xmlns=\"urn:d\"><b/></a><c/></root>";
+        org.jsoup.nodes.Document jdoc = Jsoup.parse(xml, "", Parser.xmlParser());
+        org.w3c.dom.Document w3 = new W3CDom().fromJsoup(jdoc);
+
+        Element root = w3.getDocumentElement();
+        Element a = (Element) root.getFirstChild();
+        assertEquals("urn:d", a.getNamespaceURI());
+        assertEquals("urn:d", ((Element) a.getFirstChild()).getNamespaceURI());
+        assertNull(((Element) a.getNextSibling()).getNamespaceURI());
+    }
+}
