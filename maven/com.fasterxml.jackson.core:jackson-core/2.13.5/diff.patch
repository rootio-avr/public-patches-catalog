+package com.fasterxml.jackson.core.json.async;
+
+import com.fasterxml.jackson.core.*;
+import com.fasterxml.jackson.core.async.AsyncTestBase;
+import com.fasterxml.jackson.core.async.ByteArrayFeeder;
+
+/**
+ * Tests that digit-only input fed across multiple chunks to the async parser
+ * (without ever terminating the number) is rejected once it grows past the
+ * maximum number length, instead of being buffered without bound.
+ */
+public class AsyncNumberLengthLimitTest extends AsyncTestBase
+{
+    private final JsonFactory JSON_F = new JsonFactory();
+
+    private final static int CHUNK_SIZE = 100;
+    private final static int MAX_CHUNKS = 200;
+
+    public void testIntegerDigitsRejected() throws Exception {
+        _testTooLong("{\"v\":", 0);
+    }
+
+    public void testNegativeIntegerDigitsRejected() throws Exception {
+        _testTooLong("{\"v\":-", 0);
+    }
+
+    public void testFractionDigitsRejected() throws Exception {
+        _testTooLong("{\"v\":0.", 0);
+    }
+
+    public void testExponentDigitsRejected() throws Exception {
+        _testTooLong("{\"v\":1e", 0);
+    }
+
+    public void testIntegerJustUnderLimit() throws Exception
+    {
+        final int digitCount = 999;
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < digitCount; i++) {
+            sb.append((char) ('1' + (i % 9)));
+        }
+        final String number = sb.toString();
+        JsonParser p = JSON_F.createNonBlockingByteArrayParser();
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] pre = utf8Bytes("{\"v\":");
+        feeder.feedInput(pre, 0, pre.length);
+        _drain(p);
+
+        byte[] digits = utf8Bytes(number);
+        for (int off = 0; off < digits.length; off += CHUNK_SIZE) {
+            int end = Math.min(digits.length, off + CHUNK_SIZE);
+            feeder.feedInput(digits, off, end);
+            assertToken(JsonToken.NOT_AVAILABLE, p.nextToken());
+        }
+        byte[] tail = utf8Bytes("}");
+        feeder.feedInput(tail, 0, tail.length);
+        feeder.endOfInput();
+        assertToken(JsonToken.VALUE_NUMBER_INT, p.nextToken());
+        assertEquals(number, p.getText());
+        assertToken(JsonToken.END_OBJECT, p.nextToken());
+        p.close();
+    }
+
+    private void _testTooLong(String preamble, int ignored) throws Exception
+    {
+        JsonParser p = JSON_F.createNonBlockingByteArrayParser();
+        ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+        byte[] pre = utf8Bytes(preamble);
+        feeder.feedInput(pre, 0, pre.length);
+        _drain(p);
+
+        byte[] digits = new byte[CHUNK_SIZE];
+        for (int i = 0; i < digits.length; i++) {
+            digits[i] = (byte) ('1' + (i % 9));
+        }
+        int chunks = 0;
+        try {
+            for (; chunks < MAX_CHUNKS; ) {
+                feeder.feedInput(digits, 0, digits.length);
+                ++chunks;
+                assertToken(JsonToken.NOT_AVAILABLE, p.nextToken());
+            }
+            fail("Should not accept " + (CHUNK_SIZE * MAX_CHUNKS) + " digits");
+        } catch (JsonParseException e) {
+            verifyException(e, "Number value length");
+            verifyException(e, "exceeds the maximum allowed");
+            assertTrue("Rejected too late: " + chunks + " chunks", chunks <= 12);
+            assertTrue("Rejected too early: " + chunks + " chunks", chunks > 1);
+        }
+        p.close();
+    }
+
+    private void _drain(JsonParser p) throws Exception {
+        JsonToken t;
+        while ((t = p.nextToken()) != JsonToken.NOT_AVAILABLE) {
+            assertNotNull(t);
+        }
+    }
+}
