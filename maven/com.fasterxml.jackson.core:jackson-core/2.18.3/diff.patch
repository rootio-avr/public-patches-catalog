+package com.fasterxml.jackson.core.json.async;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.core.JsonFactory;
+import com.fasterxml.jackson.core.JsonFactoryBuilder;
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.core.JsonToken;
+import com.fasterxml.jackson.core.StreamReadConstraints;
+import com.fasterxml.jackson.core.async.ByteArrayFeeder;
+import com.fasterxml.jackson.core.exc.StreamConstraintsException;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+/**
+ * Regression test for CVE-2026-68494: the non-blocking (async) parser must enforce
+ * {@code StreamReadConstraints.maxNumberLength} while the integer part of a number is
+ * streamed over many input chunks, not only once the number completes.
+ */
+class AsyncIntegerStreamingLengthLimitTest
+    extends com.fasterxml.jackson.core.JUnit5TestBase
+{
+    private static final int MAX_NUM_LEN = 1000;
+
+    private final JsonFactory STRICT_F = new JsonFactoryBuilder()
+            .streamReadConstraints(StreamReadConstraints.builder()
+                    .maxNumberLength(MAX_NUM_LEN)
+                    .build())
+            .build();
+
+    @Test
+    void positiveIntegerLargeChunks() throws Exception {
+        _verifyRejected("[", 4096, 2);
+    }
+
+    @Test
+    void negativeIntegerLargeChunks() throws Exception {
+        _verifyRejected("[-", 4096, 2);
+    }
+
+    @Test
+    void positiveIntegerSmallChunks() throws Exception {
+        // 100 digits per chunk: limit (1000) is exceeded by the 11th chunk
+        _verifyRejected("[", 100, 12);
+    }
+
+    @Test
+    void negativeIntegerSmallChunks() throws Exception {
+        _verifyRejected("[-", 100, 12);
+    }
+
+    @Test
+    void integerWithinLimitStillParses() throws Exception {
+        try (JsonParser p = STRICT_F.createNonBlockingByteArrayParser()) {
+            ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+            byte[] doc = utf8Bytes("[" + _digits(MAX_NUM_LEN) + "]");
+            feeder.feedInput(doc, 0, doc.length);
+            assertEquals(JsonToken.START_ARRAY, p.nextToken());
+            assertEquals(JsonToken.VALUE_NUMBER_INT, p.nextToken());
+            assertEquals(MAX_NUM_LEN, p.getText().length());
+            assertEquals(JsonToken.END_ARRAY, p.nextToken());
+        }
+    }
+
+    private void _verifyRejected(String prefix, int chunkSize, int maxChunksAllowed)
+        throws Exception
+    {
+        try (JsonParser p = STRICT_F.createNonBlockingByteArrayParser()) {
+            ByteArrayFeeder feeder = (ByteArrayFeeder) p;
+            byte[] pre = utf8Bytes(prefix);
+            feeder.feedInput(pre, 0, pre.length);
+            JsonToken t;
+            while ((t = p.nextToken()) != JsonToken.NOT_AVAILABLE) {
+                if (t == null) {
+                    fail("Unexpected end of content while draining prefix");
+                }
+            }
+
+            byte[] chunk = utf8Bytes(_digits(chunkSize));
+            int fed = 0;
+            try {
+                // Hard cap keeps a regressed build from consuming unbounded memory
+                for (int i = 0; i < 64; ++i) {
+                    feeder.feedInput(chunk, 0, chunk.length);
+                    ++fed;
+                    JsonToken tt = p.nextToken();
+                    if (tt != JsonToken.NOT_AVAILABLE) {
+                        fail("Expected NOT_AVAILABLE while streaming integer digits, got: " + tt);
+                    }
+                }
+                fail("Accepted " + (fed * chunkSize) + " integer digits with maxNumberLength="
+                        + MAX_NUM_LEN + "; expected StreamConstraintsException");
+            } catch (StreamConstraintsException e) {
+                String msg = String.valueOf(e.getMessage());
+                assertTrue(msg.contains("Number value length") && msg.contains("exceeds the maximum allowed"),
+                        "Unexpected message: " + msg);
+                assertTrue(fed <= maxChunksAllowed,
+                        "Constraint raised too late: after " + fed + " chunks of " + chunkSize + " digits");
+            }
+        }
+    }
+
+    private static String _digits(int len) {
+        StringBuilder sb = new StringBuilder(len);
+        for (int i = 0; i < len; ++i) {
+            sb.append((char) ('1' + (i % 9)));
+        }
+        return sb.toString();
+    }
+}

