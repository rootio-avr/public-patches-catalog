+package io.micrometer.core.instrument.binder.http;
+
+import io.micrometer.core.instrument.Tag;
+import org.junit.jupiter.api.Test;
+
+import javax.servlet.http.HttpServletRequest;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Regression test for CVE-2026-40984: {@link HttpRequestTags#method} must only
+ * emit the raw HTTP method as a tag value when it is a standard (RFC 9110 /
+ * RFC 5789) method, otherwise it must fall back to {@code UNKNOWN} to avoid an
+ * unbounded-cardinality tag from arbitrary attacker-supplied request methods.
+ */
+class Cve202640984RegressionTest {
+
+    private static HttpServletRequest mockRequest(String method) {
+        HttpServletRequest request = mock(HttpServletRequest.class);
+        when(request.getMethod()).thenReturn(method);
+        return request;
+    }
+
+    @Test
+    void nullRequestShouldContributeUnknownMethodTag() {
+        Tag unknownMethod = Tag.of("method", "UNKNOWN");
+        HttpServletRequest request = null;
+        assertThat(HttpRequestTags.method(request)).isEqualTo(unknownMethod);
+    }
+
+    @Test
+    void nonStandardMethodShouldContributeUnknownMethodTagValue() {
+        Tag unknownMethod = Tag.of("method", "UNKNOWN");
+        assertThat(HttpRequestTags.method(mockRequest("WELL"))).isEqualTo(unknownMethod);
+    }
+
+    @Test
+    void standardMethodShouldContributeMethodTag() {
+        assertThat(HttpRequestTags.method(mockRequest("GET"))).isEqualTo(Tag.of("method", "GET"));
+        assertThat(HttpRequestTags.method(mockRequest("PATCH"))).isEqualTo(Tag.of("method", "PATCH"));
+    }
+}
