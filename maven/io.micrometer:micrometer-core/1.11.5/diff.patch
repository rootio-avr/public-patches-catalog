+package io.micrometer.core.instrument.binder.http;
+
+import io.micrometer.core.instrument.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Regression test for CVE-2026-40984 (GHSA-g3pr-3p32-fp23).
+ *
+ * <p>
+ * HTTP server instrumentation used the raw HTTP method value as a metric tag without
+ * validation, allowing arbitrary/unknown method values to inflate metric cardinality and
+ * cause uncontrolled resource consumption (DoS). The fix maps any non-standard method to
+ * a fixed {@code UNKNOWN} tag value.
+ *
+ * <p>
+ * Backported replacement for the upstream {@code HttpJakartaServletRequestTagsTest} added
+ * in commit 36da131; on this line the Jakarta support is an overload of
+ * {@link HttpRequestTags} rather than a separate class, so both the {@code javax} and
+ * {@code jakarta} overloads are exercised here.
+ */
+class Cve202640984RegressionTest {
+
+    private static final Tag METHOD_UNKNOWN = Tag.of("method", "UNKNOWN");
+
+    @Test
+    void nullRequestShouldContributeUnknownMethodTag() {
+        javax.servlet.http.HttpServletRequest javaxRequest = null;
+        assertThat(HttpRequestTags.method(javaxRequest)).isEqualTo(METHOD_UNKNOWN);
+
+        jakarta.servlet.http.HttpServletRequest jakartaRequest = null;
+        assertThat(HttpRequestTags.method(jakartaRequest)).isEqualTo(METHOD_UNKNOWN);
+    }
+
+    @Test
+    void unknownMethodShouldContributeUnknownMethodTagValue() {
+        javax.servlet.http.HttpServletRequest javaxRequest = mock(javax.servlet.http.HttpServletRequest.class);
+        when(javaxRequest.getMethod()).thenReturn("WELL");
+        assertThat(HttpRequestTags.method(javaxRequest)).isEqualTo(METHOD_UNKNOWN);
+
+        jakarta.servlet.http.HttpServletRequest jakartaRequest = mock(jakarta.servlet.http.HttpServletRequest.class);
+        when(jakartaRequest.getMethod()).thenReturn("WELL");
+        assertThat(HttpRequestTags.method(jakartaRequest)).isEqualTo(METHOD_UNKNOWN);
+    }
+
+    @Test
+    void knownMethodShouldContributeMethodTag() {
+        Tag httpGet = Tag.of("method", "GET");
+
+        javax.servlet.http.HttpServletRequest javaxRequest = mock(javax.servlet.http.HttpServletRequest.class);
+        when(javaxRequest.getMethod()).thenReturn("GET");
+        assertThat(HttpRequestTags.method(javaxRequest)).isEqualTo(httpGet);
+
+        jakarta.servlet.http.HttpServletRequest jakartaRequest = mock(jakarta.servlet.http.HttpServletRequest.class);
+        when(jakartaRequest.getMethod()).thenReturn("GET");
+        assertThat(HttpRequestTags.method(jakartaRequest)).isEqualTo(httpGet);
+    }
+
+}
