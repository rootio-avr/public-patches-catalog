+package io.micrometer.core.instrument.binder.http;
+
+import io.micrometer.core.instrument.Tag;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Regression test for CVE-2026-40984: the {@code method} tag produced by
+ * {@link HttpRequestTags} must not reflect an arbitrary, attacker-controlled HTTP
+ * method verbatim, otherwise the {@code method} tag has unbounded cardinality. Only
+ * standard HTTP methods should be echoed; anything else collapses to {@code UNKNOWN}.
+ */
+class HttpRequestTagsRegressionTest {
+
+    @Test
+    void nullJavaxRequestShouldContributeUnknownMethodTag() {
+        javax.servlet.http.HttpServletRequest request = null;
+        assertThat(HttpRequestTags.method(request)).isEqualTo(Tag.of("method", "UNKNOWN"));
+    }
+
+    @Test
+    void unknownJavaxMethodShouldContributeUnknownMethodTagValue() {
+        javax.servlet.http.HttpServletRequest request = mock(javax.servlet.http.HttpServletRequest.class);
+        when(request.getMethod()).thenReturn("WELL");
+        assertThat(HttpRequestTags.method(request)).isEqualTo(Tag.of("method", "UNKNOWN"));
+    }
+
+    @Test
+    void knownJavaxMethodShouldContributeMethodTag() {
+        javax.servlet.http.HttpServletRequest request = mock(javax.servlet.http.HttpServletRequest.class);
+        when(request.getMethod()).thenReturn("GET");
+        assertThat(HttpRequestTags.method(request)).isEqualTo(Tag.of("method", "GET"));
+    }
+
+    @Test
+    void nullJakartaRequestShouldContributeUnknownMethodTag() {
+        jakarta.servlet.http.HttpServletRequest request = null;
+        assertThat(HttpRequestTags.method(request)).isEqualTo(Tag.of("method", "UNKNOWN"));
+    }
+
+    @Test
+    void unknownJakartaMethodShouldContributeUnknownMethodTagValue() {
+        jakarta.servlet.http.HttpServletRequest request = mock(jakarta.servlet.http.HttpServletRequest.class);
+        when(request.getMethod()).thenReturn("WELL");
+        assertThat(HttpRequestTags.method(request)).isEqualTo(Tag.of("method", "UNKNOWN"));
+    }
+
+    @Test
+    void knownJakartaMethodShouldContributeMethodTag() {
+        jakarta.servlet.http.HttpServletRequest request = mock(jakarta.servlet.http.HttpServletRequest.class);
+        when(request.getMethod()).thenReturn("GET");
+        assertThat(HttpRequestTags.method(request)).isEqualTo(Tag.of("method", "GET"));
+    }
+
+}
