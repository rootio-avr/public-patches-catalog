+    /**
+     * Originally FreeMarker relied on {@link Locale#toString()}, but that's actually fragile, so we recreate it as it
+     * was in older Java, but we leave out extensions (not needed for lookup), and also add the initial infix
+     * separator. This also prevents path traversal (CVE-2026-84939), as characters that could be used to break out of
+     * the intended template path (like {@code '/'}, {@code '\\'}, {@code '%'}, and control characters) terminate the
+     * locale part.
+     */
+    private static String toLocaleInfix(Locale locale) {
+        boolean hasLang = locale.getLanguage().length() != 0;
+        boolean hasCountry = locale.getCountry().length() != 0;
+        boolean hasVariant = locale.getVariant().length() != 0;
+        boolean hasScript = locale.getScript().length() != 0;
+
+        StringBuilder suffix = new StringBuilder();
+
+        appendPartToLocaleInfix(suffix, locale.getLanguage(), 0);
+
+        if (hasCountry || (hasLang && (hasVariant || hasScript))) {
+            appendPartToLocaleInfix(suffix, locale.getCountry(), 1);
+        }
+        if (hasVariant && (hasLang || hasCountry)) {
+            appendPartToLocaleInfix(suffix, locale.getVariant(), 2);
+        }
+
+        if (hasScript && (hasLang || hasCountry)) {
+            appendPartToLocaleInfix(suffix, locale.getScript(), 3);
+        }
+
+        return suffix.toString();
+    }
+
+    private static void appendPartToLocaleInfix(StringBuilder suffix, String part, int partIndex) {
+        suffix.append(LOCALE_INFIX_SEPARATOR);
+        if (partIndex == 3) { // 3 => script
+            suffix.append('#');
+        }
+        for (int i = 0; i < part.length(); i++) {
+            char c = part.charAt(i);
+            if (localePartCloser(c)) {
+                break;
+            }
+            suffix.append(c);
+        }
+    }
+
+    private static boolean localePartCloser(char c) {
+        return c < 0x20 || c == '%' || c == '/' || c == '\\';
+    }
