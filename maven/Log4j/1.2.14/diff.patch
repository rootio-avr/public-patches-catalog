Backport of reload4j commit f221f2427c45134cf5768f46279ddf72fe1407c9
"fix JMSSink CVE-2022-23302" onto Apache log4j 1.2.14.

CVE-2022-23302: JMSSink performs unrestricted JNDI lookups on names taken
from configuration/attacker-controlled input, allowing a remote attacker
to trigger deserialization of untrusted data via a malicious JNDI provider
(CWE-502 RCE). The upstream fix routes both lookups through the new
org.apache.log4j.net.JNDIUtil helper which enforces that the JNDI name is
in the "java:" namespace. Since JNDIUtil does not exist in 1.2.14, this
backport inlines the equivalent "java:" namespace restriction directly into
JMSSink's existing lookup() helper and routes the previously-unguarded
topic lookup through that helper as well, hardening both lookup call sites.

--- a/src/java/org/apache/log4j/net/JMSSink.java
+++ b/src/java/org/apache/log4j/net/JMSSink.java
@@ -108,7 +108,7 @@
       TopicSession topicSession = topicConnection.createTopicSession(false,
                                                        Session.AUTO_ACKNOWLEDGE);
 
-      Topic topic = (Topic)ctx.lookup(topicBindingName);
+      Topic topic = (Topic)lookup(ctx, topicBindingName);
 
       TopicSubscriber topicSubscriber = topicSession.createSubscriber(topic);
     
@@ -141,6 +141,13 @@
 
 
   protected static Object lookup(Context ctx, String name) throws NamingException {
+    // CVE-2022-23302: restrict JNDI lookups to the "java:" namespace to
+    // prevent lookups against attacker-controlled remote JNDI providers,
+    // which could otherwise lead to deserialization of untrusted data / RCE.
+    if (name != null && !name.startsWith("java:")) {
+      logger.error("JNDI name must start with \"java:\" but was [" + name + "].");
+      throw new NamingException("JNDI name must start with java: but was " + name);
+    }
     try {
       return ctx.lookup(name);
     } catch(NameNotFoundException e) {
