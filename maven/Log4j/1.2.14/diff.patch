+package org.apache.log4j.net;
+
+import java.util.Hashtable;
+
+import javax.naming.Context;
+import javax.naming.Name;
+import javax.naming.NameParser;
+import javax.naming.NamingEnumeration;
+import javax.naming.NamingException;
+
+import junit.framework.TestCase;
+
+/**
+ * Regression test for CVE-2022-23302.
+ *
+ * JMSSink.lookup(Context, String) must refuse to resolve any JNDI name that is
+ * not in the local "java:" namespace, so that an attacker who can influence the
+ * TopicConnectionFactory / Topic binding names cannot force a lookup against a
+ * remote/malicious JNDI provider (which could lead to deserialization of
+ * untrusted data and remote code execution).
+ *
+ * The upstream reload4j fix (commit f221f2427c45) delegates to
+ * JNDIUtil.lookupObject(); this 1.2.14 backport inlines the equivalent
+ * "java:" namespace restriction directly into JMSSink.lookup(). This test
+ * exercises that restriction directly (same package grants access to the
+ * protected static helper).
+ *
+ * @author patch-platoon-ai
+ */
+public class JMSSinkJndiRestrictionTest extends TestCase {
+
+  public JMSSinkJndiRestrictionTest(String name) {
+    super(name);
+  }
+
+  /** An absolute LDAP URL (the classic JNDI-injection payload) must be rejected. */
+  public void testRejectsRemoteLdapName() {
+    assertRejected("ldap://evil.example.com/exploit");
+  }
+
+  /** An rmi URL must be rejected. */
+  public void testRejectsRemoteRmiName() {
+    assertRejected("rmi://evil.example.com/exploit");
+  }
+
+  /** A plain (non java:) name must be rejected. */
+  public void testRejectsPlainName() {
+    assertRejected("someTopicConnectionFactory");
+  }
+
+  /**
+   * A name in the "java:" namespace passes the security check and is handed to
+   * the Context; we assert the guard let it through by observing that the
+   * Context actually received the lookup call.
+   */
+  public void testAllowsJavaNamespaceName() throws Exception {
+    RecordingContext ctx = new RecordingContext();
+    Object result = JMSSink.lookup(ctx, "java:comp/env/jms/TopicCF");
+    assertEquals("java:comp/env/jms/TopicCF", ctx.lastLookedUp);
+    assertEquals("sentinel", result);
+  }
+
+  private void assertRejected(String name) {
+    RecordingContext ctx = new RecordingContext();
+    try {
+      JMSSink.lookup(ctx, name);
+      fail("Expected NamingException for restricted JNDI name: " + name);
+    } catch (NamingException expected) {
+      // good - the restriction fired
+    }
+    assertNull("Context.lookup must not be reached for restricted name: " + name,
+               ctx.lastLookedUp);
+  }
+
+  /**
+   * Minimal javax.naming.Context that records the String name passed to
+   * lookup(String) and returns a sentinel; every other operation is
+   * unsupported because the test never exercises it.
+   */
+  private static final class RecordingContext implements Context {
+    String lastLookedUp;
+
+    public Object lookup(String name) throws NamingException {
+      this.lastLookedUp = name;
+      return "sentinel";
+    }
+
+    public Object lookup(Name name) { throw new UnsupportedOperationException(); }
+    public void bind(Name name, Object obj) { throw new UnsupportedOperationException(); }
+    public void bind(String name, Object obj) { throw new UnsupportedOperationException(); }
+    public void rebind(Name name, Object obj) { throw new UnsupportedOperationException(); }
+    public void rebind(String name, Object obj) { throw new UnsupportedOperationException(); }
+    public void unbind(Name name) { throw new UnsupportedOperationException(); }
+    public void unbind(String name) { throw new UnsupportedOperationException(); }
+    public void rename(Name oldName, Name newName) { throw new UnsupportedOperationException(); }
+    public void rename(String oldName, String newName) { throw new UnsupportedOperationException(); }
+    public NamingEnumeration list(Name name) { throw new UnsupportedOperationException(); }
+    public NamingEnumeration list(String name) { throw new UnsupportedOperationException(); }
+    public NamingEnumeration listBindings(Name name) { throw new UnsupportedOperationException(); }
+    public NamingEnumeration listBindings(String name) { throw new UnsupportedOperationException(); }
+    public void destroySubcontext(Name name) { throw new UnsupportedOperationException(); }
+    public void destroySubcontext(String name) { throw new UnsupportedOperationException(); }
+    public Context createSubcontext(Name name) { throw new UnsupportedOperationException(); }
+    public Context createSubcontext(String name) { throw new UnsupportedOperationException(); }
+    public Object lookupLink(Name name) { throw new UnsupportedOperationException(); }
+    public Object lookupLink(String name) { throw new UnsupportedOperationException(); }
+    public NameParser getNameParser(Name name) { throw new UnsupportedOperationException(); }
+    public NameParser getNameParser(String name) { throw new UnsupportedOperationException(); }
+    public Name composeName(Name name, Name prefix) { throw new UnsupportedOperationException(); }
+    public String composeName(String name, String prefix) { throw new UnsupportedOperationException(); }
+    public Object addToEnvironment(String propName, Object propVal) { throw new UnsupportedOperationException(); }
+    public Object removeFromEnvironment(String propName) { throw new UnsupportedOperationException(); }
+    public Hashtable getEnvironment() { throw new UnsupportedOperationException(); }
+    public void close() { throw new UnsupportedOperationException(); }
+    public String getNameInNamespace() { throw new UnsupportedOperationException(); }
+  }
+}
