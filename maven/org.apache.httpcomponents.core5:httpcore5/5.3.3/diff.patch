+package org.apache.hc.core5.http.config;
+
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+public class TestHttp1Config {
+
+    @Test
+    void testDefaultLimits() {
+        final Http1Config config = Http1Config.DEFAULT;
+        Assertions.assertEquals(8192, config.getMaxLineLength());
+        Assertions.assertEquals(100, config.getMaxHeaderCount());
+    }
+
+    @Test
+    void testBuilderDefaultLimits() {
+        final Http1Config config = Http1Config.custom().build();
+        Assertions.assertEquals(8192, config.getMaxLineLength());
+        Assertions.assertEquals(100, config.getMaxHeaderCount());
+    }
+
+    @Test
+    void testLimitsCanBeOverridden() {
+        final Http1Config config = Http1Config.custom()
+                .setMaxLineLength(-1)
+                .setMaxHeaderCount(-1)
+                .build();
+        Assertions.assertEquals(-1, config.getMaxLineLength());
+        Assertions.assertEquals(-1, config.getMaxHeaderCount());
+    }
+
+}
