+package org.apache.hc.core5.http.config;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Regression test for CVE-2026-54399: incoming HTTP/1 messages must be parsed
+ * with bounded defaults (max line length 8192, max header count 100) rather
+ * than the previously unlimited (-1) defaults, so a malicious peer cannot
+ * exhaust memory with oversized request lines or unbounded header counts.
+ */
+public class CVE202654399RegressionTest {
+
+    @Test
+    public void testDefaultMaxLineLengthIsBounded() {
+        Assert.assertEquals(8192, Http1Config.DEFAULT.getMaxLineLength());
+    }
+
+    @Test
+    public void testDefaultMaxHeaderCountIsBounded() {
+        Assert.assertEquals(100, Http1Config.DEFAULT.getMaxHeaderCount());
+    }
+
+    @Test
+    public void testExplicitLimitsStillHonored() {
+        final Http1Config config = Http1Config.custom()
+                .setMaxLineLength(4096)
+                .setMaxHeaderCount(50)
+                .build();
+        Assert.assertEquals(4096, config.getMaxLineLength());
+        Assert.assertEquals(50, config.getMaxHeaderCount());
+    }
+}
