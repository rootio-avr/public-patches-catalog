+package wstxtest.fuzz;
+
+import java.io.ByteArrayInputStream;
+
+import javax.xml.stream.XMLStreamException;
+import javax.xml.stream.XMLStreamReader;
+
+import com.ctc.wstx.stax.WstxInputFactory;
+
+import wstxtest.stream.BaseStreamTest;
+
+/**
+ * Regression test for CVE-2022-40153: deeply nested content-spec groups in a
+ * DTD element declaration caused unbounded recursion in
+ * {@code FullDTDReader.readContentSpec(...)}, leading to a StackOverflowError
+ * (Denial of Service). The fix caps recursion at 500 and instead raises an
+ * {@link XMLStreamException}.
+ *
+ * This replaces the upstream {@code Fuzz_DTDReadTest}, whose binary
+ * clusterfuzz resource is not shipped in this target tree; it exercises the
+ * same fixed behavior with an in-code deeply-nested DTD.
+ */
+public class Cve202240153RegressionTest
+    extends BaseStreamTest
+{
+    private final WstxInputFactory STAX_F = getWstxInputFactory();
+
+    // Deeper than the 500 recursion limit enforced by the fix.
+    private final static int NESTING = 700;
+
+    private static byte[] deeplyNestedDtdDoc()
+    {
+        StringBuilder sb = new StringBuilder();
+        sb.append("<!DOCTYPE root [<!ELEMENT root ");
+        for (int i = 0; i < NESTING; ++i) {
+            sb.append('(');
+        }
+        sb.append("#PCDATA");
+        for (int i = 0; i < NESTING; ++i) {
+            sb.append(')');
+        }
+        sb.append(">]><root/>");
+        return sb.toString().getBytes();
+    }
+
+    public void testDeepDtdRecursionIsBounded() throws Exception
+    {
+        byte[] doc = deeplyNestedDtdDoc();
+        XMLStreamReader sr = STAX_F.createXMLStreamReader(new ByteArrayInputStream(doc));
+        try {
+            streamThrough(sr);
+            fail("Expected recursion-depth-limit failure for deeply nested DTD content spec");
+        } catch (StackOverflowError soe) {
+            fail("Deeply nested DTD triggered StackOverflowError (CVE-2022-40153 not fixed)");
+        } catch (RuntimeException e) {
+            // Woodstox wraps the XMLStreamException lazily (WstxLazyException etc.)
+            verifyException(e, "recursion depth limit");
+        } catch (XMLStreamException e) {
+            verifyException(e, "recursion depth limit");
+        } finally {
+            sr.close();
+        }
+    }
+}
