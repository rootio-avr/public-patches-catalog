@@ -0,0 +1,59 @@
+package org.codehaus.groovy.runtime;
+
+import junit.framework.TestCase;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+
+/**
+ * Regression test for CVE-2016-6814: MethodClosure must not be
+ * deserializable unless explicitly allowed.
+ */
+public class MethodClosureDeserializationTest extends TestCase {
+
+    private byte[] serialize(Object o) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        ObjectOutputStream oos = new ObjectOutputStream(bos);
+        oos.writeObject(o);
+        oos.close();
+        return bos.toByteArray();
+    }
+
+    private Object deserialize(byte[] data) throws Exception {
+        ObjectInputStream ois = new ObjectInputStream(new ByteArrayInputStream(data));
+        try {
+            return ois.readObject();
+        } finally {
+            ois.close();
+        }
+    }
+
+    public void testDeserializationIsRejectedByDefault() throws Exception {
+        byte[] data = serialize(new MethodClosure("hello", "length"));
+        boolean old = MethodClosure.ALLOW_RESOLVE;
+        MethodClosure.ALLOW_RESOLVE = false;
+        try {
+            deserialize(data);
+            fail("Deserializing a MethodClosure should be rejected");
+        } catch (UnsupportedOperationException expected) {
+            // expected
+        } finally {
+            MethodClosure.ALLOW_RESOLVE = old;
+        }
+    }
+
+    public void testDeserializationAllowedWhenEnabled() throws Exception {
+        byte[] data = serialize(new MethodClosure("hello", "length"));
+        boolean old = MethodClosure.ALLOW_RESOLVE;
+        MethodClosure.ALLOW_RESOLVE = true;
+        try {
+            Object o = deserialize(data);
+            assertTrue(o instanceof MethodClosure);
+            assertEquals("length", ((MethodClosure) o).getMethod());
+        } finally {
+            MethodClosure.ALLOW_RESOLVE = old;
+        }
+    }
+}
