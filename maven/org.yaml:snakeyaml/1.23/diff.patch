+package org.yaml.snakeyaml.constructor;
+
+import java.util.List;
+
+import org.yaml.snakeyaml.nodes.Tag;
+
+/**
+ * Allow to create classes with custom global tag if the class name matches
+ * any of the provided prefixes.
+ */
+public class TrustedPrefixesTagInspector implements TagInspector {
+
+    private final List<String> trustedList;
+
+    /**
+     * Create
+     *
+     * @param trustedList - list of prefixes to allow. It may be the package names
+     */
+    public TrustedPrefixesTagInspector(List<String> trustedList) {
+        this.trustedList = trustedList;
+    }
+
+    @Override
+    public boolean allowGlobalTag(Tag tag) {
+        for (String trusted : trustedList) {
+            if (tag.getClassName().startsWith(trusted)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
