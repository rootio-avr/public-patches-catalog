+package org.yaml.snakeyaml.constructor;
+
+import org.yaml.snakeyaml.nodes.Tag;
+
+/**
+ * Check if the global tags are allowed (the local tags are always allowed).
+ * It should control the classes to create to prevent possible remote code
+ * invocation when the data comes from untrusted source.
+ */
+public interface TagInspector {
+
+    /**
+     * Check whether the global tag is allowed.
+     *
+     * @param tag - the global tag to allow
+     * @return true when the custom global tag is allowed to create a custom Java instance
+     */
+    boolean allowGlobalTag(Tag tag);
+}
