+
+    // ------------------------------------------------------------------
+    // Coverage for two containment escapes: a symlink inside the root pointing
+    // outside it, and a base path configured without a trailing separator.
+    // ------------------------------------------------------------------
+
+    /**
+     * Symlink escape: a symlink INSIDE
+     * the servable root that points OUTSIDE it must not let the resolved
+     * target escape containment. Path.normalize()/string checks would miss
+     * this; File.getCanonicalPath() must follow the symlink for checkContained
+     * to catch it.
+     */
+    @Test
+    public void symlinkInsideDocrootPointingOutside_isNotServed() throws Exception {
+        Path link = new File(docroot, "escape").toPath();
+        Files.createSymbolicLink(link, secretDir.toPath());
+
+        web.htmlfileBase = docroot.getCanonicalPath() + "/";
+        byte[] response = reply(web, "GET /escape/secret.txt HTTP/1.0");
+        assertFalse("VULNERABLE (CWE-36): a symlink inside the servable root "
+                    + "pointing outside it was followed and the secret sentinel "
+                    + "was returned; checkContained() must canonicalize (which "
+                    + "follows symlinks), not merely normalize.",
+                    containsSecret(response));
+        assertNull("EXPECTED REJECTION (CWE-36): a symlink escaping the "
+                   + "servable root must be refused with BadHttpRequest.",
+                   response);
+    }
+
+    /**
+     * Base path missing a trailing separator: when htmlfileBase is configured WITHOUT a trailing
+     * separator, plain string concatenation (htmlfileBase + filename) can
+     * literally resolve into a sibling directory whose name extends the
+     * base's name (e.g. base "/tmp/probebase" + filename "Evil/secret.txt"
+     * = "/tmp/probebaseEvil/secret.txt"). The containment check must compare
+     * canonical paths with a File.separator suffix, not a bare
+     * String.startsWith(htmlfileBase).
+     */
+    @Test
+    public void siblingDirectoryViaMissingTrailingSeparator_isNotServed() throws Exception {
+        File base = File.createTempFile("cgbase", "dir");
+        base.delete();
+        base.mkdirs();
+        File sibling = new File(base.getCanonicalPath() + "Evil");
+        sibling.mkdirs();
+        File siblingSecret = new File(sibling, "secret.txt");
+        try (OutputStream os = new FileOutputStream(siblingSecret)) {
+            os.write((SECRET + "\n").getBytes("UTF-8"));
+        }
+
+        try {
+            // Deliberately NOT trailing with a separator, per the bypass.
+            web.htmlfileBase = base.getCanonicalPath();
+            byte[] response = reply(web, "GET /Evil/secret.txt HTTP/1.0");
+            assertFalse("VULNERABLE (CWE-36): a sibling directory whose name "
+                        + "extends htmlfileBase's own name (missing trailing "
+                        + "separator) was reachable via string concatenation; "
+                        + "the secret sentinel was returned.",
+                        containsSecret(response));
+            assertNull("EXPECTED REJECTION (CWE-36): a sibling-directory escape "
+                       + "caused by a htmlfileBase without a trailing separator "
+                       + "must be refused with BadHttpRequest.", response);
+        } finally {
+            siblingSecret.delete();
+            sibling.delete();
+            base.delete();
+        }
+    }
+}
