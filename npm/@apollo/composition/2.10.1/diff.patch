+import gql from 'graphql-tag';
+import { composeAsFed2Subgraphs, errors } from './testHelper';
+
+// Regression test for CVE-2025-64530 (CWE-288): federation composition failed to
+// propagate/verify access-control requirements (@authenticated, @requiresScopes,
+// @policy) transitively through @requires field sets. A field that pulls in
+// auth-protected data via @requires without itself carrying the equivalent
+// requirements allowed the access control to be bypassed at query time.
+//
+// After the fix, composition emits a MISSING_TRANSITIVE_AUTH_REQUIREMENTS error
+// when a @requires selection reaches auth-protected data that the requiring field
+// does not itself require.
+describe('CVE-2025-64530: transitive access control verification for @requires', () => {
+  it('rejects @requires that reaches @requiresScopes-protected data without the same requirement', () => {
+    const subgraphA = {
+      name: 'subgraphA',
+      typeDefs: gql`
+        type Query {
+          t: T
+        }
+
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @requiresScopes(scopes: [["secret"]])
+        }
+      `,
+    };
+
+    const subgraphB = {
+      name: 'subgraphB',
+      typeDefs: gql`
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @external
+          # `derived` pulls in the auth-protected `protected` field via @requires
+          # but does not itself declare the @requiresScopes requirement, which is
+          # exactly the access-control bypass CVE-2025-64530 addresses.
+          derived: Int! @requires(fields: "protected")
+        }
+      `,
+    };
+
+    const result = composeAsFed2Subgraphs([subgraphA, subgraphB]);
+    const codes = errors(result).map(([code]) => code);
+    expect(codes).toContain('MISSING_TRANSITIVE_AUTH_REQUIREMENTS');
+  });
+
+  it('accepts @requires when the requiring field carries the same auth requirement', () => {
+    const subgraphA = {
+      name: 'subgraphA',
+      typeDefs: gql`
+        type Query {
+          t: T
+        }
+
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @requiresScopes(scopes: [["secret"]])
+        }
+      `,
+    };
+
+    const subgraphB = {
+      name: 'subgraphB',
+      typeDefs: gql`
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @external
+          derived: Int!
+            @requiresScopes(scopes: [["secret"]])
+            @requires(fields: "protected")
+        }
+      `,
+    };
+
+    const result = composeAsFed2Subgraphs([subgraphA, subgraphB]);
+    const codes = errors(result).map(([code]) => code);
+    expect(codes).not.toContain('MISSING_TRANSITIVE_AUTH_REQUIREMENTS');
+  });
+});
