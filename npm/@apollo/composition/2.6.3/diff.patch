+import gql from 'graphql-tag';
+import './matchers';
+import {
+  assertCompositionSuccess,
+  errors,
+  composeAsFed2Subgraphs,
+} from "./testHelper";
+
+/**
+ * Regression tests for GHSA-m8jr-fxqx-8xx6.
+ *
+ * A field annotated with `@requires` pulls in ("requires") data from other fields before it can be
+ * resolved. If that depended-on data is protected by an access control directive (`@authenticated`,
+ * `@requiresScopes`, `@policy`) but the requesting field does not itself carry at least equivalent
+ * access control requirements, then querying the `@requires` field would expose the protected data
+ * while bypassing its access control. Composition must reject such supergraphs with a
+ * `MISSING_TRANSITIVE_AUTH_REQUIREMENTS` error.
+ */
+describe('@requires access control enforcement (GHSA-m8jr-fxqx-8xx6)', () => {
+  it('errors when a @requires field pulls in @authenticated data without matching auth', () => {
+    const subgraphA = {
+      name: 'subgraphA',
+      typeDefs: gql`
+        type Query {
+          t: T
+        }
+
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @authenticated
+        }
+      `,
+    };
+
+    const subgraphB = {
+      name: 'subgraphB',
+      typeDefs: gql`
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @external
+          # BUG: this field can read the @authenticated "protected" field without requiring auth.
+          leaked: Int! @requires(fields: "protected")
+        }
+      `,
+    };
+
+    const result = composeAsFed2Subgraphs([subgraphA, subgraphB]);
+    expect(result.errors).toBeDefined();
+    expect(errors(result).map(([code]) => code)).toContain('MISSING_TRANSITIVE_AUTH_REQUIREMENTS');
+  });
+
+  it('composes cleanly when the @requires field carries matching @authenticated', () => {
+    const subgraphA = {
+      name: 'subgraphA',
+      typeDefs: gql`
+        type Query {
+          t: T
+        }
+
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @authenticated
+        }
+      `,
+    };
+
+    const subgraphB = {
+      name: 'subgraphB',
+      typeDefs: gql`
+        type T @key(fields: "id") {
+          id: ID!
+          protected: Int! @external
+          # This field now carries matching auth, so accessing the protected data is allowed.
+          derived: Int! @requires(fields: "protected") @authenticated
+        }
+      `,
+    };
+
+    const result = composeAsFed2Subgraphs([subgraphA, subgraphB]);
+    assertCompositionSuccess(result);
+  });
+
+  it('composes cleanly when the required data is not access controlled', () => {
+    const subgraphA = {
+      name: 'subgraphA',
+      typeDefs: gql`
+        type Query {
+          t: T
+        }
+
+        type T @key(fields: "id") {
+          id: ID!
+          plain: Int!
+        }
+      `,
+    };
+
+    const subgraphB = {
+      name: 'subgraphB',
+      typeDefs: gql`
+        type T @key(fields: "id") {
+          id: ID!
+          plain: Int! @external
+          derived: Int! @requires(fields: "plain")
+        }
+      `,
+    };
+
+    const result = composeAsFed2Subgraphs([subgraphA, subgraphB]);
+    assertCompositionSuccess(result);
+  });
+});
