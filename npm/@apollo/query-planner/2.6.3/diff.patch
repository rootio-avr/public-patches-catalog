+// Regression test for CVE-2026-32621 (@apollo/query-planner)
+// Prototype pollution via deepMerge / condition variable lookup.
+// The fix routes property writes through defineOwn/getOwn so that a
+// malicious "__proto__" (or other inherited) key can never mutate
+// Object.prototype. This test exercises the compiled output shipped in dist.
+const assert = require('node:assert');
+const { deepMerge } = require('../dist/utilities/deepMerge');
+const { getOwn, defineOwn } = require('../dist/utilities/own');
+
+// 1. deepMerge must not pollute Object.prototype through a "__proto__" key.
+{
+  const target = {};
+  // JSON.parse produces an *own* enumerable "__proto__" property, which is
+  // the classic prototype-pollution vector.
+  const malicious = JSON.parse('{"__proto__": {"polluted": true}}');
+  deepMerge(target, malicious);
+  assert.strictEqual(({}).polluted, undefined, 'Object.prototype must not be polluted');
+  assert.strictEqual(Object.prototype.polluted, undefined, 'Object.prototype.polluted must be undefined');
+}
+
+// 2. Nested pollution attempt must also be neutralized.
+{
+  const target = {};
+  const malicious = JSON.parse('{"a": {"__proto__": {"pwned": 1}}}');
+  deepMerge(target, malicious);
+  assert.strictEqual(({}).pwned, undefined, 'nested __proto__ must not pollute Object.prototype');
+}
+
+// 3. Legitimate deep merges still work.
+{
+  const merged = deepMerge({ a: { x: 1 } }, { a: { y: 2 }, b: 3 });
+  assert.deepStrictEqual(merged, { a: { x: 1, y: 2 }, b: 3 }, 'normal merge behavior preserved');
+}
+
+// 4. getOwn only returns own properties, never inherited ones.
+{
+  assert.strictEqual(getOwn({ foo: 5 }, 'foo'), 5, 'getOwn returns own property value');
+  assert.strictEqual(getOwn({}, 'toString'), undefined, 'getOwn does not return inherited properties');
+}
+
+// 5. defineOwn shadows an inherited property with an own undefined value.
+{
+  const obj = {};
+  defineOwn(obj, 'toString');
+  assert.ok(Object.prototype.hasOwnProperty.call(obj, 'toString'), 'defineOwn defines own property');
+  assert.strictEqual(obj.toString, undefined, 'shadowed inherited property is undefined');
+}
+
+console.log('CVE-2026-32621 regression test passed');

