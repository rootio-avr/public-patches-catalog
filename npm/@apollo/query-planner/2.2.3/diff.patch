@@ -0,0 +1,74 @@
+import { QueryPlanner, QueryPlannerConfig } from '@apollo/query-planner';
+import { composeServices } from '@apollo/composition';
+import { asFed2SubgraphDocument, assert, buildSchema, operationFromDocument, Schema, ServiceDefinition } from '@apollo/federation-internals';
+import gql from 'graphql-tag';
+import { MAX_COMPUTED_PLANS } from '../buildPlan';
+
+// Regression test for CVE-2024-43414 / GHSA-fmj9-77q8-g6c4.
+//
+// The query planner counts the number of possible query plans (`possiblePlans()`)
+// to decide when to prune candidates so it never evaluates more than
+// `MAX_COMPUTED_PLANS`. Before the fix this count was a JS `number`, so once the
+// combinatorial explosion pushed it past `Number.MAX_VALUE` (~2^1024) it silently
+// saturated to `Infinity`. `Infinity - Infinity/prevSize` stays `Infinity`, so the
+// pruning `while` loop could never bring the count back below the limit, disabling
+// the guard and leaving the planner to attempt an unbounded cartesian product
+// (uncontrolled recursion / DoS, CWE-674).
+//
+// The fix switches the counter to `BigInt`, which never saturates, so the pruning
+// loop always terminates and the planner stays bounded by `MAX_COMPUTED_PLANS`.
+//
+// This reproduces the advisory scenario: several subgraphs all exposing the same
+// `@shareable` field, and a query that aliases that field enough times that the
+// naive plan count blows past `Number.MAX_VALUE`.
+
+function composeAndCreatePlanner(services: ServiceDefinition[], config: QueryPlannerConfig = {}): [Schema, QueryPlanner] {
+  const compositionResults = composeServices(
+    services.map((s) => ({ ...s, typeDefs: asFed2SubgraphDocument(s.typeDefs) }))
+  );
+  expect(compositionResults.errors).toBeUndefined();
+  return [
+    compositionResults.schema!.toAPISchema(),
+    new QueryPlanner(buildSchema(compositionResults.supergraphSdl!), config),
+  ];
+}
+
+test('CVE-2024-43414: aliasing a @shareable field does not overflow the plan counter or disable plan pruning', () => {
+  // Five identical subgraphs that all expose the same shareable field. Each alias
+  // of that field is independently resolvable from any of the 5 subgraphs, so the
+  // number of possible plans is 5^(number of aliases).
+  const subgraphDefs = gql`
+    type Query {
+      field: Int @shareable
+    }
+  `;
+
+  const services: ServiceDefinition[] = [1, 2, 3, 4, 5].map((i) => ({
+    name: `S${i}`,
+    typeDefs: subgraphDefs,
+  }));
+
+  const [api, queryPlanner] = composeAndCreatePlanner(services);
+
+  // 5^450 is far larger than Number.MAX_VALUE (~2^1024 ~= 5^441), so the pre-fix
+  // `number` counter would saturate to Infinity here and never prune.
+  const aliasCount = 450;
+  const aliases = [...Array(aliasCount).keys()].map((i) => `a${i}: field`);
+  const operation = operationFromDocument(api, gql`
+    {
+      ${aliases.join('\n')}
+    }
+  `);
+
+  // With the BigInt fix this returns promptly; with the bug the pruning guard is
+  // disabled and the planner attempts an astronomically large cartesian product.
+  const plan = queryPlanner.buildQueryPlan(operation);
+  assert(plan.node, 'Expected the plan to have a main node');
+
+  // The key regression assertion: pruning stayed active, so the number of
+  // evaluated plans is finite and bounded by MAX_COMPUTED_PLANS.
+  const stats = queryPlanner.lastGeneratedPlanStatistics();
+  assert(stats, 'Expected planning statistics to be collected');
+  expect(Number.isFinite(stats.evaluatedPlanCount)).toBe(true);
+  expect(stats.evaluatedPlanCount).toBeLessThanOrEqual(MAX_COMPUTED_PLANS);
+});
