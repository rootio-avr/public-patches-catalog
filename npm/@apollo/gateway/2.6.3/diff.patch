+import {
+  DocumentNode,
+  FragmentDefinitionNode,
+  SelectionSetNode,
+} from 'graphql';
+
+// Maximum number of selections that may be produced by recursively expanding
+// the named fragments of an operation. Operations exceeding this bound are
+// rejected before query planning, since fragment expansion of such documents
+// can consume an unbounded amount of CPU and memory (CWE-770).
+export const MAX_RECURSIVE_SELECTIONS = 10_000_000;
+
+/**
+ * Measures the number of selections that would be encountered if we walked the
+ * given selection set while recursing into fragment spreads. Returns `null` if
+ * this number exceeds `MAX_RECURSIVE_SELECTIONS`.
+ *
+ * Fragments referenced by spreads are looked up in `fragments`. If a fragment
+ * spread appears multiple times for the same named fragment, it is counted
+ * multiple times (which is what makes deeply reused fragments so expensive to
+ * expand). Per-fragment subtotals are memoized in `fragmentCache` so that each
+ * named fragment is only walked once.
+ */
+function countRecursiveSelections(
+  fragments: Map<string, FragmentDefinitionNode>,
+  fragmentCache: Map<string, number>,
+  selectionSet: SelectionSetNode,
+  count: number,
+): number | null {
+  for (const selection of selectionSet.selections) {
+    // Add 1 for the current selection and check bounds.
+    count++;
+    if (count > MAX_RECURSIVE_SELECTIONS) {
+      return null;
+    }
+
+    switch (selection.kind) {
+      case 'Field': {
+        if (selection.selectionSet) {
+          const result = countRecursiveSelections(
+            fragments,
+            fragmentCache,
+            selection.selectionSet,
+            count,
+          );
+          if (result === null) return null;
+          count = result;
+        }
+        break;
+      }
+      case 'InlineFragment': {
+        const result = countRecursiveSelections(
+          fragments,
+          fragmentCache,
+          selection.selectionSet,
+          count,
+        );
+        if (result === null) return null;
+        count = result;
+        break;
+      }
+      case 'FragmentSpread': {
+        const name = selection.name.value;
+        const cached = fragmentCache.get(name);
+
+        if (cached !== undefined) {
+          count = count + cached;
+          if (count > MAX_RECURSIVE_SELECTIONS) {
+            return null;
+          }
+        } else {
+          const fragment = fragments.get(name);
+          // If the spread references an unknown fragment the document is
+          // invalid; leave that error to be surfaced by validation/planning
+          // and simply don't recurse here.
+          if (fragment) {
+            const oldCount = count;
+            const result = countRecursiveSelections(
+              fragments,
+              fragmentCache,
+              fragment.selectionSet,
+              count,
+            );
+            if (result === null) return null;
+            count = result;
+            fragmentCache.set(name, count - oldCount);
+          }
+        }
+        break;
+      }
+    }
+  }
+
+  return count;
+}
+
+/**
+ * Validates that expanding the named fragments of the given operation document
+ * would not produce more than `MAX_RECURSIVE_SELECTIONS` selections, throwing
+ * before any (potentially exponential) fragment expansion is attempted.
+ *
+ * This is done up front, before query planning, so that a malicious client
+ * cannot exhaust gateway resources with a small document that expands into an
+ * astronomically large operation (CWE-770 / CVE-2025-32031).
+ */
+export function validateRecursiveSelections(document: DocumentNode): void {
+  const fragments = new Map<string, FragmentDefinitionNode>();
+  for (const definition of document.definitions) {
+    if (definition.kind === 'FragmentDefinition') {
+      fragments.set(definition.name.value, definition);
+    }
+  }
+
+  const fragmentCache = new Map<string, number>();
+  for (const definition of document.definitions) {
+    if (definition.kind === 'OperationDefinition') {
+      const result = countRecursiveSelections(
+        fragments,
+        fragmentCache,
+        definition.selectionSet,
+        0,
+      );
+      if (result === null) {
+        throw new Error(
+          'Exceeded maximum recursive selections in this operation',
+        );
+      }
+    }
+  }
+}
