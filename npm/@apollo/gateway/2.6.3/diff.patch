+'use strict';
+
+// Regression test for CVE-2026-32621 (@apollo/gateway prototype pollution).
+//
+// The upstream fix (federation #3396) prevents response/variable processing
+// from reading or writing through an object's prototype chain, by routing all
+// dynamic property access through the new own.ts helpers (hasOwn/getOwn/
+// defineOwn) and by hardening deepMerge(). The published npm artifact strips
+// the project's jest specs, so this is a minimal, self-contained port of the
+// upstream "prototype manipulation prevention" tests that exercises those
+// exact primitives after they are compiled to dist/.
+//
+// Runnable with plain `node test/cve-2026-32621.test.js`.
+
+const assert = require('node:assert');
+
+const { hasOwn, getOwn, defineOwn } = require('../dist/utilities/own');
+const { deepMerge } = require('../dist/utilities/deepMerge');
+
+function run(name, fn) {
+  fn();
+  console.log('ok - ' + name);
+}
+
+run('hasOwn is false for inherited prototype-chain properties', () => {
+  const obj = {};
+  // `__proto__`/`toString` live on Object.prototype, not on `obj` itself.
+  assert.strictEqual(hasOwn(obj, '__proto__'), false);
+  assert.strictEqual(hasOwn(obj, 'toString'), false);
+
+  obj.real = 1;
+  assert.strictEqual(hasOwn(obj, 'real'), true);
+});
+
+run('getOwn returns undefined for non-own (prototype) props, value for own', () => {
+  const obj = { real: 'value' };
+  // Reading via the prototype chain must not leak inherited members.
+  assert.strictEqual(getOwn(obj, 'toString'), undefined);
+  assert.strictEqual(getOwn(obj, '__proto__'), undefined);
+  assert.strictEqual(getOwn(obj, 'real'), 'value');
+});
+
+run('defineOwn shadows an inherited property as an own, undefined property', () => {
+  const proto = { inherited: 'from-proto' };
+  const obj = Object.create(proto);
+  assert.strictEqual(hasOwn(obj, 'inherited'), false);
+  assert.strictEqual('inherited' in obj, true);
+
+  defineOwn(obj, 'inherited');
+  // The property is now an own property masking the prototype value...
+  assert.strictEqual(hasOwn(obj, 'inherited'), true);
+  assert.strictEqual(obj.inherited, undefined);
+  // ...without mutating the shared prototype.
+  assert.strictEqual(proto.inherited, 'from-proto');
+});
+
+run('deepMerge does not pollute Object.prototype via a "__proto__" key', () => {
+  const target = {};
+  const malicious = JSON.parse('{"__proto__": {"polluted": true}}');
+  deepMerge(target, malicious);
+
+  assert.strictEqual({}.polluted, undefined);
+  assert.strictEqual(Object.prototype.polluted, undefined);
+});
+
+run('deepMerge sets values as own properties on the target', () => {
+  const proto = { key: 'from-proto' };
+  const target = Object.create(proto);
+  deepMerge(target, { key: 'merged' });
+
+  assert.strictEqual(hasOwn(target, 'key'), true);
+  assert.strictEqual(target.key, 'merged');
+  assert.strictEqual(proto.key, 'from-proto');
+});
+
+console.log('CVE-2026-32621 regression test passed');

