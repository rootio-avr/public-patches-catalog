+import { parse } from 'graphql';
+import {
+  validateRecursiveSelections,
+  MAX_RECURSIVE_SELECTIONS,
+} from '../recursiveSelectionsLimit';
+
+/**
+ * Regression test for CVE-2025-32031 (GHSA-p2q6-pwh5-m6jr / GHSA-q2f9-x4p4-7xmh).
+ *
+ * The gateway performed no bound on the number of selections produced by
+ * recursively expanding named fragments during query planning. A tiny document
+ * whose fragments each spread the previous fragment several times expands
+ * exponentially, exhausting CPU/memory and rendering the gateway inoperable
+ * (CWE-770: uncontrolled resource consumption).
+ *
+ * `validateRecursiveSelections` counts the selections that recursive fragment
+ * expansion would produce *before* expanding them, and throws once the count
+ * exceeds MAX_RECURSIVE_SELECTIONS instead of attempting the expansion.
+ */
+describe('CVE-2025-32031: recursive selections limit', () => {
+  // Build a query whose named fragments each spread the previous fragment
+  // multiple times. Because spreads are counted with multiplicity when
+  // recursing, the effective selection count grows exponentially with the
+  // number of fragments, blowing past the limit with a tiny document.
+  function buildExponentialFragmentQuery(levels: number): string {
+    let doc = '';
+    // f0 is a small leaf fragment.
+    doc += `fragment f0 on T { id }\n`;
+    for (let i = 1; i <= levels; i++) {
+      // Each fragment spreads the previous one four times -> 4^i growth.
+      doc +=
+        `fragment f${i} on T { ` +
+        `a { ...f${i - 1} } ` +
+        `b { ...f${i - 1} } ` +
+        `c { ...f${i - 1} } ` +
+        `d { ...f${i - 1} } ` +
+        `}\n`;
+    }
+    doc += `query { t { ...f${levels} } }\n`;
+    return doc;
+  }
+
+  it('rejects queries whose recursive fragment expansion exceeds the limit', () => {
+    // 4^15 ~= 1.07e9 selections, far above the 10M limit, but the document
+    // itself is tiny (a handful of fragments).
+    const document = parse(buildExponentialFragmentQuery(15));
+
+    expect(() => validateRecursiveSelections(document)).toThrow(
+      /recursive selections/i,
+    );
+  });
+
+  it('accepts a normal, bounded query', () => {
+    const document = parse(`
+      query {
+        t {
+          id
+          a {
+            id
+          }
+        }
+      }
+    `);
+
+    expect(() => validateRecursiveSelections(document)).not.toThrow();
+  });
+
+  it('accepts a bounded query that reuses a small named fragment', () => {
+    const document = parse(`
+      query {
+        t {
+          ...f
+          a {
+            ...f
+          }
+        }
+      }
+      fragment f on T {
+        id
+      }
+    `);
+
+    expect(() => validateRecursiveSelections(document)).not.toThrow();
+  });
+
+  it('exposes a finite, positive selection budget', () => {
+    expect(MAX_RECURSIVE_SELECTIONS).toBeGreaterThan(0);
+    expect(Number.isFinite(MAX_RECURSIVE_SELECTIONS)).toBe(true);
+  });
+});
