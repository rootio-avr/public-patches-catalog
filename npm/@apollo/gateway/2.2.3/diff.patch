@@ -0,0 +1,110 @@
+import { buildSchema, parseOperation } from '@apollo/federation-internals';
+import {
+  MAX_RECURSIVE_SELECTIONS,
+  validateRecursiveSelections,
+} from '../recursiveSelectionsLimit';
+
+/**
+ * Regression test for CVE-2025-32031 (GHSA-q2f9-x4p4-7xmh /
+ * GHSA-p2q6-pwh5-m6jr).
+ *
+ * The upstream fix commit (302aa3a4) shipped no test, and the upstream
+ * mitigation lives in `@apollo/query-planner`. Since the published
+ * `@apollo/gateway@2.2.3` tarball only contains the gateway package (and
+ * depends on an unmodified `@apollo/query-planner@2.2.3`), the guard is
+ * backported into the gateway package itself and invoked before
+ * `queryPlanner.buildQueryPlan(operation)`. This is an authored replacement
+ * regression test that exercises that guard directly.
+ *
+ * The attack pattern is a query that reuses a chain of named fragments, each
+ * one spreading the previous fragment several times. Because fragment spreads
+ * are expanded recursively during query planning, the number of effective
+ * selections grows exponentially with the depth of the chain even though the
+ * query document itself is tiny. Without the guard, planning such a query
+ * exhausts CPU/memory and renders the gateway inoperable.
+ */
+describe('CVE-2025-32031: recursive selections limit', () => {
+  const schema = buildSchema(`#graphql
+    type Query {
+      t: T
+    }
+
+    type T {
+      id: ID!
+      a: T
+      b: T
+      c: T
+      d: T
+      e: T
+      f: T
+      g: T
+      h: T
+      i: T
+      j: T
+    }
+  `);
+
+  // Builds an operation string whose named fragments each spread the previous
+  // fragment many times, so the fully expanded selection count blows past
+  // MAX_RECURSIVE_SELECTIONS while the document itself stays small.
+  function buildExponentialFragmentQuery(
+    depth: number,
+    fanout: number,
+  ): string {
+    const fields = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j'];
+    const lines: string[] = [];
+
+    // frag0 is a plain leaf selection.
+    lines.push('fragment frag0 on T { id }');
+
+    for (let level = 1; level <= depth; level++) {
+      const body: string[] = [];
+      for (let n = 0; n < fanout; n++) {
+        const field = fields[n % fields.length];
+        body.push(`${field} { ...frag${level - 1} }`);
+      }
+      lines.push(`fragment frag${level} on T { ${body.join(' ')} }`);
+    }
+
+    return `
+      query {
+        t { ...frag${depth} }
+      }
+      ${lines.join('\n')}
+    `;
+  }
+
+  it('exposes the documented limit', () => {
+    expect(MAX_RECURSIVE_SELECTIONS).toBe(10_000_000);
+  });
+
+  it('rejects queries that expand to too many recursive selections', () => {
+    // depth 9 with fanout 10 => ~10^9 expanded selections, far over the limit.
+    const operation = parseOperation(
+      schema,
+      buildExponentialFragmentQuery(9, 10),
+    );
+
+    expect(() => validateRecursiveSelections(operation)).toThrow(
+      /Exceeded maximum recursive selections/,
+    );
+  });
+
+  it('allows a normal (small) query', () => {
+    const operation = parseOperation(
+      schema,
+      `#graphql
+        query {
+          t {
+            id
+            a {
+              id
+            }
+          }
+        }
+      `,
+    );
+
+    expect(() => validateRecursiveSelections(operation)).not.toThrow();
+  });
+});

CVE-2024-43414: bump federation deps so @apollo/query-planner uses BigInt in possiblePlans().

@apollo/gateway itself contains no query planning code: the vulnerable
`possiblePlans()` routine (query-planner-js/src/buildPlan.ts) lives in the
separate @apollo/query-planner package, which gateway declares as a runtime
dependency. The published @apollo/gateway@2.2.3 tarball ships only its own
src/ + dist/ (config, executeQueryPlan, datasources, ...) plus a package.json
that pulls @apollo/query-planner (and the lockstep @apollo/composition /
@apollo/federation-internals) via a "^2.2.3" range that resolves to a still
vulnerable release. Before 2.8.5, possiblePlans() accumulated the candidate
plan count in a JS Number; a sufficiently wide query pushes that count past
Number.MAX_VALUE to Infinity, which defeats the MAX_COMPUTED_PLANS pruning
guard (Infinity - Infinity/prevSize === Infinity) and lets the planner attempt
an unbounded cartesian product (CWE-674 / CWE-673, uncontrolled recursion /
DoS).

The fix that actually removes the vulnerable code path is @apollo/query-planner
>= 2.8.5, which switches the counter to BigInt so it can never saturate. The
three federation packages are released and versioned in lockstep, so all three
are pinned to 2.8.5 (matching the built-green @apollo/gateway 2.6.3 sibling
patch). Gateway 2.2.3 does not call the federation-internals API that changed
between 2.2.3 and 2.8.5 (Operation.schema stays unused in its dist/), so no
source adaptation is required here beyond the dependency bump.

