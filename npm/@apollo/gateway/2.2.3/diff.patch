+import { createRequire } from 'module';
+import { readFileSync } from 'fs';
+import { dirname, join } from 'path';
+
+// Regression test for CVE-2024-43414 / GHSA-fmj9-77q8-g6c4 (CWE-674 / CWE-673).
+//
+// The vulnerable code is NOT in @apollo/gateway. Gateway delegates all query
+// planning to its @apollo/query-planner dependency, whose `possiblePlans()`
+// (query-planner-js/src/buildPlan.ts) counted the number of candidate query
+// plans in a JS `Number`. A sufficiently wide query pushes that count past
+// `Number.MAX_VALUE`, collapsing it to `Infinity`. Once the counter is
+// `Infinity`, the pruning loop (`planCount -= planCount / prevSize`) can never
+// bring it back below `MAX_COMPUTED_PLANS`, so the guard is defeated and the
+// planner attempts an effectively unbounded cartesian product (uncontrolled
+// recursion / OOM / hang).
+//
+// The fix (@apollo/query-planner >= 2.8.5) switches that counter to `BigInt`,
+// which cannot saturate, so pruning always terminates and stays bounded by
+// `MAX_COMPUTED_PLANS`.
+//
+// For @apollo/gateway the fix is therefore a dependency bump: the package must
+// resolve @apollo/query-planner (and its lockstep siblings) to a version whose
+// shipped buildPlan implementation uses BigInt. This test guards against the
+// most likely backport mistake for that route: the dependency range silently
+// resolving back to a pre-fix (Number-based) query-planner, or the bump being
+// dropped/reverted during a rebase.
+
+const require = createRequire(__filename);
+
+function parseVersion(v: string): [number, number, number] {
+  const cleaned = v.replace(/^[^0-9]*/, '');
+  const [maj, min, patch] = cleaned.split('.').map((x) => parseInt(x, 10));
+  return [maj || 0, min || 0, patch || 0];
+}
+
+function gte(a: string, b: string): boolean {
+  const av = parseVersion(a);
+  const bv = parseVersion(b);
+  for (let i = 0; i < 3; i++) {
+    if (av[i] > bv[i]) return true;
+    if (av[i] < bv[i]) return false;
+  }
+  return true;
+}
+
+describe('CVE-2024-43414: @apollo/query-planner dependency carries the BigInt plan-count fix', () => {
+  test('declared @apollo/query-planner dependency is pinned to a fixed (>= 2.8.5) release', () => {
+    // Read this package's own manifest (the file patched by the CVE fix).
+    const pkg = require('../../package.json');
+    const declared: string | undefined =
+      pkg.dependencies && pkg.dependencies['@apollo/query-planner'];
+    expect(declared).toBeDefined();
+
+    // A caret range like "^2.2.3" resolves to a vulnerable release; the fix
+    // pins the fixed line. Assert the floor of the declared spec is >= 2.8.5.
+    expect(gte(declared as string, '2.8.5')).toBe(true);
+  });
+
+  test('resolved @apollo/query-planner ships a BigInt-based possiblePlans()', () => {
+    // Locate the resolved query-planner package and read its compiled buildPlan.
+    const qpEntry = require.resolve('@apollo/query-planner');
+    // dist/index.js -> dist/buildPlan.js
+    const distDir = dirname(qpEntry);
+    const buildPlanPath = join(distDir, 'buildPlan.js');
+    const source = readFileSync(buildPlanPath, 'utf8');
+
+    // The fix converts the plan counter to BigInt; pre-fix code has none.
+    expect(source.includes('BigInt')).toBe(true);
+
+    // Guard against a half-applied fix that leaves the pre-fix Number literal
+    // initialiser for the combination counter in place.
+    expect(/totalCombinations\s*=\s*1\b/.test(source)).toBe(false);
+  });
+
+  test('resolved @apollo/query-planner package version is >= 2.8.5', () => {
+    const qpPkgPath = require.resolve('@apollo/query-planner/package.json');
+    const qpPkg = JSON.parse(readFileSync(qpPkgPath, 'utf8'));
+    expect(gte(qpPkg.version, '2.8.5')).toBe(true);
+  });
+});
