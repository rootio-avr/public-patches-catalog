@@ -0,0 +1,84 @@
+import {
+  assertUnreachable,
+  Operation,
+  SelectionSet,
+} from '@apollo/federation-internals';
+
+export const MAX_RECURSIVE_SELECTIONS = 10_000_000;
+
+/**
+ * Measures the number of selections that would be encountered if we walked the
+ * given selection set while recursing into fragment spreads. Returns `null` if
+ * this number exceeds `MAX_RECURSIVE_SELECTIONS`.
+ *
+ * Assumes that fragments referenced by spreads exist and don't form cycles. If
+ * a fragment spread appears multiple times for the same named fragment, it is
+ * counted multiple times.
+ *
+ * NOTE (backport of the CVE-2025-32031 fix, upstream commit 302aa3a4): the
+ * upstream mitigation lives in `@apollo/query-planner`, but the published
+ * `@apollo/gateway@2.2.3` tarball only contains the gateway package and depends
+ * on an unmodified `@apollo/query-planner@2.2.3`. To keep the fix self-contained
+ * within the gateway package, this guard is implemented here and invoked before
+ * `queryPlanner.buildQueryPlan(operation)` in `ApolloGateway`. It walks the
+ * operation's selection set exactly as the query planner would when expanding
+ * named fragments recursively, so it bounds the amount of work query planning
+ * can be made to perform. The running `count` is hard-bounded by
+ * `MAX_RECURSIVE_SELECTIONS`, so the total work performed by this walk is itself
+ * bounded, which is what protects the query planner from the resource-exhaustion
+ * attack (GHSA-q2f9-x4p4-7xmh / GHSA-p2q6-pwh5-m6jr).
+ *
+ * A fragment spread's sub-selection is reached through the common
+ * `FragmentSelection.selectionSet` accessor, which for a spread transparently
+ * resolves to the referenced named fragment's selection set.
+ */
+function countRecursiveSelections(
+  selectionSet: SelectionSet,
+  count: number,
+): number | null {
+  for (const selection of selectionSet.selections()) {
+    // Add 1 for the current selection and check bounds.
+    count++;
+    if (count > MAX_RECURSIVE_SELECTIONS) {
+      return null;
+    }
+
+    switch (selection.kind) {
+      case 'FieldSelection': {
+        if (selection.selectionSet) {
+          const result = countRecursiveSelections(
+            selection.selectionSet,
+            count,
+          );
+          if (result === null) return null;
+          count = result;
+        }
+        break;
+      }
+      case 'FragmentSelection': {
+        // Recurse into the fragment's selection set. For a fragment spread this
+        // resolves (via the `selectionSet` accessor) to the referenced named
+        // fragment's selections, so spreads are expanded and counted just like
+        // inline fragments.
+        const result = countRecursiveSelections(
+          selection.selectionSet,
+          count,
+        );
+        if (result === null) return null;
+        count = result;
+        break;
+      }
+      default:
+        assertUnreachable(selection);
+    }
+  }
+
+  return count;
+}
+
+export function validateRecursiveSelections(operation: Operation) {
+  const result = countRecursiveSelections(operation.selectionSet, 0);
+  if (result === null) {
+    throw new Error('Exceeded maximum recursive selections in this operation');
+  }
+}
