+import { deepMerge } from '../deepMerge';
+import { hasOwn, getOwn, defineOwn } from '../own';
+
+// Regression test for CVE-2026-32621 / GHSA-pfjj-6f4p-rvmh.
+//
+// Response objects returned from subgraphs are attacker-influenced. Prior to
+// the fix, several code paths accessed those objects with bare `obj[key]`
+// property access, which walks the prototype chain. This allowed a malicious
+// subgraph response (or crafted variables) to read from / write through
+// `Object.prototype` (prototype pollution). The fix routes those accesses
+// through the own-property helpers (`hasOwn`/`getOwn`/`defineOwn`) and makes
+// `deepMerge` define own properties on the merge target rather than assigning
+// through inherited ones.
+//
+// The upstream PR (#3396) validated this end-to-end via
+// executeQueryPlan.test.ts and resultShaping.test.ts, whose additions depend
+// on APIs not present in this (older) version. This replacement test exercises
+// the same fixed behavior at the unit level against the ported helpers.
+describe('CVE-2026-32621: prototype pollution prevention', () => {
+  afterEach(() => {
+    // Ensure nothing leaked onto the global prototype between assertions.
+    delete (Object.prototype as any).polluted;
+  });
+
+  describe('own helpers', () => {
+    it('hasOwn only reports own properties, not inherited ones', () => {
+      const obj: any = { a: 1 };
+      expect(hasOwn(obj, 'a')).toBe(true);
+      // `toString`/`constructor` are inherited from Object.prototype.
+      expect(hasOwn(obj, 'toString')).toBe(false);
+      expect(hasOwn(obj, 'constructor')).toBe(false);
+    });
+
+    it('getOwn returns undefined for inherited properties', () => {
+      const obj: any = { a: 1 };
+      expect(getOwn(obj, 'a' as any)).toBe(1);
+      // Would return `[Function: toString]` with bare property access.
+      expect(getOwn(obj, 'toString' as any)).toBeUndefined();
+    });
+
+    it('defineOwn shadows an inherited property with an own undefined slot', () => {
+      (Object.prototype as any).polluted = 'from-prototype';
+      const obj: any = {};
+      // Before defineOwn, the value is inherited from the prototype.
+      expect(obj.polluted).toBe('from-prototype');
+      expect(hasOwn(obj, 'polluted')).toBe(false);
+
+      defineOwn(obj, 'polluted');
+
+      // After defineOwn, the object has its own (undefined) property that
+      // masks the inherited one, so subsequent assignment cannot reach through
+      // to the prototype.
+      expect(hasOwn(obj, 'polluted')).toBe(true);
+      expect(obj.polluted).toBeUndefined();
+    });
+  });
+
+  describe('deepMerge', () => {
+    it('does not pollute Object.prototype via a "__proto__" key', () => {
+      // Simulate a subgraph response parsed such that `__proto__` is an own,
+      // enumerable key (as JSON.parse produces).
+      const malicious: any = JSON.parse('{"__proto__": {"polluted": "yes"}}');
+      const target: any = {};
+
+      deepMerge(target, malicious);
+
+      // Global prototype must remain untouched.
+      expect(({} as any).polluted).toBeUndefined();
+      expect((Object.prototype as any).polluted).toBeUndefined();
+    });
+
+    it('merges "constructor"/"prototype" keys as own properties without walking the chain', () => {
+      const malicious: any = JSON.parse(
+        '{"constructor": {"prototype": {"polluted": "yes"}}}',
+      );
+      const target: any = {};
+
+      deepMerge(target, malicious);
+
+      expect(({} as any).polluted).toBeUndefined();
+      // The value ends up as an own property on the target, not on a prototype.
+      expect(hasOwn(target, 'constructor')).toBe(true);
+    });
+
+    it('still merges normal (non-inherited) keys correctly', () => {
+      const target = { a: 1, b: 2 };
+      const source = { b: 3, c: 4 };
+      expect(deepMerge(target, source)).toEqual({ a: 1, b: 3, c: 4 });
+    });
+  });
+});

