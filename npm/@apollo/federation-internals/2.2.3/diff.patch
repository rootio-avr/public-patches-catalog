+import { getOwn } from '../utils';
+
+/**
+ * Regression test for CVE-2026-32621 (GHSA-pfjj-6f4p-rvmh, CWE-1321).
+ *
+ * The federation value-handling code reads schema field/argument names out of
+ * client-provided input objects. Doing so with a plain `obj[name]` index access
+ * walks the prototype chain, so a field named like an inherited member
+ * (`__proto__`, `constructor`, `hasOwnProperty`, `toString`, ...) would read a
+ * value off `Object.prototype` rather than the object itself. `getOwn` restricts
+ * lookups to own (non-inherited) properties, matching the upstream fix intent of
+ * "prevent accessing the response object's prototype chain".
+ */
+describe('CVE-2026-32621: getOwn prevents prototype-chain access', () => {
+  it('returns own property values normally', () => {
+    const obj = { a: 1, b: 'two', c: null };
+    expect(getOwn(obj, 'a')).toBe(1);
+    expect(getOwn(obj, 'b')).toBe('two');
+    expect(getOwn(obj, 'c')).toBeNull();
+  });
+
+  it('returns undefined for missing own properties instead of inherited members', () => {
+    const obj: { [key: string]: any } = { a: 1 };
+    // These are all present on Object.prototype; a naive obj[name] access would
+    // return the inherited function/value rather than undefined.
+    expect(getOwn(obj, 'toString')).toBeUndefined();
+    expect(getOwn(obj, 'hasOwnProperty')).toBeUndefined();
+    expect(getOwn(obj, 'constructor')).toBeUndefined();
+    expect(getOwn(obj, 'valueOf')).toBeUndefined();
+    // Sanity: the inherited members are indeed reachable via a plain index access.
+    expect(typeof (obj as any).toString).toBe('function');
+  });
+
+  it('does not read a polluted prototype', () => {
+    // Simulate prototype pollution: a poisoned Object.prototype must not leak
+    // through getOwn for objects that do not own the property.
+    const polluted = Object.prototype as any;
+    const marker = '__cve_2026_32621_marker__';
+    try {
+      polluted[marker] = 'polluted';
+      const obj: { [key: string]: any } = { a: 1 };
+      // Plain index access would surface the polluted value...
+      expect((obj as any)[marker]).toBe('polluted');
+      // ...but getOwn must not.
+      expect(getOwn(obj, marker)).toBeUndefined();
+    } finally {
+      delete polluted[marker];
+    }
+  });
+
+  it('reads __proto__ only when it is a real own property', () => {
+    // A null-prototype object carrying an own "__proto__" data property: getOwn
+    // must return that own value, and must never fall back to the prototype.
+    const obj: { [key: string]: any } = Object.create(null);
+    obj['__proto__'] = 'ownValue';
+    expect(getOwn(obj, '__proto__')).toBe('ownValue');
+
+    const plain: { [key: string]: any } = { a: 1 };
+    // On a plain object, "__proto__" is an inherited accessor, not an own
+    // property, so getOwn must return undefined.
+    expect(getOwn(plain, '__proto__')).toBeUndefined();
+  });
+});
