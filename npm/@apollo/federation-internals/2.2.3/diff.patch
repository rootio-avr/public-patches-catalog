+/**
+ * Returns the value of an *own* property `prop` of `obj`, or `undefined` if
+ * `obj` does not have `prop` as an own (non-inherited) property.
+ *
+ * This must be used, rather than a plain `obj[prop]` index access, whenever
+ * `obj` is (or may be derived from) untrusted, client-provided data (e.g. the
+ * fields of a GraphQL input object, or a map keyed by user-controlled names).
+ * A plain index access walks the prototype chain, so a field named like an
+ * inherited member (`__proto__`, `constructor`, `hasOwnProperty`, `toString`,
+ * ...) would otherwise read a value off `Object.prototype` instead of the
+ * object itself, leading to prototype-chain access / prototype pollution
+ * (CWE-1321).
+ */
+export function getOwn<T = any>(obj: { [key: string]: any }, prop: string): T | undefined {
+  return Object.prototype.hasOwnProperty.call(obj, prop) ? obj[prop] : undefined;
+}
