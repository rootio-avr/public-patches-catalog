-  });
-
-  return async (input: string | URL | Request, { signal, ...init }: RequestInit = {}) => {
-    if (signal?.aborted) {
-      return Promise.reject(signal.reason);
-    }
-
-    const requestId = Math.random().toString(36).slice(2);
