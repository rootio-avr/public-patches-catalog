+// Regression test for CVE-2022-21680 (GHSA-rrrm-qjm4-v8hf)
+// Cubic catastrophic backtracking (ReDoS) in the block.def regular expression.
+// Grounded on the upstream test payload test/specs/redos/cubic_def.cjs, adapted
+// to this project's jasmine (-spec.js) convention. Before the fix, parsing the
+// crafted string below hangs for an unbounded amount of time; after the fix it
+// completes near-instantly.
+var marked = require('../../lib/marked.js');
+
+describe('CVE-2022-21680 block.def ReDoS', function () {
+  it('parses a crafted definition payload without catastrophic backtracking', function () {
+    var pad = new Array(1501).join(' '); // 1500 spaces, matching upstream payload
+    var markdown = '[x]:' + pad + 'x ' + pad + ' x';
+
+    var start = Date.now();
+    var html = marked(markdown);
+    var elapsed = Date.now() - start;
+
+    expect(typeof html).toBe('string');
+    // A vulnerable regex takes seconds/minutes on this input; the fixed one is
+    // effectively linear. Allow a generous ceiling to avoid flakiness on slow CI.
+    expect(elapsed).toBeLessThan(2000);
+  });
+
+  it('still parses a normal link definition correctly', function () {
+    var html = marked('[foo]: /url "title"\n\n[foo]');
+    expect(html).toContain('href="/url"');
+    expect(html).toContain('title="title"');
+  });
+});

