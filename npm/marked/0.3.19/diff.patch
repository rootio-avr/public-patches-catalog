@@ -0,0 +1,41 @@
+// Regression test for CVE-2022-21681 (GHSA-rrrm-qjm4-v8hf)
+// ReDoS in the block `def`, inline `reflink` and `nolink` grammar rules.
+// Payloads mirror the upstream fixtures test/specs/redos/{cubic_def.cjs,reflink_redos.md}.
+var marked = require('../../lib/marked.js');
+
+describe('CVE-2022-21681 ReDoS hardening', function () {
+  function timeParse(md) {
+    var start = process.hrtime();
+    var out = marked(md);
+    var diff = process.hrtime(start);
+    return { ms: (diff[0] * 1e3) + (diff[1] / 1e6), out: out };
+  }
+
+  it('does not hang on the reflink/nolink ReDoS payload', function () {
+    var md = '[x]: x\n\n[' + '\\[\\]('.repeat(40);
+    var r = timeParse(md);
+    expect(r.ms).toBeLessThan(2000);
+    expect(typeof r.out).toBe('string');
+  });
+
+  it('does not hang on the cubic def ReDoS payload', function () {
+    var md = '[x]:' + ' '.repeat(3000) + 'x ' + ' '.repeat(3000) + ' x';
+    var r = timeParse(md);
+    expect(r.ms).toBeLessThan(2000);
+    expect(typeof r.out).toBe('string');
+  });
+
+  it('does not hang on the nolink bracket ReDoS payload', function () {
+    var md = '![' + '\\[[]'.repeat(45) + '!\\';
+    var r = timeParse(md);
+    expect(r.ms).toBeLessThan(2000);
+    expect(typeof r.out).toBe('string');
+  });
+
+  it('still renders normal reference and inline links correctly', function () {
+    expect(marked('[foo][bar]\n\n[bar]: http://example.com')).toContain('href="http://example.com"');
+    expect(marked('[foo]\n\n[foo]: http://example.com')).toContain('href="http://example.com"');
+    expect(marked('[text](http://example.com)')).toContain('href="http://example.com"');
+    expect(marked('[foo]: /url "the title"\n\n[foo]')).toContain('title="the title"');
+  });
+});
