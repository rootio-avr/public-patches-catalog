+'use strict'
+
+const { DOMImplementation, XMLSerializer } = require('../lib/dom')
+
+const INVALID_STATE_ERR = 11
+
+function serialize(doctype, requireWellFormed) {
+	const doc = new DOMImplementation().createDocument(null, 'root', null)
+	doc.insertBefore(doctype, doc.documentElement)
+	return new XMLSerializer().serializeToString(doc, undefined, undefined, requireWellFormed)
+}
+
+function doctype(publicId, systemId, internalSubset) {
+	const dt = new DOMImplementation().createDocumentType('root', publicId, systemId)
+	if (internalSubset !== undefined) dt.internalSubset = internalSubset
+	return dt
+}
+
+describe('DocumentType serialization with requireWellFormed (GHSA-f6ww-3ggp-fr8h)', () => {
+	test.each([
+		['unquoted publicId', doctype('x><injected/><!--', '"s"')],
+		['publicId with disallowed char', doctype('"a<b"', '"s"')],
+		['systemId with injected markup', doctype('"-//OK//EN"', '"s"><injected/><!--"')],
+		['unquoted systemId', doctype(undefined, 'x><injected/>')],
+		['internalSubset containing "]>"', doctype(undefined, undefined, ']><injected/><!DOCTYPE x [')],
+	])('should throw InvalidStateError for %s', (_, dt) => {
+		let error
+		try {
+			serialize(dt, true)
+		} catch (e) {
+			error = e
+		}
+		expect(error).toBeDefined()
+		expect(error.code).toBe(INVALID_STATE_ERR)
+	})
+
+	test.each([
+		['PUBLIC with double quotes', doctype('"-//W3C//DTD XHTML 1.0//EN"', '"http://example.org/a.dtd"'), '<!DOCTYPE root PUBLIC "-//W3C//DTD XHTML 1.0//EN" "http://example.org/a.dtd">'],
+		['PUBLIC with single quotes', doctype("'-//A//EN'", "'a.dtd'"), "<!DOCTYPE root PUBLIC '-//A//EN' 'a.dtd'>"],
+		['SYSTEM', doctype(undefined, '"a.dtd"'), '<!DOCTYPE root SYSTEM "a.dtd">'],
+		['internal subset', doctype(undefined, undefined, '<!ENTITY a "b">'), '<!DOCTYPE root [<!ENTITY a "b">]>'],
+		['name only', doctype(), '<!DOCTYPE root>'],
+	])('should serialize valid %s', (_, dt, expected) => {
+		expect(serialize(dt, true)).toBe(expected + '<root/>')
+	})
+
+	test('should keep serializing verbatim by default', () => {
+		const dt = doctype('x><injected/><!--', '"s"')
+		expect(serialize(dt)).toContain('<!DOCTYPE root PUBLIC x><injected/><!-- "s">')
+	})
+})

