+'use strict'
+
+const { DOMParser, XMLSerializer } = require('../../lib/dom-parser')
+
+// GHSA-2v35-w6hq-6mfw / CVE-2026-41673:
+// operations that walk the tree recursively used to throw a RangeError (stack overflow)
+// on deeply nested documents, which parse without problems.
+describe('deeply nested documents (stack overflow)', () => {
+	const DEPTH = 50000
+	let doc
+	beforeAll(() => {
+		const xml = '<a>'.repeat(DEPTH) + 'text' + '</a>'.repeat(DEPTH)
+		doc = new DOMParser().parseFromString(xml, 'text/xml')
+	})
+
+	it('serializes with serializeToString', () => {
+		const out = new XMLSerializer().serializeToString(doc)
+		expect(out.length).toBe(DEPTH * 7 + 4)
+		expect(out.startsWith('<a><a>')).toBe(true)
+		expect(out.indexOf('<a>text</a></a>')).toBe((DEPTH - 1) * 3)
+		expect(out.endsWith('</a></a>')).toBe(true)
+	})
+
+	it('serializes with toString', () => {
+		expect(() => doc.toString()).not.toThrow()
+	})
+
+	it('clones with cloneNode(true)', () => {
+		const clone = doc.documentElement.cloneNode(true)
+		expect(clone).not.toBe(doc.documentElement)
+		expect(clone.textContent).toBe('text')
+	})
+
+	it('imports with importNode(node, true)', () => {
+		const other = new DOMParser().parseFromString('<root/>', 'text/xml')
+		const imported = other.importNode(doc.documentElement, true)
+		expect(imported.ownerDocument).toBe(other)
+		expect(imported.textContent).toBe('text')
+	})
+
+	it('reads textContent', () => {
+		expect(doc.documentElement.textContent).toBe('text')
+	})
+
+	it('finds elements with getElementsByTagName', () => {
+		expect(doc.getElementsByTagName('a').length).toBe(DEPTH)
+	})
+
+	it('finds elements with getElementsByTagNameNS', () => {
+		expect(doc.getElementsByTagNameNS('*', 'a').length).toBe(DEPTH)
+	})
+
+	it('finds elements with getElementById', () => {
+		expect(doc.getElementById('missing')).toBe(null)
+	})
+
+	it('normalizes', () => {
+		expect(() => doc.normalize()).not.toThrow()
+	})
+
+	it('still merges adjacent text nodes in normalize', () => {
+		const d = new DOMParser().parseFromString('<r><c/></r>', 'text/xml')
+		const c = d.documentElement.firstChild
+		c.appendChild(d.createTextNode('a'))
+		c.appendChild(d.createTextNode('b'))
+		d.documentElement.appendChild(d.createTextNode('x'))
+		d.documentElement.appendChild(d.createTextNode('y'))
+		d.normalize()
+		expect(c.childNodes.length).toBe(1)
+		expect(c.firstChild.data).toBe('ab')
+		expect(d.documentElement.childNodes.length).toBe(2)
+		expect(d.documentElement.lastChild.data).toBe('xy')
+	})
+})
