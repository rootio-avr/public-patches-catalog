@@ -0,0 +1,61 @@
+'use strict'
+
+const { DOMParser } = require('../lib/dom-parser')
+
+/**
+ * Returns the fastest wall-clock (ms) of `runs` executions of `fn`.
+ */
+function fastestMs(fn, runs) {
+	var best = Infinity
+	for (var k = 0; k < runs; k++) {
+		var t = process.hrtime.bigint()
+		fn()
+		var d = Number(process.hrtime.bigint() - t) / 1e6
+		if (d < best) best = d
+	}
+	return best
+}
+
+function attrBomb(m) {
+	var parts = new Array(m)
+	for (var i = 0; i < m; i++) parts[i] = 'a' + i + '="x"'
+	return '<r ' + parts.join(' ') + '/>'
+}
+
+describe('quadratic attribute de-duplication during parse (GHSA-8344-3jmq-59r6)', () => {
+	// Growth ratio over a 4x increase in M: quadratic ~16x, linear ~4x.
+	const M1 = 4000
+	const M2 = 16000
+	const RATIO_MAX = 8
+
+	test('an element with many distinct attributes de-duplicates in sub-quadratic time', () => {
+		const xml1 = attrBomb(M1)
+		const xml2 = attrBomb(M2)
+		const t1 = fastestMs(() => new DOMParser().parseFromString(xml1, 'text/xml'), 5)
+		const t2 = fastestMs(() => new DOMParser().parseFromString(xml2, 'text/xml'), 5)
+		expect(t2 / t1).toBeLessThan(RATIO_MAX)
+	})
+
+	test('attribute order and duplicate resolution are preserved', () => {
+		const doc = new DOMParser().parseFromString('<r a="1" b="2" __proto__="p" constructor="c"/>', 'text/xml')
+		const el = doc.documentElement
+		expect(el.attributes.length).toBe(4)
+		expect(el.getAttribute('__proto__')).toBe('p')
+		expect(el.getAttribute('constructor')).toBe('c')
+		el.setAttribute('a', '9')
+		expect(el.attributes.length).toBe(4)
+		expect(el.attributes.item(0).name).toBe('a')
+		expect(el.getAttribute('a')).toBe('9')
+	})
+
+	test('index stays in sync after removal', () => {
+		const doc = new DOMParser().parseFromString('<r a="1" b="2"/>', 'text/xml')
+		const el = doc.documentElement
+		el.removeAttribute('a')
+		expect(el.attributes.length).toBe(1)
+		el.setAttribute('a', '3')
+		expect(el.attributes.length).toBe(2)
+		expect(el.attributes.item(1).name).toBe('a')
+		expect(el.attributes.setNamedItem(doc.createAttribute('toString'))).toBeUndefined()
+	})
+})

