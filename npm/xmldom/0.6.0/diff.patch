+'use strict'
+
+const { DOMParser, XMLSerializer } = require('../lib/dom-parser')
+
+const opts = { requireWellFormed: true }
+
+describe('CVE-2026-83605: serializeToString requireWellFormed validates names', () => {
+	let doc
+	beforeEach(() => {
+		doc = new DOMParser().parseFromString('<root/>', 'text/xml')
+	})
+
+	it('default: invalid element name is emitted verbatim without throwing', () => {
+		doc.documentElement.appendChild(doc.createElement('x><inject'))
+		expect(() => new XMLSerializer().serializeToString(doc)).not.toThrow()
+	})
+
+	it('requireWellFormed: invalid element name throws', () => {
+		doc.documentElement.appendChild(doc.createElement('x><inject'))
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).toThrow()
+	})
+
+	it('requireWellFormed: valid element name does not throw', () => {
+		doc.documentElement.appendChild(doc.createElement('child'))
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).not.toThrow()
+	})
+
+	it('default: invalid attribute name is emitted verbatim without throwing', () => {
+		doc.documentElement.setAttribute('a><inject ', 'v')
+		expect(() => new XMLSerializer().serializeToString(doc)).not.toThrow()
+	})
+
+	it('requireWellFormed: invalid attribute name throws', () => {
+		doc.documentElement.setAttribute('a><inject ', 'v')
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).toThrow()
+	})
+
+	it('requireWellFormed: valid attribute name does not throw', () => {
+		doc.documentElement.setAttribute('class', 'hello')
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).not.toThrow()
+	})
+
+	it('requireWellFormed: invalid prefix in synthesized xmlns declaration throws', () => {
+		const el = doc.createElementNS('http://example.com/ns', 'p:child')
+		doc.documentElement.appendChild(el)
+		el.prefix = 'evil>'
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).toThrow()
+	})
+
+	it('requireWellFormed: invalid prefix in element qualified name throws', () => {
+		doc.documentElement.appendChild(doc.createElement('evil>:child'))
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).toThrow()
+	})
+
+	it('requireWellFormed: valid prefixed element does not throw', () => {
+		doc.documentElement.appendChild(doc.createElementNS('http://example.com/ns', 'p:child'))
+		expect(() => new XMLSerializer().serializeToString(doc, false, null, opts)).not.toThrow()
+	})
+
+	it('requireWellFormed is also honoured by Node#toString', () => {
+		doc.documentElement.setAttribute('a><inject ', 'v')
+		expect(() => doc.toString(false, null, opts)).toThrow()
+	})
+})

