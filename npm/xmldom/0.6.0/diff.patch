+'use strict'
+
+const { DOMParser } = require('../lib/dom-parser')
+
+describe('CVE-2022-37616 prototype pollution', () => {
+	afterEach(() => {
+		delete Object.prototype.polluted
+	})
+
+	it('should not copy inherited (polluted) properties onto live node lists', () => {
+		Object.prototype.polluted = 'yes'
+		const doc = new DOMParser().parseFromString(
+			'<root xmlns:a="http://a"><a:child/><child/></root>',
+			'text/xml'
+		)
+		const list = doc.documentElement.getElementsByTagName('*')
+		expect(list.length).toBe(2)
+		expect(Object.prototype.hasOwnProperty.call(list, 'polluted')).toBe(false)
+	})
+
+	it('should not treat inherited properties as namespace prefixes', () => {
+		Object.prototype.polluted = 'yes'
+		const doc = new DOMParser().parseFromString(
+			'<root xmlns:a="http://a"><a:child/></root>',
+			'text/xml'
+		)
+		const child = doc.documentElement.firstChild
+		expect(child.namespaceURI).toBe('http://a')
+		expect(child.lookupNamespaceURI('polluted')).toBeFalsy()
+	})
+})

