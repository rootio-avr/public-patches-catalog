+test('quote ops: allowlist', function (t) {
+    var ops = ['||', '&&', ';;', '|&', '<(', '<<<', '>>', '>&', '<&', '&', ';', '(', ')', '|', '<', '>'];
+    for (var i = 0; i < ops.length; i++) {
+        var op = ops[i];
+        var expected = '';
+        for (var j = 0; j < op.length; j++) { expected += '\\' + op.charAt(j); }
+        t.equal(quote([{ op: op }]), expected, 'op ' + op);
+    }
+    t.end();
+});
+
