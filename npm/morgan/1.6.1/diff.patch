Fix using special characters in format (CVE-2019-5413)

The compile() function built the generated logger body by only escaping
double-quote characters in the format string. Any other characters with
meaning inside a JS string literal (backslashes, newlines, etc.) -- as well
as token names -- were interpolated verbatim into the source passed to
new Function(). A caller-controlled format string could therefore break out
of the string literal and inject arbitrary JavaScript that runs whenever a
request is logged.

This backports the upstream fix (expressjs/morgan e329663) onto the v1.6.1
compile() shape: the whole format string is safely encoded with
JSON.stringify, and token names are likewise JSON-encoded before being
embedded in the generated function body.

--- a/index.js
+++ b/index.js
@@ -375,10 +375,17 @@
     throw new TypeError('argument format must be a string')
   }
 
-  var fmt = format.replace(/"/g, '\\"')
-  var js = '  return "' + fmt.replace(/:([-\w]{2,})(?:\[([^\]]+)\])?/g, function(_, name, arg) {
-    return '"\n    + (tokens["' + name + '"](req, res, ' + String(JSON.stringify(arg)) + ') || "-") + "'
-  }) + '";'
+  var fmt = String(JSON.stringify(format))
+  var js = '  "use strict"\n  return ' + fmt.replace(/:([-\w]{2,})(?:\[([^\]]+)\])?/g, function(_, name, arg) {
+    var tokenArguments = 'req, res'
+    var tokenFunction = 'tokens[' + String(JSON.stringify(name)) + ']'
+
+    if (arg !== undefined) {
+      tokenArguments += ', ' + String(JSON.stringify(arg))
+    }
+
+    return '" +\n    (' + tokenFunction + '(' + tokenArguments + ') || "-") + "'
+  })
 
   return new Function('tokens, req, res', js)
 }
