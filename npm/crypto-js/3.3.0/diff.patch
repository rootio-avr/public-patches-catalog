+/*
+ * Regression test for AIKIDO-2026-554041 (crypto-js insecure WordArray.random).
+ *
+ * Before the fix, WordArray.random() used an MWC PRNG seeded from Math.random(),
+ * which is not cryptographically secure and is fully predictable once Math.random
+ * is controlled. After the fix, random() draws from a native CSPRNG
+ * (crypto.getRandomValues / require('crypto').randomBytes) via
+ * cryptoSecureRandomInt(), so its output is independent of Math.random().
+ *
+ * This is a differential entropy / independence check: it does not need the
+ * upstream test suite (which is not shipped in this package tarball).
+ *
+ * Run with:  node test/aikido-2026-554041.test.js
+ */
+
+var assert = require('assert');
+var CryptoJS = require('../index');
+
+function collectWords(n) {
+    var wa = CryptoJS.lib.WordArray.random(n);
+    return wa.words.slice();
+}
+
+// 1) Output length matches requested byte count (rounded up to 4-byte words).
+(function testLength() {
+    var wa = CryptoJS.lib.WordArray.random(16);
+    assert.strictEqual(wa.sigBytes, 16, 'random(16) must report 16 significant bytes');
+    assert.strictEqual(wa.words.length, 4, 'random(16) must produce 4 32-bit words');
+})();
+
+// 2) Two successive draws must differ (basic entropy sanity).
+(function testDistinctDraws() {
+    var a = collectWords(32);
+    var b = collectWords(32);
+    assert.notDeepStrictEqual(a, b, 'two random(32) draws must not be identical');
+})();
+
+// 3) Differential check: pinning Math.random must NOT make output predictable.
+//    This is the core of the vulnerability — the legacy PRNG was seeded from
+//    Math.random(), so freezing it produced a deterministic (guessable) stream.
+(function testIndependentFromMathRandom() {
+    var originalRandom = Math.random;
+    try {
+        Math.random = function () { return 0.42; };
+        var first = collectWords(64);
+        var second = collectWords(64);
+        // With a frozen Math.random the vulnerable code produced identical
+        // (and predictable) output. The secure implementation must not.
+        assert.notDeepStrictEqual(
+            first,
+            second,
+            'WordArray.random must not be reproducible by pinning Math.random'
+        );
+    } finally {
+        Math.random = originalRandom;
+    }
+})();
+
+// 4) Entropy floor: across many words, the vast majority must be unique.
+(function testEntropyFloor() {
+    var words = collectWords(4096); // 1024 words
+    var seen = Object.create(null);
+    var unique = 0;
+    for (var i = 0; i < words.length; i++) {
+        var key = String(words[i]);
+        if (!seen[key]) {
+            seen[key] = true;
+            unique++;
+        }
+    }
+    // A CSPRNG over 1024 32-bit words should have essentially no collisions;
+    // allow generous slack while still catching a degenerate/constant stream.
+    assert.ok(
+        unique > words.length * 0.9,
+        'expected high uniqueness among random words, got ' + unique + '/' + words.length
+    );
+})();
+
+console.log('AIKIDO-2026-554041 regression test passed');

