@@ -0,0 +1,81 @@
+/*
+ * Regression test for CVE-2026-71851 (CWE-338 / CWE-330 / CWE-331).
+ *
+ * CryptoJS.lib.WordArray.random() historically used a custom
+ * Multiply-With-Carry PRNG seeded from Math.random(), which is NOT a
+ * cryptographically secure source. Its output was therefore predictable
+ * once Math.random() was controlled, weakening any key/IV/salt derived
+ * from it (e.g. BIP39 wallet seeds).
+ *
+ * The fix (upstream b405ff5) draws entropy from a native CSPRNG
+ * (crypto.getRandomValues in the browser / require('crypto').randomBytes
+ * on Node) so the output is independent of Math.random().
+ *
+ * This is a differential / entropy regression test that does not rely on
+ * the upstream test suite (which is not shipped in this package tarball).
+ *
+ * Run with:  node test/cve-2026-71851.test.js
+ */
+
+var assert = require('assert');
+var CryptoJS = require('../index');
+
+function collectWords(nBytes) {
+    return CryptoJS.lib.WordArray.random(nBytes).words.slice();
+}
+
+// 1) Shape: random(nBytes) must report the requested significant byte count
+//    and produce ceil(nBytes/4) 32-bit words.
+(function testShape() {
+    var wa = CryptoJS.lib.WordArray.random(16);
+    assert.strictEqual(wa.sigBytes, 16, 'random(16) must report 16 significant bytes');
+    assert.strictEqual(wa.words.length, 4, 'random(16) must produce 4 32-bit words');
+})();
+
+// 2) Two successive draws must differ (basic entropy sanity).
+(function testDistinctDraws() {
+    assert.notDeepStrictEqual(
+        collectWords(32),
+        collectWords(32),
+        'two random(32) draws must not be identical'
+    );
+})();
+
+// 3) Core of the vulnerability: pinning Math.random() must NOT make the
+//    output reproducible. The legacy PRNG was seeded from Math.random(),
+//    so freezing it produced a deterministic (guessable) stream; a secure
+//    implementation must remain unpredictable.
+(function testIndependentFromMathRandom() {
+    var originalRandom = Math.random;
+    try {
+        Math.random = function () { return 0.42; };
+        assert.notDeepStrictEqual(
+            collectWords(64),
+            collectWords(64),
+            'WordArray.random must not be reproducible by pinning Math.random'
+        );
+    } finally {
+        Math.random = originalRandom;
+    }
+})();
+
+// 4) Entropy floor: across many words the overwhelming majority must be
+//    unique, catching a degenerate/constant stream.
+(function testEntropyFloor() {
+    var words = collectWords(4096); // 1024 words
+    var seen = Object.create(null);
+    var unique = 0;
+    for (var i = 0; i < words.length; i++) {
+        var key = String(words[i]);
+        if (!seen[key]) {
+            seen[key] = true;
+            unique++;
+        }
+    }
+    assert.ok(
+        unique > words.length * 0.9,
+        'expected high uniqueness among random words, got ' + unique + '/' + words.length
+    );
+})();
+
+console.log('CVE-2026-71851 regression test passed');
