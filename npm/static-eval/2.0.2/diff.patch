+});
+
+test('disallow accessing constructor or __proto__', function (t) {
+    t.plan(6);
+
+    var someValue = {};
+
+    var src = 'object.constructor';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: someValue });
+    t.equal(res, undefined);
+
+    var src = 'object["constructor"]';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: someValue });
+    t.equal(res, undefined);
+
+    var src = 'object.__proto__';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: someValue });
+    t.equal(res, undefined);
+
+    var src = 'object["__pro"+"t\\x6f__"]';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: someValue });
+    t.equal(res, undefined);
+
+    var src = 'object[key]';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: someValue, key: 'constructor' });
+    t.equal(res, undefined);
+
+    var src = 'object.a';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: { a: 1 } });
+    t.equal(res, 1);
+});
+
+test('function body cannot hide constructor behind a ternary', function (t) {
+    t.plan(4);
+
+    var src = '(function(n){ return n ? n.constructor.constructor("return 1337")() : 0 })(1)';
+    var ast = parse(src).body[0].expression;
+    t.equal(evaluate(ast, {}), undefined);
+
+    src = '[1].map(function(n){ return n ? n.constructor.constructor("return 1337")() : 0 })';
+    ast = parse(src).body[0].expression;
+    t.equal(evaluate(ast, {}), undefined);
+
+    src = '(function(n){ return n ? n * 2 : 0 })(3)';
+    ast = parse(src).body[0].expression;
+    t.equal(evaluate(ast, {}), 6);
+
+    src = '(function(n){ return n ? n.foo : 0 })({foo: 1})';
+    ast = parse(src).body[0].expression;
+    t.equal(evaluate(ast, {}), 1);
+});
+
+test('computed key cannot coerce to constructor', function (t) {
+    t.plan(2);
+
+    var src = 'object[{toString:function(){return "constructor"}}]';
+    var ast = parse(src).body[0].expression;
+    var res = evaluate(ast, { object: {} });
+    t.equal(res, undefined);
+
+    src = 'flag ? object.constructor : 1';
+    ast = parse(src).body[0].expression;
+    res = evaluate(ast, { flag: false, object: {} });
+    t.equal(res, 1);
+});
