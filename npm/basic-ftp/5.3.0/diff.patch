--- /dev/null
+++ b/test/cve-2026-44240.test.js
@@ -0,0 +1,43 @@
+const assert = require("assert");
+const FTPContext = require("../dist").FTPContext;
+
+// Regression test for CVE-2026-44240: unbounded control response.
+// A malicious/misbehaving FTP server can stream control data without ever
+// completing a response, causing the client to buffer it indefinitely
+// (memory exhaustion / DoS). The fix caps the accepted control response at
+// 2**16 bytes and closes the connection with an error once exceeded.
+describe("CVE-2026-44240: guard against unbounded control response", function () {
+    this.timeout(1000);
+
+    it("closes the connection with an error when the control response exceeds the maximum size", function (done) {
+        const ftp = new FTPContext();
+        let finished = false;
+        ftp.handle(undefined, (res, task) => {
+            if (finished) {
+                return;
+            }
+            finished = true;
+            task.resolve();
+            assert.ok(res instanceof Error, "expected an error to be relayed");
+            assert.ok(
+                /exceeded maximum allowed size/.test(res.message),
+                `unexpected error message: ${res.message}`
+            );
+            done();
+        });
+        // A single oversized chunk with no response terminator (CRLF group)
+        // must be rejected rather than buffered.
+        const oversized = "2".repeat((2 ** 16) + 1);
+        ftp.socket.emit("data", oversized);
+    });
+
+    it("still relays a normal control response", function (done) {
+        const ftp = new FTPContext();
+        ftp.handle(undefined, (res, task) => {
+            task.resolve();
+            assert.deepEqual(res, { code: 200, message: "200 OK" });
+            done();
+        });
+        ftp.socket.emit("data", "200 OK");
+    });
+});
