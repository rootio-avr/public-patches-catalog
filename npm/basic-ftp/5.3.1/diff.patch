--- /dev/null
+++ b/test/cve-2026-102990.test.js
@@ -0,0 +1,34 @@
+const assert = require("assert");
+const { parseList } = require("../dist/parseList");
+
+/**
+ * A directory listing comes from a remote server, parsing it must not let that server block the
+ * event loop. These listings took minutes to parse before the parser expressions were anchored
+ * and the owner/group name quantifiers bounded.
+ */
+describe("CVE-2026-102990: directory listing parsing is not quadratic", function() {
+    const maxDuration = 1000;
+    const listDOS = "12-05-96  05:03PM       <DIR>          myDir\r\n11-14-97  04:21PM                  953 MYFILE.INI";
+    const listUnix = "drwxr-xr-x    2 1001     1001         4096 Feb 25 19:03 .\r\n-rw-------    1 1001     1001          487 Feb 25 19:03 package.json";
+
+    function measure(list) {
+        const start = Date.now();
+        const files = parseList(list);
+        return { files, duration: Date.now() - start };
+    }
+
+    it("handles a long Unix line that can't be parsed", function() {
+        // Ends on a valid line because that's the one deciding which parser is used for the whole list.
+        const list = "-rw-r--r-- 1 " + "a ".repeat(64 * 1024) + "!\r\n" + listUnix;
+        const { files, duration } = measure(list);
+        assert.deepStrictEqual(files.map(file => file.name), ["package.json"]);
+        assert.ok(duration < maxDuration, `Parsing took ${duration}ms, expected less than ${maxDuration}ms`);
+    });
+
+    it("handles a long DOS line without whitespace", function() {
+        const list = "x".repeat(256 * 1024) + "\r\n" + listDOS;
+        const { files, duration } = measure(list);
+        assert.deepStrictEqual(files.map(file => file.name), ["myDir", "MYFILE.INI"]);
+        assert.ok(duration < maxDuration, `Parsing took ${duration}ms, expected less than ${maxDuration}ms`);
+    });
+});
