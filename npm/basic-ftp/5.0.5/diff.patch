--- /dev/null
+++ b/test/cve-2026-102990.test.js
@@ -0,0 +1,44 @@
+const assert = require("assert");
+const { parseList } = require("../dist/parseList");
+
+/**
+ * Regression test for CVE-2026-102990: a directory listing comes from a remote server, parsing it
+ * must not let that server block the event loop (quadratic-time regular expression matching).
+ */
+describe("CVE-2026-102990 directory listing DoS resistance", function() {
+    const maxDuration = 1000;
+    const validUnix = "-rw-r--r--   1 patrick  staff   1057 Dec 11 14:35 package.json";
+    const validDOS = "12-05-96  05:03PM       <DIR>          myDir";
+
+    function measure(list) {
+        const start = Date.now();
+        const files = parseList(list);
+        return { files, duration: Date.now() - start };
+    }
+
+    it("handles a long Unix line that can't be parsed", function() {
+        // Ends on a valid line because that's the one deciding which parser is used for the whole list.
+        const list = "-rw-r--r-- 1 " + "a ".repeat(64 * 1024) + "!\r\n" + validUnix;
+        const { files, duration } = measure(list);
+        assert.deepStrictEqual(files.map(file => file.name), ["package.json"]);
+        assert.ok(duration < maxDuration, `Parsing took ${duration}ms, expected less than ${maxDuration}ms`);
+    });
+
+    it("handles a long DOS line without whitespace", function() {
+        const list = "x".repeat(256 * 1024) + "\r\n" + validDOS;
+        const { files, duration } = measure(list);
+        assert.deepStrictEqual(files.map(file => file.name), ["myDir"]);
+        assert.ok(duration < maxDuration, `Parsing took ${duration}ms, expected less than ${maxDuration}ms`);
+    });
+
+    it("still parses Unix lines with spaces in names and an inode/block count", function() {
+        const [owner] = parseList("-rw-r--r--   1 Domain Users  staff 12345 Feb 12 12:12 f.txt");
+        assert.strictEqual(owner.user, "Domain Users");
+        assert.strictEqual(owner.group, "staff");
+        const [group] = parseList("-rw-r--r-- 1 patrick staff group 487 Feb 25 19:03 package.json");
+        assert.strictEqual(group.group, "staff group");
+        const [inode] = parseList(" 1234567    4 -rw-r--r--   1 patrick  staff    487 Feb 25 19:03 package.json");
+        assert.strictEqual(inode.name, "package.json");
+        assert.strictEqual(inode.size, 487);
+    });
+});
