+/**
+ * Check if `destination` is the same host as `original`, or a subdomain of it.
+ *
+ * @param   String   destination  Redirect target url
+ * @param   String   original     Url of the request that was redirected
+ * @return  Boolean
+ */
+function isDomainOrSubdomain(destination, original) {
+	var dest = parse_url(destination).hostname;
+	var orig = parse_url(original).hostname;
+	if (!dest || !orig) {
+		return false;
+	}
+	return dest === orig || (dest[dest.length - orig.length - 1] === '.' && dest.slice(-orig.length) === orig);
+}
 
