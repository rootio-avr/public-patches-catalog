@@ -0,0 +1,70 @@
+'use strict';
+// Regression test for CVE-2022-0235: sensitive headers must not be forwarded
+// on a redirect to a different domain.
+const assert = require('assert');
+const http = require('http');
+const fetch = require('../lib/index.js');
+const Headers = fetch.Headers;
+
+const SENSITIVE = ['cookie', 'cookie2', 'authorization', 'www-authenticate'];
+
+function makeHeaders() {
+	return new Headers({
+		cookie: 'is=cookie',
+		cookie2: 'is=cookie2',
+		authorization: 'is=authorization',
+		'www-authenticate': 'is=www-authenticate',
+		'x-foo': 'bar'
+	});
+}
+
+const target = http.createServer((req, res) => {
+	res.setHeader('Content-Type', 'application/json');
+	res.end(JSON.stringify(req.headers));
+});
+
+const origin = http.createServer((req, res) => {
+	// /to/<absolute-url>
+	res.statusCode = 302;
+	res.setHeader('Location', decodeURIComponent(req.url.slice('/to/'.length)));
+	res.end();
+});
+
+function listen(server) {
+	return new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+}
+
+(async () => {
+	await listen(target);
+	await listen(origin);
+	const originBase = `http://127.0.0.1:${origin.address().port}`;
+	const targetPort = target.address().port;
+
+	try {
+		// Different host (localhost vs 127.0.0.1): sensitive headers must be stripped.
+		const crossUrl = `http://localhost:${targetPort}/`;
+		let res = await fetch(`${originBase}/to/${encodeURIComponent(crossUrl)}`, { headers: makeHeaders() });
+		let seen = await res.json();
+		assert.strictEqual(seen['x-foo'], 'bar');
+		for (const name of SENSITIVE) {
+			assert.strictEqual(seen[name], undefined, `${name} must not be forwarded to another domain`);
+		}
+
+		// Same host: sensitive headers are preserved.
+		const sameUrl = `http://127.0.0.1:${targetPort}/`;
+		res = await fetch(`${originBase}/to/${encodeURIComponent(sameUrl)}`, { headers: makeHeaders() });
+		seen = await res.json();
+		assert.strictEqual(seen['x-foo'], 'bar');
+		assert.strictEqual(seen.cookie, 'is=cookie');
+		assert.strictEqual(seen.cookie2, 'is=cookie2');
+		assert.strictEqual(seen.authorization, 'is=authorization');
+		assert.strictEqual(seen['www-authenticate'], 'is=www-authenticate');
+		console.log('CVE-2022-0235 regression test passed');
+	} finally {
+		target.close();
+		origin.close();
+	}
+})().catch(err => {
+	console.error(err);
+	process.exit(1);
+});
