@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest'
+import { resolveApiServerConfig } from 'vitest/node'
+
+// Regression test for CVE-2026-47429: the API server exposed a path-traversal
+// arbitrary file write / code-exec surface. The fix gates privileged write/exec
+// operations behind api.allowWrite / api.allowExec, which default to `false`
+// whenever the API server is bound to a non-loopback host (exposed to the
+// network) and `true` only for localhost / 127.0.0.1.
+describe('CVE-2026-47429 api allowWrite/allowExec defaults', () => {
+  it('defaults allowWrite and allowExec to true when not exposed (no host)', () => {
+    const api = resolveApiServerConfig({ api: { port: 5555 } }, 51204)
+    expect(api.allowWrite).toBe(true)
+    expect(api.allowExec).toBe(true)
+  })
+
+  it('defaults allowWrite and allowExec to true for localhost', () => {
+    const api = resolveApiServerConfig({ api: { port: 5555, host: 'localhost' } }, 51204)
+    expect(api.allowWrite).toBe(true)
+    expect(api.allowExec).toBe(true)
+  })
+
+  it('defaults allowWrite and allowExec to true for 127.0.0.1', () => {
+    const api = resolveApiServerConfig({ api: { port: 5555, host: '127.0.0.1' } }, 51204)
+    expect(api.allowWrite).toBe(true)
+    expect(api.allowExec).toBe(true)
+  })
+
+  it('disables allowWrite and allowExec by default when exposed to the network', () => {
+    const api = resolveApiServerConfig({ api: { port: 5555, host: '0.0.0.0' } }, 51204)
+    expect(api.allowWrite).toBe(false)
+    expect(api.allowExec).toBe(false)
+  })
+
+  it('allows explicit opt-in even when exposed to the network', () => {
+    const api = resolveApiServerConfig(
+      { api: { port: 5555, host: '0.0.0.0', allowWrite: true, allowExec: true } },
+      51204,
+    )
+    expect(api.allowWrite).toBe(true)
+    expect(api.allowExec).toBe(true)
+  })
+
+  it('honours explicit disabling on loopback', () => {
+    const api = resolveApiServerConfig(
+      { api: { port: 5555, allowWrite: false, allowExec: false } },
+      51204,
+    )
+    expect(api.allowWrite).toBe(false)
+    expect(api.allowExec).toBe(false)
+  })
+})
