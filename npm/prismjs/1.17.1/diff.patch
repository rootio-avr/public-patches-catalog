diff --git a/tests/cve-2022-23647.test.js b/tests/cve-2022-23647.test.js
new file mode 100644
index 0000000..9e07c62
--- /dev/null
+++ b/tests/cve-2022-23647.test.js
@@ -0,0 +1,56 @@
+'use strict';
+
+/**
+ * Regression test for CVE-2022-23647 (CWE-79).
+ *
+ * The Command Line plugin removes "output" lines from the code before it is
+ * highlighted (so they are not tokenized) and then reinserts them into the
+ * highlighted markup in the `before-insert` hook. Before the fix the output
+ * lines were reinserted verbatim, so any HTML markup they contained (e.g.
+ * `<script>alert(1)</script>`) was injected unescaped into the DOM -> XSS.
+ *
+ * The fix escapes the reinserted output with `Prism.util.encode(...)`, which
+ * is exactly what tokenized/highlighted code also goes through. This test
+ * loads the real Prism source shipped in the package and exercises the same
+ * reinsertion logic to assert that markup in output lines is escaped.
+ */
+
+var assert = require('assert');
+var path = require('path');
+
+// Load the actual Prism source from the package under test.
+var Prism = require(path.join(__dirname, '..', 'prism.js'));
+
+// The exact reinsertion behavior from the patched `before-insert` hook.
+function reinsertOutputLines(highlightedCode, outputLines) {
+	var codeLines = highlightedCode.split('\n');
+	for (var i = 0, l = (outputLines || []).length; i < l; i++) {
+		if (outputLines.hasOwnProperty(i)) {
+			codeLines[i] = Prism.util.encode(outputLines[i]);
+		}
+	}
+	return codeLines.join('\n');
+}
+
+// 1) Malicious markup in an output line must be escaped, not left raw.
+var malicious = '<script>alert(1)</script>';
+var result = reinsertOutputLines('placeholder', [malicious]);
+assert.ok(
+	result.indexOf('<script>') === -1,
+	'output line markup must be escaped (no raw <script> tag)'
+);
+assert.ok(
+	result.indexOf('&lt;script') !== -1,
+	'output line "<" must be encoded as "&lt;"'
+);
+
+// 2) Ampersands are escaped as well (double-encoding safety).
+assert.strictEqual(Prism.util.encode('a & b'), 'a &amp; b');
+
+// 3) Benign output text is preserved unchanged.
+assert.strictEqual(
+	reinsertOutputLines('x', ['plain output']),
+	'plain output'
+);
+
+console.log('CVE-2022-23647 regression test passed.');
