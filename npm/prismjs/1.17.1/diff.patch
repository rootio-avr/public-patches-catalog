diff --git a/tests/cve-2021-32723.test.js b/tests/cve-2021-32723.test.js
new file mode 100644
index 0000000..9874d5d
--- /dev/null
+++ b/tests/cve-2021-32723.test.js
@@ -0,0 +1,68 @@
+"use strict";
+
+// Regression test for CVE-2021-32723 (PrismJS ReDoS).
+//
+// The `asciidoc`/`adoc` and `perl` grammars contained regular expressions that
+// were vulnerable to exponential backtracking (ReDoS). Upstream fix
+// d85e30da6755fdbe7f8559f8e75d122297167018 tightened the character classes:
+//   - asciidoc: `[^\]\\"]`      -> `[^\]\\"']`  (attributes / inline patterns)
+//   - perl:     `[\w$]+)+`      -> `[\w$]+(?![\w$]))+`  (variable pattern)
+//
+// Upstream validated this via the exhaustive `tests/pattern-tests.js` harness,
+// which is not shipped in this target version. This replacement test grounds on
+// the same behavior: feeding a crafted attack string must tokenize quickly
+// instead of hanging (catastrophic backtracking).
+
+const { expect } = require("chai");
+const PrismLoader = require("./helper/prism-loader");
+
+/**
+ * Tokenizes `code` with the given language and asserts it completes well under
+ * a ReDoS-indicative time budget. On the vulnerable grammars these inputs take
+ * seconds-to-minutes; on the fixed grammars they complete in milliseconds.
+ *
+ * @param {string} language
+ * @param {string} code
+ */
+function expectFastTokenize(language, code) {
+	const Prism = PrismLoader.createInstance(language);
+	const start = Date.now();
+	Prism.tokenize(code, Prism.languages[language]);
+	const elapsed = Date.now() - start;
+	expect(elapsed, `${language} tokenize took ${elapsed}ms`).to.be.below(2000);
+}
+
+describe("CVE-2021-32723 - ReDoS in asciidoc and perl grammars", function () {
+	this.timeout(10000);
+
+	it("asciidoc should not backtrack exponentially on attribute-like input", function () {
+		// A long run of chars that used to be swallowed by `[^\]\\"]` inside the
+		// unterminated `[ ... ]` attribute construct.
+		const attack = "[" + '"'.repeat(0) + "a".repeat(60000);
+		expectFastTokenize("asciidoc", attack);
+	});
+
+	it("asciidoc should not backtrack exponentially on inline quote input", function () {
+		const attack = "\n" + "[" + "'".repeat(1) + "a".repeat(50000);
+		expectFastTokenize("asciidoc", attack);
+	});
+
+	it("perl should not backtrack exponentially on variable-like input", function () {
+		// The old `(?:...[\w$]+)+` allowed the engine to split a long word run in
+		// exponentially many ways when the overall match ultimately failed.
+		const attack = "$" + "a".repeat(60000) + "::::!";
+		expectFastTokenize("perl", attack);
+	});
+
+	it("asciidoc still tokenizes a normal attribute list", function () {
+		const Prism = PrismLoader.createInstance("asciidoc");
+		const tokens = Prism.tokenize('[source,ruby]', Prism.languages.asciidoc);
+		expect(tokens).to.be.an("array");
+	});
+
+	it("perl still tokenizes a normal variable", function () {
+		const Prism = PrismLoader.createInstance("perl");
+		const tokens = Prism.tokenize("$foo::bar", Prism.languages.perl);
+		expect(tokens).to.be.an("array");
+	});
+});

