+"use strict";
+
+// Regression test for CVE-2021-23341 (ReDoS in several PrismJS grammars).
+//
+// PrismJS < 1.23.0 shipped a number of grammar patterns whose regexes were
+// vulnerable to catastrophic backtracking (CWE-400, Uncontrolled Resource
+// Consumption). Fix commit c2f6a64 (PR #2584, "Fixed multiple cases of
+// vulnerable regexes") tightened those patterns so that adversarial input can
+// no longer cause exponential / super-linear matching time.
+//
+// The inputs below were verified to hang (multiple seconds to effectively
+// forever) when tokenized by the unpatched 1.17.1 grammars, and to complete in
+// single-digit milliseconds once the fix commit's regex tightenings are applied:
+//
+//   - eiffel  "% ".repeat(N)  drives the vulnerable single-line-string pattern
+//             /"(?:%\s*\n\s*%|%.|[^%"\r\n])*"/  into exponential backtracking
+//             (the fix replaces the ambiguous "%\s*\n\s*%" / "%." alternation
+//             with "%(?:(?!\n)\s)*\n\s*%|%\S").
+//   - rest    a partial grid-table header drives the vulnerable table pattern
+//             /(\s*)(?:\+[=-]+)+\+.../  into catastrophic backtracking via the
+//             nested "(?:\1(?:[+|].+)+[+|]...)+" group (the fix removes the
+//             nested "+" quantifier).
+//
+// The test asserts each completes within a small time budget; on the vulnerable
+// code these blow far past it, on the patched code they finish in a few ms.
+
+const { assert } = require("chai");
+const PrismLoader = require("./helper/prism-loader");
+
+// The patched grammars finish these in single-digit milliseconds; the
+// vulnerable grammars take seconds-to-forever. 1s is a safe separating budget.
+const TIME_BUDGET_MS = 1000;
+
+/**
+ * Tokenize `code` in language `lang` and return elapsed wall-clock time (ms).
+ * @param {string} lang
+ * @param {string} code
+ * @returns {number}
+ */
+function timeTokenize(lang, code) {
+	const Prism = PrismLoader.createInstance(lang);
+	const start = Date.now();
+	Prism.tokenize(code, Prism.languages[lang]);
+	return Date.now() - start;
+}
+
+describe("CVE-2021-23341 - ReDoS in PrismJS grammars", function () {
+	// Give mocha headroom so an unpatched build fails via the assertion below
+	// rather than via a mocha timeout.
+	this.timeout(30000);
+
+	const cases = [
+		// eiffel single-line string: exponential on "% " runs
+		["eiffel", '"' + "% ".repeat(40)],
+		// rest grid table: catastrophic on a partial "+-+" table body
+		["rest", "+-+\n" + "|x".repeat(40)],
+	];
+
+	cases.forEach(function (entry) {
+		const lang = entry[0];
+		const evil = entry[1];
+		it(lang + " tokenizes adversarial input within the time budget", function () {
+			const elapsed = timeTokenize(lang, evil);
+			assert.isBelow(
+				elapsed,
+				TIME_BUDGET_MS,
+				lang + " tokenization took " + elapsed + "ms (possible ReDoS)"
+			);
+		});
+	});
+
+	it("still tokenizes benign eiffel input correctly", function () {
+		const Prism = PrismLoader.createInstance("eiffel");
+		const tokens = Prism.tokenize('"hello"', Prism.languages.eiffel);
+		assert.isArray(tokens);
+		assert.isNotEmpty(tokens);
+	});
+});

