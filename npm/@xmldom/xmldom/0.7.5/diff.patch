+'use strict'
+
+const { DOMParser } = require('../lib')
+
+describe('CVE-2022-37616: prototype properties must not be used', () => {
+	const KEY = 'xmldomPolluted'
+	const URI = 'urn:xmldom:polluted'
+
+	afterEach(() => {
+		delete Object.prototype[KEY]
+	})
+
+	it('lookupNamespaceURI ignores inherited properties of the namespace map', () => {
+		const doc = new DOMParser().parseFromString('<a xmlns:x="urn:x"><b/></a>', 'text/xml')
+		Object.prototype[KEY] = URI
+		const b = doc.documentElement.firstChild
+		expect(b.lookupNamespaceURI('x')).toBe('urn:x')
+		expect(b.lookupNamespaceURI(KEY)).toBeNull()
+	})
+
+	it('lookupPrefix ignores inherited properties of the namespace map', () => {
+		const doc = new DOMParser().parseFromString('<a xmlns:x="urn:x"><b/></a>', 'text/xml')
+		Object.prototype[KEY] = URI
+		const b = doc.documentElement.firstChild
+		expect(b.lookupPrefix('urn:x')).toBe('x')
+		expect(b.lookupPrefix(URI)).toBeNull()
+	})
+
+	it('cloneNode and parsing keep working with a polluted Object.prototype', () => {
+		Object.prototype[KEY] = URI
+		const doc = new DOMParser().parseFromString('<a xmlns:x="urn:x" y="1"><x:b/></a>', 'text/xml')
+		const clone = doc.documentElement.cloneNode(true)
+		expect(clone.tagName).toBe('a')
+		expect(clone.getAttribute('y')).toBe('1')
+		expect(Object.prototype.hasOwnProperty.call(clone, KEY)).toBe(false)
+		expect(clone.firstChild.tagName).toBe('x:b')
+	})
+})

