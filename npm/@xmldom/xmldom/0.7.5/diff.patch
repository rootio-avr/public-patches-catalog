+'use strict'
+
+var DOMParser = require('../lib').DOMParser
+var XMLSerializer = require('../lib').XMLSerializer
+
+describe('CVE-2026-34601: CDATA section serialization must not allow XML injection', function () {
+	var payload = 'x]]><evil/>'
+
+	function buildDocument() {
+		var doc = new DOMParser().parseFromString('<r/>', 'text/xml')
+		var cdata = doc.createCDATASection('safe')
+		// bypass the createCDATASection check to simulate a tampered node
+		cdata.data = payload
+		doc.documentElement.appendChild(cdata)
+		return doc
+	}
+
+	it('createCDATASection rejects data containing "]]>"', function () {
+		var doc = new DOMParser().parseFromString('<r/>', 'text/xml')
+		expect(function () {
+			doc.createCDATASection('a]]>b')
+		}).toThrow()
+	})
+
+	it('splits "]]>" so serialized CDATA content cannot escape the section', function () {
+		var doc = buildDocument()
+		var xml = new XMLSerializer().serializeToString(doc)
+		expect(xml).toBe('<r><![CDATA[x]]]]><![CDATA[><evil/>]]></r>')
+		var reparsed = new DOMParser().parseFromString(xml, 'text/xml')
+		expect(reparsed.getElementsByTagName('evil').length).toBe(0)
+		expect(reparsed.documentElement.textContent).toBe(payload)
+	})
+
+	it('throws with requireWellFormed when CDATA data contains "]]>"', function () {
+		var doc = buildDocument()
+		expect(function () {
+			new XMLSerializer().serializeToString(doc, false, undefined, { requireWellFormed: true })
+		}).toThrow()
+	})
+
+	it('serializes well-formed CDATA unchanged, with and without requireWellFormed', function () {
+		var doc = new DOMParser().parseFromString('<r/>', 'text/xml')
+		doc.documentElement.appendChild(doc.createCDATASection('plain <data>'))
+		var expected = '<r><![CDATA[plain <data>]]></r>'
+		expect(new XMLSerializer().serializeToString(doc)).toBe(expected)
+		expect(new XMLSerializer().serializeToString(doc, false, undefined, { requireWellFormed: true })).toBe(expected)
+	})
+})

