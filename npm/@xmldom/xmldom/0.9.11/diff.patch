From 7ced40c06c28d151e996a97045018c3559ae4707 Mon Sep 17 00:00:00 2001
From: karfau <christian.bewernitz@bettermarks.com>
Date: Mon, 17 Aug 2026 23:02:55 +0200
Subject: [PATCH] CVE-2026-83612: case-insensitive HTML raw-text closing-tag match (upstream 7ced40c)
 case-insensitive close-tag match (GHSA-6mj3-qw4j-hgrw)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`parseHtmlSpecialContent` located a raw-text element's closing tag with a
case-sensitive `indexOf`, so a mixed-case close tag (e.g. `</ScRiPt>` for `<script>`)
returned -1; `substring(N, -1)` then back-captured the whole source from position 0,
and repeated raw-text elements re-emitted all prior markup, amplifying serialized
output quadratically (~501x at 1000 elements). The closing tag is now matched
case-insensitively (WHATWG HTML §13.2.5.14), scanning forward from the element start
so cost stays linear, and a missing closing tag is handled explicitly rather than
proceeding with a -1 slice. Valid raw-text parsing is byte-identical. Only 0.9.x is
affected; `release-0.8.x` uses a different path.

https://github.com/xmldom/xmldom/security/advisories/GHSA-6mj3-qw4j-hgrw
---
 lib/sax.js | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/lib/sax.js b/lib/sax.js
index 5569afe..49f507d 100644
--- a/lib/sax.js
+++ b/lib/sax.js
@@ -576,7 +576,22 @@ function parseHtmlSpecialContent(source, elStartEnd, tagName, entityReplacer, do
 	// TODO: https://html.spec.whatwg.org/#cdata-rcdata-restrictions
 	var isEscapableRaw = isHTMLEscapableRawTextElement(tagName);
 	if (isEscapableRaw || isHTMLRawTextElement(tagName)) {
-		var elEndStart = source.indexOf('</' + tagName + '>', elStartEnd);
+		// The closing tag of a raw-text element matches case-insensitively
+		// (WHATWG HTML §13.2.5.14 RAWTEXT end tag name state). A case-sensitive
+		// search that missed the closing tag would return -1 and the `substring`
+		// below would treat -1 as a backward slice from position 0, re-emitting all
+		// prior source and amplifying output quadratically across repeated elements.
+		// The regex is anchored to `elStartEnd` via `lastIndex` so it scans forward
+		// only (O(distance), not the whole source).
+		var closeTag = new RegExp('</' + tagName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '>', 'ig');
+		closeTag.lastIndex = elStartEnd;
+		var match = closeTag.exec(source);
+		var elEndStart = match ? match.index : -1;
+		if (elEndStart < 0) {
+			// No closing tag: never slice with a -1 end index. Leave the element to
+			// the parse loop's normal recovery instead of back-capturing the source.
+			return elStartEnd + 1;
+		}
 		var text = source.substring(elStartEnd + 1, elEndStart);
 
 		if (isEscapableRaw) {
