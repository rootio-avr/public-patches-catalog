From dabffe884e864eeecb1f515c716f875e1bc47ec1 Mon Sep 17 00:00:00 2001
From: karfau <christian.bewernitz@bettermarks.com>
Date: Mon, 17 Aug 2026 22:37:05 +0200
Subject: [PATCH] CVE-2026-83615: inherit namespace maps via Object.create to avoid O(N^2) memory (upstream dabffe8)
 prototype-chain inheritance (GHSA-965w-775f-mr7g)

`appendElement` derived each namespaced scope's in-scope map with a flat `_copy` of
the parent map, so a document nesting N scopes retained sum(1..N) = O(N^2) namespace
entries at peak during parse and could exhaust the heap from a small crafted input.
The child scope's map is now created with `Object.create(currentNSMap)`, inheriting
ancestor prefixes through the prototype chain so peak retention is O(N). Namespace
resolution is unchanged, and `localNSMap` remains a flat own-only record of the
prefixes declared at each element, so `endPrefixMapping` still reports only local
declarations. Serialized output is byte-identical.

https://github.com/xmldom/xmldom/security/advisories/GHSA-965w-775f-mr7g
---
 lib/sax.js | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/lib/sax.js b/lib/sax.js
index 678b227..5569afe 100644
--- a/lib/sax.js
+++ b/lib/sax.js
@@ -513,7 +513,13 @@ function appendElement(el, domBuilder, currentNSMap) {
 			//hack!!
 			if (localNSMap == null) {
 				localNSMap = Object.create(null);
-				_copy(currentNSMap, (currentNSMap = Object.create(null)));
+				// Derive the child scope's namespace map by prototype-chain inheritance
+				// instead of a flat copy: lookups inherit ancestor prefixes transparently,
+				// so a document nesting N scopes retains O(N) map entries rather than
+				// sum(1..N) = O(N^2). `localNSMap` stays a flat own-only record of the
+				// prefixes declared at THIS element, so own-property enumeration
+				// (endPrefixMapping below) still reports only local declarations.
+				currentNSMap = Object.create(currentNSMap);
 			}
 			currentNSMap[nsPrefix] = localNSMap[nsPrefix] = value;
 			a.uri = NAMESPACE.XMLNS;
-- 
