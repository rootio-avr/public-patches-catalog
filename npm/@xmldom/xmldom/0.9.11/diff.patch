From 7b2ec67e1750daadd0bb06c92e875e726544a362 Mon Sep 17 00:00:00 2001
From: karfau <christian.bewernitz@bettermarks.com>
Date: Fri, 21 Aug 2026 07:46:53 +0200
Subject: [PATCH] CVE-2026-83609: drop reg() multiline flag so Name/QName validators match the whole string (upstream 7b2ec67)
 dropping the reg() m flag (GHSA-jxjr-3g7g-3944, GHSA-vr34-hp96-76pp,
 GHSA-3px3-54cx-rmw9, GHSA-6h8r-xr42-gp59)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The shared `reg()` builder in `lib/grammar.js` compiled every anchored production with the `m` (multiline) flag, so a `^…$` production used as a full-string `.test()` validator matched any single line of its input. A name or id carrying an ECMAScript `LineTerminator` (U+000A, U+000D, U+2028, U+2029) passed as long as its first line conformed, letting arbitrary trailing markup through. Dropping `m` makes `QName_exact`, `Name_exact`, `NCName_exact`, `PubidLiteral_match` and `SystemLiteral_match` anchor the whole string: `serializeToString` with `requireWellFormed: true` throws `InvalidStateError` for an element or attribute name, or a DocType `publicId`/`systemId`, containing a line terminator, and `createElementNS`, `createAttributeNS`, `createDocumentType` and `createAttribute` throw `InvalidCharacterError` at creation. With `m` gone the strict end-tag matcher in `lib/sax.js` would reject the previously-tolerated post-line-break residue, so end-tag handling becomes mode-aware: a valid end-tag name followed by a line break and trailing content (`</a\njunk>`) now emits a recoverable `error` in XML and a `warning` in HTML and recovers to byte-identical output, while already-fatal residue and invalid names still `fatalError`. The recoverable arm rebuilds the strict matcher with `m` inline, only on the error path, so clean documents never construct it; a code comment notes it is removed in the next breaking release.

https://github.com/xmldom/xmldom/security/advisories/GHSA-jxjr-3g7g-3944
https://github.com/xmldom/xmldom/security/advisories/GHSA-vr34-hp96-76pp
https://github.com/xmldom/xmldom/security/advisories/GHSA-3px3-54cx-rmw9
https://github.com/xmldom/xmldom/security/advisories/GHSA-6h8r-xr42-gp59
---
 lib/grammar.js |  2 +-
 lib/sax.js     | 22 ++++++++++++++++++++--
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/lib/grammar.js b/lib/grammar.js
index f26f6f3..01bf0a3 100644
--- a/lib/grammar.js
+++ b/lib/grammar.js
@@ -79,7 +79,7 @@ function reg(args) {
 				return isStr ? part : part.source;
 			})
 			.join(''),
-		UNICODE_SUPPORT ? 'mu' : 'm'
+		UNICODE_SUPPORT ? 'u' : ''
 	);
 }
 
diff --git a/lib/sax.js b/lib/sax.js
index 916c010..678b227 100644
--- a/lib/sax.js
+++ b/lib/sax.js
@@ -152,9 +152,27 @@ function parse(source, defaultNSMapCopy, entityMap, domBuilder, errorHandler) {
 					if (!tagNameRaw) {
 						return errorHandler.fatalError('end tag name missing');
 					}
-					var tagNameMatch = end > 0 && g.reg('^', g.QName_group, g.S_OPT, '$').exec(tagNameRaw);
+					var endTagNameStrict = g.reg('^', g.QName_group, g.S_OPT, '$');
+					var tagNameMatch = end > 0 && endTagNameStrict.exec(tagNameRaw);
 					if (!tagNameMatch) {
-						return errorHandler.fatalError('end tag name contains invalid characters: "' + tagNameRaw + '"');
+						var leadingTagNameMatch = end > 0 && g.reg('^', g.QName_group).exec(tagNameRaw);
+						if (isHTML && leadingTagNameMatch) {
+							errorHandler.warning('end tag name contains invalid trailing characters: "' + tagNameRaw + '"');
+							tagNameMatch = leadingTagNameMatch;
+						} else if (
+							// Backward compatibility, remove this whole `else if` arm in the next breaking release
