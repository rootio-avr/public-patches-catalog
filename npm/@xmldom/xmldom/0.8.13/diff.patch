+			// step bounded. The candidate scanned so far is reported raw, consistent with
+			// the sibling invalid-tag-name throw below.
+			throw new Error('unexpected < in tag name: ' + source.slice(start, p));
+		}
 		switch(c){
 		case '=':
 			if(s === S_ATTR){//attrName
