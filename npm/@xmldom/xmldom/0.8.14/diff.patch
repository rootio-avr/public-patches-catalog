--- /dev/null
+++ b/test/cve-2026-83613.test.js
@@ -0,0 +1,69 @@
+'use strict'
+
+const { describe, test, expect } = require('@jest/globals')
+const { DOMParser } = require('../lib')
+
+/**
+ * Regression test for CVE-2026-83613 / GHSA-8344-3jmq-59r6.
+ *
+ * Parsing a well-formed element carrying M distinct attributes funnelled each
+ * attribute through NamedNodeMap#setNamedItem, which resolved an existing
+ * attribute with the same nodeName by scanning the whole list, costing
+ * 1+2+...+M = O(M^2). The fix maintains a null-prototype membership index so
+ * each insert is O(1) and building the element is O(M).
+ */
+
+/**
+ * Returns the fastest wall-clock (ms) of `runs` executions of `fn` — the
+ * minimum is the least noise-inflated sample, so a growth ratio built from two
+ * such measurements is stable across fast and slow hosts.
+ */
+function fastestMs(fn, runs) {
+	var best = Infinity
+	for (var k = 0; k < runs; k++) {
+		var t = process.hrtime.bigint()
+		fn()
+		var d = Number(process.hrtime.bigint() - t) / 1e6
+		if (d < best) best = d
+	}
+	return best
+}
+
+function attrBomb(m) {
+	var parts = new Array(m)
+	for (var i = 0; i < m; i++) parts[i] = 'a' + i + '="x"'
+	return '<r ' + parts.join(' ') + '/>'
+}
+
+describe('CVE-2026-83613 quadratic attribute de-duplication during parse', () => {
+	// Growth ratio over a 4x increase in M: quadratic ~16x, linear ~4x. A
+	// threshold of 8 (the log-space midpoint) separates the two with headroom.
+	const M1 = 4000
+	const M2 = 16000 // 4x M1
+	const RATIO_MAX = 8
+
+	test('an element with many distinct attributes de-duplicates in sub-quadratic time', () => {
+		const xml1 = attrBomb(M1)
+		const xml2 = attrBomb(M2)
+		const t1 = fastestMs(() => new DOMParser().parseFromString(xml1, 'text/xml'), 5)
+		const t2 = fastestMs(() => new DOMParser().parseFromString(xml2, 'text/xml'), 5)
+		expect(t2 / t1).toBeLessThan(RATIO_MAX)
+	})
+
+	test('all distinct attributes are preserved in order', () => {
+		const doc = new DOMParser().parseFromString(attrBomb(50), 'text/xml')
+		const el = doc.documentElement
+		expect(el.attributes.length).toBe(50)
+		for (var i = 0; i < 50; i++) {
+			expect(el.getAttribute('a' + i)).toBe('x')
+		}
+	})
+
+	test('an attribute named __proto__ is treated as an ordinary key', () => {
+		const doc = new DOMParser().parseFromString('<r __proto__="polluted" x="ok"/>', 'text/xml')
+		const el = doc.documentElement
+		expect(el.getAttribute('__proto__')).toBe('polluted')
+		expect(el.getAttribute('x')).toBe('ok')
+		expect(el.attributes.length).toBe(2)
+	})
+})

