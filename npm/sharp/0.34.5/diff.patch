+/*!
+  Copyright 2013 Lovell Fuller and others.
+  SPDX-License-Identifier: Apache-2.0
+*/
+
+// Regression guard for GHSA-f88m-g3jw-g9cj (CWE-1395 vulnerable dependency).
+//
+// sharp 0.34.5 bundled the prebuilt libvips 8.17.3 binary (via
+// @img/sharp-libvips-* 1.2.4), which is affected by four libvips CVEs:
+//   - CVE-2026-33327  dimension integer overflow -> heap overflow
+//   - CVE-2026-33328  gifload int overflow on 32-bit platforms
+//   - CVE-2026-35590  out-of-bounds read decoding crafted EXIF
+//   - CVE-2026-35591  tiffload heap overflow on crafted tile components
+//
+// All four are fixed upstream in libvips >= 8.18.1 (this patch ships 8.18.3
+// via @img/sharp-libvips-* 1.3.2, matched to the @img/sharp-* 0.35.3 addon).
+// This test asserts the remediation invariant: the libvips binary actually
+// loaded at runtime is >= 8.18.3, and the paired native addon still decodes
+// the bundled formats (i.e. the JS<->native ABI is coherent after the bump).
+
+const { describe, it } = require('node:test');
+const assert = require('node:assert');
+const semver = require('semver');
+
+const sharp = require('../../');
+
+const FIXED_LIBVIPS = '8.18.3';
+
+describe('GHSA-f88m-g3jw-g9cj: bundled libvips is patched', () => {
+  it('exposes a valid libvips version', () => {
+    assert.strictEqual('string', typeof sharp.versions.vips);
+    assert.notStrictEqual(null, semver.valid(sharp.versions.vips));
+  });
+
+  it('bundled libvips is >= 8.18.3 (fixed for all four CVEs)', () => {
+    assert.strictEqual(
+      true,
+      semver.gte(sharp.versions.vips, FIXED_LIBVIPS),
+      `expected bundled libvips >= ${FIXED_LIBVIPS}, found ${sharp.versions.vips} ` +
+      '(still vulnerable to CVE-2026-33327/33328/35590/35591)'
+    );
+  });
+
+  it('patched native binary still decodes a small GIF (ABI coherent)', () =>
+    sharp({
+      create: { width: 8, height: 8, channels: 3, background: { r: 1, g: 2, b: 3 } }
+    })
+      .gif()
+      .toBuffer()
+      .then((gif) => sharp(gif).metadata())
+      .then((metadata) => {
+        assert.strictEqual('gif', metadata.format);
+        assert.strictEqual(8, metadata.width);
+        assert.strictEqual(8, metadata.height);
+      }));
+});
