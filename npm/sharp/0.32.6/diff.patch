+// Copyright 2013 Lovell Fuller and others.
+// SPDX-License-Identifier: Apache-2.0
+
+'use strict';
+
+const assert = require('assert');
+
+const sharp = require('../../');
+const { inputAvif, inputJpg } = require('../fixtures');
+
+// Regression test for GHSA-rgj7-g3m4-5g8c (CWE-122).
+//
+// The prebuilt libvips binaries bundled with sharp 0.32.6 include a version of
+// libheif vulnerable to a heap-based buffer overflow when decoding untrusted
+// HEIF/AVIF input, which can lead to remote code execution. The applied
+// mitigation blocks the vulnerable VipsForeignLoadHeif decoder at module load,
+// so any attempt to decode HEIF/AVIF input must be rejected before the
+// vulnerable native code path is reached.
+describe('GHSA-rgj7-g3m4-5g8c: HEIF/AVIF decoder blocked by default', () => {
+  it('rejects decoding of untrusted AVIF/HEIF input', async () => {
+    await assert.rejects(
+      () => sharp(inputAvif).toBuffer(),
+      /VipsForeignLoadHeif|blocked|operation is blocked/i
+    );
+  });
+
+  it('still allows unaffected formats such as JPEG to be decoded', async () => {
+    const metadata = await sharp(inputJpg).metadata();
+    assert.strictEqual(metadata.format, 'jpeg');
+  });
+
+  it('allows callers to explicitly opt back in via unblock', async () => {
+    // Opting back in must not throw synchronously; downstream decode behaviour
+    // then depends on the (still vulnerable) native library, so re-block after.
+    assert.doesNotThrow(() => {
+      sharp.unblock({ operation: ['VipsForeignLoadHeif'] });
+      sharp.block({ operation: ['VipsForeignLoadHeif'] });
+    });
+  });
+});
