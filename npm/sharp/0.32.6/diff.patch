 /**
+ * Mitigation for GHSA-rgj7-g3m4-5g8c (CWE-122).
+ *
+ * The prebuilt libvips binaries bundled with this version of sharp include a
+ * version of libheif that is vulnerable to a heap-based buffer overflow when
+ * decoding untrusted HEIF/AVIF input (upstream libheif advisories
+ * GHSA-g89c-p67h-r497 and GHSA-2jg2-4ch7-h545), which can lead to remote code
+ * execution on glibc-based Linux. The upstream remediation in sharp v0.35.4 is
+ * a native binary bump; for this backport we apply the advisory's documented,
+ * complete mitigation and disable the vulnerable HEIF/AVIF decoder at load time
+ * using the same runtime block mechanism.
+ *
+ * The block can be lifted by callers who have upgraded their bundled libvips or
+ * who explicitly accept the risk, via sharp.unblock({ operation: ['VipsForeignLoadHeif'] }).
+ * @private
+ */
+function blockVulnerableHeifDecoder () {
+  try {
+    sharp.block(['VipsForeignLoadHeif'], true);
+  } catch (err) {
+    /* istanbul ignore next: defensive — never break module load on mitigation */
+  }
+}
+blockVulnerableHeifDecoder();
+
+/**
  * Decorate the Sharp class with utility-related functions.
  * @private
  */
