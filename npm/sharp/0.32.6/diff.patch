+// Copyright 2013 Lovell Fuller and others.
+// SPDX-License-Identifier: Apache-2.0
+
+'use strict';
+
+const assert = require('assert');
+const semver = require('semver');
+
+const libvips = require('../../lib/libvips');
+const { config } = require('../../package.json');
+
+// Regression test for GHSA-f88m-g3jw-g9cj.
+//
+// The advisory bundles four libvips decoder overflow/validation fixes
+// (CVE-2026-33327 dimension overflow, CVE-2026-33328 gifload int overflow,
+// CVE-2026-35591 tiffload component validation, CVE-2026-35590 EXIF ifdN
+// validation). sharp itself ships no vulnerable JS/native source for this
+// advisory; the fix is a bump of the bundled libvips dependency from the
+// vulnerable 8.14.5 to the patched >=8.18.3, first shipped upstream in
+// sharp v0.35.0 (package.json config.libvips: "8.14.5" -> ">=8.18.3").
+//
+// This test pins that remediation: the minimum libvips version sharp
+// requires/accepts must be at least 8.18.3 so no vulnerable 8.14.x build
+// is treated as acceptable.
+describe('GHSA-f88m-g3jw-g9cj libvips version pin', function () {
+  const patchedFloor = '8.18.3';
+
+  it('package.json config.libvips no longer pins vulnerable 8.14.5', function () {
+    assert.notStrictEqual(config.libvips, '8.14.5');
+  });
+
+  it('configured libvips constraint requires at least the patched 8.18.3', function () {
+    // config.libvips may be an exact version ("8.18.3") or a range (">=8.18.3").
+    const labelled = config.libvips;
+    const coerced = semver.coerce(labelled);
+    assert.notStrictEqual(coerced, null);
+    assert.strictEqual(
+      semver.gte(coerced.version, patchedFloor),
+      true,
+      `expected libvips constraint "${labelled}" to require >= ${patchedFloor}`
+    );
+  });
+
+  it('resolved minimumLibvipsVersion is at least the patched 8.18.3', function () {
+    const minimumLibvipsVersion = libvips.minimumLibvipsVersion;
+    assert.strictEqual('string', typeof minimumLibvipsVersion);
+    assert.notStrictEqual(null, semver.valid(minimumLibvipsVersion));
+    assert.strictEqual(
+      semver.gte(minimumLibvipsVersion, patchedFloor),
+      true,
+      `expected minimumLibvipsVersion "${minimumLibvipsVersion}" to be >= ${patchedFloor}`
+    );
+  });
+
+  it('a vulnerable 8.14.5 libvips is below the enforced minimum', function () {
+    assert.strictEqual(
+      semver.lt('8.14.5', libvips.minimumLibvipsVersion),
+      true,
+      'vulnerable libvips 8.14.5 must be below the enforced minimum'
+    );
+  });
+});

