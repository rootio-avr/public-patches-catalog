+/*!
+  Copyright 2013 Lovell Fuller and others.
+  SPDX-License-Identifier: Apache-2.0
+*/
+
+'use strict';
+
+// Regression test for GHSA-rgj7-g3m4-5g8c.
+//
+// The vulnerability is a heap-buffer-overflow in libheif (advisories
+// GHSA-g89c-p67h-r497 / GHSA-2jg2-4ch7-h545) reachable through the libvips
+// bundled by sharp's prebuilt native dependencies. Upstream sharp v0.35.4
+// remediated it purely by bumping those native dependencies:
+//   - @img/sharp-libvips-* -> 1.3.3 (bundles patched libheif 1.23.2)
+//   - @img/sharp-* prebuilt binaries -> 0.35.4
+//   - config.libvips compile guard -> >=8.18.6
+//
+// This test guards against a regression of those pins to the vulnerable
+// versions.
+
+const { suite, test } = require('node:test');
+
+const semver = require('semver');
+const pkg = require('../../package.json');
+
+const MIN_LIBVIPS_PREBUILT = '1.3.3';
+const MIN_LIBVIPS_CONFIG = '8.18.6';
+
+suite('GHSA-rgj7-g3m4-5g8c (libheif heap-buffer-overflow)', () => {
+  test('bundled @img/sharp-libvips-* prebuilts are >= 1.3.3', (t) => {
+    const optional = pkg.optionalDependencies || {};
+    const libvipsDeps = Object.keys(optional).filter((name) =>
+      name.startsWith('@img/sharp-libvips-'));
+    t.assert.ok(libvipsDeps.length > 0, 'expected @img/sharp-libvips-* deps');
+    for (const name of libvipsDeps) {
+      const version = semver.coerce(optional[name]).version;
+      t.assert.ok(
+        semver.gte(version, MIN_LIBVIPS_PREBUILT),
+        `${name} pinned to ${optional[name]}, must be >= ${MIN_LIBVIPS_PREBUILT}`
+      );
+    }
+  });
+
+  test('@img/sharp-libvips-dev build deps are >= 1.3.3', (t) => {
+    const dev = pkg.devDependencies || {};
+    const devLibvips = Object.keys(dev).filter((name) =>
+      name.startsWith('@img/sharp-libvips-'));
+    t.assert.ok(devLibvips.length > 0, 'expected @img/sharp-libvips-* dev deps');
+    for (const name of devLibvips) {
+      const version = semver.coerce(dev[name]).version;
+      t.assert.ok(
+        semver.gte(version, MIN_LIBVIPS_PREBUILT),
+        `${name} pinned to ${dev[name]}, must be >= ${MIN_LIBVIPS_PREBUILT}`
+      );
+    }
+  });
+
+  test('config.libvips compile guard is >= 8.18.6', (t) => {
+    t.plan(2);
+    const configured = semver.coerce(pkg.config.libvips).version;
+    t.assert.ok(configured, 'config.libvips should be a valid semver range');
+    t.assert.ok(
+      semver.gte(configured, MIN_LIBVIPS_CONFIG),
+      `config.libvips is ${pkg.config.libvips}, must be >= ${MIN_LIBVIPS_CONFIG}`
+    );
+  });
+});

