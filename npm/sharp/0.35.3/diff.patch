+/*!
+  Copyright 2013 Lovell Fuller and others.
+  SPDX-License-Identifier: Apache-2.0
+*/
+
+'use strict';
+
+// Regression test for GHSA-wq5f-xc86-pv6w.
+//
+// A use-after-free in librsvg (GNOME/librsvg#1241) is reachable via an SVG
+// containing an xi:include of a data: URI that redefines an entity, triggering
+// a free of the xmlEntity during xmlCtxtParseEntity. sharp consumes librsvg
+// through the libvips bundled in the prebuilt @img/sharp-libvips-* packages.
+// Upstream remediated it in v0.35.5 by upgrading those packages to v1.3.4.
+//
+// The prebuilt @img/sharp-<platform> binaries are linked against one exact
+// libvips shared object (e.g. libvips-cpp.so.8.18.7), so they must be bumped
+// together with @img/sharp-libvips-*. Bumping only the libvips packages leaves
+// a binary that cannot load its library and sharp silently falls back to the
+// WASM build. This test guards against both regressions.
+
+const { suite, test } = require('node:test');
+
+const semver = require('semver');
+const pkg = require('../../package.json');
+
+const MIN_LIBVIPS_PREBUILT = '1.3.4';
+const MIN_BINARY_PREBUILT = '0.35.5';
+const MIN_LIBVIPS_CONFIG = '8.18.7';
+
+const pinned = (deps, re) =>
+  Object.keys(deps || {})
+    .filter((name) => re.test(name))
+    .map((name) => [name, deps[name]]);
+
+const isLibvips = /^@img\/sharp-libvips-(?!dev)/;
+const isLibvipsDev = /^@img\/sharp-libvips-dev/;
+const isBinary = /^@img\/sharp-(?!libvips)/;
+
+suite('GHSA-wq5f-xc86-pv6w (librsvg xmlEntity use-after-free)', () => {
+  test('optional @img/sharp-libvips-* prebuilts are >= 1.3.4', (t) => {
+    const entries = pinned(pkg.optionalDependencies, isLibvips);
+    t.assert.ok(entries.length > 0, 'expected @img/sharp-libvips-* optional deps');
+    for (const [name, range] of entries) {
+      t.assert.ok(
+        semver.gte(semver.coerce(range).version, MIN_LIBVIPS_PREBUILT),
+        `${name} pinned to ${range}, must be >= ${MIN_LIBVIPS_PREBUILT}`
+      );
+    }
+  });
+
+  test('dev @img/sharp-libvips-* build deps are >= 1.3.4', (t) => {
+    const entries = [
+      ...pinned(pkg.devDependencies, isLibvips),
+      ...pinned(pkg.devDependencies, isLibvipsDev)
+    ];
+    t.assert.ok(entries.length > 0, 'expected @img/sharp-libvips-* dev deps');
+    for (const [name, range] of entries) {
+      t.assert.ok(
+        semver.gte(semver.coerce(range).version, MIN_LIBVIPS_PREBUILT),
+        `${name} pinned to ${range}, must be >= ${MIN_LIBVIPS_PREBUILT}`
+      );
+    }
+  });
+
+  test('prebuilt @img/sharp-<platform> binaries are >= 0.35.5 (match libvips 1.3.4)', (t) => {
+    const entries = pinned(pkg.optionalDependencies, isBinary);
+    t.assert.ok(entries.length > 0, 'expected @img/sharp-<platform> optional deps');
+    for (const [name, range] of entries) {
+      t.assert.ok(
+        semver.gte(semver.coerce(range).version, MIN_BINARY_PREBUILT),
+        `${name} pinned to ${range}, must be >= ${MIN_BINARY_PREBUILT}`
+      );
+    }
+  });
+
+  test('config.libvips compile guard is >= 8.18.7', (t) => {
+    const configured = semver.coerce(pkg.config.libvips).version;
+    t.assert.ok(
+      semver.gte(configured, MIN_LIBVIPS_CONFIG),
+      `config.libvips is ${pkg.config.libvips}, must be >= ${MIN_LIBVIPS_CONFIG}`
+    );
+  });
+});
