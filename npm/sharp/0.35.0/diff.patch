+/*!
+  Copyright 2013 Lovell Fuller and others.
+  SPDX-License-Identifier: Apache-2.0
+*/
+
+/*
+  Regression test for GHSA-rgj7-g3m4-5g8c (CVE-2026-84383)
+
+  Heap-based buffer overflow (CWE-122) in the libheif AVIF/HEIF decoder
+  bundled by sharp via sharp-libvips. Fixed upstream in sharp v0.35.4 by
+  upgrading the vendored sharp-libvips to v1.3.3 (libvips 8.18.6 / libheif
+  1.23.2).
+
+  The vulnerable code lives entirely inside the vendored native dependency,
+  so there is no JS/C++ code path in sharp itself to exercise. This test
+  therefore guards the fix mechanism: it asserts that every vendored native
+  addon (@img/sharp-*) and libvips runtime pointer (@img/sharp-libvips-*),
+  together with the compile-time libvips version constraint, has been
+  advanced to a version that ships the patched libheif. This prevents a
+  regression that re-pins the bundled binaries back to a vulnerable version.
+*/
+
+const { suite, test } = require('node:test');
+const assert = require('node:assert');
+const path = require('node:path');
+const fs = require('node:fs');
+
+const semver = require('semver');
+
+const pkg = JSON.parse(
+  fs.readFileSync(path.join(__dirname, '..', '..', 'package.json'), 'utf8')
+);
+
+// Minimum fixed versions that bundle the patched libheif (>= 1.23.2).
+const MIN_SHARP = '0.35.4';
+const MIN_LIBVIPS_PKG = '1.3.3';
+const MIN_LIBVIPS_CONSTRAINT = '8.18.6';
+
+suite('GHSA-rgj7-g3m4-5g8c (libheif AVIF/HEIF heap overflow)', () => {
+  test('vendored @img/sharp-* native addons are at the fixed version', (t) => {
+    const deps = pkg.optionalDependencies || {};
+    const addons = Object.keys(deps).filter(
+      (name) => name.startsWith('@img/sharp-') && !name.startsWith('@img/sharp-libvips-')
+    );
+    assert.ok(addons.length > 0, 'expected @img/sharp-* native addon pointers');
+    for (const name of addons) {
+      assert.ok(
+        semver.gte(semver.coerce(deps[name]), MIN_SHARP),
+        `${name}=${deps[name]} must be >= ${MIN_SHARP} (fix ships patched libheif)`
+      );
+    }
+  });
+
+  test('vendored @img/sharp-libvips-* runtime is at the fixed version', (t) => {
+    const groups = [pkg.optionalDependencies || {}, pkg.devDependencies || {}];
+    let checked = 0;
+    for (const deps of groups) {
+      for (const name of Object.keys(deps)) {
+        if (!name.startsWith('@img/sharp-libvips-')) continue;
+        checked += 1;
+        assert.ok(
+          semver.gte(semver.coerce(deps[name]), MIN_LIBVIPS_PKG),
+          `${name}=${deps[name]} must be >= ${MIN_LIBVIPS_PKG} (libvips 8.18.6 / libheif 1.23.2)`
+        );
+      }
+    }
+    assert.ok(checked > 0, 'expected @img/sharp-libvips-* runtime pointers');
+  });
+
+  test('config.libvips constraint requires the patched libvips', (t) => {
+    const constraint = pkg.config && pkg.config.libvips;
+    assert.ok(constraint, 'expected package.json config.libvips constraint');
+    const min = semver.coerce(constraint.replace(/^[^0-9]*/, ''));
+    assert.ok(
+      semver.gte(min, MIN_LIBVIPS_CONSTRAINT),
+      `config.libvips=${constraint} must require >= ${MIN_LIBVIPS_CONSTRAINT}`
+    );
+  });
+});
