+// Regression tests for CVE-2024-29415: isPrivate()/isPublic()/isLoopback()
+// must not be bypassed with non-canonical IPv4 notations or IPv6 spellings.
+var assert = require('assert');
+var ip = require('../lib/ip');
+
+var cases = {
+  'normalizeToLong handles every IPv4 notation': function () {
+    assert.equal(ip.normalizeToLong('127.0.0.1'), 2130706433);
+    assert.equal(ip.normalizeToLong('127.1'), 2130706433);
+    assert.equal(ip.normalizeToLong('127.0.1'), 2130706433);
+    assert.equal(ip.normalizeToLong('0x7f.0x0.0x0.0x1'), 2130706433);
+    assert.equal(ip.normalizeToLong('0x7f000001'), 2130706433);
+    assert.equal(ip.normalizeToLong('017700000001'), 2130706433);
+    assert.equal(ip.normalizeToLong('2130706433'), 2130706433);
+    assert.equal(ip.normalizeToLong('010.0.0.01'), 134217729);
+  },
+  'normalizeToLong rejects malformed input': function () {
+    assert.equal(ip.normalizeToLong('256.100.50.25'), -1);
+    assert.equal(ip.normalizeToLong('019.0.0.1'), -1);
+    assert.equal(ip.normalizeToLong('0xGG.0.0.1'), -1);
+    assert.equal(ip.normalizeToLong('0x7fzz.0.0.1'), -1);
+    assert.equal(ip.normalizeToLong(''), -1);
+    assert.equal(ip.normalizeToLong('192.168.0.1.100'), -1);
+    assert.equal(ip.normalizeToLong('4294967297'), -1);
+  },
+  'isPrivate detects non-canonical loopback/private IPv4': function () {
+    assert.equal(ip.isPrivate('0'), true);
+    assert.equal(ip.isPrivate('0.0.0.0'), true);
+    assert.equal(ip.isPrivate('127.1'), true);
+    assert.equal(ip.isPrivate('127.0.1'), true);
+    assert.equal(ip.isPrivate('0x7f.1'), true);
+    assert.equal(ip.isPrivate('0x7f000001'), true);
+    assert.equal(ip.isPrivate('017700000001'), true);
+    assert.equal(ip.isPrivate('2130706433'), true);
+    assert.equal(ip.isPrivate('0177.0.0.1'), true);
+    assert.equal(ip.isPrivate('012.0.0.1'), true);
+    assert.equal(ip.isPrivate('3232235521'), true);
+    assert.equal(ip.isPrivate('192.168.0.1'), true);
+    assert.equal(ip.isPrivate('172.16.0.5'), true);
+    assert.equal(ip.isPrivate('169.254.2.3'), true);
+  },
+  'isPrivate detects IPv6 loopback and mapped forms': function () {
+    assert.equal(ip.isPrivate('::'), true);
+    assert.equal(ip.isPrivate('::1'), true);
+    assert.equal(ip.isPrivate('0:0:0:0:0:0:0:1'), true);
+    assert.equal(ip.isPrivate('0000:0000:0000:0000:0000:0000:0000:0001'), true);
+    assert.equal(ip.isPrivate('0::1'), true);
+    assert.equal(ip.isPrivate('::ffff:127.0.0.1'), true);
+    assert.equal(ip.isPrivate('::ffff:7f00:1'), true);
+    assert.equal(ip.isPrivate('0:0:0:0:0:ffff:7f00:1'), true);
+    assert.equal(ip.isPrivate('::FFFF:172.16.200.1'), true);
+    assert.equal(ip.isPrivate('::ffff:c0a8:1'), true);
+    assert.equal(ip.isPrivate('fe80::1'), true);
+    assert.equal(ip.isPrivate('fd12:3456:789a:1::1'), true);
+  },
+  'isPublic keeps public addresses public': function () {
+    assert.equal(ip.isPublic('8.8.8.8'), true);
+    assert.equal(ip.isPublic('134744072'), true);
+    assert.equal(ip.isPublic('::ffff:8.8.8.8'), true);
+    assert.equal(ip.isPublic('::ffff:808:808'), true);
+    assert.equal(ip.isPublic('2001:4860:4860::8888'), true);
+    assert.equal(ip.isPublic('172.32.0.5'), true);
+    assert.equal(ip.isPublic('127.0.0.1'), false);
+    assert.equal(ip.isPublic('0'), false);
+  },
+  'isLoopback detects non-canonical loopback addresses': function () {
+    assert.equal(ip.isLoopback('127.0.0.1'), true);
+    assert.equal(ip.isLoopback('127.8.8.8'), true);
+    assert.equal(ip.isLoopback('127.1'), true);
+    assert.equal(ip.isLoopback('0x7f.1'), true);
+    assert.equal(ip.isLoopback('017700000001'), true);
+    assert.equal(ip.isLoopback('2130706433'), true);
+    assert.equal(ip.isLoopback('::ffff:7f00:1'), true);
+    assert.equal(ip.isLoopback('::ffff:127.0.0.1'), true);
+    assert.equal(ip.isLoopback('0:0:0:0:0:0:0:1'), true);
+    assert.equal(ip.isLoopback('fe80::1'), true);
+    assert.equal(ip.isLoopback('::1'), true);
+    assert.equal(ip.isLoopback('8.8.8.8'), false);
+    assert.equal(ip.isLoopback('::ffff:8.8.8.8'), false);
+    assert.equal(ip.isLoopback('127.0.0.1abc'), false);
+  },
+  'isPrivate rejects malformed addresses instead of reporting public': function () {
+    assert.throws(function () { ip.isPrivate('256.1.1.1'); });
+    assert.throws(function () { ip.isPrivate('0x7fzz.1'); });
+    assert.throws(function () { ip.isPrivate('not-an-ip'); });
+    assert.throws(function () { ip.isPrivate('::ffff:999.0.0.1'); });
+    assert.throws(function () { ip.isPrivate('1:2:3'); });
+  },
+};
+
+Object.keys(cases).forEach(function (name) {
+  if (typeof it === 'function') {
+    it(name, cases[name]);
+  } else {
+    cases[name]();
+    console.log('ok - ' + name);
+  }
+});
