@@ -0,0 +1,53 @@
+// Regression test for CVE-2026-19693: a zip entry whose final path component
+// is a pre-existing symlink must NOT be written through. The malicious archive
+// contains two entries named "pwn": first a symlink pointing outside the
+// extraction directory, then a regular file with the same name. Without the
+// fix, extracting the regular "pwn" entry follows the planted symlink and
+// clobbers a file outside the target directory.
+//
+// Grounded on the upstream test 'symlink at the leaf is not written through'
+// (fix commit 148750acb10c574818906de2a99aa13d457d5329), translated to the
+// tape + callback API shipped in extract-zip 1.7.0.
+var extract = require('../')
+var fs = require('fs')
+var path = require('path')
+var temp = require('temp').track()
+var test = require('tape')
+
+// test/symlink-leaf.zip, base64-encoded. Two entries both named "pwn":
+//   1. symlink -> ../canary.txt
+//   2. regular file with body "PWNED\n"
+var SYMLINK_LEAF_ZIP_B64 =
+  'UEsDBBQAAAAAAAAAIQBS3VMqDQAAAA0AAAADAAAAcHduLi4vY2FuYXJ5LnR4dFBLAwQUAAAA' +
+  'AAAAACEAtbklTgYAAAAGAAAAAwAAAHB3blBXTkVEClBLAQIUAxQAAAAAAAAAIQBS3VMqDQAA' +
+  'AA0AAAADAAAAAAAAAAAAAAD/oQAAAABwd25QSwECFAMUAAAAAAAAACEAtbklTgYAAAAGAAAA' +
+  'AwAAAAAAAAAAAAAApIEuAAAAcHduUEsFBgAAAAACAAIAYgAAAFUAAAAAAA=='
+
+if (process.platform === 'win32') {
+  test('leaf symlink guard (skipped on win32)', function (t) {
+    t.pass('symlink semantics differ on win32')
+    t.end()
+  })
+} else {
+  test('symlink at the leaf is not written through', function (t) {
+    t.plan(3)
+
+    temp.mkdir({ prefix: 'extract-zip', suffix: 'symlink-leaf' }, function (err, parent) {
+      t.notOk(err, 'no error creating temp dir')
+
+      var dirPath = path.join(parent, 'dest')
+      fs.mkdirSync(dirPath)
+      var canary = path.join(parent, 'canary.txt')
+      fs.writeFileSync(canary, 'ORIGINAL')
+
+      var zipPath = path.join(parent, 'symlink-leaf.zip')
+      fs.writeFileSync(zipPath, Buffer.from(SYMLINK_LEAF_ZIP_B64, 'base64'))
+
+      extract(zipPath, { dir: dirPath }, function (extractErr) {
+        t.true(extractErr instanceof Error, 'extraction rejected with an error')
+        t.same(fs.readFileSync(canary, 'utf8'), 'ORIGINAL',
+          'file outside the target directory is untouched')
+      })
+    })
+  })
+}
