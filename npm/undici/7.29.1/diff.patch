+    redirectEnabled: true,
+    trustedHits: 0,
+    attackerHits: 0
+  }
+
+  const attacker = createServer((_req, res) => {
+    state.attackerHits++
+    res.writeHead(200, {
+      'cache-control': 'public, max-age=86400',
+      'content-type': 'text/plain'
+    })
+    res.end('attacker-controlled-content')
+  })
