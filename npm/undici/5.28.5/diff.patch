+'use strict'
+
+const { constants } = require('crypto')
+const { once } = require('events')
+const { readFileSync } = require('fs')
+const { join } = require('path')
+const { createServer } = require('tls')
+const { test } = require('tap')
+
+const { Client } = require('..')
+
+const fixtures = join(__dirname, 'fixtures', 'tls-renegotiation')
+const matching = {
+  key: readFileSync(join(fixtures, 'matching-key.pem')),
+  cert: readFileSync(join(fixtures, 'matching-cert.pem'))
+}
+const wrongHost = {
+  key: readFileSync(join(fixtures, 'wrong-key.pem')),
+  cert: readFileSync(join(fixtures, 'wrong-cert.pem'))
+}
+const ca = readFileSync(join(fixtures, 'ca.pem'))
+
+// A TLS certificate error emitted after the connection has been established
+// (e.g. via renegotiation) must reject the request instead of tripping an
+// assertion that crashes the process.
+test('TLS certificate errors after connection establishment reject the request', async (t) => {
+  t.plan(2)
+
+  let startRenegotiation
+  const renegotiationStarted = new Promise((resolve) => {
+    startRenegotiation = resolve
+  })
+  const sockets = new Set()
+  const server = createServer({
+    ...matching,
+    minVersion: 'TLSv1.2',
+    maxVersion: 'TLSv1.2',
+    secureOptions: constants.SSL_OP_NO_SESSION_RESUMPTION_ON_RENEGOTIATION,
+    ALPNProtocols: ['http/1.1']
+  }, (socket) => {
+    sockets.add(socket)
+    socket.on('close', () => sockets.delete(socket))
+    socket.on('error', () => {})
+    socket.once('data', () => {
+      setTimeout(() => {
+        socket.setKeyCert(wrongHost)
+        startRenegotiation(socket.renegotiate({
+          requestCert: false,
+          rejectUnauthorized: false
+        }, () => {}))
+      }, 50)
+    })
+  })
+
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+
+  const client = new Client(`https://localhost:${server.address().port}`, {
+    connect: {
+      ca,
+      minVersion: 'TLSv1.2',
+      maxVersion: 'TLSv1.2',
+      lookup (hostname, options, callback) {
+        if (options.all === true) {
+          callback(null, [{ address: '127.0.0.1', family: 4 }])
+        } else {
+          callback(null, '127.0.0.1', 4)
+        }
+      }
+    }
+  })
+
+  t.teardown(async () => {
+    await client.destroy()
+    for (const socket of sockets) {
+      socket.destroy()
+    }
+    await new Promise((resolve) => server.close(resolve))
+  })
+
+  const disconnected = once(client, 'disconnect')
+  const rejected = client.request({ path: '/', method: 'GET' }).then(
+    () => null,
+    (err) => err
+  )
+
+  t.equal(await renegotiationStarted, true)
+  const err = await rejected
+  t.equal(err && err.code, 'ERR_TLS_CERT_ALTNAME_INVALID')
+  await disconnected
+})
