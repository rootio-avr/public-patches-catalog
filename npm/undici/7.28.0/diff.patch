+function addFieldNameCacheControlDirective (output, key, fieldNames) {
+  const normalizedFieldNames = []
+
+  for (let i = 0; i < fieldNames.length; i++) {
+    const fieldName = fieldNames[i].trim()
+    if (fieldName.length !== 0) {
+      normalizedFieldNames.push(fieldName)
+    }
+  }
+
+  if (normalizedFieldNames.length === 0 || output[key] === true) {
+    output[key] = true
+  } else if (key in output) {
+    output[key] = output[key].concat(normalizedFieldNames)
+  } else {
+    output[key] = normalizedFieldNames
+  }
+}
