@@ -0,0 +1,86 @@
+'use strict'
+
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const { createServer } = require('node:http')
+const { once } = require('node:events')
+const { Agent, interceptors, cacheStores } = require('..')
+
+async function listen (server) {
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+}
+
+async function closeServer (server) {
+  server.close()
+  await once(server, 'close')
+}
+
+test('cache does not store a cross-origin redirect response under the original origin (CVE-2026-109829)', async () => {
+  const state = { redirectEnabled: true, trustedHits: 0, attackerHits: 0 }
+
+  const attacker = createServer((_req, res) => {
+    state.attackerHits++
+    res.writeHead(200, {
+      'cache-control': 'public, max-age=86400',
+      'content-type': 'text/plain'
+    })
+    res.end('attacker-controlled-content')
+  })
+
+  const trusted = createServer((req, res) => {
+    state.trustedHits++
+    if (state.redirectEnabled && req.url === '/resource') {
+      res.writeHead(302, {
+        location: `http://127.0.0.1:${attacker.address().port}/payload`,
+        'cache-control': 'no-store'
+      })
+      res.end()
+      return
+    }
+    res.writeHead(200, {
+      'cache-control': 'public, max-age=86400',
+      'content-type': 'text/plain'
+    })
+    res.end('legitimate-content')
+  })
+
+  await listen(attacker)
+  await listen(trusted)
+
+  const trustedOrigin = `http://127.0.0.1:${trusted.address().port}`
+  const agent = new Agent().compose(
+    interceptors.redirect({ maxRedirections: 2 }),
+    interceptors.cache({
+      store: new cacheStores.MemoryCacheStore(),
+      type: 'shared'
+    })
+  )
+
+  try {
+    const first = await agent.request({
+      origin: trustedOrigin,
+      path: '/resource',
+      method: 'GET',
+      headers: { cookie: 'session=mallory' }
+    })
+    assert.equal(await first.body.text(), 'attacker-controlled-content')
+
+    state.redirectEnabled = false
+    const hitsBefore = [state.trustedHits, state.attackerHits]
+    const second = await agent.request({
+      origin: trustedOrigin,
+      path: '/resource',
+      method: 'GET',
+      headers: { cookie: 'session=alice' }
+    })
+    const body = await second.body.text()
+    const hitsAfter = [state.trustedHits, state.attackerHits]
+
+    assert.equal(body, 'legitimate-content')
+    assert.notDeepEqual(hitsAfter, hitsBefore)
+  } finally {
+    await agent.close()
+    await Promise.all([closeServer(trusted), closeServer(attacker)])
+  }
+})
