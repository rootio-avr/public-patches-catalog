+'use strict'
+
+const assert = require('node:assert/strict')
+const { once } = require('node:events')
+const { createServer } = require('node:http')
+const net = require('node:net')
+const { test } = require('node:test')
+
+const { Client } = require('..')
+
+// A TLS certificate error surfacing on an already established connection
+// (e.g. after a renegotiation) must reject the in-flight request instead of
+// tripping an internal assertion and crashing the process.
+test('post-connect ERR_TLS_CERT_ALTNAME_INVALID socket error rejects the request', async (t) => {
+  let socket
+  let requestReceived
+  const received = new Promise((resolve) => { requestReceived = resolve })
+  const server = createServer(() => requestReceived())
+
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+
+  const client = new Client(`http://127.0.0.1:${server.address().port}`, {
+    connect (opts, callback) {
+      socket = net.connect({ host: '127.0.0.1', port: opts.port })
+      socket.once('connect', () => callback(null, socket))
+      socket.once('error', callback)
+    }
+  })
+
+  t.after(async () => {
+    await client.destroy()
+    server.closeAllConnections()
+    await new Promise((resolve) => server.close(resolve))
+  })
+
+  const rejected = assert.rejects(
+    client.request({ path: '/', method: 'GET' }),
+    { code: 'ERR_TLS_CERT_ALTNAME_INVALID' }
+  )
+
+  await received
+
+  const err = new Error('Hostname/IP does not match certificate\'s altnames')
+  err.code = 'ERR_TLS_CERT_ALTNAME_INVALID'
+  socket.emit('error', err)
+
+  await rejected
+})

