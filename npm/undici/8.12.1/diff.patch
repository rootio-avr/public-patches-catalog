+'use strict'
+
+const assert = require('node:assert/strict')
+const { once } = require('node:events')
+const http = require('node:http')
+const { test } = require('node:test')
+const { Agent, Pool, request } = require('..')
+
+async function captureOptions (agentOptions) {
+  const server = http.createServer((req, res) => res.end('ok'))
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+
+  let captured
+  const agent = new Agent({
+    ...agentOptions,
+    factory (origin, options) {
+      captured = options
+      return new Pool(origin, options)
+    }
+  })
+
+  try {
+    const { body } = await request(`http://localhost:${server.address().port}`, { dispatcher: agent })
+    await body.text()
+  } finally {
+    await agent.close()
+    server.close()
+  }
+  return captured
+}
+
+test('Agent preserves function-valued tls and connect options (CVE-2026-109383)', async () => {
+  const checkServerIdentity = () => undefined
+  const tls = { servername: 'agent1', checkServerIdentity }
+  const connect = { timeout: 100, checkServerIdentity }
+
+  const options = await captureOptions({ tls, connect })
+
+  assert.strictEqual(options.tls.checkServerIdentity, checkServerIdentity)
+  assert.strictEqual(options.connect.checkServerIdentity, checkServerIdentity)
+  assert.strictEqual(options.tls.servername, 'agent1')
+})
+
+test('Agent copies tls and connect options before storing them (CVE-2026-109383)', async () => {
+  const server = http.createServer((req, res) => res.end('ok'))
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+
+  const connect = { timeout: 100 }
+  const tls = { servername: 'agent1' }
+  let captured
+  const agent = new Agent({
+    connect,
+    tls,
+    factory (origin, options) {
+      captured = options
+      return new Pool(origin, options)
+    }
+  })
+
+  // Mutate after construction. The stored copies must keep the original values.
+  connect.timeout = 200
+  tls.servername = 'agent2'
+
+  try {
+    const { body } = await request(`http://localhost:${server.address().port}`, { dispatcher: agent })
+    await body.text()
+  } finally {
+    await agent.close()
+    server.close()
+  }
+
+  assert.notStrictEqual(captured.connect, connect)
+  assert.notStrictEqual(captured.tls, tls)
+  assert.deepStrictEqual(captured.connect, { timeout: 100 })
+  assert.deepStrictEqual(captured.tls, { servername: 'agent1' })
+})
