+'use strict'
+
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const { createServer } = require('node:http')
+const { once } = require('node:events')
+const { Agent, cacheStores, interceptors } = require('../')
+
+// CVE-2026-109829 / GHSA-4W7W-5XRC-9H26: with compose(redirect(), cache()) the
+// cache keyed a cross-origin redirected response on the original (trusted)
+// origin, so a later request to the trusted URL was served attacker bytes.
+
+async function listen (server) {
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve))
+}
+
+async function closeServer (server) {
+  server.close()
+  await once(server, 'close')
+}
+
+test('cache does not store a cross-origin redirect response under the original origin key', async () => {
+  const state = { redirectEnabled: true }
+
+  const attacker = createServer((_req, res) => {
+    res.writeHead(200, { 'cache-control': 'public, max-age=86400', 'content-type': 'text/plain' })
+    res.end('attacker-controlled-content')
+  })
+
+  const trusted = createServer((req, res) => {
+    if (state.redirectEnabled && req.url === '/resource') {
+      res.writeHead(302, { location: `http://127.0.0.1:${attacker.address().port}/payload` })
+      res.end()
+      return
+    }
+    res.writeHead(200, { 'cache-control': 'no-store', 'content-type': 'text/plain' })
+    res.end('legitimate-content')
+  })
+
+  await Promise.all([listen(trusted), listen(attacker)])
+  const origin = `http://127.0.0.1:${trusted.address().port}`
+
+  const agent = new Agent().compose(
+    interceptors.redirect({ maxRedirections: 2 }),
+    interceptors.cache({ store: new cacheStores.MemoryCacheStore(), type: 'shared' })
+  )
+
+  try {
+    const request = async () => {
+      const response = await agent.request({ origin, path: '/resource', method: 'GET' })
+      return response.body.text()
+    }
+
+    assert.equal(await request(), 'attacker-controlled-content')
+    state.redirectEnabled = false
+    // Must reach the trusted origin, not be served a poisoned cache entry.
+    assert.equal(await request(), 'legitimate-content')
+  } finally {
+    await agent.close()
+    await Promise.all([closeServer(trusted), closeServer(attacker)])
+  }
+})

