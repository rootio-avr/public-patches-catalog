diff --git a/test/cve-2026-12151.test.js b/test/cve-2026-12151.test.js
new file mode 100644
index 0000000..f31695b
--- /dev/null
+++ b/test/cve-2026-12151.test.js
@@ -0,0 +1,51 @@
+'use strict'
+
+const { test } = require('node:test')
+const assert = require('node:assert')
+
+const Agent = require('../lib/dispatcher/agent')
+const { MessageSizeExceededError } = require('../lib/core/errors')
+
+// Regression test for CVE-2026-12151.
+//
+// The fix threads WebSocket resource limits (maxFragments / maxPayloadSize)
+// through the dispatcher so the ByteParser can cap the number of fragments and
+// the total buffered payload size, preventing unbounded memory growth from a
+// hostile peer. It also makes MessageSizeExceededError recognizable via a
+// realm-independent Symbol.hasInstance brand so cross-realm error instances are
+// still mapped to close code 1009.
+
+test('DispatcherBase exposes webSocketOptions with safe defaults', () => {
+  const agent = new Agent()
+  const opts = agent.webSocketOptions
+
+  assert.ok(opts, 'webSocketOptions getter should exist')
+  assert.strictEqual(opts.maxFragments, 131072)
+  assert.strictEqual(opts.maxPayloadSize, 128 * 1024 * 1024)
+
+  agent.close()
+})
+
+test('DispatcherBase honors caller-provided webSocket limits', () => {
+  const agent = new Agent({ webSocket: { maxFragments: 16, maxPayloadSize: 1024 } })
+  const opts = agent.webSocketOptions
+
+  assert.strictEqual(opts.maxFragments, 16)
+  assert.strictEqual(opts.maxPayloadSize, 1024)
+
+  agent.close()
+})
+
+test('MessageSizeExceededError has a realm-independent brand', () => {
+  const err = new MessageSizeExceededError()
+
+  assert.strictEqual(err.code, 'UND_ERR_WS_MESSAGE_SIZE_EXCEEDED')
+  assert.ok(err instanceof MessageSizeExceededError)
+
+  const brand = Symbol.for('undici.error.UND_ERR_WS_MESSAGE_SIZE_EXCEEDED')
+  const crossRealm = { [brand]: true }
+  assert.ok(crossRealm instanceof MessageSizeExceededError)
+
+  assert.ok(!({} instanceof MessageSizeExceededError))
+  assert.ok(!(new Error('x') instanceof MessageSizeExceededError))
+})
