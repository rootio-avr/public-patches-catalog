+function cleanEntities(svg) {
+	var entityRegex = /\s*<!Entity\s+\S*\s*(?:"|')[^"]+(?:"|')\s*>/img;
+	// Remove entities
+	return svg.replace(entityRegex, '');
+}
+
+function removeDtdMarkupDeclarations(svg) {
+	return svg.replace(/\[?(?:\s*<![A-Z]+[^>]*>\s*)*\]?/g, '');
+}
+
+function clean(svg) {
+	svg = cleanEntities(svg);
+	svg = removeDtdMarkupDeclarations(svg);
+	return svg;
+}
+
+var regex = /^\s*(?:<\?xml[^>]*>\s*)?(?:<!doctype svg[^>]*>\s*)?(?:<svg[^>]*>[^]*<\/svg>|<svg[^/>]*\/\s*>)\s*$/i;
+
 module.exports = function (buf) {
