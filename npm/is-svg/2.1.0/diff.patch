Fix ReDoS vulnerability (CVE-2021-28092)

The SVG validation regex used a nested-quantifier sub-expression to match
the DOCTYPE / DTD markup declarations:

    (?:<!doctype svg[^>]*\s*(?:<![^>]*>)*[^>]*>\s*)?

The `(?:<![^>]*>)*` group combined with the surrounding `[^>]*` allows
catastrophic backtracking. An input such as `<!doctype svg ` followed by a
long run of spaces causes exponential/quadratic matching time, enabling a
denial-of-service.

Backported from upstream commit 01f8a087fab8a69c3ac9085fbb16035907ab6a5b
(adapted to the ES5 code style of is-svg@2.1.0): the DTD entities and markup
declarations are now stripped in a dedicated pre-processing step and the
validation regex no longer contains the vulnerable nested quantifiers.

The upstream test.js additions are omitted: the published npm tarball for
is-svg@2.1.0 ships only index.js/license/package.json/readme.md, so test.js
does not exist in the build source. The security fix is entirely in index.js.

--- a/index.js
+++ b/index.js
@@ -15,6 +15,24 @@ function isBinary(buf) {
 	return false;
 }

+function cleanEntities(svg) {
+	var entityRegex = /\s*<!Entity\s+\S*\s*(?:"|')[^"]+(?:"|')\s*>/img;
+	// Remove entities
+	return svg.replace(entityRegex, '');
+}
+
+function removeDtdMarkupDeclarations(svg) {
+	return svg.replace(/\[?(?:\s*<![A-Z]+[^>]*>\s*)*\]?/g, '');
+}
+
+function clean(svg) {
+	svg = cleanEntities(svg);
+	svg = removeDtdMarkupDeclarations(svg);
+	return svg;
+}
+
+var regex = /^\s*(?:<\?xml[^>]*>\s*)?(?:<!doctype svg[^>]*>\s*)?(?:<svg[^>]*>[^]*<\/svg>|<svg[^/>]*\/\s*>)\s*$/i;
+
 module.exports = function (buf) {
-	return !isBinary(buf) && /^\s*(?:<\?xml[^>]*>\s*)?(?:<!doctype svg[^>]*\s*(?:<![^>]*>)*[^>]*>\s*)?<svg[^>]*>[^]*<\/svg>\s*$/i.test(buf.toString().replace(htmlCommentRegex, ''));
+	return !isBinary(buf) && regex.test(clean(buf.toString()).replace(htmlCommentRegex, ''));
 };
