--- /dev/null
+++ b/test/cve-2021-29059.test.js
@@ -0,0 +1,22 @@
+import test from 'ava';
+import isSvg from '../';
+
+// Regression test for CVE-2021-29059 (ReDoS in is-svg).
+// A crafted, unterminated `<!doctype svg ...>` string with a long run of
+// whitespace used to trigger catastrophic backtracking in the validation
+// regex, hanging the event loop. The hardened regex must reject it promptly.
+test('regex should not be quadratic (CVE-2021-29059)', t => {
+	const start = Date.now();
+	const result = isSvg(`<!doctype svg ${' '.repeat(50000)}`);
+	const elapsedSeconds = (Date.now() - start) / 1000;
+
+	t.false(result);
+	t.true(elapsedSeconds < 5, `validation took ${elapsedSeconds}s`);
+});
+
+// Sanity checks: the hardening must not break normal SVG detection.
+test('still detects valid SVGs (CVE-2021-29059)', t => {
+	t.true(isSvg('<svg width="100" height="100" viewBox="0 0 30 30" version="1.1"></svg>'));
+	t.true(isSvg('<?xml version="1.0" standalone="no"?><!DOCTYPE svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd"><svg></svg>'));
+	t.false(isSvg('this string contains an svg <svg></svg> in the middle'));
+});

