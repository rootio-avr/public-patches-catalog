+++ b/test/cve-2021-28092.test.js
@@ -0,0 +1,14 @@
+import test from 'ava';
+import m from '..';
+
+// Regression test for CVE-2021-28092 (ReDoS in the DOCTYPE/DTD matching regex).
+// A crafted `<!doctype svg` prefix followed by many spaces caused catastrophic
+// backtracking. After the fix the check must return quickly (and be falsy).
+test('regex should not be quadratic', t => {
+	const start = Date.now();
+	const result = m(`<!doctype svg ${' '.repeat(34560)}`);
+	const elapsedSeconds = (Date.now() - start) / 1000;
+
+	t.false(Boolean(result));
+	t.true(elapsedSeconds < 10);
+});
