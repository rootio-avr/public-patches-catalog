@@ -0,0 +1,21 @@
+// Regression test for AIKIDO-2024-10147: shipped docs must not instruct users
+// to load scripts from the compromised cdn.polyfill.io domain.
+const assert = require("assert");
+const fs = require("fs");
+const path = require("path");
+
+const docs = ["html.md", "html.html", "html.processed.html"];
+
+docs.forEach(function (name) {
+    const file = path.join(__dirname, "..", "docs", "doc", name);
+    const text = fs.readFileSync(file, "utf8");
+    assert.ok(
+        !/polyfill\.io/i.test(text),
+        name + " must not reference polyfill.io"
+    );
+    // The surrounding example must still be present.
+    assert.ok(/What about polyfills/i.test(text), name + " lost its polyfills section");
+    assert.ok(text.indexOf("jquery.min.js") !== -1, name + " lost its example script tags");
+});
+
+console.log("AIKIDO-2024-10147 docs check passed");
