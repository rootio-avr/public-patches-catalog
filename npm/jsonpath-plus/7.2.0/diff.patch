@@ -0,0 +1,91 @@
+import {checkBuiltInVMAndNodeVM} from '../test-helpers/checkVM.js';
+
+/**
+ * Regression test for AIKIDO-2024-10345 (CWE-94 remote code execution).
+ *
+ * JSONPath filter/script expressions are evaluated inside a `vm.Script`
+ * (Node) or `Function`-constructor (browser) sandbox. Reaching a
+ * prototype-chain property such as `constructor`, `__proto__` or
+ * `prototype` lets an attacker recover the `Function` constructor and
+ * break out of the sandbox to run arbitrary code. `_eval` must reject any
+ * such expression before it is ever compiled or executed, while continuing
+ * to evaluate legitimate filter expressions normally.
+ *
+ * The upstream complete fix (JSONPath-Plus commit 73ad72e5, released in
+ * 10.2.0) replaced the whole evaluator with a jsep-based SafeScript that
+ * did not exist in v7.2.0; this test asserts the equivalent hardening for
+ * the v7.2.0 `vm`/`Function` evaluator.
+ */
+checkBuiltInVMAndNodeVM(function (vmType, setBuiltInState) {
+    describe(`JSONPath - Security / RCE (${vmType})`, function () {
+        before(setBuiltInState);
+
+        const json = {
+            store: {
+                book: {
+                    category: 'reference',
+                    author: 'Nigel Rees',
+                    title: 'Sayings of the Century',
+                    price: [8.95, 8.94]
+                }
+            }
+        };
+
+        it('blocks constructor-based sandbox escape (RCE)', function () {
+            const payload = '$..[?(' +
+                '@.constructor.constructor("return process")().' +
+                'mainModule.require("child_process").execSync("id"))]';
+            expect(() => {
+                jsonpath({json, path: payload, wrap: false});
+            }).to.throw(Error, /prototype-chain property/u);
+        });
+
+        it('blocks constructor access in a `(expr)` selector', function () {
+            expect(() => {
+                jsonpath({
+                    json,
+                    path: '$..[(@.constructor.constructor("return 1")())]',
+                    wrap: false
+                });
+            }).to.throw(Error, /prototype-chain property/u);
+        });
+
+        it('blocks __proto__ access in a filter', function () {
+            expect(() => {
+                jsonpath({
+                    json,
+                    path: '$..[?(@.__proto__)]',
+                    wrap: false
+                });
+            }).to.throw(Error, /prototype-chain property/u);
+        });
+
+        it('blocks prototype access in a filter', function () {
+            expect(() => {
+                jsonpath({
+                    json,
+                    path: '$..[?(@.constructor.prototype)]',
+                    wrap: false
+                });
+            }).to.throw(Error, /prototype-chain property/u);
+        });
+
+        it('still evaluates legitimate filter expressions', function () {
+            const result = jsonpath({
+                json,
+                path: '$..[?(@.category === "reference")]',
+                wrap: false
+            });
+            assert.deepEqual(result, json.store.book);
+        });
+
+        it('still evaluates legitimate arithmetic filter expressions', function () {
+            const result = jsonpath({
+                json,
+                path: '$..[?(@.price && @.price[0] > 8)]',
+                wrap: false
+            });
+            assert.deepEqual(result, json.store.book);
+        });
+    });
+});
