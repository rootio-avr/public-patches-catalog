+checkBuiltInVMAndNodeVM(function (vmType, setBuiltInState) {
+    describe(`JSONPath - CVE-2025-1302 eval RCE (${vmType})`, function () {
+        before(setBuiltInState);
+
+        it('rejects non-string property names reaching `constructor`', () => {
+            const userControlledPath =
+                "$..[?(p=\"console.log(this.process.mainModule.require('child_process').execSync('id').toString())\";a=''[['constructor']][['constructor']](p);a())]";
+            assert.throws(() => {
+                jsonpath({json: {example: true}, path: userControlledPath});
+            }, /Unsafe member access/u);
+        });
+
+        it('rejects escaped `constructor` and `__proto__` in filters', () => {
+            assert.throws(() => {
+                jsonpath({
+                    json: {x: 1},
+                    path: "$[?(''['\\x63onstructor']['constructor']('return 1')())]"
+                });
+            }, /Unsafe member access/u);
+            assert.throws(() => {
+                jsonpath({
+                    json: {x: 1},
+                    path: "$[?(@.__proto__)]"
+                });
+            }, /Unsafe member access/u);
+        });
+
+        it('rejects `constructor` in dynamic property expressions', () => {
+            assert.throws(() => {
+                jsonpath({
+                    json: {x: 1},
+                    path: "$[(this.constructor.constructor('return 1')())]"
+                });
+            }, /Unsafe member access/u);
+        });
+
