Fix CVE-2024-21534 - RCE via JSONPath script-expression sandbox escape

JSONPath filter expressions `[?(...)]` are evaluated via Node's `vm.runInNewContext`
(0.19.0 bundles vm inline in src/jsonpath.js). Attackers can escape the sandbox
via `@.constructor.constructor("...")` or bare `Function("...")()` to reach the
host Function constructor and execute arbitrary code.

Upstream v10.2.0 (commit 73ad72e) replaces the evaluator with a jsep-based
Safe-Script AST walker; that module does not exist in 0.19.0. This backport
rejects script text containing identifiers that enable sandbox escape before
vm evaluation, matching the 7.2.0 backport denylist. Source must be rebuilt
with rollup so dist/index-*.js picks up the fix (npm tarball ships prebuilt dist).

Origin: backport, https://github.com/JSONPath-Plus/JSONPath/commit/73ad72e5ee788d8287dea6e8283a3f16f63c9eb8

--- a/src/jsonpath.js	2026-09-25 17:33:49.580245556 +0530
+++ b/src/jsonpath.js	2026-09-25 17:34:02.090912140 +0530
@@ -7,6 +7,36 @@
 const allowedResultTypes = ['value', 'path', 'pointer', 'parent', 'parentProperty', 'all'];
 const {hasOwnProperty: hasOwnProp} = Object.prototype;
 
+// CVE-2024-21534: deny tokens that enable VM / sandbox escape from inside
+// JSONPath script-expression filters (`[?(...)]` / `[(...)]`). The upstream
+// v10.2.0 fix uses a jsep-AST walker (`src/Safe-Script.js`) which does not
+// exist in this version; reject scripts whose tokenised text references
+// identifiers that can reach the host `Function` constructor or the Node
+// `process` / module loader (documented RCE vector:
+// `[].constructor.constructor(...)` then `this.process.mainModule.require(...)`).
+const _$_BLOCKED_IDENTIFIERS = [
+    'constructor',
+    '__proto__',
+    '__defineGetter__',
+    '__defineSetter__',
+    'Function',
+    'process',
+    'globalThis',
+    'global',
+    'require',
+    'import'
+];
+const _$_BLOCKED_RE = new RegExp(
+    '\\b(' + _$_BLOCKED_IDENTIFIERS.join('|') + ')\\b'
+);
+function _$_assertSafeScript (code) {
+    if (typeof code === 'string' && _$_BLOCKED_RE.test(code)) {
+        throw new Error(
+            'jsonPath: Disallowed access to property in eval expression: ' + code
+        );
+    }
+}
+
 /**
  * Copy items out of one array into another.
  * @param {Array} source Array with items to copy
@@ -471,6 +501,9 @@
 
 JSONPath.prototype._eval = function (code, _v, _vname, path, parent, parentPropName) {
     if (!this._obj || !_v) { return false; }
+    // CVE-2024-21534: reject scripts that reference unsafe identifiers
+    // before they are transformed or passed to vm.runInNewContext.
+    _$_assertSafeScript(code);
     if (code.includes('@parentProperty')) {
         this.currSandbox._$_parentProperty = parentPropName;
         code = code.replace(/@parentProperty/g, '_$_parentProperty');
--- /dev/null
+++ b/test/cve-2024-21534.test.js
@@ -0,0 +1,80 @@
+'use strict';
+const {testCase} = require('nodeunit');
+const jsonpath = require('../').JSONPath;
+
+// Regression test for CVE-2024-21534 (jsonpath-plus prototype-pollution /
+// sandbox escape via filter/eval expressions).
+const json = {
+    "store": {
+        "book": {
+            "category": "reference",
+            "author": "Nigel Rees",
+            "title": "Sayings of the Century",
+            "price": [8.95, 8.94]
+        }
+    }
+};
+
+module.exports = testCase({
+    'blocks constructor access (RCE vector)' (test) {
+        test.throws(function () {
+            jsonpath({
+                json,
+                path: "$..[?(@.constructor.constructor('return process')())]",
+                wrap: false
+            });
+        }, /Disallowed access to property/);
+        test.done();
+    },
+
+    'blocks bare Function constructor (RCE vector)' (test) {
+        test.throws(function () {
+            jsonpath({
+                json,
+                path: "$[?(Function('return 42')())]",
+                wrap: false
+            });
+        }, /Disallowed access to property/);
+        test.done();
+    },
+
+    'blocks __proto__ access (prototype pollution vector)' (test) {
+        test.throws(function () {
+            jsonpath({
+                json,
+                path: "$..[?(@.__proto__.polluted = true)]",
+                wrap: false
+            });
+        }, /Disallowed access to property/);
+        test.done();
+    },
+
+    'blocks __defineGetter__ / __defineSetter__ access' (test) {
+        test.throws(function () {
+            jsonpath({
+                json,
+                path: "$..[?(@.__defineGetter__)]",
+                wrap: false
+            });
+        }, /Disallowed access to property/);
+        test.throws(function () {
+            jsonpath({
+                json,
+                path: "$..[?(@.__defineSetter__)]",
+                wrap: false
+            });
+        }, /Disallowed access to property/);
+        test.done();
+    },
+
+    'still evaluates benign filter expressions' (test) {
+        const expected = json.store.book;
+        const result = jsonpath({
+            json,
+            path: "$..[?(@.category === 'reference')]",
+            wrap: false
+        });
+        test.deepEqual(expected, result);
+        test.done();
+    }
+});
