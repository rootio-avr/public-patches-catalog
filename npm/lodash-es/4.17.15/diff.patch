--- a/test/cve-2026-4800.test.mjs
+++ b/test/cve-2026-4800.test.mjs
@@ -0,0 +1,40 @@
+import assert from 'node:assert';
+import template from '../template.js';
+
+// Code injection through `imports` key names must be rejected.
+globalThis.__cve20264800a = false;
+var imports = {};
+imports['a = (globalThis.__cve20264800a = true, 1)'] = undefined;
+assert.throws(function() {
+  template('hello', { 'imports': imports });
+}, /Invalid `imports` option/);
+assert.strictEqual(globalThis.__cve20264800a, false);
+
+// Same payload without whitespace.
+globalThis.__cve20264800b = false;
+var compact = {};
+compact['a=(globalThis.__cve20264800b=true,1)'] = undefined;
+assert.throws(function() {
+  template('hello', { 'imports': compact });
+}, /Invalid `imports` option/);
+assert.strictEqual(globalThis.__cve20264800b, false);
+
+// Inherited (prototype-polluted) keys must not be enumerated from imports.
+globalThis.__cve20264800c = false;
+var payload = 'a = (globalThis.__cve20264800c = true, 1)';
+var inherited = Object.create({ [payload]: undefined });
+inherited._ = { 'template': template };
+try {
+  template('hello', { 'imports': inherited });
+} catch (e) {}
+assert.strictEqual(globalThis.__cve20264800c, false);
+delete globalThis.__cve20264800a;
+delete globalThis.__cve20264800b;
+delete globalThis.__cve20264800c;
+
+// Legitimate imports keep working.
+assert.strictEqual(
+  template('<%= helper(1) %>', { 'imports': { 'helper': function(n) { return n + 1; } } })({}),
+  '2'
+);
+assert.strictEqual(template('<%= a %>')({ 'a': 3 }), '3');
