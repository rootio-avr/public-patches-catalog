--- /dev/null
+++ b/test/cve-2021-23337.test.mjs
@@ -0,0 +1,18 @@
+import assert from 'node:assert';
+import template from '../template.js';
+
+// Code injection through the `variable` option must be rejected.
+assert.throws(function() {
+  template('', { 'variable': '){console.log(process.env)}; with(obj' });
+});
+
+// Other characters able to alter the function parameter list are rejected too.
+['a,b', 'a=1', '{a}', '[a]', 'a/*', 'a b', '(a)'].forEach(function(variable) {
+  assert.throws(function() {
+    template('', { 'variable': variable });
+  }, /Invalid `variable` option/);
+});
+
+// Legitimate identifiers keep working.
+assert.strictEqual(template('<%= data.a %>', { 'variable': 'data' })({ 'a': 1 }), '1');
+assert.strictEqual(template('<%= a %>')({ 'a': 2 }), '2');

