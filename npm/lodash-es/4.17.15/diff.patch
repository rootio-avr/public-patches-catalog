@@ -0,0 +1,17 @@
+import assert from 'node:assert';
+import zipObjectDeep from '../zipObjectDeep.js';
+import set from '../set.js';
+
+// Prototype pollution through zipObjectDeep / set must be rejected.
+['__proto__', 'constructor', 'prototype'].forEach(function(key) {
+  zipObjectDeep([key + '.polluted'], ['yes']);
+  zipObjectDeep([key + '.prototype.polluted'], ['yes']);
+  set({}, key + '.polluted', 'yes');
+  set({}, 'constructor.prototype.polluted', 'yes');
+  assert.strictEqual({}.polluted, undefined);
+  assert.strictEqual(Object.prototype.polluted, undefined);
+});
+
+// Legitimate paths keep working.
+assert.deepStrictEqual(zipObjectDeep(['a.b[0].c'], [1]), { a: { b: [{ c: 1 }] } });
+assert.deepStrictEqual(set({}, 'x.y', 2), { x: { y: 2 } });
