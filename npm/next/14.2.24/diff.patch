+++ b/test/unit/cve-2026-44578.test.js
@@ -0,0 +1,109 @@
+/**
+ * Regression test for CVE-2026-44578 (GHSA-c4j6-fc7j-m34r, CWE-918).
+ *
+ * WebSocket-upgrade SSRF in the self-hosted Node.js server: the router-server
+ * upgrade handler proxied any upgrade request whose resolved URL had a
+ * protocol (an absolute/cross-origin URL), letting an attacker smuggle an
+ * absolute URL in the request line and force the server to proxy to an
+ * arbitrary internal/external destination.
+ *
+ * The published npm package ships only compiled JS
+ * (dist/server/lib/router-server.js and dist/esm/server/lib/router-server.js),
+ * with no importable test harness or running server available in a unit test.
+ * The upstream e2e test
+ * (test/e2e/rewrite-request-smuggling/rewrite-request-smuggling.test.ts) is not
+ * present in the published tarball, so this is a grounded replacement that
+ * exercises the exact decision the fix introduced in the upgrade handler:
+ *
+ *   const { finished, matchedOutput, parsedUrl, statusCode } = resolveRoutes(...)
+ *   if (matchedOutput) return socket.end()
+ *   if (finished && parsedUrl.protocol) {
+ *     if (!statusCode) return proxyRequest(...)   // only a real external rewrite
+ *     return socket.end()                         // otherwise refuse (SSRF guard)
+ *   }
+ *
+ * A proxy is therefore only allowed when route resolution actually finished
+ * with an external rewrite (finished === true) AND produced no status code
+ * (statusCode falsy). An absolute-URL upgrade that was not turned into a
+ * genuine external rewrite carries a statusCode (or never finishes), so it
+ * must NOT be proxied.
+ */
+
+// Mirror of the patched upgrade-handler decision in router-server.js.
+// Returns 'proxy' | 'end' — 'proxy' means proxyRequest() is invoked.
+function upgradeProxyDecision({ finished, matchedOutput, parsedUrl, statusCode }) {
+  if (matchedOutput) {
+    return 'end'
+  }
+  if (finished && parsedUrl && parsedUrl.protocol) {
+    if (!statusCode) {
+      return 'proxy'
+    }
+    return 'end'
+  }
+  return 'end'
+}
+
+describe('CVE-2026-44578 websocket-upgrade SSRF guard', () => {
+  it('does NOT proxy an absolute-URL upgrade that carries a status code (blocked rewrite)', () => {
+    // e.g. crafted `GET http://127.0.0.1:<internal>/secret-upgrade HTTP/1.1`
+    // that route resolution rejected with a status code instead of an
+    // external rewrite.
+    expect(
+      upgradeProxyDecision({
+        finished: true,
+        matchedOutput: null,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: 403,
+      })
+    ).toBe('end')
+  })
+
+  it('does NOT proxy an absolute-URL upgrade when route resolution did not finish', () => {
+    // Pre-fix code proxied purely on parsedUrl.protocol; the guard now also
+    // requires finished === true.
+    expect(
+      upgradeProxyDecision({
+        finished: false,
+        matchedOutput: null,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: undefined,
+      })
+    ).toBe('end')
+  })
+
+  it('does NOT proxy when a local output matched', () => {
+    expect(
+      upgradeProxyDecision({
+        finished: true,
+        matchedOutput: { itemPath: '/foo' },
+        parsedUrl: { protocol: 'http:' },
+        statusCode: undefined,
+      })
+    ).toBe('end')
+  })
+
+  it('STILL proxies a genuine same-origin external rewrite (finished, protocol, no status code)', () => {
+    // Legitimate rewrite to an external destination must keep working —
+    // guards against over-blocking regressions seen in sibling backports.
+    expect(
+      upgradeProxyDecision({
+        finished: true,
+        matchedOutput: null,
+        parsedUrl: { protocol: 'https:' },
+        statusCode: undefined,
+      })
+    ).toBe('proxy')
+  })
+
+  it('does not proxy a normal relative upgrade with no protocol', () => {
+    expect(
+      upgradeProxyDecision({
+        finished: true,
+        matchedOutput: null,
+        parsedUrl: { protocol: null },
+        statusCode: undefined,
+      })
+    ).toBe('end')
+  })
+})

