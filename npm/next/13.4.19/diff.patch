+  var maxDepth = typeof limit === 'number' && limit > 0 ? limit : DEFAULT_MAX_MODEL_NESTING;
+  var depth = 0;
+  var nodes = 0;
+  var inString = false;
+  var escaped = false;
+
+  for (var i = 0; i < jsonString.length; i++) {
+    var c = jsonString.charCodeAt(i);
+
