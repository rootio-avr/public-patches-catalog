+/*
+ * Regression test for GHSA-5j59-xgg2-r9c4 (CVE-2025-67779).
+ *
+ * A crafted RSC HTTP request could drive Chunk.prototype.then's cyclic-thenable
+ * detection into an unbounded traversal, hanging the server process (DoS via CPU
+ * exhaustion). The complete fix adds a bounded `cycleProtection` counter that
+ * breaks the traversal after 1000 iterations and rejects with
+ * "Cannot have cyclic thenables." instead of looping forever.
+ *
+ * No upstream regression test ships with the fix commits (7c1be85a2e / 8e43882798),
+ * and the vendored react-server-dom-* server bundles are not loadable as standalone
+ * modules, so this test asserts the fix is present in every shipped server bundle
+ * variant: the bounded guard exists and the previous unbounded fast-path is gone.
+ */
+'use strict'
+
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+
+const nextRoot = path.join(require.resolve('next/package.json'), '..')
+
+// The vendored bundles live under dist/compiled once built/installed, and under
+// src/compiled in a source checkout (the build copies src -> dist verbatim).
+const compiledDirs = [
+  path.join(nextRoot, 'dist', 'compiled'),
+  path.join(nextRoot, 'src', 'compiled'),
+].filter((d) => fs.existsSync(d))
+
+assert.ok(
+  compiledDirs.length > 0,
+  'expected next to expose a compiled/ directory (dist/compiled or src/compiled)'
+)
+
+// Collect every vendored RSC *server* bundle that defines Chunk.prototype.then.
+const bundleDirs = [
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+]
+
+const serverFiles = []
+for (const compiledDir of compiledDirs) {
+  for (const dir of bundleDirs) {
+    const cjs = path.join(compiledDir, dir, 'cjs')
+    if (!fs.existsSync(cjs)) continue
+    for (const name of fs.readdirSync(cjs)) {
+      if (/server\..*\.js$/.test(name)) {
+        serverFiles.push(path.join(cjs, name))
+      }
+    }
+  }
+}
+
+assert.ok(serverFiles.length > 0, 'expected to find vendored RSC server bundles to check')
+
+let checked = 0
+for (const file of serverFiles) {
+  const src = fs.readFileSync(file, 'utf8')
+  if (!/\.prototype\.then\s*=\s*function/.test(src) && !/prototype\.then=function/.test(src)) {
+    // Not a bundle that defines the vulnerable then(); skip.
+    continue
+  }
+  checked++
+
+  const isMin = file.endsWith('.min.js')
+  if (isMin) {
+    // Minified guard: `d++` counter compared against `1E3<d`.
+    assert.ok(
+      /1E3<d/.test(src),
+      `missing bounded cyclic-thenable guard (1E3<d) in ${path.basename(file)}`
+    )
+    // The pre-fix INITIALIZED fast-path `case "fulfilled":a(this.value);break;`
+    // (unbounded) must no longer be present.
+    assert.ok(
+      !/case "fulfilled":a\(this\.value\);break;/.test(src),
+      `pre-fix unbounded INITIALIZED fast-path still present in ${path.basename(file)}`
+    )
+  } else {
+    // Development / production (non-min) guard.
+    assert.ok(
+      /cycleProtection\s*>\s*1000/.test(src),
+      `missing bounded cyclic-thenable guard (cycleProtection > 1000) in ${path.basename(file)}`
+    )
+    assert.ok(
+      /Cannot have cyclic thenables\./.test(src),
+      `missing cyclic-thenable rejection message in ${path.basename(file)}`
+    )
+  }
