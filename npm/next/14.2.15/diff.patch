+// 1. External request forging the subrequest header (no/invalid id) => dropped.
+{
+  const headers = {
+    'x-middleware-subrequest':
+      'middleware:middleware:middleware:middleware:middleware',
+    host: 'example.com',
+  }
+  filterInternalHeaders(headers)
+  assert.strictEqual(
+    headers['x-middleware-subrequest'],
+    undefined,
+    'forged x-middleware-subrequest header must be stripped'
+  )
