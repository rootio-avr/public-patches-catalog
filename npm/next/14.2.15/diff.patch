+// Regression test for CVE-2025-29927 (authorization bypass via the
+// "x-middleware-subrequest" header).
+//
+// The upstream fix is validated by an e2e test
+// (test/e2e/middleware-general/test/index.test.ts) that is not shipped in the
+// published npm package, so this is a minimal unit-level replacement that
+// exercises the same fixed behavior against the compiled distribution:
+// filterInternalHeaders() must drop the "x-middleware-subrequest" header when
+// the request does not carry a matching, session-issued
+// "x-middleware-subrequest-id", and must strip other internal headers, while
+// preserving the header for genuine self-issued subrequests.
+
+const assert = require('assert')
+const {
+  filterInternalHeaders,
+} = require('next/dist/server/lib/server-ipc/utils')
+
+const idSymbol = Symbol.for('@next/middleware-subrequest-id')
+const sessionId = 'deadbeefdeadbeef'
+globalThis[idSymbol] = sessionId
