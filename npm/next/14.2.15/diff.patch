+/* eslint-env jest */
+// Regression test for CVE-2026-64645 (GHSA-p9j2-gv94-2wf4):
+// "Ensure exotic rewrite param values are properly encoded".
+//
+// The upstream fix adds `encode: encodeURIComponent` to the destHostname
+// compiler in prepare-destination so that param values interpolated into a
+// rewrite destination hostname are percent-encoded instead of injected raw
+// (which could otherwise be abused to smuggle an attacker-controlled host,
+// leading to SSRF). This is the JS-level analog of the upstream e2e test
+// `test/e2e/rewrites-hostname`, which cannot ship in the published tarball.
+import { prepareDestination } from 'next/dist/shared/lib/router/utils/prepare-destination'
+
+describe('CVE-2026-64645 rewrite hostname param encoding', () => {
+  it('percent-encodes exotic param values interpolated into the destination hostname', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: 'a b' },
+      query: {},
+    })
+
+    // With the fix the exotic value is encoded; the raw space must not survive.
+    expect(parsedDestination.hostname).toBe('a%20b.example.com')
+    expect(parsedDestination.hostname).not.toContain(' ')
+  })
+
+  it('leaves ordinary param values unchanged', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: 'api' },
+      query: {},
+    })
+
+    expect(parsedDestination.hostname).toBe('api.example.com')
+  })
+})
