--- /dev/null
+++ b/test/cve-2025-29927.test.js
@@ -0,0 +1,67 @@
+// Regression test for CVE-2025-29927 (authorization bypass via the
+// "x-middleware-subrequest" header).
+//
+// The upstream fix is validated by an e2e test
+// (test/e2e/middleware-general/test/index.test.ts) that is not shipped in the
+// published npm package, so this is a minimal unit-level replacement that
+// exercises the same fixed behavior against the compiled distribution:
+// filterInternalHeaders() must drop the "x-middleware-subrequest" header when
+// the request does not carry a matching, session-issued
+// "x-middleware-subrequest-id", and must strip other internal headers, while
+// preserving the header for genuine self-issued subrequests.
+
+const assert = require('assert')
+const {
+  filterInternalHeaders,
+} = require('next/dist/server/lib/server-ipc/utils')
+
+const idSymbol = Symbol.for('@next/middleware-subrequest-id')
+const sessionId = 'deadbeefdeadbeef'
+globalThis[idSymbol] = sessionId
+
+// 1. External request forging the subrequest header (no/invalid id) => dropped.
+{
+  const headers = {
+    'x-middleware-subrequest':
+      'middleware:middleware:middleware:middleware:middleware',
+    host: 'example.com',
+  }
+  filterInternalHeaders(headers)
+  assert.strictEqual(
+    headers['x-middleware-subrequest'],
+    undefined,
+    'forged x-middleware-subrequest header must be stripped'
+  )
+  assert.strictEqual(headers['host'], 'example.com', 'benign header preserved')
+}
+
+// 2. Genuine self-issued subrequest (matching id) => header preserved.
+{
+  const headers = {
+    'x-middleware-subrequest': 'middleware',
+    'x-middleware-subrequest-id': sessionId,
+  }
+  filterInternalHeaders(headers)
+  assert.strictEqual(
+    headers['x-middleware-subrequest'],
+    'middleware',
+    'self-issued subrequest header must be preserved'
+  )
+}
+
+// 3. Other internal headers from an external request must be stripped.
+{
+  const headers = {
+    'x-middleware-rewrite': '/admin',
+    'x-middleware-override-headers': 'x-secret',
+    'x-matched-path': '/admin',
+    accept: 'text/html',
+  }
+  filterInternalHeaders(headers)
+  assert.strictEqual(headers['x-middleware-rewrite'], undefined)
+  assert.strictEqual(headers['x-middleware-override-headers'], undefined)
+  assert.strictEqual(headers['x-matched-path'], undefined)
+  assert.strictEqual(headers['accept'], 'text/html', 'benign header preserved')
+}
+
+console.log('CVE-2025-29927 regression test passed')

