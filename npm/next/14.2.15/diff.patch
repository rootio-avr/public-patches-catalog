+/**
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864)
+ *
+ * React Flight Reply deserialization (used by Next.js Server Actions /
+ * Server Functions via the compiled react-server-dom-{webpack,turbopack}
+ * server bundles) lacked resource caps, allowing a crafted RSC Reply body to
+ * cause denial-of-service. The fix introduces inline guards:
+ *   - MAX_BOUND_ARGS  (1000): bound-argument count cap in bindArgs
+ *   - MAX_BIGINT_DIGITS (300): BigInt digit-length cap in parseModelString
+ *
+ * This test verifies the guards are present across every compiled *server*
+ * bundle variant, and (when the RSC runtime is available) that an oversized
+ * BigInt payload is rejected by decodeReply while a normal value still works.
+ */
+const fs = require('fs')
+const path = require('path')
+
+const compiledRoot = path.join(
+  __dirname,
+  '..',
+  '..',
+  'dist',
+  'compiled'
+)
+
+function collectServerBundles() {
+  const pkgs = [
+    'react-server-dom-webpack',
+    'react-server-dom-webpack-experimental',
+    'react-server-dom-turbopack',
+    'react-server-dom-turbopack-experimental',
+  ]
+  const files = []
+  for (const pkg of pkgs) {
+    const cjsDir = path.join(compiledRoot, pkg, 'cjs')
+    if (!fs.existsSync(cjsDir)) continue
+    for (const name of fs.readdirSync(cjsDir)) {
+      if (
+        name.includes('-server.') &&
+        name.endsWith('.js') &&
+        !name.includes('node-register') &&
+        !name.includes('plugin')
+      ) {
+        files.push(path.join(cjsDir, name))
+      }
+    }
+  }
+  return files
+}
+
+describe('GHSA-h25m-26qc-wcjf: Flight Reply DoS guards', () => {
+  const bundles = collectServerBundles()
+
+  it('finds the compiled server bundles to guard', () => {
+    expect(bundles.length).toBeGreaterThan(0)
+  })
+
+  it('every compiled server bundle caps bound-argument count and BigInt length', () => {
+    for (const file of bundles) {
+      const src = fs.readFileSync(file, 'utf8')
+      expect(src).toContain('too many bound arguments')
+      expect(src).toContain('BigInt is too large')
+      // The limits themselves must be present.
+      expect(src).toMatch(/limit is 1000/)
+      expect(src).toMatch(/limit is 300/)
+    }
+  })
+
+  it('rejects an oversized BigInt reply but accepts a normal one (when RSC runtime available)', async () => {
+    let mod
+    try {
+      // eslint-disable-next-line import/no-dynamic-require
+      mod = require('react-server-dom-webpack/server.node')
+    } catch (e) {
+      // The full React Server runtime (react-server export condition) may not
+      // be enabled in this environment; the static guard assertions above
+      // already cover the regression in that case.
+      return
+    }
+    if (!mod || typeof mod.decodeReply !== 'function') {
+      return
+    }
+
+    const oversized = '$n' + '9'.repeat(400)
+    await expect(
+      Promise.resolve(mod.decodeReply(JSON.stringify(oversized), {}))
+    ).rejects.toThrow(/BigInt is too large/)
+
+    const normal = await mod.decodeReply(JSON.stringify('$n123'), {})
+    expect(normal).toBe(BigInt(123))
+  })
+})

CVE-2025-29927: Authorization bypass via x-middleware-subrequest header.

Next.js allowed an attacker to skip Middleware execution (including
authorization checks performed in middleware) by supplying a crafted
"x-middleware-subrequest" request header on an external request. Internal
headers used to detect self-issued middleware subrequests were honored even
when they originated from the untrusted client.

This backport adds the "filterInternalHeaders" machinery (absent in 14.2.15)
so that internal headers are stripped from incoming external requests, and
guards the "x-middleware-subrequest" header with a per-session,
cryptographically-random "x-middleware-subrequest-id". Only subrequests that
carry the matching id (set by this process when issuing its own subrequests)
are trusted; otherwise the "x-middleware-subrequest" header is dropped so
middleware is not skipped.

The published next@14.2.15 npm package ships only transpiled JavaScript, so
this patch targets the compiled distribution files (dist/**/*.js and their
dist/esm/**/*.js counterparts) rather than the monorepo TypeScript sources.

Upstream fixes: 52a078da3884efe6501613c7834a3d02a91676d2 (#77201) and its
backport 5fd3ae8f8542677c6294f32d18022731eab6fe48 (#77202).

