+++ b/test/unit/ghsa-h25m-26qc-wcjf.test.js
@@ -0,0 +1,69 @@
+/* eslint-env jest */
+/*
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864).
+ *
+ * Next.js vendors React's Flight (React Server Components) reply decoder in
+ * packages/next/src/compiled/react-server-dom-*. When an App Router Server
+ * Function endpoint deserializes an untrusted HTTP request body, the "$n"
+ * (BigInt) marker was parsed with an unbounded `BigInt(value.slice(2))` call.
+ * A request carrying a huge digit string forces V8 to allocate/convert an
+ * enormous BigInt, driving excessive CPU/memory use -> denial of service.
+ *
+ * The fix (backported from facebook/react PR #35632 / next.js 15.0.8) rejects
+ * BigInt literals whose digit count exceeds a fixed limit (300) before calling
+ * BigInt(), while still decoding legitimately-sized BigInts unchanged.
+ *
+ * This test exercises the vendored server bundle that runs in the Node.js
+ * runtime (react-server-dom-webpack server.node).
+ */
+
+const path = require('path')
+
+const serverBundle = path.join(
+  __dirname,
+  '..',
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.development.js'
+)
+
+// Minimal webpack module map; not exercised by these BigInt payloads.
+const emptyWebpackMap = {}
+
+async function resolveRoot(root) {
+  // The decoded root is a thenable Flight chunk. Awaiting it surfaces either
+  // the resolved value or the rejection produced during deserialization.
+  return await root
+}
+
+describe('GHSA-h25m-26qc-wcjf: Flight reply BigInt DoS mitigation', () => {
+  let decodeReply
+
+  beforeAll(() => {
+    ;({ decodeReply } = require(serverBundle))
+  })
+
+  it('decodes a legitimately-sized BigInt argument', async () => {
+    // A single-argument reply whose only value is a small BigInt.
+    const body = JSON.stringify('$n' + '123456789')
+    const value = await resolveRoot(decodeReply(body, emptyWebpackMap))
+    expect(value).toBe(BigInt('123456789'))
+  })
+
+  it('rejects an over-long BigInt literal instead of converting it', async () => {
+    // ~5000 digits: well past the 300-digit cap the fix introduces. Before the
+    // fix this reached BigInt() and could exhaust CPU/memory; after the fix it
+    // must be rejected with an error rather than parsed.
+    const hugeDigits = '9'.repeat(5000)
+    const body = JSON.stringify('$n' + hugeDigits)
+
+    await expect(
+      resolveRoot(decodeReply(body, emptyWebpackMap))
+    ).rejects.toThrow(/BigInt is too large/)
+  })
+})

