+++ b/test/ghsa-5j59-xgg2-r9c4.test.js
@@ -0,0 +1,101 @@
+'use strict';
+
+/*
+ * Regression test for GHSA-5j59-xgg2-r9c4 (CVE-2025-67779) — CWE-400
+ * Uncontrolled Resource Consumption in the React Flight (RSC) runtime.
+ *
+ * A crafted request could deserialize a cyclic thenable whose Chunk chain
+ * points back into itself, driving Chunk.prototype.then into an unbounded
+ * loop and exhausting CPU (DoS). The upstream fix (backport of
+ * facebook/react#35351, shipped in next@14.2.35) walks the resolved
+ * Chunk chain in Chunk.prototype.then's INITIALIZED/"fulfilled" branch and
+ * rejects with "Cannot have cyclic thenables." both when a chunk points back
+ * to itself AND after an iteration cap (1000) is exceeded, so a long/cyclic
+ * chain can never spin forever.
+ *
+ * next@14.0.4 vendors an older React canary snapshot whose
+ * Chunk.prototype.then had NO such guard at all (INITIALIZED simply did
+ * `resolve(chunk.value); break;`). The patch back-ports the guarded loop with
+ * the iteration cap into every affected server bundle variant.
+ *
+ * These bundles are compiled/minified vendor output and do not export the
+ * internal Chunk class, so this test asserts the fix is present (and the
+ * vulnerable unguarded shape absent) across all 48 patched server bundles.
+ * Runnable with `node --test` (node:test) or any assert-based runner.
+ */
+
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const COMPILED = path.join(__dirname, '..', 'packages', 'next', 'src', 'compiled');
+
+// The four vendored bundle families the fix touched.
+const FAMILIES = [
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+];
+
+function serverBundles() {
+  const files = [];
+  for (const fam of FAMILIES) {
+    const dir = path.join(COMPILED, fam, 'cjs');
+    for (const name of fs.readdirSync(dir)) {
+      if (/-server\..*\.js$/.test(name)) {
+        files.push(path.join(dir, name));
+      }
+    }
+  }
+  return files;
+}
+
+function run() {
+  const files = serverBundles();
+  assert.ok(files.length >= 48, `expected >=48 server bundles, found ${files.length}`);
+
+  let guarded = 0;
+  for (const file of files) {
+    const src = fs.readFileSync(file, 'utf8');
+
+    // Only assert on bundles that actually define Chunk.prototype.then.
+    if (!/\.prototype\.then\s*=\s*function/.test(src)) continue;
+    guarded++;
+
+    // 1) The cyclic-thenable guard message must be present.
+    assert.ok(
+      src.includes('Cannot have cyclic thenables.'),
+      `missing cyclic-thenable guard in ${file}`
+    );
+
+    // 2) The iteration cap (1000 / minified 1E3) must be present — this is the
+    //    specific DoS fix: bail out after a bounded number of chain hops.
+    assert.ok(
+      /cycleProtection\s*>\s*1000/.test(src) || /1E3\s*<\s*[a-z]/.test(src),
+      `missing iteration cap in ${file}`
+    );
+
+    // 3) The pre-fix vulnerable shape (INITIALIZED/"fulfilled" resolving the
+    //    chunk value with no chain guard) must be gone.
+    assert.ok(
+      !/case\s+INITIALIZED:\s*resolve\(chunk\.value\);\s*break;/.test(src),
+      `vulnerable unguarded INITIALIZED branch still present in ${file}`
+    );
+    assert.ok(
+      !/case "fulfilled":a\(this\.value\);break;/.test(src),
+      `vulnerable unguarded fulfilled branch still present in ${file}`
+    );
+  }
+
+  assert.ok(guarded >= 48, `expected >=48 guarded bundles, patched only ${guarded}`);
+  console.log(`OK: cyclic-thenable iteration cap present in ${guarded} server bundles`);
+}
+
+// Support both `node --test` and direct execution.
+try {
+  const { test } = require('node:test');
+  test('GHSA-5j59-xgg2-r9c4: cyclic-thenable DoS guard present in all RSC server bundles', run);
+} catch (e) {
+  run();
+}

