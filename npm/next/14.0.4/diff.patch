--- /dev/null
+++ b/test/cve-2026-44573.test.js
@@ -0,0 +1,121 @@
+/*
+ * Regression test for CVE-2026-44573 (GHSA-36qx-fr4f-26g5).
+ *
+ * Pages Router apps using i18n + middleware/proxy authorization could be
+ * bypassed via locale-less /_next/data/<buildId>/<page>.json requests: the
+ * normalized data path (e.g. "/middleware/works") never carried the default
+ * locale, so it did not match the i18n middleware matcher (which expects
+ * "/<defaultLocale>/middleware/works") and middleware/auth was skipped.
+ *
+ * Upstream fix 6c72e0b4ee096643b42c742f35e0de84c41d190d makes the
+ * middleware_next_data handler in resolve-routes remap a normalized data
+ * request to the same locale-prefixed internal pathname a direct page request
+ * would use when the default locale is inferred. This test grounds on that
+ * upstream e2e test (test/e2e/middleware-matcher/index.test.ts, the
+ * "matched data paths, including the default locale without a prefix" case) by
+ * exercising the exact remap logic with the shipped dist helpers, and by
+ * asserting the compiled router source contains the locale remap.
+ */
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+
+const {
+  normalizeLocalePath,
+} = require('../dist/shared/lib/i18n/normalize-locale-path')
+const {
+  addPathPrefix,
+} = require('../dist/shared/lib/router/utils/add-path-prefix')
+
+const locales = ['es', 'en']
+const defaultLocale = 'en'
+
+// Mirror of the patched middleware_next_data remap: given an already
+// data-normalized pathname, produce the internal pathname used for matcher
+// checks. Locale-less paths must be remapped under the default locale.
+function remapForMiddlewareMatch(normalized) {
+  const curLocaleResult = normalizeLocalePath(normalized, locales)
+  if (curLocaleResult.detectedLocale) {
+    return normalized
+  }
+  if (defaultLocale && !curLocaleResult.pathname.startsWith('/_next/')) {
+    return addPathPrefix(
+      curLocaleResult.pathname === '/'
+        ? `/${defaultLocale}`
+        : addPathPrefix(curLocaleResult.pathname || '', `/${defaultLocale}`)
+    )
+  }
+  return normalized
+}
+
+function run(name, fn) {
+  fn()
+  // eslint-disable-next-line no-console
+  console.log('ok - ' + name)
+}
+
+run('locale-less data route is remapped under the default locale', () => {
+  // This is the vulnerable path: without the fix "/middleware/works" stays
+  // locale-less and skips the "/en/middleware/works" matcher.
+  assert.strictEqual(
+    remapForMiddlewareMatch('/middleware/works'),
+    '/en/middleware/works'
+  )
+})
+
+run('root data route is remapped to the default locale', () => {
+  assert.strictEqual(remapForMiddlewareMatch('/'), '/en')
+})
+
+run('explicit non-default locale is preserved (not double-prefixed)', () => {
+  assert.strictEqual(
+    remapForMiddlewareMatch('/es/middleware/works'),
+    '/es/middleware/works'
+  )
+})
+
+run('explicit default locale is preserved', () => {
+  assert.strictEqual(
+    remapForMiddlewareMatch('/en/middleware/works'),
+    '/en/middleware/works'
+  )
+})
+
+run('compiled resolve-routes carries the locale remap fix', () => {
+  const cjs = fs.readFileSync(
+    path.join(__dirname, '../dist/server/lib/router-utils/resolve-routes.js'),
+    'utf8'
+  )
+  const esm = fs.readFileSync(
+    path.join(
+      __dirname,
+      '../dist/esm/server/lib/router-utils/resolve-routes.js'
+    ),
+    'utf8'
+  )
+  for (const src of [cjs, esm]) {
+    const idx = src.indexOf('middleware_next_data')
+    assert.ok(idx !== -1, 'middleware_next_data handler present')
+    const tail = src.slice(idx)
+    assert.ok(
+      /!curLocaleResult\.pathname\.startsWith\("\/_next\/"\)/.test(tail),
+      'default-locale remap guard present in middleware_next_data'
+    )
+  }
+})
+
+// Jest compatibility: if run under jest, register as a test too.
+if (typeof describe === 'function' && typeof it === 'function') {
+  describe('CVE-2026-44573 i18n default-locale data route middleware match', () => {
+    it('remaps locale-less data routes under the default locale', () => {
+      assert.strictEqual(
+        remapForMiddlewareMatch('/middleware/works'),
+        '/en/middleware/works'
+      )
+      assert.strictEqual(
+        remapForMiddlewareMatch('/es/middleware/works'),
+        '/es/middleware/works'
+      )
+    })
+  })
+}

