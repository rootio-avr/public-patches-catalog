+/**
+ * Regression test for GHSA-8h8q-6873-q5fj (CVE-2026-23870).
+ *
+ * Denial of Service in the vendored React Server Components deserializer used
+ * by Next.js App Router Server Functions. A crafted request body can encode
+ * mutually-referential promise chunks (e.g. row 0 = "$@1", row 1 = "$@0").
+ * When such a payload is deserialized, following the thenable chain during
+ * chunk resolution loops forever, hanging the server (CWE-770 / CWE-400).
+ *
+ * The fix adds cyclic-thenable protection to Chunk.prototype.then in the
+ * compiled react-server-dom-webpack / react-server-dom-turbopack server
+ * bundles: a self/visited/bounded check that rejects with
+ * "Cannot have cyclic thenables." instead of spinning.
+ *
+ * This test drives decodeReply() from the compiled server bundle directly
+ * (the same entry point Next.js uses via react-server-dom-webpack/server.node)
+ * with (a) a benign control payload that must resolve, and (b) the cyclic
+ * payload that must settle quickly with a rejection rather than time out.
+ *
+ * Grounded on the reproduction probe from the advisory (no upstream regression
+ * test ships with the vendored-bundle fix).
+ */
+
+const assert = require('assert')
+const path = require('path')
+
+const serverBundlePath = path.join(
+  __dirname,
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.development.js'
+)
+
+const { decodeReply } = require(serverBundlePath)
+
+function withTimeout(promise, ms, label) {
+  let timer
+  const guard = new Promise((_resolve, reject) => {
+    timer = setTimeout(() => {
+      reject(new Error('TIMEOUT: ' + label + ' did not settle within ' + ms + 'ms'))
+    }, ms)
+  })
+  return Promise.race([promise, guard]).finally(() => clearTimeout(timer))
+}
+
+async function run() {
+  // (a) Control: a well-formed payload must still decode successfully.
+  const control = new FormData()
+  control.set('0', '"control"')
+  const decoded = await withTimeout(
+    Promise.resolve(decodeReply(control, {})),
+    5000,
+    'control decode'
+  )
+  assert.strictEqual(decoded, 'control', 'benign payload should decode to its value')
+
+  // (b) Attack: two chunks that reference each other as promises form a cycle.
+  //     Pre-fix this hangs forever; post-fix it must settle (reject) quickly.
+  const cyclic = new FormData()
+  cyclic.set('0', '"$@1"')
+  cyclic.set('1', '"$@0"')
+
+  let rejected = false
+  let rejectionMessage = ''
+  try {
+    await withTimeout(
+      Promise.resolve(decodeReply(cyclic, {})),
+      5000,
+      'cyclic decode'
+    )
+  } catch (err) {
+    rejected = true
+    rejectionMessage = String(err && err.message)
+  }
+
+  assert.ok(
+    rejected,
+    'cyclic thenable payload must not resolve normally; it should be rejected'
+  )
+  assert.ok(
+    !rejectionMessage.startsWith('TIMEOUT:'),
+    'cyclic thenable payload must be rejected promptly, not hang (got: ' +
+      rejectionMessage +
+      ')'
+  )
+  assert.ok(
+    /cyclic thenables/i.test(rejectionMessage),
+    'cyclic thenable payload should be rejected with the cyclic-thenables guard (got: ' +
+      rejectionMessage +
+      ')'
+  )
+}
+
