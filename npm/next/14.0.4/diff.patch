+"use strict";
+// Regression test for CVE-2024-51479 (GHSA-7gfc-8cq8-jh5f).
+// The fix adds I18NProvider.validateQuery(), which rejects requests whose
+// internal locale query params (__nextLocale / __nextDefaultLocale) are not
+// among the configured locales. This closes the routing/authorization bypass
+// where an attacker could inject forged locale query params to manipulate the
+// resolved pathname used by pathname-based middleware authorization.
+const { I18NProvider } = require("./i18n-provider");
+
+describe("CVE-2024-51479: I18NProvider.validateQuery", () => {
+    const provider = new I18NProvider({
+        defaultLocale: "en",
+        locales: [
+            "en",
+            "fr",
+            "en-CA"
+        ],
+        domains: []
+    });
+
+    it("accepts a query with no locale params", () => {
+        expect(provider.validateQuery({})).toBe(true);
+    });
+
+    it("accepts valid configured locale params (case-insensitive)", () => {
+        expect(provider.validateQuery({
+            __nextLocale: "fr"
+        })).toBe(true);
+        expect(provider.validateQuery({
+            __nextLocale: "EN-ca"
+        })).toBe(true);
+    });
+
+    it("rejects a forged __nextLocale that is not a configured locale", () => {
+        expect(provider.validateQuery({
+            __nextLocale: "de"
+        })).toBe(false);
+        expect(provider.validateQuery({
+            __nextLocale: "../admin"
+        })).toBe(false);
+    });
+
+    it("rejects a forged __nextDefaultLocale that is not a configured locale", () => {
+        expect(provider.validateQuery({
+            __nextDefaultLocale: "evil"
+        })).toBe(false);
+    });
+});
