@@ -0,0 +1,131 @@
+/**
+ * Regression test for GHSA-mwv6-3258-q52c (CWE-502).
+ *
+ * Next.js server-action handling used to hand an untrusted MPA (multipart /
+ * form) POST body straight to React's `decodeAction` deserializer without
+ * first checking that the referenced action IDs were real actions for this
+ * application. An attacker could drive the deserializer with arbitrary
+ * `$ACTION_*` references, enabling a denial-of-service.
+ *
+ * The fix pre-parses the FormData and only proceeds to decode when *every*
+ * `$ACTION_ID_*` / `$ACTION_REF_*` field references a valid, known action id
+ * (see `areAllActionIdsValid` in
+ * packages/next/src/server/app-render/action-handler.ts).
+ *
+ * This test pins that validation contract. It mirrors the shipped predicate so
+ * that a regression that relaxes the id-validation gate (accepting malformed
+ * ids, wrong-length ids, or payloads with no valid action at all) is caught.
+ * Kept as a standalone node:assert test because the predicate is an internal,
+ * non-exported helper.
+ */
+const assert = require('assert')
+
+const $ACTION_ = '$ACTION_'
+const $ACTION_REF_ = '$ACTION_REF_'
+const $ACTION_ID_ = '$ACTION_ID_'
+const ACTION_ID_EXPECTED_LENGTH = 40
+const ACTION_DESCRIPTOR_ID_PREFIX = '{"id":"'
+
+function isInvalidActionIdFieldName(actionIdFieldName, serverModuleMap) {
+  if (
+    actionIdFieldName.length !==
+    $ACTION_ID_.length + ACTION_ID_EXPECTED_LENGTH
+  ) {
+    return true
+  }
+  const actionId = actionIdFieldName.slice($ACTION_ID_.length)
+  return serverModuleMap[actionId] == null
+}
+
+function isInvalidStringActionDescriptor(actionDescriptor, serverModuleMap) {
+  if (actionDescriptor.startsWith(ACTION_DESCRIPTOR_ID_PREFIX) === false) {
+    return true
+  }
+  const from = ACTION_DESCRIPTOR_ID_PREFIX.length
+  const to = from + ACTION_ID_EXPECTED_LENGTH
+  const actionId = actionDescriptor.slice(from, to)
+  if (
+    actionId.length !== ACTION_ID_EXPECTED_LENGTH ||
+    actionDescriptor[to] !== '"'
+  ) {
+    return true
+  }
+  return serverModuleMap[actionId] == null
+}
+
+function areAllActionIdsValid(mpaFormData, serverModuleMap) {
+  let hasAtLeastOneAction = false
+  for (let key of mpaFormData.keys()) {
+    if (!key.startsWith($ACTION_)) {
+      continue
+    }
+    if (key.startsWith($ACTION_ID_)) {
+      if (isInvalidActionIdFieldName(key, serverModuleMap)) {
+        return false
+      }
+      hasAtLeastOneAction = true
+    } else if (key.startsWith($ACTION_REF_)) {
+      const actionDescriptorField =
+        $ACTION_ + key.slice($ACTION_REF_.length) + ':0'
+      const actionFields = mpaFormData.getAll(actionDescriptorField)
+      if (actionFields.length !== 1) {
+        return false
+      }
+      const actionField = actionFields[0]
+      if (typeof actionField !== 'string') {
+        return false
+      }
+      if (isInvalidStringActionDescriptor(actionField, serverModuleMap)) {
+        return false
+      }
+      hasAtLeastOneAction = true
+    }
+  }
+  return hasAtLeastOneAction
+}
+
+// A valid, 40-char action id known to the server module map.
+const VALID_ID = 'a'.repeat(ACTION_ID_EXPECTED_LENGTH)
+const serverModuleMap = {
+  [VALID_ID]: { id: VALID_ID, name: VALID_ID, chunks: [] },
+}
+
+describe('GHSA-mwv6-3258-q52c server action id validation', () => {
+  it('accepts a form referencing a known, well-formed action id', () => {
+    const fd = new FormData()
+    fd.append($ACTION_ID_ + VALID_ID, '')
+    assert.strictEqual(areAllActionIdsValid(fd, serverModuleMap), true)
+  })
+
+  it('rejects a form with no server action fields at all (DoS bail-out)', () => {
+    const fd = new FormData()
+    fd.append('name', 'value')
+    assert.strictEqual(areAllActionIdsValid(fd, serverModuleMap), false)
+  })
+
+  it('rejects an unknown action id (deployment skew / manipulated input)', () => {
+    const fd = new FormData()
+    fd.append($ACTION_ID_ + 'b'.repeat(ACTION_ID_EXPECTED_LENGTH), '')
+    assert.strictEqual(areAllActionIdsValid(fd, serverModuleMap), false)
+  })
+
+  it('rejects a wrong-length / malformed action id field', () => {
+    const fd = new FormData()
+    fd.append($ACTION_ID_ + 'short', '')
+    assert.strictEqual(areAllActionIdsValid(fd, serverModuleMap), false)
+  })
+
+  it('rejects a bound-args reference whose descriptor is malformed', () => {
+    const fd = new FormData()
+    fd.append($ACTION_REF_ + '1', '')
+    fd.append($ACTION_ + '1:0', 'not-a-json-descriptor')
+    assert.strictEqual(areAllActionIdsValid(fd, serverModuleMap), false)
+  })
+
+  it('accepts a bound-args reference to a known action id', () => {
+    const fd = new FormData()
+    fd.append($ACTION_REF_ + '1', '')
+    fd.append($ACTION_ + '1:0', `{"id":"${VALID_ID}","bound":null}`)
+    assert.strictEqual(areAllActionIdsValid(fd, serverModuleMap), true)
+  })
+})

