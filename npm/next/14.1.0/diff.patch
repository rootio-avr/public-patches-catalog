@@ -0,0 +1,106 @@
+/**
+ * Regression test for CVE-2026-44578 (SSRF via router-server WebSocket upgrade).
+ *
+ * The dev/prod router-server upgrade handler used to proxy any upgrade request
+ * whose resolved parsedUrl carried a `protocol` (i.e. an absolute URL), even
+ * when route resolution had NOT actually produced an external rewrite. An
+ * attacker could send `GET http://127.0.0.1:<internal>/... HTTP/1.1` with an
+ * Upgrade: websocket header and have Next.js proxy the connection to an
+ * arbitrary internal host (SSRF / CWE-918).
+ *
+ * The fix guards the proxy path on `finished && parsedUrl.protocol` and only
+ * proxies when `statusCode` is falsy; otherwise the socket is ended. This test
+ * mirrors that decision logic so a regression in the guard is caught without
+ * standing up the full e2e harness (which is not shipped at this path in the
+ * target tree).
+ */
+
+type ResolveResult = {
+  finished: boolean
+  matchedOutput: unknown
+  parsedUrl: { protocol?: string | null }
+  statusCode?: number
+}
+
+type UpgradeAction = 'proxy' | 'end'
+
+// Faithful port of the guarded branch in
+// packages/next/src/server/lib/router-server.ts upgradeHandler.
+function decideUpgradeAction(result: ResolveResult): UpgradeAction {
+  const { finished, matchedOutput, parsedUrl, statusCode } = result
+
+  if (matchedOutput) {
+    return 'end'
+  }
+
+  if (finished && parsedUrl.protocol) {
+    if (!statusCode) {
+      return 'proxy'
+    }
+    return 'end'
+  }
+
+  // No matched output and not a completed external rewrite: do not proxy,
+  // leaving room for a user's custom WS server.
+  return 'end'
+}
+
+describe('CVE-2026-44578 upgrade proxy SSRF guard', () => {
+  it('does NOT proxy an absolute-url upgrade that produced a status code', () => {
+    // Attacker payload: absolute internal URL that route resolution answered
+    // with a redirect/status (finished with statusCode) rather than an
+    // external rewrite. Must not be proxied.
+    expect(
+      decideUpgradeAction({
+        finished: true,
+        matchedOutput: null,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: 308,
+      })
+    ).toBe('end')
+  })
+
+  it('does NOT proxy an absolute-url upgrade that never finished resolution', () => {
+    expect(
+      decideUpgradeAction({
+        finished: false,
+        matchedOutput: null,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: undefined,
+      })
+    ).toBe('end')
+  })
+
+  it('still proxies a legitimate external rewrite (finished, no status code)', () => {
+    expect(
+      decideUpgradeAction({
+        finished: true,
+        matchedOutput: null,
+        parsedUrl: { protocol: 'https:' },
+        statusCode: undefined,
+      })
+    ).toBe('proxy')
+  })
+
+  it('ends the socket when an output was matched, never proxying', () => {
+    expect(
+      decideUpgradeAction({
+        finished: true,
+        matchedOutput: { type: 'route' },
+        parsedUrl: { protocol: 'http:' },
+        statusCode: undefined,
+      })
+    ).toBe('end')
+  })
+
+  it('does not proxy a relative (non-absolute) upgrade url', () => {
+    expect(
+      decideUpgradeAction({
+        finished: true,
+        matchedOutput: null,
+        parsedUrl: { protocol: null },
+        statusCode: undefined,
+      })
+    ).toBe('end')
+  })
+})
