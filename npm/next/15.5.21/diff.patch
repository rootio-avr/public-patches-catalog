+/* eslint-env jest */
+// Regression test for CVE-2026-75604: path traversal via backslashes in
+// incremental-cache segments when deployed on Windows. The fix extends
+// escapePathDelimiters (dist) to also escape the backslash delimiter so a
+// crafted segment cannot traverse outside the on-disk cache root.
+const escapePathDelimiters =
+  require('next/dist/shared/lib/router/utils/escape-path-delimiters').default
+
+describe('CVE-2026-75604 escapePathDelimiters backslash handling', () => {
+  it('escapes literal backslashes so they cannot act as path separators', () => {
+    expect(escapePathDelimiters('a\\b')).toBe('a%5Cb')
+  })
+
+  it('escapes a traversal segment containing backslashes', () => {
+    expect(escapePathDelimiters('..\\..\\server-reference-manifest')).toBe(
+      '..%5C..%5Cserver-reference-manifest'
+    )
+  })
+
+  it('still escapes forward slashes, hashes and question marks', () => {
+    expect(escapePathDelimiters('a/b#c?d')).toBe('a%2Fb%23c%3Fd')
+  })
+
+  it('escapes percent-encoded delimiters when escapeEncoded is set', () => {
+    expect(escapePathDelimiters('a%2fb%5cc', true)).toBe('a%252fb%255cc')
+  })
+
+  it('leaves ordinary segments untouched', () => {
+    expect(escapePathDelimiters('seed')).toBe('seed')
+  })
+})

