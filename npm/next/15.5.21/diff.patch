+/**
+ * Regression test for GHSA-2464-fhr4-w9xw (sharp/libvips memory-handling flaw
+ * reachable through the Next.js Image Optimization API with SVG input).
+ *
+ * Upstream fix commits 5e3b687b / 9571ec89 ("Bump `sharp`") raise the sharp
+ * floor to the patched 0.35.5 release. The upstream suite does not cover this
+ * (dependency-range bump only), so this replacement asserts that the shipped
+ * manifest allows the patched sharp line, and that any sharp resolved from
+ * next's own dependency tree is not an unpatched 0.35.x release.
+ */
+const assert = require('node:assert')
+const path = require('node:path')
+
+const pkg = require('next/package.json')
+const range = pkg.optionalDependencies && pkg.optionalDependencies.sharp
+assert.ok(range, 'next must declare sharp as an optional dependency')
+assert.ok(
+  range.includes('^0.35.5'),
+  `sharp range must permit the patched ^0.35.5 line, got: ${range}`
+)
+assert.ok(
+  !range.includes('^0.35.4'),
+  `sharp range must not reference the vulnerable ^0.35.4 line, got: ${range}`
+)
+
+let sharpPkg = null
+try {
+  const nextDir = path.dirname(require.resolve('next/package.json'))
+  sharpPkg = require(require.resolve('sharp/package.json', { paths: [nextDir] }))
+} catch {
+  // sharp is optional; nothing further to check when it is not installed.
+}
+if (sharpPkg) {
+  const [maj, min, patch] = sharpPkg.version.split('.').map(Number)
+  if (maj === 0 && min === 35) {
+    assert.ok(
+      patch >= 5,
+      `installed sharp ${sharpPkg.version} is in the vulnerable 0.35.x range`
+    )
+  }
+}
+
+console.log('GHSA-2464-fhr4-w9xw regression test passed')

