@@ -0,0 +1,63 @@
+// Regression test for CVE-2024-46982 (Next.js pages-router SSR cache poisoning).
+//
+// Upstream fix commit 7ed7f125e07ef0517a331009ed7e32691ba403d3 ("Remove invalid
+// fallback revalidate value", PR #69990) ships only HTTP standalone-mode
+// integration tests under test/production/standalone-mode/... which are NOT
+// included in the published npm tarball (which contains compiled dist/ JS only).
+// This dist-level regression guards the two shipped code paths the fix touches
+// so the invalid fallback `revalidate: 1` cannot be reintroduced into the
+// tarball artifact.
+//
+// Root cause: a non-dynamic SSR route that returns no `revalidate` value was
+// given a fallback of `1`, causing Next.js to emit
+// `Cache-Control: s-maxage=1, stale-while-revalidate`, which upstream CDNs may
+// cache -> cache poisoning. The fix removes that fallback in base-server and
+// forces `revalidate = 0` on the getServerSideProps path in render.
+
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+
+function distFile(rel) {
+  // Resolve relative to the installed `next` package root.
+  const pkgJson = require.resolve('next/package.json')
+  return path.join(path.dirname(pkgJson), rel)
+}
+
+const baseServerTargets = [
+  'dist/server/base-server.js',
+  'dist/esm/server/base-server.js',
+]
+const renderTargets = ['dist/server/render.js', 'dist/esm/server/render.js']
+
+// 1. base-server must NOT contain the vulnerable fallback default of 1.
+for (const rel of baseServerTargets) {
+  const src = fs.readFileSync(distFile(rel), 'utf8')
+  assert.ok(
+    !/default to minimum revalidate \(this should be an invariant\)/.test(src),
+    `${rel}: vulnerable fallback-revalidate comment must be removed`
+  )
+  assert.ok(
+    !/revalidate:\s*result\.revalidate\s*!==\s*undefined\s*\?\s*result\.revalidate\s*:/.test(
+      src
+    ),
+    `${rel}: vulnerable ternary fallback of revalidate must be removed`
+  )
+  assert.ok(
+    /revalidate:\s*result\.revalidate\b/.test(src),
+    `${rel}: revalidate must be passed through verbatim`
+  )
+}
+
+// 2. render must force revalidate = 0 on the getServerSideProps error/guard path.
+for (const rel of renderTargets) {
+  const src = fs.readFileSync(distFile(rel), 'utf8')
+  assert.ok(
+    /canAccessRes\s*=\s*false;\s*renderResultMeta\.revalidate\s*=\s*0;/.test(
+      src.replace(/\s+/g, ' ')
+    ),
+    `${rel}: renderResultMeta.revalidate = 0 must follow canAccessRes = false`
+  )
+}
+
+console.log('CVE-2024-46982 dist-level regression test passed')

Description: Fix CVE-2024-51479 - Next.js i18n authorization bypass via crafted locale query params
 When an application relies on i18n locale prefixes for authorization
 decisions, a request could inject the internal locale query parameters
 (__nextLocale, __nextDefaultLocale, __nextInferredLocaleFromDefault)
 directly in the URL query string. Because the server trusted these
 pre-populated internal params without validating them against the
 configured locales, an attacker could set a locale value that was never
 configured (or set locale params while i18n was disabled) to reach paths
 or bypass path-prefix based authorization that would otherwise be gated
 by the locale segment.
 .
 This backport of upstream commit 1c8234eb20bc8afd396b89999a00f06b61d72d7b
 (PR #70976, [i18n] Routing fix #70761) hardens the request pipeline:
   * I18NProvider gains validate()/validateQuery() to check that any
     locale supplied in the query is one of the configured (lower-cased)
     locales.
   * base-server strips the internal locale query params whenever i18n is
     not configured or validateQuery() rejects the supplied values.
   * resolve-routes strips the internal locale query params when i18n is
     not configured at all.
 The published next@14.0.3 npm artifact ships transpiled JavaScript under
 dist/ (CJS) and dist/esm/ (ESM), so the equivalent changes are applied to
 the compiled bundles rather than the packages/next/src TypeScript sources.
Origin: backport, https://github.com/vercel/next.js/commit/1c8234eb20bc8afd396b89999a00f06b61d72d7b
Bug: CVE-2024-51479
