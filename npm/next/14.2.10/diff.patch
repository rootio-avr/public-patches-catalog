--- /dev/null
+++ b/test/cve-2025-29927.test.js
@@ -0,0 +1,49 @@
+// Regression test for CVE-2025-29927 (Next.js middleware authorization bypass
+// via a spoofed x-middleware-subrequest header). The npm artifact ships only
+// compiled JS and no upstream tests, so this exercises the shipped compiled
+// filterInternalHeaders helper directly. Grounded on the upstream fix
+// (vercel/next.js #77201 / #77202): a spoofed subrequest header without the
+// per-session id must be stripped, a legitimate one with the matching id must
+// survive, and unconditionally-internal headers must always be stripped.
+const assert = require('assert');
+const {
+  filterInternalHeaders,
+} = require('../dist/server/lib/server-ipc/utils.js');
+
+const SUBREQUEST_ID_SYMBOL = Symbol.for('@next/middleware-subrequest-id');
+globalThis[SUBREQUEST_ID_SYMBOL] = 'test-session-id';
+
+// 1. Spoofed x-middleware-subrequest with no / wrong id is removed.
+const spoofed = {
+  'x-middleware-subrequest':
+    'middleware:middleware:middleware:middleware:middleware',
+  host: 'example.com',
+};
+filterInternalHeaders(spoofed);
+assert.ok(
+  !('x-middleware-subrequest' in spoofed),
+  'spoofed x-middleware-subrequest must be stripped'
+);
+assert.strictEqual(spoofed.host, 'example.com', 'unrelated header preserved');
+
+// 2. Legitimate subrequest carrying the matching session id is preserved.
+const legit = {
+  'x-middleware-subrequest': 'pages/_middleware',
+  'x-middleware-subrequest-id': 'test-session-id',
+};
+filterInternalHeaders(legit);
+assert.strictEqual(
+  legit['x-middleware-subrequest'],
+  'pages/_middleware',
+  'legitimate subrequest with matching id must be preserved'
+);
+
+// 3. Internal-only headers are always stripped from external requests.
+const internal = { 'x-middleware-rewrite': '/internal' };
+filterInternalHeaders(internal);
+assert.ok(
+  !('x-middleware-rewrite' in internal),
+  'internal header must be stripped'
+);
+
+console.log('CVE-2025-29927 regression test passed');

