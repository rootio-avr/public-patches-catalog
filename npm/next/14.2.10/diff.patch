+/**
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864).
+ *
+ * DoS via prototype pollution: a crafted React Flight (RSC) payload whose
+ * object key is "__proto__" was written back to its parent object through the
+ * deferred dynamic-key assignment inside createModelResolver
+ * (`parentObject[key] = value`). Because that uses ordinary [[Set]] semantics,
+ * a "__proto__" key polluted Object.prototype, enabling denial of service on
+ * any App Router Server Function endpoint.
+ *
+ * Fix (backport of upstream 99b450109dfd): reject the "__proto__" key at every
+ * Flight deserialization assignment site across all vendored
+ * react-server-dom-{webpack,turbopack}{,-experimental} bundles (development,
+ * production and minified variants).
+ *
+ * This test has no external dependencies; it is collectable by plain `node`
+ * as well as by jest (it uses node:assert and, if present, jest's describe/it).
+ */
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+
+const COMPILED = path.join(
+  __dirname,
+  '..',
+  '..',
+  'dist',
+  'compiled'
+);
+
+const PKGS = [
+  'react-server-dom-webpack',
+  'react-server-dom-turbopack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack-experimental',
+];
+
+function collectBundles() {
+  const files = [];
+  for (const pkg of PKGS) {
+    const cjs = path.join(COMPILED, pkg, 'cjs');
+    if (!fs.existsSync(cjs)) continue;
+    for (const fn of fs.readdirSync(cjs)) {
+      if (fn.endsWith('.js')) files.push(path.join(cjs, fn));
+    }
+  }
+  return files;
+}
+
+// A bundle is "vulnerable-shaped" if it contains the Flight model resolver
+// deferred assignment. We detect both the readable (dev/prod) form and the
+// minified form.
+const UNGUARDED_READABLE = /parentObject\[key\] = value;/;
+const GUARDED_READABLE = /"__proto__" !== key && \(parentObject\[key\] = value\);/;
+// Minified resolver: `return function(V){OBJ[KEY]=V;` (unguarded) vs
+// `return function(V){"__proto__"!==KEY&&(OBJ[KEY]=V);` (guarded).
+const MIN_UNGUARDED = /return function\(([A-Za-z0-9_$]+)\)\{([A-Za-z0-9_$]+)\[([A-Za-z0-9_$]+)\]=\1;/;
+const MIN_GUARDED = /return function\(([A-Za-z0-9_$]+)\)\{"__proto__"!==([A-Za-z0-9_$]+)&&\(([A-Za-z0-9_$]+)\[\2\]=\1\);/;
+// Candidacy (form-agnostic): the deferred deps-counting resolver closure.
+const MIN_CANDIDATE = /\.deps--;0===[A-Za-z0-9_$]+\.deps/;
+
+function auditBundles() {
+  const bundles = collectBundles();
+  assert.ok(bundles.length > 0, 'expected to find compiled react-server-dom bundles');
+
+  let audited = 0;
+  for (const file of bundles) {
+    const src = fs.readFileSync(file, 'utf8');
+    const isMin = file.endsWith('.min.js');
+
+    if (isMin) {
+      if (MIN_CANDIDATE.test(src)) {
+        audited++;
+        assert.ok(
+          MIN_GUARDED.test(src),
+          `Flight resolver in ${file} is missing the "__proto__" guard (prototype pollution DoS not mitigated)`
+        );
+        assert.ok(
+          !MIN_UNGUARDED.test(src),
+          `Flight resolver in ${file} still contains the unguarded minified assignment`
+        );
+      }
+    } else if (src.indexOf('parentObject[key]') !== -1) {
+      audited++;
+      assert.ok(
+        GUARDED_READABLE.test(src),
+        `Flight resolver in ${file} is missing the "__proto__" guard (prototype pollution DoS not mitigated)`
+      );
+      assert.ok(
+        !UNGUARDED_READABLE.test(src),
+        `Flight resolver in ${file} still contains the unguarded assignment`
+      );
+    }
+  }
+  // All four packages ship dev/prod/min server+client entrypoints with the
+  // resolver; expect a substantial number of guarded sites.
+  assert.ok(
+    audited >= 90,
+    `expected to audit >= 90 resolver sites, only audited ${audited}`
+  );
+}
+
+// Behavioral check: the guarded-assignment idiom must reject "__proto__"
+// (leaving Object.prototype untouched) while preserving normal keys.
+function assignGuarded(target, key, value) {
+  '__proto__' !== key && (target[key] = value);
+}
+
+function behaviorRejectsProtoPollution() {
+  const victim = {};
+  assignGuarded(victim, '__proto__', { polluted: true });
+  // Prototype must NOT be polluted.
+  assert.strictEqual(({}).polluted, undefined, 'Object.prototype was polluted');
+  assert.strictEqual(victim.polluted, undefined);
+
+  // Normal keys still assigned.
+  assignGuarded(victim, 'safe', 42);
+  assert.strictEqual(victim.safe, 42);
+}
+
+if (typeof describe === 'function' && typeof it === 'function') {
+  describe('GHSA-h25m-26qc-wcjf: React Flight __proto__ DoS mitigation', () => {
+    it('guards every compiled Flight deserialization assignment site', auditBundles);
+    it('rejects __proto__ assignment without polluting Object.prototype', behaviorRejectsProtoPollution);
+  });
+} else {
+  auditBundles();
+  behaviorRejectsProtoPollution();
+  // eslint-disable-next-line no-console
+  console.log('OK: GHSA-h25m-26qc-wcjf regression test passed');
+}
