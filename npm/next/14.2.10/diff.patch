+++ b/dist/test/unit/rsc-cyclic-model-dos.test.js
@@ -0,0 +1,104 @@
+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 (CWE-770)
+ *
+ * The vendored React Server Components flight deserializer reconstructs
+ * Map/Set values inline in parseModelString() (cases 'Q' and 'W') via
+ * `new Map(data)` / `new Set(data)`. Prior to this patch there was no
+ * "already consumed" guard, so an attacker-supplied cyclic (self-referential)
+ * model could be re-consumed without bound, causing unbounded CPU/memory
+ * consumption (Denial of Service).
+ *
+ * The synthesized fix marks the initializer as consumed BEFORE construction:
+ *   if (Array.isArray(data)) {
+ *     if (true === data.$$consumed) throw Error("Already initialized Map.");
+ *     data.$$consumed = true;
+ *   }
+ * so a cyclic initializer that re-enters the same construction site throws
+ * instead of looping.
+ */
+const fs = require('fs')
+const path = require('path')
+
+const COMPILED_DIR = path.join(__dirname, '..', '..', 'compiled')
+
+function serverBundleFiles() {
+  const files = []
+  const packages = fs
+    .readdirSync(COMPILED_DIR)
+    .filter((d) => /^react-server-dom-(webpack|turbopack)(-experimental)?$/.test(d))
+  for (const pkg of packages) {
+    const cjsDir = path.join(COMPILED_DIR, pkg, 'cjs')
+    if (!fs.existsSync(cjsDir)) continue
+    for (const f of fs.readdirSync(cjsDir)) {
+      if (/-server\..*\.js$/.test(f) && !f.endsWith('.min.js')) {
+        files.push(path.join(cjsDir, f))
+      }
+    }
+  }
+  return files
+}
+
+describe('GHSA-q4gf-8mx6-v5v3: RSC cyclic-model DoS re-entrancy guard', () => {
+  const files = serverBundleFiles()
+
+  it('finds vendored RSC server bundles to check', () => {
+    expect(files.length).toBeGreaterThan(0)
+  })
+
+  it.each(files.map((f) => [path.relative(COMPILED_DIR, f), f]))(
+    'guards Map/Set construction against double-consumption in %s',
+    (_rel, file) => {
+      const src = fs.readFileSync(file, 'utf8')
+      // Every inline Map initializer must be preceded by the consumed guard.
+      const mapCtor = (src.match(/return new Map\(\w+\);/g) || []).length
+      const setCtor = (src.match(/return new Set\(\w+\);/g) || []).length
+      const mapGuard = (src.match(/throw Error\("Already initialized Map\."\)/g) || [])
+        .length
+      const setGuard = (src.match(/throw Error\("Already initialized Set\."\)/g) || [])
+        .length
+      // Consumed flag must be set before construction (TOCTOU closed).
+      expect(mapGuard).toBeGreaterThanOrEqual(mapCtor)
+      expect(setGuard).toBeGreaterThanOrEqual(setCtor)
+      expect(src).toContain('$$consumed = true')
+    }
+  )
+
+  it('guard semantics: a cyclic initializer is consumed at most once', () => {
+    // Model the exact guard the patch inserts before `new Map(data)`.
+    function guardedBuildMap(data) {
+      if (Array.isArray(data)) {
+        if (true === data.$$consumed) throw Error('Already initialized Map.')
+        data.$$consumed = true
+      }
+      return new Map(data)
+    }
+
+    // A self-referential (cyclic) initializer: an entry whose value resolves
+    // back to the same initializer array.
+    const cyclic = []
+    cyclic.push(['self', cyclic])
+
+    // First consumption succeeds and marks the array.
+    expect(() => guardedBuildMap(cyclic)).not.toThrow()
+    // Re-entering the same initializer (the cycle) now throws instead of
+    // looping forever.
+    expect(() => guardedBuildMap(cyclic)).toThrow('Already initialized Map.')
+  })
+
+  it('guard semantics: normal (non-cyclic) input still builds a Map/Set', () => {
+    function guardedBuildMap(data) {
+      if (Array.isArray(data)) {
+        if (true === data.$$consumed) throw Error('Already initialized Map.')
+        data.$$consumed = true
+      }
+      return new Map(data)
+    }
+    const m = guardedBuildMap([
+      ['a', 1],
+      ['b', 2],
+    ])
+    expect(m.get('a')).toBe(1)
+    expect(m.get('b')).toBe(2)
+    expect(m.size).toBe(2)
+  })
+})

Description: GHSA-h25m-26qc-wcjf / CVE-2026-23864 - DoS / prototype pollution
 via __proto__ key injection during React Flight (RSC) deserialization on
 Next.js App Router Server Function endpoints.
 .
 During Flight model resolution, deferred chunk values are written back to
 their parent object via a dynamic-key assignment (parentObject[key] = value)
 inside createModelResolver. Because this uses the ordinary [[Set]] semantics
 (unlike JSON.parse's own reviver, which uses define-own-property), a payload
 whose key is "__proto__" pollutes Object.prototype, enabling denial of
 service (excessive CPU / OOM / crashes) on any App Router Server Function.
 .
 This backports the upstream mitigation (commit 99b450109dfd, "Sync DoS
 mitigations for React Flight") by rejecting the "__proto__" key at every
 Flight deserialization assignment site across all vendored
 react-server-dom-{webpack,turbopack}{,-experimental} bundles (development,
 production and minified variants) shipped with next@14.2.10. The guard is
 hand-re-implemented against 14.2.10's own React 18.3.0-canary bundle layout,
 since the upstream commit targets a divergent React 19-rc bundle and cannot
 be cherry-picked directly.
