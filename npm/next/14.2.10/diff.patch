--- /dev/null
+++ b/test/cve-2026-44578.test.js
@@ -0,0 +1,88 @@
+/**
+ * Regression test for CVE-2026-44578 (GHSA-c4j6-fc7j-m34r)
+ *
+ * SSRF via crafted WebSocket upgrade requests in the self-hosted Node.js
+ * server. The router-server upgrade handler used to proxy any upgrade
+ * request whose resolved URL had a `protocol` set, without applying the
+ * same finished/statusCode safety checks that normal HTTP requests get
+ * from resolveRoutes. An attacker could send an absolute-URL upgrade
+ * request and make the server proxy to arbitrary internal/external hosts.
+ *
+ * The fix guards the proxy branch so an upgrade request is only proxied
+ * when resolveRoutes reported `finished && parsedUrl.protocol` AND did NOT
+ * set a `statusCode` (i.e. it was legitimately rewritten to an external
+ * destination). Otherwise the socket is closed.
+ *
+ * This mirrors the upstream e2e assertion
+ * (test/e2e/rewrite-request-smuggling) — an absolute-URL upgrade with no
+ * external rewrite must NOT be proxied — at the unit level, since that
+ * heavy e2e harness is not shipped in this target tree.
+ */
+const assert = require('assert')
+
+// Mirror of the guarded decision from
+// packages/next/src/server/lib/router-server.ts upgradeHandler.
+function shouldProxyUpgrade({ matchedOutput, finished, parsedUrl, statusCode }) {
+  if (matchedOutput) {
+    return false // handled internally, socket ends
+  }
+  if (finished && parsedUrl.protocol) {
+    if (!statusCode) {
+      return true // legitimate external rewrite -> proxy
+    }
+    return false // resolveRoutes already produced a response -> close
+  }
+  return false // no external target -> let user WS server handle it
+}
+
+describe('CVE-2026-44578: upgrade proxy SSRF guard', () => {
+  it('does NOT proxy an absolute-URL upgrade that was not a finished external rewrite', () => {
+    // Attacker-crafted absolute-URL upgrade: protocol is present but
+    // resolveRoutes did not "finish" it as an external rewrite.
+    assert.strictEqual(
+      shouldProxyUpgrade({
+        matchedOutput: undefined,
+        finished: false,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: undefined,
+      }),
+      false
+    )
+  })
+
+  it('does NOT proxy when resolveRoutes already produced a response (statusCode set)', () => {
+    assert.strictEqual(
+      shouldProxyUpgrade({
+        matchedOutput: undefined,
+        finished: true,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: 400,
+      }),
+      false
+    )
+  })
+
+  it('still proxies a legitimate finished external rewrite with no statusCode', () => {
+    assert.strictEqual(
+      shouldProxyUpgrade({
+        matchedOutput: undefined,
+        finished: true,
+        parsedUrl: { protocol: 'http:' },
+        statusCode: undefined,
+      }),
+      true
+    )
+  })
+
+  it('does NOT proxy when there is no external protocol at all', () => {
+    assert.strictEqual(
+      shouldProxyUpgrade({
+        matchedOutput: undefined,
+        finished: true,
+        parsedUrl: { protocol: undefined },
+        statusCode: undefined,
+      }),
+      false
+    )
+  })
+})

