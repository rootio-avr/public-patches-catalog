--- /dev/null
+++ b/test/ghsa-h25m-26qc-wcjf.test.js
@@ -0,0 +1,76 @@
+// Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864)
+//
+// React Flight Reply deserialization (used by Next.js Server Actions) revived
+// attacker-controlled model keys and assigned them directly with
+// `parentObject[key] = value`. A crafted reply whose object key is
+// "__proto__" therefore polluted Object.prototype during decodeReply(),
+// enabling prototype-pollution / DoS (CWE-400 / CWE-502).
+//
+// The fix guards the assignment so a "__proto__" key is never written back to
+// the reviving object. This test decodes a reply payload containing a
+// "__proto__" key and asserts the global Object prototype is left untouched.
+//
+// Grounded on facebook/react's Flight Reply hardening (commits 1800c832,
+// 6568bd00) vendored into Next.js by vercel/next.js 99b45010; run against the
+// bundled react-server-dom-webpack server build shipped in this package.
+
+const assert = require('node:assert');
+const path = require('node:path');
+
+const serverPath = path.join(
+  __dirname,
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.development.js'
+);
+
+const { decodeReply } = require(serverPath);
+
+async function run() {
+  assert.strictEqual(
+    typeof decodeReply,
+    'function',
+    'decodeReply should be exported by the bundled Flight server build'
+  );
+
+  const sentinel = 'polluted-' + Date.now();
+
+  // A Flight Reply whose top-level model is an object carrying a "__proto__"
+  // key. Before the fix this assignment landed on Object.prototype.
+  const body = new FormData();
+  body.append('0', JSON.stringify({ __proto__: { polluted: sentinel } }));
+
+  // Empty bundler/webpack map is fine: no client references are resolved here.
+  const root = await decodeReply(body, {});
+
+  // Core assertion: the global prototype must NOT have been polluted.
+  assert.strictEqual(
+    {}.polluted,
+    undefined,
+    'Object.prototype was polluted via a "__proto__" key in a Flight Reply'
+  );
+  assert.strictEqual(
+    Object.prototype.polluted,
+    undefined,
+    'Object.prototype.polluted must remain undefined after decodeReply'
+  );
+
+  // Sanity: decoding still succeeds and returns an object (normal behavior
+  // preserved for non-malicious input).
+  assert.ok(
+    root !== null && typeof root === 'object',
+    'decodeReply should still return the decoded model object'
+  );
+
+  console.log('GHSA-h25m-26qc-wcjf regression test passed');
+}
+
+run().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});

