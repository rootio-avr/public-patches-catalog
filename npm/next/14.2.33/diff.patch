@@ -2994,6 +2994,16 @@
           // Map
           const id = parseInt(value.slice(2), 16);
           const data = getOutlinedModel(response, id);
+          // Guard against re-entrant/cyclic RSC payloads (GHSA-q4gf-8mx6-v5v3,
+          // CWE-770): mark the outlined model consumed BEFORE constructing the
+          // Map so a crafted cyclic reference cannot force unbounded
+          // re-resolution and CPU exhaustion.
+          if (data != null && data.$$consumed === true) {
+            throw Error('Already initialized Map.');
+          }
+          if (data != null) {
+            data.$$consumed = true;
+          }
