+++ b/test/regression/cve-2026-44578.test.js
@@ -0,0 +1,70 @@
+/**
+ * Regression test for CVE-2026-44578
+ *
+ * router-server: guard upgrade (WebSocket) proxy against absolute-url SSRF.
+ *
+ * Upstream fix c4f69086 changed the upgrade handler so that a resolved route
+ * is only proxied when resolveRoutes reported `finished` AND did not set a
+ * `statusCode`. Previously any `parsedUrl.protocol` (which an attacker can
+ * force by sending an absolute-URL upgrade request such as
+ * `GET http://127.0.0.1:<internal-port>/secret-upgrade HTTP/1.1`) was proxied
+ * verbatim, allowing SSRF to internal services.
+ *
+ * This test mirrors the patched decision logic in
+ * packages/next/src/server/lib/router-server.ts and asserts that an
+ * attacker-controlled absolute URL is NOT proxied, while a legitimate
+ * externally-rewritten upgrade still is.
+ */
+const assert = require('node:assert')
+
+// Mirrors the guarded branch in the upgrade handler after the fix:
+//   if (finished && parsedUrl.protocol) {
+//     if (!statusCode) return proxyRequest(...)
+//     return socket.end()
+//   }
+function shouldProxyUpgrade({ finished, parsedUrl, statusCode }) {
+  if (finished && parsedUrl.protocol) {
+    if (!statusCode) {
+      return true
+    }
+    return false
+  }
+  return false
+}
+
+// 1. SSRF payload: absolute URL sets parsedUrl.protocol, but resolveRoutes did
+//    NOT finish (no matching external rewrite) -> must be refused.
+assert.strictEqual(
+  shouldProxyUpgrade({
+    finished: false,
+    parsedUrl: { protocol: 'http:', hostname: '127.0.0.1' },
+    statusCode: undefined,
+  }),
+  false,
+  'absolute-url upgrade without an external rewrite must not be proxied (SSRF)'
+)
+
+// 2. Even if a route "finished" but resolved to a status response (e.g. a
+//    redirect/blocked), it must not be blindly proxied.
+assert.strictEqual(
+  shouldProxyUpgrade({
+    finished: true,
+    parsedUrl: { protocol: 'http:', hostname: '127.0.0.1' },
+    statusCode: 308,
+  }),
+  false,
+  'a finished route that emitted a statusCode must not be proxied'
+)
+
+// 3. Legitimate external rewrite: finished, protocol present, no statusCode.
+assert.strictEqual(
+  shouldProxyUpgrade({
+    finished: true,
+    parsedUrl: { protocol: 'https:', hostname: 'example.com' },
+    statusCode: undefined,
+  }),
+  true,
+  'a legitimately rewritten external upgrade should still be proxied'
+)
+
+console.log('CVE-2026-44578 regression test passed')

