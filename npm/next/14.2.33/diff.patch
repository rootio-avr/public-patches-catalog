--- /dev/null
+++ b/test/ghsa-mwv6-3258-q52c.test.js
@@ -0,0 +1,45 @@
+// Regression test for GHSA-mwv6-3258-q52c (CVE-2025-55184)
+// App Router Server Action DoS: URL-encoded POSTs must be recognized so the
+// action handler can bail out early instead of parsing untrusted payloads.
+// Upstream fix 385e8c2 ("Check whether action ids are valid before parsing")
+// ships only as compiled output in the npm package, so this test exercises the
+// shipped module directly rather than the upstream e2e harness (not published).
+const assert = require('assert')
+const {
+  getServerActionRequestMetadata,
+} = require('../dist/server/lib/server-action-request-meta')
+
+// A URL-encoded POST carrying a next-action header must be flagged as a
+// URL-encoded action. The patched handler uses this flag to 404/return early
+// (for fetch vs MPA) before ever decoding the body.
+const urlEncoded = getServerActionRequestMetadata({
+  method: 'POST',
+  headers: {
+    'content-type': 'application/x-www-form-urlencoded',
+    'next-action': 'abc123',
+  },
+})
+assert.strictEqual(
+  urlEncoded.isURLEncodedAction,
+  true,
+  'URL-encoded POST should be detected as a URL-encoded action'
+)
+assert.strictEqual(urlEncoded.actionId, 'abc123')
+assert.strictEqual(urlEncoded.isServerAction, true)
+
+// A multipart POST is not a URL-encoded action and continues to normal parsing.
+const multipart = getServerActionRequestMetadata({
+  method: 'POST',
+  headers: {
+    'content-type': 'multipart/form-data; boundary=x',
+    'next-action': 'abc123',
+  },
+})
+assert.strictEqual(multipart.isURLEncodedAction, false)
+assert.strictEqual(multipart.isMultipartAction, true)
+
+// A plain GET is not a server action at all.
+const getReq = getServerActionRequestMetadata({ method: 'GET', headers: {} })
+assert.strictEqual(getReq.isServerAction, false)
+
+console.log('GHSA-mwv6-3258-q52c regression test passed')

