+ * the resolved value chain and bail out with "Cannot have cyclic thenables."
+ * when it either detects a self-referential Chunk (inspectedValue === chunk)
+ * or exceeds a bounded number of iterations (cycleProtection > 1000), instead
+ * of looping forever.
+ *
+ * Next.js 14.2.26 ships these bundles pre-compiled and does not export the
+ * internal Chunk class, so this test verifies the security guard is present in
+ * every vendored server bundle (all four RSC vendor families, every build
+ * variant), which is exactly the code the fix introduces. Before the patch the
+ * INITIALIZED case was simply `resolve(chunk.value)` with no cycle protection.
+ */
+
+const fs = require('fs')
+const path = require('path')
+
+const COMPILED_DIR = path.join(
+  __dirname,
+  '..',
+  '..',
+  'dist',
+  'compiled'
+)
+
+const FAMILIES = [
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+]
+
+function serverBundlesFor(family) {
+  const dir = path.join(COMPILED_DIR, family, 'cjs')
+  if (!fs.existsSync(dir)) return []
+  return fs
+    .readdirSync(dir)
+    .filter((f) => /-server\.(browser|edge|node)[.\w]*\.js$/.test(f))
+    .map((f) => path.join(dir, f))
+}
+
+describe('GHSA-5j59-xgg2-r9c4: cyclic thenable protection in RSC bundles', () => {
+  const bundles = []
+  for (const family of FAMILIES) {
+    for (const file of serverBundlesFor(family)) {
+      bundles.push(file)
+    }
+  }
+
+  it('collects the vendored RSC server bundles to check', () => {
+    // 4 families x (8 non-min + 4 min) = 48 server bundles expected.
+    expect(bundles.length).toBeGreaterThanOrEqual(48)
+  })
+
+  it.each(bundles)(
+    'guards Chunk.prototype.then against cyclic thenables in %s',
+    (file) => {
+      const src = fs.readFileSync(file, 'utf8')
+
+      // Only the server bundles that actually implement Chunk.prototype.then
+      // need the guard; skip register/plugin helper files defensively.
+      if (!/\.prototype\.then\s*=\s*function/.test(src)) {
+        return
+      }
+
+      // The fix rejects with this exact message when a cycle is detected.
+      expect(src).toContain('Cannot have cyclic thenables.')
+
+      // The bounded-iteration guard (cycleProtection > 1000 in readable
+      // bundles, 1E3<d in minified bundles) must be present so a crafted
+      // cyclic thenable cannot loop forever.
+      const hasBoundedGuard =
+        src.includes('cycleProtection > 1000') || src.includes('1E3<')
+      expect(hasBoundedGuard).toBe(true)
+    }
+  )
+})
