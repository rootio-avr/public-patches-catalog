+      // bundles, 1E3<d in minified bundles) must be present so a crafted
+      // cyclic thenable cannot loop forever.
+      const hasBoundedGuard =
+        src.includes('cycleProtection > 1000') || src.includes('1E3<')
+      expect(hasBoundedGuard).toBe(true)
+    }
+  )
+})

