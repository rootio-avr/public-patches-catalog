+/**
+ * Regression test for GHSA-8h8q-6873-q5fj (CWE-770)
+ *
+ * Next.js is vulnerable to Denial of Service via React Server Components:
+ * a crafted request to an App Router Server Function endpoint can trigger
+ * excessive resource consumption during React Flight / RSC deserialization.
+ *
+ * The upstream fix ("Sync DoS mitigations for React Flight",
+ * vercel/next.js@bf9f0843edab3a7cf9d4c85b315bc33c87b282ce) adds allocation
+ * guards to the Flight *server* decode path. Because no dedicated Next.js
+ * 14.x release ships the fix and the upstream change is a full re-sync of a
+ * much newer React canary bundle, the guards were hand-ported into the
+ * vendored 14.2.3 Flight server bundles. This test pins two of those guards
+ * so a regression (removal / bundle re-sync without the guard) is caught:
+ *
+ *   1. Bound-arguments limit — a decoded Server Reference may carry at most
+ *      1000 bound arguments before decode throws (limit is 1000).
+ *   2. BigInt digit limit — a "$n" encoded BigInt may carry at most 300
+ *      digits before decode throws (limit is 300).
+ *
+ * These bundles require the exact React "react-server" canary runtime to
+ * execute, which is not available to a standalone unit test, so the guard is
+ * verified by asserting the ported guard logic is present in every Flight
+ * *server* decode bundle that ships in the package.
+ */
+const fs = require('fs')
+const path = require('path')
+
+// Resolve the compiled Flight bundle root across the possible layouts:
+//   - published npm tarball / installed package:  <next>/dist/compiled
+//   - monorepo source tree:                       packages/next/src/compiled
+function findCompiledRoots() {
+  const candidates = [
+    path.join(__dirname, '..', '..', 'packages', 'next', 'dist', 'compiled'),
+    path.join(__dirname, '..', '..', 'packages', 'next', 'src', 'compiled'),
+  ]
+  try {
+    const nextPkg = require.resolve('next/package.json')
+    candidates.unshift(path.join(path.dirname(nextPkg), 'dist', 'compiled'))
+  } catch (_) {
+    // next not resolvable as a dependency in this tree; rely on path candidates
+  }
+  return candidates.filter((p) => {
+    try {
+      return fs.statSync(p).isDirectory()
+    } catch (_) {
+      return false
+    }
+  })
+}
+
+function collectServerBundles() {
+  const roots = findCompiledRoots()
+  const bundles = []
+  for (const root of roots) {
+    for (const pkg of [
+      'react-server-dom-webpack',
+      'react-server-dom-webpack-experimental',
+      'react-server-dom-turbopack',
+      'react-server-dom-turbopack-experimental',
+    ]) {
+      const cjsDir = path.join(root, pkg, 'cjs')
+      let entries
+      try {
+        entries = fs.readdirSync(cjsDir)
+      } catch (_) {
+        continue
+      }
+      for (const name of entries) {
+        // Only the *server* decode bundles handle attacker-controlled Flight
+        // payloads; the *.min.js files are minified copies of the same source.
+        if (
+          name.includes('-server.') &&
+          name.endsWith('.js') &&
+          !name.endsWith('.min.js')
+        ) {
+          bundles.push(path.join(cjsDir, name))
+        }
+      }
+    }
+    if (bundles.length) break // first existing layout wins
+  }
+  return bundles
+}
+
+describe('GHSA-8h8q-6873-q5fj — Flight RSC deserialization DoS guards', () => {
+  const bundles = collectServerBundles()
+
+  it('locates the compiled Flight server bundles to check', () => {
+    expect(bundles.length).toBeGreaterThan(0)
+  })
+
+  it.each(bundles)('bounds bound-argument count in %s', (file) => {
+    const src = fs.readFileSync(file, 'utf8')
+    // Guard must reject Server References carrying > 1000 bound arguments.
+    expect(src).toMatch(/the limit is 1000/)
+    expect(src).toMatch(/length > 1000/)
+  })
+
+  it.each(bundles)('bounds BigInt digit length in %s', (file) => {
+    const src = fs.readFileSync(file, 'utf8')
+    // Guard must reject "$n" BigInt payloads with > 300 digits.
+    expect(src).toMatch(/the limit is 300/)
+    expect(src).toMatch(/length > 300/)
+  })
+})
+
+// Behavioral sanity check of the exact threshold logic that was ported,
+// independent of the React canary runtime.
+describe('GHSA-8h8q-6873-q5fj — guard threshold semantics', () => {
+  function boundArgsGuard(args) {
+    if (args && args.length > 1000) {
+      throw new Error(
+        'Server Function has too many bound arguments. Received ' +
+          args.length +
+          ' but the limit is 1000.'
+      )
+    }
+    return true
+  }
+
+  function bigIntGuard(digits) {
+    if (digits.length > 300) {
+      throw new Error(
+        'BigInt is too large. Received ' +
+          digits.length +
+          ' digits but the limit is 300.'
+      )
+    }
+    return true
+  }
+
+  it('accepts a normal bound-arguments array', () => {
+    expect(boundArgsGuard(new Array(1000).fill(0))).toBe(true)
+  })
+
+  it('rejects an oversized bound-arguments array', () => {
+    expect(() => boundArgsGuard(new Array(1001).fill(0))).toThrow(
+      /too many bound arguments/
+    )
+  })
+
+  it('accepts a normal BigInt payload', () => {
+    expect(bigIntGuard('9'.repeat(300))).toBe(true)
+  })
+
+  it('rejects an oversized BigInt payload', () => {
+    expect(() => bigIntGuard('9'.repeat(301))).toThrow(/BigInt is too large/)
+  })
+})
