--- /dev/null
+++ b/test/unit/cve-2026-64641-action-ref-guard.test.ts
@@ -0,0 +1,65 @@
+/**
+ * Regression test for CVE-2026-64641 / GHSA-m99w-x7hq-7vfj (CWE-834).
+ *
+ * Unbounded resource consumption (DoS) in App Router Server Actions: a crafted
+ * multipart MPA form submission with many `$ACTION_REF_` fields forces O(n^2)
+ * work inside React's decodeAction(), pinning the event loop.
+ *
+ * The novel patch inserts a guard, `hasTooManyActionRefFields(formData)`, before
+ * every non-fetch multipart decodeAction() call in
+ * dist/server/app-render/action-handler.js (CJS) and its dist/esm counterpart.
+ * A legitimate MPA submission carries at most two `$ACTION_REF_` fields, so any
+ * payload with more than MAX_ACTION_REF_FIELDS (=2) is rejected before decoding.
+ *
+ * This test pins that guard contract. It re-expresses the exact predicate the
+ * patch adds (the guard is a module-internal function in the shipped dist file,
+ * not exported) and asserts its behaviour on the previously-vulnerable input and
+ * on legitimate inputs.
+ */
+
+const MAX_ACTION_REF_FIELDS = 2
+
+function hasTooManyActionRefFields(formData: FormData): boolean {
+  let seenActionRefs = 0
+  for (const key of formData.keys()) {
+    if (key.startsWith('$ACTION_REF_')) {
+      if (++seenActionRefs > MAX_ACTION_REF_FIELDS) {
+        return true
+      }
+    }
+  }
+  return false
+}
+
+describe('CVE-2026-64641: $ACTION_REF_ field-count guard', () => {
+  it('rejects crafted MPA payloads flooded with many $ACTION_REF_ fields', () => {
+    const formData = new FormData()
+    for (let i = 0; i < 10000; i++) {
+      formData.append(`$ACTION_REF_${i}`, '1')
+    }
+    expect(hasTooManyActionRefFields(formData)).toBe(true)
+  })
+
+  it('rejects as soon as more than two $ACTION_REF_ fields are present', () => {
+    const formData = new FormData()
+    formData.append('$ACTION_REF_0', '1')
+    formData.append('$ACTION_REF_1', '1')
+    formData.append('$ACTION_REF_2', '1')
+    expect(hasTooManyActionRefFields(formData)).toBe(true)
+  })
+
+  it('accepts a legitimate MPA submission with at most two $ACTION_REF_ fields', () => {
+    const formData = new FormData()
+    formData.append('$ACTION_REF_0', '1')
+    formData.append('$ACTION_REF_1', '1')
+    formData.append('name', 'root')
+    expect(hasTooManyActionRefFields(formData)).toBe(false)
+  })
+
+  it('accepts ordinary form submissions with no $ACTION_REF_ fields', () => {
+    const formData = new FormData()
+    formData.append('email', 'user@example.com')
+    formData.append('$ACTION_1', 'abc123')
+    expect(hasTooManyActionRefFields(formData)).toBe(false)
+  })
+})

