--- /dev/null
+++ b/test/unit/cve-2026-75604.test.ts
@@ -0,0 +1,35 @@
+/* eslint-env jest */
+import escapePathDelimiters from 'next/dist/shared/lib/router/utils/escape-path-delimiters'
+
+// Regression test for CVE-2026-75604 (CWE-22 path traversal via cache
+// segments). escapePathDelimiters must escape backslashes and their encoded
+// form (%5c) in addition to the forward-slash family so that path segments
+// cannot escape the incremental-cache root directory.
+describe('CVE-2026-75604 escapePathDelimiters backslash handling', () => {
+  it('escapes literal backslashes', () => {
+    expect(escapePathDelimiters('a\\b')).toBe('a%5Cb')
+    expect(escapePathDelimiters('..\\..\\server-reference-manifest')).toBe(
+      '..%5C..%5Cserver-reference-manifest'
+    )
+  })
+
+  it('escapes encoded backslashes when escapeEncoded is enabled', () => {
+    expect(escapePathDelimiters('a%5cb', true)).toBe('a%255Cb')
+    expect(escapePathDelimiters('a%5Cb', true)).toBe('a%255Cb')
+  })
+
+  it('does not escape encoded backslashes when escapeEncoded is disabled', () => {
+    // Without escapeEncoded, only the literal delimiter class is escaped; the
+    // pre-encoded %5c passes through unchanged.
