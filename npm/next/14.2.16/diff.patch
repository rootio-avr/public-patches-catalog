+++ b/test/unit/rsc-decode-reply-nesting-limit.test.js	2026-09-11 18:03:04.217758892 +0530
@@ -0,0 +1,48 @@
+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 (CVE-2026-23869).
+ *
+ * The vendored React Server Components flight decoder used by the App Router
+ * (next/dist/compiled/react-server-dom-webpack/server.node) deserialized
+ * untrusted Server Function request bodies without bounding structural
+ * array/object nesting depth, allowing a small crafted request to drive
+ * unbounded CPU work (CWE-770 / CWE-400 during CWE-502 deserialization) => DoS.
+ *
+ * The fix adds a string-literal-aware nesting/size guard in the decoder:
+ *  - decodeReply accepts an optional { arraySizeLimit } option
+ *  - a deeply nested reply exceeding the limit is rejected with
+ *    "Maximum array nesting exceeded" instead of being fully materialized
+ *  - a conservative default depth cap applies even without an explicit limit
+ *  - normal (shallow) payloads still decode successfully (no regression)
+ */
+
+const decoder = require('next/dist/compiled/react-server-dom-webpack/server.node')
+
+function nestedArrayPayload(depth) {
+  let payload = '0'
+  for (let i = 0; i < depth; i += 1) {
+    payload = '[' + payload + ',0]'
+  }
+  return payload
+}
+
+describe('GHSA-q4gf-8mx6-v5v3 RSC decodeReply nesting limit', () => {
+  it('rejects a deeply nested reply that exceeds the supplied arraySizeLimit', async () => {
+    const payload = nestedArrayPayload(128)
+    await expect(
+      Promise.resolve(decoder.decodeReply(payload, {}, { arraySizeLimit: 64 }))
+    ).rejects.toThrow('Maximum array nesting exceeded')
+  })
+
+  it('rejects pathologically deep nesting even without an explicit limit (default cap)', async () => {
+    const payload = nestedArrayPayload(5000)
+    await expect(
+      Promise.resolve(decoder.decodeReply(payload, {}))
+    ).rejects.toThrow('Maximum array nesting exceeded')
+  })
+
+  it('still decodes a normal shallow reply within the limit', async () => {
+    const payload = JSON.stringify([1, [2, 3], { a: [4] }])
+    const result = await decoder.decodeReply(payload, {}, { arraySizeLimit: 64 })
+    expect(result).toEqual([1, [2, 3], { a: [4] }])
+  })
+})
