diff -ruN a/test/unit/ghsa-h25m-26qc-wcjf.test.js b/test/unit/ghsa-h25m-26qc-wcjf.test.js
--- a/test/unit/ghsa-h25m-26qc-wcjf.test.js	1970-01-01 05:30:00.000000000 +0530
+++ b/test/unit/ghsa-h25m-26qc-wcjf.test.js	2026-09-11 15:36:09.976594944 +0530
@@ -0,0 +1,109 @@
+/* eslint-env jest */
+/*
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864).
+ *
+ * React Server Components (Flight) deserialization used by the Next.js App
+ * Router resolves forward/cyclic model references lazily. When a referenced
+ * chunk resolves, the deferred resolver returned by `createModelResolver`
+ * writes the value back into its parent via `parentObject[key] = value`.
+ * Because `key` comes straight from attacker-controlled serialized input, a
+ * `"__proto__"` key turned that write into a prototype assignment, enabling
+ * prototype pollution / DoS via crafted Server Function payloads.
+ *
+ * Upstream fix vercel/next.js@99b450109dfd ("Sync DoS mitigations for React
+ * Flight") guards that assignment so `__proto__` keys are never written:
+ *     "__proto__" !== key && (parentObject[key] = value);
+ *
+ * The fix commit is a wholesale re-vendor of the compiled React 19 bundles
+ * with no dedicated test, so this is a synthesized regression test. It asserts
+ * the guard is present (and the unguarded sink is absent) at the deferred
+ * resolver in every vendored react-server-dom-* Flight bundle that Next.js
+ * ships and loads at runtime -- both the readable development builds and the
+ * minified production builds that `NODE_ENV=production` actually requires.
+ */
+const fs = require('fs')
+const path = require('path')
+
+const COMPILED_DIR = path.join(
+  __dirname,
+  '..',
+  '..',
+  'dist',
+  'compiled'
+)
+
+const PACKAGE_DIRS = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+]
+
+function collectBundles() {
+  const bundles = []
+  for (const pkg of PACKAGE_DIRS) {
+    const cjsDir = path.join(COMPILED_DIR, pkg, 'cjs')
+    if (!fs.existsSync(cjsDir)) continue
+    for (const file of fs.readdirSync(cjsDir)) {
+      if (!file.endsWith('.js')) continue
+      // node-register / plugin bundles do not contain the Flight client model
+      // resolver, so only inspect the client/server flight bundles.
+      if (!/(client|server)\./.test(file)) continue
+      bundles.push(path.join(cjsDir, file))
+    }
+  }
+  return bundles
+}
+
+const bundles = collectBundles()
+
+describe('GHSA-h25m-26qc-wcjf: Flight deserialization prototype pollution guard', () => {
+  it('finds the vendored react-server-dom Flight bundles to inspect', () => {
+    // Guard against a refactor silently making the assertions below vacuous.
+    expect(bundles.length).toBeGreaterThanOrEqual(64)
+  })
+
+  describe.each(bundles.map((f) => [path.relative(COMPILED_DIR, f), f]))(
+    '%s',
+    (_rel, file) => {
+      const src = fs.readFileSync(file, 'utf8')
+      const isMin = file.endsWith('.min.js')
+
+      it('guards the deferred model assignment against "__proto__"', () => {
+        if (isMin) {
+          // Minified: `return function(x){b[c]=x;...}` becomes
+          // `return function(x){"__proto__"!==c&&(b[c]=x);...}`.
+          // Every guarded write references the literal "__proto__".
+          expect(src).toContain('"__proto__"!==')
+        } else {
+          expect(src).toContain('"__proto__" !== key && (parentObject[key] = value)')
+        }
+      })
+
+      it('does not leave an unguarded assignment sink', () => {
+        if (isMin) {
+          // The naked minified sink `return function(x){b[c]=x;` (no preceding
+          // "__proto__" guard) must not survive.
+          const nakedMin = /return\s*(?:function\s*\((\w)\)|\((\w)\)\s*=>)\s*\{(\w)\[(\w)\]=/g
+          let m
+          while ((m = nakedMin.exec(src)) !== null) {
+            const idx = m.index
+            const window = src.slice(Math.max(0, idx - 32), idx + m[0].length)
+            expect(window).toContain('"__proto__"!==')
+          }
+        } else {
+          // The pre-fix source line was exactly `    parentObject[key] = value;`.
+          // After the fix it only appears inside the guarded expression.
+          const lines = src.split('\n')
+          for (const line of lines) {
+            if (line.trim() === 'parentObject[key] = value;') {
+              throw new Error(
+                'Unguarded `parentObject[key] = value;` sink present in ' + file
+              )
+            }
+          }
+        }
+      })
+    }
+  )
+})

