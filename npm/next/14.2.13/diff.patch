diff -ruN a/test/ghsa-5j59-xgg2-r9c4.test.js b/test/ghsa-5j59-xgg2-r9c4.test.js
--- a/test/ghsa-5j59-xgg2-r9c4.test.js	1970-01-01 05:30:00.000000000 +0530
+++ b/test/ghsa-5j59-xgg2-r9c4.test.js	2026-09-11 15:36:10.628162523 +0530
@@ -0,0 +1,110 @@
+/*
+ * Regression test for GHSA-5j59-xgg2-r9c4 (CVE-2025-67779)
+ *
+ * Denial of Service in the React Server Components deserialization runtime.
+ * A crafted Server Function payload could make a resolved chunk resolve to a
+ * ReactPromise that (directly or transitively) points back at itself, driving
+ * `Chunk.prototype.then` into an unbounded loop and exhausting CPU. A related
+ * variant kept creating fresh *pending* chunks for references that stream in
+ * after the response was already errored/closed.
+ *
+ * The upstream fix (vendored react-server-dom-{webpack,turbopack} bundle bump
+ * baked into next's compiled dist) adds:
+ *   1. a cyclic-thenable guard in the INITIALIZED branch of wakeChunk that
+ *      walks the chunk chain and rejects with "Cannot have cyclic thenables."
+ *      instead of looping forever (also bounded by a 1000-hop cap);
+ *   2. closed-response handling: reportGlobalError marks the response closed
+ *      and getChunk returns an errored chunk (createErroredChunk) rather than a
+ *      new pending chunk once the response is closed.
+ *
+ * next ships only compiled bundles (no RSC-runtime source, no upstream tests),
+ * so this regression test asserts the fixed guards are present in every
+ * server-side compiled bundle variant. On the vulnerable 14.2.13 build these
+ * markers are absent and the test fails; on the patched build it passes.
+ */
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+
+const COMPILED = path.join(
+  __dirname,
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled'
+);
+
+const PACKAGES = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+];
+
+const TARGETS = ['browser', 'edge', 'node', 'node.unbundled'];
+const VARIANTS = ['development', 'production', 'production.min'];
+
+function serverBundlePath(pkg, target, variant) {
+  // experimental packages keep the non-experimental file prefix
+  const prefix = pkg.replace('-experimental', '');
+  return path.join(
+    COMPILED,
+    pkg,
+    'cjs',
+    `${prefix}-server.${target}.${variant}.js`
+  );
+}
+
+const bundles = [];
+for (const pkg of PACKAGES) {
+  for (const target of TARGETS) {
+    for (const variant of VARIANTS) {
+      const p = serverBundlePath(pkg, target, variant);
+      if (fs.existsSync(p)) bundles.push(p);
+    }
+  }
+}
+
+// Sanity: we expect the full 4 x 4 x 3 = 48 server bundle matrix.
+assert.ok(
+  bundles.length >= 48,
+  `expected >=48 compiled server bundles, found ${bundles.length}`
+);
+
+for (const bundle of bundles) {
+  const src = fs.readFileSync(bundle, 'utf8');
+  const rel = path.relative(COMPILED, bundle);
+
+  // (1) Cyclic-thenable guard must be present.
+  assert.ok(
+    src.includes('Cannot have cyclic thenables.'),
+    `${rel}: missing cyclic-thenable DoS guard (unbounded loop still possible)`
+  );
+
+  // (2) Closed-response handling must be present.
+  assert.ok(
+    /_closedReason/.test(src),
+    `${rel}: missing closed-response guard (_closedReason)`
+  );
+  assert.ok(
+    /_closed/.test(src),
+    `${rel}: missing closed-response flag (_closed)`
+  );
+}
+
+console.log(
+  `GHSA-5j59-xgg2-r9c4: DoS guards verified in ${bundles.length} compiled server bundles`
+);
+
+// Jest-compatible when run under the project's jest runner, and also runnable
+// directly with `node`.
+if (typeof test === 'function') {
+  test('GHSA-5j59-xgg2-r9c4: RSC deserialization DoS guards present', () => {
+    for (const bundle of bundles) {
+      const src = fs.readFileSync(bundle, 'utf8');
+      assert.ok(src.includes('Cannot have cyclic thenables.'));
+      assert.ok(/_closedReason/.test(src));
+    }
