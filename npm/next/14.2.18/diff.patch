+++ b/dist/compiled/react-server-dom-turbopack/cjs/react-server-dom-turbopack-server.browser.development.js	2026-09-11 15:51:02.305258823 +0530
@@ -3306,7 +3306,22 @@
           // backing store already.
           // $FlowFixMe[prop-missing] FormData has forEach on it.
 
+          // Root.io CVE-2026-23870 (GHSA-8h8q-6873-q5fj) mitigation:
+          // Reconstructing each "$K" FormData reference scans the entire
+          // backing store. A crafted request body can embed many "$K"
+          // references over a large backing store, causing unbounded
+          // O(n*m) work during deserialization and a denial of service
+          // (CWE-770). Cap the cumulative number of entries scanned across
+          // all FormData references in a single reply.
+          if (typeof response._rioFormDataScanBudget !== 'number') {
+            response._rioFormDataScanBudget = 10000000;
+          }
+
           backingFormData.forEach(function (entry, entryKey) {
+            if (--response._rioFormDataScanBudget < 0) {
+              throw new Error('Aborting deserialization: FormData reference reconstruction exceeded the allowed work budget (possible denial-of-service payload).');
+            }
+
             if (entryKey.startsWith(formPrefix)) {
               _data2.append(entryKey.slice(formPrefix.length), entry);
             }
