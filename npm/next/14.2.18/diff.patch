@@ -0,0 +1,54 @@
+/**
+ * Regression test for CVE-2026-44578
+ *
+ * router-server: guard upgrade proxy against absolute-url SSRF
+ * (upstream fix c4f69086cc8dcbd81b1dbc321c98ea874d90d6f8).
+ *
+ * The published npm artifact ships compiled JS only (no TypeScript source),
+ * so this test asserts against the fixed guard in the shipped
+ * dist/server/lib/router-server.js upgrade handler:
+ *
+ *     const { finished, matchedOutput, parsedUrl, statusCode } = await resolveRoutes({ ... isUpgradeReq: true ... })
+ *     if (finished && parsedUrl.protocol) {
+ *       if (!statusCode) {
+ *         return await proxyRequest(req, socket, parsedUrl, head);
+ *       }
+ *       return socket.end();
+ *     }
+ */
+const fs = require('fs')
+const path = require('path')
+
+describe('CVE-2026-44578: upgrade proxy absolute-url SSRF guard', () => {
+  const routerServerPath = path.join(
+    __dirname,
+    '..',
+    'dist',
+    'server',
+    'lib',
+    'router-server.js'
+  )
+
+  let source
+  beforeAll(() => {
+    source = fs.readFileSync(routerServerPath, 'utf8')
+  })
+
+  it('destructures finished and statusCode from the upgrade resolveRoutes call', () => {
+    expect(source).toMatch(/finished[\s\S]*matchedOutput[\s\S]*statusCode[\s\S]*isUpgradeReq: true/)
+  })
+
+  it('only proxies upgrade requests when routing finished (not on any protocol)', () => {
+    // Vulnerable form gated proxyRequest directly on parsedUrl.protocol.
+    expect(source).not.toMatch(/if \(parsedUrl\.protocol\) \{\s*return await \(0, _proxyrequest\.proxyRequest\)\(req, socket, parsedUrl, head\)/)
+    // Fixed form gates on `finished && parsedUrl.protocol`.
+    expect(source).toMatch(/if \(finished && parsedUrl\.protocol\)/)
+  })
+
+  it('refuses to proxy the upgrade when routing produced a status code', () => {
+    const idx = source.lastIndexOf('if (finished && parsedUrl.protocol)')
+    const guardBlock = source.slice(idx)
+    expect(guardBlock).toMatch(/if \(!statusCode\)\s*\{\s*return await \(0, _proxyrequest\.proxyRequest\)\(req, socket, parsedUrl, head\)/)
+    expect(guardBlock).toMatch(/return socket\.end\(\)/)
+  })
+})

