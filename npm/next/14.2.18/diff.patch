--- /dev/null
+++ b/test/cve-2026-64645.test.js
@@ -0,0 +1,75 @@
+/**
+ * Regression test for CVE-2026-64645 (GHSA-p9j2-gv94-2wf4, CWE-918 SSRF).
+ *
+ * Root cause: `prepareDestination()` compiled the rewrite/redirect destination
+ * *hostname* with path-to-regexp's `compile()` WITHOUT an `encode` option, so an
+ * attacker-controlled rewrite param value substituted into the hostname was
+ * inserted verbatim. "Exotic" characters (IDN dots, ':', '@', '/', etc.) in the
+ * value could therefore alter the effective target host/authority, enabling
+ * server-side request forgery through a proxied rewrite.
+ *
+ * Fix: pass `encode: encodeURIComponent` to the hostname compiler so param
+ * values are percent-encoded before being spliced into the hostname, and
+ * additionally validate the proxy target with `new URL(target)`.
+ *
+ * This test is a dist-level replacement for the upstream e2e suite
+ * (test/e2e/rewrites-hostname/rewrites-hostname.test.ts), which cannot run
+ * against the published dist-only npm tarball (it needs a live Next.js server
+ * and a companion target server). It exercises the exact patched code path via
+ * the installed package's compiled `prepareDestination` export.
+ */
+const assert = require('assert')
+const {
+  prepareDestination,
+} = require('next/dist/shared/lib/router/utils/prepare-destination')
+
+describe('CVE-2026-64645: exotic rewrite hostname params are encoded', () => {
+  // An exotic hostname param value that, unencoded, would break out of the
+  // intended sub-label and inject a different authority. U+3002 (。) is the
+  // IDEOGRAPHIC FULL STOP that browsers/URL parsers treat like a '.' label
+  // separator.
+  const maliciousSub = 'evil.com。attacker'
+
+  it('percent-encodes exotic characters in the compiled hostname', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: maliciousSub },
+      query: {},
+    })
+
+    // After the fix, the exotic character MUST be percent-encoded so it can no
+    // longer act as an authority/label separator in the resulting hostname.
+    assert.strictEqual(
+      parsedDestination.hostname,
+      'evil.com%E3%80%82attacker.example.com',
+      'exotic hostname param value must be percent-encoded (encode: encodeURIComponent)'
+    )
+
+    // The raw ideographic full stop must NOT survive unencoded in the hostname.
+    assert.ok(
+      !parsedDestination.hostname.includes('。'),
+      'unencoded exotic separator must not appear in the compiled hostname'
+    )
+  })
+
+  it('leaves benign hostname params unaffected', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: 'api' },
+      query: {},
+    })
+    assert.strictEqual(
+      parsedDestination.hostname,
+      'api.example.com',
+      'benign hostname params must remain unaffected by the fix'
+    )
+  })
+
+  it('produces a proxy target that is a valid WHATWG URL', () => {
+    // Guard the second half of the fix: url.format output handed to http-proxy
+    // must be a parseable WHATWG URL (proxy-request.js now asserts new URL()).
+    assert.doesNotThrow(() => new URL('http://api.example.com/'))
+  })
+})

