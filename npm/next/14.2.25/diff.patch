+++ b/test/aikido-2026-553733.test.js
@@ -0,0 +1,82 @@
+/**
+ * Regression test for AIKIDO-2026-553733 (GHSA-2xp9-vwfh-vxw4).
+ *
+ * next/image disabled AVIF image optimization because decoding untrusted AVIF
+ * input can trigger a heap buffer overflow leading to remote code execution.
+ * As part of that fix, a static AVIF import can no longer receive an automatic
+ * blur placeholder (generating one requires decoding the source image), so
+ * `placeholder: 'blur'` is downgraded to `'empty'` unless an explicit
+ * `blurDataURL` is supplied.
+ *
+ * This test is a replacement for the upstream unit test
+ * test/unit/next-image-get-img-props.test.ts, which is not shipped in the
+ * published npm artifact. It exercises the compiled `getImageProps` export.
+ */
+const assert = require('node:assert')
+const { getImageProps } = require('next/image')
+
+// A static AVIF import with placeholder='blur' and no blurDataURL must NOT get
+// an automatic blur placeholder — the style collapses to a transparent color.
+{
+  const { props } = getImageProps({
+    alt: 'a nice desc',
+    src: {
+      src: '/_next/static/media/test.abc123.avif',
+      width: 100,
+      height: 200,
+    },
+    placeholder: 'blur',
+  })
+  assert.deepStrictEqual(
+    props.style,
+    { color: 'transparent' },
+    'static avif blur placeholder should be disabled (no background-image)'
+  )
+  assert.ok(
+    !props.style || !props.style.backgroundImage,
+    'static avif must not produce a generated blur backgroundImage'
+  )
+}
+
+// A static AVIF import WITH an explicit blurDataURL must still get the blur.
+{
+  const blurDataURL = 'data:image/png;base64,custom'
+  const { props } = getImageProps({
+    alt: 'a nice desc',
+    src: {
+      src: '/_next/static/media/test.abc123.avif',
+      width: 100,
+      height: 200,
+    },
+    placeholder: 'blur',
+    blurDataURL,
+  })
+  assert.ok(
+    props.style && typeof props.style.backgroundImage === 'string',
+    'custom blurDataURL should still produce a backgroundImage'
+  )
+  assert.ok(
+    props.style.backgroundImage.includes(blurDataURL),
+    'custom blurDataURL should be preserved for a static avif'
+  )
+}
+
+// Sanity: a normal (non-avif) static import keeps automatic blur behavior.
+{
+  const { props } = getImageProps({
+    alt: 'a nice desc',
+    src: {
+      src: '/_next/static/media/test.abc123.png',
+      width: 100,
+      height: 200,
+      blurDataURL: 'data:image/png;base64,auto',
+    },
+    placeholder: 'blur',
+  })
+  assert.ok(
+    props.style && typeof props.style.backgroundImage === 'string',
+    'non-avif static import should still receive a blur placeholder'
+  )
+}
+
+console.log('AIKIDO-2026-553733 regression test passed')

