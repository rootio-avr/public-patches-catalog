--- /dev/null
+++ b/test/unit/cve-2026-75604.test.ts
@@ -0,0 +1,36 @@
+// Regression test for CVE-2026-75604 (path traversal in incremental-cache).
+//
+// The upstream fix (vercel/next.js b0f3460) has two parts:
+//   1. escapePathDelimiters must also escape backslashes (`\`) and their
+//      percent-encoded form (%5c) so a crafted segment cannot smuggle a
+//      Windows-style path separator into the on-disk cache key.
+//   2. FileSystemCache#getFilePath must reject any resolved path that escapes
+//      its cache root directory.
+//
+// The upstream regression test is an e2e suite that does not exist in this
+// (v14.2.25) target tree, so this is a minimal replacement exercising the same
+// fixed behavior against the unit that carries the security-relevant logic.
+import escapePathDelimiters from 'next/dist/shared/lib/router/utils/escape-path-delimiters'
+
+describe('CVE-2026-75604 escapePathDelimiters', () => {
+  it('escapes forward slashes, hashes and question marks (unchanged behavior)', () => {
+    expect(escapePathDelimiters('a/b#c?d')).toBe('a%2Fb%23c%3Fd')
+  })
+
+  it('escapes literal backslashes so they cannot act as path separators', () => {
+    // Before the fix a backslash passed through untouched, allowing
+    // `..\..\server-reference-manifest` style traversal on the cache path.
+    expect(escapePathDelimiters('a\\b')).toBe('a%5Cb')
+    expect(escapePathDelimiters('..\\..\\secret')).not.toContain('\\')
+  })
+
+  it('escapes percent-encoded backslashes when escapeEncoded is set', () => {
+    expect(escapePathDelimiters('a%5cb', true)).toBe('a%255cb')
+    // still escapes the previously-handled encoded delimiters too
+    expect(escapePathDelimiters('a%2fb', true)).toBe('a%252fb')
+  })
+
+  it('leaves ordinary segments untouched', () => {
+    expect(escapePathDelimiters('ordinary-segment')).toBe('ordinary-segment')
+  })
+})

