+/**
+ * Regression test for GHSA-8h8q-6873-q5fj (CVE-2026-23870):
+ * Next.js DoS with Server Components — missing __proto__ guards during
+ * React Flight (RSC payload) deserialization allow an attacker-controlled
+ * Server Function payload to mutate Object.prototype via the deferred
+ * ("blocked") model-resolver assignment (parentObject[key] = value), which
+ * can trigger excessive CPU usage / prototype corruption.
+ *
+ * The fix guards the deferred assignment with `"__proto__" !== key` in the
+ * production react-server-dom-webpack server bundle. This test decodes a
+ * Flight reply whose outlined (forward-referenced) model carries a
+ * `__proto__` key and asserts Object.prototype is never polluted.
+ *
+ * No execution here beyond a plain node:assert check — the unit-tests node
+ * runs it downstream.
+ */
+'use strict'
+
+const assert = require('assert')
+
+const server = require('./cjs/react-server-dom-webpack-server.node.production.js')
+
+// Craft a Flight reply that forces the *deferred* resolver path:
+//   field "0" is the root and references outlined model "1" ("$1"),
+//   field "1" resolves to an object carrying a poisoned "__proto__" key that
+//   itself forward-references model "2" ("$2") so the assignment is applied
+//   asynchronously through createModelResolver (the vulnerable code path),
+//   field "2" supplies the polluting payload.
+const form = new FormData()
+form.append('0', JSON.stringify({ a: '$1' }))
+form.append('1', JSON.stringify({ __proto__: '$2' }))
+form.append('2', JSON.stringify({ polluted: true }))
+
+// An empty bundler/webpack map is sufficient; we never resolve a client ref.
+const webpackMap = {}
+
+let threw = null
+try {
+  // decodeReply drives createResponse -> getRoot -> close, exercising the
+  // JSON.parse reviver and the deferred createModelResolver assignment.
+  server.decodeReply(form, webpackMap)
+} catch (err) {
+  // A thrown error is acceptable; prototype pollution is not.
+  threw = err
+}
+
+assert.strictEqual(
+  {}.polluted,
+  undefined,
+  'Object.prototype was polluted via __proto__ during Flight deserialization ' +
+    '(GHSA-8h8q-6873-q5fj not fixed)'
+)
+assert.strictEqual(
+  Object.prototype.hasOwnProperty('polluted'),
+  false,
+  'Object.prototype gained a "polluted" own property via __proto__ key'
+)
+
+// Clean up in case a future regression leaks state into this process.
+delete Object.prototype.polluted
+
+console.log(
+  'GHSA-8h8q-6873-q5fj regression OK: __proto__ guarded during Flight deserialization' +
+    (threw ? ' (decode threw: ' + threw.message + ')' : '')
