+++ b/test/unit/ghsa-q4gf-8mx6-v5v3-rsc-cyclic-dos.test.ts
@@ -0,0 +1,70 @@
+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 (CVE-2026-23869).
+ *
+ * A crafted cyclic / self-referential React Server Components reply payload
+ * used to bypass the single-consumption guard in the vendored RSC
+ * deserializer (initializeModelChunk): while a RESOLVED_MODEL chunk was being
+ * parsed it kept its RESOLVED_MODEL status, so a back-reference to that same
+ * chunk (e.g. "$0" inside chunk 0) caused initializeModelChunk to be invoked
+ * on it again and again, re-parsing without bound -> CPU-exhaustion DoS
+ * (CWE-770 / CWE-400).
+ *
+ * The fix transitions the chunk out of RESOLVED_MODEL (to BLOCKED) *before*
+ * JSON.parse, so any re-entrant reference to it during its own initialization
+ * takes the blocked-dependency branch instead of recursively re-parsing.
+ * Each chunk is therefore parsed at most once and decoding terminates
+ * promptly regardless of how the payload references itself.
+ *
+ * This test drives the real, vendored server bundle through its public
+ * decodeReply() entry point (the same function next's action-handler invokes
+ * on an incoming Server Function request) and asserts the crafted cyclic
+ * payload no longer hangs.
+ */
+
+// The node server bundle exposes decodeReply and does not require an edge/DOM
+// global environment, so it is the safest variant to load directly.
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const rsdw = require('next/dist/compiled/react-server-dom-webpack/server.node')
+
+// Minimal bundler map: no client references are dereferenced by these payloads.
+const emptyModuleMap = {}
+
+function decodeWithinBudget(formData: FormData, budgetMs: number): void {
+  const start = Date.now()
+  // decodeReply eagerly walks the model graph (getRoot -> initializeModelChunk).
+  // Before the fix, a cyclic payload never returns here; after the fix it
+  // returns (or throws synchronously) well within the budget.
+  try {
+    rsdw.decodeReply(formData, emptyModuleMap)
+  } catch (_err) {
+    // A thrown error (e.g. from a broken reference) is an acceptable,
+    // bounded outcome — the vulnerability is unbounded CPU, not throwing.
+  }
+  const elapsed = Date.now() - start
+  expect(elapsed).toBeLessThan(budgetMs)
+}
+
+describe('GHSA-q4gf-8mx6-v5v3: RSC cyclic-payload DoS', () => {
+  it('self-referential model chunk terminates instead of looping', () => {
+    // Field "0" is the root model; it references itself via "$0".
+    const form = new FormData()
+    form.append('0', '{"self":"$0"}')
+    decodeWithinBudget(form, 2000)
+  })
+
+  it('two-chunk reference cycle terminates instead of looping', () => {
+    // Chunk 0 -> "$1" -> chunk 1 -> "$0" -> chunk 0 ...
+    const form = new FormData()
+    form.append('0', '{"next":"$1"}')
+    form.append('1', '{"next":"$0"}')
+    decodeWithinBudget(form, 2000)
+  })
+
+  it('normal acyclic payload still decodes correctly', async () => {
+    const form = new FormData()
+    // A plain JSON object with no back-references.
+    form.append('0', '{"hello":"world","count":42}')
+    const root: any = await rsdw.decodeReply(form, emptyModuleMap)
+    expect(root).toEqual({ hello: 'world', count: 42 })
+  })
+})

