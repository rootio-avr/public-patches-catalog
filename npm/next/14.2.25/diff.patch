+++ b/test/unit/cve-2026-23864-flight-proto-guard.test.js
@@ -0,0 +1,95 @@
+/**
+ * Regression test for CVE-2026-23864 / GHSA-h25m-26qc-wcjf.
+ *
+ * DoS / prototype-pollution in the React Server Components (React Flight)
+ * reply deserializer vendored into Next.js. The asynchronous model resolver
+ * (`createModelResolver`) wrote a resolved value back into the parent object
+ * with an attacker-controlled key using a bracket assignment
+ * (`parentObject[key] = value`). Unlike `JSON.parse`, this `[[Set]]` does not
+ * skip the `"__proto__"` key, so a crafted Flight reply could pollute
+ * `Object.prototype` during deserialization of a Server Function payload.
+ *
+ * Upstream fix (facebook/react de58cca0, synced into next via 99b45010,
+ * released in next 15.0.8) guards the assignment with `key !== '__proto__'`.
+ * There is no discrete 14.x upstream source fix and no upstream test shipped
+ * with the fix (it lives entirely in the compiled, vendored bundles), so this
+ * is a hand-authored replacement test grounded in the fix diff.
+ *
+ * We assert the guard is present at the resolver sink in every loadable
+ * server bundle variant (development + production.min, which are the files
+ * `server.<runtime>.js` actually `require()`s) of all four vendored packages.
+ * On the unpatched 14.2.25 baseline every one of these files contains the
+ * bare `parentObject[key] = value` (readable) / `b[c]=<v>` (minified) sink
+ * with no `__proto__` guard, so this test fails pre-patch and passes
+ * post-patch.
+ */
+
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+
+const COMPILED = path.join(__dirname, '..', '..', 'packages', 'next', 'src', 'compiled');
+
+const PACKAGES = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+];
+const RUNTIMES = ['browser', 'edge', 'node', 'node.unbundled'];
+
+function stem(pkg) {
+  return pkg.replace('-experimental', '');
+}
+
+describe('CVE-2026-23864 React Flight __proto__ guard', () => {
+  const serverFiles = [];
+  for (const pkg of PACKAGES) {
+    for (const rt of RUNTIMES) {
+      const base = path.join(COMPILED, pkg, 'cjs', `${stem(pkg)}-server.${rt}`);
+      serverFiles.push(`${base}.development.js`);
+      serverFiles.push(`${base}.production.js`);
+      serverFiles.push(`${base}.production.min.js`);
+    }
+  }
+
+  it('patches every loadable server bundle variant', () => {
+    // 4 packages * 4 runtimes * 3 forms
+    assert.strictEqual(serverFiles.length, 48);
+    for (const f of serverFiles) {
+      assert.ok(fs.existsSync(f), `expected bundle to exist: ${f}`);
+    }
+  });
+
+  it('guards the async model resolver assignment against __proto__', () => {
+    for (const f of serverFiles) {
+      const src = fs.readFileSync(f, 'utf8');
+
+      if (f.endsWith('.min.js')) {
+        // Minified resolver sink: `return function(<v>){b[c]=<v>;...`
+        // The unpatched bare sink must be gone and replaced with the guard.
+        const bareMin = /return function\(([a-z])\)\{b\[c\]=\1;/;
+        assert.ok(
+          !bareMin.test(src),
+          `unguarded minified resolver sink still present in ${f}`
+        );
+        assert.ok(
+          src.includes('"__proto__"!==c&&(b[c]='),
+          `missing __proto__ guard in ${f}`
+        );
+      } else {
+        // Readable resolver sink.
+        assert.ok(
+          !src.includes('\n    parentObject[key] = value;\n'),
+          `unguarded resolver sink still present in ${f}`
+        );
+        assert.ok(
+          src.includes("if (key !== '__proto__') {"),
+          `missing __proto__ guard in ${f}`
+        );
+      }
+    }
+  });
+});

Cap $ACTION_REF_ fields when decoding MPA server actions [GHSA-m99w-x7hq-7vfj]

CVE-2026-64641 / GHSA-m99w-x7hq-7vfj — Denial of Service in the App Router
when using Server Actions. A crafted multipart form submission carrying a
large number of `$ACTION_REF_` fields forces excessive iteration while
decoding a possible MPA server action, driving sustained CPU usage that
blocks the Node.js event loop.

Upstream fix 019628571641dec57aaf349ba0c360e3964e6f12 caps the number of
`$ACTION_REF_` fields inside the `areAllActionIdsValid` pre-validation guard.
That guard was introduced in a later release and does not exist on the 14.2.x
line, which calls `decodeAction` directly at the multipart branches.

This backport applies to next@14.2.25 as published on the npm registry, whose
tarball ships compiled JavaScript (not TypeScript source). It adds a minimal
`hasTooManyActionRefs` helper and invokes it before the non-fetch multipart
`decodeAction` calls in both the CommonJS build
(dist/server/app-render/action-handler.js) and the ESM build
(dist/esm/server/app-render/action-handler.js). A legitimate submission only
ever carries at most two `$ACTION_REF_` fields (one from `<form action>` and
one from the submitter), so payloads exceeding that bound are disregarded
before decoding.

