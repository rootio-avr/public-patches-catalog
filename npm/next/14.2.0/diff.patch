@@ -0,0 +1,27 @@
+/* eslint-env jest */
+// Regression test for CVE-2026-75604 (GHSA-p293-qw3h-jr36):
+// incremental-cache path traversal via unescaped backslashes in path
+// segments. escapePathDelimiters must encode the backslash delimiter so a
+// segment cannot break out of the cache root on Windows-style separators.
+import escapePathDelimiters from 'next/dist/shared/lib/router/utils/escape-path-delimiters'
+
+describe('CVE-2026-75604 escapePathDelimiters', () => {
+  test('escapes backslash so it cannot be used for path traversal', () => {
+    const traversal = '..\\..\\server-reference-manifest'
+    const escaped = escapePathDelimiters(traversal)
+    // the raw backslash must not survive unescaped
+    expect(escaped).not.toContain('\\')
+    expect(escaped).toContain('%5C')
+  })
+
+  test('escapes encoded backslash (%5c) when escapeEncoded is set', () => {
+    const escaped = escapePathDelimiters('a%5cb', true)
+    expect(escaped.toLowerCase()).not.toContain('%5c'.toLowerCase() + 'b')
+    // the literal %5c token is re-encoded to %255c
+    expect(escaped).toContain('%255c')
+  })
+
+  test('still escapes the existing delimiters', () => {
+    expect(escapePathDelimiters('a/b#c?d')).toBe('a%2Fb%23c%3Fd')
+  })
+})
