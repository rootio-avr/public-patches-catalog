+// Regression test for GHSA-q4gf-8mx6-v5v3 (CWE-770).
+//
+// A crafted deeply-nested / oversized RSC model payload passed to a Server
+// Function endpoint is deserialized via react-server-dom-webpack's
+// decodeReply() -> initializeModelChunk() -> JSON.parse without any structural
+// limit, allowing excessive CPU/stack consumption (Denial of Service).
+//
+// The fix installs checkRSCModelStringLimits() before JSON.parse in the
+// vendored react-server-dom-webpack server.node.production bundles, rejecting
+// payloads that exceed a structural nesting cap while leaving normal payloads
+// working. This test exercises the production node bundle that the fix touches.
+
+const assert = require('node:assert');
+const path = require('path');
+
+const bundlePath = path.join(
+  __dirname,
+  '..',
+  'dist',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.production.js'
+);
+
+const { decodeReply } = require(bundlePath);
+const webpackMap = {};
+
+async function run() {
+  // 1. A normal, shallow reply payload must still decode successfully.
+  //    decodeReply expects a top-level JSON string field "0".
+  const normal = JSON.stringify('hello world');
+  const ok = await decodeReply(normal, webpackMap);
+  assert.strictEqual(ok, 'hello world', 'normal RSC payload should decode');
+
+  // 2. A pathologically deeply-nested payload must be rejected by the guard
+  //    rather than being handed to JSON.parse unbounded.
+  const depth = 200000;
+  const malicious = '['.repeat(depth) + ']'.repeat(depth);
+  await assert.rejects(
+    () => decodeReply(malicious, webpackMap),
+    /nesting depth|maximum allowed/i,
+    'deeply-nested RSC payload should be rejected by the structural guard'
+  );
+
+  console.log('GHSA-q4gf-8mx6-v5v3 regression test passed');
+}
+
+run().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
