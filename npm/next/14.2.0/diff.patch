+/*
+ * Regression test for CVE-2024-46982 (GHSA-gp8f-8m3g-qvj9).
+ *
+ * Upstream fix: vercel/next.js PR #69990
+ *   - commit 7ed7f125e07ef0517a331009ed7e32691ba403d3
+ *   - commit bd164d53af259c05f1ab434004bcfdd3837d7cda
+ *
+ * The upstream fix touches full standalone-mode integration tests that are not
+ * shipped in the published npm package, so this is a minimal replacement test
+ * that asserts the two source-level fixes landed in the compiled dist output:
+ *
+ *   1. base-server: the invalid "default to minimum revalidate" fallback of `1`
+ *      is removed; the render result's revalidate value is used verbatim. The
+ *      bogus fallback let a non-cacheable (SSR) response be treated as
+ *      cacheable and poisoned the response cache.
+ *   2. render: when server-side props access fails (canAccessRes = false),
+ *      metadata.revalidate is forced to 0 so the response is never cached.
+ */
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const pkgRoot = path.join(__dirname, '..');
+
+function read(rel) {
+  return fs.readFileSync(path.join(pkgRoot, rel), 'utf8');
+}
+
+const distTargets = [
+  'dist/server/base-server.js',
+  'dist/esm/server/base-server.js',
+];
+
+for (const rel of distTargets) {
+  const src = read(rel);
+  // The vulnerable fallback must be gone.
+  assert.ok(
+    !/default to minimum revalidate/.test(src),
+    `${rel}: invalid revalidate fallback comment must be removed`
+  );
+  assert.ok(
+    !/revalidate:\s*result\.revalidate\s*!==\s*undefined\s*\?\s*result\.revalidate\s*:/.test(src),
+    `${rel}: revalidate must not default to 1 when undefined`
+  );
+  // The fixed form must be present.
+  assert.ok(
+    /revalidate:\s*result\.revalidate\b/.test(src),
+    `${rel}: revalidate must pass through result.revalidate verbatim`
+  );
+}
+
+const renderTargets = [
+  'dist/server/render.js',
+  'dist/esm/server/render.js',
+];
+
+for (const rel of renderTargets) {
+  const src = read(rel);
+  // metadata.revalidate must be forced to 0 right after canAccessRes = false.
+  assert.ok(
+    /canAccessRes\s*=\s*false;\s*metadata\.revalidate\s*=\s*0;/.test(src),
+    `${rel}: metadata.revalidate must be set to 0 after canAccessRes = false`
+  );
+}
+
+console.log('CVE-2024-46982 regression test passed');

