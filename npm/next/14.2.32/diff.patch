+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 / CVE-2026-23869
+ *
+ * React Server Components (Flight protocol) Denial of Service.
+ *
+ * Root cause: in the vendored react-server-dom-* server bundles,
+ * `initializeModelChunk()` called `JSON.parse(chunk.value, ...)` while the
+ * chunk was still in the `resolved_model` state. A specially crafted
+ * Server Function payload containing self-/cyclic references (e.g. repeated
+ * `$Q0` / `$W0` / `$0` markers) would, during that JSON.parse, re-enter
+ * `getOutlinedModel()` -> `initializeModelChunk()` for the *same* chunk and
+ * re-parse the whole model again, and again, yielding O(n^2) (uncontrolled)
+ * CPU usage — an unauthenticated remote DoS (CWE-770).
+ *
+ * Fix (mirrors React 19.0.5 / 19.1.6 / 19.2.5): flip the chunk to the
+ * `blocked` state and null out its value/reason BEFORE calling JSON.parse,
+ * so a re-entrant reference to the same chunk can no longer retrigger a
+ * fresh initialization/parse.
+ *
+ * This is a source-invariant regression test (no React runtime needed): it
+ * asserts every server-side Flight deserializer bundle carries the guard.
+ * It FAILS against an unpatched (vulnerable) tree and PASSES once patched.
+ */
+'use strict';
+
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const COMPILED_DIR = path.join(
+  __dirname,
+  '..',
+  'dist',
+  'compiled'
+);
+
+const FAMILIES = [
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+];
+
+function serverBundles() {
+  const out = [];
+  for (const fam of FAMILIES) {
+    const cjs = path.join(COMPILED_DIR, fam, 'cjs');
+    if (!fs.existsSync(cjs)) continue;
+    for (const name of fs.readdirSync(cjs)) {
+      // Only the server-side deserializer bundles are affected
+      // (decodeReply / decodeAction live here).
+      if (/-server\..*\.js$/.test(name)) out.push(path.join(cjs, name));
+    }
+  }
+  return out;
+}
+
+const bundles = serverBundles().filter((f) =>
+  fs.readFileSync(f, 'utf8').includes('_fromJSON')
+);
+
+assert.ok(bundles.length > 0, 'expected to find server RSC bundles to check');
+
+for (const file of bundles) {
+  const src = fs.readFileSync(file, 'utf8');
+  const rel = path.relative(COMPILED_DIR, file);
+
+  // 1) The vulnerable form parsed straight from the live chunk value.
+  //    After the fix, the parse reads a captured `resolvedModel` snapshot
+  //    instead, so these exact patterns must be gone.
+  assert.ok(
+    !src.includes('JSON.parse(chunk.value, chunk._response._fromJSON)'),
+    `${rel}: still parses directly from chunk.value (vulnerable to re-entrant re-parse DoS)`
+  );
+  assert.ok(
+    !/JSON\.parse\(a\.value,a\._response\._fromJSON\)/.test(src),
+    `${rel}: still parses directly from a.value (vulnerable to re-entrant re-parse DoS)`
+  );
+
+  // 2) The guard: the chunk must be flipped to "blocked" (and value nulled)
+  //    before the deserializer parses the model, breaking the O(n^2) cycle.
+  const hasReadableGuard =
+    /chunk\.status = BLOCKED;\s*\n\s*chunk\.value = null;/.test(src) &&
+    /JSON\.parse\(resolvedModel, chunk\._response\._fromJSON\)/.test(src);
+  const hasMinifiedGuard =
+    /a\.status="blocked";a\.value=null;a\.reason=null;/.test(src) &&
+    /JSON\.parse\(resolvedModel,a\._response\._fromJSON\)/.test(src);
+
+  assert.ok(
+    hasReadableGuard || hasMinifiedGuard,
+    `${rel}: missing pre-parse "blocked" re-entrancy guard in initializeModelChunk`
+  );
+}
+
+console.log(
+  `GHSA-q4gf-8mx6-v5v3 regression: verified re-entrancy guard in ${bundles.length} server RSC bundles`
+);
