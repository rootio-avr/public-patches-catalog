+/**
+ * Regression test for CVE-2026-64645 (GHSA-p9j2-gv94-2wf4).
+ *
+ * SSRF / Open Redirect via attacker-controlled rewrite/redirect destination
+ * hostnames. The fix ensures "exotic" (IDN / Unicode / mixed-case) rewrite
+ * param values used in the destination hostname are percent-encoded when the
+ * destination hostname is compiled, so they cannot be smuggled through to the
+ * proxy target as a different, attacker-chosen host.
+ *
+ * Grounded on the upstream E2E test test/e2e/rewrites-hostname/* added in
+ * commit 35f501357e9b0fe7c950b0d6aa8fcf5343f707e9, reduced to a unit-level
+ * assertion against prepareDestination() since the full E2E harness
+ * (nextTestSetup + target-server) is not shipped in this target tree.
+ */
+import { prepareDestination } from 'next/dist/shared/lib/router/utils/prepare-destination'
+
+describe('CVE-2026-64645 rewrite destination hostname encoding', () => {
+  it('percent-encodes exotic (unicode) param values in the destination hostname', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: '你好' },
+      query: {},
+    })
+
+    // The unicode value must be percent-encoded, never emitted raw into the
+    // hostname where http-proxy would treat it as a distinct target host.
+    expect(parsedDestination.hostname).toBe('%E4%BD%A0%E5%A5%BD.example.com')
+    expect(parsedDestination.hostname).not.toContain('你好')
+  })
+
+  it('does not corrupt ordinary ascii hostnames', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: 'api' },
+      query: {},
+    })
+
+    expect(parsedDestination.hostname).toBe('api.example.com')
+  })
+})

