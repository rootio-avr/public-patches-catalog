+++ b/test/cve-2026-44573.test.js
@@ -0,0 +1,93 @@
+/*
+ * Regression test for CVE-2026-44573 (GHSA-36qx-fr4f-26g5)
+ * Middleware / Proxy bypass in Pages Router applications using i18n.
+ *
+ * Next.js ships only compiled output in the npm tarball (dist/), so the
+ * upstream e2e suites (test/e2e/middleware-matcher, test/e2e/middleware-general)
+ * that ground this fix cannot run against the published artifact. This
+ * standalone test instead asserts, against the compiled resolve-routes module
+ * actually shipped in the package, that the security fix from upstream commit
+ * 6c72e0b4ee096643b42c742f35e0de84c41d190d is present: when i18n is configured
+ * and no locale is detected on a data route, a non-/_next/ pathname is
+ * re-prefixed with the default locale so it is matched against the same
+ * locale-prefixed internal shape used by direct page requests (closing the
+ * middleware-bypass gap for unprefixed /_next/data/<buildId>/<page>.json).
+ */
+'use strict'
+
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+
+function locateResolveRoutes() {
+  const candidates = [
+    // npm tarball layout: this test lives at package/test/, dist at package/dist/
+    path.join(__dirname, '..', 'dist', 'server', 'lib', 'router-utils', 'resolve-routes.js'),
+    // monorepo / built source layout
+    path.join(__dirname, '..', 'packages', 'next', 'dist', 'server', 'lib', 'router-utils', 'resolve-routes.js'),
+    // resolved from the installed next package
+    (() => {
+      try {
+        const pkg = path.dirname(require.resolve('next/package.json'))
+        return path.join(pkg, 'dist', 'server', 'lib', 'router-utils', 'resolve-routes.js')
+      } catch (_) {
+        return null
+      }
+    })(),
+  ].filter(Boolean)
+
+  for (const c of candidates) {
+    if (fs.existsSync(c)) return c
+  }
+  throw new Error(
+    'Could not locate compiled resolve-routes.js in any known layout: ' +
+      candidates.join(', ')
+  )
+}
+
+describe('CVE-2026-44573: i18n default-locale data-route middleware matching', () => {
+  const cjsFile = locateResolveRoutes()
+  const cjsSource = fs.readFileSync(cjsFile, 'utf8')
+
+  it('re-prefixes default-locale non-/_next/ data routes so middleware matches (CJS dist)', () => {
+    // The pre-existing detected-locale handling must remain intact.
+    assert.ok(
+      /if\s*\(\s*curLocaleResult\.detectedLocale\s*\)/.test(cjsSource),
+      'expected the existing detectedLocale branch to be present'
+    )
+    // The security fix adds an else-if guarding on defaultLocale and excluding
+    // internal /_next/ paths.
+    assert.ok(
+      /else if\s*\(\s*defaultLocale\s*&&\s*!\s*curLocaleResult\.pathname\.startsWith\(\s*["']\/_next\/["']\s*\)\s*\)/.test(
+        cjsSource
+      ),
+      'CVE-2026-44573 fix missing: no default-locale / !/_next/ guard in compiled resolve-routes.js — ' +
+        'unprefixed /_next/data requests would bypass the i18n middleware matcher'
+    )
+    // And it must re-prefix the normalized pathname with the default locale.
+    assert.ok(
+      /normalized\s*=\s*\(?\s*0?\s*,?\s*(?:_addpathprefix\.)?addPathPrefix\)?\(/.test(cjsSource),
+      'expected the fix to re-prefix the normalized pathname with the default locale via addPathPrefix'
+    )
+  })
+
+  it('applies the same fix to the ESM build when present', () => {
+    const esmFile = cjsFile.includes(path.join('dist', 'esm'))
+      ? null
+      : cjsFile.replace(
+          path.join('dist', 'server'),
+          path.join('dist', 'esm', 'server')
+        )
+    if (!esmFile || !fs.existsSync(esmFile)) {
+      // ESM copy not shipped in this layout; CJS assertion above is sufficient.
+      return
+    }
+    const esmSource = fs.readFileSync(esmFile, 'utf8')
+    assert.ok(
+      /else if\s*\(\s*defaultLocale\s*&&\s*!\s*curLocaleResult\.pathname\.startsWith\(\s*["']\/_next\/["']\s*\)\s*\)/.test(
+        esmSource
+      ),
+      'CVE-2026-44573 fix missing from ESM build (dist/esm/server/lib/router-utils/resolve-routes.js)'
+    )
+  })
+})

