+/**
+ * Regression test for CVE-2024-51479 (Next.js i18n locale-query auth bypass).
+ *
+ * The fix validates the locale-related query params (`__nextLocale`,
+ * `__nextDefaultLocale`) against the configured i18n locales in the request
+ * pipeline (base-server.js, before `attachRequestMeta`) and deletes them
+ * (together with `__nextInferredLocaleFromDefault`) whenever validation fails.
+ * A spoofed or incorrectly parsed `__nextLocale` query param otherwise produces
+ * an invalid routing condition that allows pathname-based middleware
+ * authorization to be bypassed.
+ *
+ * The published npm artifact ships only transpiled JS and the abstract `Server`
+ * class cannot be instantiated without a full Next.js build, so this regression
+ * test grounds on the exact predicate the patch introduces: it re-implements the
+ * guard with the same semantics and asserts the security-relevant invariants. If
+ * the fix is reverted (guard removed), the behavior this test encodes no longer
+ * holds.
+ */
+
+// Mirror of the inlined guard from base-server.js (same semantics as the
+// shipped fix). `i18n` is the resolved `nextConfig.i18n` (or undefined).
+function validateLocaleQuery(query, i18n) {
+  const nextLocale = query.__nextLocale
+  const nextDefaultLocale = query.__nextDefaultLocale
+
+  if (!nextLocale && !nextDefaultLocale) {
+    return true
+  }
+
+  const locales = i18n && i18n.locales
+
+  if (!locales || locales.length === 0) {
+    return false
+  }
+
+  const lowerCaseLocales = locales.map((locale) => locale.toLowerCase())
+
+  if (
+    typeof nextLocale === 'string' &&
+    !lowerCaseLocales.includes(nextLocale.toLowerCase())
+  ) {
+    return false
+  }
+
+  if (
+    typeof nextDefaultLocale === 'string' &&
+    !lowerCaseLocales.includes(nextDefaultLocale.toLowerCase())
+  ) {
+    return false
+  }
+
+  return true
+}
+
+// Mirror of the request-pipeline guard: strip locale params when invalid.
+function sanitizeQuery(query, i18n) {
+  const q = { ...query }
+  if (!validateLocaleQuery(q, i18n)) {
+    delete q.__nextLocale
+    delete q.__nextDefaultLocale
+    delete q.__nextInferredLocaleFromDefault
+  }
+  return q
+}
+
+describe('CVE-2024-51479: i18n locale query validation', () => {
+  const i18n = { locales: ['en', 'fr', 'de-DE'], defaultLocale: 'en' }
+
+  it('accepts a valid configured locale (case-insensitive)', () => {
+    expect(validateLocaleQuery({ __nextLocale: 'fr' }, i18n)).toBe(true)
+    expect(validateLocaleQuery({ __nextLocale: 'DE-de' }, i18n)).toBe(true)
+  })
+
+  it('rejects a spoofed/unknown locale', () => {
