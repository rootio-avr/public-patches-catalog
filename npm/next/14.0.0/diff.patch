+/**
+ * Regression test for GHSA-5j59-xgg2-r9c4 / CVE-2025-67779
+ * Denial of Service in Next.js via React Server Components (CWE-400).
+ *
+ * A crafted RSC reply payload that encodes a Promise reference pointing back
+ * to its own root chunk ("$@0") makes the resolved chunk a cyclic thenable.
+ * On the vulnerable bundled react-server-dom runtime, resolving that chunk
+ * loops without a guard, hanging the request/server (CPU exhaustion).
+ *
+ * The fix adds a cyclic-thenable guard to Chunk.prototype.then, so such a
+ * payload is rejected with "Cannot have cyclic thenables." instead of
+ * looping forever.
+ *
+ * This package ships only the compiled/vendored RSC runtime (no isolable
+ * upstream source test exists in this tree), so the regression exercises the
+ * patched compiled server bundle directly, mirroring the DoS trigger shape.
+ */
+
+/* eslint-env jest */
+const path = require('path')
+
+const bundlePath = path.join(
+  __dirname,
+  '..',
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.development.js'
+)
+
+describe('GHSA-5j59-xgg2-r9c4 RSC cyclic-thenable DoS', () => {
+  it('rejects a self-referential (cyclic) RSC reply instead of hanging', async () => {
+    const bundle = require(bundlePath)
+    expect(typeof bundle.decodeReply).toBe('function')
+    expect(typeof FormData).toBe('function')
+
+    // Craft the malicious cyclic payload: root chunk 0 resolves to a Promise
+    // reference ("$@0") that points back to chunk 0 itself.
+    const body = new FormData()
+    body.append('0', '"$@0"')
+
+    const root = bundle.decodeReply(body, {})
+
+    const outcome = await Promise.race([
+      Promise.resolve(root).then(
+        () => ({ state: 'resolved' }),
+        (error) => ({
+          state: 'rejected',
+          message: String((error && error.message) || error),
+        })
+      ),
