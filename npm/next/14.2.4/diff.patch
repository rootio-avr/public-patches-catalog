@@ -0,0 +1,65 @@
+// Regression test for AIKIDO-2026-553733 (CWE-122 / GHSA-2xp9-vwfh-vxw4):
+// next/image AVIF input RCE via sharp/libheif heap buffer overflow.
+//
+// The fix disables AVIF *input* optimization: instead of decoding untrusted
+// AVIF through the underlying image library (the unsafe path), the optimizer
+// bypasses AVIF and returns the upstream buffer as-is. AVIF is also removed
+// from the set of formats eligible for build-time blur placeholder generation.
+//
+// The published npm package ships only compiled `dist/**/*.js` (no TS sources
+// and no integration harness), so this replacement test asserts the fixed
+// behavior directly against the installed compiled artifacts.
+const assert = require('node:assert')
+const fs = require('node:fs')
+const path = require('node:path')
+
+const distRoot = path.join(__dirname, '..', 'dist')
+
+function read(rel) {
+  return fs.readFileSync(path.join(distRoot, rel), 'utf8')
+}
+
+// 1. image-optimizer must treat AVIF input as a bypass type and short-circuit
+//    the decode/optimize path (returning the upstream buffer untouched).
+const optimizer = read(path.join('server', 'image-optimizer.js'))
+assert.ok(
+  /BYPASS_TYPES\s*=\s*\[[\s\S]*?AVIF[\s\S]*?\]/.test(optimizer),
+  'image-optimizer.js must define BYPASS_TYPES containing AVIF'
+)
+assert.ok(
+  /if\s*\(\s*BYPASS_TYPES\.includes\(\s*upstreamType\s*\)\s*\)/.test(optimizer),
+  'image-optimizer.js must early-return for BYPASS_TYPES (AVIF) input'
+)
+
+// 2. AVIF must no longer be an accepted blur-placeholder source format in any
+//    of the code paths that decode images to build a blurDataURL.
+const blurExtSources = [
+  path.join('build', 'webpack', 'loaders', 'next-image-loader', 'blur.js'),
+  path.join('shared', 'lib', 'get-img-props.js'),
+  path.join('client', 'legacy', 'image.js'),
+]
+for (const rel of blurExtSources) {
+  const src = read(rel)
+  for (const m of src.match(/VALID_BLUR_EXT\s*=\s*\[[\s\S]*?\]/g) || []) {
+    assert.ok(!/avif/i.test(m), `${rel}: VALID_BLUR_EXT must not include "avif"`)
+    // Non-AVIF formats remain supported (regression guard: fix stays minimal).
+    assert.ok(/webp/i.test(m), `${rel}: VALID_BLUR_EXT must still include "webp"`)
+  }
+}
+
+// 3. Static AVIF imports requesting a blur placeholder must be downgraded to
+//    an empty placeholder instead of throwing / attempting a decode.
+for (const rel of [
+  path.join('shared', 'lib', 'get-img-props.js'),
+  path.join('client', 'legacy', 'image.js'),
+]) {
+  const src = read(rel)
+  assert.ok(
+    /isStaticAvif\s*&&\s*placeholder\s*===\s*["']blur["']\s*&&\s*!blurDataURL/.test(
+      src
+    ),
+    `${rel}: static AVIF blur imports must be downgraded to an empty placeholder`
+  )
+}
+
+console.log('AIKIDO-2026-553733 regression checks passed')
