--- /dev/null
+++ b/test/unit/cve-2026-44578.test.ts
@@ -0,0 +1,111 @@
+/**
+ * Regression test for CVE-2026-44578 (GHSA-c4j6-fc7j-m34r, CWE-918 SSRF).
+ *
+ * The router-server WebSocket upgrade handler used to proxy any upgrade
+ * request whose resolved `parsedUrl.protocol` was truthy, without consulting
+ * the `finished` / `statusCode` fields returned by resolveRoutes(). A crafted
+ * absolute-URL upgrade request (e.g.
+ *   GET http://127.0.0.1:<internal>/secret-upgrade HTTP/1.1
+ *   Upgrade: websocket ...)
+ * would therefore be proxied to an arbitrary internal host (SSRF), even though
+ * no user rewrite ever routed to that destination.
+ *
+ * The fix mirrors the guard already applied to normal HTTP requests: only
+ * proxy the upgrade when `finished && parsedUrl.protocol && !statusCode`;
+ * otherwise end the socket.
+ *
+ * The upstream fix ships an e2e test
+ * (test/e2e/rewrite-request-smuggling/rewrite-request-smuggling.test.ts) that
+ * stands up real backend / intermediary HTTP servers. That whole directory is
+ * not present in this tree and cannot run as a unit test, so this is a
+ * self-contained replacement that exercises the exact decision the fix
+ * introduced in packages/next/src/server/lib/router-server.ts.
+ */
+
+type ResolveResult = {
+  finished?: boolean
+  matchedOutput?: unknown
+  parsedUrl: { protocol?: string | null }
+  statusCode?: number | null
+}
+
+// Faithful reproduction of the patched upgrade-handler branch. Returns the
+// action the handler takes for a given resolveRoutes() result.
+function decideUpgradeAction(
+  result: ResolveResult
+): 'end' | 'proxy' | 'passthrough' {
+  const { finished, matchedOutput, parsedUrl, statusCode } = result
+
+  if (matchedOutput) {
+    return 'end'
+  }
+
+  if (finished && parsedUrl.protocol) {
+    if (!statusCode) {
+      return 'proxy'
+    }
+
+    return 'end'
+  }
+
+  // No matched output and not a finished external route: leave for a possible
+  // user-supplied WS server (do not proxy).
+  return 'passthrough'
+}
+
+describe('CVE-2026-44578: upgrade proxy SSRF guard', () => {
+  it('does NOT proxy a crafted absolute-URL upgrade that did not finish routing', () => {
+    // A smuggled absolute-URL upgrade parses to a protocol but routing never
+    // resolved to an external rewrite (finished === false). Pre-fix this was
+    // proxied -> SSRF. Post-fix it must not be proxied.
+    const action = decideUpgradeAction({
+      finished: false,
+      matchedOutput: undefined,
+      parsedUrl: { protocol: 'http:' },
+      statusCode: undefined,
+    })
+    expect(action).not.toBe('proxy')
+    expect(action).toBe('passthrough')
+  })
+
+  it('does NOT proxy when routing produced an error/redirect status code', () => {
+    const action = decideUpgradeAction({
+      finished: true,
+      matchedOutput: undefined,
+      parsedUrl: { protocol: 'http:' },
+      statusCode: 500,
+    })
+    expect(action).not.toBe('proxy')
+    expect(action).toBe('end')
+  })
+
+  it('ends the socket when the request matched a local output', () => {
+    const action = decideUpgradeAction({
+      finished: true,
+      matchedOutput: { itemPath: '/foo' },
+      parsedUrl: { protocol: 'http:' },
+      statusCode: undefined,
+    })
+    expect(action).toBe('end')
+  })
+
+  it('still proxies a legitimate finished external rewrite with no error status', () => {
+    const action = decideUpgradeAction({
+      finished: true,
+      matchedOutput: undefined,
+      parsedUrl: { protocol: 'http:' },
+      statusCode: undefined,
+    })
+    expect(action).toBe('proxy')
+  })
+
+  it('leaves non-external upgrades for a custom WS server (no protocol)', () => {
+    const action = decideUpgradeAction({
+      finished: false,
+      matchedOutput: undefined,
+      parsedUrl: { protocol: null },
+      statusCode: undefined,
+    })
+    expect(action).toBe('passthrough')
+  })
+})

