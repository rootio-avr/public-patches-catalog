@@ -0,0 +1,61 @@
+/**
+ * Regression test for GHSA-mwv6-3258-q52c (Next.js App Router server-action DoS).
+ *
+ * The upstream fix (commit 385e8c286c21db9a15f4ec7bb68c8860caa08e3d) ships an
+ * e2e test (test/e2e/app-dir/no-server-actions/no-server-actions.test.ts) that
+ * requires a full running Next.js server, which is not available for the
+ * published npm artifact. This replacement asserts the equivalent fixed
+ * behavior directly against the compiled `dist/` files that ship in the
+ * tarball:
+ *
+ *   1. URL-encoded POST bodies are bailed out early (never decoded), closing
+ *      the infinite-loop / uncontrolled-CPU DoS.
+ *   2. Server-action IDs are validated before decoding
+ *      (areAllActionIdsValid / getActionModIdOrError pre-checks).
+ *   3. The vulnerable formDataFromSearchQueryString helper is removed.
+ *
+ * Ground truth: the assertions mirror the source changes in the fix commit.
+ */
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+
+function loadDist(rel) {
+  const p = path.join(__dirname, '..', 'dist', rel)
+  return fs.readFileSync(p, 'utf8')
+}
+
+const targets = [
+  'server/app-render/action-handler.js',
+  'esm/server/app-render/action-handler.js',
+]
+
+for (const rel of targets) {
+  const src = loadDist(rel)
+
+  // 1. Vulnerable URL-encoded decode helper must be gone.
+  assert.ok(
+    !src.includes('function formDataFromSearchQueryString'),
+    `${rel}: vulnerable formDataFromSearchQueryString helper should be removed`
+  )
+
+  // 2. URL-encoded actions must bail out early instead of being decoded.
+  assert.ok(
+    src.includes('if (isURLEncodedAction)'),
+    `${rel}: should bail out early on URL-encoded actions`
+  )
+
+  // 3. Action IDs must be validated before decoding MPA form data.
+  assert.ok(
+    src.includes('areAllActionIdsValid'),
+    `${rel}: should validate action IDs via areAllActionIdsValid`
+  )
+
+  // 4. Early 404 when the app defines no server actions at all.
+  assert.ok(
+    src.includes('hasServerActions'),
+    `${rel}: should short-circuit apps with no server actions`
+  )
+}
+
+console.log('GHSA-mwv6-3258-q52c regression test passed')
