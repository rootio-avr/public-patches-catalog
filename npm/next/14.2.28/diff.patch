+++ b/test/ghsa-h25m-26qc-wcjf.test.js
@@ -0,0 +1,75 @@
+/**
+ * Regression test for GHSA-h25m-26qc-wcjf
+ *
+ * React Flight (react-server-dom-{webpack,turbopack}) reply/model resolution
+ * assigned resolved values back into a parent object by key without excluding
+ * the "__proto__" key, allowing prototype pollution / DoS via crafted Flight
+ * payloads. The mitigation (ported from upstream fix 99b45010) guards every
+ * resolve sink with a `"__proto__" !== key` check before
+ * `parentObject[key] = value`.
+ *
+ * This test verifies the guard is present in every vendored compiled Flight
+ * bundle and that Object.prototype is not polluted when the guard runs.
+ */
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const COMPILED = path.join(__dirname, '..', 'packages', 'next', 'src', 'compiled');
+const VENDORS = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+];
+
+function collectResolveFiles() {
+  const files = [];
+  for (const vendor of VENDORS) {
+    const cjsDir = path.join(COMPILED, vendor, 'cjs');
+    if (!fs.existsSync(cjsDir)) continue;
+    for (const name of fs.readdirSync(cjsDir)) {
+      if (!name.endsWith('.js')) continue;
+      const src = fs.readFileSync(path.join(cjsDir, name), 'utf8');
+      if (src.includes('createModelResolver')) {
+        files.push({ file: path.join(vendor, 'cjs', name), src });
+      }
+    }
+  }
+  return files;
+}
+
+// 1. Every resolve sink is guarded, and no unguarded assignment remains.
+const files = collectResolveFiles();
+assert.ok(files.length > 0, 'expected to find vendored Flight bundles');
+for (const { file, src } of files) {
+  assert.ok(
+    src.includes('"__proto__" !== key && (parentObject[key] = value)'),
+    `missing __proto__ guard at resolve sink in ${file}`
+  );
+  assert.ok(
+    !/\n\s*parentObject\[key\] = value;/.test(src),
+    `unguarded parentObject[key] = value assignment still present in ${file}`
+  );
+}
+
+// 2. The guard expression itself must not pollute Object.prototype.
+(function assertGuardBehavior() {
+  const parentObject = {};
+  const key = '__proto__';
+  const value = { polluted: true };
+  // Mirror of the shipped guard.
+  '__proto__' !== key && (parentObject[key] = value);
+  assert.strictEqual(
+    ({}).polluted,
+    undefined,
+    'Object.prototype was polluted via __proto__ key'
+  );
+  // A legitimate key must still be assigned.
+  const okObj = {};
+  const okKey = 'name';
+  '__proto__' !== okKey && (okObj[okKey] = 'value');
+  assert.strictEqual(okObj.name, 'value', 'legitimate key assignment broke');
+})();
+
+console.log(`GHSA-h25m-26qc-wcjf regression test passed (${files.length} bundles checked)`);

