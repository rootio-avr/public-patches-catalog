+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 (CVE-2026-23869)
+ *
+ * Next.js Denial of Service with Server Components: a crafted HTTP request to an
+ * App Router Server Function endpoint could make the vendored React Flight/RSC
+ * deserializer (react-server-dom-webpack / react-server-dom-turbopack) consume a
+ * cyclic model multiple times, causing excessive CPU usage (CWE-770).
+ *
+ * Upstream (React 19.0.5/19.1.6/19.2.5, backported to Next.js 15.5.15 in commit
+ * cb90de98be409653f39ec602072740b38689a4e5) guards Map/Set/Iterator construction
+ * with a `model.$$consumed` flag so the same outlined model can never be
+ * re-consumed. Next.js 14.2.28 predates that refactor and instead builds Map/Set
+ * inline inside parseModelString (case 'Q' / case 'W'), so the backport inserts
+ * an equivalent already-consumed guard right before `new Map(...)` / `new Set(...)`.
+ *
+ * Upstream shipped no regression test with the fix. This test locks in the guard
+ * across every vendored server bundle variant that the fix touches, so a rebuild
+ * that drops the guard from any variant fails here rather than silently
+ * reintroducing the DoS.
+ */
+const fs = require('fs')
+const path = require('path')
+
+const COMPILED = path.join(
+  __dirname,
+  '..',
+  'dist',
+  'compiled'
+)
+
+const PACKAGES = {
+  'react-server-dom-webpack': 'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental': 'react-server-dom-webpack',
+  'react-server-dom-turbopack': 'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental': 'react-server-dom-turbopack',
+}
+
+const VARIANTS = [
+  'server.browser.development',
+  'server.browser.production',
+  'server.edge.development',
+  'server.edge.production',
+  'server.node.development',
+  'server.node.production',
+]
+
+function serverBundles() {
+  const files = []
+  for (const [pkg, prefix] of Object.entries(PACKAGES)) {
+    for (const v of VARIANTS) {
+      files.push(path.join(COMPILED, pkg, 'cjs', `${prefix}-${v}.js`))
+    }
+  }
+  return files
+}
+
+describe('GHSA-q4gf-8mx6-v5v3 cyclic RSC model DoS guard', () => {
+  const bundles = serverBundles()
+
+  it('patches every vendored server bundle variant', () => {
+    expect(bundles.length).toBe(24)
+    for (const f of bundles) {
+      expect(fs.existsSync(f)).toBe(true)
+    }
+  })
+
+  it.each(bundles.map((f) => [path.relative(COMPILED, f), f]))(
+    'guards Map and Set construction against double-consumption in %s',
+    (_rel, file) => {
+      const src = fs.readFileSync(file, 'utf8')
+
+      // Map (case 'Q') and Set (case 'W') both build inline in parseModelString.
+      expect(src).toMatch(/return new Map\(/)
+      expect(src).toMatch(/return new Set\(/)
+
+      // The already-consumed guard must be present for both collection kinds.
+      expect(src).toContain('Already initialized Map.')
+      expect(src).toContain('Already initialized Set.')
+      expect(src).toMatch(/\$\$consumed\s*=\s*true/)
+
+      // The guard must appear before the corresponding construction so a cyclic
+      // model is rejected instead of being deserialized a second time. Every
+      // `new Map(`/`new Set(` that consumes a model must be immediately preceded
+      // by a `$$consumed` guard block.
+      const guardBeforeMap =
+        /\$\$consumed\)\s*throw Error\("Already initialized Map\."\);\s*\w+\.\$\$consumed\s*=\s*true;\s*return new Map\(/
+      const guardBeforeSet =
+        /\$\$consumed\)\s*throw Error\("Already initialized Set\."\);\s*\w+\.\$\$consumed\s*=\s*true;\s*return new Set\(/
+      expect(src).toMatch(guardBeforeMap)
+      expect(src).toMatch(guardBeforeSet)
+    }
+  )
+})

