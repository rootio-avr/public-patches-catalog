+"use strict";
+// Regression test for CVE-2024-51479 (i18n routing authorization bypass,
+// backport of vercel/next.js PR #70761 / #70976). Exercises the shipped
+// compiled I18NProvider: locale-related query params (__nextLocale /
+// __nextDefaultLocale) are internal and must never be trusted from an
+// incoming request. validateQuery must reject a query carrying a locale
+// value that is not one of the configured locales, so the server strips
+// them instead of using an attacker-supplied value to reach pages outside
+// the configured locales (bypassing pathname-based middleware auth).
+const { I18NProvider } = require("./i18n-provider");
+
+describe("CVE-2024-51479 I18NProvider.validateQuery", () => {
+    const provider = new I18NProvider({
+        defaultLocale: "en",
+        locales: ["en", "fr", "en-CA"]
+    });
+
+    it("accepts a query with no locale params", () => {
+        expect(provider.validateQuery({})).toBe(true);
+    });
+
+    it("accepts a valid configured __nextLocale (case-insensitive)", () => {
+        expect(provider.validateQuery({ __nextLocale: "fr" })).toBe(true);
+        expect(provider.validateQuery({ __nextLocale: "EN-ca" })).toBe(true);
+    });
+
+    it("accepts a valid configured __nextDefaultLocale", () => {
+        expect(provider.validateQuery({ __nextDefaultLocale: "en" })).toBe(true);
+    });
+
+    it("rejects an unconfigured __nextLocale", () => {
+        expect(provider.validateQuery({ __nextLocale: "de" })).toBe(false);
+    });
+
+    it("rejects an unconfigured __nextDefaultLocale", () => {
+        expect(provider.validateQuery({ __nextDefaultLocale: "de" })).toBe(false);
+    });
+
+    it("rejects a poisoned locale value used for path traversal", () => {
+        expect(provider.validateQuery({ __nextLocale: "../../etc/passwd" })).toBe(false);
+    });
+});

