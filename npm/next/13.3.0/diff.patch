@@ -0,0 +1,64 @@
+/*
+ * Regression test for GHSA-8h8q-6873-q5fj (alias CVE-2026-23870, CWE-770).
+ *
+ * Denial of Service in the vendored React Server Components (Flight) runtime
+ * shipped inside next. A crafted RSC payload could build a cyclic chain of
+ * thenables (ReactPromise instances whose `.value` eventually points back at
+ * an ancestor). The pre-fix `ReactPromise.prototype.then` fulfilled branch
+ * unwrapped nested thenables with an unbounded loop, so a cycle caused
+ * unbounded CPU/memory consumption during payload deserialization.
+ *
+ * Upstream (React GHSA-rv78-f8rc-xrxh) fixed this by bounding the unwrap loop:
+ * a `cycleProtection` counter capped at 1000 plus a `visited` Set and a
+ * self-reference guard reject with `Error("Cannot have cyclic thenables.")`
+ * instead of spinning forever.
+ *
+ * Scope note: the sibling patch GHSA-mwv6-3258-q52c already installs a cyclic-
+ * thenable guard on the *node.production.min.js* bundle. This patch closes the
+ * remaining gap on the *node.unbundled.production.min.js* bundle, which no
+ * other hook touches. The assertion below is therefore scoped to that bundle
+ * so it verifies exactly this patch's incremental contribution.
+ *
+ * next@13.3.0 ships only minified production vendor bundles, so we assert the
+ * mitigation is present in the compiled server bundle. This test FAILS on the
+ * unpatched 13.3.0 bundle and PASSES once the cycle guard is backported.
+ *
+ * No network, sockets, or external services are used.
+ */
+
+const fs = require('fs')
+const path = require('path')
+const assert = require('assert')
+
+const CJS_DIR = path.join(
+  __dirname,
+  '..',
+  'dist',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs'
+)
+
+const file = 'react-server-dom-webpack-server.node.unbundled.production.min.js'
+const full = path.join(CJS_DIR, file)
+
+assert.ok(fs.existsSync(full), `expected vendored bundle to exist: ${file}`)
+const src = fs.readFileSync(full, 'utf8')
+
+// The bounded cyclic-thenable guard rejects with this exact message.
+if (src.indexOf('Cannot have cyclic thenables.') === -1) {
+  console.error(
+    `FAIL: ${file} is missing the bounded cyclic-thenable guard ` +
+      `(no "Cannot have cyclic thenables." rejection) — DoS mitigation absent`
+  )
+  process.exit(1)
+}
+
+// The guard must be bounded by the 1000-iteration cap (minified as 1E3/1e3).
+if (src.indexOf('1E3<') === -1 && src.indexOf('1e3<') === -1) {
+  console.error(
+    `FAIL: ${file} has no bounded (<=1000) iteration cap on the ` +
+      `thenable-unwrap loop`
+  )
+  process.exit(1)
+}
+
+console.log(`OK: ${file} contains bounded cyclic-thenable DoS mitigation`)
+process.exit(0)
