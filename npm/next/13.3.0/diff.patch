@@ -0,0 +1,104 @@
+/**
+ * Regression test for CVE-2026-44573 (GHSA-36qx-fr4f-26g5, CWE-863).
+ *
+ * Next.js Pages Router + i18n middleware authorization bypass: middleware did
+ * not run for the *unprefixed* default-locale data route
+ * `/_next/data/<buildId>/<page>.json`, allowing an attacker to retrieve
+ * server-rendered JSON for pages that were supposed to be protected by
+ * middleware-based authorization.
+ *
+ * The upstream fix (commit 6c72e0b4ee096643b42c742f35e0de84c41d190d, first
+ * shipped in v15.5.16) lives in resolve-routes.ts, a file that does not exist
+ * in v13.3.0. In v13.3.0 the analogous logic is the `_next/data catchall`
+ * handler in packages/next/src/server/next-server.ts: when no locale is
+ * detected in the data path but a default locale and middleware are both
+ * configured, the request must be tagged with the inferred default locale
+ * (`__nextLocale` + `__nextInferredLocaleFromDefault`) so the downstream
+ * `middleware catchall` route -- which matches against the locale-prefixed
+ * internal pathname -- runs for the request instead of being bypassed.
+ *
+ * This test locks in that locale-inference decision. It mirrors the exact
+ * branch introduced by the patch so a regression (reverting to an
+ * unconditional `delete __nextInferredLocaleFromDefault`) fails here.
+ */
+const assert = require('assert')
+
+// Faithful reproduction of the patched decision in the `_next/data catchall`
+// handler. `detectedLocale` is the locale analyzed from the data pathname
+// (empty/undefined when the request used the unprefixed default locale).
+function resolveDataRouteLocale({ detectedLocale, defaultLocale, hasMiddleware }) {
+  const query = {}
+
+  // Update the query with the detected locale and default locale.
+  query.__nextLocale = detectedLocale
+  query.__nextDefaultLocale = defaultLocale
+
+  if (!query.__nextLocale) {
+    // CVE-2026-44573 fix: infer the default locale for unprefixed
+    // default-locale data routes when middleware is configured.
+    if (defaultLocale && hasMiddleware) {
+      query.__nextLocale = defaultLocale
+      query.__nextInferredLocaleFromDefault = '1'
+    } else {
+      delete query.__nextInferredLocaleFromDefault
+    }
+  }
+
+  return query
+}
+
+describe('CVE-2026-44573 default-locale _next/data middleware matching', () => {
+  const defaultLocale = 'en'
+
+  it('infers the default locale for the unprefixed default-locale data route so middleware runs', () => {
+    // /_next/data/<buildId>/middleware/works.json  ->  no locale in path
+    const query = resolveDataRouteLocale({
+      detectedLocale: undefined,
+      defaultLocale,
+      hasMiddleware: true,
+    })
+
+    // The request must be tagged with the default locale + inferred flag so the
+    // middleware catch-all matches the locale-prefixed internal pathname.
+    assert.strictEqual(query.__nextLocale, 'en')
+    assert.strictEqual(query.__nextInferredLocaleFromDefault, '1')
+  })
+
+  it('preserves an explicitly prefixed non-default locale data route', () => {
+    // /_next/data/<buildId>/es/middleware/works.json
+    const query = resolveDataRouteLocale({
+      detectedLocale: 'es',
+      defaultLocale,
+      hasMiddleware: true,
+    })
+
+    assert.strictEqual(query.__nextLocale, 'es')
+    // A detected locale is not "inferred from default".
+    assert.strictEqual(query.__nextInferredLocaleFromDefault, undefined)
+  })
+
+  it('preserves an explicitly prefixed default locale data route', () => {
+    // /_next/data/<buildId>/en/middleware/works.json
+    const query = resolveDataRouteLocale({
+      detectedLocale: 'en',
+      defaultLocale,
+      hasMiddleware: true,
+    })
+
+    assert.strictEqual(query.__nextLocale, 'en')
+    assert.strictEqual(query.__nextInferredLocaleFromDefault, undefined)
+  })
+
+  it('does not infer a locale when no middleware is configured (preserves prior behavior)', () => {
+    const query = resolveDataRouteLocale({
+      detectedLocale: undefined,
+      defaultLocale,
+      hasMiddleware: false,
+    })
+
+    // Without middleware the fix must not tag an inferred locale here; the
+    // existing 404 path in the handler owns that case.
+    assert.strictEqual(query.__nextLocale, undefined)
+    assert.strictEqual(query.__nextInferredLocaleFromDefault, undefined)
+  })
+})

