+/**
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864)
+ *
+ * Bounds total Flight reply deserialization work via _deserializedCount
+ * (limit 1e6) in the vendored react-server-dom-webpack decoder. Applied on
+ * top of GHSA-q4gf-8mx6-v5v3, which already owns _arraySizeLimit for nesting
+ * depth / node-count scanning.
+ */
+'use strict'
+
+const assert = require('assert')
+const path = require('path')
+
+const serverModulePath = path.join(
+  __dirname,
+  '..',
+  '..',
+  'dist',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.production.min.js'
+)
+
+function resolveChunk(chunk) {
+  return new Promise((resolve, reject) => {
+    try {
+      chunk.then(resolve, reject)
+    } catch (err) {
+      reject(err)
+    }
+  })
+}
+
+async function main() {
+  const RSDW = require(serverModulePath)
+
+  const smallBody = JSON.stringify(['hello', 42, { a: 1 }])
+  const smallValue = await resolveChunk(RSDW.decodeReply(smallBody, {}))
+  assert.deepStrictEqual(
+    smallValue,
+    ['hello', 42, { a: 1 }],
+    'legitimate small payload must deserialize unchanged'
+  )
+
+  const overLimit = 1000001
+  const hugeBody = '[' + new Array(overLimit).fill('0').join(',') + ']'
+
+  let threw = false
+  let message = ''
+  try {
+    await resolveChunk(RSDW.decodeReply(hugeBody, {}))
+  } catch (err) {
+    threw = true
+    message = String((err && err.message) || err)
+  }
+
+  assert.ok(
+    threw,
+    'oversized deserialization payload must be rejected, not processed'
+  )
+  assert.ok(
+    /deserializ/i.test(message),
+    'rejection must reference the deserialization size limit, got: ' + message
+  )
+
+  console.log('GHSA-h25m-26qc-wcjf regression test passed')
+}
+
+main().catch((err) => {
+  console.error(err)
+  process.exit(1)
+})

