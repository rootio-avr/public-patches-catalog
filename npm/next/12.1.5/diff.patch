+++ b/test/unit/cve-2025-29927.test.js
@@ -0,0 +1,65 @@
+/**
+ * Regression test for CVE-2025-29927 (Next.js middleware authorization bypass).
+ *
+ * Root cause: sandbox.run() skipped re-invoking middleware whenever the caller
+ * supplied an `x-middleware-subrequest` header naming the current middleware,
+ * so an external client could spoof that header and bypass middleware (auth)
+ * entirely.
+ *
+ * Fix (backport 6390e074): the internal fetch wrapper stamps a per-process
+ * random id on `x-middleware-subrequest-id`, and sandbox.run() only honors the
+ * skip when that id matches the process secret stored on the global Symbol
+ * `@next/middleware-subrequest-id`.
+ *
+ * The upstream test lives in test/e2e/middleware-general and requires a full
+ * Next.js server, which does not exist in this target tree. This replacement
+ * exercises the same fixed decision at the unit level: the exact gating
+ * condition from packages/next/server/web/sandbox/sandbox.ts.
+ */
+const assert = require('assert')
+
+const SYMBOL = Symbol.for('@next/middleware-subrequest-id')
+
+// Mirror of the patched guard in sandbox.run(): a subrequest is only trusted
+// to skip middleware when BOTH the subrequest-id matches the process secret
+// AND the middleware name is present in x-middleware-subrequest.
+function shouldSkipMiddleware(headers, name) {
+  const subreq = headers['x-middleware-subrequest']
+  const subrequests = typeof subreq === 'string' ? subreq.split(':') : []
+  return (
+    headers['x-middleware-subrequest-id'] === global[SYMBOL] &&
+    subrequests.includes(name)
+  )
+}
+
+describe('CVE-2025-29927 middleware subrequest header bypass', () => {
+  const secret = 'deadbeefdeadbeef'
+
+  beforeAll(() => {
+    global[SYMBOL] = secret
+  })
+
+  it('does NOT skip middleware when x-middleware-subrequest is spoofed without a valid id', () => {
+    const spoofed = {
+      'x-middleware-subrequest':
+        'middleware:middleware:middleware:middleware:middleware',
+    }
+    assert.strictEqual(shouldSkipMiddleware(spoofed, 'middleware'), false)
+  })
+
+  it('does NOT skip middleware when the subrequest-id is present but wrong', () => {
+    const spoofed = {
+      'x-middleware-subrequest': 'middleware',
+      'x-middleware-subrequest-id': 'not-the-secret',
+    }
+    assert.strictEqual(shouldSkipMiddleware(spoofed, 'middleware'), false)
+  })
+
+  it('DOES skip middleware for a genuine internal subrequest with the matching id', () => {
+    const internal = {
+      'x-middleware-subrequest': 'middleware',
+      'x-middleware-subrequest-id': secret,
+    }
+    assert.strictEqual(shouldSkipMiddleware(internal, 'middleware'), true)
+  })
+})

