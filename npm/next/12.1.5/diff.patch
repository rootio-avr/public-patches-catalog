+/* eslint-env jest */
+import { prepareDestination } from 'next/dist/shared/lib/router/utils/prepare-destination'
+
+// Regression test for CVE-2026-64645 (SSRF / Open Redirect via unencoded
+// request-controlled rewrite/redirect destination hostname). The fix compiles
+// the destination hostname with `encode: encodeURIComponent` so that
+// attacker-controlled param values interpolated into the hostname cannot break
+// out of the authority component (e.g. inject a new host, credentials, port,
+// or path). Grounded on the upstream `rewrites-hostname` e2e test, which
+// asserts an exotic param value stays confined to the compiled hostname.
+describe('CVE-2026-64645 rewrite destination hostname encoding', () => {
+  it('encodes exotic param values interpolated into the destination hostname', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: 'attacker.com/' },
+      query: {},
+    })
+
+    // The slash must be percent-encoded so it cannot terminate the authority
+    // and redirect the proxy to attacker.com.
+    expect(parsedDestination.hostname).toBe('attacker.com%2F.example.com')
+    expect(parsedDestination.hostname).not.toContain('/')
+  })
+
+  it('encodes an injected @ so credentials/host cannot be spoofed', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:user.example.com/',
+      params: { user: 'x@evil.com' },
+      query: {},
+    })
+
+    expect(parsedDestination.hostname).not.toContain('@')
+    expect(parsedDestination.hostname).toBe('x%40evil.com.example.com')
+  })
+
+  it('leaves an ordinary destination hostname unchanged', () => {
+    const { parsedDestination } = prepareDestination({
+      appendParamsToQuery: false,
+      destination: 'http://:sub.example.com/',
+      params: { sub: 'api' },
+      query: {},
+    })
+
+    expect(parsedDestination.hostname).toBe('api.example.com')
+  })
+})

