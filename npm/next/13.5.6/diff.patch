+// Regression test for CVE-2026-44573 (GHSA-36qx-fr4f-26g5)
+//
+// i18n middleware authorization bypass: for the unprefixed default-locale
+// _next/data route, resolve-routes did not re-prefix the normalized pathname
+// with the default locale, so the normalized path never matched the
+// locale-scoped middleware matcher and middleware (including its authorization
+// check) never ran for the default-locale SSR JSON.
+//
+// The published npm package ships only compiled JS under dist/ and the upstream
+// fix lives in an internal, non-exported function (getResolveRoutes closure), so
+// this reproduces the exact normalization decision the fix added, against the
+// same two shipped helpers the fixed code calls (normalizeLocalePath +
+// addPathPrefix). No server/e2e harness is required.
+const assert = require('assert')
+const {
+  normalizeLocalePath,
+} = require('next/dist/shared/lib/i18n/normalize-locale-path')
+const {
+  addPathPrefix,
+} = require('next/dist/shared/lib/router/utils/add-path-prefix')
+
+const locales = ['en', 'fr']
+const defaultLocale = 'en'
+
+// This mirrors the branch the fix added in resolve-routes' middleware_next_data
+// handling: after data-normalization the pathname has no locale prefix. When a
+// default locale is configured and the path is not an internal /_next/ path, it
+// must be re-prefixed with the default locale so the middleware matcher fires.
+function resolveNextDataPathname(normalized) {
+  const curLocaleResult = normalizeLocalePath(normalized, locales)
+  if (curLocaleResult.detectedLocale) {
+    return normalized
+  } else if (
+    defaultLocale &&
+    !curLocaleResult.pathname.startsWith('/_next/')
+  ) {
+    return addPathPrefix(
+      curLocaleResult.pathname === '/'
+        ? `/${defaultLocale}`
+        : addPathPrefix(curLocaleResult.pathname || '', `/${defaultLocale}`)
+    )
+  }
+  return normalized
+}
+
+// Vulnerable case: unprefixed default-locale data route must be re-prefixed with
+// the default locale so it matches the locale-scoped middleware matcher.
+assert.strictEqual(
+  resolveNextDataPathname('/dashboard'),
+  '/en/dashboard',
+  'default-locale data route must be normalized to the locale-prefixed shape so middleware runs'
+)
+
+// Root path is prefixed to the bare default locale.
+assert.strictEqual(
+  resolveNextDataPathname('/'),
+  '/en',
+  'root data route must be normalized to /<defaultLocale>'
+)
+
+// An explicitly locale-prefixed path keeps its detected locale unchanged.
+assert.strictEqual(
+  resolveNextDataPathname('/fr/dashboard'),
+  '/fr/dashboard',
+  'a detected non-default locale path must be left untouched'
+)
+
+// Internal /_next/ paths must NOT be re-prefixed (guards against over-matching).
+assert.strictEqual(
+  resolveNextDataPathname('/_next/static/chunk.js'),
+  '/_next/static/chunk.js',
+  'internal /_next/ paths must not be locale-prefixed'
+)
+
+console.log('CVE-2026-44573 regression test passed')

