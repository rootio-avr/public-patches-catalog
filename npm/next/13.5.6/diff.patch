@@ -0,0 +1,44 @@
+// Regression test for CVE-2025-29927 (middleware auth bypass via
+// forged x-middleware-subrequest header).
+//
+// Grounds on upstream test/e2e/middleware-general "should filter request
+// header properly": an externally-supplied x-middleware-subrequest header
+// must NOT be honored, so middleware is not skipped. The compiled fix adds
+// filterInternalHeaders(), which drops x-middleware-subrequest unless it is
+// accompanied by the session-specific x-middleware-subrequest-id.
+const assert = require('assert')
+const { filterInternalHeaders } = require('../dist/server/lib/server-ipc/utils')
+
+const SUBREQUEST_ID = Symbol.for('@next/middleware-subrequest-id')
+
+// 1) Forged header without a matching id must be stripped.
+globalThis[SUBREQUEST_ID] = 'server-session-secret'
+const forged = {
+  'x-middleware-subrequest': 'middleware:middleware:middleware:middleware:middleware',
+}
+filterInternalHeaders(forged)
+assert.strictEqual(
+  forged['x-middleware-subrequest'],
+  undefined,
+  'forged x-middleware-subrequest must be removed'
+)
+
+// 2) Legitimate internal subrequest carrying the matching id is preserved.
+const legit = {
+  'x-middleware-subrequest': 'pages/_middleware',
+  'x-middleware-subrequest-id': 'server-session-secret',
+}
+filterInternalHeaders(legit)
+assert.strictEqual(
+  legit['x-middleware-subrequest'],
+  'pages/_middleware',
+  'valid x-middleware-subrequest must be preserved'
+)
+
+// 3) Other internal headers are always stripped from external requests.
+const internal = { 'x-middleware-rewrite': '/admin', 'x-matched-path': '/admin' }
+filterInternalHeaders(internal)
+assert.strictEqual(internal['x-middleware-rewrite'], undefined)
+assert.strictEqual(internal['x-matched-path'], undefined)
+
+console.log('CVE-2025-29927 regression test passed')
