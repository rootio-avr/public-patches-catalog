+/**
+ * Regression test for GHSA-5j59-xgg2-r9c4 / CVE-2025-67779
+ * (follow-up to CVE-2025-55184).
+ *
+ * A crafted Server Function deserialization payload can create cyclic
+ * thenables that cause an infinite loop in Chunk.prototype.then inside the
+ * vendored React Server DOM bundles, leading to resource exhaustion / DoS.
+ *
+ * The fix (backport of facebook/react#35351 / next.js
+ * 7c1be85a2eb9bd704140ea0dca7a6fdf93e854a7) makes Chunk.prototype.then walk
+ * the resolved value chain and bail out with "Cannot have cyclic thenables."
+ * when it either detects a self-referential Chunk (inspectedValue === chunk)
+ * or exceeds a bounded number of iterations (cycleProtection > 1000), instead
+ * of looping forever.
+ *
+ * Next.js 13.5.6 ships these bundles pre-compiled and does not export the
+ * internal Chunk class, so this test verifies the security guard is present in
+ * every vendored *server* bundle (all four RSC vendor families, every build
+ * variant: development + production.min), which is exactly the code the fix
+ * introduces. Before the patch the INITIALIZED case was simply
+ * `resolve(chunk.value)` with no cycle protection.
+ */
+
+const fs = require('fs')
+const path = require('path')
+
+const COMPILED_DIR = path.join(
+  __dirname,
+  '..',
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled'
+)
+
+const VENDOR_DIRS = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+]
+
+// Collect every vendored *server* bundle (development + production.min).
+// Client bundles are intentionally excluded: the vulnerable deserialization
+// path (and the upstream fix) is server-side only.
+function collectServerBundles() {
+  const files = []
+  for (const vendor of VENDOR_DIRS) {
+    const cjsDir = path.join(COMPILED_DIR, vendor, 'cjs')
+    if (!fs.existsSync(cjsDir)) {
+      continue
+    }
+    for (const name of fs.readdirSync(cjsDir)) {
+      if (!/-server\..*\.(development|production\.min)\.js$/.test(name)) {
+        continue
+      }
+      files.push(path.join(cjsDir, name))
+    }
+  }
+  return files
+}
+
+describe('GHSA-5j59-xgg2-r9c4: cyclic-thenable DoS guard in RSC server bundles', () => {
+  const bundles = collectServerBundles()
+
+  it('finds the vendored server bundles to check', () => {
+    expect(bundles.length).toBeGreaterThan(0)
+  })
+
+  it.each(bundles)('has cyclic-thenable protection in %s', (file) => {
+    const src = fs.readFileSync(file, 'utf8')
+
+    // The guard rejects cyclic thenables with this exact error message in
+    // every build variant (dev + minified).
+    expect(src).toContain('Cannot have cyclic thenables.')
+
+    if (file.endsWith('.production.min.js')) {
+      // Minified guard: bounded iteration cap (1E3 == 1000) present.
+      expect(src).toContain('1E3<')
+    } else {
+      // Development guard: the bounded loop counter and cap are present, and
+      // the old unguarded `resolve(chunk.value);` immediately followed by
+      // `break;` (with no intervening cycle check) is gone.
+      expect(src).toContain('cycleProtection')
+      expect(src).toContain('cycleProtection > 1000')
+      expect(src).not.toMatch(
+        /case INITIALIZED:\s*\n\s*resolve\(chunk\.value\);\s*\n\s*break;/
+      )
+    }
+  })
+})

