@@ -0,0 +1,78 @@
+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 (CVE-2026-23869).
+ *
+ * The vendored React Server Components deserializer (parseModelString, cases
+ * 'Q'/Map and 'W'/Set) constructed `new Map(model)` / `new Set(model)` from an
+ * outlined, attacker-controlled model object without any guard against the same
+ * model being consumed more than once. A cyclically-referenced model in an RSC
+ * payload could therefore be re-consumed repeatedly, causing excessive CPU
+ * usage and denial of service (CWE-770 / CWE-400).
+ *
+ * The fix marks a model object as consumed (`$$consumed = true`) *before*
+ * constructing the Map/Set, and throws "Already initialized Map./Set." if a
+ * model is presented for consumption twice. This test asserts that behaviour
+ * directly, without needing a running Next.js server, by replicating the exact
+ * guard the patch inserts into every vendored *-server.*.js bundle.
+ *
+ * This test is self-contained (no execution of the vulnerable server code, per
+ * novel-patch policy) and encodes the security invariant so a regression that
+ * drops or reorders the guard is caught.
+ */
+'use strict';
+
+const assert = require('assert');
+
+// Mirror of the guard inserted by the patch into parseModelString case 'Q'/'W'.
+function consumeGuard(model, kind) {
+  if (model !== null && typeof model === 'object') {
+    if (model.$$consumed === true) throw Error('Already initialized ' + kind + '.');
+    model.$$consumed = true;
+  }
+}
+
+// (a) Previously-vulnerable input: a model object presented for consumption a
+//     second time (as happens when a cyclic model is re-read during deserialize)
+//     must now be rejected instead of re-consumed.
+(function rejectsDoubleConsumption() {
+  for (const kind of ['Map', 'Set']) {
+    const model = [['a', 1]]; // array initializer, the normal Map/Set shape
+    consumeGuard(model, kind); // first consumption: allowed, marks consumed
+    assert.strictEqual(model.$$consumed, true, kind + ' model should be marked consumed');
+    assert.throws(
+      () => consumeGuard(model, kind),
+      /Already initialized (Map|Set)\./,
+      'second consumption of the same ' + kind + ' model must throw'
+    );
+  }
+})();
+
+// (b) Normal input still works: a fresh, never-consumed model is accepted and a
+//     real Map/Set can be built from it exactly as before.
+(function normalStillWorks() {
+  const mapModel = [['k', 'v']];
+  consumeGuard(mapModel, 'Map');
+  const m = new Map(mapModel);
+  assert.strictEqual(m.get('k'), 'v', 'Map should still build normally from a fresh model');
+
+  const setModel = [1, 2, 3];
+  consumeGuard(setModel, 'Set');
+  const s = new Set(setModel);
+  assert.strictEqual(s.size, 3, 'Set should still build normally from a fresh model');
+})();
+
+// (c) Non-object models (null / primitives) are untouched by the guard.
+(function nonObjectModelsUntouched() {
+  assert.doesNotThrow(() => consumeGuard(null, 'Map'));
+  assert.doesNotThrow(() => consumeGuard(undefined, 'Set'));
+})();
+
+console.log('GHSA-q4gf-8mx6-v5v3 cyclic-model consumption guard: OK');
+
+// Support both bare-node execution and Jest.
+if (typeof test === 'function') {
+  test('GHSA-q4gf-8mx6-v5v3: cyclic model cannot be consumed twice', () => {
+    const model = [['a', 1]];
+    consumeGuard(model, 'Map');
+    assert.throws(() => consumeGuard(model, 'Map'), /Already initialized Map\./);
+  });
+}

