--- /dev/null
+++ b/test/unit/incremental-cache/cve-2026-75604.test.ts
@@ -0,0 +1,61 @@
+import { fileURLToPath } from 'node:url'
+import path from 'node:path'
+import FileSystemCache from 'next/dist/server/lib/incremental-cache/file-system-cache'
+import { nodeFs } from 'next/dist/server/lib/node-fs-methods'
+import escapePathDelimiters from 'next/dist/shared/lib/router/utils/escape-path-delimiters'
+
+// Regression test for CVE-2026-75604 (GHSA-p293-qw3h-jr36):
+// Path traversal (CWE-22) in the ISR / incremental-cache getFilePath logic and
+// the escape-path-delimiters helper. A crafted route segment containing "../"
+// or backslashes could escape the cache root directory. The fix (1) adds a
+// containment guard to getFilePath that rejects any resolved path outside the
+// per-kind cache root, and (2) extends escapePathDelimiters to also escape the
+// backslash character (and its %5c encoded form).
+const cacheDir = fileURLToPath(new URL('./cache', import.meta.url))
+
+function makeCache() {
+  return new FileSystemCache({
+    _appDir: true,
+    _pagesDir: true,
+    _requestHeaders: {},
+    flushToDisk: true,
+    fs: nodeFs,
+    serverDistDir: cacheDir,
+    revalidatedTags: [],
+    experimental: {
+      ppr: false,
+    },
+  } as any)
+}
+
+describe('CVE-2026-75604 incremental-cache path traversal', () => {
+  it('escapePathDelimiters escapes backslashes and their encoded form', () => {
+    // A bare backslash must be percent-encoded so it cannot act as a Windows
+    // path separator downstream.
+    expect(escapePathDelimiters('a\\b')).toBe('a%5Cb')
+    // Forward slash, hash and question mark remain escaped (unchanged behavior).
+    expect(escapePathDelimiters('a/b#c?d')).toBe('a%2Fb%23c%3Fd')
+    // With escapeEncoded, the pre-encoded backslash (%5c) is escaped too.
+    expect(escapePathDelimiters('a%5cb', true)).toBe('a%255cb')
+  })
+
+  it('getFilePath rejects keys that escape the cache root', () => {
+    const fsCache = makeCache() as any
+    const traversal = `..${path.sep}..${path.sep}server-reference-manifest`
+
+    for (const kind of ['app', 'pages', 'fetch']) {
+      expect(() => fsCache.getFilePath(traversal, kind)).toThrow(
+        /Invalid file path/
+      )
+    }
+  })
+
+  it('getFilePath still returns confined paths for normal keys', () => {
+    const fsCache = makeCache() as any
+    const filePath: string = fsCache.getFilePath('index.html', 'pages')
+    const rootDir = path.join(cacheDir, 'pages')
+    expect(
+      filePath === rootDir || filePath.startsWith(rootDir + path.sep)
+    ).toBe(true)
+  })
+})

