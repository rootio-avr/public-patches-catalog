--- /dev/null
+++ b/test/ghsa-8h8q-6873-q5fj.test.js
@@ -0,0 +1,104 @@
+/**
+ * Regression test for GHSA-8h8q-6873-q5fj (CWE-770):
+ * Denial of Service with Server Components.
+ *
+ * A crafted App Router Server Function reply can reference an unbounded number
+ * of distinct rows, forcing the vendored react-server-dom-webpack Flight parser
+ * to allocate an unbounded number of chunks (excessive CPU/memory). The
+ * defensive fix caps the number of rows a single reply may allocate in
+ * getChunk() across every reachable server bundle.
+ *
+ * This test is intentionally self-contained (node:assert) so it can run under
+ * the project's jest runner or standalone via `node`. It exercises the real
+ * vendored bundles shipped in target_tree, imported the same way the runtime
+ * loads them.
+ */
+'use strict';
+
+const assert = require('node:assert');
+const path = require('node:path');
+const fs = require('node:fs');
+
+const COMPILED_DIR = path.join(
+  __dirname,
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs'
+);
+
+// The server-action decode path (see server/app-render/action-handler.ts) loads
+// react-server-dom-webpack/server.node and /server.edge, which resolve to these
+// bundles for development and production (minified) runtimes respectively.
+const REACHABLE_BUNDLES = [
+  'react-server-dom-webpack-server.node.development.js',
+  'react-server-dom-webpack-server.node.production.js',
+  'react-server-dom-webpack-server.node.production.min.js',
+  'react-server-dom-webpack-server.edge.development.js',
+  'react-server-dom-webpack-server.edge.production.js',
+  'react-server-dom-webpack-server.edge.production.min.js',
+];
+
+function run() {
+  // 1. Every reachable server bundle must enforce a bounded row limit so the
+  //    unbounded-allocation DoS cannot silently regress.
+  for (const file of REACHABLE_BUNDLES) {
+    const src = fs.readFileSync(path.join(COMPILED_DIR, file), 'utf8');
+    assert.ok(
+      /Maximum number of rows \(100000\) exceeded/.test(src),
+      `${file}: expected GHSA-8h8q-6873-q5fj row-limit guard to be present`
+    );
+    // The guard must live in the chunk-allocation path (guarded by _chunks size),
+    // i.e. it references the chunk store's size before allocating a new chunk.
+    assert.ok(
+      /\.size\s*>?=?\s*1?0*E?5|>=\s*MAX_ROWS_PER_RESPONSE|1E5<=/.test(src),
+      `${file}: row-limit guard should be tied to the chunk-store size`
+    );
+  }
+
+  // 2. Legitimate, small Server Function replies must still decode correctly
+  //    (the resource limit must not break normal operation). This part exercises
+  //    the live bundle, which requires react/react-dom to be resolvable; when
+  //    they are not (e.g. a bare source checkout) we skip it rather than emit a
+  //    false failure — the security guard above is the primary regression signal.
+  let decodeReply;
+  try {
+    ({ decodeReply } = require(path.join(
+      COMPILED_DIR,
+      'react-server-dom-webpack-server.node.development.js'
+    )));
+  } catch (err) {
+    if (err && err.code === 'MODULE_NOT_FOUND') {
+      return Promise.resolve();
+    }
+    throw err;
+  }
+
+  return Promise.resolve(decodeReply('"hello world"', {})).then((value) => {
+    assert.strictEqual(
+      value,
+      'hello world',
+      'a normal RSC reply should still decode to its value after the fix'
+    );
+  });
+}
+
+// jest-compatible registration when run under jest; otherwise self-execute.
+if (typeof test === 'function') {
+  test('GHSA-8h8q-6873-q5fj: RSC reply parser enforces a row-count resource limit', run);
+} else {
+  run().then(
+    () => {
+      // eslint-disable-next-line no-console
+      console.log('GHSA-8h8q-6873-q5fj regression test passed');
+    },
+    (err) => {
+      // eslint-disable-next-line no-console
+      console.error(err);
+      process.exit(1);
+    }
+  );
+}

