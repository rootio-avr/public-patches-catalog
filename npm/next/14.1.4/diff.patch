+/**
+ * Regression test for GHSA-h25m-26qc-wcjf / CVE-2026-23864
+ *
+ * DoS / prototype-pollution hardening in the vendored React Flight
+ * (react-server-dom) Server Function reply deserializer.
+ *
+ * A crafted App Router Server Function request can encode a *forward*
+ * reference keyed on `__proto__`, e.g. field "0" = `{"__proto__":"$1"}`
+ * where model "1" streams in later. When model "1" resolves, the async
+ * model resolver (`createModelResolver`) ran `parentObject[key] = value`
+ * with `[[Set]]` semantics. Because `key === "__proto__"`, this triggers
+ * the object's prototype setter instead of defining an own property,
+ * which upstream hardened against as part of the React Flight DoS
+ * mitigations (facebook/react de58cca0, vercel/next.js 99b45010, shipped
+ * in Next.js 15.0.8 / React 19.0.4). The fix guards the assignment with
+ * `"__proto__" !== key` so the forbidden key is dropped.
+ *
+ * The observable used here is deterministic: on a vulnerable build the
+ * attacker-controlled model is written under the root object's `__proto__`
+ * key by the async resolver; on a fixed build that write is suppressed.
+ */
+'use strict'
+
+const path = require('path')
+
+const SERVER_BUNDLE = path.join(
+  __dirname,
+  '..',
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.development.js'
+)
+
+// Minimal stand-in for a busboy stream: only the `on`/emit surface that
+// decodeReplyFromBusboy subscribes to.
+class FakeBusboy {
+  constructor() {
+    this._handlers = new Map()
+  }
+  on(event, handler) {
+    this._handlers.set(event, handler)
+    return this
+  }
+  emit(event, ...args) {
+    const handler = this._handlers.get(event)
+    if (handler) handler(...args)
+  }
+}
+
+const nextTick = () => new Promise((resolve) => setImmediate(resolve))
+const flush = () => new Promise((resolve) => setTimeout(resolve, 20))
+
+async function decodeWithForwardProtoReference() {
+  const { decodeReplyFromBusboy } = require(SERVER_BUNDLE)
+  expect(typeof decodeReplyFromBusboy).toBe('function')
+
+  const busboy = new FakeBusboy()
+  const reply = decodeReplyFromBusboy(busboy, {})
+
+  // Root model references not-yet-streamed model "1" under `__proto__`.
+  busboy.emit('field', '0', '{"__proto__":"$1"}')
+
+  // Let the root model parse while model "1" is still pending, so the
+  // dangerous assignment is deferred to the async model resolver.
+  const pending = Promise.resolve(reply)
+  await nextTick()
+
+  // Now stream the attacker-controlled model "1"; this drives the async
+  // resolver that performs parentObject["__proto__"] = value.
+  busboy.emit('field', '1', '{"marker":true}')
+  busboy.emit('finish')
+
+  let root
+  try {
+    root = await pending
+  } catch (err) {
+    // A rejected reply is acceptable; the pollution assertions below still
+    // hold and are what we care about.
+  }
+  await flush()
+  return root
+}
+
+describe('react-server-dom flight reply deserialization (GHSA-h25m-26qc-wcjf)', () => {
+  const GLOBAL_KEY = 'marker'
+
+  afterEach(() => {
+    // Guard against any leakage between assertions.
+    delete Object.prototype[GLOBAL_KEY]
+  })
+
+  it('drops a __proto__ forward reference instead of assigning it', async () => {
+    const root = await decodeWithForwardProtoReference()
+
+    // Global prototype must never be polluted.
+    expect(Object.prototype[GLOBAL_KEY]).toBeUndefined()
+    expect({}[GLOBAL_KEY]).toBeUndefined()
+
+    // The async resolver must not have written the attacker payload under
+    // the root object's `__proto__` key. On a vulnerable build this
+    // descriptor's value is `{ marker: true }`; the fix suppresses it.
+    const descriptor = Object.getOwnPropertyDescriptor(root || {}, '__proto__')
+    const wroteForbiddenKey = !!(
+      descriptor &&
+      descriptor.value &&
+      descriptor.value.marker === true
+    )
+    expect(wroteForbiddenKey).toBe(false)
+
+    // The prototype chain of the decoded object stays intact.
+    expect(Object.getPrototypeOf(root || {})).toBe(Object.prototype)
+  })
