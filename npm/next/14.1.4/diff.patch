+/**
+ * Regression test for GHSA-5j59-xgg2-r9c4 (CVE-2025-67779).
+ *
+ * The vendored React Flight Reply server bundles
+ * (dist/compiled/react-server-dom-*-server.*.js) decode a
+ * client -> server "reply" (e.g. a Server Action payload) into a tree of
+ * ReactPromise ("Chunk") objects. A crafted reply can contain a thenable
+ * that resolves back to itself (a cyclic self-thenable). When such a chunk is
+ * awaited, Chunk.prototype.then walked the chain of `inspectedValue instanceof
+ * Chunk` values with no bound, so a self-referencing chunk caused an infinite
+ * loop that blocks the Node.js event loop -> denial of service (CWE-400).
+ *
+ * The fix (facebook/react#35351, backported to next in vercel/next.js#87095)
+ * adds a `cycleProtection` counter that caps the walk at 1000 iterations and
+ * rejects with "Cannot have cyclic thenables." instead of spinning forever.
+ *
+ * These compiled bundles must be loaded with the "react-server" export
+ * condition enabled (and symlink preservation for the vendored react copies),
+ * which the jest process does not provide, so we exercise the fixed behaviour
+ * in a correctly-configured child node process and assert that:
+ *   1. a cyclic self-thenable reply REJECTS (does not hang), and
+ *   2. an ordinary reply still resolves correctly (no regression).
+ */
+const assert = require('assert')
+const fs = require('fs')
+const os = require('os')
+const path = require('path')
+const { spawnSync } = require('child_process')
+
+// repo root, from test/unit/
+const REPO_ROOT = path.resolve(__dirname, '..', '..')
+const COMPILED = path.join(REPO_ROOT, 'packages', 'next', 'src', 'compiled')
+const BUNDLE = path.join(
+  COMPILED,
+  'react-server-dom-webpack',
+  'cjs',
+  'react-server-dom-webpack-server.node.development.js'
+)
+
+function makeSymlinkEnv() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ghsa-5j59-'))
+  const nm = path.join(dir, 'node_modules')
+  const nextCompiled = path.join(nm, 'next', 'dist', 'compiled')
+  fs.mkdirSync(nextCompiled, { recursive: true })
+  const link = (target, name, base) => {
+    try {
+      fs.symlinkSync(target, path.join(base, name), 'dir')
+    } catch (_) {
+      /* best effort */
+    }
+  }
+  // Bundle requires 'react'/'react-dom' AND vendored 'next/dist/compiled/*'.
+  for (const dep of ['react', 'react-dom', 'scheduler']) {
+    const src = path.join(COMPILED, dep)
+    if (fs.existsSync(src)) {
+      link(src, dep, nm)
+      link(src, dep, nextCompiled)
+    }
+  }
+  return dir
+}
+
+function runInChild(replyModelString) {
+  const env = makeSymlinkEnv()
+  // Copy the real (post-patch) bundle into the env so that, under
+  // --preserve-symlinks, its require('react') / require('next/dist/compiled/*')
+  // resolve against this env's node_modules. This tests the exact byte content
+  // of the shipped bundle file.
+  const localBundle = path.join(env, 'bundle-under-test.js')
+  fs.writeFileSync(localBundle, fs.readFileSync(BUNDLE))
+  const runner = path.join(env, 'runner.js')
+  fs.writeFileSync(
+    runner,
+    `
+const RSDW = require(${JSON.stringify(localBundle)});
+const form = new FormData();
+form.append('0', ${JSON.stringify(replyModelString)});
