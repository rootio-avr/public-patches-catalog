--- /dev/null
+++ b/test/ghsa-mwv6-3258-q52c.test.js
@@ -0,0 +1,50 @@
+// Regression test for GHSA-mwv6-3258-q52c
+// Server Actions (next-action header) parsing must classify requests correctly so
+// that the action handler can bail out (URL-encoded / non-action) before reaching
+// decodeAction/decodeReply. Grounded on the upstream fix commit 385e8c286, which
+// added the `isServerAction` metadata field and narrowed action parsing.
+const assert = require('node:assert')
+const {
+  getServerActionRequestMetadata,
+  getIsServerAction,
+} = require('../dist/server/lib/server-action-request-meta')
+
+// A fetch-style Server Action: POST + next-action header.
+const fetchAction = getServerActionRequestMetadata({
+  method: 'POST',
+  headers: { 'next-action': 'abc123' },
+})
+assert.strictEqual(fetchAction.isFetchAction, true)
+assert.strictEqual(
+  fetchAction.isServerAction,
+  true,
+  'a POST with a next-action header must be a server action'
+)
+assert.strictEqual(
+  getIsServerAction({ method: 'POST', headers: { 'next-action': 'abc123' } }),
+  true
+)
+
+// A URL-encoded POST must be recognised so the handler can bail out early
+// (URL-encoded actions are not supported and must not reach decodeReply).
+const urlEncoded = getServerActionRequestMetadata({
+  method: 'POST',
+  headers: { 'content-type': 'application/x-www-form-urlencoded' },
+})
+assert.strictEqual(urlEncoded.isURLEncodedAction, true)
+assert.strictEqual(urlEncoded.isServerAction, true)
+
+// A multipart POST (MPA action) must be recognised.
+const multipart = getServerActionRequestMetadata({
+  method: 'POST',
+  headers: { 'content-type': 'multipart/form-data; boundary=x' },
+})
+assert.strictEqual(multipart.isMultipartAction, true)
+assert.strictEqual(multipart.isServerAction, true)
+
+// A plain GET is not a server action and must be skipped by the handler.
+const plainGet = getServerActionRequestMetadata({ method: 'GET', headers: {} })
+assert.strictEqual(plainGet.isServerAction, false)
+assert.strictEqual(getIsServerAction({ method: 'GET', headers: {} }), false)
+
+console.log('GHSA-mwv6-3258-q52c regression test passed')

