+/**
+ * Regression test for GHSA-h25m-26qc-wcjf / CVE-2026-23864
+ *
+ * Next.js vendors React's `react-server-dom-*` packages as pre-compiled
+ * bundles. A specially crafted HTTP request sent to an App Router Server
+ * Function endpoint is deserialized by React Server Components' Flight Reply
+ * parser. A self-referencing (cyclic) model reference makes
+ * `initializeModelChunk` re-enter itself indefinitely (unbounded recursion /
+ * CPU) turning a single request into a denial of service.
+ *
+ * The upstream fix (facebook/react de58cca0, shipped in
+ * react-server-dom-webpack 19.x) hardens the Flight Reply deserializer with
+ * cycle detection so a cyclic chunk is rejected ("Cannot have cyclic
+ * reference chunks.") instead of looping forever.
+ *
+ * Because the vendored code is a compiled bundle (not invokable as a plain
+ * unit without the `react-server` export condition and a built react/react-dom
+ * runtime), this test asserts the backported guard is present in every
+ * server-side Flight Reply deserializer bundle: the guard is checked inside
+ * `initializeModelChunk` (the JSON.parse choke point) and reset in its
+ * `finally` block. Pre-fix bundles have no such guard.
+ */
+
+import fs from 'fs'
+import path from 'path'
+
+const COMPILED_DIR = path.join(
+  __dirname,
+  '..',
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled'
+)
+
+const VENDOR_DIRS = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+]
+
+function serverBundles(): string[] {
+  const files: string[] = []
+  for (const vendor of VENDOR_DIRS) {
+    const cjs = path.join(COMPILED_DIR, vendor, 'cjs')
+    if (!fs.existsSync(cjs)) continue
+    for (const name of fs.readdirSync(cjs)) {
+      // Only the server bundles deserialize a Flight Reply payload.
+      if (name.includes('-server.') && name.endsWith('.js')) {
+        files.push(path.join(cjs, name))
+      }
+    }
+  }
+  return files
+}
+
+describe('GHSA-h25m-26qc-wcjf: Flight Reply deserialization DoS guard', () => {
+  const bundles = serverBundles()
+
+  it('discovers the vendored react-server-dom server bundles', () => {
+    // Sanity: the layout we depend on must exist.
+    expect(bundles.length).toBeGreaterThan(0)
+  })
+
+  it.each(bundles)(
+    'has cyclic-reference DoS protection in %s',
+    (file) => {
+      const src = fs.readFileSync(file, 'utf8')
+
+      // The model deserializer must exist in every server bundle.
+      // Readable variants keep the name; minified variants keep the same
+      // JSON.parse(...,_fromJSON) choke point.
+      const hasDeserializer =
+        src.includes('function initializeModelChunk') ||
+        src.includes('._response._fromJSON')
+      expect(hasDeserializer).toBe(true)
+
+      // The backported guard: a re-entrancy flag on the chunk that throws on
+      // a cyclic reference, and is cleared afterwards. Present in both the
+      // readable (chunk._cyclicInit) and minified (a._cyclicInit) forms.
+      expect(src).toMatch(/_cyclicInit/)
+      expect(src).toMatch(/Cannot have cyclic reference chunks\./)
+    }
+  )
+})
