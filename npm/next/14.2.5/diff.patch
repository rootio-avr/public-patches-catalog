+++ b/test/ghsa-8h8q-6873-q5fj.test.js
@@ -0,0 +1,80 @@
+/**
+ * Regression test for GHSA-8h8q-6873-q5fj / CVE-2026-23870.
+ *
+ * Next.js vendors a compiled copy of react-server-dom-{webpack,turbopack}. The
+ * React Flight Reply (RSC) parser used by App Router Server Functions did not
+ * bound the number of array slots produced while deserializing a single reply
+ * body, allowing a specially crafted HTTP request (e.g. a top-level JSON array
+ * with ~1e6+ elements) to trigger excessive CPU/memory usage — a denial of
+ * service (CWE-770).
+ *
+ * The backported fix caps the total deserialized array size inside the Flight
+ * reply reviver (`_fromJSON`) and throws
+ * "Maximum array nesting exceeded ..." once the cap (1_000_000 slots) is
+ * exceeded. Because the compiled server bundle can only be `require`d under the
+ * "react-server" export condition (not available in the default Jest runtime),
+ * this test asserts, across every vulnerable compiled server variant, that the
+ * DoS mitigation is present and wired into the deserialization path — so the
+ * mitigation cannot silently regress.
+ */
+const fs = require('fs')
+const path = require('path')
+
+const COMPILED_ROOT = path.join(
+  __dirname,
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled'
+)
+
+const VENDORED_DIRS = [
+  'react-server-dom-webpack',
+  'react-server-dom-webpack-experimental',
+  'react-server-dom-turbopack',
+  'react-server-dom-turbopack-experimental',
+]
+
+function serverBundles() {
+  const files = []
+  for (const dir of VENDORED_DIRS) {
+    const cjsDir = path.join(COMPILED_ROOT, dir, 'cjs')
+    if (!fs.existsSync(cjsDir)) continue
+    for (const name of fs.readdirSync(cjsDir)) {
+      if (!name.includes('-server.')) continue
+      if (name.includes('node-register') || name.includes('plugin')) continue
+      if (!name.endsWith('.js')) continue
+      files.push(path.join(cjsDir, name))
+    }
+  }
+  return files
+}
+
+describe('GHSA-8h8q-6873-q5fj Flight Reply DoS mitigation', () => {
+  const bundles = serverBundles()
+
+  it('discovers the vendored compiled server bundles', () => {
+    // Sanity: all four vendored dirs contribute server variants.
+    expect(bundles.length).toBeGreaterThanOrEqual(24)
+  })
+
+  it.each(bundles.map((f) => [path.relative(COMPILED_ROOT, f), f]))(
+    'enforces the array-size cap in %s',
+    (_rel, file) => {
+      const src = fs.readFileSync(file, 'utf8')
+
+      // The reviver must still exist (the deserialization entry point we guard).
+      expect(src).toContain('_fromJSON')
+
+      // The mitigation error must be present.
+      expect(src).toContain('Maximum array nesting exceeded')
+
+      // The cap must be wired to an array-length accumulator that throws once
+      // the 1e6 slot budget is exceeded (both the readable and minified forms
+      // encode the 1,000,000 threshold).
+      expect(src).toMatch(/_arraySizeCount/)
+      expect(src).toMatch(/1000000|1e6/)
+    }
+  )
+})

