+++ b/cve-2026-553733.test.js
@@ -0,0 +1,79 @@
+const assert = require('assert')
+const path = require('path')
+
+// Regression test for AIKIDO-2026-553733 (next/image: disable AVIF optimization).
+// AVIF input must NOT be decoded/re-encoded by the image optimizer (avoids a
+// heap buffer overflow / RCE when decoding untrusted AVIF via sharp/libheif).
+// The optimizer must serve the original AVIF bytes back unchanged.
+const {
+  imageOptimizer,
+  detectContentType,
+} = require(path.join(__dirname, 'dist', 'server', 'image-optimizer.js'))
+
+// Minimal valid AVIF header: bytes 4-7 = "ftyp", bytes 8-11 = "avif".
+const avifBuffer = Buffer.concat([
+  Buffer.from([0, 0, 0, 0x20]),
+  Buffer.from('ftypavif', 'ascii'),
+  Buffer.from('AVIF-BODY-BYTES-should-be-served-unchanged', 'ascii'),
+])
+
+async function main() {
+  assert.strictEqual(
+    detectContentType(avifBuffer),
+    'image/avif',
+    'test fixture must be detected as AVIF'
+  )
+
+  const paramsResult = {
+    isAbsolute: false,
+    href: '/test.avif',
+    width: 32,
+    mimeType: '', // old-Safari style Accept -> no explicit avif/webp mime
+    quality: 74,
+  }
+  const nextConfig = {
+    images: {
+      contentSecurityPolicy: '',
+      dangerouslyAllowSVG: false,
+      contentDispositionType: 'inline',
+      minimumCacheTTL: 60,
+    },
+  }
+  const req = { headers: {}, method: 'GET', connection: {} }
+  const res = {}
+  // handleRequest streams the raw AVIF bytes back as the "upstream" image.
+  const handleRequest = async (mockReq, mockRes) => {
+    mockRes.statusCode = 200
+    mockRes.setHeader('Content-Type', 'image/avif')
+    mockRes.setHeader('Cache-Control', 'public, max-age=60')
+    mockRes.write(avifBuffer)
+    mockRes.end()
+  }
+
+  const result = await imageOptimizer(
+    req,
+    res,
+    paramsResult,
+    nextConfig,
+    false,
+    handleRequest
+  )
+
+  // Fixed behavior: AVIF is bypassed -> original bytes + image/avif, no re-encode.
+  assert.strictEqual(
+    result.contentType,
+    'image/avif',
+    'AVIF input must be served back as image/avif (not downleveled to jpeg)'
+  )
+  assert.strictEqual(
+    Buffer.compare(result.buffer, avifBuffer),
+    0,
+    'AVIF bytes must be returned unchanged (not optimized/re-encoded)'
+  )
+  console.log('AIKIDO-2026-553733 regression test passed')
+}
+
+main().catch((err) => {
+  console.error(err)
+  process.exit(1)
+})

