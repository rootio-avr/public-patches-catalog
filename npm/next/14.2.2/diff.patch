@@ -0,0 +1,64 @@
+// Regression test for CVE-2025-29927 (GHSA-f82v-jwr5-mffw)
+// Middleware authorization bypass via a forged "x-middleware-subrequest" header.
+//
+// The upstream fix (Next.js 14.2.25, PR #77202/#77201) added
+// `filterInternalHeaders` in server-ipc/utils, which strips an incoming
+// "x-middleware-subrequest" header unless it is accompanied by a matching
+// per-server-instance "x-middleware-subrequest-id" (a random id stored on
+// globalThis[Symbol.for('@next/middleware-subrequest-id')]). This node:assert
+// test exercises that compiled behavior directly against the installed package
+// (the npm tarball ships only compiled dist/ JS, so the upstream e2e test in
+// test/e2e/middleware-general is not runnable here).
+const assert = require('node:assert')
+const {
+  filterInternalHeaders,
+} = require('next/dist/server/lib/server-ipc/utils')
+
+const SUBREQUEST_ID_SYMBOL = Symbol.for('@next/middleware-subrequest-id')
+const sessionId = 'deadbeefcafebabe'
+globalThis[SUBREQUEST_ID_SYMBOL] = sessionId
+
+// 1) A forged subrequest header from an external request (no matching id) must
+//    be stripped so middleware is NOT skipped -> mitigates the bypass.
+const forged = {
+  'x-middleware-subrequest':
+    'middleware:middleware:middleware:middleware:middleware',
+}
+filterInternalHeaders(forged)
+assert.strictEqual(
+  forged['x-middleware-subrequest'],
+  undefined,
+  'forged x-middleware-subrequest header must be removed'
+)
+
+// 2) A forged header carrying a wrong id must also be stripped.
+const wrongId = {
+  'x-middleware-subrequest': 'middleware',
+  'x-middleware-subrequest-id': 'not-the-session-id',
+}
+filterInternalHeaders(wrongId)
+assert.strictEqual(
+  wrongId['x-middleware-subrequest'],
+  undefined,
+  'x-middleware-subrequest with a mismatched id must be removed'
+)
+
+// 3) A legitimate in-session subrequest (matching id) must be preserved.
+const legit = {
+  'x-middleware-subrequest': 'middleware',
+  'x-middleware-subrequest-id': sessionId,
+}
+filterInternalHeaders(legit)
+assert.strictEqual(
+  legit['x-middleware-subrequest'],
+  'middleware',
+  'legitimate in-session x-middleware-subrequest header must be preserved'
+)
+
+// 4) Other internal headers must be filtered out regardless.
+const internal = { 'x-middleware-rewrite': '/somewhere', 'x-matched-path': '/' }
+filterInternalHeaders(internal)
+assert.strictEqual(internal['x-middleware-rewrite'], undefined)
+assert.strictEqual(internal['x-matched-path'], undefined)
+
+console.log('CVE-2025-29927 regression test passed')

