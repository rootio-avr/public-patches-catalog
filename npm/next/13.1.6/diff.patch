+/**
+ * Regression test for GHSA-q4gf-8mx6-v5v3 (CWE-770 DoS).
+ *
+ * The React Server Components client deserializer in
+ * packages/next/src/compiled/react-server-dom-webpack/client.js consumes a
+ * "resolved_model" chunk by parsing its JSON payload and only afterwards
+ * flipping the chunk out of the RESOLVED_MODEL state. A cyclic /
+ * self-referential model (a chunk whose payload is a reference to its own id,
+ * e.g. `"$0"` for chunk 0) therefore re-enters initialization on the same
+ * chunk before its status changes, recursing without bound and allowing the
+ * same model to be consumed repeatedly. That unbounded recursion is an
+ * uncontrolled-resource-consumption denial of service.
+ *
+ * The fix marks the chunk as consumed *before* parsing, so any re-entrant read
+ * of the same chunk throws a controlled error instead of recursing forever.
+ *
+ * This test drives the REAL compiled bundle from target_tree. The bundle only
+ * needs `react` for a context registry it never touches on this path, so we
+ * provide a minimal stub via Module._load to keep the test hermetic (no
+ * installed react / no network).
+ */
+
+const assert = require('assert')
+const path = require('path')
+const Module = require('module')
+
+const CLIENT_PATH = path.join(
+  __dirname,
+  '..',
+  'dist',
+  'compiled',
+  'react-server-dom-webpack',
+  'client.js'
+)
+
+// Minimal `react` stub: the deserialization path only reads the context
+// registry object, so an inert stub is sufficient and keeps the test hermetic.
+const reactStub = {
+  __SECRET_INTERNALS_DO_NOT_USE_OR_YOU_WILL_BE_FIRED: { ContextRegistry: {} },
+  createServerContext: () => ({ Provider: {} }),
+  createElement: () => ({}),
+}
+
+function loadClient() {
+  const originalLoad = Module._load
+  Module._load = function (request) {
+    if (request === 'react') return reactStub
+    return originalLoad.apply(this, arguments)
+  }
+  try {
+    delete require.cache[require.resolve(CLIENT_PATH)]
+    return require(CLIENT_PATH)
+  } finally {
+    Module._load = originalLoad
+  }
+}
+
+function streamOf(str) {
+  return new ReadableStream({
+    start(controller) {
+      controller.enqueue(new TextEncoder().encode(str))
+      controller.close()
+    },
+  })
+}
+
+// Encodes a single RSC row (id 0) whose model is a reference back to itself.
+const SELF_REFERENTIAL_ROW = 'J0:"$0"\n'
+
+async function run() {
+  const client = loadClient()
+
+  assert.strictEqual(
+    typeof client.createFromReadableStream,
+    'function',
+    'compiled client bundle must export createFromReadableStream'
+  )
+
+  const root = client.createFromReadableStream(streamOf(SELF_REFERENTIAL_ROW), {
+    moduleMap: {},
+  })
+
+  // Let the stream be fully consumed before we force initialization.
+  await new Promise((resolve) => setTimeout(resolve, 50))
+
+  let rejection = null
+  try {
+    root.then(
+      () => {},
+      (err) => {
+        rejection = err
+      }
+    )
+  } catch (err) {
+    rejection = err
+  }
+
+  assert.ok(
+    rejection,
+    'consuming a self-referential model must fail in a controlled way, not hang or recurse'
+  )
+
+  const message = String((rejection && rejection.message) || rejection)
+
+  // The vulnerable code recurses without bound and blows the stack
+  // ("Maximum call stack size exceeded"). The fix converts this into a
+  // controlled, bounded rejection. Assert we did NOT hit the DoS path...
+  assert.ok(
+    !/call stack size exceeded/i.test(message),
+    'self-referential model must not trigger unbounded recursion (DoS); got: ' +
+      message
+  )
+
+  // ...and DID hit the reentrancy guard.
+  assert.ok(
+    /cyclic model/i.test(message),
+    'expected the cyclic-model reentrancy guard to reject; got: ' + message
+  )
+
+  console.log('GHSA-q4gf-8mx6-v5v3 regression test passed:', message)
+}
+
+// Support both a plain `node` run and a Jest run.
+if (typeof test === 'function') {
+  test('GHSA-q4gf-8mx6-v5v3: cyclic RSC model is not consumed repeatedly', run)
+} else {
+  run().catch((err) => {
+    console.error(err)
+    process.exit(1)
+  })
+}
