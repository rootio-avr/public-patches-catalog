+/**
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864)
+ *
+ * Next.js HTTP request deserialization DoS via the bundled React Flight
+ * runtime (react-server-dom-webpack). A crafted Flight row carrying an
+ * oversized BigInt token ("$n" followed by very many digits) forced
+ * unbounded BigInt parsing / uncontrolled resource consumption during
+ * deserialization. The fix caps accepted BigInt digits at MAX_BIGINT_DIGITS
+ * (300) and rejects larger payloads with "BigInt is too large.".
+ *
+ * The upstream fix ships only compiled/vendored runtime JS (no paired test),
+ * so this is an authored replacement test grounded in that guard and the
+ * synthesized DoS repro. Plain node:assert so it is runnable without extra
+ * deps.
+ */
+'use strict'
+
+const assert = require('assert')
+
+const client = require('../dist/compiled/react-server-dom-webpack/client')
+
+function flightStream(row) {
+  const encoder = new TextEncoder()
+  return new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode(row))
+      controller.close()
+    },
+  })
+}
+
+// Resolve a Flight response, but never hang: a bounded timeout stands in for
+// the pre-fix DoS (the root chunk stayed pending forever on the bad input).
+function settle(promise, ms) {
+  return Promise.race([
+    promise.then(
+      (value) => ({ outcome: 'resolved', value }),
+      (error) => ({ outcome: 'rejected', error })
+    ),
+    new Promise((resolve) =>
+      setTimeout(() => resolve({ outcome: 'timeout' }), ms)
+    ),
+  ])
+}
+
+async function run() {
+  // 1) Oversized BigInt (301 digits) must be rejected, not parsed/hung.
+  const bigDigits = '1'.repeat(301)
+  const malicious = `0:{"value":"$n${bigDigits}"}\n`
+  const maliciousResult = await settle(
+    client.createFromReadableStream(flightStream(malicious)),
+    2000
+  )
+  assert.notStrictEqual(
+    maliciousResult.outcome,
+    'timeout',
+    'oversized BigInt must not hang deserialization (DoS)'
+  )
+  assert.strictEqual(
+    maliciousResult.outcome,
+    'rejected',
+    'oversized BigInt payload must be rejected'
+  )
+  assert.ok(
+    /BigInt is too large/.test(String(maliciousResult.error && maliciousResult.error.message)),
+    'rejection must be the BigInt size-limit guard'
+  )
+
+  // 2) A normal, small BigInt still deserializes correctly.
+  const benign = `0:{"value":"$n123"}\n`
+  const benignResult = await settle(
+    client.createFromReadableStream(flightStream(benign)),
+    2000
+  )
+  assert.strictEqual(
+    benignResult.outcome,
+    'resolved',
+    'a small BigInt must still deserialize'
+  )
+  assert.strictEqual(
+    benignResult.value.value,
+    123n,
+    'small BigInt round-trips to its value'
+  )
+
+  console.log('GHSA-h25m-26qc-wcjf regression test passed')
+}
+
+run().catch((error) => {
+  console.error(error)
+  process.exit(1)
+})

