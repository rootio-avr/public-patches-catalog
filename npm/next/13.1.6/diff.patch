+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+
+function read(rel) {
+  return fs.readFileSync(path.join(__dirname, '..', rel), 'utf8');
+}
+
+// Both the CommonJS and ESM server builds must enforce the mitigation so
+// there is no residual bypass path (CVE-2025-29927).
+const BUILDS = ['dist/server', 'dist/esm/server'];
+
+function checkBuild(base) {
+  const sandbox = read(base + '/web/sandbox/sandbox.js');
+  const context = read(base + '/web/sandbox/context.js');
+  const nextServer = read(base + '/next-server.js');
+
+  // next-server generates a per-process secret id used to authenticate
+  // internal middleware subrequests.
+  assert(
+    nextServer.includes('@next/middleware-subrequest-id'),
+    base + ': next-server must generate a per-process middleware subrequest id'
+  );
+  // context.js attaches the secret to genuine internal subrequests only.
+  assert(
+    context.includes('x-middleware-subrequest-id'),
+    base + ': context must attach the subrequest id header to internal subrequests'
+  );
+  // sandbox.js must only honor x-middleware-subrequest when the client
+  // supplied id matches the server generated secret, so a spoofed header
+  // cannot skip middleware.
+  assert(
+    sandbox.includes('x-middleware-subrequest-id'),
+    base + ': sandbox must read the subrequest id header'
+  );
+  assert(
+    /subreqId === subrequestId/.test(sandbox),
+    base + ': sandbox must compare the client id against the server secret'
+  );
+}
+
+function checkMitigation() {
+  for (const base of BUILDS) {
+    checkBuild(base);
+  }
+}
+
+if (typeof describe === 'function' && typeof it === 'function') {
+  describe('CVE-2025-29927 middleware subrequest header trust', () => {
+    it('only honors x-middleware-subrequest with the server secret', () => {
+      checkMitigation();
+    });
+  });
+} else {
+  checkMitigation();
+  console.log('CVE-2025-29927 regression test passed');
+}

