+/**
+ * Regression test for GHSA-8h8q-6873-q5fj (CVE-2026-23870, CWE-770).
+ *
+ * A crafted App Router Server Function payload could drive the vendored React
+ * Server Components (Flight) deserializer into unbounded row iteration / chunk
+ * allocation, exhausting server CPU and memory (Denial of Service). The fix
+ * bounds the deserializer with MAX_FLIGHT_ROWS and MAX_FLIGHT_PARTIAL_ROW_LENGTH
+ * caps enforced in processFullRow / S and in the partial-row accumulation.
+ *
+ * This test drives the real (patched) compiled bundle through the XHR entry
+ * point, which routes every newline-delimited row through the guarded row
+ * counter. It asserts:
+ *   (a) an over-limit payload now throws a bounded-parse error instead of
+ *       looping / allocating without bound, and
+ *   (b) a small, valid payload is still parsed without error.
+ */
+
+// Force the readable development build so the guard is exercised with a
+// human-readable error message.
+process.env.NODE_ENV = 'development';
+
+const path = require('path');
+const RSDW = require(path.join(__dirname, '..', 'client.js'));
+
+// Minimal XMLHttpRequest stand-in: collects listeners so the test can drive
+// the 'load' phase synchronously with an attacker-controlled responseText.
+function makeFakeXHR(responseText) {
+  const listeners = {};
+  return {
+    responseText,
+    addEventListener(type, cb) {
+      (listeners[type] = listeners[type] || []).push(cb);
+    },
+    dispatch(type) {
+      (listeners[type] || []).forEach((cb) => cb());
+    },
+  };
+}
+
+const MAX_FLIGHT_ROWS = 100000;
+
+describe('GHSA-8h8q-6873-q5fj Flight deserializer DoS guard', () => {
+  test('rejects a payload that exceeds the maximum number of rows', () => {
+    // Build MAX_FLIGHT_ROWS + a handful of well-formed rows ("J<id>:0\n").
+    const rows = [];
+    for (let i = 0; i < MAX_FLIGHT_ROWS + 10; i++) {
+      rows.push('J' + i.toString(16) + ':0');
+    }
+    const payload = rows.join('\n') + '\n';
+
+    const xhr = makeFakeXHR(payload);
+    RSDW.createFromXHR(xhr, { moduleMap: {} });
+
+    // The 'load' handler runs the row loop synchronously; the guard must throw.
+    expect(() => xhr.dispatch('load')).toThrow(
+      /exceeded the maximum number of rows/
+    );
+  });
+
+  test('still parses a small, valid payload without error', () => {
+    // A single simple model row is well within the limits.
+    const payload = 'J0:1\n';
+    const xhr = makeFakeXHR(payload);
+
+    expect(() => {
+      RSDW.createFromXHR(xhr, { moduleMap: {} });
+      xhr.dispatch('load');
+    }).not.toThrow();
+  });
+});

