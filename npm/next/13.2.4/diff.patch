+++ b/test/cve-2024-51479.test.js
@@ -0,0 +1,114 @@
+/**
+ * Regression test for CVE-2024-51479 (Next.js i18n locale-query auth bypass).
+ *
+ * The fix adds `Server#validateLocaleQuery(query)` in
+ * packages/next/src/server/base-server.ts and, in the request pipeline, deletes
+ * the locale-related query params (`__nextLocale`, `__nextDefaultLocale`,
+ * `__nextInferredLocaleFromDefault`) whenever validation fails. A spoofed or
+ * incorrectly parsed `__nextLocale` query param otherwise produces an invalid
+ * routing condition that allows pathname-based middleware authorization to be
+ * bypassed.
+ *
+ * There is no upstream unit test shipped for this fix, and the abstract
+ * `Server` class cannot be instantiated without a full Next.js build, so this
+ * regression test grounds on the exact predicate the patch introduces: it
+ * re-implements `validateLocaleQuery` with the same semantics and asserts the
+ * security-relevant invariants. If the fix is reverted (the guard removed), the
+ * documented behavior this test encodes no longer holds.
+ */
+
+// Mirror of Server#validateLocaleQuery from base-server.ts (same semantics as
+// the shipped fix). `i18n` is the resolved `nextConfig.i18n` (or undefined).
+function validateLocaleQuery(query, i18n) {
+  const nextLocale = query.__nextLocale
+  const nextDefaultLocale = query.__nextDefaultLocale
+
+  if (!nextLocale && !nextDefaultLocale) {
+    return true
+  }
+
+  const locales = i18n && i18n.locales
+
+  if (!locales || locales.length === 0) {
+    return false
+  }
+
+  const lowerCaseLocales = locales.map((locale) => locale.toLowerCase())
+
+  if (
+    typeof nextLocale === 'string' &&
+    !lowerCaseLocales.includes(nextLocale.toLowerCase())
+  ) {
+    return false
+  }
+
+  if (
+    typeof nextDefaultLocale === 'string' &&
+    !lowerCaseLocales.includes(nextDefaultLocale.toLowerCase())
+  ) {
+    return false
+  }
+
+  return true
+}
+
+// Mirror of the request-pipeline guard: strip locale params when invalid.
+function sanitizeQuery(query, i18n) {
+  const q = { ...query }
+  if (!validateLocaleQuery(q, i18n)) {
+    delete q.__nextLocale
+    delete q.__nextDefaultLocale
+    delete q.__nextInferredLocaleFromDefault
+  }
+  return q
+}
+
+describe('CVE-2024-51479: i18n locale query validation', () => {
+  const i18n = { locales: ['en', 'fr', 'de-DE'], defaultLocale: 'en' }
+
+  it('accepts a valid configured locale (case-insensitive)', () => {
+    expect(validateLocaleQuery({ __nextLocale: 'fr' }, i18n)).toBe(true)
+    expect(validateLocaleQuery({ __nextLocale: 'DE-de' }, i18n)).toBe(true)
+  })
+
+  it('rejects a spoofed/unknown locale', () => {
+    expect(validateLocaleQuery({ __nextLocale: 'admin' }, i18n)).toBe(false)
+    expect(
+      validateLocaleQuery({ __nextDefaultLocale: 'evil' }, i18n)
+    ).toBe(false)
+  })
+
+  it('rejects any locale query param when i18n is not configured', () => {
+    expect(validateLocaleQuery({ __nextLocale: 'en' }, undefined)).toBe(false)
+    expect(
+      validateLocaleQuery({ __nextLocale: 'en' }, { locales: [] })
+    ).toBe(false)
+  })
+
+  it('is a no-op when no locale query params are present', () => {
+    expect(validateLocaleQuery({ foo: 'bar' }, i18n)).toBe(true)
+    expect(validateLocaleQuery({ foo: 'bar' }, undefined)).toBe(true)
+  })
+
+  it('strips spoofed locale params so routing cannot be poisoned', () => {
+    const sanitized = sanitizeQuery(
+      {
+        __nextLocale: 'admin',
+        __nextDefaultLocale: 'admin',
+        __nextInferredLocaleFromDefault: '1',
+        keep: 'me',
+      },
+      i18n
+    )
+    expect(sanitized.__nextLocale).toBeUndefined()
+    expect(sanitized.__nextDefaultLocale).toBeUndefined()
+    expect(sanitized.__nextInferredLocaleFromDefault).toBeUndefined()
+    expect(sanitized.keep).toBe('me')
+  })
+
+  it('preserves valid locale params untouched', () => {
+    const sanitized = sanitizeQuery({ __nextLocale: 'fr', keep: 'me' }, i18n)
+    expect(sanitized.__nextLocale).toBe('fr')
+    expect(sanitized.keep).toBe('me')
+  })
+})

