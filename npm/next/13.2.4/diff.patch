+++ b/test/ghsa-h25m-26qc-wcjf.test.js
@@ -0,0 +1,109 @@
+/**
+ * Regression test for GHSA-h25m-26qc-wcjf (CVE-2026-23864).
+ *
+ * A crafted Server Function / RSC (React Flight) request payload can drive the
+ * vendored react-server-dom-webpack deserializer to write attacker-controlled
+ * `__proto__` keys, enabling prototype pollution (and the associated DoS) during
+ * Flight model deserialization.
+ *
+ * The upstream "Sync DoS mitigations for React Flight" fix hardens the Flight
+ * deserialization choke points so that a `__proto__` property carried in the
+ * serialized model is never written onto the reconstructed object graph. In
+ * next@13.2.4's older Flight bundle this is applied at the two assignment
+ * choke points:
+ *   - createFromJSONCallback's reviver (synchronous string/object parse), and
+ *   - createModelResolver's async assignment (parentObject[key] = value).
+ *
+ * No upstream regression test shipped for this CVE, so this test is synthesized
+ * from the vulnerability mechanism. It asserts the guard is present in every
+ * shipped client bundle, and includes a functional prototype-pollution control
+ * mirroring the shipped reviver guard semantics.
+ */
+const assert = require('assert')
+const fs = require('fs')
+const path = require('path')
+
+const CJS_DIR = path.join(
+  __dirname,
+  '..',
+  'packages',
+  'next',
+  'src',
+  'compiled',
+  'react-server-dom-webpack',
+  'cjs'
+)
+
+const DEV_BUNDLES = [
+  'react-server-dom-webpack-client.browser.development.js',
+  'react-server-dom-webpack-client.development.js',
+  'react-server-dom-webpack-client.edge.development.js',
+  'react-server-dom-webpack-client.node.development.js',
+  'react-server-dom-webpack-client.node.unbundled.development.js',
+]
+
+const PROD_BUNDLES = [
+  'react-server-dom-webpack-client.browser.production.min.js',
+  'react-server-dom-webpack-client.edge.production.min.js',
+  'react-server-dom-webpack-client.node.production.min.js',
+  'react-server-dom-webpack-client.node.unbundled.production.min.js',
+  'react-server-dom-webpack-client.production.min.js',
+]
+
+function read(bundle) {
+  return fs.readFileSync(path.join(CJS_DIR, bundle), 'utf8')
+}
+
+// 1) Every development client bundle must guard __proto__ at both choke points.
+for (const bundle of DEV_BUNDLES) {
+  const src = read(bundle)
+  assert.ok(
+    src.includes("if (key === '__proto__')"),
+    `${bundle}: missing __proto__ guard in JSON reviver (createFromJSONCallback)`
+  )
+  assert.ok(
+    src.includes("if (key !== '__proto__')"),
+    `${bundle}: missing __proto__ guard in async model resolver (createModelResolver)`
+  )
+}
+
+// 2) Every production (minified) client bundle must guard __proto__ too.
+for (const bundle of PROD_BUNDLES) {
+  const src = read(bundle)
+  assert.ok(
+    src.includes('"__proto__"===') ,
+    `${bundle}: missing __proto__ guard in minified JSON reviver`
+  )
+  assert.ok(
+    src.includes('"__proto__"!==') ,
+    `${bundle}: missing __proto__ guard in minified async model resolver`
+  )
+}
+
+// 3) Functional control: a reviver applying the shipped guard semantics must not
+//    let a crafted `__proto__` payload pollute Object.prototype.
+function guardedReviver(key, value) {
+  if (key === '__proto__') {
+    return undefined
+  }
+  return value
+}
+
+const malicious = '{"__proto__":{"polluted":"yes"},"safe":1}'
+const parsed = JSON.parse(malicious, guardedReviver)
+
+// Normal (non-vulnerable) data is preserved.
+assert.strictEqual(parsed.safe, 1, 'benign payload data must be preserved')
+
+// The prototype must remain clean for freshly created objects.
+assert.strictEqual(
+  {}.polluted,
+  undefined,
+  'Object.prototype must not be polluted after deserializing a __proto__ payload'
+)
+assert.ok(
+  !Object.prototype.hasOwnProperty('polluted'),
+  'Object.prototype must not gain attacker-controlled properties'
+)
+
+console.log('GHSA-h25m-26qc-wcjf regression test passed')

