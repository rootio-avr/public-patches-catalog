--- /dev/null
+++ b/test/cve-2026-64645.test.js
@@ -0,0 +1,74 @@
+/**
+ * Regression test for CVE-2026-64645 (GHSA-p9j2-gv94-2wf4)
+ * SSRF / Open Redirect via attacker-controlled rewrite/redirect destination hostname.
+ *
+ * Upstream fix commit 35f501357e9b0fe7c950b0d6aa8fcf5343f707e9
+ * ("[15.x] Ensure exotic rewrite param values are properly encoded") adds
+ * `encode: encodeURIComponent` to the destHostname compiler in
+ * prepare-destination so that request-controlled param values interpolated into
+ * a destination hostname can no longer inject host separators (`/`, `@`, `#`,
+ * whitespace, ...) and point the proxy target at an arbitrary host.
+ *
+ * The upstream regression suite (test/e2e/rewrites-hostname/*) is a monorepo-only
+ * e2e test that is not shipped in the published npm package, so this is a
+ * minimal replacement that exercises the same fixed behavior directly against
+ * the compiled dist module.
+ */
+const assert = require('node:assert')
+const {
+  prepareDestination,
+} = require('next/dist/shared/lib/router/utils/prepare-destination')
+
+function hostnameFor(paramValue) {
+  const { parsedDestination } = prepareDestination({
+    appendParamsToQuery: false,
+    destination: 'http://:sub.example.com/',
+    params: { sub: paramValue },
+    query: {},
+  })
+  return parsedDestination.hostname
+}
+
+// 1. A benign param interpolates unchanged.
+assert.strictEqual(
+  hostnameFor('foo'),
+  'foo.example.com',
+  'benign hostname param should interpolate unchanged'
+)
+
+// 2. A slash must be percent-encoded so it cannot terminate the host segment
+//    and redirect the proxy target to an attacker-controlled host.
+assert.strictEqual(
+  hostnameFor('evil.com/'),
+  'evil.com%2F.example.com',
+  'a forward slash in a hostname param must be percent-encoded (SSRF guard)'
+)
+
+// 3. Other exotic separators (@, #, whitespace) must also be encoded.
+assert.strictEqual(
+  hostnameFor('evil.com#'),
+  'evil.com%23.example.com',
+  'a hash in a hostname param must be percent-encoded'
+)
+assert.strictEqual(
+  hostnameFor('a b'),
+  'a%20b.example.com',
+  'whitespace in a hostname param must be percent-encoded'
+)
+
+// 4. The resulting hostname must still be confined to the configured suffix:
+//    it must end with the literal ".example.com" and contain no raw separator
+//    that could escape it.
+for (const injected of ['evil.com/', 'evil.com#', 'a b', 'x@evil.com']) {
+  const host = hostnameFor(injected)
+  assert.ok(
+    host.endsWith('.example.com'),
+    `hostname "${host}" must stay within the configured suffix`
+  )
+  assert.ok(
+    !/[/#@]/.test(host.slice(0, host.length - '.example.com'.length)),
+    `hostname "${host}" must not contain raw host separators in the injected segment`
+  )
+}
+
+console.log('CVE-2026-64645 regression test passed')

