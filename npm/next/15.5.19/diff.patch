+/**
+ * Regression test for GHSA-2xp9-vwfh-vxw4 (next/image AVIF input handling).
+ *
+ * Upstream fix commit 409772ec807def20132d251ad48fd8d8ad4c73c2
+ * ("[15.5.x] [next/image]: disable avif image optimization") disables decoding
+ * of untrusted AVIF input. Two observable consequences are asserted here:
+ *
+ *   1. 'avif' is removed from the VALID_BLUR_EXT allowlists, so a static AVIF
+ *      import with placeholder="blur" and no author-supplied blurDataURL no
+ *      longer attempts to synthesize a blur placeholder (which would require
+ *      decoding the AVIF). Instead the placeholder degrades to "empty" and the
+ *      resulting style is the plain transparent style with no backgroundImage.
+ *   2. An author-supplied blurDataURL is still honored for a static AVIF.
+ *
+ * The upstream regression suite (test/unit/next-image-get-img-props.test.ts,
+ * test/integration/image-optimizer/*) is monorepo-only and is not shipped in
+ * the published npm package, so this is a minimal replacement that exercises
+ * the fixed behavior directly against the compiled dist module.
+ */
+const assert = require('node:assert')
+const { getImgProps } = require('next/dist/shared/lib/get-img-props')
+const defaultLoader = require('next/dist/shared/lib/image-loader').default
+
+function propsFor(overrides) {
+  const { props } = getImgProps(
+    {
+      alt: 'a nice desc',
+      src: {
+        src: '/_next/static/media/test.abc123.avif',
+        width: 100,
+        height: 200,
+      },
+      placeholder: 'blur',
+      ...overrides,
+    },
+    { defaultLoader }
+  )
+  return props
+}
+
+// 1. Static AVIF + placeholder="blur" without a blurDataURL must NOT produce a
+//    generated blur backgroundImage (AVIF decoding is disabled). The placeholder
+//    degrades to empty, leaving only the transparent image style.
+const avifProps = propsFor({})
+assert.ok(
+  !(avifProps.style && avifProps.style.backgroundImage),
+  'static AVIF blur placeholder must not synthesize a backgroundImage'
+)
+assert.deepStrictEqual(
+  avifProps.style,
+  { color: 'transparent' },
+  'static AVIF blur placeholder should degrade to the empty/transparent style'
+)
+
+// 2. An author-supplied blurDataURL is still honored for a static AVIF.
+const blurDataURL = 'data:image/png;base64,custom'
+const customProps = propsFor({ blurDataURL })
+assert.ok(
+  customProps.style &&
+    typeof customProps.style.backgroundImage === 'string' &&
+    customProps.style.backgroundImage.includes(blurDataURL),
+  'a custom blurDataURL must still be used for a static AVIF'
+)
+
+// 3. The VALID_BLUR_EXT allowlist surfaced in the thrown error for a missing
+//    blurDataURL must no longer advertise 'avif' as a supported blur type.
+let sawError = false
+try {
+  getImgProps(
+    {
+      alt: 'a nice desc',
+      src: '/remote/photo.png',
+      width: 100,
+      height: 200,
+      placeholder: 'blur',
+    },
+    { defaultLoader }
+  )
+} catch (err) {
+  sawError = true
+  assert.ok(
+    !/supported file types:[^\n]*\bavif\b/.test(String(err.message)),
+    'VALID_BLUR_EXT error message must not advertise avif as a supported blur type'
+  )
+}
+assert.ok(
+  sawError,
+  'expected a missing-blurDataURL error for a non-static blur placeholder'
+)
+
+console.log('GHSA-2xp9-vwfh-vxw4 regression test passed')
