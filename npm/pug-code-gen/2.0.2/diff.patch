--- /dev/null
+++ b/test/cve-2021-21353.test.js
@@ -0,0 +1,78 @@
+'use strict';
+
+// Regression test for CVE-2021-21353: the `pretty` compile option was
+// interpolated unescaped into the generated template function, allowing
+// arbitrary JavaScript injection / RCE (CWE-94). The fix rejects any
+// non-whitespace `pretty` string and escapes the indentation value.
+var assert = require('assert');
+var generateCode = require('../index.js');
+
+var ast = {
+  type: 'Block',
+  nodes: [
+    {
+      type: 'Mixin',
+      name: 'foo',
+      args: '',
+      block: {
+        type: 'Block',
+        nodes: [{ type: 'Text', val: 'x', line: 1 }],
+        line: 1
+      },
+      call: false,
+      attrs: [],
+      attributeBlocks: [],
+      line: 1
+    }
+  ],
+  line: 0
+};
+
+// 1. A malicious non-whitespace `pretty` string must be rejected outright.
+var malicious = "');process.env.PWNED='1';pug_indent.push('";
+assert.throws(
+  function () {
+    generateCode(ast, {
+      compileDebug: false,
+      pretty: malicious,
+      inlineRuntimeFunctions: false,
+      templateName: 'tmpl'
+    });
+  },
+  /pretty parameter should either be a boolean or whitespace only string/,
+  'malicious pretty string should throw'
+);
+
+// 2. The injected payload must never appear verbatim in generated source.
+assert.throws(function () {
+  var src = generateCode(ast, {
+    compileDebug: false,
+    pretty: malicious,
+    templateName: 'tmpl'
+  });
+  assert.strictEqual(
+    src.indexOf("process.env.PWNED='1'"),
+    -1,
+    'payload leaked into generated code'
+  );
+});
+
+// 3. A legitimate whitespace-only `pretty` value still compiles fine.
+var okSrc = generateCode(ast, {
+  compileDebug: false,
+  pretty: '\t',
+  inlineRuntimeFunctions: false,
+  templateName: 'tmpl'
+});
+assert.strictEqual(typeof okSrc, 'string');
+assert.ok(okSrc.indexOf('function tmpl') !== -1);
+
+// 4. pretty: true (boolean) is normalised and compiles fine.
+var boolSrc = generateCode(ast, {
+  compileDebug: false,
+  pretty: true,
+  templateName: 'tmpl'
+});
+assert.strictEqual(typeof boolSrc, 'string');
+
+console.log('CVE-2021-21353 regression test passed');
