+'use strict';
+
+// Regression test for AIKIDO-2024-10106 (pug-code-gen code injection / CWE-94).
+// templateName and each entry of globals are interpolated verbatim into the
+// generated function source. Before the fix, a non-identifier value allowed
+// arbitrary JavaScript to be injected into the compiled template. The fix
+// rejects any templateName / globals entry that is not a valid JS identifier.
+
+var assert = require('assert');
+var generateCode = require('../index.js');
+
+var ast = {type: 'Block', nodes: []};
+
+// Malicious templateName must be rejected (code injection vector).
+assert.throws(function () {
+  generateCode(ast, {templateName: 'function(){}//'});
+}, /valid JavaScript identifier/);
+
+// Malicious global entry must be rejected (code injection vector).
+assert.throws(function () {
+  generateCode(ast, {globals: ['x); process.exit(1); (function(']});
+}, /valid JavaScript identifiers/);
+
+// Legitimate options must still compile without throwing.
+assert.doesNotThrow(function () {
+  generateCode(ast, {templateName: 'myTemplate', globals: ['myGlobal']});
+});
+
+console.log('AIKIDO-2024-10106 regression test passed');

Description: CVE-2021-21353 - sanitise and escape the `pretty` option in pug-code-gen.
 A crafted `pretty` compile option (a non-whitespace string) was interpolated
 unescaped into the generated template function via `pug_indent.push('...')`,
 allowing arbitrary JavaScript to be injected and executed at render time
 (CWE-94, remote code execution). This validates that `pretty` is boolean or a
 whitespace-only string, and escapes the indentation value with js-stringify
 before emitting it into the compiled function source.
Origin: backport, https://github.com/pugjs/pug/commit/991e78f7c4220b2f8da042877c6f0ef5a4683be0
