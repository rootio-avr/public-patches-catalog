--- /dev/null
+++ b/test/cve-2026-118257.test.js
@@ -0,0 +1,44 @@
+'use strict'
+// Regression test for CVE-2026-118257 (GHSA-83rm-6c8r-g728):
+// `srcdoc` must be neutralized in translations when `escapeParameter` is enabled.
+const assert = require('node:assert')
+const {
+  createCoreContext,
+  registerMessageCompiler,
+  compile,
+  translate
+} = require('../index.js')
+
+registerMessageCompiler(compile)
+
+const SRCDOC_ATTR = /(^|[\s"'<>/])srcdoc\s*=/i
+
+const ctx = createCoreContext({
+  locale: 'en',
+  warnHtmlMessage: false,
+  escapeParameter: true,
+  messages: {
+    en: {
+      inMessage: '<iframe srcdoc="<b>x</b>"></iframe>',
+      inMessageUpper: '<iframe SRCDOC="<b>x</b>"></iframe>',
+      inMessageSpaced: '<iframe srcdoc = "<b>x</b>"></iframe>',
+      inParameter: '<iframe srcdoc="{content}"></iframe>',
+      safe: '<div data-srcdoc="x">Test</div>'
+    }
+  }
+})
+
+for (const key of ['inMessage', 'inMessageUpper', 'inMessageSpaced']) {
+  const result = translate(ctx, key)
+  assert.strictEqual(SRCDOC_ATTR.test(result), false, `${key}: ${result}`)
+  assert.ok(result.includes('&#115;rcdoc') || result.includes('&#115;RCDOC'))
+}
+
+const injected = translate(ctx, 'inParameter', { content: '<b>x</b>' })
+assert.strictEqual(SRCDOC_ATTR.test(injected), false, injected)
+assert.ok(injected.includes('&#115;rcdoc'))
+
+// attributes that merely contain `srcdoc` in their name are left as is
+assert.strictEqual(translate(ctx, 'safe'), '<div data-srcdoc="x">Test</div>')
+
+console.log('CVE-2026-118257 regression test passed')
