diff --git a/test/unit/commands/test-cleartext-plugin-gate.test.cjs b/test/unit/commands/test-cleartext-plugin-gate.test.cjs
new file mode 100644
index 0000000..1681f71
--- /dev/null
+++ b/test/unit/commands/test-cleartext-plugin-gate.test.cjs
@@ -0,0 +1,108 @@
+'use strict';
+
+// Regression test for GHSA-3f6p-5ww8-9rcr:
+// The mysql_clear_password auth plugin sends the password in plaintext. A
+// malicious server can request an auth switch to mysql_clear_password and
+// capture credentials. The client must NOT honor such a request by default;
+// it must be explicitly opted in via `enableCleartextPlugin: true` or a
+// custom `mysql_clear_password` entry in `authPlugins`.
+
+const { assert } = require('poku');
+const authSwitch = require('../../../lib/commands/auth_switch');
+const Packets = require('../../../lib/packets/index.js');
+
+function buildClearPasswordSwitchPacket() {
+  const packet = new Packets.AuthSwitchRequest({
+    pluginName: 'mysql_clear_password',
+    pluginData: Buffer.alloc(0)
+  }).toPacket();
+  // toPacket() leaves the read cursor at the end; reset like a received packet.
+  packet.offset = 4;
+  return packet;
+}
+
+function makeConnection(config) {
+  return {
+    config,
+    _authPlugin: null,
+    writePacket() {}
+  };
+}
+
+// 1. Default: cleartext auth switch must be rejected with a specific error.
+{
+  const connection = makeConnection({
+    password: 'test_password',
+    authPlugins: undefined,
+    enableCleartextPlugin: false
+  });
+  let thrown = null;
+  try {
+    authSwitch.authSwitchRequest(
+      buildClearPasswordSwitchPacket(),
+      connection,
+      {}
+    );
+  } catch (err) {
+    thrown = err;
+  }
+  assert.ok(thrown, 'cleartext auth switch should be rejected by default');
+  assert.equal(
+    thrown.code,
+    'MYSQL_CLEAR_PASSWORD_NOT_ENABLED',
+    'should throw MYSQL_CLEAR_PASSWORD_NOT_ENABLED by default'
+  );
+  assert.equal(thrown.fatal, true, 'error should be fatal');
+  assert.ok(
+    thrown.message.includes('enableCleartextPlugin'),
+    'error message should mention the enableCleartextPlugin option'
+  );
+}
+
+// 2. Opt-in via enableCleartextPlugin: true must NOT throw the gate error.
+{
+  const connection = makeConnection({
+    password: 'test_password',
+    authPlugins: undefined,
+    enableCleartextPlugin: true
+  });
+  let thrown = null;
+  try {
+    authSwitch.authSwitchRequest(
+      buildClearPasswordSwitchPacket(),
+      connection,
+      {}
+    );
+  } catch (err) {
+    thrown = err;
+  }
+  assert.ok(
+    !thrown || thrown.code !== 'MYSQL_CLEAR_PASSWORD_NOT_ENABLED',
+    'enableCleartextPlugin: true should allow cleartext auth'
+  );
+}
+
+// 3. Implicit opt-in via a custom authPlugins entry must NOT throw the gate.
+{
+  const connection = makeConnection({
+    password: 'custom_password',
+    authPlugins: {
+      mysql_clear_password: () => () => Buffer.from('custom_password\0')
+    },
+    enableCleartextPlugin: false
+  });
+  let thrown = null;
+  try {
+    authSwitch.authSwitchRequest(
+      buildClearPasswordSwitchPacket(),
+      connection,
+      {}
+    );
+  } catch (err) {
+    thrown = err;
+  }
+  assert.ok(
+    !thrown || thrown.code !== 'MYSQL_CLEAR_PASSWORD_NOT_ENABLED',
+    'a custom mysql_clear_password plugin should count as opt-in'
+  );
+}
