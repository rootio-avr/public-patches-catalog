--- /dev/null
+++ b/test/integration/test-cleartext-plugin-gate.test.cjs
@@ -0,0 +1,77 @@
+'use strict';
+
+// Regression test for GHSA-3f6p-5ww8-9rcr: the built-in mysql_clear_password
+// plugin must be disabled by default. A malicious server that requests
+// cleartext auth via an AuthSwitchRequest must not be able to make the client
+// leak the password in plaintext; the connection should instead fail with a
+// MYSQL_CLEAR_PASSWORD_NOT_ENABLED error.
+
+const mysql = require('../../index.js');
+const Command = require('../../lib/commands/command.js');
+const Packets = require('../../lib/packets/index.js');
+const { Buffer } = require('node:buffer');
+const assert = require('node:assert');
+const process = require('node:process');
+
+// The process is not terminated in Deno
+if (typeof Deno !== 'undefined') process.exit(0);
+
+class CleartextAuthSwitch extends Command {
+  start(_, connection) {
+    const serverHelloPacket = new Packets.Handshake({
+      protocolVersion: 10,
+      serverVersion: 'node.js rocks',
+      connectionId: 1234,
+      statusFlags: 2,
+      characterSet: 8,
+      capabilityFlags: 0xffffff,
+    });
+    serverHelloPacket.setScrambleData(() => {
+      connection.writePacket(serverHelloPacket.toPacket(0));
+    });
+    return CleartextAuthSwitch.prototype.sendAuthSwitchRequest;
+  }
+
+  sendAuthSwitchRequest(_, connection) {
+    const asr = new Packets.AuthSwitchRequest({
+      pluginName: 'mysql_clear_password',
+      pluginData: Buffer.allocUnsafe(0),
+    });
+    connection.writePacket(asr.toPacket());
+    return CleartextAuthSwitch.prototype.finish;
+  }
+
+  finish(_, connection) {
+    connection.end();
+    return CleartextAuthSwitch.prototype.finish;
+  }
+}
+
+const server = mysql.createServer((conn) => {
+  conn.on('error', () => {});
+  conn.addCommand(new CleartextAuthSwitch());
+});
+
+let error;
+
+const portfinder = require('portfinder');
+portfinder.getPort((_, port) => {
+  server.listen(port);
+  const conn = mysql.createConnection({
+    port: port,
+    user: 'test_user',
+    password: 'test_password',
+  });
+
+  conn.on('error', (err) => {
+    error = err;
+    conn.destroy();
+    server.close();
+  });
+});
+
+process.on('exit', () => {
+  assert.ok(error, 'connection should emit an error');
+  assert.equal(error.code, 'MYSQL_CLEAR_PASSWORD_NOT_ENABLED');
+  assert.ok(error.message.includes('enableCleartextPlugin'));
+});
