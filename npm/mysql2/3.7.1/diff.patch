+'use strict';
+
+// Regression test for CVE-2024-21511 (mysql2 timezone code injection / CWE-94).
+//
+// The text/binary row parsers build parser source code by interpolating the
+// user-controlled `timezone` option into a generated JS string. Before the fix
+// the value was wrapped in raw single quotes (`packet.parseDate('${timezone}')`),
+// so a crafted timezone could break out of the string literal and inject
+// arbitrary code that runs when the generated parser is compiled. The fix routes
+// the value through helpers.srcEscape() instead.
+//
+// The upstream tests (test/esm/unit/parsers/timezone-*-sanitization.test.mjs)
+// require a live MySQL connection and the poku ESM harness, neither of which is
+// available in this target tree, so this is a DB-free replacement that asserts
+// on the sanitizer that the fix relies on and on the shape of the generated code.
+
+const assert = require('assert');
+const helpers = require('../lib/helpers');
+
+// The exact injection payload used by the upstream regression tests.
+const PAYLOAD = `'); process.env.TEST_ENV_VALUE = "not so much"; //`;
+
+// 1. srcEscape must produce a single, self-contained JS string literal.
+const escaped = helpers.srcEscape(PAYLOAD);
+assert.strictEqual(
+  typeof escaped,
+  'string',
+  'srcEscape must return a string'
+);
+
+// 2. Emulate the fixed generated snippet and confirm the payload stays inert:
+//    the whole timezone value must remain the single string argument, so
+//    evaluating the snippet yields exactly the original payload and nothing
+//    outside the literal executes.
+process.env.TEST_ENV_VALUE = 'secure';
+// eslint-disable-next-line no-eval
+const result = eval(`(function(){ return ${escaped}; })()`);
+assert.strictEqual(
+  result,
+  PAYLOAD,
+  'Escaped timezone must round-trip as a single string literal'
+);
+assert.strictEqual(
+  process.env.TEST_ENV_VALUE,
+  'secure',
+  'Timezone sanitization failed - code injection possible'
+);
+
+// 3. Guard against the pre-fix pattern: the escaped form must NOT be the naive
+//    raw single-quote wrapping that allowed the breakout.
+assert.notStrictEqual(
+  escaped,
+  `'${PAYLOAD}'`,
+  'srcEscape must not emit the vulnerable raw-quoted form'
+);
+
+// 4. A normal timezone value must still round-trip correctly.
+assert.strictEqual(
+  // eslint-disable-next-line no-eval
+  eval(`(function(){ return ${helpers.srcEscape('Z')}; })()`),
+  'Z',
+  'Benign timezone value must be preserved'
+);
+
+console.log('CVE-2024-21511 regression test passed');

