+++ b/test/cve-2024-21512.test.js
@@ -0,0 +1,57 @@
+'use strict';
+
+// Regression test for CVE-2024-21512 (prototype pollution via nestTables).
+// Ported from the upstream ESM tests
+// test/esm/unit/parsers/ensure-safe-binary-fields.test.mjs and
+// ensure-safe-text-fields.test.mjs, adapted to node:assert because the
+// target tree (mysql2@3.7.1) does not ship the ESM/poku test harness.
+
+const assert = require('assert');
+const getBinaryParser = require('../lib/parsers/binary_parser.js');
+const getTextParser = require('../lib/parsers/text_parser.js');
+const { privateObjectProps } = require('../lib/helpers.js');
+
+const blockedProps = Array.from(privateObjectProps);
+assert.ok(blockedProps.length > 0, 'privateObjectProps must be populated');
+assert.ok(blockedProps.includes('__proto__'), '__proto__ must be blocked');
+
+const pollutionMsg = /can't be the same as an object's private property/;
+
+[getBinaryParser, getTextParser].forEach((getParser) => {
+  blockedProps.forEach((prop) => {
+    // dangerous field name is rejected
+    assert.throws(
+      () => getParser([{ name: prop, table: '' }], {}, {}),
+      pollutionMsg,
+      `field name ${prop} must be rejected`
+    );
+
+    // nestTables as string: composed key with dangerous name is rejected
+    assert.throws(
+      () =>
+        getParser(
+          [{ name: prop.slice(1), table: '' }],
+          { nestTables: prop.charAt(0) },
+          {}
+        ),
+      pollutionMsg,
+      `nestTables-string field ${prop} must be rejected`
+    );
+
+    // nestTables as true: dangerous table name is rejected
+    assert.throws(
+      () => getParser([{ name: '', table: prop }], { nestTables: true }, {}),
+      pollutionMsg,
+      `nestTables-true table ${prop} must be rejected`
+    );
+  });
+
+  // sanity: a normal field/table must NOT throw
+  assert.doesNotThrow(
+    () => getParser([{ name: 'id', table: 'users' }], { nestTables: true }, {}),
+    'normal field/table must be accepted'
+  );
+});
+
+// eslint-disable-next-line no-console
+console.log('CVE-2024-21512 regression test passed');
