+'use strict';
+
+// Regression test for AIKIDO-2024-10020 (node-mysql2 PR #2572, CWE-94 RCE).
+//
+// The text row parser compiles a parser function by string concatenation and
+// interpolates supportBigNumbers directly into the generated source for
+// BIGINT / LONGLONG columns:
+//
+//   packet.parseLengthCodedInt(${supportBigNumbers})
+//
+// Before the fix supportBigNumbers / bigNumberStrings were taken verbatim from
+// the per-query options (or connection config), so an attacker able to control
+// those values could break out of the argument list and inject arbitrary
+// JavaScript into the compiled parser. The fix coerces both values with
+// Boolean(...), so only true / false can ever reach the generated source.
+
+const assert = require('assert');
+const Types = require('../../lib/constants/types.js');
+const parserCache = require('../../lib/parsers/parser_cache.js');
+const getTextParser = require('../../lib/parsers/text_parser.js');
+
+const payload =
+  'false); global.MYSQL2_INJECTED = true; packet.parseLengthCodedInt(true';
+const marker = 'MYSQL2_INJECTED';
+
+// A single BIGINT / LONGLONG column drives the vulnerable code path.
+const fields = [
+  {
+    name: 'total',
+    columnType: Types.LONGLONG,
+    columnLength: 20,
+    schema: 'db',
+    table: 't',
+    flags: 0,
+    characterSet: 63,
+    encoding: 'binary',
+    decimals: 0
+  }
+];
+
+// Attacker-controlled supportBigNumbers must not leak into the generated
+// parser source and must not execute during parser generation.
+parserCache.clearCache();
+delete global.MYSQL2_INJECTED;
+
+const injected = getTextParser(
+  fields,
+  { supportBigNumbers: payload, bigNumberStrings: false },
+  {}
+).toString();
+
+assert.strictEqual(
+  injected.indexOf(marker),
+  -1,
+  'injected payload leaked into generated text parser source'
+);
+assert.strictEqual(
+  global.MYSQL2_INJECTED,
+  undefined,
+  'injected payload executed during text parser generation'
+);
+
+// Positive control: legitimate boolean options still enable big-number string
+// handling, so the Boolean() coercion preserves behaviour.
+parserCache.clearCache();
+
+const ok = getTextParser(
+  fields,
+  { supportBigNumbers: true, bigNumberStrings: true },
+  {}
+).toString();
+
+assert.notStrictEqual(
+  ok.indexOf('parseLengthCodedIntString'),
+  -1,
+  'valid boolean options should still enable bigNumberStrings'
+);
+
+parserCache.clearCache();
+delete global.MYSQL2_INJECTED;
+
+console.log('AIKIDO-2024-10020: big number options sanitized');

