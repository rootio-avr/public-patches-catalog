+'use strict';
+
+// Regression test for AIKIDO-2024-10037 (CWE-94 code injection via `timezone`).
+//
+// The row parsers build JavaScript source by string-interpolating the
+// connection/query `timezone` option and then eval it (generate-function).
+// Before the fix the timezone was wrapped in raw single quotes
+// (`packet.parseDateTime('${timezone}')`), so a crafted timezone could break
+// out of the string literal and inject arbitrary code that runs when the
+// generated parser executes. The fix routes the value through
+// `helpers.srcEscape(...)`.
+//
+// This mirrors the upstream ESM tests
+// (test/esm/unit/parsers/timezone-{text,binary}-sanitization.test.mjs) but
+// without a live MySQL server: we compile the parser with a malicious
+// timezone and run the generated row parser against a stub packet, asserting
+// the injected statement never executes.
+
+const assert = require('assert');
+const Types = require('../../../lib/constants/types.js');
+const getTextParser = require('../../../lib/parsers/text_parser.js');
+const getBinaryParser = require('../../../lib/parsers/binary_parser.js');
+
+// Breaks out of `'...'` then assigns a sentinel and comments out the rest.
+const INJECTION = `'); process.env.AIKIDO_2024_10037 = "injected"; //`;
+
+const fields = [
+  {
+    name: 'ts',
+    columnType: Types.DATETIME,
+    characterSet: 33,
+    encoding: 'utf8',
+    length: 19,
+    schema: 'db',
+    table: 't',
+    flags: 0
+  }
+];
+
+const options = { timezone: INJECTION };
+const config = { timezone: 'local' };
+
+// A packet stub exposing just the methods the generated parsers call for a
+// single DATETIME column. If the injection is neutralised these simply return
+// a placeholder; if not, the injected assignment fires instead.
+function stubPacket() {
+  return {
+    readInt8: () => 0, // status byte + null bitmap -> field is not null
+    parseDate: () => null,
+    parseDateTime: () => null,
+    readDateTime: () => null,
+    readDateTimeString: () => null
+  };
+}
+
+function runTextParser() {
+  const RowClass = getTextParser(fields, options, config);
+  const parser = new RowClass(fields);
+  parser.next(stubPacket(), fields, options);
+}
+
+function runBinaryParser() {
+  const RowClass = getBinaryParser(fields, options, config);
+  const parser = new RowClass();
+  parser.next(stubPacket(), fields, options);
+}
+
+// --- Text protocol ------------------------------------------------------
+delete process.env.AIKIDO_2024_10037;
+runTextParser();
+assert.strictEqual(
+  process.env.AIKIDO_2024_10037,
+  undefined,
+  'Text parser: timezone sanitization failed - code injection possible'
+);
+
+// --- Binary protocol ----------------------------------------------------
+delete process.env.AIKIDO_2024_10037;
+runBinaryParser();
+assert.strictEqual(
+  process.env.AIKIDO_2024_10037,
+  undefined,
+  'Binary parser: timezone sanitization failed - code injection possible'
+);
+
+// --- Sanity: a normal timezone still produces a usable parser -----------
+const okParser = new (getTextParser(
+  fields,
+  { timezone: 'Z' },
+  config
+))(fields);
+assert.strictEqual(
+  typeof okParser.next,
+  'function',
+  'Parser with a benign timezone should still compile'
+);
+
+console.log('AIKIDO-2024-10037 timezone sanitization: OK');

