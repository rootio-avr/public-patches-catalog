--- /dev/null
+++ b/test/en/en_performance.test.js
@@ -0,0 +1,24 @@
+import * as chrono from '../../src/chrono';
+
+test("Test - Benchmarking against whitespace backtracking (CVE-2021-23371)", () => {
+    const str =
+        "BGR3" + " ".repeat(93) +
+        " ".repeat(88) + "186" + " ".repeat(10) +
+        " ".repeat(38) + "days" + " ".repeat(125) +
+        " ".repeat(11) + "18" + " ".repeat(48) + "hours" + " ".repeat(200) +
+        " ".repeat(35) + "37" + " ".repeat(48) + "minutes" + " ".repeat(200) +
+        " ".repeat(61) + "01" + " ".repeat(38) + "seconds";
+
+    const startTime = Date.now();
+    const results = chrono.parse(str);
+    const elapsed = Date.now() - startTime;
+
+    expect(Array.isArray(results)).toBe(true);
+    expect(elapsed).toBeLessThan(1000);
+});
+
+test("Test - Time unit patterns still match normal input", () => {
+    const results = chrono.parse("5 days ago, and 2 hours 30 minutes later", new Date(2012, 7, 10));
+    expect(results.length).toBeGreaterThan(0);
+    expect(results[0].text).toBe("5 days ago");
+});
