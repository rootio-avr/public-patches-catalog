@@ -0,0 +1,43 @@
+'use strict';
+
+const assert = require('assert');
+const { isMatch, makeRe } = require('..');
+
+describe('CVE-2026-112366: single-branch repeated extglobs with an unbounded star', () => {
+  const timed = fn => {
+    const start = Date.now();
+    const result = fn();
+    return { result, elapsed: Date.now() - start };
+  };
+
+  it('should not backtrack exponentially on +(*)', () => {
+    const { result, elapsed } = timed(() => isMatch('a'.repeat(40) + 'c', '+(*)b'));
+    assert.strictEqual(result, false);
+    assert(elapsed < 1000, `took ${elapsed}ms`);
+  });
+
+  it('should not backtrack exponentially on *(*)', () => {
+    const { result, elapsed } = timed(() => isMatch('a'.repeat(40) + 'c', '*(*)b'));
+    assert.strictEqual(result, false);
+    assert(elapsed < 1000, `took ${elapsed}ms`);
+  });
+
+  it('should not backtrack exponentially on +(*a)', () => {
+    const { result, elapsed } = timed(() => isMatch('a'.repeat(40) + 'b', '+(*a)'));
+    assert.strictEqual(result, false);
+    assert(elapsed < 1000, `took ${elapsed}ms`);
+  });
+
+  it('should literalize +(*a) like other risky repeated extglobs', () => {
+    assert.strictEqual(makeRe('+(*a)').source, '^(?:\\+\\(\\*a\\))$');
+    assert(isMatch('+(*a)', '+(*a)'));
+  });
+
+  it('should still match normal patterns', () => {
+    assert(isMatch('abc', '+(*)c'));
+    assert(!isMatch('abc', '+(*)x'));
+    assert(isMatch('abcabc', '+(abc)'));
+    assert(isMatch('foobar', '*(foo|bar)'));
+    assert(isMatch('ffo', '*(f*(o))'));
+  });
+});
