+'use strict';
+
+const assert = require('assert');
+const picomatch = require('..');
+
+const isMatch = (str, pattern, options) => picomatch(pattern, options)(str);
+
+describe('CVE-2026-112366: repeated extglob ReDoS', () => {
+  const evil = 'a'.repeat(40) + '!';
+
+  ['+(*a)', '*(*a)', '+(*)', '*(*)', '+(a*)', '+(*a|*b)', '+(**)'].forEach(pattern => {
+    it(`should not backtrack exponentially for ${pattern}`, () => {
+      const start = Date.now();
+      isMatch(evil, pattern);
+      isMatch(evil, pattern, { dot: true });
+      assert(Date.now() - start < 1000, 'matching took too long');
+    });
+  });
+
+  it('should keep matching semantics for repeated extglobs with wildcards', () => {
+    assert(isMatch('aaa', '+(*a)'));
+    assert(isMatch('bba', '+(*a)'));
+    assert(!isMatch('aab', '+(*a)'));
+    assert(!isMatch('', '+(*a)'));
+    assert(isMatch('xa', '*(*a)'));
+    assert(!isMatch('xb', '*(*a)'));
+    assert(isMatch('ab', '+(a*)'));
+    assert(isMatch('xb', '+(*a|*b)'));
+    assert(!isMatch('xc', '+(*a|*b)'));
+    assert(isMatch('foob', '+(*o)b'));
+  });
+
+  it('should keep matching other repeated extglobs', () => {
+    assert(isMatch('abab', '+(ab)'));
+    assert(isMatch('ababab', '*(ab)'));
+    assert(!isMatch('aba', '+(ab)'));
+    assert(isMatch('ab', '+(a|ab)'));
+  });
+});
