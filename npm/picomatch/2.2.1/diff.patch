--- /dev/null
+++ b/test/redos-repeated-extglob.js
@@ -0,0 +1,45 @@
+'use strict';
+
+const assert = require('assert');
+const { isMatch, makeRe } = require('..');
+
+const timed = fn => {
+  const start = Date.now();
+  const result = fn();
+  return { result, elapsed: Date.now() - start };
+};
+
+describe('repeated extglobs containing wildcards (CVE-2026-112366)', () => {
+  const evil = 'a'.repeat(40);
+
+  ['+(*)x', '+(*a)x', '*(*)x', '*(*a)x', '+(a*)x', '+(**)x'].forEach(pattern => {
+    it(`should not backtrack catastrophically for "${pattern}"`, () => {
+      const { result, elapsed } = timed(() => isMatch(`${evil}!`, pattern));
+      assert.strictEqual(result, false);
+      assert(elapsed < 1000, `took ${elapsed}ms`);
+    });
+  });
+
+  it('should not backtrack catastrophically with capture enabled', () => {
+    const { elapsed } = timed(() => isMatch(`${evil}!`, '+(*a)x', { capture: true }));
+    assert(elapsed < 1000, `took ${elapsed}ms`);
+  });
+
+  it('should still match normal input', () => {
+    assert(isMatch('abc', '+(*)c'));
+    assert(!isMatch('abc', '+(*)x'));
+    assert(isMatch('aaa', '+(*a)'));
+    assert(isMatch('xxa', '+(*a)'));
+    assert(!isMatch('aab', '+(*a)'));
+    assert(isMatch('ba', '*(*a)'));
+    assert(!isMatch('a/a', '+(*a)'));
+    assert(isMatch('ax', '*(a*|b)'));
+    assert(!isMatch('ax', 'a*(b*)'));
+  });
+
+  it('should not alter the output of repeated extglobs without wildcards', () => {
+    assert(/\)\+/.test(makeRe('+(a|b)').source));
+    assert(isMatch('abab', '+(a|b)'));
+    assert(isMatch('fofo', '*(f*(o))', { bash: true }));
+  });
+});
