+'use strict';
+
+const assert = require('assert');
+const { isMatch, makeRe } = require('..');
+
+describe('CVE-2026-112366: single-branch repeated extglobs', () => {
+  it('should literalize single-branch repeated extglobs with an unbounded `*`', () => {
+    assert.strictEqual(makeRe('+(*a)').source, '^(?:\\+\\(\\*a\\))$');
+    assert.strictEqual(makeRe('*(*a)').source, '^(?:\\*\\(\\*a\\))$');
+    assert.strictEqual(makeRe('+(a*)').source, '^(?:\\+\\(a\\*\\))$');
+  });
+
+  it('should not backtrack catastrophically on `+(*)` and `+(*a)`', () => {
+    for (const pattern of ['+(*)', '*(*)', '+(*a)', '*(*a)', '+(a*)']) {
+      const start = Date.now();
+      assert(!isMatch('a'.repeat(42) + '!', pattern + 'x'));
+      assert(Date.now() - start < 1000, `${pattern} backtracked`);
+    }
+  });
+
+  it('should still treat `+(*)` as a plain `*`', () => {
+    assert(isMatch('abc', '+(*)c'));
+    assert(!isMatch('abc', '+(*)x'));
+  });
+
+  it('should preserve ordinary repeated extglobs', () => {
+    assert(isMatch('abcabc', '+(abc)'));
+    assert(isMatch('foobar', '*(foo|bar)'));
+    assert(isMatch('my/folder (Work, Accts)', '*/*(W*, *)*'));
+  });
+});
