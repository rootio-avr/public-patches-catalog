+/**
+ * Scan a branch for top-level `*` and `?` wildcards. Inside a repeated
+ * `+(...)`/`*(...)` an unbounded `*` nests one unbounded quantifier inside
+ * another (`(?:[^/]*?a)+`), which backtracks catastrophically. Wildcards inside
+ * brackets or a nested extglob are not top level.
+ */
+
+const scanWildcards = branch => {
+  let escaped = false;
+  let bracket = 0;
+  let paren = 0;
+  let star = false;
+  let qmark = false;
+
+  for (let i = 0; i < branch.length; i++) {
+    const ch = branch[i];
+
+    if (escaped === true) {
+      escaped = false;
+      continue;
+    }
+
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+
+    if (ch === '[') {
+      bracket++;
+      continue;
+    }
+
+    if (ch === ']' && bracket > 0) {
+      bracket--;
+      continue;
+    }
+
+    if (ch === '(') {
+      paren++;
+      continue;
+    }
+
+    if (ch === ')' && paren > 0) {
+      paren--;
+      continue;
+    }
+
+    if (bracket > 0 || paren > 0) {
+      continue;
+    }
+
+    if (ch === '*' || ch === '?') {
+      // An extglob opener is not a wildcard of its own.
+      if (branch[i + 1] === '(') continue;
+      if (ch === '*') star = true;
+      else qmark = true;
+    }
+  }
+
+  return { star, qmark };
+};
