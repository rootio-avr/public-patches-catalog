+import { describe, expect, it } from 'vitest';
+import { fromJSON, toJSONAsync } from '../src';
+import type { SerovalNode } from '../src';
+
+/**
+ * Regression test for AIKIDO-2026-310861 / GHSA-p6vx-979v-rg4c (CWE-843).
+ *
+ * seroval's deserializer resolved/rejected a reconstructed Promise with
+ * whatever value the child node deserialized to, without checking that the
+ * value was not itself a thenable. A malicious `fromJSON` payload could make
+ * the resolved value of a `Promise` node be another `Promise` (a thenable),
+ * causing type confusion: the outer deferred would adopt the inner thenable's
+ * state instead of using it as a plain resolution value.
+ *
+ * The fix adds an `isThennable()` guard in `deserializePromise` and both
+ * `deserializePromiseResolve` / `deserializePromiseReject`, throwing
+ * `SerovalMalformedNodeError` when a deserialized Promise value is a thenable.
+ */
+describe('AIKIDO-2026-310861: thenable guard in Promise deserialization', () => {
+  it('rejects a Promise node whose resolved value is itself a thenable', async () => {
+    // A legitimate serialized `Promise.resolve(42)` to reuse valid feature flags.
+    const valid = await toJSONAsync(Promise.resolve(42));
+
+    // Craft the malicious payload: the outer Promise's resolved value (`f`) is
+    // itself a Promise node, which deserializes to a real (thenable) Promise.
+    const innerPromise = JSON.parse(JSON.stringify(valid.t)) as SerovalNode;
+    // Give the nested promise a distinct ref id to avoid a conflicted-ref error.
+    (innerPromise as { i: number }).i = 1;
+
+    const malicious = {
+      t: {
+        ...(JSON.parse(JSON.stringify(valid.t)) as Record<string, unknown>),
+        i: 0,
+        f: innerPromise,
+      } as unknown as SerovalNode,
+      f: valid.f,
+      m: valid.m,
+    };
+
+    expect(() => fromJSON(malicious)).toThrowError();
+  });
+
+  it('still round-trips a legitimate resolved Promise', async () => {
+    const json = await toJSONAsync(Promise.resolve(42));
+    const restored = fromJSON<Promise<number>>(json);
+    await expect(restored).resolves.toBe(42);
+  });
+});
