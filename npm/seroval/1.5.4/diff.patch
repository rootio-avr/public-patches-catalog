+import { describe, expect, it } from 'vitest';
+import type { SerovalNode } from '../src';
+import { createPlugin, fromJSON, toJSONAsync } from '../src';
+
+// Regression test for AIKIDO-2026-310861 (fixed upstream in seroval 1.6.2,
+// commit f1ffcc9 "guard thenables").
+//
+// Promise deserialization used to pass the locally deserialized value straight
+// into a native Promise resolve/reject. When that value is a *thenable*
+// (an object exposing a callable `then`), the JS engine adopts it and invokes
+// its `then` method during deserialization — arbitrary attacker-controlled code
+// running on an untrusted payload (CWE-843). The fix guards with isThennable()
+// and throws SerovalMalformedNodeError before the value ever reaches the
+// native promise machinery.
+//
+// We reproduce the exact seam described by the vulnerability analysis: a plugin
+// whose `deserialize` yields a thenable. `toJSONAsync` produces a genuine wire
+// payload (a Promise node whose fulfilled value is the plugin node), and
+// `fromJSON` replays it. A sentinel records whether the malicious `then` was
+// ever called.
+
+let thenInvoked = false;
+
+interface EvilMarker {
+  evil: true;
+}
+
+// A thenable object. If seroval hands this to a native Promise resolve, the
+// engine adopts it and calls `then`, flipping the sentinel.
+function makeThennable(): EvilMarker & PromiseLike<unknown> {
+  return {
+    evil: true,
+    then(onFulfilled?: (value: unknown) => unknown): void {
+      thenInvoked = true;
+      if (onFulfilled) {
+        onFulfilled(undefined);
+      }
+    },
+  };
+}
+
+const EvilThennablePlugin = createPlugin<EvilMarker, SerovalNode>({
+  tag: 'AIKIDO-2026-310861/EvilThennable',
+  test(value): value is EvilMarker {
+    return !!value && typeof value === 'object' && (value as EvilMarker).evil === true;
+  },
+  parse: {
+    sync(_value, ctx) {
+      return ctx.parse(0);
+    },
+    async async(_value, ctx) {
+      return await ctx.parse(0);
+    },
+    stream(_value, ctx) {
+      return ctx.parse(0);
+    },
+  },
+  serialize(node, ctx) {
+    return `({evil:true,then:function(){}})(${ctx.serialize(node)})`;
+  },
+  // On the deserialize side we return a thenable — the malicious payload.
+  deserialize() {
+    return makeThennable();
+  },
+});
+
+describe('AIKIDO-2026-310861: guard thenables in Promise deserialization', () => {
+  it('does not adopt a deserialized thenable Promise value', async () => {
+    thenInvoked = false;
+
+    // A real Promise node whose fulfilled value is produced by the plugin.
+    const json = await toJSONAsync(Promise.resolve<EvilMarker>({ evil: true }), {
+      plugins: [EvilThennablePlugin],
+    });
+
+    // Deserializing the untrusted payload must NOT invoke the thenable's
+    // `then`. The fix rejects it with a malformed-node error first.
+    expect(() =>
+      fromJSON(json, {
+        plugins: [EvilThennablePlugin],
+      }),
+    ).toThrow();
+
+    // The core security property: the attacker-controlled `then` never ran.
+    expect(thenInvoked).toBe(false);
+  });
+});
