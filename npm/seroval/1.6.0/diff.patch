+import { describe, expect, it } from 'vitest';
+import { fromJSON, toJSONAsync } from '../src';
+
+// Regression test for AIKIDO-2026-310861.
+//
+// seroval's fromJSON() used to settle a deserialized Promise node by passing
+// the raw decoded value straight to the promise resolver, without checking
+// whether that value was itself a thenable (an object exposing a callable
+// `then`). A crafted payload whose fulfilled value decodes to a thenable would
+// therefore have its `then` method invoked automatically by native Promise
+// mechanics. Fixed in 1.6.2 by rejecting any deserialized value exposing a
+// `then` function before it can settle the promise.
+describe('AIKIDO-2026-310861: thenable guard on deserialized promises', () => {
+  it('round-trips a normal (non-thenable) resolved promise', async () => {
+    const json = await toJSONAsync(Promise.resolve(42));
+    const revived = fromJSON<Promise<number>>(json);
+    await expect(revived).resolves.toBe(42);
+  });
+
+  it('rejects a payload whose fulfilled value decodes to a thenable', async () => {
+    // Start from a legitimately serialized promise so that features/marked
+    // refs are valid, then tamper the fulfilled value so it decodes into
+    // another (native) Promise — i.e. a genuine thenable.
+    const json = await toJSONAsync(Promise.resolve(1));
+    const promiseNode = json.t as unknown as { i: number };
+
+    // A second promise node reusing the original shape but with a fresh ref id
+    // so it deserializes into its own native Promise instance.
+    const thenableNode = { ...(json.t as object), i: promiseNode.i + 1 };
+    const malicious = {
+      f: json.f,
+      m: json.m,
+      t: { ...(json.t as object), f: thenableNode },
+    };
+
+    expect(() => fromJSON(malicious as never)).toThrow();
+  });
+});
