+import { describe, expect, it } from 'vitest';
+import { fromJSON } from '../src';
+
+// Regression test for AIKIDO-2026-310861 (seroval thenable type-confusion).
+//
+// A crafted JSON payload can describe a serialized Promise whose fulfilled /
+// rejected value is itself a thenable (e.g. a nested Promise node). When such a
+// payload is deserialized, the inner thenable is handed directly to the outer
+// deferred's resolve/reject, causing the runtime to adopt the attacker's
+// thenable and enabling type-confusion. The deserializer must reject any
+// deserialized Promise value that is itself a thenable.
+
+// Outer Promise (node type 12) fulfilled with a nested Promise (also type 12),
+// i.e. a thenable value where a plain value is expected.
+const MALICIOUS_PROMISE_FULFILL = {
+  t: {
+    t: 12,
+    i: 0,
+    s: 1,
+    f: { t: 12, i: 1, s: 1, f: { t: 1, s: 'inner' } },
+  },
+  f: 63,
+  m: [],
+};
+
+// Same shape but the outer Promise is rejected (s: 0) with a nested thenable.
+const MALICIOUS_PROMISE_REJECT = {
+  t: {
+    t: 12,
+    i: 0,
+    s: 0,
+    f: { t: 12, i: 1, s: 1, f: { t: 1, s: 'inner' } },
+  },
+  f: 63,
+  m: [],
+};
+
+describe('AIKIDO-2026-310861: thenable guard on Promise deserialization', () => {
+  it('rejects a deserialized fulfilled Promise whose value is a thenable', () => {
+    // biome-ignore lint/suspicious/noExplicitAny: crafted malformed payload
+    expect(() => fromJSON(MALICIOUS_PROMISE_FULFILL as any)).toThrowError();
+  });
+
+  it('rejects a deserialized rejected Promise whose value is a thenable', () => {
+    // biome-ignore lint/suspicious/noExplicitAny: crafted malformed payload
+    expect(() => fromJSON(MALICIOUS_PROMISE_REJECT as any)).toThrowError();
+  });
+
+  it('still deserializes a normal (non-thenable) Promise value', async () => {
+    const NORMAL = {
+      t: {
+        t: 12,
+        i: 0,
+        s: 1,
+        f: { t: 10, i: 1, p: { k: ['foo'], v: [{ t: 1, s: 'bar' }] }, o: 0 },
+      },
+      f: 63,
+      m: [],
+    };
+    // biome-ignore lint/suspicious/noExplicitAny: crafted payload
+    const result = fromJSON<Promise<{ foo: string }>>(NORMAL as any);
+    expect(result).toBeInstanceOf(Promise);
+    expect((await result).foo).toBe('bar');
+  });
+});
