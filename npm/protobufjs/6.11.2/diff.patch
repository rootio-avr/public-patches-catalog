+++ b/tests/cve-2026-44289.test.js
@@ -0,0 +1,55 @@
+var tape = require("tape");
+
+var protobuf = require("..");
+
+var Reader = protobuf.Reader,
+    Writer = protobuf.Writer;
+
+// Regression test for CVE-2026-44289: unbounded recursion in
+// Reader.prototype.skipType when decoding deeply nested / repeated
+// start-group (wire type 3) tags leads to stack exhaustion (DoS).
+tape.test("CVE-2026-44289 - skipType recursion depth is bounded", function(test) {
+
+    // normal, shallow skipType calls must still work unchanged
+    var reader = Reader.create(Writer.create()
+        .uint32(1)
+        .double(0.1)
+        .string("123")
+        .uint32(1 << 3 | 1).double(0.1).uint32(4)
+        .uint32(4)
+        .float(0.125)
+        .finish()
+    );
+    reader.skipType(0);
+    test.equal(reader.pos, 1, "varints");
+    reader.skipType(1);
+    test.equal(reader.pos, 9, "fixed 64 bits");
+    reader.skipType(2);
+    test.equal(reader.pos, 13, "length delimited values");
+    reader.skipType(3);
+    test.equal(reader.pos, 23, "legacy groups");
+    reader.skipType(3);
+    test.equal(reader.pos, 24, "empty legacy groups");
+    reader.skipType(5);
+    test.equal(reader.pos, 28, "fixed 32 bits");
+
+    // a message consisting only of start-group tags (0x7B = field 15,
+    // wire type 3) forces skipType to recurse once per byte. Before the
+    // fix this overflows the stack; after the fix it is capped.
+    test.throws(function() {
+        var root = protobuf.Root.fromJSON({
+            nested: {
+                MyMessage: {
+                    fields: {
+                        name: { type: "string", id: 1 }
+                    }
+                }
+            }
+        });
+        var MyMessage = root.lookupType("MyMessage");
+        var payload = Buffer.alloc(50000, 0x7B);
+        MyMessage.decode(payload);
+    }, /maximum nesting depth exceeded/, "limits recursion in reader");
+
+    test.end();
+});

