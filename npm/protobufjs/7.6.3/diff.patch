# Patch for CVE-2026-59877
# Guard against null token (EOF) while parsing an option name so unterminated
# options throw an illegal-parse error instead of TypeError/hang.
# Affected version: protobufjs@7.6.3
# Brings parse option-name EOF handling in line with upstream 7.6.5.
# src-only: npm tarball has no tests/.
#
--- a/src/parse.js
+++ b/src/parse.js
@@ -678,6 +678,9 @@
             }
 
             while (token !== "=") {
+                if (token === null) {
+                    throw illegal(token, "end of input");
+                }
                 if (token === "(") {
                     var parensValue = next();
                     skip(")");
