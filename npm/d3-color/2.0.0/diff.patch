+++ b/test/ghsa-36jr-mh4h-2g58-test.js
@@ -0,0 +1,27 @@
+var tape = require("tape"),
+    color = require("../");
+
+// GHSA-36jr-mh4h-2g58: ReDoS in d3-color rgb()/hsl() number parsing.
+// The reN/reP sub-patterns used "\d*\.?\d+" which backtracks catastrophically
+// on long malicious inputs. The fix rewrites them as "(?:\d*\.)?\d+" so the
+// decimal point can no longer overlap with the digit run.
+
+tape("color parses well-formed rgb/hsl values (no regression)", function(test) {
+  test.equal(color.rgb("rgb(12, 34, 56)") + "", "rgb(12, 34, 56)");
+  test.equal(color.rgb("rgba(12%, 34%, 56%, 0.4)") + "", "rgba(31, 87, 143, 0.4)");
+  test.equal(color.hsl("hsl(120, 50%, 50%)") + "", "rgb(64, 191, 64)");
+  test.end();
+});
+
+tape("color rejects malicious ReDoS input in bounded time", function(test) {
+  // A long run of digits with no closing ")" is the classic backtracking
+  // trigger. With the fixed regex this resolves (to null) essentially
+  // instantly; the vulnerable version would spin for seconds+.
+  var attack = "rgb(" + "1".repeat(50000) + "!";
+  var start = Date.now();
+  var result = color.color(attack);
+  var elapsed = Date.now() - start;
+  test.equal(result, null, "malformed color string is not parsed");
+  test.ok(elapsed < 1000, "parsing completes quickly (took " + elapsed + "ms)");
+  test.end();
+});
