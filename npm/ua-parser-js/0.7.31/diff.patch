+// Regression test for CVE-2022-25927 (ReDoS in ua-parser-js trim()).
+//
+// The vulnerable code used two backtracking-prone anchored whitespace
+// regexes in trim():  str.replace(/^\s\s*/, '').replace(/\s\s*$/, '')
+// A crafted user-agent string consisting of many whitespace characters
+// followed by a non-whitespace, non-matching tail forces catastrophic
+// backtracking on the trailing /\s\s*$/ alternative, hanging the parser.
+//
+// The fix removes the unsafe trailing-whitespace replace. This test feeds a
+// ReDoS payload through the same public path that invokes trim() (setUA on a
+// string longer than UA_MAX_LENGTH) and asserts it completes near-instantly,
+// plus a sanity assertion that normal parsing still works.
+
+var assert   = require('assert');
+var UAParser = require('./../src/ua-parser');
+
+describe('CVE-2022-25927 - ReDoS in trim()', function () {
+
+    it('does not hang on a whitespace-heavy user-agent (ReDoS payload)', function () {
+        // Many spaces + a trailing non-whitespace char, well over UA_MAX_LENGTH
+        // (255) so that trim() is exercised via setUA().
+        var payload = new Array(60000).join(' ') + '!';
+
+        var start = Date.now();
+        var parser = new UAParser(payload);
+        parser.getResult();
+        var elapsed = Date.now() - start;
+
+        // A vulnerable build backtracks for seconds/minutes on this input.
+        // The fixed build returns almost immediately.
+        assert.ok(elapsed < 2000,
+            'trim() took too long (' + elapsed + 'ms) - possible ReDoS');
+    });
+
+    it('still parses a normal user-agent correctly', function () {
+        var ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ' +
+                 '(KHTML, like Gecko) Chrome/108.0.0.0 Safari/537.36';
+        var result = new UAParser(ua).getBrowser();
+        assert.strictEqual(result.name, 'Chrome');
+    });
+});
