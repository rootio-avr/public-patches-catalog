+import {Buffer} from 'node:buffer';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import process from 'node:process';
+import {fileURLToPath} from 'node:url';
+import test from 'ava';
+import decompress from '../index.js';
+
+// Regression tests for CVE-2026-53486 (path traversal / link escape / setuid).
+// The upstream fix ships crafted binary fixtures that are not present in this
+// (9.0.1) target tree, so the vulnerable entries are fed through in-process
+// plugins instead. Each plugin returns file/link entries the same way a
+// decompress plugin would, so the writer path exercised is identical.
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const isWindows = process.platform === 'win32';
+const outputDir = path.join(__dirname, 'cve-2026-53486-out');
+
+const plugin = entries => () => Promise.resolve(entries.map(entry => ({
+	mtime: new Date(),
+	...entry,
+})));
+
+test.afterEach.always('clean up', async () => {
+	await fs.rm(outputDir, {force: true, recursive: true});
+	await fs.rm(path.join(__dirname, 'cve-2026-53486-secret.txt'), {force: true});
+});
+
+test.serial('refuses a hardlink whose target escapes the output directory', async t => {
+	const secret = path.join(__dirname, 'cve-2026-53486-secret.txt');
+	await fs.writeFile(secret, 'SECRET');
+
+	await t.throwsAsync(
+		decompress(Buffer.from(''), outputDir, {
+			plugins: [plugin([{type: 'link', path: 'evil', linkname: '../cve-2026-53486-secret.txt'}])],
+		}),
+		{message: /Refusing/},
+	);
+
+	t.is(await fs.readFile(secret, 'utf8'), 'SECRET');
+});
+
+(isWindows ? test.serial.skip : test.serial)('refuses a symlink whose target escapes the output directory', async t => {
+	const secret = path.join(__dirname, 'cve-2026-53486-secret.txt');
+	await fs.writeFile(secret, 'SECRET');
+
+	await t.throwsAsync(
+		decompress(Buffer.from(''), outputDir, {
+			plugins: [plugin([{type: 'symlink', path: 'evil', linkname: '../cve-2026-53486-secret.txt'}])],
+		}),
+		{message: /Refusing/},
+	);
+
+	t.is(await fs.readFile(secret, 'utf8'), 'SECRET');
+});
+
+(isWindows ? test.serial.skip : test.serial)('refuses writing a file through an in-output symlink (contiguous-file style)', async t => {
+	const secret = path.join(__dirname, 'cve-2026-53486-secret.txt');
+	await fs.writeFile(secret, 'SECRET');
+	await fs.mkdir(outputDir, {recursive: true});
+	await fs.symlink(secret, path.join(outputDir, 'pwned'));
+
+	await t.throwsAsync(
+		decompress(Buffer.from(''), outputDir, {
+			plugins: [plugin([{type: 'file', path: 'pwned', data: Buffer.from('overwritten')}])],
+		}),
+		{message: /Refusing/},
+	);
+
+	t.is(await fs.readFile(secret, 'utf8'), 'SECRET');
+});
+
+(isWindows ? test.serial.skip : test.serial)('strips setuid/setgid/sticky bits from extracted files', async t => {
+	await decompress(Buffer.from(''), outputDir, {
+		plugins: [plugin([{type: 'file', path: 'evil', mode: 0o4755, data: Buffer.from('x')}])],
+	});
+
+	const {mode} = await fs.stat(path.join(outputDir, 'evil'));
+	t.is(mode & 0o7000, 0); // eslint-disable-line no-bitwise
+	t.is(mode & 0o100, 0o100); // eslint-disable-line no-bitwise
+});
+
+test.serial('still extracts a normal file inside the output directory', async t => {
+	await decompress(Buffer.from(''), outputDir, {
+		plugins: [plugin([{type: 'file', path: 'safe.txt', mode: 0o644, data: Buffer.from('hello')}])],
+	});
+
+	t.is(await fs.readFile(path.join(outputDir, 'safe.txt'), 'utf8'), 'hello');
+});
