+++ b/test/cve-2026-45623.test.js
@@ -0,0 +1,69 @@
+'use strict'
+
+// Regression test for CVE-2026-45623.
+//
+// PostCSS resolved the `sourceMappingURL` annotation found inside untrusted
+// CSS and loaded whatever file it pointed at as a "previous" source map. An
+// attacker who controlled the CSS could therefore make PostCSS read arbitrary
+// local files (e.g. `/etc/passwd`) and, because the content was passed
+// straight into JSON.parse, could also trigger thrown parsing errors on
+// non-JSON files.
+//
+// The fix restricts annotation-driven loading to paths ending in `.map`
+// (unless `unsafeMap: true` is opted in, or the map comes from a trusted
+// `prev` callback), and swallows JSON parse errors for non-JSON maps instead
+// of throwing.
+
+let assert = require('assert')
+let { mkdtempSync, writeFileSync } = require('fs')
+let { join } = require('path')
+let { tmpdir } = require('os')
+
+let PreviousMap = require('../lib/previous-map.js')
+
+let dir = mkdtempSync(join(tmpdir(), 'cve-2026-45623-'))
+
+// A "secret" file the attacker would like PostCSS to read. It happens to hold
+// valid JSON so that, if it *were* loaded, it would populate the map text.
+let secretContents = JSON.stringify({
+  mappings: '',
+  names: [],
+  sources: ['secret'],
+  version: 3
+})
+let secretPath = join(dir, 'secret.txt')
+writeFileSync(secretPath, secretContents)
+let cssPath = join(dir, 'input.css')
+
+// 1. Annotation pointing at a non-".map" file must NOT be loaded.
+let cssNonMap = 'a{}\n/*# sourceMappingURL=secret.txt */'
+let prevNonMap = new PreviousMap(cssNonMap, { from: cssPath, map: {} })
+assert.strictEqual(
+  prevNonMap.text,
+  undefined,
+  'must not load a non-.map file referenced by an untrusted annotation'
+)
+
+// 2. Non-JSON content in a legitimate ".map" file must not throw.
+let badMapPath = join(dir, 'input.css.map')
+writeFileSync(badMapPath, 'this is not json at all')
+let cssBadMap = 'a{}\n/*# sourceMappingURL=input.css.map */'
+assert.doesNotThrow(() => {
+  // eslint-disable-next-line no-new
+  new PreviousMap(cssBadMap, { from: cssPath, map: {} })
+}, 'must not throw a JSON parsing error for non-JSON source maps')
+
+// 3. Opting into unsafeMap restores loading of arbitrary annotation targets.
+let prevUnsafe = new PreviousMap(cssNonMap, {
+  from: cssPath,
+  map: {},
+  unsafeMap: true
+})
+assert.strictEqual(
+  prevUnsafe.text,
+  secretContents,
+  'unsafeMap: true must restore the legacy (unrestricted) loading behavior'
+)
+
+// eslint-disable-next-line no-console
+console.log('CVE-2026-45623 regression test passed')

