@@ -0,0 +1,101 @@
+// Regression test for CVE-2026-45623 (postcss)
+//
+// A crafted `sourceMappingURL` annotation could make PostCSS read an
+// arbitrary local file as a "previous source map". Because the annotation
+// path was resolved and loaded with no extension check, an attacker who
+// controlled the CSS input could:
+//   * read arbitrary files on disk (CWE-22 path traversal), and
+//   * leak file bytes through the JSON parse error message when the target
+//     was not valid JSON (CWE-200 information exposure).
+//
+// The fix only loads annotation-referenced maps whose path ends in `.map`,
+// swallows JSON parse errors instead of throwing them, and adds an explicit
+// `unsafeMap: true` opt-out for callers that need the old behaviour.
+//
+// This test grounds on the fixed behaviour of lib/previous-map.js
+// (commits aaec7b78 + c64b7488). It uses the project's uvu runner idiom.
+
+const {
+  existsSync,
+  mkdirSync,
+  readdirSync,
+  rmSync,
+  writeFileSync
+} = require('fs')
+const { join } = require('path')
+const { test } = require('uvu')
+const { is, not, type } = require('uvu/assert')
+
+const { parse } = require('../lib/postcss.js')
+
+const dir = join(__dirname, 'cve-2026-45623-fixtures')
+
+const validMap = JSON.stringify({
+  file: null,
+  mappings: '',
+  names: [],
+  sources: [],
+  version: 3
+})
+
+function cleanup() {
+  if (existsSync(dir)) {
+    for (const entry of readdirSync(dir)) {
+      rmSync(join(dir, entry), { force: true, recursive: true })
+    }
+    rmSync(dir, { force: true, recursive: true })
+  }
+}
+
+test.before.each(cleanup)
+test.after.each(cleanup)
+
+test('ignores annotation pointing at a non-.map file', () => {
+  mkdirSync(dir)
+  // A "secret" file that must never be loaded via a sourceMappingURL.
+  const secret = join(dir, 'secret.txt')
+  writeFileSync(secret, 'TOP-SECRET-CONTENTS')
+
+  const from = join(dir, 'a.css')
+  const root = parse('a{}\n/*# sourceMappingURL=secret.txt */', { from })
+
+  // The traversal target must not be loaded as a previous map.
+  type(root.source?.input.map?.text, 'undefined')
+})
+
+test('does not throw on a non-JSON .map file', () => {
+  mkdirSync(dir)
+  const mapFile = join(dir, 'a.css.map')
+  writeFileSync(mapFile, 'this is not valid json')
+
+  const from = join(dir, 'a.css')
+  // Must not throw a JSON parse error (which could leak file bytes).
+  const root = parse('a{}\n/*# sourceMappingURL=a.css.map */', { from })
+  is(root.source?.input.map?.text, 'this is not valid json')
+})
+
+test('still loads a legitimate .map file', () => {
+  mkdirSync(dir)
+  const mapFile = join(dir, 'a.css.map')
+  writeFileSync(mapFile, validMap)
+
+  const from = join(dir, 'a.css')
+  const root = parse('a{}\n/*# sourceMappingURL=a.css.map */', { from })
+  is(root.source?.input.map?.text, validMap)
+})
+
+test('unsafeMap opt-out restores loading of non-.map files', () => {
+  mkdirSync(dir)
+  const target = join(dir, 'a.json')
+  writeFileSync(target, validMap)
+
+  const from = join(dir, 'a.css')
+  const root = parse('a{}\n/*# sourceMappingURL=a.json */', {
+    from,
+    unsafeMap: true
+  })
+  not.type(root.source?.input.map?.text, 'undefined')
+  is(root.source?.input.map?.text, validMap)
+})
+
+test.run()

