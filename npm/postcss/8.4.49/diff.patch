+import {
+  existsSync,
+  lstatSync,
+  mkdirSync,
+  readdirSync,
+  rmdirSync,
+  unlinkSync,
+  writeFileSync
+} from 'fs'
+import { join } from 'path'
+import { test } from 'uvu'
+import { is, not, type } from 'uvu/assert'
+
+import { parse } from '../lib/postcss.js'
+
+let dir = join(__dirname, 'cve-2026-45623-fixtures')
+
+let mapObj = {
+  file: null,
+  mappings: '',
+  names: [],
+  sources: [],
+  version: 3
+}
+let map = JSON.stringify(mapObj)
+
+function deleteDir(path: string): void {
+  if (existsSync(path)) {
+    readdirSync(path).forEach(i => {
+      let file = join(path, i)
+      if (lstatSync(file).isDirectory()) {
+        deleteDir(file)
+      } else {
+        unlinkSync(file)
+      }
+    })
+    rmdirSync(path)
+  }
+}
+
+test.after.each(() => {
+  deleteDir(dir)
+})
+
+test('does not load non-.map source map files from annotation', () => {
+  // A "secrets" file that is NOT a .map — must never be read via annotation.
+  let secretFile = join(dir, 'secret.txt')
+  let cssFile = join(dir, 'a.css')
+  mkdirSync(dir)
+  writeFileSync(secretFile, 'TOP-SECRET-CONTENTS')
+
+  let root = parse('a{}\n/*# sourceMappingURL=secret.txt */', { from: cssFile })
+
+  // No previous map should have been produced from the untrusted, non-.map path.
+  type(root.source?.input.map, 'undefined')
+})
+
+test('does not leak file bytes via JSON parse errors for non-JSON maps', () => {
+  // A .map file whose contents are not valid JSON (e.g. arbitrary file bytes).
+  // The loader must swallow the parse error rather than throwing the bytes back.
+  let file = join(dir, 'a.map')
+  mkdirSync(dir)
+  writeFileSync(file, 'root:x:0:0:root:/root:/bin/bash\n')
+
+  let root: any
+  let threw = false
+  try {
+    root = parse('a{}\n/*# sourceMappingURL=a.map */', { from: file })
+  } catch (e) {
+    threw = true
+  }
+
+  is(threw, false)
+  type(root.source?.input.map, 'undefined')
+})
+
+test('still loads legitimate .map annotations', () => {
+  let file = join(dir, 'a.map')
+  mkdirSync(dir)
+  writeFileSync(file, map)
+
+  let root = parse('a{}\n/*# sourceMappingURL=a.map */', { from: file })
+
+  not.type(root.source?.input.map, 'undefined')
+  is(root.source?.input.map.text, map)
+})
+
+test('unsafeMap opt-out still allows loading non-.map files', () => {
+  let secretFile = join(dir, 'secret.txt')
+  let file = join(dir, 'a.css')
+  mkdirSync(dir)
+  writeFileSync(secretFile, map)
+
+  let root = parse('a{}\n/*# sourceMappingURL=secret.txt */', {
+    from: file,
+    // @ts-expect-error runtime option
+    unsafeMap: true
+  })
+
+  not.type(root.source?.input.map, 'undefined')
+})
+
+test.run()

