diff --git a/test/cve-2026-45623.test.js b/test/cve-2026-45623.test.js
new file mode 100644
index 0000000..d3a803e
--- /dev/null
+++ b/test/cve-2026-45623.test.js
@@ -0,0 +1,49 @@
+let path = require('path')
+let fs = require('fs-extra')
+
+let parse = require('../lib/parse')
+
+let dir = path.join(__dirname, 'cve-2026-45623-fixtures')
+
+let mapObj = {
+  version: 3,
+  file: 'a.css',
+  sources: ['a.css'],
+  names: [],
+  mappings: ''
+}
+let map = JSON.stringify(mapObj)
+
+afterEach(() => {
+  if (fs.existsSync(dir)) fs.removeSync(dir)
+})
+
+it('does not load non-.map source map files by default', () => {
+  fs.outputFileSync(path.join(dir, 'secret.txt'), map)
+  let css = 'a{}\n/*# sourceMappingURL=secret.txt */'
+  let root = parse(css, { from: path.join(dir, 'a.css') })
+  // The annotated file is not a .map file, so it must be ignored.
+  expect(root.source.input.map.text).not.toBeDefined()
+})
+
+it('still loads .map source map files by default', () => {
+  fs.outputFileSync(path.join(dir, 'a.css.map'), map)
+  let css = 'a{}\n/*# sourceMappingURL=a.css.map */'
+  let root = parse(css, { from: path.join(dir, 'a.css') })
+  expect(root.source.input.map.text).toEqual(map)
+})
+
+it('loads non-.map files when unsafeMap is enabled', () => {
+  fs.outputFileSync(path.join(dir, 'secret.txt'), map)
+  let css = 'a{}\n/*# sourceMappingURL=secret.txt */'
+  let root = parse(css, { from: path.join(dir, 'a.css'), unsafeMap: true })
+  expect(root.source.input.map.text).toEqual(map)
+})
+
+it('does not throw on non-JSON source map content', () => {
+  fs.outputFileSync(path.join(dir, 'not-json.css.map'), 'this is not json')
+  let css = 'a{}\n/*# sourceMappingURL=not-json.css.map */'
+  expect(() => {
+    parse(css, { from: path.join(dir, 'a.css') })
+  }).not.toThrow()
+})

