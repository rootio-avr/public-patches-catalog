--- /dev/null
+++ b/test/cve-2026-45623.js
@@ -0,0 +1,66 @@
+import parse from '../lib/parse';
+
+import path from 'path';
+import test from 'ava';
+import fs   from 'fs-extra';
+
+let dir = path.join(__dirname, 'cve-2026-45623-fixtures');
+
+let validMap = JSON.stringify({
+    version:  3,
+    file:     null,
+    sources:  [],
+    names:    [],
+    mappings: ''
+});
+
+test.afterEach( () => {
+    if ( fs.existsSync(dir) ) fs.removeSync(dir);
+});
+
+// CVE-2026-45623: PostCSS followed a sourceMappingURL annotation to read an
+// arbitrary file off disk and, when its content was not JSON, threw a
+// SyntaxError whose message embedded the first bytes of the file, leaking it.
+
+test('does not load non-.map annotation targets (arbitrary file read)', t => {
+    let secret = path.join(dir, 'secret.txt');
+    fs.outputFileSync(secret, 'super-secret-not-json-content');
+
+    let css = 'a{}\n/*# sourceMappingURL=secret.txt */';
+    // Must not throw a JSON/SyntaxError leaking file content, and must not
+    // load the non-.map file as a previous map.
+    let root = t.notThrows( () => parse(css, { from: path.join(dir, 'a.css') }) );
+    t.deepEqual(typeof root.source.input.map, 'undefined');
+});
+
+test('does not throw for non-JSON .map content', t => {
+    let file = path.join(dir, 'a.css');
+    let mapFile = path.join(dir, 'a.map');
+    fs.outputFileSync(mapFile, 'this is not json');
+
+    let css = 'a{}\n/*# sourceMappingURL=a.map */';
+    // Non-JSON map: silently ignored (returns undefined), never throws.
+    let root = t.notThrows( () => parse(css, { from: file }) );
+    t.deepEqual(typeof root.source.input.map, 'undefined');
+});
+
+test('still loads a valid .map source map', t => {
+    let file = path.join(dir, 'a.css');
+    let mapFile = path.join(dir, 'a.map');
+    fs.outputFileSync(mapFile, validMap);
+
+    let css = 'a{}\n/*# sourceMappingURL=a.map */';
+    let root = parse(css, { from: file });
+    t.deepEqual(root.source.input.map.text, validMap);
+    t.deepEqual(root.source.input.map.annotation, 'a.map');
+});
+
+test('unsafeMap opt-in restores loading non-.map targets', t => {
+    let file = path.join(dir, 'a.css');
+    let mapFile = path.join(dir, 'a.txt');
+    fs.outputFileSync(mapFile, validMap);
+
+    let css = 'a{}\n/*# sourceMappingURL=a.txt */';
+    let root = parse(css, { from: file, unsafeMap: true });
+    t.deepEqual(root.source.input.map.text, validMap);
+});

