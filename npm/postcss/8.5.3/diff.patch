+++ b/test/cve-2026-73646.test.js
@@ -0,0 +1,84 @@
+'use strict'
+
+// Regression test for CVE-2026-73646 (CWE-22 path traversal via source maps).
+//
+// PostCSS resolved the `sourceMappingURL` annotation found inside untrusted
+// CSS and loaded whatever file it pointed at as a "previous" source map. Even
+// after restricting loads to `.map` files, an attacker could still escape the
+// source file's own directory with a relative path such as `../secret.map`
+// (or an absolute path), causing PostCSS to read arbitrary local `.map` files
+// outside the `from` folder.
+//
+// The fix (upstream commit 95663d3e, "Limit where source map can be loaded for
+// security reasons") confines annotation-driven map loading to the directory
+// of the `from` file: any resolved path whose location is a parent directory,
+// escapes via `..`, or is absolute is rejected — unless the caller explicitly
+// opts back into the legacy behavior with `unsafeMap: true`.
+//
+// This test grounds on the upstream test/previous-map.test.ts cases added in
+// that commit ("does not load map from outside the from folder" and "loads map
+// from outside the from folder with unsafeMap"). The published npm tarball
+// ships only `lib/`, so we exercise the shipped PreviousMap class directly
+// rather than the TypeScript-only parse() harness.
+
+let assert = require('assert')
+let { mkdtempSync, mkdirSync, writeFileSync } = require('fs')
+let { join } = require('path')
+let { tmpdir } = require('os')
+
+let PreviousMap = require('../lib/previous-map.js')
+
+let validMap = JSON.stringify({
+  mappings: '',
+  names: [],
+  sources: ['a.css'],
+  version: 3
+})
+
+let base = mkdtempSync(join(tmpdir(), 'cve-2026-73646-'))
+let subdir = join(base, 'subdir')
+mkdirSync(subdir)
+
+// A legitimate ".map" file that lives OUTSIDE the `from` folder (in the parent
+// directory of the CSS file). This is the file an attacker tries to reach.
+let outsidePath = join(base, 'outside.map')
+writeFileSync(outsidePath, validMap)
+
+// CSS whose sourceMappingURL escapes the `from` folder with `../`.
+let cssEscaping = 'a{}\n/*# sourceMappingURL=../outside.map */'
+let from = join(subdir, 'a.css')
+
+// 1. A map referenced outside the `from` folder must NOT be loaded.
+let prevEscaping = new PreviousMap(cssEscaping, { from, map: {} })
+assert.strictEqual(
+  prevEscaping.text,
+  undefined,
+  'must not load a .map file that escapes the from folder via ".."'
+)
+
+// 2. Opting into unsafeMap restores loading of the out-of-folder map.
+let prevUnsafe = new PreviousMap(cssEscaping, {
+  from,
+  map: {},
+  unsafeMap: true
+})
+assert.strictEqual(
+  prevUnsafe.text,
+  validMap,
+  'unsafeMap: true must restore the legacy (unrestricted) loading behavior'
+)
+
+// 3. A map that stays inside the `from` folder must still load normally
+//    (the confinement must not break legitimate sibling source maps).
+let insidePath = join(subdir, 'a.css.map')
+writeFileSync(insidePath, validMap)
+let cssInside = 'a{}\n/*# sourceMappingURL=a.css.map */'
+let prevInside = new PreviousMap(cssInside, { from, map: {} })
+assert.strictEqual(
+  prevInside.text,
+  validMap,
+  'a .map file inside the from folder must still load'
+)
+
+// eslint-disable-next-line no-console
+console.log('CVE-2026-73646 regression test passed')

