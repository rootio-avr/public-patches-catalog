+// Regression test for CVE-2025-68429 (GHSA-8452-54wp-rmv6)
+// Storybook `storybook build` could bundle ALL env vars loaded from .env files
+// (via lazy-universal-dotenv) into the preview/manager output, leaking secrets.
+// The fix filters so only STORYBOOK_-prefixed keys from .env / process.env are
+// exposed; everything else must be dropped from both `raw` and `stringified`.
+import { loadEnvs } from './envs';
+
+jest.mock('lazy-universal-dotenv', () => ({
+  getEnvironment: jest.fn(() => ({
+    // Simulate values sourced from a .env file on disk.
+    raw: {
+      STORYBOOK_FROM_DOTENV: 'from-dotenv',
+      SECRET_API_KEY: 'super-secret-from-dotenv',
+    },
+    stringified: {
+      STORYBOOK_FROM_DOTENV: JSON.stringify('from-dotenv'),
+      SECRET_API_KEY: JSON.stringify('super-secret-from-dotenv'),
+    },
+  })),
+}));
+
+describe('CVE-2025-68429: loadEnvs only exposes STORYBOOK_-prefixed env vars', () => {
+  const OLD_ENV = process.env;
+
+  beforeEach(() => {
+    process.env = { ...OLD_ENV };
+    process.env.STORYBOOK_FROM_PROCESS = 'from-process';
+    process.env.AWS_SECRET_ACCESS_KEY = 'leaked-if-vulnerable';
+  });
+
+  afterEach(() => {
+    process.env = OLD_ENV;
+  });
+
+  it('does not leak non-STORYBOOK_ env vars from .env files', () => {
+    const { raw, stringified } = loadEnvs();
+
+    // Secrets from the .env file must never be bundled.
+    expect(raw).not.toHaveProperty('SECRET_API_KEY');
+    expect(stringified).not.toHaveProperty('SECRET_API_KEY');
+    // Secrets from process.env must never be bundled either.
+    expect(raw).not.toHaveProperty('AWS_SECRET_ACCESS_KEY');
+    expect(stringified).not.toHaveProperty('AWS_SECRET_ACCESS_KEY');
+  });
+
+  it('still exposes STORYBOOK_-prefixed vars from both process.env and .env', () => {
+    const { raw, stringified } = loadEnvs();
+
+    expect(raw.STORYBOOK_FROM_PROCESS).toBe('from-process');
+    expect(raw.STORYBOOK_FROM_DOTENV).toBe('from-dotenv');
+    expect(stringified.STORYBOOK_FROM_DOTENV).toBe(JSON.stringify('from-dotenv'));
+  });
+
+  it('keeps the base env keys intact', () => {
+    const { raw } = loadEnvs();
+
+    expect(raw.NODE_ENV).toBeDefined();
+    expect(raw.STORYBOOK).toBe('true');
+  });
+});
