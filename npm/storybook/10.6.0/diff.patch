@@ -0,0 +1,73 @@
+// oxlint-disable no-named-as-default-member
+import events from 'storybook/internal/core-events';
+
+export type EventSender = 'manager' | 'preview' | 'server' | 'any';
+
+// The dev server drops an event arriving over a browser connection whose declared page is not
+// the event's sender; 'server' events never legitimately arrive from a browser at all.
+export const CORE_EVENT_SENDERS: Record<events, EventSender> = {
+  [events.CHANNEL_WS_DISCONNECT]: 'any',
+  [events.CHANNEL_CREATED]: 'manager',
+  [events.CONFIG_ERROR]: 'preview',
+  [events.STORY_INDEX_INVALIDATED]: 'server',
+  [events.STORY_SPECIFIED]: 'preview',
+  [events.SET_CONFIG]: 'manager',
+  [events.SET_STORIES]: 'preview',
+  [events.SET_INDEX]: 'preview',
+  [events.SET_CURRENT_STORY]: 'manager',
+  [events.CURRENT_STORY_WAS_SET]: 'preview',
+  [events.FORCE_RE_RENDER]: 'any',
+  [events.FORCE_REMOUNT]: 'any',
+  [events.PRELOAD_ENTRIES]: 'manager',
+  [events.STORY_PREPARED]: 'preview',
+  [events.DOCS_PREPARED]: 'preview',
+  [events.STORY_CHANGED]: 'preview',
+  [events.STORY_UNCHANGED]: 'preview',
+  [events.STORY_RENDERED]: 'preview',
+  [events.STORY_FINISHED]: 'preview',
+  [events.STORY_MISSING]: 'preview',
+  [events.STORY_ERRORED]: 'preview',
+  [events.STORY_THREW_EXCEPTION]: 'preview',
+  [events.STORY_RENDER_PHASE_CHANGED]: 'preview',
+  [events.STORY_HOT_UPDATED]: 'any',
+  [events.PLAY_FUNCTION_THREW_EXCEPTION]: 'preview',
+  [events.UNHANDLED_ERRORS_WHILE_PLAYING]: 'preview',
+  [events.UPDATE_STORY_ARGS]: 'any',
+  [events.STORY_ARGS_UPDATED]: 'preview',
+  [events.RESET_STORY_ARGS]: 'any',
+  [events.SET_FILTER]: 'manager',
+  [events.SET_GLOBALS]: 'preview',
+  [events.UPDATE_GLOBALS]: 'any',
+  [events.GLOBALS_UPDATED]: 'preview',
+  [events.REGISTER_SUBSCRIPTION]: 'any',
+  [events.PREVIEW_INITIALIZED]: 'preview',
+  [events.PREVIEW_KEYDOWN]: 'preview',
+  [events.PREVIEW_BUILDER_PROGRESS]: 'server',
+  [events.SELECT_STORY]: 'preview',
+  [events.STORIES_COLLAPSE_ALL]: 'manager',
+  [events.STORIES_EXPAND_ALL]: 'manager',
+  [events.DOCS_RENDERED]: 'preview',
+  [events.SHARED_STATE_CHANGED]: 'any',
+  [events.SHARED_STATE_SET]: 'any',
+  [events.NAVIGATE_URL]: 'any',
+  [events.UPDATE_QUERY_PARAMS]: 'manager',
+  [events.REQUEST_WHATS_NEW_DATA]: 'manager',
+  [events.RESULT_WHATS_NEW_DATA]: 'server',
+  [events.SET_WHATS_NEW_CACHE]: 'manager',
+  [events.TOGGLE_WHATS_NEW_NOTIFICATIONS]: 'manager',
+  [events.TELEMETRY_ERROR]: 'any',
+  [events.SAVE_STORY_REQUEST]: 'manager',
+  [events.SAVE_STORY_RESPONSE]: 'server',
+  [events.ARGTYPES_INFO_REQUEST]: 'manager',
+  [events.ARGTYPES_INFO_RESPONSE]: 'preview',
+  [events.GHOST_STORIES_REQUEST]: 'manager',
+  [events.GHOST_STORIES_RESPONSE]: 'server',
+  [events.AI_SETUP_ANALYTICS_RESPONSE]: 'server',
+  [events.AI_SETUP_ANALYTICS_REQUEST]: 'server',
+  [events.OPEN_IN_EDITOR_REQUEST]: 'manager',
+  [events.OPEN_IN_EDITOR_RESPONSE]: 'server',
+  [events.MANAGER_INERT_ATTRIBUTE_CHANGED]: 'manager',
+  [events.SHARE_ISOLATE_MODE]: 'manager',
+  [events.AI_PROMPT_NUDGE]: 'manager',
