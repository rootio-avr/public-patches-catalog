--- /dev/null
+++ b/code/core/src/core-server/utils/__tests__/getSecurityHeadersMiddleware.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import type { Middleware, SecurityConfig } from '../../../types/index.ts';
+import { getSecurityHeadersMiddleware } from '../getSecurityHeadersMiddleware.ts';
+
+const run = (security?: SecurityConfig) => {
+  const res = { appendHeader: vi.fn() };
+  const next = vi.fn();
+  getSecurityHeadersMiddleware(security)(
+    {} as Parameters<Middleware>[0],
+    res as unknown as Parameters<Middleware>[1],
+    next
+  );
+  return { res, next };
+};
+
+describe('getSecurityHeadersMiddleware', () => {
+  it.each([
+    ['security is not configured', undefined],
+    ['insecureRemoteIframeEmbed is false', { insecureRemoteIframeEmbed: false }],
+  ])('restricts framing to Storybook and loopback pages when %s', (_, security) => {
+    const { res, next } = run(security);
+    expect(res.appendHeader).toHaveBeenCalledWith(
+      'Content-Security-Policy',
+      "frame-ancestors 'self' http://localhost:* http://*.localhost:* http://127.0.0.1:*"
+    );
+    expect(next).toHaveBeenCalled();
+  });
+
+  it('sends no header when insecureRemoteIframeEmbed is true', () => {
+    const { res, next } = run({ insecureRemoteIframeEmbed: true });
+    expect(res.appendHeader).not.toHaveBeenCalled();
+    expect(next).toHaveBeenCalled();
+  });
+});
diff --git a/code/core/src/core-server/utils/getSecurityHeadersMiddleware.ts b/code/core/src/core-server/utils/getSecurityHeadersMiddleware.ts
new file mode 100644
index 0000000..c103ed2
--- /dev/null
+++ b/code/core/src/core-server/utils/getSecurityHeadersMiddleware.ts
@@ -0,0 +1,19 @@
+import { LOOPBACK_HOSTNAMES } from '../../shared/utils/local-hosts.ts';
+import type { Middleware, SecurityConfig } from '../../types/index.ts';
+
+// An `http:` source also matches `https:` pages.
+const FRAME_ANCESTORS = [
+  "'self'",
+  ...LOOPBACK_HOSTNAMES.map((hostname) => `http://${hostname}:*`),
+].join(' ');
+
+export function getSecurityHeadersMiddleware(security?: SecurityConfig): Middleware {
+  if (security?.insecureRemoteIframeEmbed) {
+    return (req, res, next) => next();
+  }
+
+  return (req, res, next) => {
+    res.appendHeader('Content-Security-Policy', `frame-ancestors ${FRAME_ANCESTORS}`);
+    next();
+  };
+}
