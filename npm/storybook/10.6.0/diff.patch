+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { mockCacheGet, mockCacheSet, mockIsCI, mockSelect, mockWarn } = vi.hoisted(() => ({
+  mockCacheGet: vi.fn(),
+  mockCacheSet: vi.fn(),
+  mockIsCI: vi.fn(),
