@@ -0,0 +1,71 @@
+// Regression test for CVE-2026-114125: the postMessage channel must ignore messages from
+// untrusted origins / windows while Storybook runs in dev mode.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const listeners = [];
+const frames = [];
+const ownOrigin = 'http://localhost:6006';
+
+globalThis.addEventListener = (type, listener) => {
+  if (type === 'message') {
+    listeners.push(listener);
+  }
+};
+globalThis.location = { origin: ownOrigin, search: '' };
+globalThis.document = {
+  location: { toString: () => `${ownOrigin}/` },
+  querySelectorAll: (selector) => (selector === 'iframe' ? frames : []),
+};
+globalThis.CONFIG_TYPE = 'DEVELOPMENT';
+
+const { PostMessageTransport } = await import('../dist/channels/index.js');
+
+const makeMessage = (origin, source) => ({
+  origin,
+  source,
+  data: JSON.stringify({ key: 'storybook-channel', event: { type: 'testEvent', args: [] } }),
+});
+
+const setup = (page) => {
+  const received = [];
+  const transport = new PostMessageTransport({ page });
+  transport.setHandler((event) => received.push(event));
+  const listener = listeners[listeners.length - 1];
+  return { received, dispatch: (message) => listener(message) };
+};
+
+test('preview ignores messages from a foreign origin in dev mode', () => {
+  const { received, dispatch } = setup('preview');
+  dispatch(makeMessage('https://evil.example', {}));
+  assert.equal(received.length, 0);
+});
+
+test('preview accepts messages from its own origin and from local hosts', () => {
+  const { received, dispatch } = setup('preview');
+  dispatch(makeMessage(ownOrigin, {}));
+  dispatch(makeMessage('http://127.0.0.1:6007', {}));
+  dispatch(makeMessage('http://app.localhost:3000', {}));
+  assert.equal(received.length, 3);
+});
+
+test('manager ignores messages from windows that are not registered preview iframes', () => {
+  const { received, dispatch } = setup('manager');
+  const attacker = {};
+  dispatch(makeMessage('https://evil.example', attacker));
+  assert.equal(received.length, 0);
+});
+
+test('manager accepts messages from its preview iframe on the expected origin only', () => {
+  const { received, dispatch } = setup('manager');
+  const previewWindow = {};
+  frames.push({
+    contentWindow: previewWindow,
+    hasAttribute: (name) => name === 'data-is-storybook',
+    getAttribute: () => 'iframe.html',
+  });
+  dispatch(makeMessage(ownOrigin, previewWindow));
+  assert.equal(received.length, 1);
+  dispatch(makeMessage('https://evil.example', previewWindow));
+  assert.equal(received.length, 1);
+});
