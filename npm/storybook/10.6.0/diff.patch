+
+describe('save-story', () => {
+  beforeEach(() => {
+    vi.mocked(writeFile).mockReset();
+  });
+
+  it('rejects a story name that is not a valid identifier', async () => {
+    const response = await saveStory({
+      args: '{}',
+      name: 'Pwned = globalThis.alert(1); export const Other',
+    });
