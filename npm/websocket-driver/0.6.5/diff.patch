+// Regression test for CVE-2026-54466
+//
+// websocket-driver <= 0.6.5 did not bound the length header of a
+// draft-75/76 framed message, nor the payload size after extension
+// processing in the hybi driver. A remote peer could send a growing
+// length header (or an extension that inflates a message) to exceed the
+// configured maxLength and exhaust memory. The fix closes / fails the
+// connection as soon as the length exceeds maxLength.
+//
+// Grounded in spec/websocket/driver/draft75_spec.js; uses node:assert so
+// it is self-contained and does not require the jstest runner wiring.
+
+'use strict';
+
+var assert  = require('assert');
+var Draft75 = require('../lib/websocket/driver/draft75');
+
+var request = {
+  headers: {
+    'connection': 'Upgrade',
+    'upgrade':    'WebSocket',
+    'origin':     'http://www.example.com'
+  }
+};
+
+function makeDriver(maxLength) {
+  var driver = new Draft75(request, 'ws://www.example.com/socket', {
+    maxLength: maxLength,
+    masking: false
+  });
+  driver.io.on('data', function() {});
+  driver.start();
+  return driver;
+}
+
+// 1. A draft-75 length header that grows past maxLength must close the
+//    connection instead of accumulating an unbounded buffer.
+(function () {
+  var driver = makeDriver(10);
+
+  // Leading byte 0x80 selects the length-framed message type; each
+  // following byte with the high bit set keeps accumulating _length.
+  // 0xFF contributes 127, immediately exceeding maxLength = 10.
+  driver.parse(new Buffer([0x80, 0xFF, 0xFF, 0xFF, 0xFF]));
+
+  assert.strictEqual(driver.getState(), 'closed',
+    'driver should close when the length header exceeds maxLength');
+})();
+
+// 2. A well-formed short frame within maxLength must still be delivered.
+(function () {
+  var driver = makeDriver(1024);
+  var received = null;
+  driver.on('message', function (event) { received = event.data; });
+
+  // 0x00 <bytes> 0xFF is a normal text frame: "Hi"
+  driver.parse(new Buffer([0x00, 0x48, 0x69, 0xFF]));
+
+  assert.strictEqual(driver.getState(), 'open',
+    'driver should stay open for a frame within maxLength');
+  assert.strictEqual(received, 'Hi',
+    'a frame within maxLength should be delivered intact');
+})();
+
+console.log('CVE-2026-54466 regression test passed');
