+++ b/test/cve-2026-111181.test.js
@@ -0,0 +1,80 @@
+'use strict'
+
+var assert = require('assert')
+var http = require('http')
+
+var bodyParser = require('..')
+
+// zlib.gzipSync('{"a":1}'), precomputed
+var GZIPPED_JSON = Buffer.from('1f8b0800000000000003ab564a54b232ac0500afac1b5607000000', 'hex')
+
+// Since Node.js 11 zlib ends the readable side of a decompression stream as
+// soon as the compressed frame is complete
+var zlibEndsAtStreamEnd = parseInt(process.versions.node.split('.')[0], 10) >= 11
+
+function createServer (opts) {
+  var _bodyParser = bodyParser.json(opts)
+
+  return http.createServer(function (req, res) {
+    _bodyParser(req, res, function (err) {
+      res.statusCode = err ? (err.status || 500) : 200
+      res.end(err ? err.message : JSON.stringify(req.body))
+    })
+  })
+}
+
+function post (server, contentType, callback) {
+  server.listen(0, '127.0.0.1', function () {
+    var body = Buffer.concat([
+      GZIPPED_JSON,
+      Buffer.from([0x00]),
+      Buffer.alloc(100 * 1024, 0x58)
+    ])
+    var req = http.request({
+      host: '127.0.0.1',
+      port: server.address().port,
+      method: 'POST',
+      path: '/',
+      headers: {
+        'Content-Type': contentType,
+        'Content-Encoding': 'gzip',
+        'Content-Length': body.length
+      }
+    }, function (res) {
+      var data = ''
+      res.on('data', function (c) { data += c })
+      res.on('end', function () {
+        // allow any late decompression error to surface as an uncaught exception
+        setTimeout(function () {
+          server.close()
+          callback(null, res, data)
+        }, 200)
+      })
+    })
+    req.on('error', callback)
+    req.end(body)
+  })
+}
+
+describe('CVE-2026-111181: trailing bytes after a compressed body', function () {
+  it('should not crash on trailing bytes after a gzip body', function (done) {
+    post(createServer(), 'application/json', function (err, res, data) {
+      if (err) return done(err)
+      if (zlibEndsAtStreamEnd) {
+        assert.strictEqual(res.statusCode, 200)
+        assert.strictEqual(data, '{"a":1}')
+      } else {
+        assert.ok(res.statusCode === 200 || res.statusCode === 400, 'unexpected status ' + res.statusCode)
+      }
+      done()
+    })
+  })
+
+  it('should not crash when an unsupported charset rejects a compressed body', function (done) {
+    post(createServer({ verify: function () {} }), 'application/json; charset=utf-999', function (err, res) {
+      if (err) return done(err)
+      assert.strictEqual(res.statusCode, 415)
+      done()
+    })
+  })
+})
