+'use strict'
+
+var assert = require('assert')
+var bodyParser = require('..')
+
+describe('CVE-2026-12590: limit option validation', function () {
+  var parsers = {
+    json: bodyParser.json,
+    raw: bodyParser.raw,
+    text: bodyParser.text,
+    urlencoded: function (opts) {
+      return bodyParser.urlencoded(Object.assign({ extended: false }, opts))
+    }
+  }
+
+  Object.keys(parsers).forEach(function (name) {
+    var factory = parsers[name]
+
+    describe('bodyParser.' + name + '()', function () {
+      it('should throw for an invalid string limit', function () {
+        assert.throws(function () {
+          factory({ limit: 'invalid' })
+        }, /option limit "invalid" is invalid/)
+        assert.throws(function () {
+          factory({ limit: '' })
+        }, /option limit "" is invalid/)
+      })
+
+      it('should throw for a NaN limit', function () {
+        assert.throws(function () {
+          factory({ limit: NaN })
+        }, /option limit "NaN" is invalid/)
+      })
+
+      it('should throw for a boolean limit', function () {
+        assert.throws(function () {
+          factory({ limit: true })
+        }, /option limit "true" is invalid/)
+        assert.throws(function () {
+          factory({ limit: false })
+        }, /option limit "false" is invalid/)
+      })
+
+      it('should throw for an object limit', function () {
+        assert.throws(function () {
+          factory({ limit: { foo: 'bar' } })
+        }, /option limit "\[object Object\]" is invalid/)
+      })
+
+      it('should accept a valid string limit', function () {
+        assert.doesNotThrow(function () {
+          factory({ limit: '1kb' })
+        })
+      })
+
+      it('should default when limit is null or undefined', function () {
+        assert.doesNotThrow(function () {
+          factory({ limit: null })
+        })
+        assert.doesNotThrow(function () {
+          factory({})
+        })
+      })
+    })
+  })
+})

