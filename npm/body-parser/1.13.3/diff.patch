+/*!
+ * Regression test for CVE-2024-45590
+ *
+ * body-parser urlencoded (extended) parsed with an unbounded depth
+ * (depth: Infinity), allowing a crafted request body to exhaust memory /
+ * stack via deeply nested keys. The fix bounds the parse depth (default 32,
+ * configurable via the `depth` option) and validates the option.
+ *
+ * This target ships the vendored qs@4.0.0, which has no strictDepth/RangeError
+ * signalling, so the security-relevant, executable behaviour to assert here is
+ * that the depth is now bounded/configurable and that invalid depth values are
+ * rejected at construction time. Grounded on the upstream "with depth option /
+ * when custom value set" test added in b2695c4.
+ */
+
+'use strict'
+
+var assert = require('assert')
+var bodyParser = require('..')
+
+describe('bodyParser.urlencoded() CVE-2024-45590 depth option', function () {
+  it('should reject non-positive / non-numeric depth values', function () {
+    assert.throws(function () {
+      bodyParser.urlencoded({ extended: true, depth: -1 })
+    }, /option depth must be a zero or a positive number/)
+
+    assert.throws(function () {
+      bodyParser.urlencoded({ extended: true, depth: NaN })
+    }, /option depth must be a zero or a positive number/)
+
+    assert.throws(function () {
+      bodyParser.urlencoded({ extended: true, depth: 'beep' })
+    }, /option depth must be a zero or a positive number/)
+  })
+
+  it('should accept a valid custom depth without throwing', function () {
+    assert.doesNotThrow(function () {
+      bodyParser.urlencoded({ extended: true, depth: 10 })
+    })
+  })
+
+  it('should construct with the default (bounded) depth', function () {
+    assert.doesNotThrow(function () {
+      bodyParser.urlencoded({ extended: true })
+    })
+  })
+})

