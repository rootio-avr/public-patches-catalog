@@ -0,0 +1,74 @@
+/**
+ * Regression test for CVE-2026-12590
+ *
+ * body-parser accepted invalid `limit` option values (non-numeric strings,
+ * NaN, booleans, objects) without validation. bytes.parse() returns null for
+ * these, which silently disabled the body size limit. The fix validates the
+ * parsed limit and throws a TypeError for invalid values.
+ *
+ * The upstream fix commit's assertions live in test/{json,raw,text,urlencoded}.js,
+ * which are not shipped in the published npm package, so this standalone
+ * regression test carries the same behavior forward.
+ */
+
+var assert = require('assert')
+var bodyParser = require('..')
+
+var parsers = ['json', 'raw', 'text', 'urlencoded']
+
+describe('CVE-2026-12590 limit option validation', function () {
+  parsers.forEach(function (name) {
+    describe(name + '()', function () {
+      it('should throw for an invalid string limit', function () {
+        assert.throws(function () {
+          bodyParser[name]({ limit: 'invalid' })
+        }, /option limit "invalid" is invalid/)
+      })
+
+      it('should throw for an empty string limit', function () {
+        assert.throws(function () {
+          bodyParser[name]({ limit: '' })
+        }, /option limit "" is invalid/)
+      })
+
+      it('should throw for a NaN limit', function () {
+        assert.throws(function () {
+          bodyParser[name]({ limit: NaN })
+        }, /option limit "NaN" is invalid/)
+      })
+
+      it('should throw for a boolean limit', function () {
+        assert.throws(function () {
+          bodyParser[name]({ limit: true })
+        }, /option limit "true" is invalid/)
+        assert.throws(function () {
+          bodyParser[name]({ limit: false })
+        }, /option limit "false" is invalid/)
+      })
+
+      it('should throw for an object limit', function () {
+        assert.throws(function () {
+          bodyParser[name]({ limit: { foo: 'bar' } })
+        }, /option limit "\[object Object\]" is invalid/)
+      })
+
+      it('should accept a valid string limit', function () {
+        assert.doesNotThrow(function () {
+          bodyParser[name]({ limit: '1kb' })
+        })
+      })
+
+      it('should accept a valid numeric limit', function () {
+        assert.doesNotThrow(function () {
+          bodyParser[name]({ limit: 1024 })
+        })
+      })
+
+      it('should accept an undefined limit (default applies)', function () {
+        assert.doesNotThrow(function () {
+          bodyParser[name]({})
+        })
+      })
+    })
+  })
+})
