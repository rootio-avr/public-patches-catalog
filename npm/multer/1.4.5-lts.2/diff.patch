+      // The overflow must be handled (surfaced as an error), not crash the process.
+      assert.ok(err, 'expected the request to be rejected with an error')
+      assert.strictEqual(err.code, 'INVALID_FIELD_NAME')
+      done()
+    })
+  })
+})

