Description: Fix CVE-2026-77078 (GHSA-wc9g-mqfw-jrwm) - reject invalid field
 names instead of crashing on append-field errors. A crafted multipart request
 with field names that overflow the maximum JS array length causes append-field
 to throw an uncaught RangeError, crashing the process (denial of service).
 Wrap appendField in a try/catch and surface the failure as an INVALID_FIELD_NAME
 MulterError so the request is rejected gracefully.
Origin: upstream, https://github.com/expressjs/multer/commit/87a584e8c8d4da873292635fa1d8c4d78d985b76
Ref: https://github.com/expressjs/multer/security/advisories/GHSA-wc9g-mqfw-jrwm
--- a/lib/make-middleware.js
+++ b/lib/make-middleware.js
@@ -146,7 +146,11 @@ function makeMiddleware (setup) {
         }
       }

-      appendField(req.body, fieldname, value)
+      try {
+        appendField(req.body, fieldname, value)
+      } catch {
+        return abortWithCode('INVALID_FIELD_NAME', fieldname)
+      }
     })

     // handle files
--- a/lib/multer-error.js
+++ b/lib/multer-error.js
@@ -10,7 +10,8 @@ var errorMessages = {
   LIMIT_UNEXPECTED_FILE: 'Unexpected field',
   MISSING_FIELD_NAME: 'Field name missing',
   LIMIT_FIELD_NESTING: 'Field name nesting too deep',
-  LIMIT_FIELD_ARRAY_INDEX: 'Field name array index too large'
+  LIMIT_FIELD_ARRAY_INDEX: 'Field name array index too large',
+  INVALID_FIELD_NAME: 'Invalid field name'
 }

 function MulterError (code, field) {
