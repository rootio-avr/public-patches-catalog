--- a/test/cve-2026-2359.test.js
+++ b/test/cve-2026-2359.test.js
@@ -0,0 +1,63 @@
+/* global describe, it */
+
+// Regression test for CVE-2026-2359 (CWE-772): multer must not hang and leak
+// resources when a client disconnects in the middle of a multipart upload.
+// Grounded on the upstream test added in fix commit cccf0fe0.
+
+var assert = require('assert')
+var http = require('http')
+var net = require('net')
+var multer = require('../')
+
+describe('CVE-2026-2359 disconnect handling', function () {
+  it('should not hang when client aborts multipart upload', function (done) {
+    this.timeout(5000)
+
+    var upload = multer({ storage: multer.memoryStorage() }).any()
+    var finished = false
+
+    var server = http.createServer(function (req, res) {
+      var hung = false
+
+      var timer = setTimeout(function () {
+        hung = true
+        server.close()
+        done(new Error('Middleware hung when client aborted request'))
+      }, 1000)
+
+      upload(req, res, function (/* err */) {
+        if (hung || finished) return
+        finished = true
+        clearTimeout(timer)
+        server.close()
+        assert.ok(true, 'middleware invoked its callback after client abort')
+        done()
+      })
+    })
+
+    server.listen(0, function () {
+      var port = server.address().port
+      var boundary = 'PoC' + Date.now()
+      var sock = new net.Socket()
+
+      sock.connect(port, '127.0.0.1', function () {
+        sock.write(
+          'POST / HTTP/1.1\r\n' +
+          'Host: localhost\r\n' +
+          'Content-Type: multipart/form-data; boundary=' + boundary + '\r\n' +
+          'Content-Length: 999999\r\n\r\n' +
+          '--' + boundary + '\r\n' +
+          'Content-Disposition: form-data; name="file"; filename="test.bin"\r\n' +
+          'Content-Type: application/octet-stream\r\n\r\n' +
+          'AAAAAAAAAAAAAAAA'
+        )
+
+        setTimeout(function () {
+          sock.destroy()
+        }, 50)
+      })
+
+      sock.on('error', function () {})
+    })
+  })
+})

