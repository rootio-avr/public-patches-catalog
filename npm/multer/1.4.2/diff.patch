+/* eslint-env mocha */
+
+// Regression test for CVE-2025-47935 (multer DoS: unhandled request-stream
+// errors / never-draining stream caused the upload middleware to hang and
+// leak memory instead of completing).
+//
+// The upstream fix (PR #1120) is bundled with the busboy 1.x API migration
+// released as v2.0.0, whose new-API assertions (MISSING_FIELD_NAME,
+// 'Unexpected end of form', 'Malformed part header') do not apply to the
+// busboy 0.x that multer 1.4.2 depends on. This is a minimal replacement that
+// exercises the isolated security behavior that WAS back-ported:
+//   1. an error emitted on the request stream is now handled (req.on('error'))
+//      and surfaced to the middleware callback, and
+//   2. the callback fires promptly (done() calls next(err) directly instead of
+//      waiting on on-finished, which never fires for an aborted request).
+
+var assert = require('assert')
+var stream = require('stream')
+
+var multer = require('../')
+
+describe('CVE-2025-47935', function () {
+  it('surfaces request-stream errors to the callback without hanging', function (done) {
+    var upload = multer().single('file')
+
+    var req = new stream.PassThrough()
+    req.headers = {
+      'content-type': 'multipart/form-data; boundary=AaB03x',
+      'content-length': '1000'
+    }
+
+    var finished = false
+    var timer = setTimeout(function () {
+      if (!finished) done(new Error('middleware never invoked its callback (hang)'))
+    }, 1000)
+
+    upload(req, null, function (err) {
+      finished = true
+      clearTimeout(timer)
+      assert.ok(err, 'expected the request-stream error to be surfaced')
+      assert.strictEqual(err.message, 'boom')
+      done()
+    })
+
+    // Simulate an aborted / errored request stream.
+    req.emit('error', new Error('boom'))
+  })
+})

