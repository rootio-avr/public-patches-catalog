+/* eslint-env mocha */
+
+var assert = require('assert')
+var stream = require('stream')
+var multer = require('../')
+
+// @see https://github.com/expressjs/multer/security/advisories/GHSA-q7qp-rjg7-q26m
+
+describe('late busboy error after teardown', function () {
+  it('does not crash the process when busboy emits an error after the request finished', function (done) {
+    var req = new stream.PassThrough()
+    var busboy
+    var boundary = 'TeardownBoundary'
+    var body = [
+      '--' + boundary,
+      'Content-Disposition: form-data; name="field"',
+      '',
+      'value',
+      '--' + boundary + '--',
+      ''
+    ].join('\r\n')
+
+    // done() unpipes the request from busboy; use that to capture the instance.
+    var originalUnpipe = req.unpipe
+    req.unpipe = function (dest) {
+      if (!busboy && dest) busboy = dest
+      return originalUnpipe.apply(this, arguments)
+    }
+
+    req.headers = {
+      'content-type': 'multipart/form-data; boundary=' + boundary,
+      'content-length': Buffer.byteLength(body)
+    }
+
+    multer().none()(req, null, function (err) {
+      assert.ifError(err)
+      assert.ok(busboy, 'expected busboy to be torn down')
+
+      // done() queued listener removal before next(), so this runs after teardown.
+      setImmediate(function () {
+        assert.doesNotThrow(function () {
+          busboy.emit('error', new Error('late busboy error'))
+        })
+        done()
+      })
+    })
+
+    req.end(body)
+  })
+})
