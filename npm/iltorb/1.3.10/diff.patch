+++ b/test/cveAikido202627763.js
@@ -0,0 +1,45 @@
+'use strict';
+
+const crypto = require('crypto');
+const expect = require('chai').expect;
+const brotli = require('../');
+
+describe('AIKIDO-2026-27763: uncompressed metablock handling', function() {
+  it('round-trips incompressible data fed in small chunks', function(done) {
+    const input = crypto.randomBytes(256 * 1024);
+    const chunks = [];
+    const stream = brotli.decompressStream();
+    stream.on('error', done);
+    stream.on('data', function(c) { chunks.push(c); });
+    stream.on('end', function() {
+      expect(Buffer.concat(chunks).equals(input)).to.equal(true);
+      done();
+    });
+    brotli.compress(input, {quality: 0}, function(err, compressed) {
+      if (err) {
+        return done(err);
+      }
+      for (let i = 0; i < compressed.length; i += 7) {
+        stream.write(compressed.slice(i, i + 7));
+      }
+      stream.end();
+    });
+  });
+
+  it('rejects truncated or corrupted input without crashing', function(done) {
+    const input = crypto.randomBytes(64 * 1024);
+    brotli.compress(input, {quality: 0}, function(err, compressed) {
+      if (err) {
+        return done(err);
+      }
+      const corrupted = Buffer.from(compressed.slice(0, compressed.length >> 1));
+      corrupted.fill(0xff, 0, 16);
+      brotli.decompress(corrupted, function(err2) {
+        if (err2) {
+          expect(err2).to.be.an('error');
+        }
+        done();
+      });
+    });
+  });
+});
