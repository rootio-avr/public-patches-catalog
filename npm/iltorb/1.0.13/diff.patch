+++ b/test/cveAikido202627763.js
@@ -0,0 +1,45 @@
+'use strict';
+
+var brotli = require('../');
+var expect = require('expect.js');
+var fs = require('fs');
+var path = require('path');
+
+// Regression test for AIKIDO-2026-27763 hardening of the vendored brotli
+// decoder: the uncompressed-metablock copy path
+// (CopyUncompressedBlockToOutput) must size its copies with size_t instead of
+// a truncated int. Data10k.bin.compressed is a single uncompressed metablock;
+// feeding it in small chunks drives the partial-copy path repeatedly.
+
+var fixtures = path.join(__dirname, 'fixtures');
+
+function decompressInChunks(input, chunkSize, done) {
+  var decompress = brotli.decompressStream();
+  var chunks = [];
+  decompress.on('data', function(chunk) { chunks.push(chunk); });
+  decompress.on('error', done);
+  decompress.on('end', function() { done(null, Buffer.concat(chunks)); });
+  for (var i = 0; i < input.length; i += chunkSize) {
+    decompress.write(input.slice(i, i + chunkSize));
+  }
+  decompress.end();
+}
+
+describe('AIKIDO-2026-27763 uncompressed metablock copy', function() {
+  var compressed = fs.readFileSync(path.join(fixtures, 'data10k.bin.compressed'));
+  var expected = fs.readFileSync(path.join(fixtures, 'data10k.bin'));
+
+  [1, 7, 1000, 4096].forEach(function(chunkSize) {
+    it('should decompress an uncompressed metablock fed in ' + chunkSize + '-byte chunks', function(done) {
+      decompressInChunks(compressed, chunkSize, function(err, output) {
+        if (err) return done(err);
+        expect(output).to.eql(expected);
+        done();
+      });
+    });
+  });
+
+  it('should still decompress the same data in a single sync call', function() {
+    expect(brotli.decompressSync(compressed)).to.eql(expected);
+  });
+});
