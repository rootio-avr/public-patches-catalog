diff --git a/built/DataHandler.js b/built/DataHandler.js
index 7f95466..af87c65 100644
--- a/built/DataHandler.js
+++ b/built/DataHandler.js
@@ -23,7 +23,15 @@ class DataHandler {
         });
         // prependListener ensures the parser receives and processes data before socket timeout checks are performed
         redis.stream.prependListener("data", (data) => {
-            parser.execute(data);
+            try {
+                parser.execute(data);
+            }
+            catch (err) {
+                // A malformed or pathological reply (e.g. a deeply nested array that
+                // overflows the parser's call stack) must not escape as an uncaught
+                // exception from the socket listener.
+                this.returnFatalError(err instanceof Error ? err : new Error(String(err)));
+            }
         });
         // prependListener() doesn't enable flowing mode automatically - we need to resume the stream manually
         redis.stream.resume();
