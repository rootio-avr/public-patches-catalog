@@ -0,0 +1,78 @@
+'use strict';
+
+/**
+ * Regression test for CVE-2024-53900: NoSQL injection via a `$where` operator
+ * supplied through a populate() `match` filter.
+ *
+ * Grounded in upstream fix c9e86bff7eef477da75a29af62a06d41a835a156
+ * ("fix: disallow using $where in match"). In the mongoose 6.9.1 build tree the
+ * remediation is already present (the throwOn$where() guard installed at the
+ * getModelsMapForPopulate.js call sites), so this test asserts that every
+ * vulnerable populate() code path named in the advisory now rejects a `$where`
+ * match with the expected MongooseError.
+ */
+
+const start = require('./common');
+
+const assert = require('assert');
+
+const mongoose = start.mongoose;
+const Schema = mongoose.Schema;
+
+describe('CVE-2024-53900: $where in populate() match', function() {
+  let db;
+
+  before(function() {
+    db = start();
+  });
+
+  after(async function() {
+    await db.close();
+  });
+
+  it('rejects $where in populate match across every populate path', async function() {
+    const ParentSchema = new Schema({
+      name: String,
+      child: {
+        type: Schema.Types.ObjectId,
+        ref: 'CVE53900_Child'
+      },
+      children: [{
+        type: Schema.Types.ObjectId,
+        ref: 'CVE53900_Child'
+      }]
+    });
+
+    const ChildSchema = new Schema({
+      name: String
+    });
+    ChildSchema.virtual('parent', {
+      ref: 'CVE53900_Parent',
+      localField: '_id',
+      foreignField: 'parent'
+    });
+
+    const Parent = db.model('CVE53900_Parent', ParentSchema);
+    const Child = db.model('CVE53900_Child', ChildSchema);
+
+    const child = await Child.create({ name: 'Luke' });
+    const parent = await Parent.create({ name: 'Anakin', child: child._id });
+
+    const evilMatch = { $where: 'console.log("oops!");' };
+    const expected = /Cannot use \$where filter with populate\(\) match/;
+
+    // Model.findOne(...).populate(...)
+    await assert.rejects(
+      () => Parent.findOne().populate({ path: 'child', match: evilMatch }),
+      expected
+    );
+
+    // Model.find(...).populate(...)
+    await assert.rejects(
+      () => Parent.find().populate({ path: 'child', match: evilMatch }),
+      expected
+    );
+
+    // document.populate(...)
+    await assert.rejects(
+      () => parent.populate({ path: 'child', match: evilMatch }),
+      expected
+    );
+
+    // Virtual populate path (_virtualPopulate call site)
+    await assert.rejects(
+      () => Child.find().populate({ path: 'parent', match: evilMatch }),
+      expected
+    );
+
+    // match supplied as a function returning the malicious filter
+    await assert.rejects(
+      () => Parent.find().populate({ path: 'child', match: () => evilMatch }),
+      expected
+    );
+  });
+});

