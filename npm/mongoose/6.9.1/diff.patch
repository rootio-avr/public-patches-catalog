+'use strict';
+
+/**
+ * Regression test for CVE-2025-23061: disallow nested $where in populate() match.
+ * Grounded in upstream fix 64a9f9706f2428c49e0cfb8e223065acc645f7bc.
+ */
+
+const start = require('./common');
+
+const assert = require('assert');
+
+const mongoose = start.mongoose;
+const Schema = mongoose.Schema;
+
+describe('CVE-2025-23061: nested $where in populate match', function() {
+  let db;
+
+  before(function() {
+    db = start();
+  });
+
+  after(async function() {
+    await db.close();
+  });
+
+  it('rejects top-level $where in populate match', async function() {
+    const childSchema = new Schema({ name: String });
+    const parentSchema = new Schema({
+      name: String,
+      child: { type: Schema.Types.ObjectId, ref: 'CVE23061_Child' }
+    });
+    const Child = db.model('CVE23061_Child', childSchema);
+    const Parent = db.model('CVE23061_Parent', parentSchema);
+
+    const child = await Child.create({ name: 'Luke' });
+    await Parent.create({ name: 'Anakin', child: child._id });
+
+    await assert.rejects(
+      () => Parent.findOne().populate({ path: 'child', match: () => ({ $where: 'doesNotExist("foo");' }) }),
+      /Cannot use \$where filter with populate\(\) match/
+    );
+  });
+
+  it('rejects nested $where inside $or in populate match', async function() {
+    const Child = db.model('CVE23061_Child');
+    const Parent = db.model('CVE23061_Parent');
+
+    await assert.rejects(
+      () => Parent.find().populate({ path: 'child', match: () => ({ $or: [{ $where: 'doesNotExist("foo");' }] }) }),
+      /Cannot use \$where filter with populate\(\) match/
+    );
+    await assert.rejects(
+      () => Parent.find().populate({ path: 'child', match: () => ({ $and: [{ $where: 'doesNotExist("foo");' }] }) }),
+      /Cannot use \$where filter with populate\(\) match/
+    );
+  });
+
+  it('allows $where only present as an inherited (non-own) property', async function() {
+    const Parent = db.model('CVE23061_Parent');
+
+    class MyClass {}
+    MyClass.prototype.$where = 'doesNotExist("foo");';
+    // OK because sift only looks through own properties
+    await Parent.find().populate({ path: 'child', match: () => new MyClass() });
+  });
+});

