+'use strict';
+
+// Regression test for CVE-2026-42334: sanitizeFilter NoSQL injection bypass.
+// Grounded in upstream fix b804e34e4d4cc670d7247fbd558c47412b4e5e01
+// (test/helpers/query.sanitizeFilter.test.js), reduced to the security-
+// relevant assertions since the upstream test file is not shipped in the
+// published npm tarball.
+
+const assert = require('assert');
+const { trusted } = require('../lib/helpers/query/trusted');
+const sanitizeFilter = require('../lib/helpers/query/sanitizeFilter');
+
+describe('CVE-2026-42334 sanitizeFilter', function() {
+  it('recurses into $nor to neutralize injected selectors', function() {
+    const obj = { $nor: [{ username: 'val' }, { pwd: { $ne: 'my secret' } }] };
+    sanitizeFilter(obj);
+    assert.deepEqual(obj, { $nor: [{ username: 'val' }, { pwd: { $eq: { $ne: 'my secret' } } }] });
+  });
+
+  it('throws on untrusted $jsonSchema', function() {
+    const obj = {
+      $jsonSchema: {
+        bsonType: 'object',
+        required: ['pwd'],
+        properties: { pwd: { bsonType: 'string' } }
+      }
+    };
+    assert.throws(
+      () => sanitizeFilter(obj),
+      /\$jsonSchema is not allowed with sanitizeFilter/
+    );
+  });
+
+  it('throws on untrusted $where', function() {
+    const obj = { $where: 'true' };
+    assert.throws(
+      () => sanitizeFilter(obj),
+      /\$where is not allowed with sanitizeFilter/
+    );
+  });
+
+  it('throws on untrusted $expr', function() {
+    const obj = { $expr: { $function: { body: function() { return true; } } } };
+    assert.throws(
+      () => sanitizeFilter(obj),
+      /\$expr is not allowed with sanitizeFilter/
+    );
+  });
+
+  it('throws on untrusted $text', function() {
+    const obj = { $text: { $search: 'test' } };
+    assert.throws(
+      () => sanitizeFilter(obj),
+      /\$text is not allowed with sanitizeFilter/
+    );
+  });
+
+  it('allows a trusted $where function (trusted() now accepts functions)', function() {
+    const whereFunc = function() { return true; };
+    const obj = { $where: trusted(whereFunc) };
+    sanitizeFilter(obj);
+    assert.deepEqual(obj, { $where: whereFunc });
+  });
+});
