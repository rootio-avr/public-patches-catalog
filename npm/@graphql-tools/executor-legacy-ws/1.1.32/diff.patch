@@ -0,0 +1,137 @@
+'use strict';
+// Regression test for CVE-2026-118665: per-request auth and subscription
+// results must be isolated between executions of the legacy WS executor.
+const assert = require('node:assert');
+const { test } = require('node:test');
+const { parse } = require('graphql');
+const { buildWSLegacyExecutor, LEGACY_WS } = require('../cjs/index.js');
+
+const document = parse('subscription PrivateEvents { privateEvents { id } }');
+
+let sockets = [];
+
+class FakeSocket {
+  constructor(url, protocol, options) {
+    this.url = url;
+    this.protocol = protocol;
+    this.options = options;
+    this.readyState = FakeSocket.CONNECTING;
+    this.sent = [];
+    this.terminated = false;
+    sockets.push(this);
+  }
+  send(data, callback) {
+    this.sent.push(data);
+    if (callback) callback();
+  }
+  terminate() {
+    this.terminated = true;
+    this.readyState = FakeSocket.CLOSED;
+    if (this.onclose) this.onclose();
+  }
+  open() {
+    this.readyState = FakeSocket.OPEN;
+    if (this.onopen) this.onopen();
+  }
+  receive(message) {
+    const raw = JSON.stringify(message);
+    this.onmessage({ data: { toString: () => raw } });
+  }
+}
+FakeSocket.CONNECTING = 0;
+FakeSocket.OPEN = 1;
+FakeSocket.CLOSING = 2;
+FakeSocket.CLOSED = 3;
+
+function initPayload(socket) {
+  const init = socket.sent.map(r => JSON.parse(r)).find(m => m.type === LEGACY_WS.CONNECTION_INIT);
+  return init && init.payload;
+}
+
+function startMessage(socket) {
+  return socket.sent.map(r => JSON.parse(r)).find(m => m.type === LEGACY_WS.START);
+}
+
+test('does not replay a previous request connectionParams on the next connection', () => {
+  sockets = [];
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket, {
+    connectionParams: { client: 'gateway' },
+  });
+  const first = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer victim-token' } },
+  });
+  first.next();
+  sockets[0].open();
+  assert.deepStrictEqual(initPayload(sockets[0]), {
+    client: 'gateway',
+    Authorization: 'Bearer victim-token',
+  });
+
+  const second = exec({ document });
+  second.next();
+  sockets[1].open();
+  assert.notStrictEqual(sockets[0], sockets[1]);
+  assert.deepStrictEqual(initPayload(sockets[1]), { client: 'gateway' });
+});
+
+test('delivers DATA only to the operation whose id matches', async () => {
+  sockets = [];
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket);
+  const victim = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer victim-token' } },
+  });
+  const attacker = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer attacker-token' } },
+  });
+  const victimPending = victim.next();
+  const attackerPending = attacker.next();
+  assert.strictEqual(sockets.length, 2);
+  sockets[0].open();
+  sockets[1].open();
+  sockets[0].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  sockets[1].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  const victimId = startMessage(sockets[0]).id;
+  const attackerId = startMessage(sockets[1]).id;
+  assert.notStrictEqual(victimId, attackerId);
+
+  // frames with a foreign id must be dropped
+  sockets[1].receive({
+    type: LEGACY_WS.DATA,
+    id: victimId,
+    payload: { data: { privateEvents: { secret: 'VICTIM-PRIVATE-DATA' } } },
+  });
+  sockets[0].receive({
+    type: LEGACY_WS.DATA,
+    id: victimId,
+    payload: { data: { privateEvents: { secret: 'VICTIM-PRIVATE-DATA' } } },
+  });
+  sockets[1].receive({
+    type: LEGACY_WS.DATA,
+    id: attackerId,
+    payload: { data: { privateEvents: { secret: 'ATTACKER-OWN' } } },
+  });
+
+  assert.deepStrictEqual(await victimPending, {
+    done: false,
+    value: { data: { privateEvents: { secret: 'VICTIM-PRIVATE-DATA' } } },
+  });
+  assert.deepStrictEqual(await attackerPending, {
+    done: false,
+    value: { data: { privateEvents: { secret: 'ATTACKER-OWN' } } },
+  });
+  await victim.return();
+  await attacker.return();
+});
+
+test('verifies TLS certificates unless the caller opts out', () => {
+  sockets = [];
+  buildWSLegacyExecutor('wss://example.com/graphql', FakeSocket)({ document }).next();
+  assert.strictEqual(sockets[0].options.rejectUnauthorized, true);
+  buildWSLegacyExecutor('wss://example.com/graphql', FakeSocket, { rejectUnauthorized: false })({
+    document,
+  }).next();
+  assert.strictEqual(sockets[1].options.rejectUnauthorized, false);
+});
