@@ -0,0 +1,113 @@
+'use strict';
+// Regression test for CVE-2026-118665 (GHSA-434m-5hcj-pxf3 / GHSA-mp66-8ww2-pcwm):
+// a shared buildWSLegacyExecutor() must isolate per-request connectionParams and
+// only deliver frames that match its own operation id.
+const test = require('node:test');
+const assert = require('node:assert');
+const { parse } = require('graphql');
+const { buildWSLegacyExecutor } = require('../cjs/index.js');
+
+function createFakeWebSocket() {
+  const sockets = [];
+  class FakeWebSocket {
+    constructor(url, protocol, opts) {
+      this.url = url;
+      this.opts = opts;
+      this.readyState = 1; // OPEN
+      this.sent = [];
+      this.terminated = false;
+      sockets.push(this);
+    }
+    send(data, cb) {
+      this.sent.push(JSON.parse(data));
+      if (typeof cb === 'function') cb();
+    }
+    terminate() {
+      this.terminated = true;
+      this.readyState = 3;
+    }
+    receive(msg) {
+      this.onmessage({ data: Buffer.from(JSON.stringify(msg)) });
+    }
+  }
+  return { FakeWebSocket, sockets };
+}
+
+const document = parse('subscription { tick }');
+
+async function start(executor, extensions) {
+  const iterator = (await executor({ document, extensions }))[Symbol.asyncIterator]();
+  const pending = iterator.next();
+  return { iterator, pending };
+}
+
+test('connection_init does not replay a previous caller connectionParams', async () => {
+  const { FakeWebSocket, sockets } = createFakeWebSocket();
+  const executor = buildWSLegacyExecutor('ws://localhost/graphql', FakeWebSocket, {
+    connectionParams: { base: 'yes' },
+  });
+
+  const first = await start(executor, { connectionParams: { Authorization: 'Bearer alice' } });
+  const second = await start(executor, undefined);
+
+  assert.strictEqual(sockets.length, 2, 'each execution must open its own socket');
+  sockets[0].onopen();
+  sockets[1].onopen();
+
+  assert.deepStrictEqual(sockets[0].sent[0].payload, {
+    base: 'yes',
+    Authorization: 'Bearer alice',
+  });
+  assert.deepStrictEqual(sockets[1].sent[0].payload, { base: 'yes' });
+  assert.ok(!('Authorization' in sockets[1].sent[0].payload));
+
+  executor[Symbol.dispose]();
+  await first.pending;
+  await second.pending;
+});
+
+test('data frames for other operation ids are ignored', async () => {
+  const { FakeWebSocket, sockets } = createFakeWebSocket();
+  const executor = buildWSLegacyExecutor('ws://localhost/graphql', FakeWebSocket);
+
+  const { pending } = await start(executor, undefined);
+  const socket = sockets[0];
+  socket.onopen();
+  socket.receive({ type: 'connection_ack' });
+  const startMsg = socket.sent.find(m => m.type === 'start');
+  assert.ok(startMsg, 'start message must be sent after connection_ack');
+  assert.notStrictEqual(startMsg.id, String(Date.now()));
+
+  let settled = false;
+  pending.then(() => {
+    settled = true;
+  });
+  socket.receive({ type: 'data', id: 'someone-elses-operation', payload: { data: { tick: 'leak' } } });
+  await new Promise(resolve => setImmediate(resolve));
+  assert.strictEqual(settled, false, 'foreign data frame must not be delivered');
+
+  socket.receive({ type: 'data', id: startMsg.id, payload: { data: { tick: 'ok' } } });
+  const result = await pending;
+  assert.deepStrictEqual(result.value, { data: { tick: 'ok' } });
+
+  executor[Symbol.dispose]();
+});
+
+test('foreign complete frames do not terminate the subscription', async () => {
+  const { FakeWebSocket, sockets } = createFakeWebSocket();
+  const executor = buildWSLegacyExecutor('ws://localhost/graphql', FakeWebSocket);
+
+  const { pending } = await start(executor, undefined);
+  const socket = sockets[0];
+  socket.onopen();
+  socket.receive({ type: 'connection_ack' });
+  const startMsg = socket.sent.find(m => m.type === 'start');
+
+  socket.receive({ type: 'complete', id: 'someone-elses-operation' });
+  assert.strictEqual(socket.terminated, false);
+
+  socket.receive({ type: 'complete', id: startMsg.id });
+  assert.strictEqual(socket.terminated, true);
+  const result = await pending;
+  assert.strictEqual(result.done, true);
+});
