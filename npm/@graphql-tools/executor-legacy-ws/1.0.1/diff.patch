@@ -0,0 +1,79 @@
+// Regression test for CVE-2026-118665: every subscription must use its own
+// socket and its own operation id, and must ignore messages for other ids.
+const assert = require('node:assert');
+const { parse } = require('graphql');
+const { buildWSLegacyExecutor } = require('../cjs/index.js');
+
+const sockets = [];
+class StubWebSocket {
+  constructor() {
+    this.readyState = 1; // OPEN
+    this.sent = [];
+    this.terminated = false;
+    sockets.push(this);
+  }
+  send(data, cb) {
+    this.sent.push(JSON.parse(data));
+    if (cb) cb();
+  }
+  terminate() {
+    this.terminated = true;
+  }
+  receive(msg) {
+    this.onmessage({ data: Buffer.from(JSON.stringify(msg)) });
+  }
+}
+
+async function main() {
+  const executor = buildWSLegacyExecutor('ws://localhost:0/graphql', StubWebSocket, {
+    connectionParams: { token: 'shared' },
+  });
+  const document = parse('subscription { a }');
+
+  const first = executor({ document });
+  const second = executor({ document });
+
+  // one socket per subscription
+  assert.strictEqual(sockets.length, 2, 'each subscription must open its own socket');
+  const [s1, s2] = sockets;
+
+  s1.onopen();
+  s2.onopen();
+  s1.receive({ type: 'connection_ack' });
+  s2.receive({ type: 'connection_ack' });
+
+  const id1 = s1.sent.find(m => m.type === 'start').id;
+  const id2 = s2.sent.find(m => m.type === 'start').id;
+  assert.notStrictEqual(id1, id2, 'operation ids must be unique');
+
+  // a message carrying another operation id must be ignored
+  s1.receive({ type: 'data', id: id2, payload: { data: { a: 'for-second' } } });
+  s1.receive({ type: 'data', id: id1, payload: { data: { a: 'for-first' } } });
+  const r1 = await first.next();
+  assert.deepStrictEqual(r1.value, { data: { a: 'for-first' } });
+
+  // a foreign complete must not close the subscription
+  s2.receive({ type: 'complete', id: id1 });
+  assert.strictEqual(s2.terminated, false, 'foreign complete must not tear down the socket');
+  s2.receive({ type: 'data', id: id2, payload: { data: { a: 'for-second' } } });
+  const r2 = await second.next();
+  assert.deepStrictEqual(r2.value, { data: { a: 'for-second' } });
+
+  // completing one subscription must not affect the other
+  s1.receive({ type: 'complete', id: id1 });
+  assert.strictEqual(s1.terminated, true);
+  assert.strictEqual(s2.terminated, false);
+
+  // closed guard: late messages after teardown are dropped
+  s1.receive({ type: 'data', id: id1, payload: { data: { a: 'late' } } });
+  assert.strictEqual((await first.next()).done, true);
+
+  await second.return();
+  assert.strictEqual(s2.terminated, true);
+  console.log('cve-2026-118665 regression test passed');
+}
+
+main().catch(err => {
+  console.error(err);
+  process.exit(1);
+});
