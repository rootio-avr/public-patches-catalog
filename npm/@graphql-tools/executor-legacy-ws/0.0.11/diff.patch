+import assert from 'node:assert/strict';
+import { parse } from 'graphql';
+import { buildWSLegacyExecutor, LEGACY_WS } from '../esm/index.js';
+
+const document = parse(/* GraphQL */ `
+  subscription PrivateEvents {
+    privateEvents {
+      id
+    }
+  }
+`);
+
+let sockets = [];
+
+class FakeSocket {
+  constructor(url, protocol, options) {
+    this.url = url;
+    this.protocol = protocol;
+    this.options = options;
+    this.readyState = 0;
+    this.sent = [];
+    this.terminated = false;
+    this.onopen = null;
+    this.onmessage = null;
+    this.onerror = null;
+    this.onclose = null;
+    sockets.push(this);
+  }
+  send(data, callback) {
+    this.sent.push(data);
+    if (callback) callback();
+  }
+  terminate() {
+    this.terminated = true;
+    this.readyState = 3;
+    if (this.onclose) this.onclose();
+  }
+  open() {
+    this.readyState = 1;
+    this.onopen();
+  }
+  receive(message) {
+    const raw = JSON.stringify(message);
+    this.onmessage({ data: { toString: () => raw } });
+  }
+}
+
+const sent = socket => socket.sent.map(raw => JSON.parse(raw));
+const initPayload = socket => sent(socket).find(m => m.type === LEGACY_WS.CONNECTION_INIT)?.payload;
+const startMessage = socket => sent(socket).find(m => m.type === LEGACY_WS.START);
+
+async function run(name, fn) {
+  sockets = [];
+  await fn();
+  console.log(`ok - ${name}`);
+}
+
+await run('does not replay a previous request connectionParams on the next connection', async () => {
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket);
+  const victim = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer victim-token', tenant: 'alice' } },
+  });
+  const victimNext = victim.next();
+  sockets[0].open();
+  assert.deepEqual(initPayload(sockets[0]), {
+    Authorization: 'Bearer victim-token',
+    tenant: 'alice',
+  });
+  sockets[0].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  const victimId = startMessage(sockets[0]).id;
+  sockets[0].receive({ type: LEGACY_WS.DATA, id: victimId, payload: { data: { privateEvents: { id: '1' } } } });
+  await victimNext;
+  sockets[0].receive({ type: LEGACY_WS.COMPLETE, id: victimId });
+  await victim.return();
+
+  const anonymous = exec({ document });
+  const anonymousNext = anonymous.next();
+  sockets[1].open();
+  assert.notEqual(sockets[0], sockets[1]);
+  assert.deepEqual(initPayload(sockets[1]), {});
+  sockets[1].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  sockets[1].receive({ type: LEGACY_WS.COMPLETE, id: startMessage(sockets[1]).id });
+  await anonymousNext;
+});
+
+await run('evaluates connectionParams functions per execution', async () => {
+  let n = 0;
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket, {
+    connectionParams: () => ({ n: ++n }),
+  });
+  exec({ document });
+  exec({ document });
+  sockets[0].open();
+  sockets[1].open();
+  assert.deepEqual(initPayload(sockets[0]), { n: 1 });
+  assert.deepEqual(initPayload(sockets[1]), { n: 2 });
+});
+
+await run('delivers DATA only to the operation whose id matches', async () => {
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket);
+  const victim = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer victim-token' } },
+  });
+  const attacker = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer attacker-token' } },
+  });
+  const victimPending = victim.next();
+  const attackerPending = attacker.next();
+  assert.equal(sockets.length, 2);
+  sockets[0].open();
+  sockets[1].open();
+  sockets[0].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  sockets[1].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  const victimId = startMessage(sockets[0]).id;
+  const attackerId = startMessage(sockets[1]).id;
+  assert.notEqual(victimId, attackerId);
+
+  // frames carrying another operation's id must be ignored
+  sockets[1].receive({
+    type: LEGACY_WS.DATA,
+    id: victimId,
+    payload: { data: { privateEvents: { secret: 'VICTIM-PRIVATE-DATA' } } },
+  });
+  sockets[0].receive({
+    type: LEGACY_WS.DATA,
+    id: victimId,
+    payload: { data: { privateEvents: { secret: 'VICTIM-PRIVATE-DATA' } } },
+  });
+  sockets[1].receive({
+    type: LEGACY_WS.DATA,
+    id: attackerId,
+    payload: { data: { privateEvents: { secret: 'ATTACKER-OWN' } } },
+  });
+
+  assert.deepEqual(await victimPending, {
+    done: false,
+    value: { data: { privateEvents: { secret: 'VICTIM-PRIVATE-DATA' } } },
+  });
+  assert.deepEqual(await attackerPending, {
+    done: false,
+    value: { data: { privateEvents: { secret: 'ATTACKER-OWN' } } },
+  });
+  await victim.return();
+  await attacker.return();
+});
+
+await run('drops ERROR and COMPLETE frames that belong to another operation', async () => {
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket);
+  const iterator = exec({ document });
+  const pending = iterator.next();
+  sockets[0].open();
+  sockets[0].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  const id = startMessage(sockets[0]).id;
