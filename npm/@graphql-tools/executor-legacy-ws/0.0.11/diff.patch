+  sockets[0].receive({ type: LEGACY_WS.COMPLETE, id: 'other' });
+  assert.equal(sockets[0].terminated, false);
+  sockets[0].receive({ type: LEGACY_WS.DATA, id, payload: { data: { privateEvents: { id: '1' } } } });
