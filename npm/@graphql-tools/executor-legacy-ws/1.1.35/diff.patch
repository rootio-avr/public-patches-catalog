+'use strict';
+// Regression test for CVE-2026-118665: per-request auth (connectionParams) and
+// subscription results must be isolated between executions.
+const assert = require('node:assert');
+const { test } = require('node:test');
+const { parse } = require('graphql');
+const { buildWSLegacyExecutor, LEGACY_WS } = require('../cjs/index.js');
+
+const document = parse('subscription PrivateEvents { privateEvents { id } }');
+
+let sockets = [];
+
+class FakeSocket {
+  constructor(url, protocol, options) {
+    this.url = url;
+    this.protocol = protocol;
+    this.options = options;
+    this.readyState = FakeSocket.CONNECTING;
+    this.sent = [];
+    this.terminated = false;
+    sockets.push(this);
+  }
+  send(data, callback) {
+    this.sent.push(data);
+    if (callback) callback();
+  }
+  terminate() {
+    this.terminated = true;
+    this.readyState = FakeSocket.CLOSED;
+    if (this.onclose) this.onclose();
+  }
+  open() {
+    this.readyState = FakeSocket.OPEN;
+    this.onopen();
+  }
+  receive(message) {
+    const raw = JSON.stringify(message);
+    this.onmessage({ data: { toString: () => raw } });
+  }
+  message(type) {
+    return this.sent.map(raw => JSON.parse(raw)).find(m => m.type === type);
+  }
+}
+FakeSocket.CONNECTING = 0;
+FakeSocket.OPEN = 1;
+FakeSocket.CLOSING = 2;
+FakeSocket.CLOSED = 3;
+
+test('does not replay a previous request connectionParams on the next connection', async () => {
+  sockets = [];
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket);
+
+  const victim = exec({
+    document,
+    extensions: { connectionParams: { Authorization: 'Bearer victim-token' } },
+  });
+  const victimNext = victim.next();
+  sockets[0].open();
+  assert.deepStrictEqual(sockets[0].message(LEGACY_WS.CONNECTION_INIT).payload, {
+    Authorization: 'Bearer victim-token',
+  });
+  sockets[0].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  const victimId = sockets[0].message(LEGACY_WS.START).id;
+  sockets[0].receive({ type: LEGACY_WS.DATA, id: victimId, payload: { data: { privateEvents: { id: '1' } } } });
+  await victimNext;
+  sockets[0].receive({ type: LEGACY_WS.COMPLETE, id: victimId });
+  await victim.return();
+
+  const anonymous = exec({ document });
+  const anonymousNext = anonymous.next();
+  assert.notStrictEqual(sockets[1], sockets[0]);
+  sockets[1].open();
+  assert.deepStrictEqual(sockets[1].message(LEGACY_WS.CONNECTION_INIT).payload, {});
+  sockets[1].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  sockets[1].receive({ type: LEGACY_WS.COMPLETE, id: sockets[1].message(LEGACY_WS.START).id });
+  await anonymousNext;
+});
+
+test('ignores data and completion for other operation ids', async () => {
+  sockets = [];
+  const exec = buildWSLegacyExecutor('ws://localhost/graphql', FakeSocket);
+
+  const sub = exec({ document });
+  const first = sub.next();
+  sockets[0].open();
+  sockets[0].receive({ type: LEGACY_WS.CONNECTION_ACK });
+  const id = sockets[0].message(LEGACY_WS.START).id;
+
+  sockets[0].receive({ type: LEGACY_WS.DATA, id: 'someone-else', payload: { data: { privateEvents: { id: 'leak' } } } });
+  sockets[0].receive({ type: LEGACY_WS.COMPLETE, id: 'someone-else' });
+  assert.strictEqual(sockets[0].terminated, false);
+
+  sockets[0].receive({ type: LEGACY_WS.DATA, id, payload: { data: { privateEvents: { id: 'mine' } } } });
+  const result = await first;
+  assert.deepStrictEqual(result.value, { data: { privateEvents: { id: 'mine' } } });
+  await sub.return();
+});
