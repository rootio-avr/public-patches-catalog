+import assert from 'node:assert';
+import { mergeDeep } from '../esm/mergeDeep.js';
+
+// JSON parsing makes __proto__ a real own enumerable key, unlike an object literal
+const protoPayload = JSON.parse('{"nested":{"__proto__":{"polluted":"yes"}}}');
+const merged = mergeDeep([{ nested: { a: 1 } }, protoPayload]);
+assert.strictEqual(merged.nested.a, 1);
+assert.strictEqual(merged.nested.polluted, undefined);
+assert.strictEqual(Object.getPrototypeOf(merged.nested), Object.prototype);
+
+const ctorPayload = JSON.parse('{"constructor":{"prototype":{"polluted":"yes"}}}');
+const merged2 = mergeDeep([{ a: 1 }, ctorPayload]);
+assert.strictEqual(merged2.a, 1);
+assert.strictEqual({}.polluted, undefined);
+assert.ok(!Object.prototype.hasOwnProperty.call(Object.prototype, 'polluted'));
+console.log('CVE-2026-104852 regression test passed');

