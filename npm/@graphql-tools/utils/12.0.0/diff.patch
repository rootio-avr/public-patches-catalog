+import assert from 'node:assert';
+import { mergeIncrementalResult } from '../esm/mergeIncrementalResult.js';
+import { isDangerousObjectKey, isSafeObjectKey } from '../esm/jsutils.js';
+
+assert.strictEqual(isDangerousObjectKey('__proto__'), true);
+assert.strictEqual(isSafeObjectKey(['__proto__']), false);
+assert.strictEqual(isSafeObjectKey('ok'), true);
+
+function run(incrementalResult) {
+  delete Object.prototype.polluted;
+  const executionResult = { data: {} };
+  mergeIncrementalResult({ incrementalResult, executionResult });
+  assert.strictEqual({}.polluted, undefined);
+  assert.deepStrictEqual(executionResult, { data: {} });
+  assert.strictEqual(executionResult.data.NaN, undefined);
+  delete Object.prototype.polluted;
+}
+
+run(JSON.parse('{"path":[["__proto__"],"polluted"],"data":"yes"}'));
+run({ path: ['__proto__', 'polluted'], data: 'yes' });
+run({ path: [{ toString: () => '__proto__' }, 'polluted'], data: 'yes' });
+run(JSON.parse('{"path":[["__proto__"],"polluted",0],"items":["yes"]}'));
+run(JSON.parse('{"path":["viewer",["__proto__"],"polluted"],"data":"yes"}'));
+run(JSON.parse('{"path":[["__proto__"]],"items":["yes","no"]}'));
+
+// benign behavior is preserved
+const res = { data: { list: [] } };
+mergeIncrementalResult({ incrementalResult: { path: ['list', 0], items: ['a', 'b'] }, executionResult: res });
+assert.deepStrictEqual(res, { data: { list: ['a', 'b'] } });
+console.log('CVE-2026-114604 regression test passed');
