+// Regression test for CVE-2026-114604: prototype pollution via mergeIncrementalResult paths.
+import assert from 'node:assert';
+import { createRequire } from 'node:module';
+import { mergeIncrementalResult as esmMerge } from '../esm/mergeIncrementalResult.js';
+
+const cjsMerge = createRequire(import.meta.url)('../cjs/mergeIncrementalResult.js').mergeIncrementalResult;
+
+for (const mergeIncrementalResult of [esmMerge, cjsMerge]) {
+
+  function run(incrementalResult) {
+    delete Object.prototype.polluted;
+    const executionResult = { data: {} };
+    mergeIncrementalResult({ incrementalResult, executionResult });
+    assert.strictEqual({}.polluted, undefined, 'Object.prototype must not be polluted');
+    assert.deepStrictEqual(executionResult, { data: {} });
+    delete Object.prototype.polluted;
+  }
+
+  // array segment coercing to "__proto__"
+  run(JSON.parse('{"path":[["__proto__"],"polluted"],"data":"yes"}'));
+  // plain-string __proto__ segments
+  run({ path: ['__proto__', 'polluted'], data: 'yes' });
+  run({ path: ['__proto__'], data: { polluted: 'yes' } });
+  // object segment coercing via toString
+  run({ path: [{ toString: () => '__proto__' }, 'polluted'], data: 'yes' });
+  // items batch with unsafe segment
+  run(JSON.parse('{"path":[["__proto__"],"polluted",0],"items":["yes"]}'));
+  // no partial parent creation before a later unsafe segment
+  run(JSON.parse('{"path":["viewer",["__proto__"],"polluted"],"data":"yes"}'));
+  // no NaN writes after rejected items path
+  {
+    const executionResult = { data: {} };
+    mergeIncrementalResult({
+      incrementalResult: JSON.parse('{"path":[["__proto__"]],"items":["yes","no"]}'),
+      executionResult,
+    });
+    assert.deepStrictEqual(executionResult, { data: {} });
+    assert.strictEqual(executionResult.data.NaN, undefined);
+  }
+  // normal behavior is preserved
+  {
+    const executionResult = { data: { user: { name: 'a' } } };
+    mergeIncrementalResult({
+      incrementalResult: { path: ['user'], data: { age: 3 } },
+      executionResult,
+    });
+    assert.deepStrictEqual(executionResult, { data: { user: { name: 'a', age: 3 } } });
+    const r2 = { data: {} };
+    mergeIncrementalResult({ incrementalResult: { path: ['list', 0], items: ['x', 'y'] }, executionResult: r2 });
+    assert.deepStrictEqual(r2, { data: { list: ['x', 'y'] } });
+  }
+}
+console.log('ok');
