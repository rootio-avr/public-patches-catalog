+/*
+ * Copyright The OpenTelemetry Authors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Regression test for CVE-2026-59892.
+ *
+ * Malformed percent-encoding in the uber-trace-id header or in an uberctx-*
+ * baggage header must NOT cause decodeURIComponent() to throw an uncaught
+ * URIError out of JaegerPropagator.extract() (a denial-of-service).
+ *
+ * Grounded in the upstream fix commit b1c196d49d54caae59741cca0a9d57d101d7ea88
+ * (open-telemetry/opentelemetry-js) which added the equivalent cases to
+ * test/JaegerPropagator.test.ts. This dist-only npm package ships only
+ * compiled JS (build/{esm,esnext,src}), so the upstream .test.ts cannot be
+ * carried over verbatim; this exercises the same fixed behavior against the
+ * compiled build that the patch modifies.
+ */
+
+'use strict';
+
+const assert = require('assert');
+const { ROOT_CONTEXT, defaultTextMapGetter, propagation, trace } = require('@opentelemetry/api');
+const {
+  JaegerPropagator,
+  UBER_TRACE_ID_HEADER,
+  UBER_BAGGAGE_HEADER_PREFIX,
+} = require('../build/src/index.js');
+
+describe('CVE-2026-59892: malformed percent-encoding does not throw', () => {
+  let propagator;
+  let carrier;
+
+  beforeEach(() => {
+    propagator = new JaegerPropagator();
+    carrier = {};
+  });
+
+  it('returns no span context and does not throw on malformed UBER_TRACE_ID_HEADER', () => {
+    for (const malformed of ['%ZZ', 'abc%G:123:0:01', '%']) {
+      carrier[UBER_TRACE_ID_HEADER] = malformed;
+      let result = ROOT_CONTEXT;
+      assert.doesNotThrow(() => {
+        result = propagator.extract(ROOT_CONTEXT, carrier, defaultTextMapGetter);
+      });
+      assert.deepStrictEqual(trace.getSpanContext(result), undefined);
+    }
+  });
+
+  it('ignores a malformed UBER_TRACE_ID_HEADER but still extracts valid baggage', () => {
+    carrier[UBER_TRACE_ID_HEADER] = '%ZZ';
+    carrier[`${UBER_BAGGAGE_HEADER_PREFIX}-test`] = 'value';
+    let result = ROOT_CONTEXT;
+    assert.doesNotThrow(() => {
+      result = propagator.extract(ROOT_CONTEXT, carrier, defaultTextMapGetter);
+    });
+    assert.deepStrictEqual(trace.getSpanContext(result), undefined);
+    const entry = propagation.getBaggage(result)?.getEntry('test');
+    assert.ok(typeof entry !== 'undefined');
+    assert.strictEqual(entry.value, 'value');
+  });
+
+  it('skips a baggage entry with malformed percent-encoding and keeps valid entries', () => {
+    carrier[`${UBER_BAGGAGE_HEADER_PREFIX}-bad`] = '%ZZ';
+    carrier[`${UBER_BAGGAGE_HEADER_PREFIX}-test`] = 'value';
+    let result = ROOT_CONTEXT;
+    assert.doesNotThrow(() => {
+      result = propagator.extract(ROOT_CONTEXT, carrier, defaultTextMapGetter);
+    });
+    const extractedBaggage = propagation.getBaggage(result);
+    assert.strictEqual(typeof extractedBaggage?.getEntry('bad'), 'undefined');
+    const validEntry = extractedBaggage?.getEntry('test');
+    assert.ok(typeof validEntry !== 'undefined');
+    assert.strictEqual(validEntry.value, 'value');
+  });
+});
