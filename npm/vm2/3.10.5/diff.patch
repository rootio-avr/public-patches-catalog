+'use strict';
+
+// GHSA-c48m-32m9-vx93 -- NodeVM `require.external` allowlist bypass with a custom
+// `require.resolve`: the bare-specifier pre-check was an unanchored substring
+// match and accepted `..` traversal in the permitted subpath.
+
+const assert = require('assert');
+const { NodeVM } = require('../lib/main.js');
+
+function consultedFor(external, specifiers) {
+	const consulted = [];
+	const vm = new NodeVM({
+		require: {
+			external,
+			resolve: moduleName => { consulted.push(moduleName); return undefined; },
+			context: 'host',
+		},
+	});
+	for (const spec of specifiers) {
+		try { vm.run(`require(${JSON.stringify(spec)})`); } catch (e) { /* module-not-found is fine */ }
+	}
+	return consulted;
+}
+
+describe('GHSA-c48m-32m9-vx93 (external allowlist matcher)', function () {
+	it('does not consult the resolver for substring-colliding package names', function () {
+		const consulted = consultedFor(['left-pad'], ['evil-left-pad', 'left-pad-evil', 'xleft-padx', 'left-padx']);
+		assert.deepStrictEqual(consulted, []);
+	});
+
+	it('still consults the resolver for the allowlisted name and its subpaths', function () {
+		const specs = ['left-pad', 'left-pad/index.js', 'left-pad/lib/x'];
+		assert.deepStrictEqual(consultedFor(['left-pad'], specs), specs);
+	});
+
+	it('does not consult the resolver for `..` traversal subpaths', function () {
+		const consulted = consultedFor(['left-pad'], [
+			'left-pad/../evil-package',
+			'left-pad/sub/../../evil-package',
+			'left-pad/a/b/../../../evil-package',
+			'left-pad\\..\\evil-package',
+			'left-pad/..',
+		]);
+		assert.deepStrictEqual(consulted, []);
+	});
+
+	it('wildcard allowlist entries match by segment, not substring', function () {
+		const consulted = consultedFor(['@scope/*'], ['@scope/pkg', '@scope/pkg/sub', 'x@scope/pkg', '@scope-evil/pkg']);
+		assert.deepStrictEqual(consulted, ['@scope/pkg', '@scope/pkg/sub']);
+	});
+});

