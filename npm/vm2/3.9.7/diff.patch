+
+	// ---- Symbol.for source-side denial -------------------------------------
+
+	it('Symbol.for("nodejs.util.promisify.custom") returns a sandbox-local symbol', () => {
+		const isSandboxLocal = safeRun(`return Symbol.keyFor(Symbol.for('nodejs.util.promisify.custom')) === undefined;`);
+		assert.strictEqual(isSandboxLocal, true, 'Symbol.for returned a real cross-realm symbol');
+	});
+
