+/* eslint-env mocha */
+/* eslint-disable max-len */
+
+/**
+ * CVE-2026-47135 / GHSA-m5q2-4fm3-vfqp
+ *
+ * Sandbox escape via unblocked cross-realm `Symbol.for` keys plus missing
+ * dangerous-symbol guards on the bridge's write traps.
+ *
+ * Two-layer fix (backported to 3.9.7):
+ *   1. lib/setup-sandbox.js — `Symbol.for(key)` returns a sandbox-local symbol
+ *      whenever `key` is in the `nodejs.` namespace, so sandbox code can never
+ *      obtain a real cross-realm Node.js internal symbol.
+ *   2. lib/bridge.js — the `set`, `defineProperty` and `deleteProperty` write
+ *      traps reject any sandbox-originated operation whose key is a known
+ *      dangerous cross-realm symbol, so even a host-provided dangerous symbol
+ *      cannot be installed on / deleted from a host object from the sandbox.
+ */
+
+'use strict';
+
+const assert = require('assert');
+const util = require('util');
+const {VM} = require('..');
+
+const NODE_MAJOR = parseInt(process.versions.node.split('.')[0], 10);
+const HAS_STREAM_BRAND_SYMBOLS = NODE_MAJOR >= 16;
+
+function safeRun(code) {
+	const vm = new VM();
+	try {
+		return vm.run('(function () { try { ' + code + ' } catch (_) { return undefined; } })()');
+	} catch (_) {
+		return undefined;
+	}
+}
+
