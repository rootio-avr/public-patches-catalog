+'use strict';
+
+/*
+ * Regression test for CVE-2026-47139 (GHSA-r9pm-gxmw-wv6p).
+ *
+ * Node exposes a parallel family of underscored builtins (_http_client,
+ * _http_server, _http_agent, _http_common, _http_incoming, _http_outgoing,
+ * _tls_common, _tls_wrap, _stream_*). They are the private implementation
+ * modules backing http/https/tls/streams -- undocumented, but present in
+ * require('module').builtinModules -- and they expose the network primitives
+ * directly (_http_client.ClientRequest, _http_server.Server).
+ *
+ * Pre-fix, `builtin: ['*', '-http', '-https', '-net', '-tls', ...]` (the
+ * documented "allow all except network" pattern) silently allowed every
+ * _http_* / _tls_* sibling, fully bypassing the embedder's network
+ * restriction (SSRF-class). The fix filters underscored builtins out of the
+ * '*' wildcard expansion in lib/resolver-compat.js while preserving explicit
+ * opt-in and mock/override registrations.
+ */
+
+const assert = require('assert');
+const {NodeVM} = require('../lib/main.js');
+
+const UNDERSCORED_NETWORK = [
+	'_http_agent',
+	'_http_client',
+	'_http_common',
+	'_http_incoming',
+	'_http_outgoing',
+	'_http_server',
+	'_tls_common',
+	'_tls_wrap'
+];
+
+function tryRequire(vm, name) {
+	return vm.run(`
+		try {
+			const m = require(${JSON.stringify(name)});
+			module.exports = {ok: true};
+		} catch (e) {
+			module.exports = {ok: false, message: e && e.message};
+		}
+	`, 'vm.js');
+}
+
+describe('CVE-2026-47139 -- underscored network builtins bypass via wildcard', () => {
+
+	it("`builtin: ['*']` does NOT expose _http_client", () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.strictEqual(tryRequire(vm, '_http_client').ok, false);
+	});
+
+	it("`builtin: ['*']` does NOT expose _http_server", () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.strictEqual(tryRequire(vm, '_http_server').ok, false);
+	});
+
+	it("`['*', '-http', '-https', '-net', '-tls']` leaks no _http_*/_tls_* sibling (canonical PoC)", () => {
+		const vm = new NodeVM({
+			require: {
+				builtin: ['*', '-http', '-https', '-net', '-dgram', '-tls', '-dns', '-http2'],
+				external: false
+			}
+		});
+		for (const name of UNDERSCORED_NETWORK) {
+			assert.strictEqual(tryRequire(vm, name).ok, false, `${name} must NOT load under network-excluded wildcard`);
+		}
+	});
+
+	it('underscored stream internals are also excluded from the wildcard', () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		for (const name of ['_stream_readable', '_stream_writable', '_stream_duplex', '_stream_transform']) {
+			assert.strictEqual(tryRequire(vm, name).ok, false, `${name} must NOT load under wildcard`);
+		}
+	});
+
+	it('non-underscored builtins still load under the wildcard', () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.strictEqual(vm.run("module.exports = typeof require('fs').readFileSync", 'vm.js'), 'function');
+		assert.strictEqual(vm.run("module.exports = typeof require('path').join", 'vm.js'), 'function');
+	});
+
+	it('mock/override escape hatch is preserved for underscored names', () => {
+		const vm = new NodeVM({
+			require: {
+				builtin: ['*'],
+				external: false,
+				mock: {_http_client: {safe: 7}}
+			}
+		});
+		assert.strictEqual(vm.run("module.exports = require('_http_client').safe", 'vm.js'), 7);
+	});
+
+});

