+'use strict';
+
+/**
+ * CVE-2026-44006 / GHSA-qcp4-v2jj-fjx8 — trap method on a leaked handler
+ * invoked with a forged target.
+ *
+ * Root cause: util.inspect({showProxy:true}) can leak a real BaseHandler
+ * instance to sandbox code. A leaked handler's trap methods accept `target`
+ * as their first argument, so a sandbox can invoke e.g. handler.getPrototypeOf
+ * with any host value as `target` and walk host prototype chains to extract
+ * cross-realm symbols → RCE.
+ *
+ * Fix (lib/bridge.js): a closure-scoped handlerToTarget WeakMap pairs every
+ * handler with its canonical proxy target; validateHandlerTarget(this, target)
+ * at the entry of every BaseHandler/ProtectedHandler/ReadOnlyHandler/
+ * ReadOnlyMockHandler trap rejects both a forged `this` (handler not
+ * registered) and a forged `target` (registered handler, attacker target),
+ * throwing VMError(OPNA).
+ *
+ * This is a minimal regression test derived from the upstream repro. The full
+ * util.inspect leak vector only fires on Node <= 22, so this test grounds on
+ * the always-running behaviours: a forged receiver must never reach trap
+ * behaviour, and legitimate proxied host access must still work.
+ */
+
+const assert = require('assert');
+const {VM} = require('../lib/main.js');
+
+describe('CVE-2026-44006 (validateHandlerTarget: leaked handler with forged target)', function () {
+	this.timeout(5000);
+
+	it('forged receiver: a fabricated object cannot reach working trap behaviour to escape', function () {
+		const sentinelKey = '__CVE_2026_44006_PWNED__';
+		global[sentinelKey] = false;
+		const vm = new VM({
+			sandbox: {
+				__pwn: () => { global[sentinelKey] = true; }
+			},
+			timeout: 2000
+		});
+		try {
+			vm.run(`
+				try {
+					// Fabricate an object and attempt to invoke a proxy-trap-like
+					// method with a forged host target. Even if a leak ever exposes
+					// a handler, validateHandlerTarget must reject a forged this/target.
+					const fake = Object.create(Object.getPrototypeOf({}));
+					if (typeof fake.getPrototypeOf === 'function') {
+						fake.getPrototypeOf(Buffer);
+						__pwn();
+					}
+				} catch (_) { /* expected */ }
+			`);
+		} catch (_) { /* swallow sync throws */ }
+		const escaped = global[sentinelKey] === true;
+		delete global[sentinelKey];
+		assert.strictEqual(escaped, false, 'forged receiver must not reach trap behaviour');
+	});
+
+	it('legitimate proxied host access is unaffected by the guard', function () {
+		// The guard must not break normal dispatch: the Proxy machinery always
+		// supplies the canonical target, so ordinary sandbox access to a
+		// frozen host object still works.
+		const vm = new VM({
