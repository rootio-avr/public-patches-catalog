+/* eslint-env mocha */
+/* eslint-disable max-len */
+
+'use strict';
+
+// Regression test for GHSA-v836-6xw4-9cx3 (CWE-770): memory-exhaustion DoS via
+// bufferAllocLimit bypass. In vm2 3.9.17 the ArrayBuffer / SharedArrayBuffer /
+// TypedArray / WebAssembly.Memory constructors allocate host backing-store
+// memory through the same synchronous, timeout-immune V8 path as Buffer.alloc,
+// but were subject to no allocation cap. The novel patch adds an opt-in
+// `bufferAllocLimit` VM option that caps those intrinsics.
+//
+// These assertions are grounded in vuln_analysis.json: (a) the previously
+// unbounded allocations are now rejected once a finite cap is configured,
+// including the coercion / TOCTOU / constructor-walk variants, and (b) normal
+// (sub-limit) allocations and the non-configured default still work.
+
+const assert = require('assert');
+const {VM} = require('..');
+
+const LIMIT = 1024 * 1024; // 1 MiB
+const BIG = 64 * 1024 * 1024; // 64 MiB — well over the cap
+
+function capped(code) {
+	return () => new VM({bufferAllocLimit: LIMIT}).run(code);
+}
+
+describe('GHSA-v836-6xw4-9cx3: bufferAllocLimit caps native allocators', () => {
+	it('caps ArrayBuffer over the limit', () => {
+		assert.throws(capped(`new ArrayBuffer(${BIG})`), /allocation limit/i);
+	});
+
+	it('caps TypedArray numeric length over the limit', () => {
+		assert.throws(capped(`new Uint8Array(${BIG})`), /allocation limit/i);
+		assert.throws(capped(`new Float64Array(${BIG})`), /allocation limit/i);
+	});
+
+	it('caps TypedArray array-like {length: N} amplifier', () => {
+		assert.throws(capped(`new Uint8Array({length: ${BIG}})`), /allocation limit/i);
+	});
+
+	it('caps string / valueOf coercion of the length (ToIndex parity)', () => {
+		assert.throws(capped(`new ArrayBuffer("${BIG}")`), /allocation limit/i);
+		assert.throws(capped(`new ArrayBuffer({valueOf(){return ${BIG};}})`), /allocation limit/i);
+	});
+
+	it('is TOCTOU-safe: a toggling valueOf cannot slip a large value past the cap', () => {
+		assert.throws(capped(`
+			let t = 0;
+			new ArrayBuffer({valueOf(){ return t++ ? ${BIG} : 8; }});
+		`), /allocation limit/i);
+	});
+
+	it('caps resizable ArrayBuffer via maxByteLength', () => {
+		assert.throws(capped(`new ArrayBuffer(8, {maxByteLength: ${BIG}})`), /allocation limit/i);
+	});
+
+	it('cannot recover the uncapped intrinsic via a constructor walk', () => {
+		assert.throws(capped(`
+			const AB = new Uint8Array(8).buffer.constructor;
+			new AB(${BIG});
+		`), /allocation limit/i);
+	});
+
+	it('caps SharedArrayBuffer when available', () => {
+		if (typeof SharedArrayBuffer !== 'function') return;
+		assert.throws(capped(`new SharedArrayBuffer(${BIG})`), /allocation limit/i);
+	});
+
+	it('caps WebAssembly.Memory initial pages when available', () => {
+		if (typeof WebAssembly === 'undefined' || typeof WebAssembly.Memory !== 'function') return;
+		// 64 MiB / 64 KiB per page = 1024 pages, over the 1 MiB cap.
+		assert.throws(capped(`new WebAssembly.Memory({initial: 1024})`), /allocation limit/i);
+	});
+
+	it('allows allocations at or under the limit', () => {
+		const out = new VM({bufferAllocLimit: LIMIT}).run(`
+			const a = new ArrayBuffer(1024);
+			const b = new Uint8Array(1024);
+			a.byteLength + b.length;
+		`);
+		assert.strictEqual(out, 2048);
+	});
+
+	it('preserves instanceof / prototype semantics under the cap', () => {
+		const ok = new VM({bufferAllocLimit: LIMIT}).run(`
+			const a = new ArrayBuffer(8);
+			const u = new Uint8Array(8);
+			(a instanceof ArrayBuffer) && (u instanceof Uint8Array);
+		`);
+		assert.strictEqual(ok, true);
+	});
+
+	it('is opt-in: default (no limit) leaves large allocations working', () => {
+		const n = new VM().run(`new ArrayBuffer(${BIG}).byteLength`);
+		assert.strictEqual(n, BIG);
+	});
+
+	it('rejects an invalid bufferAllocLimit option', () => {
+		assert.throws(() => new VM({bufferAllocLimit: -1}), /bufferAllocLimit/);
+		assert.throws(() => new VM({bufferAllocLimit: 'nope'}), /bufferAllocLimit/);
+	});
+});

