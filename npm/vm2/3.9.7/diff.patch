+/**
+ * CVE-2026-24118 / GHSA-grj5-jjm8-h35p — Array species self-return sandbox escape.
+ *
+ * V8's ArraySpeciesCreate (invoked internally by Array.prototype.{map,filter,
+ * slice,concat,splice,...}) reads `this.constructor[Symbol.species]` directly on
+ * raw host objects, bypassing the bridge proxy traps. An attacker obtains a
+ * host-realm array `r`, installs a sandbox `constructor` whose [Symbol.species]
+ * returns `r` itself, then calls `r.map(f)` — causing V8 to write raw host values
+ * directly into a sandbox-visible array, escaping the bridge.
+ *
+ * Fix (lib/bridge.js): (1) the get trap returns a cached this-realm Array
+ * constructor for host arrays; (2) the apply/construct traps shadow
+ * `constructor = undefined` on every reachable host array before the host call and
+ * restore it in a finally; non-configurable/non-extensible attacker state is
+ * rejected with VMError.
+ *
+ * Replacement regression test authored for target 3.9.7 (upstream test/ghsa/... is
+ * not shipped in this version's target_tree). Grounded on the upstream repro.js.
+ */
+
+'use strict';
+
+const assert = require('assert');
+const { VM } = require('../lib/main.js');
+
+// Common prelude: walk the prototype chain via ({}).__lookupGetter__ + Buffer.apply
+// to obtain the HOST Object constructor, then ho.entries({}) yields a host-realm
+// array — the primitive surface for the species attack.
+const PRELUDE = `
+	const g = ({}).__lookupGetter__;
+	const a = Buffer.apply;
+	const p = a.apply(g, [Buffer, ['__proto__']]);
+	const op = p.call(p.call(p.call(p.call(Buffer.of()))));
+	const ho = op.constructor; // host Object
+`;
