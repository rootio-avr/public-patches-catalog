+	it('blocks pp.set.call(forgedHandler, null, k, v)', () => {
+		runBlocked('direct-method-call', `
+			try {
+				if (!pp) { 'NO_HANDLER' }
+				else {
+					const s = {__proto__: null};
+					const forged = {};
+					Object.setPrototypeOf(forged, pp);
