+	// Final — the full RCE chain from the advisory must be blocked.
+	it('blocks full RCE chain from advisory', () => {
+		const vm = new VM();
+		let thrown = null;
+		let leaked = false;
+		try {
+			leaked = vm.run(`
+				try {
+					const obj = {
+						subarray: Buffer.prototype.inspect,
+						slice: Buffer.prototype.slice,
+						hexSlice:()=>''
