+	const vm = new VM();
+	let result;
+	let thrown = null;
+	try {
+		result = vm.run(PRELUDE + code);
+	} catch (e) {
+		thrown = e;
+	}
+	// 'BLOCKED'   -> attack threw inside the sandbox (caught by test code)
+	// 'NO_ESCAPE' -> attack completed but did NOT escape (fix worked silently)
+	// A bridge-level throw also counts as blocked.
+	if (thrown) return;
+	assert.ok(
+		result === 'BLOCKED' || result === 'NO_ESCAPE',
+		`[${label}] expected BLOCKED or NO_ESCAPE, got: ${JSON.stringify(result)}`
+	);
