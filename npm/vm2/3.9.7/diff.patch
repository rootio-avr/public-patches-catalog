+'use strict';
+
+/*
+ * Regression test for CVE-2026-47210 (vm2 Promise species-constructor sandbox escape).
+ *
+ * When async is allowed, vm2 leaves sandbox Promises live. Promise.prototype
+ * .then/.catch/.finally build their result promise via
+ * SpeciesConstructor(promise, %Promise%), reading the receiver's attacker
+ * controllable `constructor` / `Symbol.species`. A malicious Promise subclass
+ * inside the sandbox could hijack that lookup so host internals invoke an
+ * attacker supplied constructor with the promise resolving functions, leaking
+ * host capabilities and escaping the sandbox. The fix forces the species lookup
+ * back to the genuine host Promise before delegating to the native method.
+ */
+
+const assert = require('assert');
+const {VM} = require('..');
+
+describe('CVE-2026-47210 Promise species-constructor escape', () => {
+	it('does not invoke an attacker-controlled species constructor from .then', () => {
+		const vm = new VM({allowAsync: true});
+		const escaped = vm.run(`
+			let leaked = false;
+			class Evil extends Promise {
+				static get [Symbol.species]() {
+					return function (executor) {
+						leaked = true;
+						return new Promise(executor);
+					};
+				}
+			}
+			const p = Evil.resolve(1);
+			try { p.then(() => {}); } catch (e) {}
+			leaked;
+		`);
+		assert.strictEqual(escaped, false, 'sandbox must not reach a hijacked Promise species constructor');
+	});
+
+	it('still allows normal promise chaining under allowAsync', async () => {
+		const vm = new VM({allowAsync: true});
+		const result = await vm.run('Promise.resolve(41).then(v => v + 1)');
+		assert.strictEqual(result, 42);
+	});
+});

