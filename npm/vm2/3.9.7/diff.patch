+/**
+ * CVE-2026-47131 / GHSA-v6mx-mf47-r5wg — sandbox escape via host intrinsic
+ * prototype severance through the bridge apply trap.
+ *
+ * Grounded in the upstream regression test
+ * (test/ghsa/GHSA-v6mx-mf47-r5wg/repro.js @ 27c525f). The sandbox chains
+ * `Buffer.call.call({}.__lookupSetter__, Buffer, "__proto__")` to obtain the
+ * host `Object.prototype.__proto__` setter and calls it with a wrapped host
+ * object as `this`; the apply trap unwrapped the proxy and forwarded to the
+ * host setter, severing a host prototype chain. A subsequent host error then
+ * fell through `thisEnsureThis` unwrapped, exposing host `Function` via
+ * `e.constructor.constructor` → RCE.
+ *
+ * The two-layer fix (a) refuses sandbox-initiated apply-trap invocations that
+ * reach a dangerous host proto-mutator (directly or via one indirection layer)
+ * and (b) cache-checks previously bridged host values in thisEnsureThis before
+ * the proto-chain walk. These tests assert the escape is blocked while normal
+ * sandbox-native behavior is preserved.
+ */
+
+'use strict';
+
+const assert = require('assert');
+const { VM } = require('../lib/main.js');
+
+const NODE_MAJOR = parseInt(process.versions.node.split('.')[0], 10);
+const HAS_WASM_STREAMING = NODE_MAJOR >= 14;
+
+function escapeAttempt(code) {
+	const vm = new VM({ timeout: 2000 });
+	const pwnKey = '__CVE_2026_47131_pwned_' + Math.random().toString(36).slice(2);
+	global[pwnKey] = false;
+	try {
+		vm.run(code.replace(/__PWN_KEY__/g, JSON.stringify(pwnKey)));
+	} catch (_) {
+		/* bridge-level throws are also an acceptable block */
+	}
+	return new Promise(function (resolve) {
+		setTimeout(function () {
+			const escaped = global[pwnKey] === true;
+			delete global[pwnKey];
+			resolve(escaped);
+		}, 300);
+	});
+}
+
+describe('CVE-2026-47131 (GHSA-v6mx-mf47-r5wg) host prototype severance escape', function () {
+
+	(HAS_WASM_STREAMING ? it : it.skip)('blocks the canonical Buffer.call.call proto-severance PoC', async function () {
+		this.timeout(5000);
+		const escaped = await escapeAttempt(`
+			"use strict";
+			const getProto = Buffer.call.call({}.__lookupGetter__, Buffer, "__proto__");
+			const setProto = Buffer.call.call({}.__lookupSetter__, Buffer, "__proto__");
+			async function f() {
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) { try { setProto.call(getProto.call(e), null); } catch (_) {} }
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						const HostFunction = e.constructor.constructor;
+						new HostFunction("globalThis[" + JSON.stringify(__PWN_KEY__) + "] = true")();
+					} catch (_) {}
+				}
+			}
+			f().catch(() => {});
+		`);
+		assert.strictEqual(escaped, false, 'canonical PoC succeeded — sandbox escaped');
+	});
+
+	(HAS_WASM_STREAMING ? it : it.skip)('blocks the deeper (two-level) proto-severance variant', async function () {
+		this.timeout(5000);
+		const escaped = await escapeAttempt(`
+			"use strict";
+			const getProto = Buffer.call.call({}.__lookupGetter__, Buffer, "__proto__");
+			const setProto = Buffer.call.call({}.__lookupSetter__, Buffer, "__proto__");
+			async function f() {
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) { try { setProto.call(getProto.call(getProto.call(e)), null); } catch (_) {} }
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						const HostFunction = e.constructor.constructor;
+						new HostFunction("globalThis[" + JSON.stringify(__PWN_KEY__) + "] = true")();
+					} catch (_) {}
+				}
+			}
+			f().catch(() => {});
+		`);
+		assert.strictEqual(escaped, false, 'deeper proto-severance variant succeeded');
+	});
+
+	it('blocks direct sandbox invocation of the host __proto__ setter on a host object', function () {
+		// Layer A write-side: invoking the host prototype mutator via the
+		// indirection primitive must throw rather than mutate a host object.
+		const vm = new VM({ sandbox: {} });
+		const out = vm.run(`
+			"use strict";
+			let blocked = false;
+			try {
+				const setProto = Buffer.call.call({}.__lookupSetter__, Buffer, "__proto__");
+				// Buffer is a host-realm function reachable from the sandbox.
+				setProto.call(Buffer, null);
+			} catch (e) { blocked = true; }
+			blocked;
+		`);
+		assert.strictEqual(out, true, 'host __proto__ setter was not blocked');
+	});
+
+	it('preserves sandbox-native error identity through a catch block', function () {
+		const vm = new VM();
+		const out = vm.run(`
+			let sameIdentity = false;
+			try { throw new Error("local"); }
+			catch (e) { sameIdentity = (e instanceof Error) && e.message === "local"; }
+			({ sameIdentity });
+		`);
+		assert.strictEqual(out.sameIdentity, true, 'sandbox-native error lost identity through catch');
+	});
+
+	it('passes Object.create(null) sandbox values through untouched', function () {
+		const vm = new VM();
+		const out = vm.run(`
+			const nullProto = Object.create(null);
+			nullProto.kind = "marker";
+			let caught = null;
+			try { throw nullProto; } catch (e) { caught = e; }
+			({ kind: caught && caught.kind, sameRef: caught === nullProto });
+		`);
+		assert.strictEqual(out.kind, 'marker', 'null-proto throw lost data');
+		assert.strictEqual(out.sameRef, true, 'null-proto throw was wrapped');
+	});
+});

