+'use strict';
+
+/* eslint-env mocha */
+
+/**
+ * CVE-2026-44009 / GHSA-9vg3-4rfj-wgcm
+ * Sandbox breakout via null-proto throw / handleException write-through.
+ *
+ * Upstream (vm2 >= 3.11.0) regressed when commit b57ac2d switched the
+ * sandbox-side `handleException` catch sanitiser and the
+ * `globalPromise.prototype.then` onFulfilled wrapper from `ensureThis(e)` to
+ * `from(e)` for "GHSA-mpf8 symmetry". `from()` builds a bridge proxy that
+ * treats its target as host-realm; on a SANDBOX-realm null-proto value its
+ * `set` trap unwraps incoming sandbox proxies of host functions back to the
+ * raw host originals and stores them on the underlying sandbox object,
+ * readable via the original sandbox reference -> host `Function` -> RCE.
+ * The fix (c33c2bb) reverted those callsites back to `ensureThis()`.
+ *
+ * Target vm2 3.9.7 PRE-DATES b57ac2d entirely: `lib/setup-sandbox.js` already
+ * aliases `handleException` directly to `ensureThis` (sandbox-realm passthrough)
+ * and never introduced the `from()`-wrapped catch / onFulfilled callsites, so
+ * the vulnerable write-through proxy was never present here. This regression
+ * test grounds that not-applicable determination by asserting the advisory's
+ * exact PoC cannot reach a host `Function` constructor on 3.9.7, and that
+ * ordinary sandbox exception handling still works.
+ */
+
+const assert = require('assert');
+const { VM } = require('../lib/main.js');
+
+describe('CVE-2026-44009 (null-proto throw / handleException write-through)', function () {
+	it('null-proto throw + Buffer.prototype.inspect cannot reach host Function', function () {
+		const vm = new VM();
+		const result = vm.run(`
+			const o = {__proto__: null};
+			let leaked = null;
+			try {
+				try {
+					throw o;
+				} catch (e) {
+					e.f = Buffer.prototype.inspect;
+					// Read back via the ORIGINAL sandbox reference \`o\` (not the
+					// caught \`e\`). If the raw host inspect was written through,
+					// \`o.f.constructor\` would be host Function.
+					leaked = o.f && o.f.constructor;
+				}
+			} catch (_) {
+				leaked = null;
+			}
+			({
+				leakedIsFunction: typeof leaked === 'function',
+				leakedCanCompile: (function () {
+					if (typeof leaked !== 'function') return false;
+					try {
+						return leaked('return typeof process')() === 'object';
+					} catch (_) {
+						return false;
+					}
+				})()
+			});
+		`);
+		assert.strictEqual(
+			result.leakedIsFunction && result.leakedCanCompile,
+			false,
+			'host Function constructor leaked via null-proto throw write-through'
+		);
+	});
+
+	it('advisory PoC does not perform RCE (no host child_process)', function () {
+		const vm = new VM();
+		let escaped = false;
+		let captured = null;
+		try {
+			vm.run(`
+				const o = {__proto__: null};
+				try {
+					throw o;
+				} catch (e) {
+					e.f = Buffer.prototype.inspect;
+					return o.f.constructor("return process")().mainModule.require('child_process');
+				}
+			`);
+			escaped = true;
+		} catch (e) {
+			captured = e;
+		}
+		assert.strictEqual(escaped, false, 'sandbox escape: PoC reached child_process');
+		assert.ok(captured, 'PoC must throw rather than return a host module');
+	});
+
+	it('regression: ordinary sandbox catch on a sandbox-realm Error still works', function () {
+		const vm = new VM();
+		const msg = vm.run(`
+			try {
+				throw new Error('boom');
+			} catch (e) {
+				e.message;
+			}
+		`);
+		assert.strictEqual(msg, 'boom');
+	});
+});
