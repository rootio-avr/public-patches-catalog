+'use strict';
+
+/**
+ * CVE-2026-44001 / GHSA-hw58-p9xv-2mjh
+ * Promise executor unhandled rejection escapes to host (DoS).
+ *
+ * Sandbox code creates a `Promise` whose executor synchronously triggers a
+ * host-realm error (e.g. `new Promise((r,j) => { var e = new Error();
+ * e.name = Symbol(); e.stack; })` — V8's FormatStackTrace coerces the
+ * Symbol-named `name` and throws). With no `.catch()` attached, the rejection
+ * propagated to the host process as an unhandled rejection; Node 15+ default
+ * behaviour terminates the process. `allowAsync: false` made it worse because
+ * the sandbox `.catch` was blocked, guaranteeing the rejection went unhandled.
+ *
+ * Fix: the sandbox Promise is replaced with a subclass whose constructor wraps
+ * the user executor in try/catch (rejecting with a sandbox-realm value) and
+ * attaches a benign swallow tail so the host's unhandledRejection never fires.
+ *
+ * Grounded on the upstream regression test
+ * test/ghsa/GHSA-hw58-p9xv-2mjh/repro.js from fix commit 6bbfbb37.
+ */
+
+const assert = require('assert');
+const {VM} = require('../lib/main.js');
+
+describe('CVE-2026-44001 (Promise executor unhandled rejection DoS)', () => {
+	it('Symbol-named Error stack throw inside executor produces no host unhandled rejection', done => {
+		const captured = [];
+		function handler(reason) {
+			captured.push(reason);
+		}
+		process.on('unhandledRejection', handler);
+		new VM({timeout: 5000, allowAsync: false}).run(`
+			new Promise(function(r, j) {
+				var e = new Error();
+				e.name = Symbol();
+				e.stack;
+			});
+		`);
+		setImmediate(() => {
+			process.off('unhandledRejection', handler);
+			assert.strictEqual(
+				captured.length,
+				0,
+				'host should not see unhandled rejection; got: ' + (captured[0] && captured[0].message)
+			);
+			done();
+		});
+	});
+
+	it('plain executor throw is also swallowed', done => {
+		const captured = [];
+		function handler(reason) {
+			captured.push(reason);
+		}
+		process.on('unhandledRejection', handler);
+		new VM({timeout: 5000, allowAsync: false}).run(`new Promise(function(r, j) { throw new Error('boom'); });`);
+		setImmediate(() => {
+			process.off('unhandledRejection', handler);
+			assert.strictEqual(captured.length, 0, 'plain throw must not produce host unhandled rejection');
+			done();
+		});
+	});
