+/* eslint-env mocha */
+/* eslint-disable max-len */
+
+'use strict';
+
+// Regression test for CVE-2026-47698 (GHSA-cfcw-xp6x-25gj):
+// stacked-indirection / host-side-laundering bypass of the prior single-layer
+// indirection check. The attacker severs a host error's prototype chain
+// host-side so the bridge proto-mapping lookup misses, then a RAW host error
+// surfaces in a sandbox `catch`. The sandbox pivots `e.constructor.constructor`
+// to host `Function` for RCE.
+//
+// Grounded on the upstream repro (test/ghsa/GHSA-cfcw-xp6x-25gj/repro.js). The
+// backported fix refuses, in `thisEnsureThis` (the sole exception re-entry
+// chokepoint the transformer routes caught values through), any host-realm
+// object whose prototype chain reaches null without ever passing through the
+// sandbox Object.prototype — the universal signature of a severed host carrier.
+
+const assert = require('assert');
+const {VM} = require('..');
+
+const NODE_MAJOR = parseInt(process.versions.node.split('.')[0], 10);
+// WebAssembly.compileStreaming exists on Node 14+; the PoC depends on its
+// rejection producing a host Node-internal error whose chain can be severed.
+const HAS_WASM_STREAMING = NODE_MAJOR >= 14;
+
+function escapeAttempt(code) {
+	const vm = new VM({timeout: 2000});
+	const pwnKey = '__CVE_2026_47698_pwned_' + Math.random().toString(36).slice(2);
+	global[pwnKey] = false;
+	try {
+		vm.run(code.replace(/__PWN_KEY__/g, JSON.stringify(pwnKey)));
+	} catch (_) {
+		/* bridge-level throws are also acceptable — escape is what matters */
+	}
+	return new Promise((resolve) => {
+		setTimeout(() => {
+			const escaped = global[pwnKey] === true;
+			delete global[pwnKey];
+			resolve(escaped);
+		}, 300);
+	});
+}
+
+describe('CVE-2026-47698 (severed host-prototype-chain sandbox escape)', () => {
+
+	const cond = HAS_WASM_STREAMING ? it : it.skip;
+
+	cond('blocks the canonical stacked-indirection PoC', async function () {
+		this.timeout(5000);
+		const escaped = await escapeAttempt(`
+			"use strict";
+			const getProto = Buffer.call.call(Buffer.call, {}.__lookupGetter__, Buffer, "__proto__");
+			const setProto = Buffer.call.call(Buffer.call, {}.__lookupSetter__, Buffer, "__proto__");
+			async function f() {
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						Buffer.call.call(Buffer.call, setProto,
+							Buffer.call.call(Buffer.call, getProto, e), null);
+					} catch (_) {}
+				}
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						const HostFunction = e.constructor.constructor;
+						new HostFunction("globalThis[" + JSON.stringify(__PWN_KEY__) + "] = true")();
+					} catch (_) {}
+				}
+			}
+			f().catch(() => {});
+		`);
+		assert.strictEqual(escaped, false, 'stacked-indirection PoC succeeded — sandbox escaped');
+	});
+
+	cond('blocks the map/bind host-side laundering variant', async function () {
+		this.timeout(5000);
+		const escaped = await escapeAttempt(`
+			"use strict";
+			const ca = Buffer.call.call(Buffer.bind, Buffer.apply, Buffer.call, Buffer.call);
+			function caar(a){ const r = Buffer.of().toJSON().data; r[0] = a; return r.map(ca); }
+			async function f() {
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						const g = caar([{}.__lookupGetter__, Buffer, "__proto__"]); g[1] = e;
+						const s = caar([{}.__lookupSetter__, Buffer, "__proto__"]); s[1] = ca(g); s[2] = null;
+						ca(s);
+					} catch (_) {}
+				}
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						e.constructor.constructor("globalThis[" + JSON.stringify(__PWN_KEY__) + "] = true")();
+					} catch (_) {}
+				}
+			}
+			f().catch(() => {});
+		`);
+		assert.strictEqual(escaped, false, 'map/bind laundering PoC succeeded — sandbox escaped');
+	});
+
+	it('preserves normal sandbox exception handling', () => {
+		const vm = new VM();
+		// A sandbox-realm error caught inside the sandbox must still behave
+		// normally: its message is readable and its constructor stays inside the
+		// sandbox realm (constructor.constructor is the sandbox Function, safe).
+		const out = vm.run(`
+			let msg = null, ctorName = null;
+			try { throw new TypeError('boom'); }
+			catch (e) { msg = e.message; ctorName = e.constructor.name; }
+			[msg, ctorName];
+		`);
+		assert.strictEqual(out[0], 'boom');
+		assert.strictEqual(out[1], 'TypeError');
+	});
+
+	it('preserves Object.create(null) throws (primordial null-proto value)', () => {
+		const vm = new VM();
+		// A deliberately primordial null-proto sandbox value must pass through
+		// untouched — it is NOT a severed host carrier.
+		const out = vm.run(`
+			let seen = false;
+			try { throw Object.create(null); }
+			catch (e) { seen = (e !== null && typeof e === 'object'); }
+			seen;
+		`);
+		assert.strictEqual(out, true);
+	});
+
+});

