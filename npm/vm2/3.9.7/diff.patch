+					}
+					if (!built) { 'NO_ESCAPE' }
+					else {
+						try { built.set(null, 'obj', s); } catch (e) {}
+						if (typeof s.obj !== 'undefined') { 'ESCAPE:brute' }
+						else { 'NO_ESCAPE' }
+					}
+				}
+			} catch (e) { 'BLOCKED' }
