+'use strict';
+
+/*
+ * Regression test for CVE-2026-47139 (GHSA-r9pm-gxmw-wv6p).
+ *
+ * Node exposes a parallel family of underscored builtins (_http_client,
+ * _http_server, _http_agent, _http_common, _http_incoming, _http_outgoing,
+ * _tls_common, _tls_wrap, _stream_*). They are the private implementation
+ * modules backing http/https/tls/streams -- undocumented, but present in
+ * require('module').builtinModules -- and they expose the network primitives
+ * directly (_http_client.ClientRequest, _http_server.Server).
+ *
+ * Pre-fix, `builtin: ['*', '-http', '-https', '-net', '-tls', ...]` (the
+ * documented "allow all except network" pattern) silently allowed every
+ * _http_* / _tls_* sibling, fully bypassing the embedder's network
+ * restriction (SSRF-class). The fix filters underscored builtins out of the
+ * '*' wildcard expansion in lib/resolver-compat.js while preserving explicit
+ * opt-in and mock/override registrations.
+ */
+
+const assert = require('assert');
+const {NodeVM} = require('../lib/main.js');
+
+const UNDERSCORED_NETWORK = [
+	'_http_agent',
+	'_http_client',
+	'_http_common',
+	'_http_incoming',
+	'_http_outgoing',
+	'_http_server',
+	'_tls_common',
+	'_tls_wrap'
+];
+
+function tryRequire(vm, name) {
+	return vm.run(`
+		try {
+			const m = require(${JSON.stringify(name)});
+			module.exports = {ok: true};
+		} catch (e) {
+			module.exports = {ok: false, message: e && e.message};
+		}
+	`, 'vm.js');
