+/* eslint-env mocha */
+/* eslint-disable max-len */
+
+'use strict';
+
+// Regression test for GHSA-m5w8-4gq2-6f8x -- NodeVM `os` and `dns` builtins
+// leak host-process state and expose host-process *write* APIs
+// (`os.setPriority`, `dns.setServers`, `dns.setDefaultResultOrder`). Replacement
+// for the upstream test/ghsa/GHSA-m5w8-4gq2-6f8x/repro.js, which is not shipped
+// in the 3.9.7 target tree. The pre-3.11 backport enforces the denylist in
+// lib/resolver-compat.js (wildcard BUILTIN_MODULES filter + addDefaultBuiltin).
+
+const assert = require('assert');
+const {NodeVM} = require('..');
+
+describe('GHSA-m5w8-4gq2-6f8x: os/dns denied as NodeVM builtins', () => {
+	it('builtin: ["*"] does not expose os', () => {
+		const vm = new NodeVM({require: {builtin: ['*']}});
+		assert.throws(() => vm.run('module.exports = require("os");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+	});
+
+	it('builtin: ["*"] does not expose dns', () => {
+		const vm = new NodeVM({require: {builtin: ['*']}});
+		assert.throws(() => vm.run('module.exports = require("dns");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+	});
+
+	it('explicit allowlist builtin: ["os"] is rejected', () => {
+		const vm = new NodeVM({require: {builtin: ['os']}});
+		assert.throws(() => vm.run('module.exports = require("os");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+	});
+
+	it('explicit allowlist builtin: ["dns"] is rejected', () => {
+		const vm = new NodeVM({require: {builtin: ['dns']}});
+		assert.throws(() => vm.run('module.exports = require("dns");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+	});
+
+	it('object-map form builtin: {os: true} is rejected', () => {
+		const vm = new NodeVM({require: {builtin: {os: true}}});
+		assert.throws(() => vm.run('module.exports = require("os");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+	});
+
+	it('node: URL prefix does not bypass (node:os / node:dns)', () => {
+		const vm = new NodeVM({require: {builtin: ['*']}});
+		assert.throws(() => vm.run('module.exports = require("node:os");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+		assert.throws(() => vm.run('module.exports = require("node:dns");', 'poc.js'),
+			/is not whitelisted|Access denied|Cannot find module/);
+	});
