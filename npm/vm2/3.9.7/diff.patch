+const assert = require('assert');
+const {VM} = require('../lib/main.js');
+
+const HAS_ASYNC_GEN = (() => {
+	try {
+		eval('(async function*(){})');
+		return true;
+	} catch (e) {
+		return false;
+	}
+})();
+
