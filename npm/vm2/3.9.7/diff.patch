+'use strict';
+
+const assert = require('assert');
+const {VM} = require('..');
+
+// Regression test for CVE-2023-29199 (vm2 sandbox escape).
+//
+// The source transformer instruments sandboxed code with handleException()
+// calls so that host exceptions leaked into a catch clause are sanitized
+// before sandboxed code can read them. The upstream fix (3.9.16) removes the
+// insecure string post-processing in transformer.js that let an attacker
+// bypass handleException() and reach the host Function constructor
+// (see the public PoC: https://gist.github.com/leesh3288/f05730165799bf56d70391f3d9ea187c).
+//
+// These tests assert the sanitized behavior the fix guarantees: a host
+// exception caught inside the sandbox cannot be used to obtain the host
+// `process` object, while ordinary in-sandbox catch semantics keep working.
+describe('CVE-2023-29199', () => {
+	it('sanitizes host exceptions caught in a catch clause (no sandbox escape)', () => {
+		const vm = new VM();
+		// Provoke a genuine host exception (stack overflow) and attempt the
+		// escape primitive used by the public PoC: reach the Function
+		// constructor through the caught value and evaluate `return process`.
+		const code = `
+			function stack() { new Error().stack; stack(); }
+			let leaked = null;
+			try {
+				stack();
+			} catch (e) {
+				leaked = e;
+			}
+			(function() {
+				try {
+					return leaked.constructor.constructor('return process')().pid;
+				} catch (err) {
+					return 'blocked';
+				}
+			})();
+		`;
+		assert.strictEqual(vm.run(code), 'blocked', 'caught host exception must be sanitized and must not expose host process');
+	});
+
+	it('still allows normal catch behavior for in-sandbox errors', () => {
+		const vm = new VM();
+		const result = vm.run(`
+			let msg = null;
+			try {
+				throw new Error('boom');
+			} catch (e) {
+				msg = e.message;
+			}
+			msg;
+		`);
+		assert.strictEqual(result, 'boom', 'ordinary catch semantics must be preserved');
+	});
+});

