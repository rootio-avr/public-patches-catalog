+/* eslint-env mocha */
+/* eslint-disable no-new-wrappers, max-len */
+
+'use strict';
+
+const assert = require('assert');
+const {VM} = require('..');
+
+// Regression test for CVE-2023-30547 (vm2 sandbox escape).
+//
+// A host exception captured inside the sandbox — either through a `catch`
+// clause or through a Promise rejection handler — was not sanitized. That
+// leaked a reference to a host object (e.g. the host `Error`/`Object`
+// prototype), which could be used to reach the host `process` and run
+// arbitrary code. The fix ensures every captured error is passed through the
+// contextify layer (`handleException` / `ensureThis`) so the sandbox only ever
+// sees a sandbox-side object.
+
+describe('CVE-2023-30547', () => {
+	it('sanitizes host errors captured by a catch clause', () => {
+		const vm = new VM();
+		const leaked = vm.run(`
+			let captured;
+			try {
+				// Force a host-thrown TypeError from the bridge.
+				null.x;
+			} catch (e) {
+				captured = e;
+			}
+			// If the error object were a host object, its constructor chain
+			// would escape the sandbox. It must be a sandbox-local object.
+			captured.constructor.constructor === Function;
+		`);
+		assert.strictEqual(leaked, true, 'captured error must be a sandbox object');
+	});
+
+	it('does not expose the host constructor through a captured error', () => {
+		const vm = new VM();
+		const isHostConstructor = vm.run(`
+			let ctor;
+			try {
+				null.x;
+			} catch (e) {
+				ctor = e.constructor.constructor;
+			}
+			// Building a function through the leaked constructor must stay
+			// inside the sandbox: reaching the host 'process' means escape.
+			(function () {
+				try {
+					return ctor('return this.process')() !== undefined;
+				} catch (err) {
+					return false;
+				}
+			})();
+		`);
+		assert.strictEqual(isHostConstructor, false, 'sandbox must not reach host process via captured error');
+	});
+
+	it('sanitizes host errors captured by a Promise rejection handler', async () => {
+		const vm = new VM({allowAsync: true});
+		const promise = vm.run(`
+			Promise.resolve().then(() => { null.x; }).then(undefined, (e) => {
+				return e && e.constructor && e.constructor.constructor === Function;
+			});
+		`);
+		const sanitized = await promise;
+		assert.strictEqual(sanitized, true, 'rejection value must be a sandbox object');
+	});
+});

