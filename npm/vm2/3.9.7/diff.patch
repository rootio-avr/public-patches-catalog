+		result === 'BLOCKED' || result === 'NO_ESCAPE' || result === 'NO_HANDLER',
+		`[${label}] expected BLOCKED/NO_ESCAPE/NO_HANDLER, got: ${JSON.stringify(result)}`
+	);
