+'use strict';
+
+/**
+ * CVE-2026-45411 / GHSA-248r-7h7q-cr24
+ * Async generator yield*-return thenable exception capture.
+ *
+ * When an async generator delegates via `yield*` to an inner async iterator
+ * with no `return` method, calling `i.return(thenable)` causes V8 to await the
+ * thenable as the abrupt-return value. A synchronous throw from the thenable's
+ * `.then` callback is captured by V8's PromiseResolveThenableJob and delivered
+ * to sandbox code as an iterator result (`{ value: thrown, done: false }`) —
+ * bypassing both the transformer's catch-block instrumentation and the
+ * Promise.prototype.then rejection sanitizer. The fix wraps
+ * %AsyncGeneratorPrototype%.{next,return,throw} so every value flowing out of
+ * an async generator into sandbox code is routed through the exception
+ * sanitizer, and the thenable argument V8 awaits is normalised first.
+ *
+ * Grounded on the upstream regression PoC
+ * (test/ghsa/GHSA-248r-7h7q-cr24/repro.js) which is not shipped in this
+ * target tree; the assertions below mirror its core escape/sanitization checks.
