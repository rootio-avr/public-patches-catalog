@@ -0,0 +1,121 @@
+/**
+ * CVE-2026-100721 (GHSA-5h3f-q97h-ccvc) — NodeVM custom-resolver authorization
+ * must be matched with a directory boundary, not a raw string prefix.
+ *
+ * After `require('foo')` is resolved by the embedder's `require.resolve`, a
+ * prefix-sharing sibling (`node_modules/foo2/index.js`) must NOT be loadable.
+ * Oracle: a marker file the sibling writes with the HOST fs at its top level.
+ */
+
+'use strict';
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const {NodeVM} = require('../lib/main.js');
+
+describe('CVE-2026-100721 custom-resolver prefix-sharing sibling authorization', function () {
+	let base, root, nodeModules, pkgs, entry;
+
+	const marker = name => path.join(root, name + '.marker');
+
+	function write(file, content) {
+		fs.mkdirSync(path.dirname(file), {recursive: true});
+		fs.writeFileSync(file, content);
+	}
+
+	function attacker(file, name) {
+		write(file, 'require("fs").writeFileSync(' + JSON.stringify(marker(name)) + ', "PWNED");\n' +
+			'module.exports = ' + JSON.stringify('PWN:' + name) + ';');
+	}
+
+	before(function () {
+		base = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'vm2-5h3f-')));
+		root = path.join(base, 'root');
+		nodeModules = path.join(root, 'node_modules');
+		pkgs = path.join(root, 'pkgs');
+		entry = path.join(base, 'entry', 'entry.js');
+		fs.mkdirSync(path.dirname(entry), {recursive: true});
+		write(path.join(nodeModules, 'foo', 'index.js'), 'module.exports = "FOO_OK";');
+		write(path.join(pkgs, 'foo', 'index.js'), 'module.exports = "PKG_FOO_OK";');
+		write(path.join(pkgs, 'foo', 'lib', 'inner.js'), 'module.exports = "INNER_OK";');
+		attacker(path.join(nodeModules, 'foo2', 'index.js'), 'nm-foo2');
+		attacker(path.join(nodeModules, 'bar', 'index.js'), 'nm-bar');
+		attacker(path.join(pkgs, 'foo2', 'index.js'), 'pkgs-foo2');
+		attacker(path.join(pkgs, 'foo', 'index.js.evil.js'), 'evil');
+	});
+
+	after(function () {
+		if (base) fs.rmSync(base, {recursive: true, force: true});
+	});
+
+	function run(resolve, code) {
+		const vm = new NodeVM({
+			require: {
+				external: {modules: ['foo'], transitive: false},
+				root: root,
+				context: 'host',
+				resolve: resolve
+			}
+		});
+		return vm.run(code, entry);
+	}
+
+	function attempt(resolve, code) {
+		try {
+			return {loaded: true, value: run(resolve, code)};
+		} catch (e) {
+			return {loaded: false, error: e};
+		}
+	}
+
+	function assertDenied(res, name) {
+		assert.strictEqual(fs.existsSync(marker(name)), false, 'sibling ran its top-level code in the HOST realm');
+		assert.notStrictEqual(res.value, 'PWN:' + name);
+		assert.strictEqual(res.loaded, false, 'un-allowlisted sibling loaded');
+	}
+
+	const requireFooThen = file => 'require("foo"); module.exports = require(' + JSON.stringify(file) + ');';
+
+	it('still resolves the allowlisted package (string answer)', function () {
+		const res = attempt(n => n === 'foo' ? path.join(pkgs, 'foo') : undefined, 'module.exports = require("foo");');
+		assert.strictEqual(res.value, 'PKG_FOO_OK');
+	});
+
+	it('still resolves a file inside the authorized directory', function () {
+		const res = attempt(n => n === 'foo' ? path.join(pkgs, 'foo') : undefined,
+			requireFooThen(path.join(pkgs, 'foo', 'lib', 'inner.js')));
+		assert.strictEqual(res.value, 'INNER_OK');
+	});
+
+	it('denies a prefix-sharing sibling after a string answer (directory)', function () {
+		const res = attempt(n => n === 'foo' ? path.join(nodeModules, 'foo') : undefined,
+			requireFooThen(path.join(nodeModules, 'foo2', 'index.js')));
+		assertDenied(res, 'nm-foo2');
+	});
+
+	it('denies a prefix-sharing sibling outside node_modules', function () {
+		const res = attempt(n => n === 'foo' ? path.join(pkgs, 'foo') : undefined,
+			requireFooThen(path.join(pkgs, 'foo2', 'index.js')));
+		assertDenied(res, 'pkgs-foo2');
+	});
+
+	it('denies a sibling of a resolved file path', function () {
+		const res = attempt(n => n === 'foo' ? path.join(pkgs, 'foo', 'index.js') : undefined,
+			requireFooThen(path.join(pkgs, 'foo', 'index.js.evil.js')));
+		assertDenied(res, 'evil');
+	});
+
+	it('does not authorize the whole search directory for the {module, path} shape', function () {
+		const res = attempt(n => n === 'foo' ? {module: 'foo', path: nodeModules} : undefined,
+			requireFooThen(path.join(nodeModules, 'bar', 'index.js')));
+		assertDenied(res, 'nm-bar');
+	});
+
+	it('denies a sibling of the package resolved through the {module, path} shape', function () {
+		const res = attempt(n => n === 'foo' ? {module: 'foo', path: nodeModules} : undefined,
+			requireFooThen(path.join(nodeModules, 'foo2', 'index.js')));
+		assertDenied(res, 'nm-foo2');
+	});
+});
