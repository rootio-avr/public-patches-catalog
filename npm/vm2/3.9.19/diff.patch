+/* eslint-env mocha */
+/* eslint-disable max-len */
+
+// Regression test for CVE-2026-47698 (GHSA-cfcw-xp6x-25gj):
+// stacked-indirection / host-side-laundering bypass of the apply-trap peel.
+//
+// Grounded on upstream test/ghsa/GHSA-cfcw-xp6x-25gj/repro.js (fix commit
+// a85acb61). The upstream test tree does not exist in vm2@3.9.19, so this is a
+// minimal replacement exercising the same fixed behavior against the adapted
+// backport (the severed-host-value proto-walk guard in thisEnsureThis).
+
+'use strict';
+
+const assert = require('assert');
+const {VM} = require('..');
+
+const NODE_MAJOR = parseInt(process.versions.node.split('.')[0], 10);
+const HAS_WASM_STREAMING = NODE_MAJOR >= 14;
+
+function escapeAttempt(code) {
+	const vm = new VM({timeout: 2000});
+	const pwnKey = '__CVE_2026_47698_pwned_' + Math.random().toString(36).slice(2);
+	global[pwnKey] = false;
+	try {
+		vm.run(code.replace(/__PWN_KEY__/g, JSON.stringify(pwnKey)));
+	} catch (_) {
+		/* bridge-level throws are also an acceptable block */
+	}
+	return new Promise(function (resolve) {
+		setTimeout(function () {
+			const escaped = global[pwnKey] === true;
+			delete global[pwnKey];
+			resolve(escaped);
+		}, 300);
+	});
+}
+
+describe('CVE-2026-47698 (stacked indirection / host laundering breakout)', function () {
+	(HAS_WASM_STREAMING ? it : it.skip)('blocks the stacked-call PoC (Buffer.call.call(Buffer.call, setProto, ...))', async function () {
+		this.timeout(5000);
+		const escaped = await escapeAttempt(`
+			"use strict";
+			const getProto = Buffer.call.call(Buffer.call, {}.__lookupGetter__, Buffer, "__proto__");
+			const setProto = Buffer.call.call(Buffer.call, {}.__lookupSetter__, Buffer, "__proto__");
+			async function f() {
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						Buffer.call.call(Buffer.call, setProto,
+							Buffer.call.call(Buffer.call, getProto, e), null);
+					} catch (_) {}
+				}
+				try { await WebAssembly.compileStreaming(); }
+				catch (e) {
+					try {
+						const HostFunction = e.constructor.constructor;
+						new HostFunction("globalThis[" + JSON.stringify(__PWN_KEY__) + "] = true")();
+					} catch (_) {}
+				}
+			}
+			f().catch(() => {});
+		`);
+		assert.strictEqual(escaped, false, 'stacked-indirection PoC succeeded');
+	});
+
+	it('a severed-prototype host carrier surfaced in a sandbox catch cannot reach host Function', function () {
+		// Directly exercise the payoff signature the guard defends: a caught
+		// value whose prototype chain was severed host-side must never expose a
+		// host constructor pivot. Any escape would set the flag.
+		const vm = new VM({timeout: 2000});
+		const out = vm.run(`
+			"use strict";
+			let hostFunctionReached = false;
+			try {
+				const setProto = Buffer.call.call(Buffer.call, {}.__lookupSetter__, Buffer, "__proto__");
+				try { Buffer.call.call(Buffer.call, setProto, Buffer, null); } catch (_) {}
+				try {
+					const C = Buffer.constructor.constructor;
+					if (typeof C === 'function') {
+						// A sandbox Function is harmless; only a host Function escapes.
+						C("this.__cve_probe = true");
+					}
+				} catch (_) {}
+			} catch (_) {}
+			hostFunctionReached;
+		`);
+		assert.strictEqual(out, false, 'severed-host carrier exposed host Function');
+	});
+
+	it('legitimate sandbox Object.setPrototypeOf on sandbox objects still works', function () {
+		const vm = new VM();
+		const out = vm.run(`
+			const a = {};
+			const b = { kind: 'parent' };
+			Object.setPrototypeOf(a, b);
+			a.kind;
+		`);
+		assert.strictEqual(out, 'parent', 'legitimate setPrototypeOf broke');
+	});
