+/* eslint-env mocha */
+/* eslint-disable max-len */
+
+'use strict';
+
+// Regression test for GHSA-m5w8-4gq2-6f8x -- NodeVM `os`/`dns` builtins leaked
+// host state and exposed host-process write APIs (`os.setPriority`,
+// `dns.setServers`, `dns.setDefaultResultOrder`) under `builtin: ['*']` and any
+// explicit allowlist. Grounded in the upstream repro
+// (test/ghsa/GHSA-m5w8-4gq2-6f8x/repro.js).
+
+const assert = require('assert');
+const {NodeVM, makeResolverFromLegacyOptions} = require('..');
+
+describe('GHSA-m5w8-4gq2-6f8x', () => {
+	it("os is denied under builtin: ['*']", () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.throws(() => vm.run("require('os');", 'os.js'));
+	});
+
+	it("dns is denied under builtin: ['*']", () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.throws(() => vm.run("require('dns');", 'dns.js'));
+	});
+
+	it('os is denied when explicitly allowlisted', () => {
+		const vm = new NodeVM({require: {builtin: ['os'], external: false}});
+		assert.throws(() => vm.run("require('os');", 'os.js'));
+	});
+
+	it('dns/promises subpath is denied via the family-prefix matcher', () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.throws(() => vm.run("require('dns/promises');", 'dnsp.js'));
+	});
+
+	it('node: prefixed os is denied', () => {
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.throws(() => vm.run("require('node:os');", 'nodeos.js'));
+	});
+
+	it('dns.setServers from the sandbox does not change the host resolver list', () => {
+		const dnsHost = require('dns');
+		const before = dnsHost.getServers();
+		const vm = new NodeVM({require: {builtin: ['*'], external: false}});
+		try {
+			vm.run("require('dns').setServers(['127.0.0.1:5353', '8.8.4.4']);", 'dns.js');
+		} catch (e) { /* expected: require denied */ }
+		assert.deepStrictEqual(dnsHost.getServers(), before, 'host DNS resolver list must be unchanged');
+	});
+
+	it('non-host-state builtins still load (fs, path)', () => {
+		const vmFs = new NodeVM({require: {builtin: ['fs'], external: false}});
+		assert.strictEqual(vmFs.run("module.exports = typeof require('fs').readFileSync"), 'function');
+		const vmPath = new NodeVM({require: {builtin: ['*'], external: false}});
+		assert.strictEqual(vmPath.run("module.exports = typeof require('path').join"), 'function');
+	});
+
+	it('mock os/dns escape hatch is preserved', () => {
+		const vmOs = new NodeVM({require: {builtin: ['*'], external: false, mock: {os: {EOL: '\n', tag: 'sandbox-safe'}}}});
+		assert.strictEqual(vmOs.run("module.exports = require('os').tag"), 'sandbox-safe');
+		const vmDns = new NodeVM({require: {builtin: ['*'], external: false, mock: {dns: {tag: 'sandbox-safe'}}}});
+		assert.strictEqual(vmDns.run("module.exports = require('dns').tag"), 'sandbox-safe');
+	});
+
+	it('makeResolverFromLegacyOptions denies os/dns default loaders', () => {
+		// makeResolverFromLegacyOptions is the public entry over makeBuiltins*/addDefaultBuiltin.
+		const resolver = makeResolverFromLegacyOptions({builtin: ['os', 'dns', 'dns/promises']});
+		const vm = new NodeVM({require: resolver});
+		for (const name of ['os', 'dns', 'dns/promises']) {
+			assert.throws(() => vm.run(`require('${name}');`, `${name.replace('/', '-')}.js`));
+		}
+	});
+});
