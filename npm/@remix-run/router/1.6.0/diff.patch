+/**
+ * Regression test for CVE-2026-22029.
+ *
+ * A loader/action was able to return a redirect Response whose Location used a
+ * dangerous protocol (e.g. `javascript:`, `data:`, `blob:`, `file:` ...).  When
+ * the router processed such a redirect it would normalize the location and,
+ * for absolute/external targets, hand it straight to
+ * `window.location.assign`/`window.location.replace`, allowing script execution
+ * / unsafe navigations (an open-redirect / XSS vector).
+ *
+ * The fix rejects redirect targets whose protocol matches a Chromium-style
+ * blocklist during redirect normalization, so the malicious location is never
+ * followed.  These assertions mirror that fixed behavior; they are grounded in
+ * upstream fix f933b6583 ("Validate redirect locations", PR #14707), which
+ * shipped without its own regression test.
+ */
+import { createMemoryHistory, createRouter, redirect } from "../index";
+
+describe("CVE-2026-22029 - reject redirects to unsafe protocols", () => {
+  const unsafeLocations = [
+    "javascript:alert(document.domain)",
+    "data:text/html,<script>alert(1)</script>",
+    "blob:https://example.com/1234",
+    "file:///etc/passwd",
+  ];
+
+  let oldLocation: Location;
+
+  beforeEach(() => {
+    // Shim window.location so we can observe whether the router tried to
+    // navigate the browser to the malicious redirect target.
+    // https://stackoverflow.com/a/60697570
+    oldLocation = window.location;
+    const location = new URL(window.location.href) as unknown as Location;
+    location.assign = jest.fn();
+    location.replace = jest.fn();
+    delete (window as any).location;
+    window.location = location as unknown as Location;
+  });
+
+  afterEach(() => {
+    window.location = oldLocation;
+  });
+
+  it.each(unsafeLocations)(
+    "does not follow a loader redirect to %s",
+    async (unsafe) => {
+      let router = createRouter({
+        history: createMemoryHistory(),
+        routes: [
+          { id: "index", index: true, path: "/" },
+          {
+            id: "evil",
+            path: "/evil",
+            loader: () => redirect(unsafe),
+          },
+        ],
+      });
+      router.initialize();
+
+      // The malicious redirect must be rejected rather than followed.
+      await router.navigate("/evil").catch(() => {});
+
+      expect(window.location.assign).not.toHaveBeenCalled();
+      expect(window.location.replace).not.toHaveBeenCalled();
+      // The router must not have adopted the dangerous location.
+      expect(router.state.location.pathname).not.toBe(unsafe);
+
+      router.dispose();
+    }
+  );
+
+  it("still follows a safe same-origin redirect", async () => {
+    let router = createRouter({
+      history: createMemoryHistory(),
+      routes: [
+        { id: "index", index: true, path: "/" },
+        {
+          id: "start",
+          path: "/start",
+          loader: () => redirect("/safe"),
+        },
+        { id: "safe", path: "/safe" },
+      ],
+    });
+    router.initialize();
+
+    await router.navigate("/start");
+
+    expect(router.state.location.pathname).toBe("/safe");
+    expect(window.location.assign).not.toHaveBeenCalled();
+    expect(window.location.replace).not.toHaveBeenCalled();
+
+    router.dispose();
+  });
+});
