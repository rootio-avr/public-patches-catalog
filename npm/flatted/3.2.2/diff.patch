--- /dev/null
+++ b/test/cve-2026-32141.test.js
@@ -0,0 +1,47 @@
+// Regression test for CVE-2026-32141
+// Deeply nested / long circular structures previously overflowed the call
+// stack because `parse` revived values recursively (revive.apply(null, ...)).
+// The fix reshapes revival into an iterative lazy queue, so deep input must
+// parse without a RangeError ("Maximum call stack size exceeded").
+const assert = require('assert');
+const {parse, stringify} = require('../cjs/index.js');
+
+// 1) Basic round-trip still works.
+{
+  const source = {a: 1, b: 'two', c: [1, 2, 3]};
+  const restored = parse(stringify(source));
+  assert.deepStrictEqual(restored, source);
+}
+
+// 2) Circular references are preserved.
+{
+  const circular = {};
+  circular.self = circular;
+  const restored = parse(stringify(circular));
+  assert.strictEqual(restored.self, restored);
+}
+
+// 3) Deeply nested input parses iteratively without a stack overflow.
+{
+  const depth = 100000;
+  let deep = {};
+  const root = deep;
+  for (let i = 0; i < depth; i++) {
+    deep.next = {};
+    deep = deep.next;
+  }
+  deep.value = 'leaf';
+
+  const text = stringify(root);
+  let restored;
+  assert.doesNotThrow(() => {
+    restored = parse(text);
+  }, 'deep parse must not overflow the stack');
+
+  // Walk down to confirm the structure survived.
+  let cursor = restored;
+  for (let i = 0; i < depth; i++) cursor = cursor.next;
+  assert.strictEqual(cursor.value, 'leaf');
+}
+
+console.log('CVE-2026-32141 regression test passed');
