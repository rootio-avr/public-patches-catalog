--- /dev/null
+++ b/test/cve-2026-32141.test.js
@@ -0,0 +1,45 @@
+'use strict';
+// Regression test for CVE-2026-32141 (flatted): deeply-nested input caused
+// unbounded recursion in parse()/revive(), leading to a stack-overflow
+// (RangeError: Maximum call stack size exceeded) denial-of-service. The fix
+// refactors revive into an iterative resolver so parse() no longer recurses
+// per nesting level. Exercises the CommonJS entry point shipped by the package.
+const assert = require('assert');
+const {parse, stringify} = require('../cjs/index.js');
+
+// 1. Normal round-trip still works.
+const obj = {a: 1, b: [1, 2, 3], c: {d: true, e: null}};
+assert.strictEqual(stringify(parse(stringify(obj))), stringify(obj));
+
+// 2. Circular references are still resolved correctly.
+const circular = {};
+circular.self = circular;
+const revived = parse(stringify(circular));
+assert.strictEqual(revived.self, revived);
+
+// 3. The fix: a deeply-nested structure must parse iteratively without a
+//    stack overflow. The vulnerable recursive implementation throws
+//    RangeError here.
+function deepNest(depth) {
+  const root = {};
+  let cur = root;
+  for (let i = 0; i < depth; i++) {
+    cur.next = {};
+    cur = cur.next;
+  }
+  cur.end = true;
+  return root;
+}
+
+const serialized = stringify(deepNest(60000));
+const parsed = parse(serialized);
+let cur = parsed;
+let count = 0;
+while (cur.next) {
+  cur = cur.next;
+  count++;
+}
+assert.strictEqual(count, 60000);
+assert.strictEqual(cur.end, true);
+
+console.log('CVE-2026-32141 regression test passed');

