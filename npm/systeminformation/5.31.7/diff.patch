+'use strict';
+// Regression test for CVE-2026-116576: sanitizeShellString must strip unicode
+// quotes/dashes that PowerShell treats as ASCII quote/dash characters.
+const assert = require('assert');
+const util = require('../lib/util');
+
+const quotes = ['‘', '’', '‚', '‛', '“', '”', '„'];
+const dashes = ['–', '—', '―'];
+
+quotes.concat(dashes).forEach((ch) => {
+  assert.strictEqual(util.sanitizeShellString('a' + ch + 'b'), 'ab', 'U+' + ch.charCodeAt(0).toString(16) + ' must be stripped');
+  assert.strictEqual(util.sanitizeShellString('x' + ch + ' ; calc', true).indexOf(ch), -1);
+});
+assert.strictEqual(util.sanitizeShellString('’; Start-Process calc; ‘'.replace(/;/g, '')), ' Start-Process calc ');
+// normal input unaffected
+assert.strictEqual(util.sanitizeShellString('eth0-vlan_1.5'), 'eth0-vlan_1.5');
+console.log('CVE-2026-116576 regression test passed');
