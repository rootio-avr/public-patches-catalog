 /**
+ * Compiles sync JavaScript code into a function that returns a `Promise`.
+ *
+ * The converted code is evaluated inside of a `vm2` sandbox, so that untrusted
+ * code cannot reach the host's `process`, `require`, constructors, etc. (e.g.
+ * via `this.constructor.constructor('return process')()`). The plain `vm`
+ * module is NOT a security boundary and must not be used for this.
+ *
+ * @param {String} code JavaScript string to convert and evaluate
+ * @param {String} returnName Name of the function to return from the sandbox
+ * @param {Array} names Array of function names to add `yield` operators to
+ * @param {Object} options `vm2` `VM` options, plus `sandbox` and `filename`
+ * @return {Function} function that returns a `Promise`
+ * @api public
+ */
+
+function compile (code, returnName, names, options) {
+  options = options || {};
+  var compiled = degenerator(code, names);
+  var sandbox = new vm2.VM(options);
+  var script = new vm2.VMScript(compiled + ';' + returnName, {
+    filename: options.filename
+  });
+  var fn = sandbox.run(script);
+  if (typeof fn !== 'function') {
+    throw new Error('Expected a "function" to be returned for `' + returnName + '`, but got "' + typeof fn + '"');
+  }
+  // `vm2` only applies the `timeout` option to a `run()` call. Invoking `fn`
+  // (and stepping the generator it returns) directly from the host would run
+  // untrusted code with no time limit, so route every call and every generator
+  // step through `run()` as well.
+  var G = '__degenerator_' + Math.random().toString(36).slice(2) + '_';
+  var callScript = new vm2.VMScript(G + 'fn.apply(' + G + 'self, ' + G + 'args)', {
+    filename: options.filename
+  });
+  var stepScript = new vm2.VMScript(G + 'gen[' + G + 'method](' + G + 'arg)', {
+    filename: options.filename
+  });
+  function isGenerator (o) {
+    return o && typeof o.next == 'function' && typeof o.throw == 'function';
+  }
+
+  // Drives a generator object to completion. Yielded values may be promises or
+  // other generator objects (`degenerator()` turns every user function into a
+  // generator, so `yield userFn()` yields a generator), which are driven
+  // recursively, like `co` does.
+  function drive (gen) {
+    return new Promise(function (resolve, reject) {
+      step('next', undefined);
+
+      function step (method, arg) {
+        var res;
+        try {
+          sandbox.setGlobal(G + 'gen', gen);
+          sandbox.setGlobal(G + 'method', method);
+          sandbox.setGlobal(G + 'arg', arg);
+          res = sandbox.run(stepScript);
+        } catch (err) {
+          return reject(err);
+        }
+        if (res.done) return resolve(res.value);
+        var value = res.value;
+        (isGenerator(value) ? drive(value) : Promise.resolve(value)).then(function (val) {
+          step('next', val);
+        }, function (err) {
+          step('throw', err);
+        });
+      }
+    });
+  }
+
+  var r = function () {
+    var self = this;
+    var args = arguments;
+    var ret;
+    try {
+      sandbox.setGlobal(G + 'fn', fn);
+      sandbox.setGlobal(G + 'self', self);
+      sandbox.setGlobal(G + 'args', Array.prototype.slice.call(args));
+      ret = sandbox.run(callScript);
+    } catch (err) {
+      return Promise.reject(err);
+    }
+    return isGenerator(ret) ? drive(ret) : Promise.resolve(ret);
+  };
+  Object.defineProperty(r, 'toString', {
+    value: fn.toString.bind(fn),
+    enumerable: false
+  });
+  return r;
+}
