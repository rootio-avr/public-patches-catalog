   });
 
+  describe('compile()', function () {
+
+    it('should compile a function that returns a Promise', function () {
+      var a = function () { return 'a'; };
+      var b = function () { return 'b'; };
+      function aPlusB () {
+        return a() + b();
+      }
+      var fn = degenerator.compile('' + aPlusB, 'aPlusB', ['a'], {
+        sandbox: { a: a, b: b }
+      });
+      return fn().then(function (val) {
+        assert.equal(val, 'ab');
+      });
+    });
+
+    it('should resolve `undefined` return values', function () {
+      var fn = degenerator.compile('function foo () {}', 'foo', []);
+      return fn().then(function (val) {
+        assert.strictEqual(val, undefined);
+      });
+    });
+
+    it('should throw an Error if no function is returned from the sandbox', function () {
+      var err;
+      try {
+        degenerator.compile('var foo = 1', 'foo', []);
+      } catch (_err) {
+        err = _err;
+      }
+      assert(err);
+      assert.equal(err.message, 'Expected a "function" to be returned for `foo`, but got "number"');
+    });
+
+    it('should prevent privilege escalation of untrusted code', function () {
+      var fn = degenerator.compile(
+        'var f = this.constructor.constructor("return process");',
+        'f',
+        []
+      );
+      return fn().then(function () {
+        throw new Error('expected the sandbox escape to fail');
+      }, function (err) {
+        assert.equal(err.message, 'process is not defined');
+      });
+    });
+
+    it('should enforce the `timeout` option when the returned function is called', function () {
+      this.timeout(5000);
+      var fn = degenerator.compile('function w () { while (true) {} }', 'w', [], {
+        timeout: 200
+      });
+      return fn().then(function () {
+        throw new Error('expected the infinite loop to time out');
+      }, function (err) {
+        assert.equal(err.message, 'Script execution timed out after 200ms');
+      });
+    });
+
+    it('should drive generators yielded by other degenerated functions', function () {
