+/*
+ * Regression test for CVE-2026-46681 (@nevware21/ts-utils)
+ * Prototype-pollution / object-poisoning hardening of objCopyProps / objDeepCopy.
+ *
+ * This package publishes only compiled output (dist/), so the test exercises the
+ * published entry point rather than the TypeScript sources. It uses only the
+ * Node.js built-in assert module so it runs without any test framework:
+ *     node test/cve-2026-46681.test.js
+ */
+"use strict";
+
+var assert = require("assert");
+var tsUtils = require("../dist/es5/main/ts-utils.js");
+
+function testCopyPropsSkipsDangerousOwnKey() {
+    var src = JSON.parse("{\"a\":1,\"b\":2}");
+    src.constructor = "EVIL";
+    var target = {};
+    tsUtils.objCopyProps(target, src);
+
+    assert.strictEqual(target.a, 1, "safe key a is copied");
+    assert.strictEqual(target.b, 2, "safe key b is copied");
+    assert.strictEqual(
+        Object.prototype.hasOwnProperty.call(target, "constructor"),
+        false,
+        "dangerous own key 'constructor' must not be copied onto target"
+    );
+}
+
+function testCopyPropsNoProtoPollution() {
+    var src = JSON.parse("{\"a\":1,\"__proto__\":{\"polluted\":\"yes\"}}");
+    var target = {};
+    tsUtils.objCopyProps(target, src);
+
+    assert.strictEqual(({}).polluted, undefined, "Object.prototype must not be polluted");
+    assert.strictEqual(target.a, 1, "safe key a is still copied");
+}
+
+function testDeepCopyNoProtoPollution() {
+    var src = JSON.parse("{\"a\":1,\"__proto__\":{\"pollutedDeep\":\"yes\"}}");
+    var result = tsUtils.objDeepCopy(src);
+
+    assert.strictEqual(result.a, 1, "safe properties are still copied");
+    assert.strictEqual(({}).pollutedDeep, undefined, "Object.prototype must not be polluted");
+}
+
+testCopyPropsSkipsDangerousOwnKey();
+testCopyPropsNoProtoPollution();
+testDeepCopyNoProtoPollution();
+
+console.log("CVE-2026-46681 regression test passed");
