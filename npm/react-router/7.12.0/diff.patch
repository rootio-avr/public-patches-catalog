+// Regression test for GHSA-qwww-vcr4-c8h2 (CWE-352, CSRF bypass in unstable RSC codepaths).
+//
+// Upstream fix commit 7a71c728ad116bd78699a258b2014ce9585729f5 ("harden RSC CSRF
+// codepaths", PR #15311) hardens generateRenderResponse() in the RSC server bundle so
+// that when throwIfPotentialCSRFAttack() detects a potential CSRF mutation request it is
+// caught, routed through onError, downgraded to a GET (dropping the mutation), and the
+// server-action processing block is gated behind the ABSENCE of that CSRF error. This
+// ensures a cross-origin POST can never invoke a server action (upstream integration test
+// "does not call actions on cross-origin document POST requests").
+//
+// The published npm package for react-router@7.12.0 ships only compiled bundles (no
+// source tree and no RSC test harness), and the RSC server entry cannot be exercised in a
+// plain node process (it requires the "react-server" export condition plus a full RSC
+// server pipeline). This test therefore asserts, on the shipped bundles, that the
+// hardening is present and the pre-fix unguarded codepath is gone -- which is exactly the
+// behavior the upstream integration test validates.
+const assert = require("node:assert");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const bundles = [
+  "dist/development/index-react-server.js",
+  "dist/production/index-react-server.js",
+  "dist/development/index-react-server.mjs",
+  "dist/production/index-react-server.mjs",
+];
+
+const pkgRoot = path.resolve(__dirname, "..");
+let checked = 0;
+
+for (const rel of bundles) {
+  const file = path.join(pkgRoot, rel);
+  if (!fs.existsSync(file)) {
+    // Bundle layout differs; skip missing files rather than failing spuriously.
+    continue;
+  }
+  checked++;
+  const src = fs.readFileSync(file, "utf8");
+
+  // The CSRF check must exist in this bundle.
+  assert.ok(
+    src.includes("throwIfPotentialCSRFAttack"),
+    `${rel}: expected throwIfPotentialCSRFAttack to be present`,
+  );
+
+  // Fix marker 1: a detected CSRF attack is captured, not left to throw uncaught,
+  // and recorded so the action block can be skipped.
+  assert.ok(
+    src.includes("potentialCSRFAttackError"),
+    `${rel}: missing CSRF error capture (potentialCSRFAttackError) from the fix`,
+  );
+
+  // Fix marker 2: the offending request is downgraded to a safe GET, dropping the
+  // mutation payload so no server action can run against it.
+  assert.ok(
+    /method:\s*"GET"/.test(src),
+    `${rel}: missing GET downgrade of the CSRF-flagged request`,
+  );
+
+  // Fix marker 3: the server-action processing block is gated behind the ABSENCE of a
+  // CSRF error -- this is the core of the bypass fix.
+  assert.ok(
+    /if\s*\(\s*!\s*potentialCSRFAttackError\s*\)/.test(src),
+    `${rel}: server-action block is not gated behind (!potentialCSRFAttackError)`,
+  );
+
+  // Pre-fix vulnerable shape: throwIfPotentialCSRFAttack immediately followed by an
+  // unconditional runningAction/processServerAction call (no intervening try/catch guard).
+  // That exact unguarded sequence must no longer be present.
+  const idx = src.indexOf("throwIfPotentialCSRFAttack(request.headers");
+  if (idx !== -1) {
+    const after = src.slice(idx, idx + 200);
+    const unguarded =
+      /throwIfPotentialCSRFAttack\(request\.headers[^;]*\);\s*ctx\.runningAction\s*=\s*true;/.test(
+        after,
+      );
+    assert.ok(
+      !unguarded,
+      `${rel}: found pre-fix unguarded CSRF codepath (action runs even on CSRF detection)`,
+    );
+  }
+}
+
+assert.ok(checked > 0, "expected at least one RSC server bundle to be checked");
+console.log(
+  `GHSA-qwww-vcr4-c8h2 regression test passed (${checked} RSC bundle(s) hardened).`,
+);
