@@ -0,0 +1,61 @@
+// Regression test for GHSA-qwww-vcr4-c8h2 — harden RSC CSRF codepaths.
+//
+// Upstream fix commit 7a71c728ad116bd78699a258b2014ce9585729f5 hardens the RSC
+// server request handler (packages/react-router/lib/rsc/server.rsc.ts) so that
+// when throwIfPotentialCSRFAttack() rejects a cross-origin mutation request the
+// handler (a) reports the error via onError, (b) downgrades the request to a
+// safe GET so the server action is never invoked, and (c) guards the action
+// codepath behind `if (!potentialCSRFAttackError)`. The vulnerable build ran
+// the action first and only special-cased the CSRF error afterwards via
+// `skipRevalidation || !!potentialCSRFAttackError`.
+//
+// react-router ships dist-only (compiled) artifacts on npm, and the fixed
+// closure is not exported, so the upstream Playwright integration test
+// (integration/rsc-csrf-action-test.ts) cannot be executed here. This is a
+// grounded structural regression check over the shipped RSC bundles.
+
+const assert = require("node:assert");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const bundles = [
+  "dist/development/index-react-server.js",
+  "dist/production/index-react-server.js",
+  "dist/development/index-react-server.mjs",
+  "dist/production/index-react-server.mjs",
+];
+
+for (const rel of bundles) {
+  const file = path.join(__dirname, "..", rel);
+  const src = fs.readFileSync(file, "utf8");
+
+  // The CSRF codepath must still exist in this bundle.
+  assert.ok(
+    src.includes("throwIfPotentialCSRFAttack(request.headers, allowedActionOrigins)"),
+    `${rel}: CSRF guard call missing`,
+  );
+
+  // Fixed: on CSRF rejection the request is downgraded to a safe GET so the
+  // action never runs, and the error is surfaced through onError.
+  assert.ok(
+    /catch \(error\) \{\s*onError\?\.\(error\);\s*potentialCSRFAttackError = error;\s*request = new Request\(request\.url, \{\s*method: "GET"/.test(
+      src,
+    ),
+    `${rel}: CSRF rejection does not downgrade request to GET / report via onError`,
+  );
+
+  // Fixed: the action codepath is guarded so it is skipped on a CSRF error.
+  assert.ok(
+    src.includes("if (!potentialCSRFAttackError) {"),
+    `${rel}: action codepath is not guarded by !potentialCSRFAttackError`,
+  );
+
+  // Vulnerable predicate must be gone: the handler no longer relies on
+  // running the action and then filtering matches when a CSRF error exists.
+  assert.ok(
+    !src.includes("skipRevalidation || !!potentialCSRFAttackError"),
+    `${rel}: vulnerable "skipRevalidation || !!potentialCSRFAttackError" predicate still present`,
+  );
+}
+
+console.log("GHSA-qwww-vcr4-c8h2 RSC CSRF hardening regression test passed");
