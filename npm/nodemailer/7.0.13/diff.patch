+/* eslint no-unused-vars: 0 */
+
+'use strict';
+
+const { describe, it } = require('node:test');
+const assert = require('node:assert');
+const MailComposer = require('../lib/mail-composer');
+
+// Regression test for GHSA-h3hj-cmcx-xc66 (CWE-73): MailComposer.compile()
+// built the root MimeNode for a message-level `raw` option without threading
+// the disableFileAccess / disableUrlAccess flags, so `raw: { path }` and
+// `raw: { href }` were read/fetched even when an application set those flags
+// to sandbox untrusted input (local file disclosure + SSRF).
+describe('GHSA-h3hj-cmcx-xc66 raw message file/url access enforcement', () => {
+    it('should not load raw message from file when disableFileAccess is set', (t, done) => {
+        let data = {
+            raw: {
+                path: __dirname + '/mail-composer/fixtures/attachment.bin'
+            },
+            disableFileAccess: true
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(err, 'expected build to reject with disableFileAccess set');
+            assert.ok(!message, 'expected no message to be produced');
+            done();
+        });
+    });
+
+    it('should not fetch raw message from url when disableUrlAccess is set', (t, done) => {
+        let data = {
+            raw: {
+                href: 'http://localhost:1/raw'
+            },
+            disableUrlAccess: true
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(err, 'expected build to reject with disableUrlAccess set');
+            assert.ok(!message, 'expected no message to be produced');
+            done();
+        });
+    });
+});

