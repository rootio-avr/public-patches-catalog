+'use strict';
+
+// Regression test for GHSA-h3hj-cmcx-xc66 (nodemailer)
+// MailComposer.compile() built the root MimeNode for a message-level `raw`
+// option without threading the disableFileAccess / disableUrlAccess flags, so
+// `raw: { path }` / `raw: { href }` were read/fetched even when an application
+// set those flags to sandbox untrusted input (local-file disclosure + SSRF).
+// The fix threads both flags onto the raw root node; these tests assert the
+// flags are now enforced for the raw message option.
+
+const { describe, it } = require('node:test');
+const assert = require('node:assert/strict');
+const MailComposer = require('../lib/mail-composer');
+
+describe('GHSA-h3hj-cmcx-xc66: raw message respects access flags', () => {
+    it('rejects raw:{path} with EFILEACCESS when disableFileAccess is set', (t, done) => {
+        let data = {
+            raw: {
+                path: __dirname + '/does-not-need-to-exist.bin'
+            },
+            disableFileAccess: true
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(err, 'expected an error when file access is disabled');
+            assert.strictEqual(err.code, 'EFILEACCESS');
+            assert.ok(!message);
+            done();
+        });
+    });
+
+    it('rejects raw:{href} with EURLACCESS when disableUrlAccess is set', (t, done) => {
+        let data = {
+            raw: {
+                href: 'http://localhost:1/raw'
+            },
+            disableUrlAccess: true
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(err, 'expected an error when url access is disabled');
+            assert.strictEqual(err.code, 'EURLACCESS');
+            assert.ok(!message);
+            done();
+        });
+    });
+});

