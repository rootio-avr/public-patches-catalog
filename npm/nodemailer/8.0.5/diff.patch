+'use strict';
+
+const { describe, it } = require('node:test');
+const assert = require('node:assert/strict');
+const MailComposer = require('../../lib/mail-composer');
+
+// Regression test for CVE-2026-82659 (GHSA-p6gq-j5cr-w38f)
+// MailComposer.compile() built the root MimeNode for a message-level `raw`
+// option without threading the disableFileAccess / disableUrlAccess flags,
+// so `raw: { path }` / `raw: { href }` was read/fetched even when an
+// application set those flags to sandbox untrusted input (local-file
+// disclosure and full-response SSRF). The fix threads both flags onto the
+// raw root node so _getStream() enforces them.
+describe('CVE-2026-82659 raw message file/url access enforcement', () => {
+    it('should load raw message from file when access is not restricted', (t, done) => {
+        let data = {
+            raw: {
+                path: __dirname + '/fixtures/attachment.bin'
+            }
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(!err);
+            // raw content is emitted verbatim (not base64-encoded like an attachment)
+            assert.ok(message.toString().includes('õkva'));
+            done();
+        });
+    });
+
+    it('should not load raw message from file if disableFileAccess is set', (t, done) => {
+        let data = {
+            raw: {
+                path: __dirname + '/fixtures/attachment.bin'
+            },
+            disableFileAccess: true
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(err);
+            assert.strictEqual(err.code, 'EFILEACCESS');
+            assert.ok(!message);
+            done();
+        });
+    });
+
+    it('should not load raw message from url if disableUrlAccess is set', (t, done) => {
+        let data = {
+            raw: {
+                href: 'http://localhost:1/raw'
+            },
+            disableUrlAccess: true
+        };
+
+        let mail = new MailComposer(data).compile();
+        mail.build((err, message) => {
+            assert.ok(err);
+            assert.strictEqual(err.code, 'EURLACCESS');
+            assert.ok(!message);
+            done();
+        });
+    });
+});

