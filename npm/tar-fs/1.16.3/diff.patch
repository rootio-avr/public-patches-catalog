+test('no symlink targets outside of extraction directory', function (t) {
+  if (win32) return t.end()
+
+  var out = path.join(__dirname, 'fixtures', 'invalid')
+
+  rimraf.sync(out)
+
+  var s = tarStream.pack()
+
+  s.entry({
+    type: 'symlink',
+    name: 'escape',
+    linkname: '../../outside'
+  })
+
+  s.finalize()
+
+  s.pipe(tar.extract(out))
+    .on('error', function (err) {
+      t.ok(/is not a valid symlink/i.test(err.message), 'had error')
+      t.throws(function () {
+        fs.lstatSync(path.join(out, 'escape'))
+      }, 'symlink was not created')
+      t.end()
+    })
+    .on('finish', function () {
+      t.fail('should not have extracted the symlink')
+      t.end()
+    })
+})
+
+test('no hardlink targets resolving outside of extraction directory', function (t) {
+  if (win32) return t.end()
+
+  var out = path.join(__dirname, 'fixtures', 'invalid')
+  var outside = path.join(__dirname, 'fixtures', 'outside')
+
+  rimraf.sync(out)
+
+  var s = tarStream.pack()
+
+  fs.writeFileSync(outside, 'something')
+  fs.mkdirSync(out)
+  fs.symlinkSync(outside, path.join(out, 'sym'))
+
+  s.entry({
+    type: 'link',
+    name: 'link',
+    linkname: 'sym'
+  })
+
+  s.entry({
+    name: 'link'
+  }, 'overwrite')
+
+  s.finalize()
+
+  s.pipe(tar.extract(out))
+    .on('error', function (err) {
+      t.ok(/is not a valid hardlink/i.test(err.message), 'had error')
+      fs.readFile(outside, 'utf-8', function (err, str) {
+        t.error(err, 'no error')
+        t.same(str, 'something')
+        t.end()
+      })
+    })
+    .on('finish', function () {
+      t.fail('should not have extracted the hardlink')
+      t.end()
+    })
+})
+
+test('reject symlink into predictable sibling prefix of cwd', function (t) {
+  if (win32) return t.end()
+
+  var base = path.join(__dirname, 'fixtures')
+  var out = path.join(base, 'prefix-out')
+  var sibling = path.join(base, 'prefix-out-evil')
+
+  rimraf.sync(out)
+  rimraf.sync(sibling)
+  fs.mkdirSync(sibling)
+  fs.writeFileSync(path.join(sibling, 'secret'), 'keep')
+
+  var s = tarStream.pack()
+  s.entry({
+    type: 'symlink',
+    name: 'escape',
+    linkname: '../prefix-out-evil/secret'
+  })
+  s.finalize()
+
+  s.pipe(tar.extract(out))
+    .on('error', function (err) {
+      t.ok(/is not a valid symlink/i.test(err.message), 'had error')
+      t.same(fs.readFileSync(path.join(sibling, 'secret'), 'utf-8'), 'keep')
+      rimraf.sync(out)
+      rimraf.sync(sibling)
+      t.end()
+    })
+    .on('finish', function () {
+      t.fail('prefix sibling symlink should be rejected')
+      rimraf.sync(out)
+      rimraf.sync(sibling)
+      t.end()
+    })
+})
