Fix CVE-2025-48387: hardlink extraction path traversal (CWE-22)

tar-fs's extract() created hardlinks whose source path was only sanitized
lexically via path.join(cwd, path.join('/', header.linkname)). A crafted
archive could point a hardlink at a symlink that had been (or could be)
resolved to a location outside the extraction directory, letting an attacker
create a hardlink to an arbitrary file on disk.

Backport of upstream commit 266194b94b5ab0b6c2ad2739e4247970dbd1e7ba
("hardlink tweak from main", released in tar-fs 2.1.3): resolve the hardlink
source with fs.realpath and reject any target that does not resolve inside the
extraction cwd before creating the link.

A regression test is added that extracts a hardlink pointing through an
escaping symlink and asserts the extraction is rejected.

--- a/index.js
+++ b/index.js
@@ -272,13 +272,17 @@ exports.extract = function (cwd, opts) {
       xfs.unlink(name, function () {
         var srcpath = path.join(cwd, path.join('/', header.linkname))

-        xfs.link(srcpath, name, function (err) {
-          if (err && err.code === 'EPERM' && opts.hardlinkAsFilesFallback) {
-            stream = xfs.createReadStream(srcpath)
-            return onfile()
-          }
+        xfs.realpath(srcpath, function (err, dst) {
+          if (err || !dst.startsWith(path.resolve(cwd))) return next(new Error(name + ' is not a valid hardlink'))

-          stat(err)
+          xfs.link(dst, name, function (err) {
+            if (err && err.code === 'EPERM' && opts.hardlinkAsFilesFallback) {
+              stream = xfs.createReadStream(srcpath)
+              return onfile()
+            }
+
+            stat(err)
+          })
         })
       })
     }
--- a/test/index.js
+++ b/test/index.js
@@ -344,3 +344,38 @@ test('no abs hardlink targets', function (t) {
       })
     })
 })
+
+test('hardlink may not resolve outside cwd via symlink (CVE-2025-48387)', function (t) {
+  if (win32) { // no symlink support on win32 currently
+    t.end()
+    return
+  }
+
+  var out = path.join(__dirname, 'fixtures', 'cve-48387')
+  var outside = path.join(__dirname, 'fixtures', 'cve-48387-secret')
+
+  rimraf.sync(out)
+  rimraf.sync(outside)
+  fs.mkdirSync(out, { recursive: true })
+  fs.writeFileSync(outside, 'secret')
+  // a symlink inside the extraction dir that points outside it
+  fs.symlinkSync(path.join('..', 'cve-48387-secret'), path.join(out, 'escape'))
+
+  var s = tarStream.pack()
+
+  s.entry({
+    type: 'link',
+    name: 'pwn',
+    linkname: 'escape'
+  })
+
+  s.finalize()
+
+  var errored = false
+  s.pipe(tar.extract(out))
+    .on('error', function (err) {
+      errored = true
+      t.ok(/is not a valid hardlink/i.test(err.message), 'rejected escaping hardlink')
+      t.end()
+    })
+    .on('finish', function () {
+      if (!errored) {
+        t.fail('extraction of escaping hardlink should have been rejected')
+        t.end()
+      }
+    })
+})

