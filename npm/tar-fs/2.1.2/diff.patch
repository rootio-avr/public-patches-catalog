+test('symlink cannot escape cwd (CVE-2025-59343)', function (t) {
+  if (win32) {
+    t.end() // no symlink support on win32 currently
+    return
+  }
+
+  var out = path.join(__dirname, 'fixtures', 'cve-2025-59343-symlink')
+
+  rimraf.sync(out)
+
+  var s = tarStream.pack()
+
+  // A symlink whose target resolves outside of cwd must be rejected.
+  s.entry({
+    type: 'symlink',
+    name: 'escape',
+    linkname: '../../../../../../tmp/tar-fs-escape'
+  })
+
+  s.finalize()
+
+  s.pipe(tar.extract(out))
+    .on('error', function (err) {
+      t.ok(err, 'had error')
+      t.ok(/is not a valid symlink/i.test(err.message), 'symlink rejected')
+      fs.lstat(path.join(out, 'escape'), function (err) {
+        t.ok(err, 'no symlink created')
+        t.end()
+      })
+    })
+    .on('finish', function () {
+      t.fail('extraction should not have finished')
+      t.end()
+    })
+})
+
+test('hardlink cannot escape cwd (CVE-2025-59343)', function (t) {
+  if (win32) {
+    t.end() // no hardlink support on win32 currently
+    return
+  }
+
+  var out = path.join(__dirname, 'fixtures', 'cve-2025-59343-hardlink')
+  var outside = path.join(__dirname, 'fixtures', 'cve-2025-59343-outside')
+
+  rimraf.sync(out)
+  fs.writeFileSync(outside, 'secret')
+
+  var s = tarStream.pack()
+
+  // Hardlink target pointing outside of cwd must be rejected.
+  s.entry({
+    type: 'link',
+    name: 'link',
+    linkname: path.relative(out, outside)
+  })
+
+  s.finalize()
+
+  s.pipe(tar.extract(out))
+    .on('error', function (err) {
+      t.ok(err, 'had error')
+      t.ok(/is not a valid hardlink/i.test(err.message), 'hardlink rejected')
+      fs.readFile(outside, 'utf-8', function (err, str) {
+        t.error(err, 'target still present')
+        t.same(str, 'secret', 'target not modified')
+        t.end()
+      })
+    })
+    .on('finish', function () {
+      t.fail('extraction should not have finished')
+      t.end()
+    })
+})
