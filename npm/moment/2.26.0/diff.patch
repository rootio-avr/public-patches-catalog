--- /dev/null
+++ b/src/test/moment/cve-2022-24785.js
@@ -0,0 +1,40 @@
+import { module, test } from '../qunit';
+import moment from '../../moment';
+
+module('cve-2022-24785');
+
+test('path-looking locale names are not loaded from fs', function (assert) {
+    // Regression test for CVE-2022-24785 (path traversal via locale name).
+    // A locale name containing path separators must never trigger a require
+    // from the filesystem; moment should fall back to the current locale.
+    var current = moment.locale();
+
+    [
+        './../../../file',
+        '../evil',
+        '..\\evil',
+        'foo/bar',
+        'foo\\bar',
+        '/etc/passwd',
+    ].forEach(function (bad) {
+        moment.locale(bad);
+        assert.equal(
+            moment.locale(),
+            current,
+            'malicious locale name "' +
+                bad +
+                '" should be ignored and locale left unchanged'
+        );
+    });
+
+    // Sanity: a well-formed (though non-existent) name is still handled
+    // gracefully without changing the active locale.
+    moment.locale('does-not-exist');
+    assert.equal(
+        moment.locale(),
+        current,
+        'unknown but sane locale name leaves locale unchanged'
+    );
+
+    moment.locale(current);
+});
