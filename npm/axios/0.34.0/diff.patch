+var assert = require('assert');
+var http = require('http');
+var axios = require('../../../index');
+
+function startServer(handler) {
+  return new Promise(function (resolve) {
+    var server = http.createServer(handler);
+    server.listen(0, '127.0.0.1', function () {
+      resolve(server);
+    });
+  });
+}
+
+function stopServer(server) {
+  return new Promise(function (resolve) {
+    server.close(resolve);
+  });
+}
+
+describe('adapters::http sensitiveHeaders (AIKIDO-2026-291630)', function () {
+  it('strips sensitiveHeaders on cross-origin redirect', function () {
+    var captured;
+    var destination;
+    var origin;
+
+    return startServer(function (req, res) {
+      captured = req.headers;
+      res.end('ok');
+    }).then(function (server) {
+      destination = server;
+      return startServer(function (req, res) {
+        res.statusCode = 302;
+        res.setHeader('Location', 'http://127.0.0.1:' + destination.address().port + '/dest');
+        res.end();
+      });
+    }).then(function (server) {
+      origin = server;
+      return axios.get('http://127.0.0.1:' + origin.address().port + '/src', {
+        maxRedirects: 5,
+        headers: {'X-Api-Key': 'secret', 'X-Other': 'keep'},
+        sensitiveHeaders: ['x-api-key']
+      });
+    }).then(function () {
+      assert.strictEqual(captured['x-api-key'], undefined);
+      assert.strictEqual(captured['x-other'], 'keep');
+      return Promise.all([stopServer(origin), stopServer(destination)]);
+    }, function (err) {
+      return Promise.all([stopServer(origin), stopServer(destination)]).then(function () {
+        throw err;
+      });
+    });
+  });
+
+  it('preserves sensitiveHeaders on same-origin redirect', function () {
+    var captured;
+    var count = 0;
+    var server;
+
+    return startServer(function (req, res) {
+      count++;
+      if (count === 1) {
+        res.statusCode = 302;
+        res.setHeader('Location', '/dest');
+        res.end();
+      } else {
+        captured = req.headers;
+        res.end('ok');
+      }
+    }).then(function (s) {
+      server = s;
+      return axios.get('http://127.0.0.1:' + server.address().port + '/src', {
+        maxRedirects: 5,
+        headers: {'X-API-Key': 'secret'},
+        sensitiveHeaders: ['X-API-Key']
+      });
+    }).then(function () {
+      assert.strictEqual(captured['x-api-key'], 'secret');
+      return stopServer(server);
+    }, function (err) {
+      return stopServer(server).then(function () {
+        throw err;
+      });
+    });
+  });
+
+  it('rejects invalid sensitiveHeaders config', function () {
+    return axios.get('http://127.0.0.1:1/', {sensitiveHeaders: 'X-API-Key'}).then(function () {
+      assert.fail('expected rejection');
+    }, function (err) {
+      assert.strictEqual(err.code, 'ERR_BAD_OPTION_VALUE');
+      assert.strictEqual(err.message, 'sensitiveHeaders must be an array of strings');
+      return axios.get('http://127.0.0.1:1/', {sensitiveHeaders: [null]}).then(function () {
+        assert.fail('expected rejection');
+      }, function (err2) {
+        assert.strictEqual(err2.code, 'ERR_BAD_OPTION_VALUE');
+      });
+    });
+  });
+});
