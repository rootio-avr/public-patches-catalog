+++ b/test/unit/regression/GHSA-gcfj-64vw-6mp9.js
@@ -0,0 +1,131 @@
+'use strict';
+
+// Regression test for GHSA-gcfj-64vw-6mp9 (CWE-1321 / CWE-200):
+// improve request config handling so that Object.prototype pollution can no
+// longer inject request config values, and so that deeply nested / recursive
+// FormData structures cannot be used to exhaust resources.
+//
+// Authored fresh against the axios@0.31.1 target tree (the published npm tarball
+// layout) because the upstream fix commit's test/ hunks were written against the
+// git repo layout. Mirrors the assertions of upstream commit
+// 1417285c69344bbcc6420a021f67dee0c6fedb2d (PR #11001).
+
+var assert = require('assert');
+var buildURL = require('../../../lib/helpers/buildURL');
+var formDataToJSON = require('../../../lib/helpers/formDataToJSON');
+var shouldBypassProxy = require('../../../lib/helpers/shouldBypassProxy');
+var AxiosError = require('../../../lib/core/AxiosError');
+
+describe('GHSA-gcfj-64vw-6mp9 request config handling', function () {
+  describe('buildURL prototype-safe options', function () {
+    afterEach(function () {
+      delete Object.prototype.encode;
+      delete Object.prototype.serialize;
+    });
+
+    it('should not read `encode`/`serialize` inherited from Object.prototype', function () {
+      var called = false;
+      Object.prototype.serialize = function () {
+        called = true;
+        return 'polluted=1';
+      };
+      Object.prototype.encode = function () {
+        called = true;
+        return 'polluted';
+      };
+
+      // options is an empty own-property object: inherited keys must be ignored.
+      var result = buildURL('/api', { foo: 'bar' }, {});
+
+      assert.strictEqual(called, false, 'inherited serialize/encode must not be invoked');
+      assert.strictEqual(result, '/api?foo=bar');
+    });
+
+    it('should still honour an own `serialize` option', function () {
+      var result = buildURL('/api', { foo: 'bar' }, {
+        serialize: function () { return 'x=1'; }
+      });
+      assert.strictEqual(result, '/api?x=1');
+    });
+
+    it('should treat a function options argument as the serializer', function () {
+      var result = buildURL('/api', { foo: 'bar' }, function () {
+        return 'serialized=yes';
+      });
+      assert.strictEqual(result, '/api?serialized=yes');
+    });
+  });
+
+  describe('formDataToJSON depth guard', function () {
+    // Minimal FormData-like object that satisfies utils.isFormData():
+    // it must NOT inherit directly from Object.prototype, must expose an
+    // `append`/`entries` function, iterate via Symbol.iterator, and stringify
+    // to '[object FormData]'.
+    function MockFormData() {
+      this._entries = [];
+    }
+    MockFormData.prototype.append = function (name, value) {
+      this._entries.push([name, value]);
+    };
+    MockFormData.prototype.entries = function () {
+      return this._entries.slice();
+    };
+    MockFormData.prototype.toString = function () {
+      return '[object FormData]';
+    };
+    MockFormData.prototype[Symbol.iterator] = function () {
+      var entries = this._entries;
+      var index = 0;
+      return {
+        next: function () {
+          return index < entries.length
+            ? { value: entries[index++], done: false }
+            : { value: undefined, done: true };
+        }
+      };
+    };
+
+    it('should throw ERR_FORM_DATA_DEPTH_EXCEEDED for excessively nested keys', function () {
+      // Build a key with > 100 levels of nesting: a[0][0]...[0]
+      var name = 'a';
+      for (var i = 0; i < 130; i++) {
+        name += '[0]';
+      }
+
+      var formData = new MockFormData();
+      formData.append(name, 'value');
+
+      assert.throws(function () {
+        formDataToJSON(formData);
+      }, function (err) {
+        return err instanceof AxiosError && err.code === AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED;
+      });
+    });
+
+    it('should still parse a shallow FormData structure', function () {
+      var formData = new MockFormData();
+      formData.append('user[name]', 'Bob');
+      formData.append('user[age]', '30');
+
+      var obj = formDataToJSON(formData);
+      assert.strictEqual(obj.user.name, 'Bob');
+      assert.strictEqual(obj.user.age, '30');
+    });
+  });
+
+  describe('shouldBypassProxy loopback', function () {
+    it('should treat 0.0.0.0 as a loopback host (no_proxy bypass)', function () {
+      var original = process.env.no_proxy;
+      process.env.no_proxy = 'localhost';
+      try {
+        assert.strictEqual(shouldBypassProxy('http://0.0.0.0/'), true);
+      } finally {
+        if (original === undefined) {
+          delete process.env.no_proxy;
+        } else {
+          process.env.no_proxy = original;
+        }
+      }
+    });
+  });
+});
