+// Regression test for CVE-2026-44496 (axios browser cookie helper).
+//
+// The vulnerable lib/helpers/cookies.js read() built a RegExp by interpolating
+// the requested cookie name directly: new RegExp('(?:^|; )' + name + '=([^;]*)').
+// An attacker-influenced name containing regex metacharacters could match the
+// wrong cookie or trigger catastrophic backtracking (ReDoS). The fix matches the
+// name by splitting on ';' and comparing the name literally.
+//
+// The cookie helper selects its browser implementation at import time based on
+// platform.hasStandardBrowserEnv, so we install a minimal standard-browser env
+// (window/document, no react-native navigator) before dynamically importing it.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+function makeDocument(cookieString) {
+  let store = cookieString;
+  return {
+    get cookie() {
+      return store;
+    },
+    set cookie(v) {
+      // Minimal browser-like append: "name=value; attrs" -> keep name=value pair.
+      const pair = String(v).split(';')[0];
+      store = store ? store + '; ' + pair : pair;
+    },
+  };
+}
+
+async function loadCookies(cookieString) {
+  globalThis.window = globalThis.window || {};
+  globalThis.navigator = undefined;
+  globalThis.document = makeDocument(cookieString);
+  const mod = await import('../lib/helpers/cookies.js');
+  return mod.default;
+}
+
+test('reads cookies when the separator has no following space', async () => {
+  const cookies = await loadCookies('foo=abc;bar=def');
+  assert.equal(cookies.read('bar'), 'def');
+});
+
+test('matches cookie names exactly even when the name contains regex metacharacters', async () => {
+  // "X.Y" must not match a cookie called "XAY"; a literal comparison rejects it.
+  const cookies = await loadCookies('XAY=wrong');
+  assert.equal(cookies.read('X.Y'), null);
+});
+
+test('does not return a partial match for a name that is a prefix of another cookie', async () => {
+  const cookies = await loadCookies('xsrf-token-extra=wrong');
+  assert.equal(cookies.read('xsrf-token'), null);
+});
+
+test('still reads a normally-named cookie', async () => {
+  const cookies = await loadCookies('foo=abc; xsrf-token=good');
+  assert.equal(cookies.read('xsrf-token'), 'good');
+});

