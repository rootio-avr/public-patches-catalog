+import axios from '../../../index.js';
+import assert from 'assert';
+
+// Regression test for GHSA-mmx7-hfxf-jppx
+// Prototype-polluted config properties must not leak into requests. Bodyless
+// method aliases (get/delete/head/options) and the http adapter read
+// config.data / auth / paramsSerializer / proxy via own-property guards, so a
+// value injected onto Object.prototype must be ignored.
+describe('GHSA-mmx7-hfxf-jppx prototype pollution protection', function () {
+  afterEach(function () {
+    delete Object.prototype.data;
+  });
+
+  it('should not copy inherited data into bodyless request aliases', function () {
+    Object.prototype.data = 'polluted';
+
+    return axios.get('/users', {
+      adapter: function adapter(config) {
+        assert.strictEqual(config.data, undefined);
+
+        return Promise.resolve({
+          data: null,
+          status: 200,
+          statusText: 'OK',
+          headers: {},
+          config: config,
+        });
+      },
+    });
+  });
+
+  it('should still honor an explicitly provided data value', function () {
+    Object.prototype.data = 'polluted';
+
+    return axios.get('/users', {
+      data: 'explicit',
+      adapter: function adapter(config) {
+        assert.strictEqual(config.data, 'explicit');
+
+        return Promise.resolve({
+          data: null,
+          status: 200,
+          statusText: 'OK',
+          headers: {},
+          config: config,
+        });
+      },
+    });
+  });
+});

