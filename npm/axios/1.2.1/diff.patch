+import assert from 'assert';
+import buildURL from '../../../lib/helpers/buildURL.js';
+
+describe('GHSA-7q8q-rj6j-mhjq pollution-safe config reads', function () {
+  afterEach(function () {
+    delete Object.prototype.serialize;
+    delete Object.prototype.encode;
+    delete Object.prototype.username;
+    delete Object.prototype.password;
+  });
+
+  it('ignores a polluted Object.prototype.serialize', function () {
+    let called = false;
+    Object.prototype.serialize = function () {
+      called = true;
+      return 'hijacked=1';
+    };
+
+    const result = buildURL('/api', { a: 1 }, {});
+    assert.strictEqual(called, false);
+    assert.strictEqual(result.indexOf('hijacked') === -1, true);
+    assert.strictEqual(result, '/api?a=1');
+  });
+
+  it('still honors an own serialize function', function () {
+    const result = buildURL('/api', { a: 1 }, {
+      serialize: function () {
+        return 'own=1';
+      }
+    });
+    assert.strictEqual(result, '/api?own=1');
+  });
+
+  it('still honors options passed as a serializer function', function () {
+    const result = buildURL('/api', { a: 1 }, function () {
+      return 'fn=1';
+    });
+    assert.strictEqual(result, '/api?fn=1');
+  });
+});
