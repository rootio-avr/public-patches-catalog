+
+describe('formDataToJSON depth guard (GHSA-42h9-826w-cgv3)', function () {
+  it('throws AxiosError when a field path exceeds the default depth limit', function () {
+    const formData = new FormData();
+    formData.append('foo' + '[bar]'.repeat(101), '123');
+
+    let error;
+    try {
+      formDataToJSON(formData);
+    } catch (err) {
+      error = err;
+    }
+
+    assert.ok(error instanceof AxiosError);
+    assert.strictEqual(error.code, AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    assert.ok(!(error instanceof RangeError));
+  });
+
