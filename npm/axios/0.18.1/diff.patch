Description: Fix CVE-2026-42035 - FormData/prototype-pollution header gadget
 Harden FormData detection and only trust getHeaders on real FormData-like
 values. Merge-config own-property hardening is intentionally omitted here
 because it is already supplied by CVE-2026-42033, which runs earlier in this
 hook's ordered patch set.
Origin: backport
Forwarded: not-needed
Last-Update: 2026-06-23

--- a/lib/utils.js
+++ b/lib/utils.js
@@ -53,9 +53,18 @@
  * @param {Object} val The value to test
  * @returns {boolean} True if value is an FormData, otherwise false
  */
 function isFormData(val) {
-  return (typeof FormData !== 'undefined') && (val instanceof FormData);
+  if (!val) return false;
+  if (typeof FormData !== 'undefined' && val instanceof FormData) return true;
+  // Reject non-objects and plain objects inheriting from Object.prototype
+  // to prevent prototype pollution gadgets from spoofing FormData.
+  if (typeof val !== 'object') return false;
+  var proto = Object.getPrototypeOf(val);
+  if (!proto || proto === Object.prototype) return false;
+  if (typeof val.append !== 'function') return false;
+  return toString.call(val) === '[object FormData]' ||
+    (typeof val.toString === 'function' && val.toString() === '[object FormData]');
 }
 
