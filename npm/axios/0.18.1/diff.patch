+'use strict';
+
+// Regression test for CVE-2026-42033: config values must not be inherited
+// from a polluted Object.prototype.
+var assert = require('assert');
+var http = require('http');
+var utils = require('../lib/utils');
+var axios = require('../index');
+
+function cleanup() {
+  delete Object.prototype.transport;
+  delete Object.prototype.polluted;
+}
+
+// utils.hasOwnProperty only reports own properties
+assert.strictEqual(utils.hasOwnProperty({a: 1}, 'a'), true);
+assert.strictEqual(utils.hasOwnProperty({}, 'toString'), false);
+assert.strictEqual(utils.hasOwnProperty(null, 'a'), false);
+
+// utils.merge must not read inherited values or copy inherited keys
+Object.prototype.polluted = {leak: true};
+try {
+  var merged = utils.merge({}, {polluted: {own: true}});
+  assert.strictEqual(utils.hasOwnProperty(merged.polluted, 'leak'), false);
+  assert.strictEqual(merged.polluted.own, true);
+  assert.strictEqual(utils.hasOwnProperty(utils.merge({}, {}), 'polluted'), false);
+} finally {
+  cleanup();
+}
+
+// A "__proto__" key must not change the prototype of the merged result
+var evil = JSON.parse('{"__proto__": {"transport": "evil"}}');
+assert.strictEqual(utils.merge({}, evil).transport, undefined);
+
+// The http adapter must ignore an inherited "transport"
+var server = http.createServer(function (req, res) {
+  res.end('ok');
+});
+
+server.listen(0, '127.0.0.1', function () {
+  var hijacked = false;
+  Object.prototype.transport = {
+    request: function () {
+      hijacked = true;
+      throw new Error('inherited transport was used');
+    }
+  };
+
+  axios.get('http://127.0.0.1:' + server.address().port + '/', {adapter: require('../lib/adapters/http')})
+    .then(function (res) {
+      cleanup();
+      assert.strictEqual(hijacked, false);
+      assert.strictEqual(res.data, 'ok');
+      console.log('cve-2026-42033: ok');
+      server.close();
+    })
+    .catch(function (err) {
+      cleanup();
+      server.close();
+      console.error(err);
+      process.exit(1);
+    });
+});

