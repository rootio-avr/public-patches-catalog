+var http = require('http');
+var axios = require('../index');
+
+var proxySeen = [];
+var targetSeen = [];
+
+var target = http.createServer(function (req, res) {
+  targetSeen.push(req.headers);
+  res.end('ok');
+});
+
+target.listen(0, '127.0.0.1', function () {
+  var targetPort = target.address().port;
+  var proxy = http.createServer(function (req, res) {
+    proxySeen.push(req.headers);
+    res.statusCode = 302;
+    res.setHeader('Location', 'http://127.0.0.1:' + targetPort + '/final');
+    res.end();
+  });
+
+  proxy.listen(0, '127.0.0.1', function () {
+    axios.get('http://example.invalid/start', {
+      proxy: {
+        host: '127.0.0.1',
+        port: proxy.address().port,
+        auth: {username: 'user', password: 'secret'}
+      }
+    }).then(function (response) {
+      assert.strictEqual(response.data, 'ok');
+      assert.strictEqual(proxySeen.length, 1);
+      assert.ok(proxySeen[0]['proxy-authorization'], 'proxy should receive Proxy-Authorization');
+      assert.strictEqual(targetSeen.length, 1);
+      assert.strictEqual(targetSeen[0]['proxy-authorization'], undefined,
+        'redirect target must not receive Proxy-Authorization');
+      console.log('CVE-2026-44487 regression test passed');
+    }).then(function () {
+      proxy.close();
+      target.close();
+    }, function (err) {
+      proxy.close();
+      target.close();
+      console.error(err);
+      process.exit(1);
+    });
+  });
+});

