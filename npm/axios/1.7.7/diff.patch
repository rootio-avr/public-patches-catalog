+// Regression test for CVE-2026-42264 (GHSA-q8qp-cvcw-x6jj)
+// Prototype pollution: mergeConfig must build its result on a null-prototype
+// object so a polluted Object.prototype cannot leak inherited values into
+// the merged config.
+import assert from 'assert';
+import mergeConfig from '../../../lib/core/mergeConfig.js';
+
+describe('CVE-2026-42264: mergeConfig prototype-pollution hardening', function () {
+  afterEach(function () {
+    delete Object.prototype.insecureHTTPParser;
+    delete Object.prototype.polluted;
+  });
+
+  it('does not inherit polluted Object.prototype values', function () {
+    // eslint-disable-next-line no-extend-native
+    Object.prototype.polluted = 'attacker-controlled';
+    // eslint-disable-next-line no-extend-native
+    Object.prototype.insecureHTTPParser = true;
+
+    const merged = mergeConfig({}, {});
+
+    // A plain-object result would inherit these; a null-prototype result must not.
+    assert.strictEqual(merged.polluted, undefined);
+    assert.strictEqual(merged.insecureHTTPParser, undefined);
+    assert.strictEqual(Object.getPrototypeOf(merged), null);
+  });
+
+  it('still merges explicitly provided values', function () {
+    const merged = mergeConfig({ timeout: 1000 }, { baseURL: 'https://example.com' });
+    assert.strictEqual(merged.timeout, 1000);
+    assert.strictEqual(merged.baseURL, 'https://example.com');
+  });
+});

