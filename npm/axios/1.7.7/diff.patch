+// Regression test for CVE-2026-25639: prototype pollution in axios
+// via utils.merge() and mergeConfig() when handling __proto__ /
+// constructor / prototype keys.
+import assert from 'node:assert';
+import utils from '../lib/utils.js';
+import mergeConfig from '../lib/core/mergeConfig.js';
+
+// utils.merge must not pollute Object.prototype through __proto__.
+{
+  const before = ({}).polluted;
+  const malicious = JSON.parse('{"__proto__": {"polluted": "yes"}}');
+  const result = utils.merge({}, malicious);
+  assert.strictEqual(({}).polluted, before,
+    'Object.prototype must not be polluted by utils.merge');
+  assert.strictEqual(Object.prototype.polluted, undefined,
+    'Object.prototype.polluted must remain undefined');
+  // The dangerous own key must be dropped from the result too.
+  assert.ok(!Object.prototype.hasOwnProperty.call(result, '__proto__'),
+    'result must not carry an own __proto__ property');
+}
+
+// mergeConfig must not pollute Object.prototype through __proto__.
+{
+  const malicious = JSON.parse('{"__proto__": {"polluted": "cfg"}}');
+  mergeConfig({}, malicious);
+  assert.strictEqual(({}).polluted, undefined,
+    'Object.prototype must not be polluted by mergeConfig');
+}
+
+// Sanity: normal keys still merge correctly.
+{
+  const merged = utils.merge({ a: 1 }, { b: 2 });
+  assert.strictEqual(merged.a, 1);
+  assert.strictEqual(merged.b, 2);
+}
+
+console.log('CVE-2026-25639 regression test passed');

