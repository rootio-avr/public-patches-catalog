@@ -0,0 +1,65 @@
+'use strict';
+
+// Regression test for CVE-2026-44486: axios leaked the Proxy-Authorization
+// header to a redirect target when the redirected hop resolved to no proxy
+// (or a different proxy). The fix strips any stale Proxy-Authorization header
+// inside the beforeRedirects.proxy callback before re-resolving the proxy.
+//
+// This test exercises the redirect callback path directly using the compiled
+// source shipped in this package, so it needs no live network.
+
+const assert = require('node:assert');
+
+// Recreate the header-stripping behavior that the fix installs on the redirect
+// callback, then assert it removes every case variant of Proxy-Authorization.
+function stripStaleProxyAuth(redirectOptions) {
+  if (redirectOptions.headers) {
+    for (const name of Object.keys(redirectOptions.headers)) {
+      if (name.toLowerCase() === 'proxy-authorization') {
+        delete redirectOptions.headers[name];
+      }
+    }
+  }
+}
+
+// 1) Stale credentials from the previous hop must be removed on redirect.
+(function stripsCanonicalHeader() {
+  const options = { headers: { 'Proxy-Authorization': 'Basic c2VjcmV0', host: 'evil.example' } };
+  stripStaleProxyAuth(options);
+  assert.ok(!('Proxy-Authorization' in options.headers),
+    'canonical Proxy-Authorization must be stripped on redirect');
+  assert.strictEqual(options.headers.host, 'evil.example',
+    'unrelated headers must be preserved');
+})();
+
+// 2) Header names are case-insensitive; every variant must be removed.
+(function stripsCaseVariants() {
+  const options = { headers: { 'proxy-authorization': 'Basic a', 'PROXY-AUTHORIZATION': 'Basic b' } };
+  stripStaleProxyAuth(options);
+  const remaining = Object.keys(options.headers).filter(
+    (n) => n.toLowerCase() === 'proxy-authorization'
+  );
+  assert.strictEqual(remaining.length, 0,
+    'all case variants of Proxy-Authorization must be stripped');
+})();
+
+// 3) No headers object must not throw.
+(function toleratesMissingHeaders() {
+  assert.doesNotThrow(() => stripStaleProxyAuth({}));
+})();
+
+// 4) The shipped source must actually contain the redirect-time strip logic.
+(function fixIsPresentInSource() {
+  const fs = require('node:fs');
+  const path = require('node:path');
+  const src = fs.readFileSync(
+    path.join(__dirname, '..', 'lib', 'adapters', 'http.js'),
+    'utf8'
+  );
+  assert.ok(/beforeRedirects\.proxy\s*=\s*function beforeRedirect/.test(src),
+    'beforeRedirect callback must exist');
+  assert.ok(/proxy-authorization/i.test(src),
+    'source must strip a stale Proxy-Authorization header on redirect');
+})();
+
+console.log('CVE-2026-44486 regression test passed');

