+// Regression test for CVE-2026-44488 (GHSA-777c-7fjr-54vf):
+// the fetch adapter did not enforce maxContentLength / maxBodyLength.
+// Grounded in the upstream test added by fix commit e5540dca
+// (tests/unit/adapters/fetch.test.js). Uses a local HTTP server + data: URLs
+// so it runs without network access.
+import assert from 'assert';
+import http from 'http';
+import axios from '../../../index.js';
+
+const runIf = (typeof fetch === 'function' ? describe : describe.skip);
+
+runIf('CVE-2026-44488 fetch adapter size limits', function () {
+  this.timeout(30000);
+
+  const fetchAxios = axios.create({ adapter: 'fetch' });
+
+  const startServer = (handler) =>
+    new Promise((resolve) => {
+      const server = http.createServer(handler);
+      server.listen(0, '127.0.0.1', () => resolve(server));
+    });
+
+  const stopServer = (server) =>
+    new Promise((resolve) => server.close(() => resolve()));
+
+  const urlFor = (server) => {
+    const { port } = server.address();
+    return `http://127.0.0.1:${port}/`;
+  };
+
+  it('rejects an outbound body exceeding maxBodyLength with ERR_BAD_REQUEST', async () => {
+    const server = await startServer((req, res) => res.end('ok'));
+    try {
+      await assert.rejects(
+        fetchAxios.post(urlFor(server), 'A'.repeat(2048), { maxBodyLength: 1024 }),
+        (err) => {
+          assert.strictEqual(err.code, 'ERR_BAD_REQUEST');
+          assert.match(err.message, /Request body larger than maxBodyLength limit/);
+          return true;
+        }
+      );
+    } finally {
+      await stopServer(server);
+    }
+  });
+
+  it('rejects a response whose Content-Length exceeds maxContentLength with ERR_BAD_RESPONSE', async () => {
+    const payload = 'A'.repeat(8 * 1024);
+    const server = await startServer((req, res) => {
+      res.setHeader('Content-Length', Buffer.byteLength(payload));
+      res.end(payload);
+    });
+    try {
+      await assert.rejects(
+        fetchAxios.get(urlFor(server), { maxContentLength: 1024 }),
+        (err) => {
+          assert.strictEqual(err.code, 'ERR_BAD_RESPONSE');
+          assert.match(err.message, /maxContentLength size of 1024 exceeded/);
+          return true;
+        }
+      );
+    } finally {
+      await stopServer(server);
+    }
+  });
