+import assert from 'assert';
+import mergeConfig from '../../lib/core/mergeConfig.js';
+
+// Regression test for CVE-2026-42033.
+// mergeConfig / the default transformers must read config values via
+// own-property checks (utils.hasOwnProp) rather than `in` / dotted access,
+// so that prototype-pollution gadgets planted on Object.prototype cannot
+// leak into a merged request config.
+describe('CVE-2026-42033: mergeConfig ignores inherited (polluted) properties', () => {
+  afterEach(() => {
+    // Clean up any prototype pollution introduced by a test.
+    delete Object.prototype.polluted;
+    delete Object.prototype.baseURL;
+  });
+
+  it('does not pull an inherited property into the merged config', () => {
+    // eslint-disable-next-line no-extend-native
+    Object.prototype.polluted = 'evil';
+
+    const merged = mergeConfig({}, {});
+
+    assert.strictEqual(
+      Object.prototype.hasOwnProperty.call(merged, 'polluted'),
+      false,
+      'inherited (prototype) key must not become an own key of the merged config'
+    );
+  });
+
+  it('does not let a polluted prototype override an explicit own value', () => {
+    // eslint-disable-next-line no-extend-native
+    Object.prototype.baseURL = 'https://attacker.example';
+
+    const merged = mergeConfig({baseURL: 'https://safe.example'}, {});
+
+    assert.strictEqual(
+      merged.baseURL,
+      'https://safe.example',
+      'own value must win; inherited prototype value must be ignored'
+    );
+  });
+
+  it('still merges legitimate own properties', () => {
+    const merged = mergeConfig({timeout: 1000}, {timeout: 2000});
+    assert.strictEqual(merged.timeout, 2000);
+  });
+});

