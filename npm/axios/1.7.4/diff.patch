+// Regression test for CVE-2026-42264 (GHSA-q8qp-cvcw-x6jj)
+// Prototype pollution read-side gadgets in axios config handling.
+// The fix makes mergeConfig return a null-prototype object and reads config
+// values via own-property checks so a polluted Object.prototype cannot leak
+// attacker-controlled defaults (e.g. baseURL, auth, insecureHTTPParser).
+import assert from 'node:assert';
+import mergeConfig from '../lib/core/mergeConfig.js';
+
+function run(name, fn) {
+  try {
+    fn();
+    console.log('ok - ' + name);
+  } catch (e) {
+    console.error('not ok - ' + name);
+    throw e;
+  }
+}
+
+run('merged config does not inherit polluted Object.prototype values', () => {
+  // eslint-disable-next-line no-extend-native
+  Object.prototype.polluted = 'evil.example.com';
+  try {
+    const merged = mergeConfig({}, {});
+    // A null-prototype (or own-only) config must not surface the polluted key.
+    assert.strictEqual(
+      merged.polluted,
+      undefined,
+      'merged config must not inherit polluted prototype properties'
+    );
+    assert.strictEqual(
+      Object.prototype.hasOwnProperty.call(merged, 'polluted'),
+      false,
+      'merged config must not own the polluted key'
+    );
+  } finally {
+    delete Object.prototype.polluted;
+  }
+});
+
+run('hasOwnProperty remains callable on merged config', () => {
+  const merged = mergeConfig({}, {a: 1});
+  assert.strictEqual(typeof merged.hasOwnProperty, 'function');
+  assert.strictEqual(merged.hasOwnProperty('a'), true);
+});
+
+run('legitimate own config values still merge through', () => {
+  const merged = mergeConfig({timeout: 100}, {timeout: 200});
+  assert.strictEqual(merged.timeout, 200);
+});
+
+console.log('CVE-2026-42264 regression tests passed');

