+// Regression test for CVE-2026-25639: prototype pollution in axios
+// via utils.merge() and mergeConfig(). The fix skips the dangerous
+// property names __proto__/constructor/prototype during merge.
+import assert from 'assert';
+import utils from '../lib/utils.js';
+import mergeConfig from '../lib/core/mergeConfig.js';
+
+describe('CVE-2026-25639 prototype pollution', function () {
+  afterEach(function () {
+    // Ensure no test leaves the global Object prototype polluted.
+    delete Object.prototype.polluted;
+  });
+
+  it('utils.merge() must not pollute Object.prototype via __proto__', function () {
+    const malicious = JSON.parse('{"__proto__": {"polluted": "yes"}}');
+    const result = utils.merge({}, malicious);
+    assert.strictEqual({}.polluted, undefined, 'Object.prototype was polluted');
+    assert.strictEqual(result.polluted, undefined);
+  });
+
+  it('utils.merge() must not copy constructor/prototype keys', function () {
+    const malicious = JSON.parse('{"constructor": {"prototype": {"polluted": "yes"}}}');
+    const result = utils.merge({}, malicious);
+    assert.strictEqual({}.polluted, undefined);
+    assert.ok(!Object.prototype.hasOwnProperty('polluted'));
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'constructor'), false);
+  });
+
+  it('mergeConfig() must not pollute Object.prototype via __proto__', function () {
+    const malicious = JSON.parse('{"__proto__": {"polluted": "yes"}}');
+    mergeConfig({}, malicious);
+    assert.strictEqual({}.polluted, undefined, 'Object.prototype was polluted via mergeConfig');
+  });
+
+  it('utils.merge() still merges safe keys normally', function () {
+    const result = utils.merge({ a: 1 }, { b: 2 });
+    assert.strictEqual(result.a, 1);
+    assert.strictEqual(result.b, 2);
+  });
+});

