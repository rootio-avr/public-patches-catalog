+// Regression test for CVE-2026-44486: axios leaked the Proxy-Authorization
+// header to the redirect target when a request was redirected. The fix strips
+// any stale Proxy-Authorization header inside the beforeRedirects.proxy hook
+// before the proxy is recomputed for the new destination.
+import assert from 'node:assert';
+import {__setProxy} from '../lib/adapters/http.js';
+
+function makeOptions(headers) {
+  return {
+    headers,
+    hostname: 'origin.example',
+    port: 443,
+    beforeRedirects: {},
+  };
+}
+
+// 1. Initial call with no proxy installs the beforeRedirects.proxy hook.
+const options = makeOptions({'Proxy-Authorization': 'Basic c3RhbGU6Y3JlZA=='});
+__setProxy(options, false, 'https://origin.example/');
+assert.strictEqual(
+  typeof options.beforeRedirects.proxy,
+  'function',
+  'setProxy must install a beforeRedirects.proxy hook'
+);
+
+// 2. On redirect (invoking the hook) the stale Proxy-Authorization header must
+//    be removed, regardless of header-name casing, before re-applying proxy.
+const redirectOptions = makeOptions({'proxy-authorization': 'Basic c3RhbGU6Y3JlZA=='});
+redirectOptions.href = 'https://attacker.example/';
+options.beforeRedirects.proxy(redirectOptions);
+const remaining = Object.keys(redirectOptions.headers)
+  .filter((n) => n.toLowerCase() === 'proxy-authorization');
+assert.strictEqual(
+  remaining.length,
+  0,
+  'stale Proxy-Authorization header must be stripped on redirect'
+);
+
+console.log('CVE-2026-44486 regression test passed');

