--- a/test/unit/adapters/ghsa-mwf2-3pr3-8698.test.js
+++ b/test/unit/adapters/ghsa-mwf2-3pr3-8698.test.js
@@ -0,0 +1,111 @@
+// Regression test for GHSA-mwf2-3pr3-8698.
+//
+// Streamed request bodies must be capped by config.maxBodyLength on every
+// transport that does not enforce the limit itself. Before the fix, the
+// byte-counting wrapper was only present on the follow-redirects transport,
+// so a streamed body sent over the native http/https transport (selected via
+// maxRedirects: 0) — the same code path exercised by HTTP/2 streamed uploads —
+// bypassed maxBodyLength entirely and the oversized payload reached the server.
+//
+// This test is self-contained (no shared helpers) so it runs against the
+// published npm tarball layout as well as the upstream git tree.
+import axios from '../../../index.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+import http from 'http';
+import stream from 'stream';
+import assert from 'assert';
+
+describe('GHSA-mwf2-3pr3-8698: maxBodyLength on streamed uploads', function () {
+  let server;
+
+  afterEach(function (done) {
+    if (server) {
+      server.close(() => {
+        server = null;
+        done();
+      });
+    } else {
+      done();
+    }
+  });
+
+  it('rejects a streamed body larger than maxBodyLength on the native transport', function (done) {
+    let bytesReceived = 0;
+
+    server = http
+      .createServer((req, res) => {
+        req.on('data', (chunk) => {
+          bytesReceived += chunk.length;
+        });
+        req.on('error', () => {});
+        req.on('end', () => {
+          res.end('OK');
+        });
+      })
+      .listen(4446, async function (listenErr) {
+        if (listenErr) {
+          return done(listenErr);
+        }
+
+        const limit = 1024;
+        const payload = Buffer.alloc(2 * 1024 * 1024, 0x63);
+        const source = stream.Readable.from([payload]);
+
+        try {
+          await axios.post('http://localhost:4446/', source, {
+            // maxRedirects: 0 selects the native http transport, which does
+            // not self-enforce maxBodyLength — the vulnerable path.
+            maxRedirects: 0,
+            maxBodyLength: limit,
+            headers: { 'Content-Type': 'application/octet-stream' },
+          });
+          return done(new Error('request should have been rejected'));
+        } catch (error) {
+          try {
+            assert.strictEqual(
+              error.message,
+              'Request body larger than maxBodyLength limit'
+            );
+            assert.strictEqual(error.code, AxiosError.ERR_BAD_REQUEST);
+            assert.ok(
+              bytesReceived <= limit * 4,
+              `server should not receive full payload; got ${bytesReceived}`
+            );
+            return done();
+          } catch (assertionError) {
+            return done(assertionError);
+          }
+        }
+      });
+  });
+
+  it('allows a streamed body within maxBodyLength on the native transport', function (done) {
+    server = http
+      .createServer((req, res) => {
+        req.on('data', () => {});
+        req.on('end', () => {
+          res.end('OK');
+        });
+      })
+      .listen(4447, async function (listenErr) {
+        if (listenErr) {
+          return done(listenErr);
+        }
+
+        const payload = Buffer.alloc(512, 0x63);
+        const source = stream.Readable.from([payload]);
+
+        try {
+          const res = await axios.post('http://localhost:4447/', source, {
+            maxRedirects: 0,
+            maxBodyLength: 1024,
+            headers: { 'Content-Type': 'application/octet-stream' },
+          });
+          assert.strictEqual(res.data, 'OK');
+          return done();
+        } catch (error) {
+          return done(error);
+        }
+      });
+  });
+});

