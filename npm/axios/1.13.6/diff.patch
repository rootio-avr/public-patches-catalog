+// Regression test for GHSA-mmx7-hfxf-jppx (CWE-1321): bodyless method aliases
+// (axios.get/delete/head/options) must not transmit an inherited `data`
+// property from a prototype-polluted config object.
+
+import assert from 'assert';
+import Axios from '../../../lib/core/Axios.js';
+
+describe('GHSA-mmx7-hfxf-jppx bodyless alias data reads', function () {
+  afterEach(function () {
+    delete Object.prototype.data;
+  });
+
+  it('does not copy inherited data onto bodyless method configs', function () {
+    Object.prototype.data = 'polluted-body';
+    const axios = new Axios({});
+    const captured = [];
+    axios.request = function (config) {
+      captured.push(config);
+      return Promise.resolve({ data: 'ok' });
+    };
+
+    axios.get('http://example.com/users', {});
+
+    assert.strictEqual(captured.length, 1);
+    assert.strictEqual(captured[0].data, undefined);
+  });
+
+  it('still honors an own data property on bodyless methods', function () {
+    const axios = new Axios({});
+    const captured = [];
+    axios.request = function (config) {
+      captured.push(config);
+      return Promise.resolve({ data: 'ok' });
+    };
+
+    axios.get('http://example.com/users', { data: 'own-body' });
+
+    assert.strictEqual(captured.length, 1);
+    assert.strictEqual(captured[0].data, 'own-body');
+  });
+});

