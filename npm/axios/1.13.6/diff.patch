+// Regression test for GHSA-jqh4-m9w3-8hp9
+// axios: malformed http(s) URLs missing "//" after the protocol were silently
+// normalized instead of being rejected. buildFullPath must now throw an
+// AxiosError with code ERR_INVALID_URL for such input.
+// Upstream fix: axios/axios@32fc489632377d214db55bfa4e2c48486a7d7ce2 (#11000)
+
+import buildFullPath from '../../../lib/core/buildFullPath.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+import assert from 'assert';
+
+describe('GHSA-jqh4-m9w3-8hp9 (malformed http urls)', function () {
+  function expectInvalidUrl(fn) {
+    let error;
+    try {
+      fn();
+    } catch (err) {
+      error = err;
+    }
+    assert.ok(error instanceof AxiosError, 'expected an AxiosError to be thrown');
+    assert.strictEqual(error.code, AxiosError.ERR_INVALID_URL);
+    assert.strictEqual(error.message, 'Invalid URL: missing "//" after protocol');
+  }
+
+  it('rejects HTTP(S) URLs missing slashes after the protocol', function () {
+    const malformed = [
+      'https:example.com/users',
+      '\thttps:example.com/users',
+      '\u0020https:example.com/users',
+      '\u0000https:example.com/users',
+      'h\nttp:example.com/users',
+      'ht\ttp:example.com/users',
+      'htt\rp:example.com/users',
+      'http:/example.com/users'
+    ];
+    malformed.forEach(function (url) {
+      expectInvalidUrl(function () {
+        buildFullPath(undefined, url);
+      });
+    });
+
+    // Malformed baseURL used for a relative request.
+    expectInvalidUrl(function () {
+      buildFullPath('http:example.com/api', '/users');
+    });
+  });
+
+  it('does not reject an unused malformed baseURL for absolute requests', function () {
+    assert.strictEqual(
+      buildFullPath('http:example.com/api', 'https://api.example.com/users'),
+      'https://api.example.com/users'
+    );
+  });
+
+  it('rejects a malformed baseURL when absolute requests are forced through baseURL', function () {
+    expectInvalidUrl(function () {
+      buildFullPath('http:example.com/api', 'https://api.example.com/users', false);
+    });
+  });
+
+  it('still accepts well-formed URLs', function () {
+    assert.strictEqual(
+      buildFullPath('https://api.github.com', '/users'),
+      'https://api.github.com/users'
+    );
+    assert.strictEqual(
+      buildFullPath(undefined, 'https://api.example.com/users'),
+      'https://api.example.com/users'
+    );
+  });
+});

