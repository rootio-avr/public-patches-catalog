+import assert from 'assert';
+import formDataToJSON from '../../../lib/helpers/formDataToJSON.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+
+// Regression test for GHSA-42h9-826w-cgv3 (CWE-400/674): a deeply nested
+// FormData field name caused unbounded recursion / resource exhaustion in
+// formDataToJSON. The fix adds a depth guard that throws an AxiosError
+// (ERR_FORM_DATA_DEPTH_EXCEEDED) instead of overflowing the stack.
+describe('formDataToJSON depth guard (GHSA-42h9-826w-cgv3)', () => {
+  it('should throw AxiosError when a field path exceeds the default depth limit', () => {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(101), '123');
+
+    let error;
+    try {
+      formDataToJSON(formData);
+    } catch (err) {
+      error = err;
+    }
+
+    assert.ok(error instanceof AxiosError, 'expected an AxiosError to be thrown');
+    assert.strictEqual(error.code, AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    assert.ok(!(error instanceof RangeError), 'should not be a stack overflow RangeError');
+  });
+
+  it('should throw AxiosError while tokenizing very deep field paths', () => {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(10000), '123');
+
+    let error;
+    try {
+      formDataToJSON(formData);
+    } catch (err) {
+      error = err;
+    }
+
+    assert.ok(error instanceof AxiosError, 'expected an AxiosError to be thrown');
+    assert.strictEqual(error.code, AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    assert.ok(!(error instanceof RangeError), 'should not be a stack overflow RangeError');
+  });
+
+  it('should convert a field path at the default depth limit', () => {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(100), '123');
+
+    let value = formDataToJSON(formData).foo;
+
+    for (let i = 0; i < 100; i++) {
+      value = value.bar;
+    }
+
+    assert.strictEqual(value, '123');
+  });
+});

