--- a/test/specs/helpers/ghsa-pmv8-rq9r-6j72.spec.js
+++ b/test/specs/helpers/ghsa-pmv8-rq9r-6j72.spec.js
@@ -0,0 +1,56 @@
+import formDataToJSON from '../../../lib/helpers/formDataToJSON';
+import AxiosError from '../../../lib/core/AxiosError';
+
+// Regression test for GHSA-pmv8-rq9r-6j72 (CWE-400 uncontrolled recursion DoS).
+// A FormData key with a very large number of bracket-delimited segments used to
+// recurse once per segment with no depth limit, exhausting the call stack
+// (RangeError: Maximum call stack size exceeded) and crashing the process.
+describe('formDataToJSON GHSA-pmv8-rq9r-6j72', function () {
+  it('should throw AxiosError when a field path exceeds the default depth limit', function () {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(101), '123');
+
+    let err;
+    try {
+      formDataToJSON(formData);
+    } catch (e) {
+      err = e;
+    }
+
+    expect(err instanceof AxiosError).toEqual(true);
+    expect(err.code).toEqual(AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    expect(err instanceof RangeError).toEqual(false);
+  });
+
+  it('should throw AxiosError while tokenizing very deep field paths', function () {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(15000), '123');
+
+    let err;
+    try {
+      formDataToJSON(formData);
+    } catch (e) {
+      err = e;
+    }
+
+    expect(err instanceof AxiosError).toEqual(true);
+    expect(err.code).toEqual(AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    expect(err instanceof RangeError).toEqual(false);
+  });
+
+  it('should convert a field path at the default depth limit', function () {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(100), '123');
+
+    let value = formDataToJSON(formData).foo;
+
+    for (let i = 0; i < 100; i++) {
+      value = value.bar;
+    }
+
+    expect(value).toEqual('123');
+  });
+});
