+function cve_2026_42038_isIPv4Loopback(host) {
+  if (!host) return false;
+  const parts = host.split('.');
+  if (parts.length !== 4) return false;
+  if (parts[0] !== '127') return false;
+  for (let i = 0; i < 4; i++) {
+    if (!/^\d+$/.test(parts[i])) return false;
+    const n = Number(parts[i]);
+    if (n < 0 || n > 255) return false;
+  }
+  return true;
+}
+
+function cve_2026_42038_isIPv6Loopback(host) {
+  if (!host) return false;
+  if (host === '::1') return true;
+
+  // IPv4-mapped IPv6 loopback: ::ffff:127.0.0.1
+  const v4MappedDotted = host.match(/^::ffff:(\d+\.\d+\.\d+\.\d+)$/i);
+  if (v4MappedDotted) return cve_2026_42038_isIPv4Loopback(v4MappedDotted[1]);
+
+  // Hex form Node sometimes normalises to: ::ffff:7f00:1
+  const v4MappedHex = host.match(/^::ffff:([0-9a-f]{1,4}):([0-9a-f]{1,4})$/i);
+  if (v4MappedHex) {
+    const high = parseInt(v4MappedHex[1], 16);
+    return high >= 0x7f00 && high <= 0x7fff;
+  }
+
+  // Full-form 0:0:0:0:0:0:0:1
+  const groups = host.split(':');
+  if (groups.length === 8) {
+    for (let i = 0; i < 7; i++) {
+      if (!/^0+$/.test(groups[i])) return false;
+    }
+    return /^0*1$/.test(groups[7]);
+  }
