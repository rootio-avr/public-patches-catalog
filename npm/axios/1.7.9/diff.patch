+// https://github.com/axios/axios (CVE-2026-42033, CWE-1321 Prototype Pollution)
+// Upstream fix: 42eb721eebc95cfded8d6c70cf62f3fbe83f3246
+//   "fix: replace in with has own prop util (#10761)"
+// Grounded in upstream tests/unit/prototypePollution.test.js, restricted to the
+// two gadgets that exist in axios 1.7.9's code surface:
+//   (a) mergeConfig.mergeDirectKeys used `prop in config` (traverses the
+//       prototype chain) for validateStatus.
+//   (b) http adapter read `config.transport` directly, picking up an inherited
+//       value from Object.prototype.
+// parseReviver / httpVersion / http2 gadgets are intentionally NOT tested here
+// because that code does not exist in 1.7.9.
+
+import axios from '../../../index.js';
+import mergeConfig from '../../../lib/core/mergeConfig.js';
+import defaults from '../../../lib/defaults/index.js';
+import http from 'http';
+import assert from 'assert';
+
+describe('Prototype Pollution Protection (CVE-2026-42033)', () => {
+  afterEach(() => {
+    // Clean up any pollution that might have occurred.
+    delete Object.prototype.validateStatus;
+    delete Object.prototype.transport;
+  });
+
+  // Gadget (a): mergeConfig.mergeDirectKeys must not inherit validateStatus from
+  // Object.prototype (was using the `in` operator which traverses the chain).
+  describe('mergeConfig validateStatus', () => {
+    it('should not inherit a polluted validateStatus during mergeConfig', () => {
+      Object.prototype.validateStatus = () => true;
+
+      const merged = mergeConfig(defaults, { url: '/x' });
+
+      assert.strictEqual(merged.validateStatus, defaults.validateStatus);
+    });
+
+    it('should keep 4xx responses rejected when Object.prototype.validateStatus is polluted', async () => {
+      Object.prototype.validateStatus = () => true;
+
+      const server = http.createServer((req, res) => {
+        res.writeHead(401, { 'Content-Type': 'application/json' });
+        res.end('{"error":"unauthorized"}');
+      });
+
+      await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+      const { port } = server.address();
+
+      try {
+        let threw = false;
+        try {
+          await axios.get(`http://127.0.0.1:${port}/`);
+        } catch (err) {
