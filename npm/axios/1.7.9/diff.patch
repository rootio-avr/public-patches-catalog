+// Regression tests for CVE-2026-42264 / GHSA-q8qp-cvcw-x6jj.
+//
+// Five config properties were read via direct property access in the http
+// adapter and resolveConfig, bypassing hasOwnProperty and allowing
+// prototype pollution gadgets (auth, baseURL, socketPath, beforeRedirect,
+// insecureHTTPParser). validator.assertOptions also looked up schema
+// entries through the prototype chain. This file backports a focused
+// subset of the upstream prototype-pollution test suite (originally
+// vitest, here ported to mocha) covering the gadgets that apply to this
+// release line.
+
+import axios from '../../../index.js';
+import http from 'http';
+import net from 'net';
+import assert from 'assert';
+import validator from '../../../lib/helpers/validator.js';
+import mergeConfig from '../../../lib/core/mergeConfig.js';
+
+describe('CVE-2026-42264 prototype pollution protection', function () {
+  this.timeout(15000);
+
+  afterEach(() => {
+    delete Object.prototype.auth;
+    delete Object.prototype.baseURL;
+    delete Object.prototype.socketPath;
+    delete Object.prototype.beforeRedirect;
+    delete Object.prototype.insecureHTTPParser;
+    delete Object.prototype.transport;
+    delete Object.prototype.polluted;
+  });
+
+  function startServer(handler) {
+    return new Promise((resolve) => {
+      const server = http.createServer(handler || ((req, res) => {
+        res.writeHead(200, { 'Content-Type': 'application/json' });
+        res.end(JSON.stringify({ headers: req.headers, url: req.url }));
+      }));
+      server.listen(0, '127.0.0.1', () => resolve(server));
+    });
+  }
+
+  function stopServer(server) {
+    return new Promise((resolve) => server.close(resolve));
+  }
+
+  describe('mergeConfig', () => {
+    it('produces a null-prototype config object', () => {
+      const merged = mergeConfig({}, { url: '/x' });
+      assert.strictEqual(Object.getPrototypeOf(merged), null);
+    });
+
+    it('does not pick up Object.prototype.auth via direct read', () => {
+      Object.prototype.auth = { username: 'attacker', password: 'exfil' };
+      const merged = mergeConfig({}, { url: '/x' });
+      // direct property access on a null-prototype object cannot inherit
+      assert.strictEqual(merged.auth, undefined);
+    });
+  });
+
+  describe('validator.assertOptions', () => {
+    it('does not resolve schema validators through Object.prototype', () => {
+      Object.prototype.polluted = 'not a function';
+      // Without the hasOwnProperty guard, schema[opt] would return the
+      // polluted string and assertOptions would treat it as a validator,
+      // throwing a TypeError. With the guard, the polluted key is
+      // treated as unknown and (with allowUnknown=true) ignored.
+      assert.doesNotThrow(() => {
+        validator.assertOptions({ polluted: 'value' }, {}, true);
+      });
+    });
+  });
+
+  describe('http adapter gadgets', () => {
+    it('does not pick up Object.prototype.auth as an Authorization header', async () => {
+      Object.prototype.auth = { username: 'attacker', password: 'exfil' };
+      const server = await startServer();
+      const { port } = server.address();
+      try {
+        const res = await axios.get(`http://127.0.0.1:${port}/api`);
+        assert.strictEqual(res.data.headers.authorization, undefined);
+      } finally {
+        await stopServer(server);
+      }
+    });
+
+    it('does not redirect via Object.prototype.socketPath', async () => {
+      Object.prototype.socketPath = '/tmp/axios-should-never-be-used.sock';
+      const server = await startServer();
+      const { port } = server.address();
+      try {
+        const res = await axios.get(`http://127.0.0.1:${port}/api`);
+        assert.strictEqual(res.status, 200);
+        assert.strictEqual(res.data.url, '/api');
+      } finally {
+        await stopServer(server);
+      }
+    });
+
+    it('does not invoke Object.prototype.beforeRedirect during redirects', async () => {
+      let hijackCalled = false;
+      Object.prototype.beforeRedirect = function polluted() {
+        hijackCalled = true;
+      };
+      const target = await startServer();
+      const { port: targetPort } = target.address();
+      const redirector = await startServer((req, res) => {
+        res.writeHead(302, { Location: `http://127.0.0.1:${targetPort}/final` });
+        res.end();
+      });
+      const { port: redirectorPort } = redirector.address();
+      try {
+        const res = await axios.get(`http://127.0.0.1:${redirectorPort}/start`);
+        assert.strictEqual(res.status, 200);
+        assert.strictEqual(hijackCalled, false);
+      } finally {
+        await stopServer(redirector);
+        await stopServer(target);
+      }
+    });
+
+    it('does not enable insecureHTTPParser via Object.prototype', async () => {
+      // A raw TCP server emits a response with LF-only line terminators.
+      // Node's strict HTTP parser rejects this with HPE_*; the insecure
+      // parser would accept it. If the gadget is properly blocked the
+      // request must fail with a parser error.
+      Object.prototype.insecureHTTPParser = true;
+      const malformedPayload =
+        'HTTP/1.1 200 OK\n' +
+        'Content-Type: application/json\n' +
+        'Content-Length: 2\n' +
+        '\n' +
+        '{}';
+      const malformed = await new Promise((resolve) => {
+        const srv = net.createServer((socket) => {
+          socket.once('data', () => socket.end(malformedPayload));
+        });
+        srv.listen(0, '127.0.0.1', () => resolve(srv));
+      });
+      const { port } = malformed.address();
+      try {
+        let threw = false;
+        let caughtCode = '';
+        try {
+          await axios.get(`http://127.0.0.1:${port}/`, {
+            transitional: { clarifyTimeoutError: false },
+          });
+        } catch (err) {
+          threw = true;
+          caughtCode = String(err && (err.code || err.message));
+        }
+        assert.strictEqual(threw, true,
+          `request should be rejected by the strict HTTP parser (got: ${caughtCode || 'success'})`);
+        assert.match(caughtCode, /^HPE_/,
+          `expected an HPE_* parser error, got: ${caughtCode}`);
+      } finally {
+        await new Promise((resolve) => malformed.close(resolve));
+      }
+    });
+  });
+
+  describe('resolveConfig baseURL gadget', () => {
+    it('does not hijack relative-URL requests via Object.prototype.baseURL', async () => {
+      let hijackHit = false;
+      const hijacker = await startServer(() => { hijackHit = true; });
+      const { port: hijackerPort } = hijacker.address();
+      Object.prototype.baseURL = `http://127.0.0.1:${hijackerPort}`;
+      try {
+        let threw = false;
+        try { await axios.get('/api'); } catch (_err) { threw = true; }
+        assert.strictEqual(hijackHit, false);
+        assert.strictEqual(threw, true);
+      } finally {
+        await stopServer(hijacker);
+      }
+    });
+  });
+});

