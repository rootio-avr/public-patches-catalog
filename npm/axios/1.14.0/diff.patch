--- /dev/null
+++ b/tests/unit/GHSA-jqh4-m9w3-8hp9.test.js
@@ -0,0 +1,86 @@
+import { describe, it, afterEach } from 'vitest';
+import assert from 'assert';
+import {
+  startHTTPServer,
+  stopHTTPServer,
+  makeReadableStream,
+  generateReadable,
+} from '../setup/server.js';
+import axios from '../../index.js';
+
+// Regression test for GHSA-jqh4-m9w3-8hp9 (CWE-770).
+//
+// CVE-2026-44488 added a known-size maxBodyLength check to the fetch adapter
+// but still skipped live WHATWG ReadableStream bodies whose size cannot be
+// determined before dispatch. This leftover counts those streams per-chunk.
+
+const SERVER_PORT = 8011;
+const LOCAL_SERVER_URL = `http://localhost:${SERVER_PORT}`;
+
+const fetchAxios = axios.create({
+  baseURL: LOCAL_SERVER_URL,
+  adapter: 'fetch',
+});
+
+describe.runIf(typeof fetch === 'function' && typeof ReadableStream === 'function')(
+  'GHSA-jqh4-m9w3-8hp9: fetch adapter streamed maxBodyLength',
+  () => {
+    let server;
+
+    afterEach(async () => {
+      await stopHTTPServer(server);
+      server = null;
+    });
+
+    it('should reject a streamed request body that exceeds maxBodyLength', async () => {
+      server = await startHTTPServer((req, res) => req.pipe(res), { port: SERVER_PORT });
+
+      await assert.rejects(
+        async () => {
+          await fetchAxios.post('/', makeReadableStream('chunk', 1000, 1), {
+            maxBodyLength: 1024,
+          });
+        },
+        (err) => {
+          assert.ok(axios.isAxiosError(err), 'expected an AxiosError');
+          assert.strictEqual(err.code, 'ERR_BAD_REQUEST');
+          assert.match(err.message, /Request body larger than maxBodyLength limit/);
+          return true;
+        }
+      );
+    });
+
+    it('should reject a response larger than maxContentLength', async () => {
+      server = await startHTTPServer(
+        (req, res) => {
+          generateReadable(1024 * 1024, 16 * 1024, 0).pipe(res);
+        },
+        { port: SERVER_PORT }
+      );
+
+      await assert.rejects(
+        async () => {
+          await fetchAxios.get('/', {
+            maxContentLength: 2000,
+          });
+        },
+        (err) => {
+          assert.ok(axios.isAxiosError(err), 'expected an AxiosError');
+          assert.strictEqual(err.code, 'ERR_BAD_RESPONSE');
+          assert.match(err.message, /maxContentLength size of 2000 exceeded/);
+          return true;
+        }
+      );
+    });
+
+    it('should not enforce limits when left at the default (-1)', async () => {
+      const payload = 'x'.repeat(64 * 1024);
+
+      server = await startHTTPServer((req, res) => res.end(payload), { port: SERVER_PORT });
+
+      const { data } = await fetchAxios.get('/');
+
+      assert.strictEqual(data, payload);
+    });
+  }
+);

