@@ -0,0 +1,58 @@
+import { describe, it, expect } from 'vitest';
+import formDataToJSON from '../../lib/helpers/formDataToJSON.js';
+import AxiosError from '../../lib/core/AxiosError.js';
+
+// Regression test for GHSA-pmv8-rq9r-6j72
+// Uncontrolled recursion / stack exhaustion (CWE-400) in formDataToJSON.
+// A FormData key with thousands of nested bracket segments used to exhaust
+// the JavaScript call stack. After the fix, such input is rejected with an
+// AxiosError whose code is ERR_FORM_DATA_DEPTH_EXCEEDED.
+describe('GHSA-pmv8-rq9r-6j72 - formDataToJSON depth guard', () => {
+  it('should reject a field path that exceeds the depth limit with an AxiosError', () => {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(101), '123');
+
+    let error;
+    try {
+      formDataToJSON(formData);
+    } catch (err) {
+      error = err;
+    }
+
+    expect(error).toBeInstanceOf(AxiosError);
+    expect(error.code).toBe(AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    expect(error).not.toBeInstanceOf(RangeError);
+  });
+
+  it('should reject a very deeply nested field path without a stack overflow', () => {
+    const formData = new FormData();
+
+    formData.append('a' + '[x]'.repeat(15000), 'value');
+
+    let error;
+    try {
+      formDataToJSON(formData);
+    } catch (err) {
+      error = err;
+    }
+
+    expect(error).toBeInstanceOf(AxiosError);
+    expect(error.code).toBe(AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED);
+    expect(error).not.toBeInstanceOf(RangeError);
+  });
+
+  it('should still convert a field path within the depth limit', () => {
+    const formData = new FormData();
+
+    formData.append('foo' + '[bar]'.repeat(100), '123');
+
+    let value = formDataToJSON(formData).foo;
+
+    for (let i = 0; i < 100; i++) {
+      value = value.bar;
+    }
+
+    expect(value).toBe('123');
+  });
+});
