@@ -0,0 +1,185 @@
+// Regression test for GHSA-7q8q-rj6j-mhjq (CWE-1321 prototype pollution).
+//
+// axios read several nested config values (auth.username/password, the
+// params serializer's encode/serialize options) via plain property access, so
+// a polluted Object.prototype could inject attacker-controlled credentials and
+// serializer behavior. The fix routes these reads through the pollution-safe
+// utils.getSafeProp()/utils.hasOwnInPrototypeChain() helpers. This test locks
+// that behavior in for the backport to axios 1.14.0.
+import { describe, it, expect, afterEach } from 'vitest';
+import utils from '../../lib/utils.js';
+import buildURL from '../../lib/helpers/buildURL.js';
+import resolveConfig from '../../lib/helpers/resolveConfig.js';
+
+describe('GHSA-7q8q-rj6j-mhjq: prototype-pollution-safe config reads', () => {
+  afterEach(() => {
+    delete Object.prototype.username;
+    delete Object.prototype.password;
+    delete Object.prototype.serialize;
+    delete Object.prototype.encode;
+    delete Object.prototype[Symbol.iterator];
+    delete Object.prototype[Symbol.toStringTag];
+  });
+
+  describe('utils.hasOwnInPrototypeChain / getSafeProp', () => {
+    it('ignores values injected onto Object.prototype', () => {
+      Object.defineProperty(Object.prototype, 'username', {
+        value: 'inherited-user',
+        configurable: true,
+      });
+
+      expect(utils.hasOwnInPrototypeChain({}, 'username')).toBe(false);
+      expect(utils.getSafeProp({}, 'username')).toBe(undefined);
+    });
+
+    it('honors genuine own properties', () => {
+      expect(utils.hasOwnInPrototypeChain({ a: 1 }, 'a')).toBe(true);
+      expect(utils.getSafeProp({ a: 1 }, 'a')).toBe(1);
+    });
+
+    it('honors members inherited from a non-Object.prototype source', () => {
+      const proto = { role: 'admin' };
+      const obj = Object.create(proto);
+      expect(utils.hasOwnInPrototypeChain(obj, 'role')).toBe(true);
+      expect(utils.getSafeProp(obj, 'role')).toBe('admin');
+    });
+
+    it('returns undefined for null/undefined sources', () => {
+      expect(utils.getSafeProp(null, 'x')).toBe(undefined);
+      expect(utils.getSafeProp(undefined, 'x')).toBe(undefined);
+    });
+
+    it('terminates on cyclic prototype chains', () => {
+      let calls = 0;
+      let proxy;
+      proxy = new Proxy(
+        {},
+        {
+          getPrototypeOf() {
+            calls += 1;
+            if (calls > 5) {
+              throw new Error('cycled');
+            }
+            return proxy;
+          },
+        }
+      );
+
+      expect(utils.hasOwnInPrototypeChain(proxy, 'missing')).toBe(false);
+      expect(utils.getSafeProp(proxy, 'missing')).toBe(undefined);
+      expect(calls).toBeLessThanOrEqual(2);
+    });
+  });
+
+  describe('utils.isPlainObject', () => {
+    it('ignores inherited symbol properties injected via pollution', () => {
+      Object.prototype[Symbol.iterator] = function* () {
+        yield ['x-injected', 'yes'];
+      };
+      Object.prototype[Symbol.toStringTag] = 'Custom';
+
+      expect(utils.isPlainObject({})).toBe(true);
+      expect(utils.isPlainObject([])).toBe(false);
+    });
+
+    it('treats an object with a genuinely inherited iterator as non-plain', () => {
+      const proto = Object.create(null);
+      proto[Symbol.iterator] = function* () {
+        yield ['x', '1'];
+      };
+      expect(utils.isPlainObject(Object.create(proto))).toBe(false);
+    });
+  });
+
+  describe('utils.isSafeIterable', () => {
+    it('does not treat a pollution-injected iterator as iterable', () => {
+      Object.prototype[Symbol.iterator] = function* () {
+        yield ['x', '1'];
+      };
+      expect(utils.isSafeIterable({})).toBe(false);
+    });
+
+    it('recognizes a genuine own iterator', () => {
+      const obj = {
+        *[Symbol.iterator]() {
+          yield 1;
+        },
+      };
+      expect(utils.isSafeIterable(obj)).toBe(true);
+    });
+  });
+
+  describe('buildURL', () => {
+    it('ignores inherited serializer options', () => {
+      let serializeInvoked = false;
+      let encodeInvoked = false;
+
+      Object.defineProperty(Object.prototype, 'serialize', {
+        value() {
+          serializeInvoked = true;
+          return 'inherited=1';
+        },
+        configurable: true,
+      });
+      Object.defineProperty(Object.prototype, 'encode', {
+        value() {
+          encodeInvoked = true;
+          return 'inherited';
+        },
+        configurable: true,
+      });
+
+      expect(buildURL('/foo', { value: 'a b' }, {})).toEqual('/foo?value=a+b');
+      expect(serializeInvoked).toBe(false);
+      expect(encodeInvoked).toBe(false);
+    });
+  });
+
+  describe('resolveConfig', () => {
+    it('ignores inherited nested auth fields', () => {
+      Object.defineProperty(Object.prototype, 'username', {
+        value: 'inherited-user',
+        configurable: true,
+      });
+      Object.defineProperty(Object.prototype, 'password', {
+        value: 'inherited-pass',
+        configurable: true,
+      });
+
+      const config = resolveConfig({ url: '/foo', auth: {} });
+
+      // Basic Og== is base64 of ":" -- i.e. empty username and password.
+      expect(config.headers.get('Authorization')).toEqual('Basic Og==');
+    });
+
+    it('ignores inherited nested serializer fields', () => {
+      let serializeInvoked = false;
+      let encodeInvoked = false;
+
+      Object.defineProperty(Object.prototype, 'serialize', {
+        value() {
+          serializeInvoked = true;
+          return 'inherited=1';
+        },
+        configurable: true,
+      });
+      Object.defineProperty(Object.prototype, 'encode', {
+        value() {
+          encodeInvoked = true;
+          return 'inherited';
+        },
+        configurable: true,
+      });
+
+      const config = resolveConfig({
+        url: '/foo',
+        params: { value: 'a b' },
+        paramsSerializer: {},
+      });
+
+      expect(config.url).toEqual('/foo?value=a+b');
+      expect(serializeInvoked).toBe(false);
+      expect(encodeInvoked).toBe(false);
+    });
+  });
+});

