diff --git a/tests/unit/GHSA-mwf2-3pr3-8698.test.js b/tests/unit/GHSA-mwf2-3pr3-8698.test.js
new file mode 100644
index 0000000..4ffbe33
--- /dev/null
+++ b/tests/unit/GHSA-mwf2-3pr3-8698.test.js
@@ -0,0 +1,93 @@
+import { describe, it } from 'vitest';
+import assert from 'assert';
+import stream from 'stream';
+import {
+  startHTTPServer,
+  stopHTTPServer,
+} from '../setup/server.js';
+import axios from '../../index.js';
+
+// Regression test for GHSA-mwf2-3pr3-8698 (CWE-400).
+//
+// HTTP/2 uses Node's native http2.request, which does not honor
+// options.maxBodyLength. CVE-2026-42034 wrapped streamed uploads only when
+// maxRedirects === 0 (the follow-redirects bypass). This leftover also wraps
+// the HTTP/2 path so default-redirect HTTP/2 streams are bounded.
+
+const SERVER_PORT = 8012;
+
+describe('GHSA-mwf2-3pr3-8698: HTTP/2 streamed maxBodyLength', () => {
+  it('should reject an HTTP/2 streamed body that exceeds maxBodyLength', async () => {
+    const server = await startHTTPServer(
+      (req, res) => {
+        req.resume();
+        res.end('OK');
+      },
+      {
+        useHTTP2: true,
+        port: SERVER_PORT,
+      }
+    );
+
+    try {
+      const localServerURL = `https://localhost:${server.address().port}`;
+      const http2Axios = axios.create({
+        baseURL: localServerURL,
+        httpVersion: 2,
+        http2Options: {
+          rejectUnauthorized: false,
+        },
+      });
+
+      const oversized = stream.Readable.from(['x'.repeat(4096)]);
+
+      await assert.rejects(
+        async () => {
+          await http2Axios.post(localServerURL, oversized, {
+            maxBodyLength: 1024,
+            maxRedirects: 5,
+          });
+        },
+        (err) => {
+          assert.ok(axios.isAxiosError(err), 'expected an AxiosError');
+          assert.strictEqual(err.code, 'ERR_BAD_REQUEST');
+          assert.match(err.message, /Request body larger than maxBodyLength limit/);
+          return true;
+        }
+      );
+    } finally {
+      await stopHTTPServer(server);
+    }
+  });
+
+  it('should still send a small HTTP/2 streamed body', async () => {
+    const server = await startHTTPServer(null, {
+      useHTTP2: true,
+      port: SERVER_PORT,
+    });
+
+    try {
+      const localServerURL = `https://localhost:${server.address().port}`;
+      const http2Axios = axios.create({
+        baseURL: localServerURL,
+        httpVersion: 2,
+        http2Options: {
+          rejectUnauthorized: false,
+        },
+      });
+
+      const payload = 'ok-stream';
+      const { data } = await http2Axios.post(
+        localServerURL,
+        stream.Readable.from([payload]),
+        {
+          maxBodyLength: 1024,
+          maxRedirects: 5,
+        }
+      );
+      assert.strictEqual(data, payload);
+    } finally {
+      await stopHTTPServer(server);
+    }
+  });
+});

