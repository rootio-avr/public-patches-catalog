diff --git a/tests/unit/GHSA-42h9-826w-cgv3.test.js b/tests/unit/GHSA-42h9-826w-cgv3.test.js
new file mode 100644
index 0000000..4283e33
--- /dev/null
+++ b/tests/unit/GHSA-42h9-826w-cgv3.test.js
@@ -0,0 +1,78 @@
+import { describe, it } from 'vitest';
+import assert from 'assert';
+import FormData from 'form-data';
+import toFormData from '../../lib/helpers/toFormData.js';
+import AxiosError from '../../lib/core/AxiosError.js';
+
+// Regression test for GHSA-42h9-826w-cgv3:
+// toFormData recursed without a depth limit, so a deeply nested payload
+// caused unbounded recursion (stack overflow / DoS). The fix adds a
+// configurable maxDepth guard (default 100) that throws a catchable
+// AxiosError with code ERR_FORM_DATA_DEPTH_EXCEEDED instead of overflowing.
+// Production guard itself is applied by CVE-2026-42039; this leftover
+// shares DEFAULT_FORM_DATA_MAX_DEPTH with formDataToJSON and locks tests.
+describe('GHSA-42h9-826w-cgv3: toFormData recursion depth limit', () => {
+  function nest(depth) {
+    let o = { leaf: 1 };
+    for (let i = 0; i < depth; i++) o = { a: o };
+    return o;
+  }
+
+  it('throws a catchable AxiosError when payload exceeds default depth (100)', () => {
+    let caught;
+    try {
+      toFormData(nest(101), new FormData());
+    } catch (err) {
+      caught = err;
+    }
+    assert.ok(caught instanceof AxiosError, 'error must be AxiosError, not RangeError');
+    assert.strictEqual(caught.code, 'ERR_FORM_DATA_DEPTH_EXCEEDED');
+    assert.ok(!(caught instanceof RangeError), 'must not be a native stack-overflow error');
+  });
+
+  it('succeeds at exactly the default depth limit (100)', () => {
+    const formData = toFormData(nest(100), new FormData());
+    assert.ok(formData instanceof FormData);
+  });
+
+  it('does not regress shallow payloads', () => {
+    const formData = toFormData(nest(5), new FormData());
+    assert.ok(formData instanceof FormData);
+  });
+
+  it('allows deeper payloads when maxDepth is raised', () => {
+    const formData = toFormData(nest(150), new FormData(), { maxDepth: 200 });
+    assert.ok(formData instanceof FormData);
+  });
+
+  it('rejects shallower payloads when maxDepth is lowered', () => {
+    let caught;
+    try {
+      toFormData(nest(10), new FormData(), { maxDepth: 5 });
+    } catch (err) {
+      caught = err;
+    }
+    assert.ok(caught instanceof AxiosError);
+    assert.strictEqual(caught.code, 'ERR_FORM_DATA_DEPTH_EXCEEDED');
+  });
+
+  it('still detects circular references while the depth guard is active', () => {
+    const data = { foo: 'bar' };
+    data.self = data;
+    let caught;
+    try {
+      toFormData(data, new FormData());
+    } catch (err) {
+      caught = err;
+    }
+    assert.ok(caught, 'should have thrown');
+    assert.ok(
+      caught.message.includes('Circular reference detected'),
+      'must be circular-ref error'
+    );
+  });
+
+  it('exposes the ERR_FORM_DATA_DEPTH_EXCEEDED error code constant', () => {
+    assert.strictEqual(AxiosError.ERR_FORM_DATA_DEPTH_EXCEEDED, 'ERR_FORM_DATA_DEPTH_EXCEEDED');
+  });
+});

