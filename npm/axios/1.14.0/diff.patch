diff --git a/tests/unit/GHSA-mmx7-hfxf-jppx.test.js b/tests/unit/GHSA-mmx7-hfxf-jppx.test.js
new file mode 100644
index 0000000..ad07dbd
--- /dev/null
+++ b/tests/unit/GHSA-mmx7-hfxf-jppx.test.js
@@ -0,0 +1,94 @@
+// https://github.com/advisories/GHSA-mmx7-hfxf-jppx
+// Prototype-pollution read gadgets in axios: values injected onto
+// Object.prototype must never leak into request config (body / serializer /
+// auth). The full upstream commit is not a clean cherry-pick onto 1.14.0;
+// this leftover covers the bodyless-method `data` gadget. Pollution-safe
+// config reads (getSafeProp) are applied by GHSA-7q8q-rj6j-mhjq.
+import { describe, it } from 'vitest';
+import axios from '../../index.js';
+import utils from '../../lib/utils.js';
+import assert from 'assert';
+
+describe('GHSA-mmx7-hfxf-jppx: prototype pollution read gadgets', () => {
+  it('should ignore an inherited `data` for bodyless method helpers', async () => {
+    Object.defineProperty(Object.prototype, 'data', {
+      value: 'inherited-body',
+      configurable: true,
+    });
+
+    try {
+      await Promise.all(
+        ['delete', 'get', 'head', 'options'].map(async (method) => {
+          let seenData = 'unset';
+
+          await axios[method]('/test', {
+            adapter(config) {
+              seenData = config.data;
+
+              return Promise.resolve({
+                data: null,
+                status: 200,
+                statusText: 'OK',
+                headers: {},
+                config,
+                request: {},
+              });
+            },
+          });
+
+          assert.strictEqual(seenData, undefined);
+        })
+      );
+    } finally {
+      delete Object.prototype.data;
+    }
+  });
+
+  it('should still send an own `data` property on bodyless helpers', async () => {
+    let seenData = 'unset';
+
+    await axios.get('/test', {
+      data: 'own-body',
+      adapter(config) {
+        seenData = config.data;
+
+        return Promise.resolve({
+          data: null,
+          status: 200,
+          statusText: 'OK',
+          headers: {},
+          config,
+          request: {},
+        });
+      },
+    });
+
+    assert.strictEqual(seenData, 'own-body');
+  });
+
+  describe('utils.getSafeProp / hasOwnInPrototypeChain', () => {
+    it('should not read values injected onto Object.prototype', () => {
+      Object.defineProperty(Object.prototype, 'username', {
+        value: 'polluted',
+        configurable: true,
+      });
+
+      try {
+        assert.strictEqual(utils.getSafeProp({}, 'username'), undefined);
+        assert.strictEqual(utils.hasOwnInPrototypeChain({}, 'username'), false);
+      } finally {
+        delete Object.prototype.username;
+      }
+    });
+
+    it('should read genuine own and inherited (non-Object.prototype) props', () => {
+      assert.strictEqual(utils.getSafeProp({ a: 1 }, 'a'), 1);
+
+      const proto = Object.create(null);
+      proto.token = 'real';
+      const obj = Object.create(proto);
+      assert.strictEqual(utils.getSafeProp(obj, 'token'), 'real');
+      assert.strictEqual(utils.hasOwnInPrototypeChain(obj, 'token'), true);
+    });
+  });
+});

