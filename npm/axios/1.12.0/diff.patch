+// Regression test for GHSA-7q8q-rj6j-mhjq (CWE-1321 Prototype Pollution)
+// https://github.com/advisories/GHSA-7q8q-rj6j-mhjq
+//
+// axios <1.18.0 read nested option objects (auth.username/password,
+// paramsSerializer.encode/serialize) and ingested iterable header sources
+// without guarding against Object.prototype pollution. An attacker able to
+// pollute Object.prototype could therefore inject credentials, a serializer,
+// or forge header entries. The fix reads such nested/untrusted members
+// pollution-safely (utils.getSafeProp / utils.isSafeIterable).
+
+import assert from 'assert';
+import utils from '../../../lib/utils.js';
+import AxiosHeaders from '../../../lib/core/AxiosHeaders.js';
+import buildURL from '../../../lib/helpers/buildURL.js';
+
+describe('Regression: GHSA-7q8q-rj6j-mhjq prototype pollution hardening', function () {
+  afterEach(function () {
+    // Ensure no pollution leaks between assertions.
+    delete Object.prototype.username;
+    delete Object.prototype.password;
+    delete Object.prototype.encode;
+    delete Object.prototype.serialize;
+    delete Object.prototype[Symbol.iterator];
+  });
+
+  describe('utils.getSafeProp', function () {
+    it('ignores values injected onto Object.prototype', function () {
+      Object.prototype.username = 'attacker';
+      assert.strictEqual(utils.getSafeProp({}, 'username'), undefined);
+    });
+
+    it('honors genuine own properties', function () {
+      assert.strictEqual(utils.getSafeProp({username: 'real'}, 'username'), 'real');
+    });
+
+    it('honors members inherited from a non-Object.prototype source', function () {
+      class Creds { get password() { return 'inherited'; } }
+      assert.strictEqual(utils.getSafeProp(new Creds(), 'password'), 'inherited');
+    });
+  });
+
+  describe('utils.isSafeIterable', function () {
+    it('returns false for a plain object made "iterable" via prototype pollution', function () {
+      Object.prototype[Symbol.iterator] = function* () { yield ['x', 'polluted']; };
+      assert.strictEqual(utils.isSafeIterable({}), false);
+    });
+
+    it('returns true for a genuinely iterable value', function () {
+      assert.strictEqual(utils.isSafeIterable([['a', '1']]), true);
+    });
+  });
+
+  describe('AxiosHeaders iterable ingestion', function () {
+    it('does not treat a polluted Object.prototype iterator as header entries', function () {
+      Object.prototype[Symbol.iterator] = function* () { yield ['x-injected', 'evil']; };
+      const headers = new AxiosHeaders();
+      // A plain object is not a legitimate iterable; the polluted iterator must
+      // be ignored, so no forged header is set.
+      headers.set({'x-real': 'ok'});
+      assert.strictEqual(headers.get('x-injected'), undefined);
+      assert.strictEqual(headers.get('x-real'), 'ok');
+    });
+
+    it('builds the header accumulator without an Object.prototype parent', function () {
+      Object.prototype.polluted = 'evil';
+      const headers = new AxiosHeaders();
+      headers.set([['content-type', 'text/plain']]);
+      assert.strictEqual(headers.get('content-type'), 'text/plain');
+      assert.strictEqual(headers.get('polluted'), undefined);
+      delete Object.prototype.polluted;
+    });
+  });
+
+  describe('buildURL paramsSerializer reads', function () {
+    it('ignores a serialize function injected onto Object.prototype', function () {
+      let called = false;
+      Object.prototype.serialize = function () { called = true; return 'pwned=1'; };
+      const result = buildURL('/api', {a: 1}, {});
+      assert.strictEqual(called, false);
+      assert.ok(result.indexOf('a=1') !== -1);
+    });
+
+    it('ignores an encode function injected onto Object.prototype', function () {
+      Object.prototype.encode = function () { return 'PWNED'; };
+      const result = buildURL('/api', {a: 'b'}, {});
+      assert.ok(result.indexOf('PWNED') === -1);
+    });
+  });
+});

