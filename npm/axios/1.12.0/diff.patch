+// Regression test for GHSA-mmx7-hfxf-jppx leftover hunks on axios 1.12.0.
+// https://github.com/advisories/GHSA-mmx7-hfxf-jppx
+//
+// The full upstream commit (axios/axios@32fc489) is a 29-file mega-patch.
+// getSafeProp, FormData depth, and fetch maxBodyLength are already applied by
+// GHSA-7q8q / GHSA-42h9 / GHSA-jqh4 / CVE-2026-42039. This leftover covers the
+// remaining unique gadgets: bodyless-alias Object.prototype.data, inherited
+// paramsSerializer reads, and malformed http(s) URLs missing "//".
+
+import assert from 'assert';
+import Axios from '../../../lib/core/Axios.js';
+import buildFullPath from '../../../lib/core/buildFullPath.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+import utils from '../../../lib/utils.js';
+
+describe('Regression: GHSA-mmx7-hfxf-jppx leftover hardening', function () {
+  afterEach(function () {
+    delete Object.prototype.data;
+    delete Object.prototype.proxy;
+    delete Object.prototype.params;
+    delete Object.prototype.paramsSerializer;
+  });
+
+  it('bodyless aliases do not copy inherited Object.prototype.data', function () {
+    Object.prototype.data = 'INJECTED';
+    const axios = new Axios({});
+    let captured;
+    axios.request = function (config) {
+      captured = config;
+      return Promise.resolve({data: config});
+    };
+
+    axios.get('/x');
+
+    assert.strictEqual(captured.data, undefined);
+    assert.strictEqual(utils.hasOwnProp(captured, 'data') ? captured.data : 'missing', undefined);
+  });
+
+  it('bodyless aliases still honor an own config.data', function () {
+    const axios = new Axios({});
+    let captured;
+    axios.request = function (config) {
+      captured = config;
+      return Promise.resolve({data: config});
+    };
+
+    axios.get('/x', {data: 'own-body'});
+
+    assert.strictEqual(captured.data, 'own-body');
+  });
+
+  it('rejects HTTP URLs missing slashes after the protocol', function () {
+    assert.throws(() => buildFullPath(undefined, 'https:example.com/users'), (err) => {
+      assert.ok(err instanceof AxiosError);
+      assert.strictEqual(err.code, AxiosError.ERR_INVALID_URL);
+      return true;
+    });
+  });
+});
