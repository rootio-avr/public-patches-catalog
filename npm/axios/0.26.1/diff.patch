+// source. Uses node:assert + mocha's describe/it (already a devDependency).
+var assert = require('assert');
+var utils = require('../lib/utils');
+var mergeConfig = require('../lib/core/mergeConfig');
+
+describe('CVE-2026-42035: FormData spoofing via prototype pollution', function () {
+  describe('utils.isFormData hardening', function () {
+    it('should reject primitives without throwing (ES5 getPrototypeOf guard)', function () {
+      [undefined, null, false, true, 0, 1, '', 'body', NaN].forEach(function (thing) {
+        assert.doesNotThrow(function () { utils.isFormData(thing); });
+        assert.strictEqual(utils.isFormData(thing), false);
+      });
+    });
+
+    it('should reject a plain object spoofing toString === "[object FormData]"', function () {
+      var spoof = { toString: function () { return '[object FormData]'; } };
+      assert.strictEqual(utils.isFormData(spoof), false);
+    });
+
+    it('should reject an object with a null prototype', function () {
+      var nullProto = Object.create(null);
+      assert.strictEqual(utils.isFormData(nullProto), false);
+    });
+
+    it('should reject a plain object with toString pulled from a polluted Object.prototype', function () {
+      Object.prototype.toString = function () { return '[object FormData]'; };
+      try {
+        assert.strictEqual(utils.isFormData({}), false);
+      } finally {
+        delete Object.prototype.toString;
+      }
+    });
+  });
+
+  describe('mergeConfig prototype-pollution isolation', function () {
+    it('should not inherit transport from a polluted Object.prototype', function () {
+      var polluted = { request: function () {} };
+      Object.prototype.transport = polluted;
+      try {
+        var result = mergeConfig({}, { url: '/a' });
+        assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'transport'), false);
+        assert.strictEqual(result.transport, undefined);
+        assert.notStrictEqual(result.transport, polluted);
+      } finally {
+        delete Object.prototype.transport;
+      }
+    });
+
+    it('should not inherit adapter from a polluted Object.prototype', function () {
+      var polluted = function () { return 'hijacked'; };
+      Object.prototype.adapter = polluted;
+      try {
+        var result = mergeConfig({}, { url: '/a' });
+        assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'adapter'), false);
+        assert.strictEqual(result.adapter, undefined);
+        assert.notStrictEqual(result.adapter, polluted);
+      } finally {
+        delete Object.prototype.adapter;
+      }
+    });
+
+    it('should still merge configs correctly', function () {
+      var result = mergeConfig({ url: '/base', timeout: 1000 }, { url: '/override' });
+      assert.strictEqual(result.url, '/override');
+      assert.strictEqual(result.timeout, 1000);
+    });
+  });
+});
