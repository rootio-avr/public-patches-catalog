+import { describe, it, expect } from 'vitest';
+import assert from 'assert';
+import utils from '../../lib/utils.js';
+import estimateDataURLDecodedBytes from '../../lib/helpers/estimateDataURLDecodedBytes.js';
+
+// Regression coverage for GHSA-jqh4-m9w3-8hp9 (axios "malformed http urls" fix).
+// The upstream fix hardens prototype-pollution-sensitive reads (getSafeProp /
+// hasOwnInPrototypeChain / isSafeIterable / isPlainObject) and makes
+// estimateDataURLDecodedBytes count percent-encoded bytes exactly. The upstream
+// test files live under tests/ which is not shipped in the npm package tarball,
+// so this minimal replacement grounds on the same fixed behavior.
+describe('GHSA-jqh4-m9w3-8hp9', () => {
+  it('getSafeProp ignores values reachable only via a polluted Object.prototype', () => {
+    Object.defineProperty(Object.prototype, 'username', {
+      value: 'inherited-user',
+      configurable: true,
+    });
+    try {
+      // A polluted-only prototype property must not be surfaced.
+      assert.strictEqual(utils.getSafeProp({}, 'username'), undefined);
+      // A genuine own property is still honored.
+      assert.strictEqual(utils.getSafeProp({ username: 'real' }, 'username'), 'real');
+    } finally {
+      delete Object.prototype.username;
+    }
+  });
+
+  it('isPlainObject ignores inherited Symbol.iterator / Symbol.toStringTag pollution', () => {
+    try {
+      Object.prototype[Symbol.iterator] = function* () {
+        yield ['x-injected', 'yes'];
+      };
+      Object.prototype[Symbol.toStringTag] = 'Custom';
+
+      expect(utils.isPlainObject({})).toEqual(true);
+      expect(
+        utils.isPlainObject({
+          [Symbol.iterator]: function* () {
+            yield ['x-own', 'yes'];
+          },
+        })
+      ).toEqual(false);
+    } finally {
+      delete Object.prototype[Symbol.iterator];
+      delete Object.prototype[Symbol.toStringTag];
+    }
+  });
+
+  it('isSafeIterable rejects an iterator sourced only from Object.prototype', () => {
+    try {
+      Object.prototype[Symbol.iterator] = function* () {
+        yield ['x-injected', 'yes'];
+      };
+      expect(utils.isSafeIterable({})).toEqual(false);
+    } finally {
+      delete Object.prototype[Symbol.iterator];
+    }
+  });
+
+  it('estimateDataURLDecodedBytes counts percent-encoded bytes exactly', () => {
+    // '%E2%82%AC' decodes to '€' which is 3 UTF-8 bytes.
+    assert.strictEqual(
+      estimateDataURLDecodedBytes('data:text/plain,%E2%82%AC'),
+      Buffer.byteLength('€', 'utf8')
+    );
+    // Each percent-encoded ASCII triplet counts as one decoded byte.
+    assert.strictEqual(
+      estimateDataURLDecodedBytes('data:text/plain,hello%20world'),
+      Buffer.byteLength('hello world', 'utf8')
+    );
+  });
+});

