+/* eslint-disable no-prototype-builtins */
+// Regression test for GHSA-7q8q-rj6j-mhjq (CWE-1321).
+//
+// The top-level merged config is already protected with a null prototype, so
+// pollution of a whole config key (e.g. Object.prototype.auth) is neutralized.
+// This advisory is about the *nested* case: an application passes an empty
+// placeholder object (auth: {}, paramsSerializer: {}) that IS an own key of the
+// config, but whose inner fields (username/password, encode/serialize) are then
+// read directly. When Object.prototype has been polluted, those inner reads
+// walk the prototype chain and pull attacker-controlled values, silently
+// injecting Basic auth credentials or hijacking query serialization.
+//
+// The fix reads nested config fields via utils.getSafeProp, which ignores
+// values reachable only through a polluted Object.prototype.
+import { afterEach, describe, it } from 'vitest';
+import assert from 'assert';
+import http from 'http';
+import utils from '../../lib/utils.js';
+import buildURL from '../../lib/helpers/buildURL.js';
+import resolveConfig from '../../lib/helpers/resolveConfig.js';
+import axios from '../../index.js';
+
+describe('Nested prototype pollution (GHSA-7q8q-rj6j-mhjq)', () => {
+  afterEach(() => {
+    delete Object.prototype.username;
+    delete Object.prototype.password;
+    delete Object.prototype.encode;
+    delete Object.prototype.serialize;
+  });
+
+  function startServer(handler) {
+    return new Promise((resolve) => {
+      const server = http.createServer(
+        handler ||
+          ((req, res) => {
+            res.writeHead(200, { 'Content-Type': 'application/json' });
+            res.end(JSON.stringify({ headers: req.headers, url: req.url }));
+          })
+      );
+      server.listen(0, '127.0.0.1', () => resolve(server));
+    });
+  }
+  const stop = (s) => new Promise((r) => s.close(r));
+
+  describe('utils.getSafeProp', () => {
+    it('reads genuine own properties', () => {
+      assert.strictEqual(utils.getSafeProp({ a: 1 }, 'a'), 1);
+    });
+
+    it('reads members inherited from a non-Object.prototype source', () => {
+      const proto = { role: 'template' };
+      const obj = Object.create(proto);
+      assert.strictEqual(utils.getSafeProp(obj, 'role'), 'template');
+    });
+
+    it('ignores values injected only onto Object.prototype', () => {
+      Object.prototype.username = 'attacker';
+      assert.strictEqual(utils.getSafeProp({}, 'username'), undefined);
+    });
+
+    it('returns undefined for null/undefined sources', () => {
+      Object.prototype.username = 'attacker';
+      assert.strictEqual(utils.getSafeProp(null, 'username'), undefined);
+      assert.strictEqual(utils.getSafeProp(undefined, 'username'), undefined);
+    });
+  });
+
+  describe('buildURL paramsSerializer placeholder', () => {
+    it('does not invoke a polluted serialize on an empty options object', () => {
+      let invoked = false;
+      Object.prototype.serialize = function polluted() {
+        invoked = true;
+        return 'injected=yes';
+      };
+
+      const url = buildURL('/api', { legit: 'true' }, {});
+
+      assert.strictEqual(invoked, false, 'polluted serialize must not be called');
+      assert.ok(url.indexOf('legit=true') !== -1, 'legitimate params must still be serialized');
+      assert.ok(url.indexOf('injected') === -1, 'injected params must not appear');
+    });
+
+    it('does not use a polluted encode on an empty options object', () => {
+      let invoked = false;
+      Object.prototype.encode = function polluted(v) {
+        invoked = true;
+        return 'HIJACKED';
+      };
+
+      const url = buildURL('/api', { q: 'a b' }, {});
+
+      assert.strictEqual(invoked, false, 'polluted encode must not be called');
+      assert.ok(url.indexOf('HIJACKED') === -1, 'polluted encoder output must not appear');
+    });
+  });
+
+  describe('resolveConfig auth placeholder', () => {
+    it('does not read polluted username/password from an empty auth object', () => {
+      Object.prototype.username = 'attacker';
+      Object.prototype.password = 'exfil';
+
+      const resolved = resolveConfig({ url: '/api', method: 'get', auth: {} });
+      const authorization = resolved.headers.get('Authorization');
+
+      // Basic base64('attacker:exfil') === 'YXR0YWNrZXI6ZXhmaWw='
+      assert.ok(
+        !authorization || authorization.indexOf('YXR0YWNrZXI6ZXhmaWw=') === -1,
+        'polluted credentials must not appear in the Authorization header'
+      );
+    });
+  });
+
+  describe('http adapter auth placeholder — full request flow', () => {
+    it('does not inject Basic auth from polluted username/password with auth: {}', async () => {
+      Object.prototype.username = 'attacker';
+      Object.prototype.password = 'exfil';
+
+      const server = await startServer();
+      const { port } = server.address();
+
+      try {
+        const res = await axios.get(`http://127.0.0.1:${port}/api`, { auth: {} });
+        assert.strictEqual(
+          res.data.headers.authorization,
+          undefined,
+          'polluted Object.prototype.username/password must not produce an Authorization header'
+        );
+      } finally {
+        await stop(server);
+      }
+    }, 10000);
+
+    it('does not invoke a polluted paramsSerializer with paramsSerializer: {}', async () => {
+      let invoked = false;
+      Object.prototype.serialize = function polluted() {
+        invoked = true;
+        return 'injected=yes';
+      };
+
+      const server = await startServer();
+      const { port } = server.address();
+
+      try {
+        const res = await axios.get(`http://127.0.0.1:${port}/data`, {
+          params: { legit: 'true' },
+          paramsSerializer: {},
+        });
+        assert.strictEqual(invoked, false, 'polluted serialize must not run');
+        assert.ok(res.data.url.indexOf('injected') === -1, 'injected query must not be sent');
+        assert.ok(res.data.url.indexOf('legit=true') !== -1, 'legitimate query must be sent');
+      } finally {
+        await stop(server);
+      }
+    }, 10000);
+  });
+});

