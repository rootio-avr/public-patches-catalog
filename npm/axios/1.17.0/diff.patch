+++ b/tests/unit/adapters/ghsa-mwf2-3pr3-8698.test.js
@@ -0,0 +1,80 @@
+// Regression test for GHSA-mwf2-3pr3-8698.
+//
+// Streamed request uploads bypassed `maxBodyLength` on transports other than
+// the native http/https path because the byte-counting pipeline in
+// lib/adapters/http.js was gated on `config.maxRedirects === 0`. The HTTP/2
+// transport never sets `maxRedirects === 0`, so an oversized streamed body was
+// sent in full instead of being rejected with
+// 'Request body larger than maxBodyLength limit' (ERR_BAD_REQUEST).
+//
+// The fix gates the pipeline on `!transportEnforcesMaxBodyLength` so every
+// transport that does not apply `maxBodyLength` itself (native http/https,
+// http2, and user-supplied custom transports) enforces it on streamed uploads.
+import { describe, it } from 'vitest';
+import assert from 'assert';
+import stream from 'stream';
+import { startHTTPServer, stopHTTPServer } from '../../setup/server.js';
+import axios from '../../../index.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+
+const SERVER_PORT = 8021;
+
+describe('GHSA-mwf2-3pr3-8698: maxBodyLength enforcement on streamed uploads', () => {
+  const createHttp2Axios = (baseURL) =>
+    axios.create({
+      baseURL,
+      httpVersion: 2,
+      http2Options: {
+        rejectUnauthorized: false,
+      },
+    });
+
+  it('should enforce maxBodyLength for HTTP/2 streamed uploads', async () => {
+    let bytesReceived = 0;
+    const server = await startHTTPServer(
+      (req, res) => {
+        req.on('data', (chunk) => {
+          bytesReceived += chunk.length;
+        });
+        req.on('error', () => {});
+        req.on('end', () => {
+          res.setHeader('Content-Type', 'application/json');
+          res.end(JSON.stringify({ received: bytesReceived }));
+        });
+      },
+      {
+        useHTTP2: true,
+        port: SERVER_PORT,
+      }
+    );
+
+    try {
+      const localServerURL = `https://localhost:${server.address().port}`;
+      const http2Axios = createHttp2Axios(localServerURL);
+      const payload = Buffer.alloc(2 * 1024 * 1024, 0x63);
+      const source = stream.Readable.from([payload]);
+
+      await assert.rejects(
+        http2Axios.post(localServerURL, source, {
+          maxBodyLength: 1024,
+          headers: { 'Content-Type': 'application/octet-stream' },
+        }),
+        (error) => {
+          assert.strictEqual(error.message, 'Request body larger than maxBodyLength limit');
+          assert.strictEqual(error.code, AxiosError.ERR_BAD_REQUEST);
+          return true;
+        }
+      );
+
+      assert.ok(
+        bytesReceived <= 1024 * 4,
+        `server should not receive full payload; got ${bytesReceived}`
+      );
+    } finally {
+      if (server.closeAllSessions) {
+        server.closeAllSessions();
+      }
+      await stopHTTPServer(server);
+    }
+  });
+});

