+import { describe, it } from 'vitest';
+import assert from 'assert';
+import { startHTTPServer, stopHTTPServer } from '../../setup/server.js';
+import axios from '../../../index.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+
+// Regression test for CVE-2026-101898 (GHSA-3pq3-5fj3-cg6v).
+//
+// The HTTP/2 transport ignored the `lookup` option, silently picked up
+// environment proxy settings it cannot honor, and did not reject explicit
+// proxy configuration. Custom DNS resolution and proxy policy could therefore
+// be bypassed when `httpVersion: 2` was used.
+describe('CVE-2026-101898: HTTP/2 lookup and proxy handling', () => {
+  const createServer = () =>
+    startHTTPServer(
+      (req, res) => {
+        res.setHeader('Content-Type', 'application/json');
+        res.end(JSON.stringify({ ok: true }));
+      },
+      { useHTTP2: true }
+    );
+
+  it('should forward the custom lookup option to the HTTP/2 connection', async () => {
+    const server = await createServer();
+    const calls = [];
+
+    try {
+      const port = server.address().port;
+      const response = await axios.get(`https://axios-lookup-test.invalid:${port}/`, {
+        httpVersion: 2,
+        http2Options: { rejectUnauthorized: false },
+        lookup: (hostname, options, cb) => {
+          calls.push(hostname);
+          cb(null, '127.0.0.1', 4);
+        },
+      });
+
+      assert.strictEqual(response.status, 200);
+      assert.ok(calls.includes('axios-lookup-test.invalid'));
+    } finally {
+      await stopHTTPServer(server);
+    }
+  });
+
+  it('should reject HTTP/2 requests with an explicit proxy', async () => {
+    await assert.rejects(
+      axios.get('https://localhost:1/', {
+        httpVersion: 2,
+        proxy: { protocol: 'http', host: '127.0.0.1', port: 9 },
+      }),
+      (error) => {
+        assert.strictEqual(error.code, AxiosError.ERR_NOT_SUPPORT);
+        assert.match(error.message, /HTTP\/2 requests with a proxy are not supported/);
+        return true;
+      }
+    );
+  });
+
+  it('should not apply environment proxies to HTTP/2 requests', async () => {
+    const server = await createServer();
+    const keys = ['https_proxy', 'HTTPS_PROXY', 'http_proxy', 'HTTP_PROXY', 'no_proxy', 'NO_PROXY'];
+    const saved = {};
+    keys.forEach((key) => {
+      saved[key] = process.env[key];
+      delete process.env[key];
+    });
+    process.env.https_proxy = 'http://127.0.0.1:9';
+    process.env.HTTPS_PROXY = 'http://127.0.0.1:9';
+
