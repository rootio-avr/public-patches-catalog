+import { describe, it, expect, afterEach } from 'vitest';
+import utils from '../../lib/utils.js';
+import buildURL from '../../lib/helpers/buildURL.js';
+
+// Regression test for GHSA-xj6q-8x83-jv6g (CWE-1321, prototype pollution).
+//
+// An attacker who can pollute Object.prototype (e.g. via a deep-merge of
+// untrusted JSON) could previously have axios read inherited prototype values
+// for credential / serializer fields, forging an outbound "Authorization"
+// header or overriding the params serializer. The fix reads these behavior
+// affecting fields pollution-safely via utils.getSafeProp, which ignores
+// values reachable only through a polluted Object.prototype.
+describe('GHSA-xj6q-8x83-jv6g: prototype-pollution-safe config reads', () => {
+  const polluted = [];
+
+  const pollute = (key, value) => {
+    polluted.push(key);
+    // eslint-disable-next-line no-extend-native
+    Object.defineProperty(Object.prototype, key, {
+      value,
+      writable: true,
+      configurable: true,
+      enumerable: false,
+    });
+  };
+
+  afterEach(() => {
+    while (polluted.length) {
+      delete Object.prototype[polluted.pop()];
+    }
+  });
+
+  describe('utils.getSafeProp', () => {
+    it('ignores values injected onto Object.prototype', () => {
+      pollute('username', 'attacker');
+      pollute('password', 'secret');
+
+      const auth = {};
+      expect(utils.getSafeProp(auth, 'username')).toBeUndefined();
+      expect(utils.getSafeProp(auth, 'password')).toBeUndefined();
+    });
+
+    it('honors genuine own properties', () => {
+      pollute('username', 'attacker');
+
+      const auth = { username: 'real-user' };
+      expect(utils.getSafeProp(auth, 'username')).toBe('real-user');
+    });
+
+    it('honors members inherited from a non-Object.prototype source', () => {
+      pollute('token', 'attacker');
+
+      const template = { token: 'legit' };
+      const instance = Object.create(template);
+      expect(utils.getSafeProp(instance, 'token')).toBe('legit');
+    });
+
+    it('returns undefined for null/undefined sources', () => {
+      expect(utils.getSafeProp(null, 'x')).toBeUndefined();
+      expect(utils.getSafeProp(undefined, 'x')).toBeUndefined();
+    });
+  });
+
+  describe('buildURL serializer options', () => {
+    it('does not honor a serialize function injected via Object.prototype', () => {
+      let called = false;
+      pollute('serialize', () => {
+        called = true;
+        return 'attacker=1';
+      });
+
+      const result = buildURL('/foo', { a: 'b' }, {});
+      expect(called).toBe(false);
+      expect(result).toBe('/foo?a=b');
+    });
+
+    it('does not honor an encode function injected via Object.prototype', () => {
+      let called = false;
+      pollute('encode', () => {
+        called = true;
+        return 'attacker';
+      });
+
+      const result = buildURL('/foo', { a: 'b' }, {});
+      expect(called).toBe(false);
+      expect(result).toBe('/foo?a=b');
+    });
+
+    it('still honors an own serialize function', () => {
+      const result = buildURL('/foo', { a: 'b' }, { serialize: () => 'x=y' });
+      expect(result).toBe('/foo?x=y');
+    });
+  });
+});

