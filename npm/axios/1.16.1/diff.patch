+// Regression test for GHSA-7q8q-rj6j-mhjq
+// Axios Prototype Pollution via Nested Config Objects (CWE-1321).
+import { describe, it, afterEach } from 'vitest';
+import assert from 'assert';
+import resolveConfig from '../../lib/helpers/resolveConfig.js';
+import utils from '../../lib/utils.js';
+import buildURL from '../../lib/helpers/buildURL.js';
+
+function clearPollution() {
+  delete Object.prototype.username;
+  delete Object.prototype.password;
+  delete Object.prototype.serialize;
+  delete Object.prototype.encode;
+}
+
+describe('GHSA-7q8q-rj6j-mhjq prototype pollution via nested config objects', () => {
+  afterEach(clearPollution);
+
+  it('ignores inherited auth username/password (no injected Authorization)', () => {
+    Object.defineProperty(Object.prototype, 'username', {
+      value: 'inherited-user',
+      configurable: true,
+    });
+    Object.defineProperty(Object.prototype, 'password', {
+      value: 'inherited-pass',
+      configurable: true,
+    });
+
+    const config = resolveConfig({ url: '/foo', auth: {} });
+
+    // btoa(':') === 'Og==' — proves neither inherited credential was consumed.
+    assert.strictEqual(config.headers.get('Authorization'), 'Basic Og==');
+  });
+
+  it('still honors legitimately-supplied auth credentials', () => {
+    const config = resolveConfig({
+      url: '/foo',
+      auth: { username: 'user', password: 'pass' },
+    });
+
+    // btoa('user:pass') === 'dXNlcjpwYXNz'
+    assert.strictEqual(config.headers.get('Authorization'), 'Basic dXNlcjpwYXNz');
+  });
+
+  it('ignores inherited paramsSerializer encode/serialize', () => {
+    let serializeInvoked = false;
+    let encodeInvoked = false;
+
+    Object.defineProperty(Object.prototype, 'serialize', {
+      value() {
+        serializeInvoked = true;
+        return 'inherited=1';
+      },
+      configurable: true,
+    });
+    Object.defineProperty(Object.prototype, 'encode', {
+      value() {
+        encodeInvoked = true;
+        return 'inherited';
+      },
+      configurable: true,
+    });
+
+    const config = resolveConfig({
+      url: '/foo',
+      params: { value: 'a b' },
+      paramsSerializer: {},
+    });
+
+    assert.strictEqual(config.url, '/foo?value=a+b');
+    assert.strictEqual(serializeInvoked, false);
+    assert.strictEqual(encodeInvoked, false);
+  });
+
+  describe('utils.getSafeProp', () => {
+    it('returns own properties', () => {
+      assert.strictEqual(utils.getSafeProp({ a: 1 }, 'a'), 1);
+    });
+
+    it('returns members inherited from a non-Object.prototype source', () => {
+      class Template {}
+      Template.prototype.serialize = function () {
+        return 'ok';
+      };
+      const instance = new Template();
+      assert.strictEqual(typeof utils.getSafeProp(instance, 'serialize'), 'function');
+    });
+
+    it('ignores values reachable only via a polluted Object.prototype', () => {
+      Object.defineProperty(Object.prototype, 'password', {
+        value: 'inherited-pass',
+        configurable: true,
+      });
+      assert.strictEqual(utils.getSafeProp({}, 'password'), undefined);
+    });
+
+    it('returns undefined for null/undefined sources', () => {
+      assert.strictEqual(utils.getSafeProp(null, 'x'), undefined);
+      assert.strictEqual(utils.getSafeProp(undefined, 'x'), undefined);
+    });
+  });
+
+  describe('buildURL paramsSerializer placeholder', () => {
+    it('does not invoke a polluted serialize on an empty options object', () => {
+      let invoked = false;
+      Object.prototype.serialize = function polluted() {
+        invoked = true;
+        return 'injected=yes';
+      };
+
+      const url = buildURL('/api', { legit: 'true' }, {});
+
+      assert.strictEqual(invoked, false, 'polluted serialize must not be called');
+      assert.ok(url.indexOf('legit=true') !== -1, 'legitimate params must still be serialized');
+      assert.ok(url.indexOf('injected') === -1, 'injected params must not appear');
+    });
+  });
+});

