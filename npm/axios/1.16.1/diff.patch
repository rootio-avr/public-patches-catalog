+// Regression test for GHSA-hcpx-6fm6-wx23
+// Hardens toFormData / AxiosURLSearchParams maxDepth handling against the
+// `{}` metatoken bypass, where a key ending in `{}` routed a deeply nested
+// value straight through JSON.stringify (bypassing the depth guard) and
+// could overflow the stack with a RangeError instead of a controlled
+// AxiosError(ERR_FORM_DATA_DEPTH_EXCEEDED).
+import { describe, it } from 'vitest';
+import assert from 'assert';
+import FormData from 'form-data';
+import toFormData from '../../lib/helpers/toFormData.js';
+import AxiosError from '../../lib/core/AxiosError.js';
+import AxiosURLSearchParams from '../../lib/helpers/AxiosURLSearchParams.js';
+
+function nest(depth) {
+  let o = { leaf: 1 };
+  for (let i = 0; i < depth; i++) o = { a: o };
+  return o;
+}
+
+describe('GHSA-hcpx-6fm6-wx23: {} metatoken depth bypass', () => {
+  it('rejects deeply nested {} metatoken values before JSON.stringify overflows', () => {
+    try {
+      toFormData({ 'evil{}': nest(10000) }, new FormData());
+      assert.fail('Should have thrown');
+    } catch (err) {
+      assert.ok(err instanceof AxiosError, 'error must be AxiosError, not RangeError');
+      assert.strictEqual(err.code, 'ERR_FORM_DATA_DEPTH_EXCEEDED');
+      assert.ok(!(err instanceof RangeError));
+    }
+  });
+
+  it('allows {} metatoken values within the normal top-level depth boundary', () => {
+    const formData = toFormData({ 'safe{}': nest(99) }, new FormData());
+    assert.ok(formData instanceof FormData);
+  });
+
+  it('rejects {} metatoken values beyond the normal top-level depth boundary', () => {
+    try {
+      toFormData({ 'evil{}': nest(100) }, new FormData());
+      assert.fail('Should have thrown');
+    } catch (err) {
+      assert.ok(err instanceof AxiosError);
+      assert.strictEqual(err.code, 'ERR_FORM_DATA_DEPTH_EXCEEDED');
+    }
+  });
+
+  it('rejects deeply nested {} metatoken params (AxiosURLSearchParams) before overflow', () => {
+    try {
+      new AxiosURLSearchParams({ 'evil{}': nest(10000) });
+      assert.fail('Should have thrown');
+    } catch (err) {
+      assert.ok(err instanceof AxiosError, 'error must be AxiosError, not RangeError');
+      assert.strictEqual(err.code, 'ERR_FORM_DATA_DEPTH_EXCEEDED');
+      assert.ok(!(err instanceof RangeError));
+    }
+  });
+});

