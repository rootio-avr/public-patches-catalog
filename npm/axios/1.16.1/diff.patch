+        makeUploadStream(payloadLength),
+        {
+          maxBodyLength: 1024,
+          headers: { 'Content-Type': 'application/octet-stream' },
+        }
+      );
+
+      assert.strictEqual(data.received, payloadLength);
+    } finally {
+      await stopHTTPServer(server);
+    }
+  });
