+import { describe, it } from 'vitest';
+import assert from 'assert';
+import { startHTTPServer, stopHTTPServer } from '../../setup/server.js';
+import axios from '../../../index.js';
+import AxiosError from '../../../lib/core/AxiosError.js';
+import stream from 'stream';
+
+// Regression test for GHSA-mwf2-3pr3-8698 (CWE-400).
+//
+// Before the fix, the explicit byte-counting upload pipeline in
+// lib/adapters/http.js was gated on `config.maxRedirects === 0`, so the
+// HTTP/2 transport (and any other transport that does not apply
+// options.maxBodyLength itself) streamed uploads without enforcing
+// maxBodyLength. A client could send an arbitrarily large body past the
+// configured limit. The fix enforces maxBodyLength for every transport that
+// does not enforce it on its own (http2, native http/https, custom
+// transports).
+describe('GHSA-mwf2-3pr3-8698: maxBodyLength enforcement on HTTP/2 uploads', () => {
+  const createHttp2Axios = (baseURL) =>
+    axios.create({
+      baseURL,
+      httpVersion: 2,
+      http2Options: {
+        rejectUnauthorized: false,
+      },
+    });
+
+  it('should enforce maxBodyLength for HTTP/2 streamed uploads', async () => {
+    let bytesReceived = 0;
+    const server = await startHTTPServer(
+      (req, res) => {
+        req.on('data', (chunk) => {
+          bytesReceived += chunk.length;
+        });
+        req.on('error', () => {});
+        req.on('end', () => {
+          res.setHeader('Content-Type', 'application/json');
+          res.end(JSON.stringify({ received: bytesReceived }));
+        });
+      },
+      {
+        useHTTP2: true,
+      }
+    );
+
+    try {
+      const localServerURL = `https://localhost:${server.address().port}`;
+      const http2Axios = createHttp2Axios(localServerURL);
+      const payload = Buffer.alloc(2 * 1024 * 1024, 0x63);
+      const source = stream.Readable.from([payload]);
+
+      await assert.rejects(
+        http2Axios.post(localServerURL, source, {
+          maxBodyLength: 1024,
+          headers: { 'Content-Type': 'application/octet-stream' },
+        }),
+        (error) => {
+          assert.strictEqual(error.message, 'Request body larger than maxBodyLength limit');
+          assert.strictEqual(error.code, AxiosError.ERR_BAD_REQUEST);
+          return true;
+        }
+      );
+
+      assert.ok(
+        bytesReceived <= 1024 * 4,
+        `server should not receive full payload; got ${bytesReceived}`
+      );
+    } finally {
+      if (server.closeAllSessions) {
+        server.closeAllSessions();
+      }
+      await stopHTTPServer(server);
+    }
+  });
+});

