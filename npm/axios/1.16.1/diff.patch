+// Regression test for GHSA-f4gw-2p7v-4548 (axios malformed http urls /
+// proxy-bypass of the unspecified address 0.0.0.0 and IPv6 ::).
+//
+// Grounds on the upstream fix commit 32fc489632377d214db55bfa4e2c48486a7d7ce2
+// which added '0.0.0.0' to the loopback set and the isIPv6Unspecified helper so
+// the unspecified address (IPv4 0.0.0.0 / IPv6 ::) is treated as
+// loopback-equivalent for NO_PROXY matching. Authored as a standalone new file
+// because the published npm tarball does not ship the upstream test tree.
+import { afterEach, describe, expect, it } from 'vitest';
+import shouldBypassProxy from '../../../lib/helpers/shouldBypassProxy.js';
+
+const originalNoProxy = process.env.no_proxy;
+const originalNOProxy = process.env.NO_PROXY;
+
+const setNoProxy = (value) => {
+  process.env.no_proxy = value;
+  process.env.NO_PROXY = value;
+};
+
+afterEach(() => {
+  if (originalNoProxy === undefined) {
+    delete process.env.no_proxy;
+  } else {
+    process.env.no_proxy = originalNoProxy;
+  }
+
+  if (originalNOProxy === undefined) {
+    delete process.env.NO_PROXY;
+  } else {
+    process.env.NO_PROXY = originalNOProxy;
+  }
+});
+
+describe('GHSA-f4gw-2p7v-4548: unspecified-address proxy bypass', () => {
+  it('bypasses proxy for 0.0.0.0 when no_proxy holds a local entry', () => {
+    for (const entry of ['localhost', '127.0.0.1', '::1']) {
+      setNoProxy(entry);
+
+      expect(shouldBypassProxy('http://0.0.0.0:7777/')).toBe(true);
+    }
+  });
+
+  it('respects explicit ports for 0.0.0.0 local matching', () => {
+    setNoProxy('localhost:8080');
+
+    expect(shouldBypassProxy('http://0.0.0.0:8080/')).toBe(true);
+    expect(shouldBypassProxy('http://0.0.0.0:9090/')).toBe(false);
+  });
+
+  it('bypasses proxy for the IPv6 unspecified address symmetrically with 0.0.0.0', () => {
+    for (const entry of ['localhost', '127.0.0.1', '::1']) {
+      setNoProxy(entry);
+
+      expect(shouldBypassProxy('http://[::]:7777/')).toBe(true);
+      expect(shouldBypassProxy('http://[0:0:0:0:0:0:0:0]:7777/')).toBe(true);
+    }
+  });
+
+  it('bypasses proxy for compressed IPv6 unspecified request forms', () => {
+    setNoProxy('localhost,127.0.0.1,::1');
+
+    for (const host of ['0::', '::0', '0:0::', '::0:0', '0::0']) {
+      expect(shouldBypassProxy(`http://[${host}]:7777/`)).toBe(true);
+    }
+  });
+
+  it('does not treat a nonzero compressed IPv6 address as unspecified', () => {
+    setNoProxy('0::2');
+
+    expect(shouldBypassProxy('http://[::]:7777/')).toBe(false);
+  });
+
+  it('still routes a real public IPv6 host through the proxy', () => {
+    setNoProxy('localhost');
+
+    expect(shouldBypassProxy('http://[2001:db8::1]:7777/')).toBe(false);
+  });
+});

Description: Fix uncontrolled recursion (CWE-674) in formDataToJSON's buildPath()
 A FormData field name with thousands of bracket-nested segments
 (e.g. 'foo' + '[bar]'.repeat(15000)) drives buildPath() into unbounded
 recursion, exhausting the call stack and throwing a RangeError (DoS).
 This backports the depth guard from upstream commit
 32fc489632377d214db55bfa4e2c48486a7d7ce2 (axios PR #11000): a MAX_DEPTH
 limit enforced during both path tokenization (parsePropPath) and the
 recursive descent (buildPath), throwing AxiosError with code
 ERR_FORM_DATA_DEPTH_EXCEEDED instead of overflowing the stack.
 MAX_DEPTH is hardcoded to 100 (matching toFormData.js's default) rather
 than importing DEFAULT_FORM_DATA_MAX_DEPTH, which target 1.16.1 does not
 export.
Origin: backport, https://github.com/axios/axios/commit/32fc489632377d214db55bfa4e2c48486a7d7ce2
