+
+const basic = (user, pass) => 'Basic ' + Buffer.from(user + ':' + pass, 'utf8').toString('base64');
+
+const newOptions = (host, port, headers) => ({
+  headers: headers || {},
+  beforeRedirects: {},
+  hostname: host,
+  host: host,
+  port: port
+});
+
+describe('AIKIDO-2026-10741: Proxy-Authorization leak on redirect', () => {
+  it('clears stale Proxy-Authorization when redirect resolves to no proxy (configProxy=false)', () => {
+    const options = newOptions('initial.example.com', 80);
+    __setProxy(options, {host: '127.0.0.1', port: 8030, auth: {username: 'user', password: 'pass'}}, 'http://initial.example.com/start');
+    assert.strictEqual(options.headers['Proxy-Authorization'], basic('user', 'pass'));
+
+    const redirectOptions = newOptions('attacker.example.com', 443, {...options.headers});
+    __setProxy(redirectOptions, false, 'https://attacker.example.com/final', true);
+    assert.strictEqual(redirectOptions.headers['Proxy-Authorization'], undefined);
+  });
+
+  it('clears stale Proxy-Authorization when env proxy is bypassed on redirect (NO_PROXY)', () => {
+    const saved = {
+      http_proxy: process.env.http_proxy,
+      https_proxy: process.env.https_proxy,
+      no_proxy: process.env.no_proxy
+    };
+
+    process.env.http_proxy = 'http://user:pass@127.0.0.1:8030';
+    process.env.https_proxy = 'http://user:pass@127.0.0.1:8030';
+    process.env.no_proxy = 'attacker.example.com';
+
+    try {
+      const options = newOptions('initial.example.com', 80);
+      __setProxy(options, undefined, 'http://initial.example.com/start');
+      assert.strictEqual(options.headers['Proxy-Authorization'], basic('user', 'pass'));
+
+      const redirectOptions = newOptions('attacker.example.com', 443, {...options.headers});
+      redirectOptions.protocol = 'https:';
+      __setProxy(redirectOptions, undefined, 'https://attacker.example.com/final', true);
+      assert.strictEqual(redirectOptions.headers['Proxy-Authorization'], undefined);
+    } finally {
+      Object.keys(saved).forEach((key) => {
+        if (saved[key] === undefined) delete process.env[key]; else process.env[key] = saved[key];
+      });
+    }
+  });
+
+  it('does not leak credentials of the previous proxy to a new proxy without credentials', () => {
+    const options = newOptions('initial.example.com', 80);
+    __setProxy(options, {host: '127.0.0.1', port: 8030, auth: {username: 'user', password: 'pass'}}, 'http://initial.example.com/start');
+    assert.ok(options.headers['Proxy-Authorization']);
+
+    const redirectOptions = newOptions('second.example.com', 80, {...options.headers});
+    __setProxy(redirectOptions, {host: '127.0.0.2', port: 8031}, 'http://second.example.com/final', true);
+    assert.strictEqual(redirectOptions.headers['Proxy-Authorization'], undefined);
+  });
