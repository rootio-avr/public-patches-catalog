+++ b/lib/adapters/http.js
@@ -446,7 +446,7 @@ export default isHttpAdapterSupported && function httpAdapter(config) {
       path,
       method: method,
       headers: headers.toJSON(),
-      agents: { http: config.httpAgent, https: config.httpsAgent },
+      agents: { http: own('httpAgent'), https: own('httpsAgent') },
       auth,
       protocol,
