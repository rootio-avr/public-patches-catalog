diff --git a/tests/unit/cve-jqh4-m9w3-8hp9.test.js b/tests/unit/cve-jqh4-m9w3-8hp9.test.js
new file mode 100644
index 0000000..b232f6a
--- /dev/null
+++ b/tests/unit/cve-jqh4-m9w3-8hp9.test.js
@@ -0,0 +1,81 @@
+// Regression test for GHSA-jqh4-m9w3-8hp9 (CWE-770):
+// The fetch adapter failed to enforce `maxBodyLength` for streamed request
+// bodies, so an oversized ReadableStream / Readable payload was uploaded in
+// full even when maxBodyLength was set. The fix counts bytes as fetch consumes
+// the body and rejects with ERR_BAD_REQUEST once the limit is exceeded, and it
+// never trusts a caller-declared (possibly under-reported) Content-Length.
+import { describe, it } from 'vitest';
+import assert from 'assert';
+import stream from 'stream';
+import axios from '../../index.js';
+
+const fetchAxios = axios.create({ adapter: 'fetch' });
+
+describe.runIf(typeof fetch === 'function')(
+  'GHSA-jqh4-m9w3-8hp9: fetch adapter enforces maxBodyLength on streamed bodies',
+  () => {
+    it('rejects a streamed outbound body exceeding maxBodyLength without uploading it all', async () => {
+      let bytesRead = 0;
+
+      await assert.rejects(
+        fetchAxios.post('/', stream.Readable.from([Buffer.alloc(2048)]), {
+          maxBodyLength: 1024,
+          headers: {
+            'Content-Type': 'application/octet-stream',
+            'Content-Length': '1',
+          },
+          env: {
+            Request: null,
+            async fetch(_url, options) {
+              for await (const chunk of options.body) {
+                bytesRead += chunk.byteLength;
+              }
+              return {
+                headers: {},
+                status: 200,
+                statusText: 'OK',
+                text: async () => 'ok',
+              };
+            },
+          },
+        }),
+        (err) => {
+          assert.strictEqual(err.code, 'ERR_BAD_REQUEST');
+          assert.strictEqual(err.message, 'Request body larger than maxBodyLength limit');
+          return true;
+        }
+      );
+
+      assert.ok(
+        bytesRead <= 1024,
+        `custom fetch must not read more than maxBodyLength; got ${bytesRead}`
+      );
+    });
+
+    it('allows a streamed outbound body at or below maxBodyLength', async () => {
+      let bytesRead = 0;
+
+      const { data } = await fetchAxios.post('/', stream.Readable.from([Buffer.alloc(512)]), {
+        maxBodyLength: 1024,
+        headers: { 'Content-Type': 'application/octet-stream' },
+        env: {
+          Request: null,
+          async fetch(_url, options) {
+            for await (const chunk of options.body) {
+              bytesRead += chunk.byteLength;
+            }
+            return {
+              headers: {},
+              status: 200,
+              statusText: 'OK',
+              text: async () => 'ok',
+            };
+          },
+        },
+      });
+
+      assert.strictEqual(data, 'ok');
+      assert.strictEqual(bytesRead, 512);
+    });
+  }
+);

