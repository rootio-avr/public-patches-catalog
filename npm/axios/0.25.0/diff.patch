@@ -0,0 +1,52 @@
+'use strict';
+
+// Regression test for CVE-2025-62718: NO_PROXY hostname normalization bypass
+// (e.g. "localhost." / "[::1]" / loopback aliases not matching NO_PROXY entries,
+// so requests intended to skip the proxy were sent through it - SSRF).
+
+var assert = require('assert');
+var shouldBypassProxy = require('../lib/helpers/shouldBypassProxy');
+
+function withNoProxy(value, fn) {
+  var oldLower = process.env.no_proxy;
+  var oldUpper = process.env.NO_PROXY;
+  delete process.env.NO_PROXY;
+  process.env.no_proxy = value;
+  try {
+    fn();
+  } finally {
+    if (oldLower === undefined) { delete process.env.no_proxy; } else { process.env.no_proxy = oldLower; }
+    if (oldUpper === undefined) { delete process.env.NO_PROXY; } else { process.env.NO_PROXY = oldUpper; }
+  }
+}
+
+describe('CVE-2025-62718 NO_PROXY normalization', function () {
+  it('bypasses the proxy for a trailing-dot hostname matching an entry', function () {
+    withNoProxy('localhost,example.com', function () {
+      assert.strictEqual(shouldBypassProxy('http://localhost.:8080/'), true);
+      assert.strictEqual(shouldBypassProxy('http://example.com./'), true);
+    });
+  });
+
+  it('treats loopback addresses as equivalent', function () {
+    withNoProxy('localhost', function () {
+      assert.strictEqual(shouldBypassProxy('http://127.0.0.1:8080/'), true);
+      assert.strictEqual(shouldBypassProxy('http://[::1]:8080/'), true);
+    });
+  });
+
+  it('honours ports and wildcard/suffix entries', function () {
+    withNoProxy('example.com:8080,.internal.test', function () {
+      assert.strictEqual(shouldBypassProxy('http://example.com:8080/'), true);
+      assert.strictEqual(shouldBypassProxy('http://example.com:9090/'), false);
+      assert.strictEqual(shouldBypassProxy('http://a.internal.test/'), true);
+    });
+  });
+
+  it('does not bypass the proxy for unrelated hosts', function () {
+    withNoProxy('localhost,example.com', function () {
+      assert.strictEqual(shouldBypassProxy('http://evil.test/'), false);
+      assert.strictEqual(shouldBypassProxy('http://notexample.com/'), false);
+    });
+  });
+});

