+var assert = require('assert');
+var utils = require('../lib/utils');
+var mergeConfig = require('../lib/core/mergeConfig');
+
+describe('CVE-2026-42035: FormData spoofing via prototype pollution', function () {
+  describe('utils.isFormData hardening', function () {
+    it('should reject primitives without throwing (ES5 getPrototypeOf guard)', function () {
+      [undefined, null, false, true, 0, 1, '', 'body', NaN].forEach(function (thing) {
+        assert.doesNotThrow(function () { utils.isFormData(thing); });
+        assert.strictEqual(utils.isFormData(thing), false);
+      });
+    });
+
+    it('should reject a plain object spoofing toString === "[object FormData]"', function () {
+      var spoof = { toString: function () { return '[object FormData]'; } };
+      assert.strictEqual(utils.isFormData(spoof), false);
+    });
+
+    it('should reject an object with a null prototype', function () {
+      var nullProto = Object.create(null);
+      assert.strictEqual(utils.isFormData(nullProto), false);
+    });
+
+    it('should reject a plain object with toString pulled from a polluted Object.prototype', function () {
+      Object.prototype.toString = function () { return '[object FormData]'; };
