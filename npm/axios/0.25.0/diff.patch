+++ b/test/cve-2026-25639.test.js
@@ -0,0 +1,62 @@
+'use strict';
+
+var assert = require('assert');
+var utils = require('../lib/utils');
+var mergeConfig = require('../lib/core/mergeConfig');
+
+describe('CVE-2026-25639 prototype key handling in merge/mergeConfig', function () {
+  afterEach(function () {
+    delete Object.prototype.polluted;
+  });
+
+  it('mergeConfig should not throw on a __proto__ key and should drop it', function () {
+    var malicious = JSON.parse('{"__proto__": {"polluted": "yes"}, "url": "/api/test"}');
+    var result;
+    assert.doesNotThrow(function () {
+      result = mergeConfig({}, malicious);
+    });
+    assert.strictEqual(Object.prototype.polluted, undefined);
+    assert.strictEqual(result.url, '/api/test');
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result, '__proto__'), false);
+  });
+
+  it('mergeConfig should drop constructor and prototype keys', function () {
+    var result = mergeConfig({}, {
+      constructor: { polluted: 'yes' },
+      prototype: { polluted: 'yes' },
+      url: '/x'
+    });
+    assert.strictEqual(result.url, '/x');
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'constructor'), false);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'prototype'), false);
+  });
+
+  it('mergeConfig should drop dangerous keys nested in headers', function () {
+    var malicious = JSON.parse('{"headers": {"__proto__": {"polluted": "yes"}, "Content-Type": "application/json"}}');
+    var result = mergeConfig({}, malicious);
+    assert.strictEqual(Object.prototype.polluted, undefined);
+    assert.strictEqual(result.headers['Content-Type'], 'application/json');
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result.headers, '__proto__'), false);
+  });
+
+  it('utils.merge should filter dangerous keys at any depth', function () {
+    var malicious = JSON.parse('{"a": {"b": {"__proto__": {"polluted": "deep"}, "constructor": {"prototype": {"polluted": "deep"}}, "safe": "v"}}}');
+    var result = utils.merge({}, malicious);
+    assert.strictEqual(Object.prototype.polluted, undefined);
+    assert.strictEqual(result.a.b.safe, 'v');
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result.a.b, '__proto__'), false);
+    assert.strictEqual(Object.prototype.hasOwnProperty.call(result.a.b, 'constructor'), false);
+  });
+
+  it('mergeConfig should still merge regular configs', function () {
+    var result = mergeConfig(
+      { baseURL: 'https://api.example.com', timeout: 1000, headers: { common: { Accept: 'application/json' } } },
+      { url: '/users', timeout: 5000, headers: { common: { 'Content-Type': 'application/json' } } }
+    );
+    assert.strictEqual(result.baseURL, 'https://api.example.com');
+    assert.strictEqual(result.url, '/users');
+    assert.strictEqual(result.timeout, 5000);
+    assert.strictEqual(result.headers.common.Accept, 'application/json');
+    assert.strictEqual(result.headers.common['Content-Type'], 'application/json');
+  });
+});

