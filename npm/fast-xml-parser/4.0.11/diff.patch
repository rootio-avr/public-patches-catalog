+'use strict';
+
+const { XMLParser } = require("../src/fxp");
+
+// Regression test for CVE-2026-33036 (GHSA-8gc5-j5rx-235r).
+// Entity references were expanded without being counted, allowing an
+// entity-expansion (billion-laughs style) denial of service. When
+// processEntities is configured as an object with a maxTotalExpansions limit,
+// expansions must be counted for lastEntities and html entities too, and the
+// limit must be enforced. Mirrors upstream commit bd26122c
+// ("check for entitiy expansion for lastEntities and html entities too").
+describe("CVE-2026-33036 entity expansion limit", function () {
+
+  it("should throw when html entities exceed maxTotalExpansions", function () {
+    const entity = '&cent;'.repeat(30);
+    const xmlData = `<root>${entity}</root>`;
+
+    const options = {
+      htmlEntities: true,
+      processEntities: {
+        enabled: true,
+        maxTotalExpansions: 20,
+      },
+    };
+    const parser = new XMLParser(options);
+
+    expect(function () {
+      parser.parse(xmlData);
+    }).toThrowError(/Entity expansion limit exceeded: 30 > 20/);
+  });
+
+  it("should throw when standard (last) entities exceed maxTotalExpansions", function () {
+    const entity = '&lt;'.repeat(30);
+    const xmlData = `<root>${entity}</root>`;
+
+    const options = {
+      processEntities: {
+        enabled: true,
+        maxTotalExpansions: 20,
+      },
+    };
+    const parser = new XMLParser(options);
+
+    expect(function () {
+      parser.parse(xmlData);
+    }).toThrowError(/Entity expansion limit exceeded: 30 > 20/);
+  });
+
+  it("should still parse normally when within the expansion limit", function () {
+    const xmlData = `<root>&cent;&cent;</root>`;
+
+    const options = {
+      htmlEntities: true,
+      processEntities: {
+        enabled: true,
+        maxTotalExpansions: 20,
+      },
+    };
+    const parser = new XMLParser(options);
+    const result = parser.parse(xmlData);
+
+    expect(result.root).toEqual("¢¢");
+  });
+
+  it("should keep legacy boolean processEntities behavior (no limit)", function () {
+    const entity = '&cent;'.repeat(30);
+    const xmlData = `<root>${entity}</root>`;
+
+    const parser = new XMLParser({ htmlEntities: true, processEntities: true });
+
+    expect(function () {
+      parser.parse(xmlData);
+    }).not.toThrow();
+  });
+});
