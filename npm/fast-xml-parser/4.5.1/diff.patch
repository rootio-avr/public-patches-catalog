diff --git a/spec/cve-2026-26278_spec.js b/spec/cve-2026-26278_spec.js
new file mode 100644
index 0000000..44bf3dc
--- /dev/null
+++ b/spec/cve-2026-26278_spec.js
@@ -0,0 +1,80 @@
+"use strict";
+
+const { XMLParser } = require("../src/fxp");
+
+// Regression test for CVE-2026-26278 (GHSA-jmr7-xgp7-cmfj, CWE-776):
+// entity-expansion denial of service. The parser must enforce safety
+// limits (entity count, entity size, total expansions, expanded length)
+// while continuing to expand well-behaved entities.
+describe("CVE-2026-26278 entity expansion DoS", function () {
+    it("should still expand a normal, bounded set of entities", function () {
+        const xmlData =
+            `<?xml version="1.0"?>` +
+            `<!DOCTYPE note [` +
+            `<!ENTITY writer "Donald Duck.">` +
+            `<!ENTITY copyright "W3Schools.">` +
+            `]>` +
+            `<note><footer>&writer;&copyright;</footer></note>`;
+
+        const parser = new XMLParser({ processEntities: true });
+        const result = parser.parse(xmlData);
+        expect(result.note.footer).toEqual("Donald Duck.W3Schools.");
+    });
+
+    it("should reject too many declared entities (maxEntityCount)", function () {
+        let dtd = "<!DOCTYPE d [";
+        for (let i = 0; i < 200; i++) {
+            dtd += `<!ENTITY e${i} "v${i}">`;
+        }
+        dtd += "]>";
+        const xmlData = `${dtd}<d>&e1;</d>`;
+
+        const parser = new XMLParser({ processEntities: true });
+        expect(function () {
+            parser.parse(xmlData);
+        }).toThrowError(/Entity count .* exceeds maximum allowed/);
+    });
+
+    it("should reject an oversized entity value (maxEntitySize)", function () {
+        const huge = "B".repeat(20000);
+        const xmlData = `<!DOCTYPE d [<!ENTITY h "${huge}">]><d>&h;</d>`;
+
+        const parser = new XMLParser({ processEntities: true });
+        expect(function () {
+            parser.parse(xmlData);
+        }).toThrowError(/exceeds maximum allowed size/);
+    });
+
+    it("should reject an over-expanded value (maxExpandedLength / maxTotalExpansions)", function () {
+        const big = "A".repeat(5000);
+        let refs = "";
+        for (let i = 0; i < 300; i++) {
+            refs += "&big;";
+        }
+        const xmlData = `<!DOCTYPE d [<!ENTITY big "${big}">]><d>${refs}</d>`;
+
+        const parser = new XMLParser({ processEntities: true });
+        expect(function () {
+            parser.parse(xmlData);
+        }).toThrowError(/Entity expansion/);
+    });
+
+    it("should honor caller-supplied limits via the object form", function () {
+        const big = "A".repeat(5000);
+        let refs = "";
+        for (let i = 0; i < 300; i++) {
+            refs += "&big;";
+        }
+        const xmlData = `<!DOCTYPE d [<!ENTITY big "${big}">]><d>${refs}</d>`;
+
+        const parser = new XMLParser({
+            processEntities: {
+                maxEntitySize: 100000,
+                maxTotalExpansions: 100000,
+                maxExpandedLength: 100000000
+            }
+        });
+        const result = parser.parse(xmlData);
+        expect(result.d.length).toBeGreaterThan(1000000);
+    });
+});
