+/**
+ * Normalizes the processEntities option into a config object.
+ *
+ * Historically processEntities was a boolean. To defend against
+ * entity-expansion denial-of-service (CWE-776) the option is normalized
+ * into an object carrying safety limits while preserving backward
+ * compatibility for the boolean form.
+ *
+ * @param {boolean|object} value
+ * @returns {object} Always returns a normalized config object.
+ */
+function normalizeProcessEntities(value) {
+    // Boolean backward compatibility
+    if (typeof value === 'boolean') {
+        return {
+            enabled: value, // true or false
+            maxEntitySize: 10000,
+            maxExpansionDepth: 10,
+            maxTotalExpansions: 1000,
+            maxExpandedLength: 100000,
+            maxEntityCount: 100
+        };
+    }
+
+    // Object config - merge with defaults
+    if (typeof value === 'object' && value !== null) {
+        return {
+            enabled: value.enabled !== false, // default true if not specified
+            maxEntitySize: Math.max(1, value.maxEntitySize == null ? 10000 : value.maxEntitySize),
+            maxExpansionDepth: Math.max(1, value.maxExpansionDepth == null ? 10 : value.maxExpansionDepth),
+            maxTotalExpansions: Math.max(1, value.maxTotalExpansions == null ? 1000 : value.maxTotalExpansions),
+            maxExpandedLength: Math.max(1, value.maxExpandedLength == null ? 100000 : value.maxExpandedLength),
+            maxEntityCount: Math.max(1, value.maxEntityCount == null ? 100 : value.maxEntityCount)
+        };
+    }
+
+    // Default to enabled with limits
+    return normalizeProcessEntities(true);
+}
+
 const buildOptions = function(options) {
-    return Object.assign({}, defaultOptions, options);
+    const built = Object.assign({}, defaultOptions, options);
+    // Always normalize processEntities for backward compatibility and to
+    // enforce entity-expansion safety limits (CVE-2026-26278 / CWE-776).
+    built.processEntities = normalizeProcessEntities(built.processEntities);
+    return built;
 };
 
 exports.buildOptions = buildOptions;
