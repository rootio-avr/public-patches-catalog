+// Regression test for CVE-2026-13149 (GHSA-3jxr-9vmj-r5cp).
+// brace-expansion@5.0.5 publishes only the compiled `dist/` output, so this
+// replacement test exercises the shipped build directly instead of the
+// upstream `test/index.js` (which is not part of the published package).
+import assert from 'node:assert'
+import { expand } from '../dist/esm/index.js'
+
+// A run of non-expanding `{}` groups used to expand `post` once per group,
+// doubling the work on every group (O(2^n)) and, via unbounded recursion on
+// the `{a},b}` rewrite, could also exhaust the call stack. This 30-group input
+// must return quickly and expand to itself.
+{
+  const str =
+    'a{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}'
+  const start = performance.now()
+  const expanded = expand(str)
+  const elapsed = performance.now() - start
+  assert.deepStrictEqual(expanded, [str], 'does not expand')
+  assert.ok(elapsed < 1000, `expected ${elapsed}ms < 1000ms`)
+}
+
+// A single huge numeric sequence must respect `max` and stay fast.
+{
+  const start = performance.now()
+  const expanded = expand('{1..100000000}', { max: 10 })
+  const elapsed = performance.now() - start
+  assert.strictEqual(expanded.length, 10, 'sequence expansion is bounded')
+  assert.ok(elapsed < 500, `expected ${elapsed}ms < 500ms`)
+}
+
+// Ordinary expansions must still behave correctly after the fix.
+assert.deepStrictEqual(expand('a{b,c}d'), ['abd', 'acd'])
+assert.deepStrictEqual(expand('{1..5}'), ['1', '2', '3', '4', '5'])
+assert.deepStrictEqual(expand('{3..1}'), ['3', '2', '1'])
+assert.deepStrictEqual(expand('{a,b{1..3},c}'), ['a', 'b1', 'b2', 'b3', 'c'])
+assert.deepStrictEqual(expand('a{},b}c'), ['a}c', 'abc'])
+assert.deepStrictEqual(
+  expand('{{A..Z},{a..z}}'),
+  'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'.split(''),
+)
+
+console.log('CVE-2026-13149 regression test passed')

