+++ b/test/cve-2026-102278.test.js
@@ -0,0 +1,45 @@
+import t from 'tap'
+import { expand } from '../dist/esm/index.js'
+
+// CVE-2026-102278 / GHSA-qhr7-859c-m2p7: expand_ recursed once per level of
+// brace nesting, so a few KB of `{{{...a,b...}}}` exhausted the native stack
+// and crashed the process. The max/maxLength bounds cannot help because the
+// crash happens before the result set grows; `maxDepth` bounds the nesting.
+t.test('deep nesting does not overflow the stack', async t => {
+  // A set nested inside every comma member.
+  const members = '{a,'.repeat(10_000) + 'z' + '}'.repeat(10_000)
+  t.doesNotThrow(() => {
+    t.ok(expand(members).length > 0, 'comma members still return a result')
+  })
+
+  // A set whose body parses to a single part, nested all the way down.
+  const single = '{'.repeat(10_000) + 'a,b' + '}'.repeat(10_000)
+  t.doesNotThrow(() => {
+    t.ok(expand(single).length > 0, 'single set still returns a result')
+  })
+
+  t.doesNotThrow(
+    () => expand(single, { max: 1, maxLength: 1 }),
+    'still safe with both output bounds at their lowest',
+  )
+})
+
+t.test('maxDepth option bounds nesting depth', async t => {
+  // A flat set never needs any depth.
+  t.strictSame(expand('{a,b}', { maxDepth: 0 }), ['a', 'b'])
+
+  // Below the bound the result is exactly what an unbounded expansion gives.
+  for (const str of ['{a,b}', '{{a,b}}', '{a,{b,c}}', 'x{{a,b}}y']) {
+    t.strictSame(
+      expand(str, { maxDepth: 50 }),
+      expand(str),
+      `${str} is unchanged below the bound`,
+    )
+  }
+  t.strictSame(expand('{a,{b,c}}'), ['a', 'b', 'c'])
+
+  // Past the bound the group comes back literal rather than throwing.
+  t.strictSame(expand('{{a,b}}', { maxDepth: 0 }), ['{{a,b}}'])
+  t.strictSame(expand('x{{a,b}}y', { maxDepth: 0 }), ['x{{a,b}}y'])
+  t.strictSame(expand('{a,{b,c}}', { maxDepth: 0 }), ['a', '{b,c}'])
+})
