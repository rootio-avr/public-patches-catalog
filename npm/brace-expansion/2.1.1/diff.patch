+++ b/test/max-length.js
@@ -0,0 +1,53 @@
+var test = require('tape');
+var expand = require('..');
+
+// CVE-2026-14257: the `max` option caps the *number* of expansions but not
+// their length. Chaining many brace groups (e.g. `'{a,b}'.repeat(1500)`) keeps
+// the count under `max` while each result grows with the number of groups.
+// Building the long results, plus the intermediate arrays combined along the
+// way, exhausted memory and crashed the process with an uncatchable
+// out-of-memory error. The fix bounds the total accumulated output length.
+test('total expansion length is bounded (CVE-2026-14257)', function(t) {
+  var str = new Array(1500 + 1).join('{a,b}');
+  var startTime = Date.now();
+  var expanded = expand(str);
+  var timeTaken = Date.now() - startTime;
+
+  var totalLength = expanded.reduce(function(sum, s) {
+    return sum + s.length;
+  }, 0);
+
+  t.ok(
+    totalLength <= 4000000,
+    'total expansion length (' + totalLength + ') is bounded to 4,000,000'
+  );
+  t.ok(expanded.length > 0, 'still returns a (truncated) result');
+  t.ok(
+    expanded.every(function(s) { return /^[ab]*$/.test(s); }),
+    'results are valid expansions'
+  );
+  t.ok(
+    timeTaken < 10000,
+    'completes quickly (' + timeTaken + 'ms) instead of exhausting memory'
+  );
+  t.end();
+});
+
+test('maxLength option bounds output (CVE-2026-14257)', function(t) {
+  var str = new Array(1500 + 1).join('{a,b}');
+  var expanded = expand(str, { maxLength: 100 });
+  var totalLength = expanded.reduce(function(sum, s) {
+    return sum + s.length;
+  }, 0);
+  t.ok(
+    totalLength <= 100,
+    'custom maxLength caps total output length (' + totalLength + ' <= 100)'
+  );
+  t.end();
+});
+
+test('short input is unaffected by the length bound', function(t) {
+  t.deepEqual(expand('a{b,c}d'), ['abd', 'acd'], 'basic expansion preserved');
+  t.deepEqual(expand('{a,b{1..3},c}'), ['a', 'b1', 'b2', 'b3', 'c'], 'nested preserved');
+  t.end();
+});

