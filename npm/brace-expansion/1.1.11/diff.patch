+  // Below the bound the result is exactly what an unbounded expansion produces.
+  var cases = ['{a,b}', '{{a,b}}', '{{{a,b}}}', '{a,{b,c}}', '{a,{b,{c,d}}}', 'x{{a,b}}y']
+  for (var i = 0; i < cases.length; i++) {
