--- /dev/null
+++ b/test/cve-2026-14257.js
@@ -0,0 +1,69 @@
+var test = require('tape');
+var expand = require('..');
+
+// CVE-2026-14257 (GHSA-mh99-v99m-4gvg, CWE-400):
+// Chaining many brace groups keeps the number of results small while each
+// result grows with the number of groups. Building the full result set (and
+// the intermediate arrays combined along the way) exhausted memory and crashed
+// the process with an uncatchable out-of-memory error. The fix threads a single
+// accumulator through expand() and bounds the total number of characters it may
+// hold (maxLength, default 4,000,000), truncating output instead of letting it
+// grow without bound. The tail is expanded iteratively so deeply chained input
+// no longer overflows the stack.
+
+test('CVE-2026-14257: total expansion length is bounded', function(t) {
+  var str = new Array(1501).join('{a,b}'); // '{a,b}'.repeat(1500)
+  var start = Date.now();
+  var expanded = expand(str);
+  var elapsed = Date.now() - start;
+
+  var totalLength = expanded.reduce(function(sum, s) { return sum + s.length; }, 0);
+  t.ok(totalLength <= 4000000,
+    'Expected total length (' + totalLength + ') to be bounded');
+  t.ok(expanded.length > 0, 'still returns a (truncated) result');
+  t.ok(expanded.every(function(s) { return /^[ab]+$/.test(s); }),
+    'results are valid expansions');
+  t.ok(elapsed < 5000,
+    'Expected time (' + elapsed + 'ms) to be less than 5000ms');
+  t.end();
+});
+
+test('CVE-2026-14257: bound holds regardless of group count', function(t) {
+  // The bound is a single accumulator, not a per-level limit, so it holds no
+  // matter how many brace groups are chained - not groups * maxLength.
+  [100, 1500, 5000].forEach(function(groups) {
+    var total = expand(new Array(groups + 1).join('{a,b}')).reduce(
+      function(sum, s) { return sum + s.length; }, 0);
+    t.ok(total <= 4000000,
+      'Expected total length (' + total + ') to stay bounded at ' + groups + ' groups');
+  });
+  t.end();
+});
+
+test('CVE-2026-14257: deep chaining does not overflow the stack', function(t) {
+  var str = new Array(50001).join('{a,b}'); // '{a,b}'.repeat(50000)
+  t.doesNotThrow(function() {
+    var expanded = expand(str);
+    t.ok(expanded.length > 0, 'still returns a (truncated) result');
+    t.ok(expanded.reduce(function(sum, s) { return sum + s.length; }, 0) <= 4000000,
+      'output stays bounded');
+  });
+  t.end();
+});
+
+test('CVE-2026-14257: maxLength option bounds output size', function(t) {
+  var str = new Array(1501).join('{a,b}');
+  var expanded = expand(str, { maxLength: 100000 });
+  var totalLength = expanded.reduce(function(sum, s) { return sum + s.length; }, 0);
+  t.ok(totalLength <= 100000,
+    'Expected total length (' + totalLength + ') to respect maxLength');
+
+  // The `${...}` literal branch combines its body with the expanded tail and
+  // must be bounded the same way.
+  var dollar = '${x}' + new Array(21).join('{a,b}');
+  var expandedDollar = expand(dollar, { maxLength: 100000 });
+  var dollarLength = expandedDollar.reduce(function(sum, s) { return sum + s.length; }, 0);
+  t.ok(dollarLength <= 100000,
+    'Expected total length (' + dollarLength + ') to respect maxLength');
+  t.end();
+});

