+++ b/test/cve-2026-14257.js
@@ -0,0 +1,53 @@
+var test = require('tape');
+var expand = require('..');
+
+var EXPANSION_MAX_LENGTH = 4000000;
+
+function totalLength(arr) {
+  return arr.reduce(function (sum, value) {
+    return sum + value.length;
+  }, 0);
+}
+
+test('CVE-2026-14257 bounds total expansion length', function (t) {
+  var expanded = expand(new Array(1500 + 1).join('{a,b}'));
+
+  t.ok(expanded.length > 0, 'returns a truncated expansion');
+  t.ok(
+    totalLength(expanded) <= EXPANSION_MAX_LENGTH,
+    'total output length stays within the default limit'
+  );
+  t.ok(
+    expanded.every(function (value) { return /^[ab]+$/.test(value); }),
+    'truncated results remain valid expansions'
+  );
+  t.end();
+});
+
+test('CVE-2026-14257 supports a custom length limit', function (t) {
+  t.deepEqual(
+    expand('{a,b}{c,d}', { maxLength: 3 }),
+    ['ac'],
+    'stops before the accumulator exceeds maxLength'
+  );
+  t.end();
+});
+
+test('existing max result-count option remains enforced', function (t) {
+  var expanded = expand('{a,b}{c,d}', { max: 3 });
+  t.equal(expanded.length, 3, 'returns no more than max results');
+  t.end();
+});
+
+test('deep brace chains do not overflow the stack', function (t) {
+  var input = new Array(3000 + 1).join('{a,b}');
+  t.doesNotThrow(function () {
+    var expanded = expand(input);
+    t.ok(expanded.length > 0, 'returns a truncated expansion');
+    t.ok(
+      totalLength(expanded) <= EXPANSION_MAX_LENGTH,
+      'deep-chain output remains bounded'
+    );
+  });
+  t.end();
+});
