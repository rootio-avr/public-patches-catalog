+var test = require('tape');
+var expand = require('..');
+
+// CVE-2026-69152 (GHSA-mh99-v99m-4gvg): `max` caps the *number* of results but
+// not their total length, so chaining many brace groups keeps the count under
+// the cap while each result grows with the number of groups. Building large
+// long results (and the intermediate arrays combined along the way) exhausted
+// memory and could crash the process. The fix bounds the total number of
+// characters across all expansions (default 4,000,000).
+test('total expansion length is bounded', function (t) {
+  var str = '{a,b}'.repeat(1500);
+  var startTime = Date.now();
+  var expanded = expand(str);
+  var duration = Date.now() - startTime;
+
+  var totalLength = expanded.reduce(function (sum, s) { return sum + s.length; }, 0);
+  t.ok(totalLength <= 4000000, 'total length (' + totalLength + ') is bounded');
+  t.ok(expanded.length > 0, 'still returns a (truncated) result');
+  t.ok(
+    expanded.every(function (s) { return /^[ab]+$/.test(s); }),
+    'results are valid expansions'
+  );
+  t.ok(duration < 5000, 'expansion completes quickly (' + duration + 'ms)');
+
+  // The bound is a single accumulator, not a per-level limit, so it holds no
+  // matter how many brace groups are chained.
+  [100, 1500, 5000].forEach(function (groups) {
+    var total = expand('{a,b}'.repeat(groups)).reduce(
+      function (sum, s) { return sum + s.length; },
+      0
+    );
+    t.ok(total <= 4000000, 'stays bounded at ' + groups + ' groups (' + total + ')');
+  });
+
+  t.end();
+});
+
+test('deep chaining does not overflow the stack', function (t) {
+  var str = '{a,b}'.repeat(50000);
+  t.doesNotThrow(function () {
+    var expanded = expand(str);
+    t.ok(expanded.length > 0, 'still returns a (truncated) result');
+    t.ok(
+      expanded.reduce(function (sum, s) { return sum + s.length; }, 0) <= 4000000,
+      'output stays bounded'
+    );
+  });
+  t.end();
+});
+
+test('maxLength option bounds output size', function (t) {
+  var str = '{a,b}'.repeat(1500);
+  var expanded = expand(str, { maxLength: 100000 });
+  var totalLength = expanded.reduce(function (sum, s) { return sum + s.length; }, 0);
+  t.ok(totalLength <= 100000, 'total length (' + totalLength + ') respects maxLength');
+  t.end();
+});
