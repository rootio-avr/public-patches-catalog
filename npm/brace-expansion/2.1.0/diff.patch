+import test from 'node:test'
+import assert from 'assert'
+import expand from '../index.js'
+
+// CVE-2026-69152 / GHSA-rgw5-rvv9-x895: the CVE-2026-14257 mitigation only
+// bounded each comma-separated alternative's own output, not the running total
+// accumulated across all of them. Many alternatives - each individually far
+// under `maxLength` - could still sum to an unbounded intermediate array.
+test('total length across comma alternatives is bounded', function () {
+  const alt = '{1..5}'
+  const str = '{' + Array(1000).fill(alt).join(',') + '}'
+  const startTime = performance.now()
+  const expanded = expand(str, { maxLength: 50 })
+  const timeTaken = performance.now() - startTime
+
+  const totalLength = expanded.reduce((sum, s) => sum + s.length, 0)
+  assert.ok(totalLength <= 50, `Expected total length (${totalLength}) to respect maxLength`)
+  assert.ok(expanded.length > 0, 'still returns a (truncated) result')
+  assert.ok(timeTaken < 1000, `Expected time (${timeTaken}ms) to be less than 1000ms`)
+})
+
+// Bounding the intermediate `values` array must not change what `max` counts:
+// alternatives that expand to nothing are dropped, so they cost a slot in
+// `values` but must never count as a kept result.
+test('max bounds the number of kept results', function () {
+  assert.deepStrictEqual(
+    expand('{a,,b}', { max: 2 }),
+    ['a', 'b'],
+    'dropped empty alternatives do not count against max'
+  )
+  assert.deepStrictEqual(
+    expand('{a,,,b,c}', { max: 3 }),
+    ['a', 'b', 'c'],
+    'consecutive empty alternatives do not count against max'
+  )
+  // Here the empties survive as `xy`, so they are results and do count.
+  assert.deepStrictEqual(
+    expand('x{a,,b}y', { max: 2 }),
+    ['xay', 'xy'],
+    'kept empty alternatives still count against max'
+  )
+})
+
+// Truncating early must not change results that fit within the bound.
+test('input under the bound is unaffected', function () {
+  assert.deepStrictEqual(
+    expand('{01..10}'),
+    ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10'],
+    'padded sequences under the bound are unaffected'
+  )
+})
