+import t from 'tap'
+import { expand } from '../dist/esm/index.js'
+
+// CVE-2026-102276 / GHSA-6j4f-fj2g-mc7p: parseCommaParts recursed once per
+// brace group and used push.apply, so large/chained comma sets overflowed the
+// stack while parsing.
+t.test('deeply chained comma groups do not overflow the stack', async t => {
+  const str = '{' + '{a},'.repeat(50_000) + 'b}'
+  t.doesNotThrow(() => {
+    const expanded = expand(str)
+    t.ok(expanded.length > 0, 'still returns a result')
+  })
+  t.doesNotThrow(
+    () => expand(str, { max: 1 }),
+    'still safe with max set as low as it goes',
+  )
+})
+
+t.test('a large comma set does not overflow the stack', async t => {
+  const str = '{{x},' + 'a,'.repeat(200_000) + 'b}'
+  t.doesNotThrow(() => {
+    const expanded = expand(str)
+    t.ok(expanded.length > 0, 'still returns a (truncated) result')
+  })
+})
+
+t.test('nested comma parts still expand correctly', async t => {
+  t.same(expand('{a,{b,c},d}'), ['a', 'b', 'c', 'd'])
+  t.same(expand('{a{b,c}d,e}f'), ['abdf', 'acdf', 'ef'])
+})

