+++ b/tests/test-reject-unauthorized.js
@@ -0,0 +1,36 @@
+// Regression test for CVE-2021-31597: rejectUnauthorized must default to true
+var assert = require("assert")
+  , https = require("https")
+  , XMLHttpRequest = require("../lib/XMLHttpRequest").XMLHttpRequest
+  , originalRequest = https.request;
+
+function capture(opts) {
+  var captured = null;
+  https.request = function(options) {
+    captured = options;
+    return {
+      on: function() { return this; },
+      write: function() {},
+      end: function() {},
+      setHeader: function() {}
+    };
+  };
+  try {
+    var xhr = new XMLHttpRequest(opts);
+    xhr.open("GET", "https://localhost:1/");
+    try { xhr.send(); } catch (e) {}
+  } finally {
+    https.request = originalRequest;
+  }
+  assert.ok(captured, "https.request should have been called");
+  return captured.rejectUnauthorized;
+}
+
+// Default (no option) must verify certificates
+assert.strictEqual(capture(), true);
+assert.strictEqual(capture({}), true);
+assert.strictEqual(capture({ rejectUnauthorized: true }), true);
+// Explicit opt-out is still honoured
+assert.strictEqual(capture({ rejectUnauthorized: false }), false);
+
+console.log("Done");
