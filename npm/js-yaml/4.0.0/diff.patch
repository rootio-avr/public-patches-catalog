 function resolveYamlOmap(data) {
   if (data === null) return true;

-  var objectKeys = [], index, length, pair, pairKey, pairHasKey,
+  var objectKeys = {}, index, length, pair, pairKey, pairHasKey,
       object = data;

   for (index = 0, length = object.length; index < length; index += 1) {
@@ -26,8 +26,8 @@ function resolveYamlOmap(data) {

     if (!pairHasKey) return false;

-    if (objectKeys.indexOf(pairKey) === -1) objectKeys.push(pairKey);
-    else return false;
+    if (_hasOwnProperty.call(objectKeys, pairKey)) return false;
+    Object.defineProperty(objectKeys, pairKey, { value: true });
   }

   return true;
--- /dev/null
+++ b/test/units/omap-quadratic-complexity.js
@@ -0,0 +1,45 @@
+'use strict';
+
+
+var assert = require('assert');
+var yaml   = require('../../');
+
+
+// Regression test for GHSA-5p4m-2wfm-xmqj:
+// duplicate-key detection for `!!omap` must not be quadratic, and must still
+// correctly accept unique-key omaps and reject duplicate-key omaps.
+describe('omap quadratic complexity (GHSA-5p4m-2wfm-xmqj)', function () {
+  it('accepts an omap with many unique keys quickly', function () {
+    this.timeout(5000);
+
+    var lines = [ '--- !!omap' ];
+    var count = 20000;
+    for (var i = 0; i < count; i += 1) {
+      lines.push('- k' + i + ': ' + i);
+    }
+
+    var start = Date.now();
+    var result = yaml.load(lines.join('\n'));
+    var elapsed = Date.now() - start;
+
+    assert.strictEqual(result.length, count);
+    // With the O(n^2) scan this took many seconds; the fixed O(n) path is
+    // comfortably under this generous bound.
+    assert.ok(elapsed < 3000, 'omap resolution took too long: ' + elapsed + 'ms');
+  });
+
+  it('still rejects an omap containing duplicate keys', function () {
+    assert.throws(function () {
+      yaml.load('--- !!omap\n- foo: 1\n- foo: 2\n');
+    }, yaml.YAMLException);
+  });
+
+  it('is not confused by keys named like Object.prototype members', function () {
+    var result = yaml.load('--- !!omap\n- hasOwnProperty: 1\n- toString: 2\n');
+    assert.strictEqual(result.length, 2);
+
+    assert.throws(function () {
+      yaml.load('--- !!omap\n- hasOwnProperty: 1\n- hasOwnProperty: 2\n');
+    }, yaml.YAMLException);
+  });
+});
