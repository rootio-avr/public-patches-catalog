Backport merge limits from v5.4.1 (CVE-2026-84375)

Bound the work performed while resolving YAML merge keys ("<<") so that a
document consisting of long sequences of empty/aliased mappings cannot force
quadratic/unbounded work (CWE-400 denial of service). Each source mapping is
now itself charged against maxTotalMergeKeys, and abnormally large merge
sequences are rejected outright.

--- a/lib/js-yaml/loader.js
+++ b/lib/js-yaml/loader.js
@@ -283,6 +283,14 @@ function captureSegment(state, start, end, checkJson) {
   }
 }

+function chargeMergeWork(state) {
+  state.totalMergeKeys += 1;
+
+  if (state.maxTotalMergeKeys !== -1 && state.totalMergeKeys > state.maxTotalMergeKeys) {
+    throwError(state, 'merge keys exceeded maxTotalMergeKeys (' + state.maxTotalMergeKeys + ')');
+  }
+}
+
 function mergeMappings(state, destination, source, overridableKeys) {
   var sourceKeys, key, index, quantity;

