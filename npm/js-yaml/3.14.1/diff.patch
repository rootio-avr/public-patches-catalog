--- /dev/null
+++ b/test/units/cve-2026-84375.test.js
@@ -0,0 +1,78 @@
+'use strict';
+
+// Regression test for CVE-2026-84375: js-yaml merge keys (<<) allowed
+// unbounded CPU usage. maxTotalMergeKeys now counts every merge source
+// (including empty mappings) via chargeMergeWork(), and an abnormally large
+// merge sequence is rejected outright.
+
+var assert = require('assert');
+var yaml = require('../..');
+
+
+function merge(n) {
+  var anchors = [];
+  var refs = [];
+  var i;
+
+  for (i = 0; i < n; i++) {
+    anchors.push('- &x' + i + ' {a' + i + ': ' + i + '}');
+    refs.push('*x' + i);
+  }
+
+  return anchors.join('\n') + '\n- <<: [' + refs.join(', ') + ']\n';
+}
+
+
+suite('CVE-2026-84375 - merge key CPU limits', function () {
+  test('maxTotalMergeKeys caps total merge keys', function () {
+    assert.doesNotThrow(function () {
+      yaml.safeLoad(merge(3), { maxTotalMergeKeys: 6 });
+    });
+
+    assert.throws(function () {
+      yaml.safeLoad(merge(3), { maxTotalMergeKeys: 2 });
+    }, /maxTotalMergeKeys/);
+  });
+
+  test('maxTotalMergeKeys = -1 disables the limit', function () {
+    assert.doesNotThrow(function () {
+      yaml.safeLoad(merge(3), { maxTotalMergeKeys: -1 });
+    });
+  });
+
+  test('empty merge sources are still counted', function () {
+    // A long sequence of empty-mapping merge sources previously bypassed the
+    // limit because no keys were copied. Each source must now be charged.
+    var anchors = [];
+    var refs = [];
+    var i;
+
+    for (i = 0; i < 50; i++) {
+      anchors.push('- &e' + i + ' {}');
+      refs.push('*e' + i);
+    }
+
+    var src = anchors.join('\n') + '\n- <<: [' + refs.join(', ') + ']\n';
+
+    assert.throws(function () {
+      yaml.safeLoad(src, { maxTotalMergeKeys: 10 });
+    }, /maxTotalMergeKeys/);
+  });
+
+  test('abnormally large merge sequence is rejected', function () {
+    var anchors = [];
+    var refs = [];
+    var i;
+
+    for (i = 0; i < 200; i++) {
+      anchors.push('- &y' + i + ' {b' + i + ': ' + i + '}');
+      refs.push('*y' + i);
+    }
+
+    var src = anchors.join('\n') + '\n- <<: [' + refs.join(', ') + ']\n';
+
+    assert.throws(function () {
+      yaml.safeLoad(src, { maxTotalMergeKeys: -1 });
+    }, /abnormal merge sequence size/);
+  });
+});
