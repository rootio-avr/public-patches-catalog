@@ -0,0 +1,78 @@
+'use strict';
+
+// Regression test for CVE-2026-59869: unbounded YAML merge (`<<`) key
+// expansion allows a small document to explode into a huge number of merged
+// keys (algorithmic complexity / memory-amplification DoS). The fix adds a
+// `maxTotalMergeKeys` loader option (default 10000) that caps the total number
+// of keys processed by merge across a single load call.
+//
+// NOTE: this is a replacement test authored for target js-yaml 3.13.1. The
+// upstream test (test/units/loader-parameters.js) is not shipped in the 3.13.1
+// tree and relies on the 2-arg `safeLoadAll(input, options)` form that only
+// exists from 3.14.0 onward. This test uses the 3.13.1 public API: the 2-arg
+// `safeLoad(input, options)` form and the 3-arg
+// `safeLoadAll(input, iterator, options)` form.
+
+var assert = require('assert');
+var yaml   = require('../../');
+
+// Build a document with `n` anchored one-key mappings all merged into a final
+// mapping via a merge sequence, producing `n` merged keys.
+function merge(n) {
+  var anchors = [];
+  var refs = [];
+  var i;
+
+  for (i = 0; i < n; i++) {
+    anchors.push('- &x' + i + ' {a' + i + ': ' + i + '}');
+    refs.push('*x' + i);
+  }
+
+  return anchors.join('\n') + '\n- <<: [' + refs.join(', ') + ']\n';
+}
+
+suite('CVE-2026-59869 maxTotalMergeKeys', function () {
+  test('allows loads under the cap', function () {
+    assert.doesNotThrow(function () {
+      yaml.safeLoad(merge(3), { maxTotalMergeKeys: 5 });
+    });
+  });
+
+  test('throws when the total merge keys exceed the cap', function () {
+    assert.throws(function () {
+      yaml.safeLoad(merge(3), { maxTotalMergeKeys: 2 });
+    }, /maxTotalMergeKeys/);
+  });
+
+  test('cap of -1 disables the limit', function () {
+    assert.doesNotThrow(function () {
+      yaml.safeLoad(merge(3), { maxTotalMergeKeys: -1 });
+    });
+  });
+
+  test('default cap (10000) permits reasonable documents', function () {
+    assert.doesNotThrow(function () {
+      yaml.safeLoad(merge(50));
+    });
+  });
+
+  test('safeLoadAll shares the cap across all documents', function () {
+    var src = [
+      '---',
+      'a: &a { k1: 1, k2: 2 }',
+      'b: { <<: *a }',
+      '---',
+      'a: &a2 { k1: 1, k2: 2 }',
+      'b: { <<: *a2 }',
+      ''
+    ].join('\n');
+
+    // 3-arg form (iterator + options) is the 3.13.1-compatible API.
+    assert.doesNotThrow(function () {
+      yaml.safeLoadAll(src, function () {}, { maxTotalMergeKeys: 4 });
+    });
+    assert.throws(function () {
+      yaml.safeLoadAll(src, function () {}, { maxTotalMergeKeys: 3 });
+    }, /maxTotalMergeKeys/);
+  });
+});

