@@ -0,0 +1,33 @@
+'use strict';
+
+
+var assert = require('assert');
+var yaml = require('../../');
+
+
+// Regression test for GHSA-5p4m-2wfm-xmqj:
+// quadratic (O(n^2)) complexity in !!omap duplicate-key detection.
+// The fix replaces the linear Array#indexOf scan with an O(1) object
+// property lookup, so a large omap with all-unique keys must still
+// resolve quickly, while duplicate keys must be rejected.
+test('GHSA-5p4m-2wfm-xmqj: large !!omap with unique keys resolves', function () {
+  var n = 20000;
+  var lines = ['--- !!omap'];
+  for (var i = 0; i < n; i += 1) {
+    lines.push('- key' + i + ': ' + i);
+  }
+
+  var data = yaml.safeLoad(lines.join('\n'));
+
+  assert.ok(Array.isArray(data));
+  assert.strictEqual(data.length, n);
+  assert.deepStrictEqual(data[0], { key0: 0 });
+  assert.deepStrictEqual(data[n - 1], { ['key' + (n - 1)]: n - 1 });
+});
+
+
+test('GHSA-5p4m-2wfm-xmqj: duplicate !!omap keys are rejected', function () {
+  assert.throws(function () {
+    yaml.safeLoad('--- !!omap\n- foo: 1\n- foo: 2\n');
+  }, yaml.YAMLException);
+});
