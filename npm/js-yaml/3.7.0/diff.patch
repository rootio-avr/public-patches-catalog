@@ -0,0 +1,43 @@
+'use strict';
+
+
+var assert = require('assert');
+var yaml   = require('../../');
+
+
+// GHSA-5p4m-2wfm-xmqj: quadratic complexity in !!omap duplicate-key
+// detection. The original resolver used an array with Array#indexOf for
+// the seen-key check, which is O(n^2) over the number of pairs and lets
+// a small YAML document consume disproportionate CPU. The fix switches
+// the bookkeeping to a plain object (O(1) hasOwnProperty lookups) while
+// still rejecting duplicate keys.
+suite('GHSA-5p4m-2wfm-xmqj', function () {
+  test('!!omap with many unique keys resolves quickly (no quadratic blowup)', function () {
+    var count = 20000;
+    var lines = [ '--- !!omap' ];
+    for (var i = 0; i < count; i += 1) {
+      lines.push('- k' + i + ': ' + i);
+    }
+    var source = lines.join('\n') + '\n';
+
+    var start = Date.now();
+    var result = yaml.safeLoad(source);
+    var elapsed = Date.now() - start;
+
+    assert.strictEqual(result.length, count);
+    // A quadratic implementation would take many seconds for 20k pairs;
+    // the linear implementation finishes well under this bound.
+    assert.ok(elapsed < 5000, 'omap resolution took too long: ' + elapsed + 'ms');
+  });
+
+  test('!!omap still rejects duplicate keys', function () {
+    assert.throws(function () {
+      yaml.safeLoad('--- !!omap\n- foo: 1\n- foo: 2\n');
+    }, yaml.YAMLException);
+  });
+
+  test('!!omap with unique keys loads correctly', function () {
+    var result = yaml.safeLoad('--- !!omap\n- foo: 1\n- bar: 2\n');
+    assert.deepStrictEqual(result, [ { foo: 1 }, { bar: 2 } ]);
+  });
+});
