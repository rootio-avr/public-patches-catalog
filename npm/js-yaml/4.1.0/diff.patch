+++ b/test/issues/ghsa-5p4m-2wfm-xmqj.js
@@ -0,0 +1,45 @@
+'use strict';
+
+
+var assert = require('assert');
+var yaml = require('../../');
+
+
+// GHSA-5p4m-2wfm-xmqj: quadratic complexity in !!omap duplicate key detection.
+// resolveYamlOmap used Array.prototype.indexOf for uniqueness checks, which is
+// O(n) per key and O(n^2) overall, letting a crafted omap with many unique keys
+// cause a denial of service. The fix uses an object as a hash set so lookups are
+// O(1). These tests assert both correctness and that a large unique omap resolves
+// quickly.
+describe('GHSA-5p4m-2wfm-xmqj', function () {
+  it('accepts an omap with many unique keys quickly (no quadratic blowup)', function () {
+    this.timeout(5000);
+
+    var lines = ['--- !!omap'];
+    var count = 20000;
+    for (var i = 0; i < count; i += 1) {
+      lines.push('- key' + i + ': ' + i);
+    }
+    var doc = lines.join('\n') + '\n';
+
+    var start = Date.now();
+    var result = yaml.load(doc);
+    var elapsed = Date.now() - start;
+
+    assert.strictEqual(result.length, count);
+    // A linear implementation handles this in well under a second; the previous
+    // quadratic implementation would take orders of magnitude longer.
+    assert.ok(elapsed < 3000, 'omap resolution took too long: ' + elapsed + 'ms');
+  });
+
+  it('still rejects an omap with duplicate keys', function () {
+    assert.throws(function () {
+      yaml.load('--- !!omap\n- foo: 1\n- foo: 2\n');
+    }, yaml.YAMLException);
+  });
+
+  it('still accepts a valid small omap', function () {
+    var result = yaml.load('--- !!omap\n- a: 1\n- b: 2\n');
+    assert.deepStrictEqual(result, [ { a: 1 }, { b: 2 } ]);
+  });
+});
