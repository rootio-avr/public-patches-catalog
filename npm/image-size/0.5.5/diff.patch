Description: Fix CVE-2025-71329 - defensive forward-progress guard against CWE-835 infinite loop
 The reported vulnerability is a CWE-835 infinite loop in the JXL/HEIF ISO-BMFF
 box parser: a crafted buffer whose recognized box declares a zero-valued size
 makes the parser offset never advance, spinning the loop forever and blocking
 the Node.js event loop. That box parser does not exist in image-size 0.5.5.
 The structurally-equivalent attacker-controlled parse loop in this tree is
 lib/types/jpg.js calculate(), which reads a per-block size from image bytes and
 advances the buffer by it each iteration. This patch adds an explicit
 forward-progress invariant: if the buffer does not strictly shrink after
 advancing, the parser throws instead of looping, eliminating the CWE-835
 infinite-loop class defensively while leaving valid JPEG parsing unchanged.
Origin: ai-synthesized, CVE-2025-71329
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-08-11

--- a/lib/types/jpg.js
+++ b/lib/types/jpg.js
@@ -33,7 +33,7 @@ function calculate (buffer) {
   // Skip 4 chars, they are for signature
   buffer = buffer.slice(4);

-  var i, next;
+  var i, next, prevLength;
   while (buffer.length) {
     // read length of the next block
     i = buffer.readUInt16BE(0);
@@ -48,8 +48,13 @@ function calculate (buffer) {
     if (next === 0xC0 || next === 0xC1 || next === 0xC2) {
       return extractSize(buffer, i + 5);
     }

-    // move to the next block
+    // move to the next block, and guard against a crafted size field that
+    // fails to advance the parser offset (CWE-835 infinite loop).
+    prevLength = buffer.length;
     buffer = buffer.slice(i + 2);
+    if (buffer.length >= prevLength) {
+      throw new TypeError('Invalid JPG, parser made no progress');
+    }
   }

   throw new TypeError('Invalid JPG, no size found');
--- /dev/null
+++ b/specs/cve-2025-71329.spec.js
@@ -0,0 +1,50 @@
+'use strict';
+
+// Regression test for CVE-2025-71329 (CWE-835 infinite loop).
+//
+// The reported vulnerability is an infinite loop in a length-prefixed
+// container parser where a zero-valued size field prevents the parser offset
+// from advancing. The JXL/HEIF box parser that carries the upstream bug does
+// not exist in image-size 0.5.5; the structurally-equivalent attacker-
+// controlled parse loop in this tree is lib/types/jpg.js calculate(). The
+// patch adds a forward-progress invariant so the loop can never spin forever.
+//
+// This test asserts (a) a crafted JPEG-like buffer terminates (throws) instead
+// of hanging, and (b) a well-formed baseline SOF0 buffer still parses.
+
+var expect = require('expect.js');
+var jpg = require('../lib/types/jpg');
+
+describe('CVE-2025-71329 - JPG parser forward-progress guard', function () {
+
+  it('terminates (throws TypeError) on a crafted buffer instead of looping forever', function () {
+    // After slice(4): block length i=0 and buffer[0] !== 0xFF, so the parser
+    // must reject rather than spin on a non-advancing offset.
+    var crafted = new Buffer([
+      0xFF, 0xD8, 0xFF, 0xE0, // SOI + skipped signature
+      0x00, 0x00, 0x00, 0x00, // block length = 0, marker byte not 0xFF
+      0x00, 0x00, 0x00, 0x00
+    ]);
+    expect(function () { jpg.calculate(crafted); }).to.throwException(function (e) {
+      expect(e).to.be.a(TypeError);
+    });
+  });
+
+  it('still parses a well-formed baseline (SOF0) JPEG buffer', function () {
+    // After slice(4) the block length i = 4; buffer[4]=0xFF, buffer[5]=0xC0
+    // (SOF0). extractSize reads height at i+5 (=9) and width at i+7 (=11).
+    var valid = new Buffer([
+      0xFF, 0xD8, 0xFF, 0xE0, // 0-3  SOI + skipped signature
+      0x00, 0x04,             // 4-5  block length = 4  (sliced index 0-1)
+      0x00, 0x00,             // 6-7  padding           (sliced index 2-3)
+      0xFF, 0xC0,             // 8-9  SOF0 marker        (sliced index 4-5)
+      0x00, 0x00,             // 10-11 precision/pad     (sliced index 6-7)
+      0x00,                   // 12                       (sliced index 8)
+      0x01, 0xC8,             // 13-14 height = 456       (sliced index 9-10)
+      0x00, 0x7B              // 15-16 width  = 123       (sliced index 11-12)
+    ]);
+    var size = jpg.calculate(valid);
+    expect(size.height).to.equal(456);
+    expect(size.width).to.equal(123);
+  });
+});
