+'use strict'
+
+// Regression test for CVE-2025-71330 (CWE-835: ICNS zero-length entry DoS).
+//
+// The functional fix lives in CVE-2025-71329 (dist/types/icns.* and bundled
+// entry points). This test asserts the ICNS-specific PoC from the advisory
+// terminates quickly instead of hanging the event loop.
+
+const assert = require('node:assert')
+const { describe, it } = require('node:test')
+const { imageSize } = require('../dist/index.cjs')
+
+// Minimal ICNS: magic + file length + one entry with zero length field.
+const ICNS_ZERO_LENGTH_B64 = 'aWNucwAAABBpYzA3AAAAAA=='
+
+describe('CVE-2025-71330 - ICNS zero-length entry infinite loop', () => {
+  it('rejects icns-zero-length-entry without hanging', () => {
+    const input = new Uint8Array(Buffer.from(ICNS_ZERO_LENGTH_B64, 'base64'))
+    const start = Date.now()
+    assert.throws(
+      () => imageSize(input),
+      (err) => {
+        assert.ok(err instanceof TypeError, `expected TypeError, got ${err}`)
+        assert.match(err.message, /^Invalid ICNS/)
+        return true
+      },
+    )
+    assert.ok(Date.now() - start < 2000, 'ICNS parser must terminate quickly')
+  })
+})
