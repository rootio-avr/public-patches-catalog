Description: Fix CVE-2025-71329 - denial-of-service infinite loop (CWE-835) in ICNS parser
 image-size advances its parse offset by an entry-length field read verbatim
 from the image buffer. A crafted ICNS file whose entry length is zero (or
 smaller than the 8-byte entry header) never advances imageOffset, so the
 calculate() while-loop spins forever and blocks the Node.js event loop. This
 is the same non-advancing-offset infinite loop reported upstream for the
 JXL/HEIF parsers (an 'ispe' box with size=0); those parsers do not exist in
 0.6.3, but the identical pattern is reachable via the ICNS parser here.
 Add a guard clause that terminates iteration when the declared entry length
 cannot move the offset forward.
Origin: ai-synthesized, CVE-2025-71329
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-08-18

--- a/lib/types/icns.js
+++ b/lib/types/icns.js
@@ -21,6 +21,9 @@ var FILE_LENGTH_OFFSET = 4; // MSB => BIG ENDIAN
  *
  **/
 var ENTRY_LENGTH_OFFSET = 4; // MSB => BIG ENDIAN
+// Minimum size of a valid image entry: 4-byte OSType + 4-byte length field.
+// Any declared entry length below this cannot represent a real entry.
+var MIN_ENTRY_LENGTH = 8;
 
 function isICNS (buffer) {
   return ('icns' === buffer.toString('ascii', 0, 4));
@@ -94,6 +97,12 @@ function calculate (buffer) {
 
   imageHeader = readImageHeader(buffer, imageOffset);
   imageSize = getImageSize(imageHeader[0]);
+  // Guard against CVE-2025-71329 (CWE-835): a crafted entry whose declared
+  // length is zero or smaller than the entry header would never advance
+  // imageOffset, causing an infinite loop below. Bail out safely instead.
+  if (imageHeader[1] < MIN_ENTRY_LENGTH) {
+    return imageSize;
+  }
   imageOffset += imageHeader[1];
 
   if (imageOffset === fileLength) {
@@ -109,6 +118,12 @@ function calculate (buffer) {
   while (imageOffset < fileLength && imageOffset < bufferLength) {
     imageHeader = readImageHeader(buffer, imageOffset);
     imageSize = getImageSize(imageHeader[0]);
+    // Guard against CVE-2025-71329 (CWE-835): stop if the declared entry
+    // length cannot advance the parse offset, otherwise the loop never
+    // terminates and blocks the event loop.
+    if (imageHeader[1] < MIN_ENTRY_LENGTH) {
+      break;
+    }
     imageOffset += imageHeader[1];
     result.images.push(imageSize);
   }
--- /dev/null
+++ b/specs/cve_2025_71329.spec.js
@@ -0,0 +1,50 @@
+'use strict';
+
+// Regression test for CVE-2025-71329 (CWE-835 infinite loop in ICNS parser).
+// A crafted ICNS buffer whose image-entry length field is zero used to make
+// the parse offset in icns.calculate() never advance, spinning the while-loop
+// forever and blocking the event loop. The fix bails out when a declared
+// entry length cannot advance past the 8-byte entry header.
+
+var expect = require('expect.js');
+var icns = require('../lib/types/icns');
+
+// Build a minimal ICNS buffer with a recognized entry type ('is32') whose
+// declared entry length is 0 -- the exact non-advancing-offset trigger.
+function craftZeroLengthICNS() {
+  var buf = Buffer.alloc(24);
+  buf.write('icns', 0, 'ascii');       // magic
+  buf.writeUInt32BE(24, 4);            // file length
+  buf.write('is32', 8, 'ascii');       // recognized entry OSType (offset 8)
+  buf.writeUInt32BE(0, 12);            // entry length = 0  <-- malicious
+  // trailing bytes so bufferLength > fileLength boundary is exercised
+  return buf;
+}
+
+describe('CVE-2025-71329 - ICNS infinite loop', function () {
+
+  it('should terminate (not hang) on a zero-length entry', function () {
+    this.timeout(2000); // if the loop is unbounded, mocha kills it here
+    var buf = craftZeroLengthICNS();
+    // Must return without looping forever; result shape is not asserted,
+    // only that calculate() returns / throws promptly instead of hanging.
+    var run = function () { return icns.calculate(buf); };
+    expect(run).to.not.throwException(function (e) {
+      // A RangeError from reading past the buffer is acceptable; an infinite
+      // loop (test timeout) is the only real failure mode being guarded.
+      throw e;
+    });
+  });
+
+  it('still detects a well-formed single-entry ICNS', function () {
+    var buf = Buffer.alloc(24);
+    buf.write('icns', 0, 'ascii');
+    buf.writeUInt32BE(24, 4);
+    buf.write('is32', 8, 'ascii'); // is32 => 16x16
+    buf.writeUInt32BE(16, 12);     // valid entry length advances the offset
+    var out = icns.calculate(buf);
+    expect(out).to.be.an('object');
+    expect(out.width).to.be(16);
+    expect(out.height).to.be(16);
+  });
+});

Description: CVE-2025-71330 - ICNS zero-length entry denial of service (CWE-835)
 A crafted ICNS file with an image entry whose declared data length is 0 never
 advances imageOffset, so calculate() loops forever pushing entries until the
 heap is exhausted, blocking the Node.js event loop.
 .
 Rewritten as a leftover patch: in 0.6.3 this is the same non-advancing-offset
 defect as CVE-2025-71329, and the terminating guard in lib/types/icns.js is
 already applied by patches/CVE-2025-71329. Re-applying the upstream
 "imageOffset += imageHeader[1] > 0 ? imageHeader[1] : 8" advance here is
 unreachable behind that guard, and its original context no longer matched the
 guarded file, so both icns.js hunks were dropped. This file keeps the
 regression test.
 .
 Verified against the 0.6.3 dist tarball: unpatched, the spec exhausts the heap
 and crashes; with CVE-2025-71329 applied, all three assertions pass.
Origin: upstream, https://github.com/image-size/image-size/commit/0f6a6665a166c530ba126a8ab8608a0603cb49dc
Last-Update: 2026-09-15

--- /dev/null
+++ b/specs/cve-2025-71330.spec.js
@@ -0,0 +1,48 @@
+'use strict';
+
+// Regression test for CVE-2025-71330:
+// A crafted ICNS file with an image entry whose declared data length is 0
+// caused an infinite loop (DoS) because the parser's imageOffset never
+// advanced. The fix guards both offset advances so a zero-length entry
+// falls back to the minimum entry header size.
+
+var expect = require('expect.js');
+var icns = require('../lib/types/icns');
+
+describe('CVE-2025-71330 - ICNS zero-length entry DoS', function () {
+
+  // Build a minimal ICNS buffer:
+  //   "icns" magic + 4-byte file length,
+  //   then image entries: 4-byte type + 4-byte length (== 0).
+  function buildMalicious () {
+    var buffer = Buffer.alloc(24);
+    buffer.write('icns', 0, 'ascii');       // magic
+    buffer.writeUInt32BE(24, 4);            // file length (bigger than one entry)
+    buffer.write('ic09', 8, 'ascii');       // first entry type
+    buffer.writeUInt32BE(0, 12);            // first entry length = 0 (malicious)
+    buffer.write('ic10', 16, 'ascii');      // second entry type
+    buffer.writeUInt32BE(0, 20);            // second entry length = 0 (malicious)
+    return buffer;
+  }
+
+  it('should be detected as an icns buffer', function () {
+    expect(icns.detect(buildMalicious())).to.be(true);
+  });
+
+  it('should terminate (not loop forever) on zero-length entries', function () {
+    this.timeout(2000);
+    var result = icns.calculate(buildMalicious());
+    // The important assertion is simply that calculate() returns.
+    expect(result).to.be.an('object');
+  });
+
+  it('should advance past a zero-length first entry', function () {
+    var buffer = Buffer.alloc(16);
+    buffer.write('icns', 0, 'ascii');
+    buffer.writeUInt32BE(16, 4);            // file length
+    buffer.write('ic09', 8, 'ascii');       // single entry type
+    buffer.writeUInt32BE(0, 12);            // single entry length = 0
+    var result = icns.calculate(buffer);
+    expect(result).to.be.an('object');
+  });
+});
