@@ -0,0 +1,33 @@
+const { assert } = require('chai')
+const HeaderParser = require('../deps/dicer/lib/HeaderParser')
+
+describe('dicer-headerparser prototype property names (CVE-2026-19481)', () => {
+  ;['__proto__', 'constructor'].forEach((name) => {
+    it(`should store "${name}" as a plain header without touching the prototype`, () => {
+      const parser = new HeaderParser()
+      let header
+
+      parser.on('header', (value) => { header = value })
+      parser.push(`${name}: injected\r\n\r\n`)
+
+      assert.strictEqual(Object.getPrototypeOf(header), null)
+      assert.deepEqual(header[name], ['injected'])
+      assert.isUndefined({}.injected)
+      assert.notProperty(Object.prototype, 'injected')
+    })
+  })
+
+  it('should keep a null-prototype header map after reset', () => {
+    const parser = new HeaderParser()
+    const headers = []
+
+    parser.on('header', (value) => headers.push(value))
+    parser.push('a: 1\r\n\r\n')
+    parser.reset()
+    parser.push('__proto__: 2\r\n\r\n')
+
+    assert.strictEqual(headers.length, 2)
+    headers.forEach((h) => assert.strictEqual(Object.getPrototypeOf(h), null))
+    assert.deepEqual(headers[1].__proto__, ['2'])
+  })
+})
