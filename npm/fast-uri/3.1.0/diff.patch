+'use strict'
+
+// Regression test for CVE-2026-18446 (fast-uri malformed authority introducer
+// host-confusion / SSRF / redirect bypass).
+//
+// fast-uri only recognizes a literal "//" as the authority introducer. Node's
+// WHATWG URL parser treats "\" as interchangeable with "/" on special schemes
+// and strips TAB/LF/CR before parsing, so inputs like "http:\\evil.com/path",
+// "http:/\evil.com/path", "http:\/evil.com/path", or a whitespace-split
+// "/<TAB>/evil.com/path" resolve to a different host in Node than the one
+// fast-uri parses. These must be rejected (parse marks them malformed;
+// resolve() throws; normalize()/equal() do not silently canonicalize them)
+// rather than folded into the path group.
+//
+// The upstream fix (commit 2cad02d) ships these assertions in
+// test/security.test.js, which is not present in this package version, so this
+// file is an equivalent replacement authored against v3.1.0's public API.
+
+const test = require('tape')
+const fastURI = require('..')
+
+test('CVE-2026-18446: parse rejects a malformed authority introducer (\\\\, /\\, \\/)', (t) => {
+  const cases = [
+    'http:\\\\evil.com/path',
+    'http:/\\evil.com/path',
+    'http:\\/evil.com/path',
+    'ws:\\\\evil.com/chat',
+    'wss:\\\\evil.com/chat',
+    'ftp:\\\\evil.com/',
+    '\\\\evil.com/path'
+  ]
+
+  t.plan(cases.length)
+
+  cases.forEach((input) => {
+    t.equal(
+      fastURI.parse(input).error,
+      'URI authority must not contain a literal backslash.',
+      input
+    )
+  })
+})
+
+test('CVE-2026-18446: parse rejects a whitespace-split authority introducer (TAB, LF, CR)', (t) => {
+  const cases = [
+    { input: '/\t\\evil.com/path', expectedError: 'URI authority must not contain a literal backslash.' },
+    { input: '/\t/evil.com/path', expectedError: 'URI authority introducer must not contain whitespace.' },
+    { input: '/\n\\evil.com/path', expectedError: 'URI authority must not contain a literal backslash.' },
+    { input: '/\r\\evil.com/path', expectedError: 'URI authority must not contain a literal backslash.' },
+    { input: '\t//evil.com/path', expectedError: 'URI authority introducer must not contain whitespace.' },
