+'use strict'
+
+// Regression test for CVE-2026-76172 (GHSA-jqff-g426-hqxp).
+//
+// fast-uri percent-decoded the URI scheme without re-validating it against
+// the RFC 3986 scheme grammar. An encoded scheme such as "%2f%2fevil.example"
+// decoded to "//evil.example" and was re-emitted as an authority, and
+// "%0d%0a..." decoded to a raw CRLF header-injection payload. The fix rejects
+// any scheme that is not a valid RFC 3986 scheme after percent-decoding.
+//
+// Adapted from upstream test/scheme-validation.test.js. Note: fast-uri 3.0.3
+// preserves scheme case at parse time, so scheme-casing assertions differ
+// from upstream (which lowercases).
+
+const test = require('tape')
+const fastURI = require('..')
+
+const MALFORMED_SCHEME_ERROR = 'URI scheme is malformed.'
+
+const malformedSchemes = [
+  '%2f%2fevil.example:/pwn',
+  '%0d%0aSet-Cookie:%20sid=attacker:/p',
+  'foo%3Abar:value',
+  'foo%2Fbar:value',
+  '1http://example.com/',
+  'foo_bar:value'
+]
+
+test('parse rejects schemes that decode to invalid RFC 3986 identifiers', (t) => {
+  for (const uri of malformedSchemes) {
+    const parsed = fastURI.parse(uri)
+    t.equal(parsed.error, MALFORMED_SCHEME_ERROR, uri)
+  }
+  t.end()
+})
+
+test('parse still accepts valid (including percent-encoded) schemes', (t) => {
+  const validSchemes = [
+    ['a:value', 'a'],
+    ['a1+.-:value', 'a1+.-'],
+    ['foo%2Bbar:value', 'foo+bar'],
+    ['ht%74ps://example.com/', 'https']
+  ]
+  for (const [uri, scheme] of validSchemes) {
+    const parsed = fastURI.parse(uri)
+    t.equal(parsed.error, undefined, uri + ' has no error')
+    t.equal(parsed.scheme, scheme, uri + ' scheme')
+  }
+  // encoded scheme still selects the correct scheme handler after decoding
+  t.equal(fastURI.normalize('ht%74ps://example.com:443'), 'https://example.com/', 'decoded scheme selects handler')
+  t.end()
+})
+
+test('normalize preserves (does not decode) malformed-scheme inputs', (t) => {
+  for (const uri of malformedSchemes) {
+    t.equal(fastURI.normalize(uri), uri, uri)
+  }
+  t.end()
+})
+
+test('normalize cannot synthesize an authority or raw CRLF from an encoded scheme', (t) => {
+  const authority = '%2f%2fevil.example:/pwn'
+  const crlf = '%0d%0aSet-Cookie:%20sid=attacker:/p'
+
