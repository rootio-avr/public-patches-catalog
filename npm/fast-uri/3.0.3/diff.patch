+'use strict'
+
+// Regression test for AIKIDO-2026-87893 / GHSA-f65p-4m7j-42xc:
+// malformed bracketed IPv6 literals such as "[::not-valid]" must never be
+// truncated into a different valid address ("[::]") and must fail closed.
+
+const test = require('tape')
+const fastURI = require('..')
+
+const HOST_ERROR = 'URI host is malformed.'
+
+const malformedLiterals = [
+  '::not-valid',
+  'fc00::not-hex',
+  'fe80::not-hex',
+  '1:2:3',
+  '1:2:3:4:5:6:7:8:9',
+  '1::2::3',
+  '12345::',
+  '::ffff:192.0.2.999',
+  'v.foo',
+  'fe80::1%25',
+  'fe80::1%25eth 0',
+  'not-an-ip'
+]
+
+test('AIKIDO-2026-87893: malformed bracketed IPv6 literals are rejected, not truncated', (t) => {
+  for (const literal of malformedLiterals) {
+    const uri = `http://[${literal}]/private`
+    const parsed = fastURI.parse(uri)
+
+    t.equal(parsed.error, HOST_ERROR, `parse rejects ${literal}`)
+    t.equal(parsed.host, `[${literal.toLowerCase()}]`, `parse does not truncate ${literal}`)
+    t.equal(fastURI.normalize(uri), uri, `normalize preserves ${literal}`)
+    t.equal(fastURI.equal(uri, uri), false, `equal fails closed for ${literal}`)
+  }
+  t.end()
+})
+
+test('AIKIDO-2026-87893: the reported [::not-valid] PoC no longer becomes [::]', (t) => {
+  const uri = 'http://[::not-valid]/private'
+  t.notEqual(fastURI.parse(uri).host, '::', 'host is not truncated to ::')
+  t.notEqual(fastURI.normalize(uri), 'http://[::]/private', 'does not normalize to loopback-like address')
+  t.equal(fastURI.equal(uri, 'http://[::]/private'), false, 'is not equal to http://[::]/private')
+  t.end()
+})
+
+test('AIKIDO-2026-87893: resolve throws for malformed bracketed IPv6 literals', (t) => {
+  for (const literal of malformedLiterals) {
+    const uri = `http://[${literal}]/private`
+    t.throws(() => fastURI.resolve(uri, 'child'), /URI host is malformed\./, `rejects malformed base ${literal}`)
+    t.throws(() => fastURI.resolve('http://example.com/', uri), /URI host is malformed\./, `rejects malformed relative ${literal}`)
+  }
+  t.end()
+})
+
+test('AIKIDO-2026-87893: valid IPv6 and IPvFuture hosts still normalize', (t) => {
+  const cases = [
+    ['http://[::1]/', 'http://[::1]/'],
+    ['http://[2001:0DB8::0001]/', 'http://[2001:db8::1]/'],
+    ['http://[0:0:0:0:0:0:0:0]/', 'http://[::]/'],
+    ['http://[::ffff:192.0.2.1]/', 'http://[::ffff:192.0.2.1]/'],
+    ['http://[fe80::a%25en1]/', 'http://[fe80::a%25en1]/'],
+    ['http://[1:0:0:0:2:0:0:3]/', 'http://[1::2:0:0:3]/'],
+    ['http://[vF.A:b]/', 'http://[vf.a:b]/']
+  ]
+  for (const [uri, normalized] of cases) {
+    t.equal(fastURI.parse(uri).error, undefined, `${uri} parses without error`)
+    t.equal(fastURI.normalize(uri), normalized, `${uri} normalizes to ${normalized}`)
+  }
+  t.equal(fastURI.equal('http://[::1]/', 'http://[0:0:0:0:0:0:0:1]/'), true, 'compressed equals expanded')
+  t.equal(fastURI.resolve('http://[::1]/a/b', 'c'), 'http://[::1]/a/c', 'resolve against a valid literal works')
+  t.end()
+})

