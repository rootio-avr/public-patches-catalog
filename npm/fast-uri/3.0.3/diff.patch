+'use strict'
+
+// Regression test for AIKIDO-2026-695913 (GHSA-jqff-g426-hqxp).
+//
+// A scheme that percent-decodes to characters outside the RFC 3986 scheme
+// grammar (e.g. "%2f%2fevil.example" -> "//evil.example", or CRLF) must be
+// flagged as malformed and must never be left decoded in the parsed
+// components, otherwise a consumer re-emitting parsed.scheme gets an
+// authority or header-injection payload.
+
+const test = require('tape')
+const fastURI = require('..')
+
+const MALFORMED_SCHEME_ERROR = 'URI scheme is malformed.'
+
+test('malformed decoded scheme is flagged and stays percent-encoded', (t) => {
+  const cases = [
+    ['%2f%2fevil.example:/pwn', '%2f%2fevil.example'],
+    ['%0d%0aSet-Cookie:%20sid=attacker:/p', '%0d%0aSet-Cookie'],
+    ['foo%3Abar:value', 'foo%3Abar'],
+    ['foo%2Fbar:value', 'foo%2Fbar']
+  ]
+  for (const [uri, scheme] of cases) {
+    const parsed = fastURI.parse(uri)
+    t.equal(parsed.error, MALFORMED_SCHEME_ERROR, uri + ' error')
+    t.equal(parsed.scheme, scheme, uri + ' scheme is not decoded')
+  }
+  t.end()
+})
+
+test('decoded scheme selects its scheme handler', (t) => {
+  const parsed = fastURI.parse('ht%74ps://example.com:443')
+  t.equal(parsed.error, undefined)
+  t.equal(parsed.scheme, 'https')
+  t.equal(fastURI.normalize('ht%74ps://example.com:443'), 'https://example.com/')
+  t.end()
+})
+
+test('normalize, equal and serialize reject malformed decoded schemes', (t) => {
+  const uri = '%2f%2fevil.example:/pwn'
