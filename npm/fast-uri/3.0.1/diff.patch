+'use strict'
+
+// Regression test for CVE-2026-84292 (CWE-116):
+// recomposeAuthority() serialized components.port verbatim, so a non-digit
+// port value (e.g. '@evil.example' or '8080/path') injected extra authority
+// or path/query/fragment delimiters into the recomposed URI. This let an
+// attacker smuggle a different host/path past a URI built from trusted
+// component parts, defeating host- or path-based allowlists.
+// Grounded on upstream fix commit 820e8478 (adds an isPort validator that
+// rejects non-digit ports per RFC 3986, throwing a TypeError).
+
+const tap = require('tap')
+const test = tap.test
+const fastURI = require('../')
+
+test('serialize rejects a non-digit port as malformed (RFC 3986)', (t) => {
+  // Each of these ports, if emitted verbatim, would inject authority/path/
+  // query/fragment delimiters and change the meaning of the URI.
+  const malformedPorts = [
+    '@127.0.0.1:8124',
+    '8080@evil.example',
+    '8080/path',
+    '8080?query',
+    '8080#fragment',
+    '8080:9000',
+    '-1',
+    '1.5',
+    1.5,
+    NaN,
+    Infinity,
+    '١' // Arabic-Indic digit one: not an ASCII digit
+  ]
+
+  t.plan(malformedPorts.length)
+
+  for (const port of malformedPorts) {
+    t.throws(
+      () => fastURI.serialize({ scheme: 'http', host: 'trusted.example', port, path: '/app' }),
+      /URI port is malformed\./,
+      String(port)
+    )
+  }
+})
+
+test('normalize/equal fail closed on a malformed port', (t) => {
+  t.plan(2)
+
+  t.throws(
+    () => fastURI.normalize({ scheme: 'http', host: 'trusted.example', port: '@evil.example' }),
+    /URI port is malformed\./,
+    'object normalization rejects a malformed port'
+  )
+
+  t.equal(
+    fastURI.equal(
+      { scheme: 'http', host: 'trusted.example', port: '@evil.example' },
+      { scheme: 'http', host: 'trusted.example', port: '@evil.example' }
+    ),
+    false,
+    'object equality fails closed for a malformed port'
+  )
+})
+
+test('serialize preserves RFC 3986 digit port values', (t) => {
+  t.plan(4)
+
+  t.equal(
+    fastURI.serialize({ scheme: 'http', host: 'trusted.example', port: 8080, path: '/app' }),
+    'http://trusted.example:8080/app',
+    'numeric port is preserved'
+  )
+  t.equal(
+    fastURI.serialize({ scheme: 'http', host: 'trusted.example', port: '8080', path: '/app' }),
+    'http://trusted.example:8080/app',
+    'string digit port is preserved'
+  )
+  t.equal(
+    fastURI.serialize({ scheme: 'http', host: 'trusted.example', port: 0, path: '/app' }),
+    'http://trusted.example:0/app',
+    'zero port is preserved'
+  )
+  // An empty port is valid RFC 3986 syntax and must not throw (isPort allows
+  // it); the http scheme handler drops the empty ":" during serialization.
+  t.equal(
+    fastURI.serialize({ scheme: 'http', host: 'trusted.example', port: '', path: '/app' }),
+    'http://trusted.example/app',
+    'empty port does not throw and serializes cleanly'
+  )
+})
