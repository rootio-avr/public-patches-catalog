+/* eslint-disable */
+// Regression test for AIKIDO-2025-10093: prototype pollution in extend()
+import { extend } from '../package/ssr-window.esm.js';
+import assert from 'node:assert';
+
+function test() {
+  // __proto__ payload must not pollute Object.prototype
+  extend({}, JSON.parse('{"__proto__": {"polluted": "yes"}}'));
+  assert.strictEqual(({}).polluted, undefined, '__proto__ pollution');
+
+  // constructor.prototype payload must not pollute
+  extend({}, JSON.parse('{"constructor": {"prototype": {"polluted2": "yes"}}}'));
+  assert.strictEqual(({}).polluted2, undefined, 'constructor.prototype pollution');
+
+  // prototype key must be ignored
+  extend({}, JSON.parse('{"prototype": {"polluted3": "yes"}}'));
+  assert.strictEqual(({}).polluted3, undefined, 'prototype pollution');
+
+  // legitimate keys still merge normally
+  const merged = {};
+  extend(merged, { a: 1, b: { c: 2 } });
+  assert.strictEqual(merged.a, 1, 'normal key a');
+  assert.strictEqual(merged.b.c, 2, 'nested key b.c');
+}
+
+test();
+
+export default test;
