+// Truncate keepExtensions suffixes at the first non [A-Za-z0-9.] character.
+// Mirrors upstream 3.2.4 fix (node-formidable/formidable#857 / 81dd350).
+function invalidExtensionChar(c) {
+  var code = c.charCodeAt(0);
+  return !(
+    code === 46 || // .
+    (code >= 48 && code <= 57) ||
+    (code >= 65 && code <= 90) ||
+    (code >= 97 && code <= 122)
+  );
+}
+
 IncomingForm.prototype._uploadPath = function(filename) {
   var buf = crypto.randomBytes(16);
   var name = 'upload_' + buf.toString('hex');
 
   if (this.keepExtensions) {
     var ext = path.extname(filename);
-    ext     = ext.replace(/(\.[a-z0-9]+).*/i, '$1');
+    var firstInvalidIndex = -1;
+    for (var i = 0; i < ext.length; i++) {
+      if (invalidExtensionChar(ext.charAt(i))) {
+        firstInvalidIndex = i;
+        break;
+      }
+    }
+    if (firstInvalidIndex !== -1) {
+      ext = ext.substring(0, firstInvalidIndex);
+    }
+    if (ext === '.') {
+      ext = '';
+    }
 
     name += ext;
   }
