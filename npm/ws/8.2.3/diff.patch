+'use strict';
+
+const assert = require('assert');
+const http = require('http');
+
+const WebSocket = require('../');
+
+//
+// Regression test for CVE-2024-37890.
+//
+// When the `Upgrade` header field value cannot be read (for example because
+// the number of received headers exceeds `server.maxHeadersCount`), the
+// `req.headers.upgrade` property is `undefined`. Before the fix,
+// `WebSocketServer.prototype.handleUpgrade()` called
+// `req.headers.upgrade.toLowerCase()` unconditionally, throwing a
+// `TypeError` and crashing the process (a denial of service). The fix guards
+// the access with an `req.headers.upgrade === undefined` check so the request
+// is aborted with a `400` response instead.
+//
+describe('CVE-2024-37890', () => {
+  it('does not crash when the Upgrade header field cannot be read', (done) => {
+    const server = http.createServer();
+    const wss = new WebSocket.Server({ noServer: true });
+
+    // Force the Upgrade header to be dropped so `req.headers.upgrade` is
+    // `undefined` when `handleUpgrade()` runs.
+    server.maxHeadersCount = 1;
+
+    server.on('upgrade', (req, socket, head) => {
+      assert.strictEqual(req.headers.upgrade, undefined);
+
+      // Must not throw and must not invoke the completion callback.
+      wss.handleUpgrade(req, socket, head, () => {
+        done(new Error('Unexpected callback invocation'));
+      });
+    });
+
+    server.listen(() => {
+      const req = http.get({
+        port: server.address().port,
+        headers: {
+          foo: 'bar',
+          bar: 'baz',
+          Connection: 'Upgrade',
+          Upgrade: 'websocket'
+        }
+      });
+
+      req.on('response', (res) => {
+        assert.strictEqual(res.statusCode, 400);
+        res.resume();
+        res.on('end', () => {
+          server.close(done);
+        });
+      });
+
+      req.on('error', done);
+    });
+  });
+});

