@@ -0,0 +1,40 @@
+'use strict';
+
+const assert = require('assert');
+
+const Receiver = require('../lib/receiver');
+
+//
+// Regression test for CVE-2026-48779: a peer could exhaust memory by sending
+// data in a very large number of tiny chunks (or a message split into a very
+// large number of fragments). The fix adds `maxBufferedChunks` and
+// `maxFragments` guards to the Receiver.
+//
+describe('CVE-2026-48779', () => {
+  it('rejects too many buffered chunks', (done) => {
+    const receiver = new Receiver({ maxBufferedChunks: 1 });
+
+    receiver.on('error', (err) => {
+      assert.ok(err instanceof RangeError);
+      assert.strictEqual(err.code, 'WS_ERR_TOO_MANY_BUFFERED_PARTS');
+      done();
+    });
+
+    // First incomplete chunk is buffered (a frame header needs 2 bytes).
+    receiver.write(Buffer.from([0x00]));
+    // Second chunk exceeds the buffered-chunk limit and must error.
+    receiver.write(Buffer.from([0x00]));
+  });
+
+  it('accepts buffered chunks below the limit', (done) => {
+    const receiver = new Receiver({ maxBufferedChunks: 10 });
+
+    receiver.on('error', () => {
+      done(new Error('should not have errored'));
+    });
+
+    receiver.write(Buffer.from([0x00]), () => {
+      done();
+    });
+  });
+});
