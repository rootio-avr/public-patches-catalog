--- /dev/null
+++ b/test/cve-2023-54404.test.js
@@ -0,0 +1,32 @@
+const assert = require("node:assert");
+const { z } = require("../lib");
+
+// Oversized arrays/sets must be rejected before any element is parsed.
+let calls = 0;
+const el = z.custom(() => {
+  calls++;
+  return true;
+});
+
+const maxArr = el.array().max(2).safeParse([1, 2, 3, 4, 5]);
+assert.strictEqual(maxArr.success, false);
+assert.strictEqual(maxArr.error.issues.length, 1);
+assert.strictEqual(maxArr.error.issues[0].code, "too_big");
+
+const lenArr = el.array().length(2).safeParse([1, 2, 3, 4, 5]);
+assert.strictEqual(lenArr.success, false);
+assert.strictEqual(lenArr.error.issues.length, 1);
+assert.strictEqual(lenArr.error.issues[0].code, "too_big");
+
+const maxSet = z.set(el).max(2).safeParse(new Set([1, 2, 3, 4, 5]));
+assert.strictEqual(maxSet.success, false);
+assert.strictEqual(maxSet.error.issues.length, 1);
+assert.strictEqual(maxSet.error.issues[0].code, "too_big");
+
+assert.strictEqual(calls, 0);
+
+el.array().max(2).safeParseAsync([1, 2, 3, 4, 5]).then((r) => {
+  assert.strictEqual(r.success, false);
+  assert.strictEqual(r.error.issues.length, 1);
+  assert.strictEqual(calls, 0);
+});
