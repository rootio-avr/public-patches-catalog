@@ -0,0 +1,25 @@
+import { getFilenameFromUrl } from '../lib/util';
+
+// GHSA-p3f5-w63m-mxph: a publicPath without a trailing slash must not allow
+// requests to resolve outside of the output directory.
+describe('GHSA-p3f5-w63m-mxph path traversal', () => {
+  const compiler = { outputPath: '/srv/app/dist' };
+
+  it('should still resolve legitimate files under a non-slash publicPath', () => {
+    expect(getFilenameFromUrl('/static', compiler, '/static/index.html')).toBe(
+      '/srv/app/dist/index.html'
+    );
+  });
+
+  it('should reject "/static../secret.txt"', () => {
+    expect(
+      getFilenameFromUrl('/static', compiler, '/static../secret.txt')
+    ).toBe(false);
+  });
+
+  it('should reject encoded traversal segments', () => {
+    expect(
+      getFilenameFromUrl('/static', compiler, '/static/%2e%2e/secret.txt')
+    ).toBe(false);
+  });
+});
