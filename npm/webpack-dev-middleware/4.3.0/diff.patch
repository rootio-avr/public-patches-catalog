--- /dev/null
+++ b/test/cve-2026-76844.test.js
@@ -0,0 +1,78 @@
+/**
+ * Regression test for CVE-2026-76844 (GHSA-g84c-rxfj-3j2c).
+ *
+ * Path traversal via a `publicPath` that has no trailing slash. When
+ * `publicPath` is `/static`, a request for `/static../secret.txt` shares the
+ * prefix `/static`, so the pre-strip ".." guard does not fire, and the stripped
+ * remainder `../secret.txt` joined onto the output root escapes it one level up.
+ *
+ * The fix adds a `path.relative(outputPath, filename)` containment check that
+ * rejects any resolved filename outside the output directory. This test drives
+ * the built `dist/utils/getFilenameFromUrl` (the shipped artifact) directly with
+ * a stub context, mirroring the upstream test in test/middleware.test.js.
+ */
+
+const assert = require("assert");
+const path = require("path");
+
+const getFilenameFromUrl = require("../dist/utils/getFilenameFromUrl").default;
+
+const outputPath = path.resolve("/srv/app/dist");
+
+// Files that exist on the (stubbed) output filesystem.
+const existing = new Set([
+  path.join(outputPath, "index.html"),
+  // A sensitive file one level ABOVE the served output root.
+  path.resolve(outputPath, "../secret.txt"),
+]);
+
+function makeContext(publicPath) {
+  return {
+    options: {},
+    outputFileSystem: {
+      statSync(filename) {
+        if (existing.has(filename)) {
+          return { isFile: () => true, isDirectory: () => false };
+        }
+        const err = new Error("ENOENT");
+        err.code = "ENOENT";
+        throw err;
+      },
+    },
+    stats: {
+      stats: [
+        {
+          compilation: {
+            getPath: (p) => p,
+            outputOptions: { path: outputPath, publicPath },
+          },
+        },
+      ],
+    },
+  };
+}
+
+// 1) A legitimate file under the "/static" prefix must resolve.
+{
+  const context = makeContext("/static");
+  const filename = getFilenameFromUrl(context, "/static/index.html");
+  assert.strictEqual(
+    filename,
+    path.join(outputPath, "index.html"),
+    "legitimate file under publicPath should resolve",
+  );
+}
+
+// 2) A traversal request must NOT resolve to the file above the output root.
+{
+  const context = makeContext("/static");
+  const filename = getFilenameFromUrl(context, "/static../secret.txt");
+  assert.strictEqual(
+    filename,
+    undefined,
+    "path traversal above output root must be rejected (CVE-2026-76844)",
+  );
+}
+
+// eslint-disable-next-line no-console
+console.log("CVE-2026-76844 regression test passed");

