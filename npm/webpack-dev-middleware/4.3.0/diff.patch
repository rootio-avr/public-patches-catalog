--- /dev/null
+++ b/test/ghsa-p3f5-w63m-mxph.test.js
@@ -0,0 +1,49 @@
+const assert = require("assert");
+const path = require("path");
+
+const getFilenameFromUrl = require("../dist/utils/getFilenameFromUrl").default;
+
+// @see https://github.com/webpack/webpack-dev-middleware/security/advisories/GHSA-g84c-rxfj-3j2c
+// A `publicPath` without a trailing slash must not allow escaping `outputPath`.
+const outputPath = path.resolve("/virtual/output/static");
+const files = new Set([
+  path.resolve(outputPath, "index.html"),
+  path.resolve(outputPath, "../secret.txt"),
+]);
+
+function createContext() {
+  return {
+    options: {},
+    stats: {
+      compilation: {
+        getPath: (value) => value,
+        outputOptions: { path: outputPath, publicPath: "/static" },
+      },
+    },
+    outputFileSystem: {
+      statSync(filename) {
+        if (!files.has(filename)) {
+          throw new Error("ENOENT");
+        }
+
+        return { isFile: () => true, isDirectory: () => false };
+      },
+    },
+  };
+}
+
+describe("GHSA-p3f5-w63m-mxph", () => {
+  it("should serve a legitimate file under the publicPath prefix", () => {
+    assert.strictEqual(
+      getFilenameFromUrl(createContext(), "/static/index.html"),
+      path.resolve(outputPath, "index.html")
+    );
+  });
+
+  it("should not resolve files above the output directory", () => {
+    assert.strictEqual(
+      getFilenameFromUrl(createContext(), "/static../secret.txt"),
+      undefined
+    );
+  });
+});
