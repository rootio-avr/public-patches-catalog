+import { getFilenameFromUrl } from '../lib/util';
+
+// Regression test for CVE-2024-29180 (path traversal in getFilenameFromUrl).
+// A request path is decoded before it is joined with the output directory, and
+// any decoded path that escapes the output directory ("..") or contains a null
+// byte must be rejected (getFilenameFromUrl returns `false`, which the
+// middleware turns into a pass-through / not-found) instead of resolving to a
+// file above the served root.
+describe('CVE-2024-29180: getFilenameFromUrl path traversal', () => {
+  function resolve(url, outputPath = '/dist', publicPath = '/') {
+    return getFilenameFromUrl(publicPath, { outputPath }, url);
+  }
+
+  const maliciousUrls = [
+    // Percent-encoded "../" traversal (the advisory PoC shape).
+    '/..%2f..%2f..%2fetc%2fpasswd',
+    // Encoded dots + encoded slash.
+    '/%2e%2e/%2e%2e/etc/passwd',
+    // Plain unencoded traversal.
+    '/../../../etc/passwd',
+    // Fully encoded dots and slashes.
+    '/%2e%2e%2f%2e%2e%2fetc%2fpasswd',
+  ];
+
+  for (const url of maliciousUrls) {
+    it(`rejects traversal for ${url}`, () => {
+      expect(resolve(url)).toBe(false);
+    });
+  }
+
+  it('rejects a null byte in the path', () => {
+    expect(resolve('/foo%00.js')).toBe(false);
+  });
+
+  // Legitimate requests must keep working after the fix.
+  it('still resolves a normal file', () => {
+    expect(resolve('/a.js')).toBe('/dist/a.js');
+  });
+
+  it('still resolves percent-encoded (non-traversal) characters', () => {
+    expect(resolve('/f%C3%B6%C3%B6.js', '/')).toBe('/föö.js');
+  });
+
+  it('still allows dot segments that are not traversal', () => {
+    expect(resolve('/folder-name-with-dots/mono-v6.x.x', '/')).toBe(
+      '/folder-name-with-dots/mono-v6.x.x'
+    );
+  });
+});

