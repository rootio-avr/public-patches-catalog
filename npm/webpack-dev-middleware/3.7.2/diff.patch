+import { getFilenameFromUrl } from '../lib/util';
+
+// Regression test for CVE-2026-76844 (path traversal via offset slice on a
+// non-slash-terminated publicPath — an incomplete-fix bypass of
+// CVE-2024-29180).
+//
+// When `publicPath` has no trailing slash, a sibling request path can share
+// its prefix (e.g. `/assets../secret` starts with `/assets`). The `..`
+// traversal guard runs on the request path *before* the publicPath prefix is
+// stripped at a fixed character offset, so the stripped remainder can still
+// contain `..` that escapes the output directory once joined. After the fix,
+// `getFilenameFromUrl` verifies that the final resolved path stays inside
+// `outputPath` and returns `false` (pass-through / not-found) otherwise.
+describe('CVE-2026-76844: getFilenameFromUrl output-directory containment', () => {
+  function resolve(url, outputPath, publicPath) {
+    return getFilenameFromUrl(publicPath, { outputPath }, url);
+  }
+
+  // publicPath WITHOUT a trailing slash — the advisory PoC shape.
+  const escapingUrls = [
+    '/assets../secret.txt',
+    '/assets/../secret.txt',
+    '/assets../../secret.txt',
+    '/assets%2f..%2fsecret.txt',
+    '/assets..%2fsecret.txt',
+  ];
+
+  for (const url of escapingUrls) {
+    it(`rejects traversal outside outputPath for ${url}`, () => {
+      expect(resolve(url, '/output/assets', '/assets')).toBe(false);
+    });
+  }
+
+  // Legitimate requests must keep working after the fix.
+  it('still resolves a normal file under the output directory', () => {
+    expect(resolve('/assets/a.js', '/output/assets', '/assets')).toBe(
+      '/output/assets/a.js'
+    );
+  });
+
+  it('still resolves a nested file under the output directory', () => {
+    expect(resolve('/assets/js/b.js', '/output/assets', '/assets')).toBe(
+      '/output/assets/js/b.js'
+    );
+  });
+
+  it('still resolves files when publicPath is the root', () => {
+    expect(resolve('/a.js', '/dist', '/')).toBe('/dist/a.js');
+  });
+
+  it('still allows dot segments that are not traversal', () => {
+    expect(resolve('/folder/mono-v6.x.x', '/dist', '/')).toBe(
+      '/dist/folder/mono-v6.x.x'
+    );
+  });
+});

