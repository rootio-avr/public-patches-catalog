@@ -0,0 +1,45 @@
+import { getFilenameFromUrl } from '../lib/util';
+
+// Regression test for GHSA-p3f5-w63m-mxph (a.k.a. GHSA-g84c-rxfj-3j2c):
+// path traversal in getFilenameFromUrl when `publicPath` has no trailing
+// slash. A sibling path can share the publicPath prefix (for example
+// `/static../secret` starts with `/static`), so the stripped remainder may
+// contain `..` that escapes the output root once joined. The final resolved
+// path must be verified to stay within `outputPath`; otherwise
+// getFilenameFromUrl must return `false` (which the middleware turns into a
+// pass-through / not-found) instead of resolving to a file above the root.
+describe('GHSA-p3f5-w63m-mxph: getFilenameFromUrl output-directory containment', () => {
+  function resolve(url, outputPath = '/dist', publicPath = '/') {
+    return getFilenameFromUrl(publicPath, { outputPath }, url);
+  }
+
+  it('rejects traversal when publicPath has no trailing slash', () => {
+    // Advisory PoC shape: `/static../secret.txt` shares the `/static` prefix.
+    expect(resolve('/static../secret.txt', '/dist', '/static')).toBe(false);
+  });
+
+  it('rejects an explicit "../" escape under a no-slash publicPath', () => {
+    expect(resolve('/static/../secret.txt', '/dist', '/static')).toBe(false);
+  });
+
+  it('rejects encoded traversal that resolves outside outputPath', () => {
+    expect(resolve('/..%2f..%2fetc%2fpasswd', '/dist', '/')).toBe(false);
+  });
+
+  // Legitimate requests must keep working after the fix.
+  it('still serves a legitimate file under the "/static" prefix', () => {
+    expect(resolve('/static/index.html', '/dist', '/static')).toBe(
+      '/dist/index.html'
+    );
+  });
+
+  it('still resolves a normal file at the root publicPath', () => {
+    expect(resolve('/a.js')).toBe('/dist/a.js');
+  });
+
+  it('still allows dot segments that are not traversal', () => {
+    expect(resolve('/folder/mono-v6.x.x')).toBe(
+      '/dist/folder/mono-v6.x.x'
+    );
+  });
+});
