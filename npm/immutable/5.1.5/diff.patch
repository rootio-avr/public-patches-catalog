+  // With the old linear scan this is ~O(n^2) and takes seconds for 16384
+  // keys; with the seeded index it is ~linear and near-instant.
+  const floodKeys = collisionKeys(14); // 16384 colliding keys
+  const floodObj = {};
+  floodKeys.forEach((k, i) => (floodObj[k] = i));
