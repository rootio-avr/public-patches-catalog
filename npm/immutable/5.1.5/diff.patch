+/**
+ * Regression test for CVE-2026-59879.
+ *
+ * A List addresses its values through a 32-wide trie using signed 32-bit
+ * bitwise math. Sizes/indices at or beyond 2 ** 30 used to overflow that math:
+ * the level-raising loop in setListBounds() spun forever (hanging an empty
+ * List and OOM-crashing a populated one), and setSize silently wrapped large
+ * values. All of these must now throw a clear, catchable RangeError, while
+ * in-range operations keep working.
+ */
+const assert = require('node:assert');
+const { List, fromJS } = require('../dist/immutable.js');
+
+const tooBig = 2 ** 30;
+
+function arrayOfSize(s) {
+  return new Array(s).fill(0);
+}
+
+// Throws (does not hang) when setting a too-large index on an empty List.
+assert.throws(() => List().set(tooBig, 'x'), RangeError);
+
+// Throws (does not OOM-crash) when setting a too-large index on a populated List.
+assert.throws(() => List(arrayOfSize(64)).set(tooBig, 'x'), RangeError);
+
+// Throws for a numeric-string index coming through a setIn key path.
+assert.throws(
+  () => fromJS({ items: arrayOfSize(64) }).setIn(['items', '1073741824'], 'x'),
+  RangeError
+);
+
+// Throws on setSize beyond the max rather than silently truncating.
+assert.throws(() => List([1, 2, 3]).setSize(2 ** 31), RangeError);
+assert.throws(() => List([1, 2, 3]).setSize(2 ** 32 + 5), RangeError);
+
+// Still allows operations within the addressable range.
+assert.strictEqual(List([1, 2, 3]).setSize(1500).size, 1500);
+assert.strictEqual(List([1, 2, 3]).set(5, 'x').size, 6);
+assert.strictEqual(List([1, 2, 3]).setSize(tooBig).size, tooBig);
+
+// Handles a large in-range negative index without hanging: existing values
+// are shifted to the end of the grown List (exercises the 2 ** exp fallback).
+const result = List([1, 2, 3]).set(-(2 ** 29), 'x');
+assert.strictEqual(result.size, 2 ** 29);
+assert.strictEqual(result.get(result.size - 3), 1);
+assert.strictEqual(result.get(result.size - 2), 2);
+assert.strictEqual(result.get(result.size - 1), 3);
+
+console.log('CVE-2026-59879 regression test passed');

