+// Regression test for CVE-2026-59879 (CWE-190).
+//
+// A List addresses its values through a 32-wide trie using signed 32-bit
+// bitwise math. Sizes/indices at or beyond 2 ** 30 used to overflow that
+// math: the level-raising loop in setListBounds() spun forever, hanging an
+// empty List and OOM-crashing a populated one, while setSize silently
+// wrapped large values. All of these must now throw a clear, catchable
+// RangeError. This test loads the shipped bundle (package "main") directly,
+// since the published npm package ships only dist/immutable.js.
+var assert = require('assert');
+var Immutable = require('../dist/immutable.js');
+var List = Immutable.List;
+var fromJS = Immutable.fromJS;
+
+var tooBig = Math.pow(2, 30);
+
+function arrayOfSize(n) {
+  var a = new Array(n);
+  for (var i = 0; i < n; i++) {
+    a[i] = i;
+  }
+  return a;
+}
+
+// Throws (does not hang) when setting a too-large index on an empty List.
+assert.throws(function () {
+  List().set(tooBig, 'x');
+}, RangeError);
+
+// Throws (does not OOM-crash) when setting a too-large index on a populated List.
+assert.throws(function () {
+  List(arrayOfSize(64)).set(tooBig, 'x');
+}, RangeError);
+
+// Throws for a numeric-string index coming through a setIn key path.
+assert.throws(function () {
+  fromJS({ items: arrayOfSize(64) }).setIn(['items', '1073741824'], 'x');
+}, RangeError);
+
+// Throws on setSize beyond the max rather than silently truncating.
+// (Previously returned size 0 and size 5 respectively.)
+assert.throws(function () {
+  List([1, 2, 3]).setSize(Math.pow(2, 31));
+}, RangeError);
+assert.throws(function () {
+  List([1, 2, 3]).setSize(Math.pow(2, 32) + 5);
+}, RangeError);
+
+// Still allows operations within the addressable range.
+assert.strictEqual(List([1, 2, 3]).setSize(1500).size, 1500);
+assert.strictEqual(List([1, 2, 3]).set(5, 'x').size, 6);
+// Largest in-range size is accepted by the bounds math (sparse, no alloc).
+assert.strictEqual(List([1, 2, 3]).setSize(tooBig).size, tooBig);
+
+// Handles a large in-range negative index without hanging: exercises the
+// deep-tree origin-normalization path (the Math.pow(2, exp) fallback). Must
+// terminate rather than spin forever; existing values shift to the end.
+var result = List([1, 2, 3]).set(-Math.pow(2, 29), 'x');
+assert.strictEqual(result.size, Math.pow(2, 29));
+assert.strictEqual(result.get(result.size - 3), 1);
+assert.strictEqual(result.get(result.size - 2), 2);
+assert.strictEqual(result.get(result.size - 1), 3);
+
+console.log('CVE-2026-59879 regression test passed');
