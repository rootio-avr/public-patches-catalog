@@ -0,0 +1,164 @@
+// Regression test for CVE-2026-59880 (CWE-407 hash-flooding DoS).
+//
+// A Map/Set routes keys through a hash trie; keys that share one 32-bit hash()
+// land in a single flat HashCollisionNode. Before the fix that node scanned its
+// entries linearly, so an attacker feeding thousands of keys that collide under
+// the library's string hash (JVM-style `31 * h + c`) forced O(n^2) work per
+// operation -- a denial of service. The fix builds a seeded secondary index for
+// large collision buckets; is() still decides equality, so the index may only
+// narrow candidates, never lose a key.
+//
+// The published npm package ships only dist/immutable.js, so this test loads the
+// shipped bundle directly and asserts correctness (not timing).
+var assert = require('assert');
+var Immutable = require('../dist/immutable.js');
+var Map = Immutable.Map;
+var Set = Immutable.Set;
+var is = Immutable.is;
+
+// The blocks "Aa" and "BB" both hash to 65*31+97 === 66*31+66 === 2112, so any
+// concatenation of them shares one primary hash and is forced into a single
+// HashCollisionNode -- exactly the hash-flooding scenario the seeded index
+// guards against.
+function collisionKeys(rounds) {
+  var keys = [''];
+  for (var i = 0; i < rounds; i++) {
+    var next = [];
+    for (var j = 0; j < keys.length; j++) {
+      next.push(keys[j] + 'Aa');
+      next.push(keys[j] + 'BB');
+    }
+    keys = next;
+  }
+  return keys;
+}
+
+// The generated keys are all distinct (sanity check on the generator).
+(function () {
+  var keys = collisionKeys(8); // 256 keys
+  var seen = {};
+  var distinct = 0;
+  keys.forEach(function (k) {
+    if (!seen[k]) { seen[k] = true; distinct++; }
+  });
+  assert.strictEqual(distinct, keys.length);
+})();
+
+// Stores and retrieves every colliding key (well above the index threshold).
+(function () {
+  var keys = collisionKeys(11); // 2048 keys
+  var map = Map();
+  keys.forEach(function (k, i) { map = map.set(k, i); });
+
+  assert.strictEqual(map.size, keys.length);
+  assert.ok(keys.every(function (k, i) { return map.get(k) === i; }));
+  assert.strictEqual(map.get('not-a-colliding-key', 'default'), 'default');
+  assert.strictEqual(map.has(keys[0]), true);
+  assert.strictEqual(map.has('not-a-colliding-key'), false);
+})();
+
+// Transient and persistent builds produce the same Map.
+(function () {
+  var keys = collisionKeys(11);
+  var transient = Map().withMutations(function (m) {
+    keys.forEach(function (k, i) { m.set(k, i); });
+  });
+  var persistent = Map();
+  keys.forEach(function (k, i) { persistent = persistent.set(k, i); });
+
+  assert.strictEqual(transient.size, keys.length);
+  assert.strictEqual(persistent.size, keys.length);
+  assert.strictEqual(is(transient, persistent), true);
+  assert.ok(keys.every(function (k, i) { return persistent.get(k) === i; }));
+})();
+
+// Overwriting an existing colliding key keeps size and is persistent.
+(function () {
+  var keys = collisionKeys(11);
+  var map = Map(keys.map(function (k, i) { return [k, i]; }));
+  var updated = map.set(keys[100], 9999);
+
+  assert.strictEqual(updated.get(keys[100]), 9999);
+  assert.strictEqual(updated.size, map.size);
+  assert.strictEqual(map.get(keys[100]), 100);
+})();
+
+// Removing colliding keys keeps the rest retrievable (index stays valid).
+(function () {
+  var keys = collisionKeys(11);
+  var map = Map(keys.map(function (k, i) { return [k, i]; }));
+  var removed = map.remove(keys[50]).remove(keys[51]).remove(keys[52]);
+
+  assert.strictEqual(removed.size, map.size - 3);
+  assert.strictEqual(removed.get(keys[50], 'gone'), 'gone');
+  assert.strictEqual(removed.get(keys[51], 'gone'), 'gone');
+  assert.strictEqual(removed.get(keys[53]), 53);
+  assert.strictEqual(removed.get(keys[0]), 0);
+  assert.strictEqual(removed.get(keys[keys.length - 1]), keys.length - 1);
+})();
+
+// Iterates over every colliding entry exactly once.
+(function () {
+  var keys = collisionKeys(11);
+  var map = Map(keys.map(function (k, i) { return [k, i]; }));
+  var seen = {};
+  var count = 0;
+  map.forEach(function (v, k) {
+    if (!seen[k]) { seen[k] = true; count++; }
+  });
+  assert.strictEqual(count, keys.length);
+  assert.ok(keys.every(function (k) { return seen[k] === true; }));
+  assert.strictEqual(map.entrySeq().count(), keys.length);
+})();
+
+// Correct just below and just above the index threshold.
+(function () {
+  [3, 6].forEach(function (rounds) {
+    var keys = collisionKeys(rounds);
+    var map = Map();
+    keys.forEach(function (k, i) { map = map.set(k, i); });
+    assert.strictEqual(map.size, keys.length);
+    assert.ok(keys.every(function (k, i) { return map.get(k) === i; }));
+  });
+})();
+
+// Value-object keys that all share one hashCode: exercises the non-string
+// fallback in hashCollisionKey. Equality is still decided by equals().
+(function () {
+  function Collider(id) { this.id = id; }
+  Collider.prototype.equals = function (other) {
+    return other instanceof Collider && other.id === this.id;
+  };
+  Collider.prototype.hashCode = function () { return 7; };
+
+  var map = Map();
+  var items = [];
+  for (var i = 0; i < 50; i++) { items.push(new Collider(i)); }
+  items.forEach(function (c, idx) { map = map.set(c, idx); });
+
+  assert.strictEqual(map.size, items.length);
+  assert.ok(items.every(function (c, idx) { return map.get(new Collider(idx)) === idx; }));
+  assert.strictEqual(map.get(new Collider(999), 'absent'), 'absent');
+
+  var removed = map.remove(new Collider(25));
+  assert.strictEqual(removed.size, items.length - 1);
+  assert.strictEqual(removed.get(new Collider(25), 'gone'), 'gone');
+  assert.strictEqual(removed.get(new Collider(26)), 26);
+})();
+
+// A large flood of colliding keys stays fast (near-linear) and correct.
+(function () {
+  var keys = collisionKeys(14); // 16384 colliding keys
+  var map = Map();
+  keys.forEach(function (k, i) { map = map.set(k, i); });
+  assert.strictEqual(map.size, keys.length);
+  assert.strictEqual(map.get(keys[0]), 0);
+  assert.strictEqual(map.get(keys[keys.length - 1]), keys.length - 1);
+
+  var set = Set(keys);
+  assert.strictEqual(set.size, keys.length);
+  assert.strictEqual(set.has(keys[10]), true);
+  assert.strictEqual(set.remove(keys[10]).has(keys[10]), false);
+})();
+
+console.log('CVE-2026-59880 regression test passed');
