+++ b/test/cve-2026-59880.test.js
@@ -0,0 +1,167 @@
+'use strict';
+
+// Regression test for CVE-2026-59880 (immutable-js hash-collision DoS, CWE-407).
+//
+// The upstream fix (__tests__/Map.collision.ts) adds a seeded secondary index
+// to HashCollisionNode so that buckets full of keys sharing one Immutable
+// hash() no longer degrade to an O(n^2) linear scan. The published npm package
+// ships only compiled dist/ bundles, so this replacement test grounds the same
+// behavior against the installed package via `require('immutable')`.
+//
+// Run with either `node test/cve-2026-59880.test.js` or under jest (the
+// describe/it globals are used only when present).
+
+const assert = require('assert');
+// Require the package's own compiled entry point relatively: this test ships
+// inside the (dist-only) package, so `require('immutable')` cannot self-resolve.
+// Exercising ../dist/immutable.js validates the actual published artifact.
+const { Map, Set, is, hash, fromJS } = require('../dist/immutable.js');
+
+// Generates `2 ** rounds` distinct strings that all share the same
+// Immutable.hash(), by concatenating the classic "Aa"/"BB" collision blocks
+// (both equal 65*31+97 === 66*31+66 === 2112 under the JVM-style 31*h+c string
+// hash). Inserting these into a Map forces them all into a single
+// HashCollisionNode -- the hash-flooding scenario the fix guards against.
+function collisionKeys(rounds) {
+  let keys = [''];
+  for (let i = 0; i < rounds; i++) {
+    const next = [];
+    for (const k of keys) {
+      next.push(k + 'Aa');
+      next.push(k + 'BB');
+    }
+    keys = next;
+  }
+  return keys;
+}
+
+function run() {
+  // 1. The generated keys really do collide (the test is meaningful).
+  const sample = collisionKeys(8); // 256 keys
+  const h = hash(sample[0]);
+  assert.ok(
+    sample.every(k => hash(k) === h),
+    'expected all crafted keys to share one hash()'
+  );
+  assert.strictEqual(
+    new global.Set(sample).size,
+    sample.length,
+    'expected the crafted keys to be distinct'
+  );
+
+  // 2. The public, deterministic hash() of strings is unchanged: the seeded
+  //    secondary hash must never leak into hash().
+  assert.strictEqual(hash('a'), 97, 'hash("a") must stay 97');
+  assert.strictEqual(
+    hash('immutable-js'),
+    510203252,
+    'hash("immutable-js") must stay 510203252'
+  );
+
+  // 3. Correctness with thousands of colliding keys (well above the index
+  //    threshold): store, retrieve, transient vs persistent, overwrite, remove.
+  const keys = collisionKeys(11); // 2048 keys
+  const obj = {};
+  keys.forEach((k, i) => (obj[k] = i));
+  const map = Map(obj);
+
+  assert.strictEqual(map.size, keys.length, 'size after bulk build');
+  assert.ok(keys.every((k, i) => map.get(k) === i), 'every colliding key found');
+  assert.strictEqual(map.get('not-a-colliding-key', 'default'), 'default');
+  assert.strictEqual(map.has(keys[0]), true);
+  assert.strictEqual(map.has('not-a-colliding-key'), false);
+
+  const transient = Map().withMutations(m => {
+    keys.forEach((k, i) => m.set(k, i));
+  });
+  let persistent = Map();
+  keys.forEach((k, i) => (persistent = persistent.set(k, i)));
+  assert.ok(is(transient, persistent), 'transient equals persistent build');
+  assert.ok(is(transient, map), 'both equal the object-built map');
+
+  const overwritten = map.set(keys[100], 9999);
+  assert.strictEqual(overwritten.get(keys[100]), 9999);
+  assert.strictEqual(overwritten.size, map.size);
+  assert.strictEqual(map.get(keys[100]), 100, 'original untouched (persistence)');
+
+  const removed = map.remove(keys[50]).remove(keys[51]).remove(keys[52]);
+  assert.strictEqual(removed.size, map.size - 3);
+  assert.strictEqual(removed.get(keys[50], 'gone'), 'gone');
+  assert.strictEqual(removed.get(keys[53]), 53, 'index stayed valid after removes');
+  assert.strictEqual(removed.get(keys[keys.length - 1]), keys.length - 1);
+
+  // 4. equals()/hashCode() stay consistent for colliding-key maps.
+  const a = Map(keys.map((k, i) => [k, i]));
+  const b = Map(keys.map((k, i) => [k, i]));
+  assert.ok(is(a, b));
+  assert.strictEqual(a.hashCode(), b.hashCode());
+  assert.ok(!is(a, a.set(keys[0], -1)));
+
+  // 5. Set (backed by Map) handles colliding values.
+  const set = Set(keys);
+  assert.strictEqual(set.size, keys.length);
+  assert.ok(keys.every(k => set.has(k)));
+  assert.strictEqual(set.remove(keys[10]).has(keys[10]), false);
+
+  // 6. merge()/mergeDeep() work with colliding keys.
+  const merged = Map({ existing: -1 }).merge(obj);
+  assert.strictEqual(merged.get('existing'), -1);
+  assert.strictEqual(merged.get(keys[123]), 123);
+  assert.strictEqual(merged.size, keys.length + 1);
+  const deep = Map({ existing: -1 }).mergeDeep(fromJS(obj));
+  assert.strictEqual(deep.get(keys[123]), 123);
+
+  // 7. Value-object keys that all share one hashCode: equality is decided by
+  //    is()/equals(), never by the (here constant) secondary hash.
+  class Collider {
+    constructor(id) {
+      this.id = id;
+    }
+    equals(other) {
+      return other instanceof Collider && other.id === this.id;
+    }
+    hashCode() {
+      return 7;
+    }
+  }
+  const items = Array.from({ length: 50 }, (_, i) => new Collider(i));
+  let vmap = Map();
+  items.forEach((c, i) => (vmap = vmap.set(c, i)));
+  assert.strictEqual(vmap.size, items.length);
+  assert.ok(items.every((c, i) => vmap.get(new Collider(i)) === i));
+  assert.strictEqual(vmap.get(new Collider(999), 'absent'), 'absent');
+  assert.strictEqual(vmap.remove(new Collider(25)).size, items.length - 1);
+
+  // 8. DoS regression guard: a large flood of colliding keys must build and be
+  //    queryable quickly. With the pre-fix linear scan this is ~O(n^2) and
+  //    takes seconds for 16384 keys; with the seeded index it is ~linear.
+  const flood = collisionKeys(14); // 16384 colliding keys
+  const floodObj = {};
+  flood.forEach((k, i) => (floodObj[k] = i));
+  const started = Date.now();
+  const floodMap = Map(floodObj);
+  assert.strictEqual(floodMap.size, flood.length);
+  assert.strictEqual(floodMap.get(flood[0]), 0);
+  assert.strictEqual(floodMap.get(flood[flood.length - 1]), flood.length - 1);
+  assert.strictEqual(
+    floodMap.get(flood[Math.floor(flood.length / 2)]),
+    Math.floor(flood.length / 2)
+  );
+  const elapsed = Date.now() - started;
+  assert.ok(
+    elapsed < 5000,
+    'building a 16384-key collision bucket must not degrade to O(n^2) (took ' +
+      elapsed +
+      'ms)'
+  );
+}
+
+if (typeof describe === 'function' && typeof it === 'function') {
+  describe('CVE-2026-59880 hash-collision DoS', () => {
+    it('indexes large hash-collision buckets and keeps Map correct', run);
+  });
+} else {
+  run();
+  // eslint-disable-next-line no-console
+  console.log('CVE-2026-59880 regression test passed');
+}
