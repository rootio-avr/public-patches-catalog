+// Generates `2 ** rounds` distinct strings that all share the same
+// Immutable string hash, by concatenating the classic "Aa"/"BB" collision
+// blocks (both equal 65 * 31 + 97 === 66 * 31 + 66 === 2112 under the
+// JVM-style `31 * h + c` string hash). Inserting these into a Map forces
+// them all into a single HashCollisionNode -- the hash-flooding scenario
+// (CWE-407) this patch guards against.
+function collisionKeys(rounds) {
+  var keys = [''];
+  for (var i = 0; i < rounds; i++) {
+    var next = [];
+    for (var j = 0; j < keys.length; j++) {
+      next.push(keys[j] + 'Aa');
+      next.push(keys[j] + 'BB');
+    }
+    keys = next;
+  }
+  return keys;
+}
+
+describe('CVE-2026-59880 Map hash collisions', () => {
+
+  it('the generated keys really do collide (test is meaningful)', () => {
+    var keys = collisionKeys(8); // 256 keys
+    // All keys share one hash bucket, yet are all distinct strings.
+    var uniq = {};
+    keys.forEach(function (k) { uniq[k] = true; });
+    expect(Object.keys(uniq).length).toBe(keys.length);
+    // A Map keyed on them collapses to the single collision node but keeps size.
+    expect(Map(keys.map(function (k, i) { return [k, i]; })).size).toBe(keys.length);
+  });
+
+  it('stores and retrieves every colliding key, well above the index threshold', () => {
+    var keys = collisionKeys(11); // 2048 keys
+    var obj = {};
+    keys.forEach(function (k, i) { obj[k] = i; });
+    var map = Map(obj);
+
+    expect(map.size).toBe(keys.length);
+    expect(keys.every(function (k, i) { return map.get(k) === i; })).toBe(true);
+    expect(map.get('not-a-colliding-key', 'default')).toBe('default');
+    expect(map.has(keys[0])).toBe(true);
+    expect(map.has('not-a-colliding-key')).toBe(false);
+  });
+
+  it('behaves the same whether built transiently or persistently', () => {
+    var keys = collisionKeys(11);
+    var transient = Map().withMutations(function (m) {
+      keys.forEach(function (k, i) { m.set(k, i); });
+    });
