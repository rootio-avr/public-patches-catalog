+++ b/test/cve-2022-37599.test.js
@@ -0,0 +1,36 @@
+'use strict';
+
+const loaderUtils = require('../');
+
+// Regression test for CVE-2022-37599 (ReDoS in interpolateName's hash template
+// regex). A crafted name containing many leading '[' characters used to cause
+// catastrophic backtracking in /\[(?:([^:\]]+):)?.../. The fix excludes '[' from
+// the negated class (`[^[:\]]+`), so matching stays linear.
+describe('CVE-2022-37599 interpolateName ReDoS', () => {
+  it('does not hang on a malicious hash template', () => {
+    const loaderContext = { resourcePath: '/app/js/javascript.js' };
+    const maliciousName = '['.repeat(50000) + '[hash].[ext]';
+
+    const start = Date.now();
+    const result = loaderUtils.interpolateName(loaderContext, maliciousName, {
+      content: 'test content',
+    });
+    const elapsed = Date.now() - start;
+
+    // Before the fix this input backtracked for many seconds; it must now
+    // complete near-instantly.
+    expect(elapsed).toBeLessThan(2000);
+    expect(typeof result).toBe('string');
+  });
+
+  it('still interpolates a normal hash template', () => {
+    const loaderContext = { resourcePath: '/app/js/javascript.js' };
+    const result = loaderUtils.interpolateName(
+      loaderContext,
+      'js/[hash].script.[ext]',
+      { content: 'test content' }
+    );
+
+    expect(result).toBe('js/9473fdd0d880a43c21b7778d34872157.script.js');
+  });
+});
