+'use strict';
+
+const loaderUtils = require('../');
+
+describe('parseQuery() prototype pollution (CVE-2022-37601)', () => {
+  afterEach(() => {
+    // Ensure no test leaked a polluted prototype.
+    delete Object.prototype.polluted;
+  });
+
+  it('should not pollute Object.prototype via __proto__ key', () => {
+    loaderUtils.parseQuery('?__proto__[polluted]=yes');
+    expect({}.polluted).toBeUndefined();
+    expect(Object.prototype.polluted).toBeUndefined();
+  });
+
+  it('should not pollute Object.prototype via constructor.prototype', () => {
+    loaderUtils.parseQuery('?constructor[prototype][polluted]=yes');
+    expect({}.polluted).toBeUndefined();
+    expect(Object.prototype.polluted).toBeUndefined();
+  });
+
+  it('should still parse ordinary query params correctly', () => {
+    const result = loaderUtils.parseQuery('?name=cheesecake&warm=false');
+    expect(result.name).toBe('cheesecake');
+    expect(result.warm).toBe(false);
+  });
+});

