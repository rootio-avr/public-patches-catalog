+'use strict';
+
+const loaderUtils = require('../');
+
+// Regression test for CVE-2022-37599 (ReDoS in interpolateName hash regex).
+// A crafted name containing many leading '[' characters used to trigger
+// catastrophic backtracking in the hash-template regexp. The fix anchors the
+// prefix character class so interpolation completes quickly and safely.
+describe('CVE-2022-37599 interpolateName ReDoS', () => {
+  it('resolves a malicious name quickly without catastrophic backtracking', () => {
+    const loaderContext = { resourcePath: '/app/js/javascript.js' };
+    // Attack string: long run of '[' then ':hash' to force backtracking.
+    const maliciousName = '['.repeat(50000) + ':hash]';
+
+    const start = Date.now();
+    const result = loaderUtils.interpolateName(loaderContext, maliciousName, {
+      content: 'test content',
+    });
+    const elapsed = Date.now() - start;
+
+    // Vulnerable versions hang for many seconds/forever on this input.
+    expect(elapsed).toBeLessThan(2000);
+    // The '[hash]' token is not present, so nothing is interpolated.
+    expect(typeof result).toBe('string');
+  });
+
+  it('still interpolates a normal [hash] template correctly', () => {
+    const loaderContext = { resourcePath: '/app/js/javascript.js' };
+    const result = loaderUtils.interpolateName(
+      loaderContext,
+      '[hash].[ext]',
+      { content: 'test content' }
+    );
+    expect(result).toBe('9473fdd0d880a43c21b7778d34872157.js');
+  });
+});
