+'use strict';
+
+const loaderUtils = require('../');
+
+// Regression test for CVE-2022-37603 (ReDoS in interpolateName).
+// The vulnerable hash-template regex used `[^:\]]+` for the hash-type
+// prefix, which allowed catastrophic backtracking when a `[` was repeated
+// inside the prefix. The fix excludes `[` from that character class
+// (`[^[:\]]+`). A malicious `name` must therefore be processed quickly
+// instead of hanging the event loop.
+describe('CVE-2022-37603 interpolateName ReDoS', () => {
+  it('does not hang on a crafted hash template with many "[" chars', () => {
+    const malicious = '['.repeat(100000) + '[hash].[ext]';
+
+    const start = Date.now();
+    const result = loaderUtils.interpolateName(
+      { resourcePath: '/app/js/file.js' },
+      malicious,
+      { content: 'test content' }
+    );
+    const elapsed = Date.now() - start;
+
+    // With the vulnerable regex this would take exponential time; the fix
+    // keeps it linear. Anything under a couple of seconds proves no ReDoS.
+    expect(elapsed).toBeLessThan(2000);
+    expect(typeof result).toBe('string');
+  });
+
+  it('still interpolates a normal hash template correctly', () => {
+    const result = loaderUtils.interpolateName(
+      { resourcePath: '/app/js/javascript.js' },
+      'js/[hash].script.[ext]',
+      { content: 'test content' }
+    );
+
+    expect(result).toBe('js/9473fdd0d880a43c21b7778d34872157.script.js');
+  });
+});

