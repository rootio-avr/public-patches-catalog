+'use strict';
+
+const loaderUtils = require('../');
+
+describe('CVE-2022-37601 parseQuery prototype pollution', () => {
+  it('should not pollute Object.prototype via __proto__ query param', () => {
+    const result = loaderUtils.parseQuery('?__proto__[polluted]=yes');
+
+    expect({}.polluted).toBeUndefined();
+    expect(Object.prototype.polluted).toBeUndefined();
+    // result itself must not inherit from Object.prototype
+    expect(Object.getPrototypeOf(result)).toBe(null);
+  });
+
+  it('should still parse normal query params correctly', () => {
+    expect(loaderUtils.parseQuery('?name=cheesecake&warm=false')).toEqual({
+      name: 'cheesecake',
+      warm: false,
+    });
+  });
+});
