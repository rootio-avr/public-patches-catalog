+test('arrayLimit applies to [] notation (CVE-2025-15284)', function (t) {
+    t.test('many a[]= entries are converted to an object past arrayLimit', function (st) {
+        var arr = [];
+        for (var i = 0; i < 105; i++) {
+            arr[arr.length] = 'x';
+        }
+        var attack = 'a[]=' + arr.join('&a[]=');
+        var result = qs.parse(attack, { arrayLimit: 100 });
+
+        st.notOk(Array.isArray(result.a), 'arrayLimit is respected: result is an object, not an array');
+        st.equal(Object.keys(result.a).length, 105, 'all values are preserved');
+        st.end();
+    });
+
+    t.test('exactly at the limit stays as array', function (st) {
+        var result = qs.parse('a[]=1&a[]=2&a[]=3', { arrayLimit: 3 });
+        st.ok(Array.isArray(result.a), 'result is an array when exactly at limit');
+        st.deepEqual(result.a, ['1', '2', '3'], 'all values present');
+        st.end();
+    });
+
+    t.test('one over the limit converts to object', function (st) {
