@@ -0,0 +1,84 @@
+// CVE-2026-50017 backport: pin unscoped per-registry settings to their
+// source's registry at load time.
+//
+// When a workspace `.npmrc` (or pnpm-workspace.yaml, or any layer below the
+// user-level config) overrides `registry=` to a value the user did not
+// choose, unscoped credential keys (`_authToken`, `_auth`, `username`/
+// `_password`, `tokenHelper`) authored in the user-level config must NOT
+// follow the override. Each source's unscoped per-registry keys are
+// rewritten to their URL-scoped form (`//host[:port]/path/:<key>=...`)
+// using the same source's `registry=` value, or the npm default if the
+// source declares none. A later layer overriding `registry=` can no
+// longer rebind a credential to its own registry — the credential is
+// already pinned to the URL its author intended.
+//
+// `cert`/`key` (inline PEM) are pinned for the same trust-boundary
+// reason. `ca`/`cafile` are intentionally left unscoped: they are trust
+// anchors, not credentials, and corporate MITM-proxy setups depend on
+// them applying globally.
+import normalizeRegistryUrl from 'normalize-registry-url'
+
+const UNSCOPED_RESCOPABLE_KEYS = [
+  '_authToken', '_auth', 'username', '_password', 'tokenHelper',
+  'cert', 'key',
+] as const
+
+// Convert a registry URL to its nerf-darted form (`//host[:port]/path/`).
+// Mirrors `@pnpm/config.nerf-dart` so this package does not need a new
+// dependency for the backport.
+function nerfDart (url: string): string {
+  const parsed = new URL(url)
+  const pathname = parsed.pathname.endsWith('/') ? parsed.pathname : `${parsed.pathname}/`
+  return `//${parsed.host}${pathname}`
+}
+
+/**
+ * Rewrite any unscoped per-registry keys in `source` to their URL-scoped
+ * equivalents using `source.registry` (or `defaultRegistry` if the source
+ * does not declare its own). Mutates `source` in place and returns it.
+ *
+ * A URL-scoped key for the same registry already present in `source` is
+ * preserved — we never overwrite an explicit scoped value.
+ */
+export function rescopeUnscopedCreds (
+  source: Record<string, unknown>,
+  sourceLabel: string,
+  defaultRegistry: string,
+  warnings: string[]
+): Record<string, unknown> {
+  if (!UNSCOPED_RESCOPABLE_KEYS.some(key => key in source)) {
+    return source
+  }
+  const rawRegistry = typeof source.registry === 'string' && source.registry !== '' ? source.registry : null
+  const fallbackRegistry = rawRegistry ?? defaultRegistry
+  let nerfedRegistry: string
+  try {
+    nerfedRegistry = nerfDart(normalizeRegistryUrl(fallbackRegistry))
+  } catch {
+    // `registry=` resolved to something `URL` can't parse — often an
+    // unresolved `${VAR}` placeholder. Drop the unscoped keys (a bare
+    // token has nowhere safe to bind) and warn.
+    const dropped = UNSCOPED_RESCOPABLE_KEYS.filter(key => key in source)
+    for (const key of dropped) delete source[key]
+    warnings.push(`Unscoped per-registry settings (${dropped.join(', ')}) in "${sourceLabel}" were ignored: ` +
+      `the source's "registry" value (${JSON.stringify(source.registry)}) is not a parseable URL, so pnpm cannot pin them anywhere safe. ` +
+      'Write them URL-scoped (e.g. "//registry.example.com/:_authToken=...") to send them to a specific registry.')
+    return source
+  }
+  const rescoped: string[] = []
+  for (const key of UNSCOPED_RESCOPABLE_KEYS) {
+    if (!(key in source)) continue
+    const scopedKey = `${nerfedRegistry}:${key}`
+    if (!(scopedKey in source)) {
+      source[scopedKey] = source[key]
+    }
+    delete source[key]
+    rescoped.push(key)
+  }
+  if (rescoped.length > 0) {
+    warnings.push(`Unscoped per-registry settings (${rescoped.join(', ')}) in "${sourceLabel}" are deprecated. ` +
+      `pnpm pinned them to "${nerfedRegistry}" for this run, but a future release will stop supporting unscoped per-registry settings. ` +
+      `Write them as "${nerfedRegistry}:${rescoped[0]}=..." instead.`)
+  }
+  return source
+}

Description: Fix CVE-2026-50021 - require integrity for tarball-shaped lockfile resolutions
 A tampered pnpm-lock.yaml that strips the integrity field from a tarball
 resolution let the worker download the URL contents and mint a fresh
 integrity from the unverified bytes. An attacker who could both alter the
 lockfile and serve modified content at the referenced tarball URL could
 install a tampered package without any error - including under
 --frozen-lockfile.
 .
 pkgSnapshotToResolution now fails closed at lockfile-read time with
 ERR_PNPM_MISSING_TARBALL_INTEGRITY whenever a tarball-shaped resolution
 (no `type` field) lacks integrity. Git-hosted tarballs and file: tarballs
 remain exempt: the commit SHA in a git-host URL and the user-controlled
 local path already anchor the bytes.
 .
 Backport of upstream commit b8196b82 (PR #12007) from release/10,
 shipped in pnpm v10.34.1. Adapted for v10.32.1: target uses
 isGitHostedPkgUrl from @pnpm/pick-fetcher; the patch mirrors upstream by
 dropping that dependency and adding a local isGitHostedTarballUrl helper.
Origin: upstream, https://github.com/pnpm/pnpm/commit/b8196b82d10ccc4ace8b33e9f9d10b83014351dd
Author: Zoltan Kochan <z@kochan.io>
Last-Update: 2026-06-30

