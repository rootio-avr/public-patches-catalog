+'use strict';
+
+// Regression test for CVE-2026-27959: Host Header Injection via ctx.host / ctx.hostname.
+// A malformed Host header containing an "@" (userinfo) must not leak the
+// attacker-controlled portion; the real host must be extracted via the URL parser.
+
+const request = require('../test-helpers/context').request;
+const assert = require('assert');
+
+describe('CVE-2026-27959 req.host / req.hostname with @ in Host header', () => {
+  it('should extract the real host from userinfo@host format (host)', () => {
+    const req = request();
+    req.header.host = 'evil.com:fake@legitimate.com';
+    assert.strictEqual(req.host, 'legitimate.com');
+  });
+
+  it('should extract the real host from user@host format (host)', () => {
+    const req = request();
+    req.header.host = 'user@example.com';
+    assert.strictEqual(req.host, 'example.com');
+  });
+
+  it('should keep the port from userinfo@host:port format (host)', () => {
+    const req = request();
+    req.header.host = 'user:pass@example.com:8080';
+    assert.strictEqual(req.host, 'example.com:8080');
+  });
+
+  it('should sanitize @ in X-Forwarded-Host when proxy is trusted (host)', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-host'] = 'evil.com:fake@legitimate.com';
+    req.header.host = 'foo.com';
+    assert.strictEqual(req.host, 'legitimate.com');
+  });
+
+  it('should sanitize @ in :authority on HTTP/2 (host)', () => {
+    const req = request({
+      httpVersionMajor: 2,
+      httpVersion: '2.0'
+    });
+    req.header[':authority'] = 'evil.com:fake@legitimate.com';
+    req.header.host = 'foo.com';
+    assert.strictEqual(req.host, 'legitimate.com');
+  });
+
+  it('should return empty string for invalid host with @ (host)', () => {
+    const req = request();
+    req.header.host = 'user@';
+    assert.strictEqual(req.host, '');
+  });
+
+  it('should extract the real hostname from userinfo@host format (hostname)', () => {
+    const req = request();
+    req.header.host = 'evil.com:fake@legitimate.com';
+    assert.strictEqual(req.hostname, 'legitimate.com');
+  });
+
+  it('should drop the port for hostname from userinfo@host:port format (hostname)', () => {
+    const req = request();
+    req.header.host = 'user:pass@example.com:8080';
+    assert.strictEqual(req.hostname, 'example.com');
+  });
+
+  it('should still return a normal host untouched', () => {
+    const req = request();
+    req.header.host = 'foo.com:3000';
+    assert.strictEqual(req.host, 'foo.com:3000');
+    assert.strictEqual(req.hostname, 'foo.com');
+  });
+});
