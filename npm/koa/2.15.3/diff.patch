+'use strict';
+
+// Regression test for CVE-2025-25200 (GHSA-593f-38f6-jp5m):
+// ReDoS in the `host`, `protocol` and `ips` getters caused by the
+// `/\s*,\s*/` split regexp when `app.proxy` is enabled. The fix replaces
+// the vulnerable regexp with a linear-time comma split + trim.
+
+const request = require('../../test-helpers/context').request;
+const assert = require('assert');
+
+// A pathological comma/whitespace-padded value that would trigger
+// catastrophic backtracking against the removed `/\s*,\s*/` regexp.
+const evil = ',' + ' '.repeat(50000) + ',';
+
+// Generous ceiling; the vulnerable regexp takes seconds/minutes, the fix
+// completes in well under this bound.
+const MAX_MS = 1000;
+
+describe('CVE-2025-25200: ReDoS on host/protocol/ips getters', () => {
+  it('req.host resolves quickly for a padded X-Forwarded-Host', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-host'] = evil;
+    const start = Date.now();
+    const host = req.host;
+    const elapsed = Date.now() - start;
+    assert.ok(elapsed < MAX_MS, `req.host took ${elapsed}ms`);
+    assert.strictEqual(host, '');
+  });
+
+  it('req.protocol resolves quickly for a padded X-Forwarded-Proto', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-proto'] = evil;
+    const start = Date.now();
+    const proto = req.protocol;
+    const elapsed = Date.now() - start;
+    assert.ok(elapsed < MAX_MS, `req.protocol took ${elapsed}ms`);
+    assert.strictEqual(proto, '');
+  });
+
+  it('req.ips resolves quickly for a padded X-Forwarded-For', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-for'] = evil;
+    const start = Date.now();
+    const ips = req.ips;
+    const elapsed = Date.now() - start;
+    assert.ok(elapsed < MAX_MS, `req.ips took ${elapsed}ms`);
+    assert.ok(Array.isArray(ips));
+  });
+
+  it('still trims and splits normal comma-separated values', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-host'] = 'bar.com , baz.com';
+    assert.strictEqual(req.host, 'bar.com');
+
+    const req2 = request();
+    req2.app.proxy = true;
+    req2.header['x-forwarded-for'] = 'client , proxy1 , proxy2';
+    assert.deepStrictEqual(req2.ips, ['client', 'proxy1', 'proxy2']);
+  });
+});

Backport of upstream koa@2.16.4 fix for CVE-2026-27959 (commit b76ddc0).
Host header injection: parse userinfo@host via URL when Host contains '@'.
Apply after CVE-2025-25200 (introduces splitCommaSeparatedValues used in hunk context).

--- a/lib/request.js
+++ b/lib/request.js
@@ -257,7 +257,17 @@ module.exports = {
       if (!host) host = this.get('Host');
     }
     if (!host) return '';
-    return splitCommaSeparatedValues(host, 1)[0];
+    host = splitCommaSeparatedValues(host, 1)[0];
+    // Host header may contain userinfo (e.g., "user@host") which is invalid per RFC 7230.
+    // Use URL parser to correctly extract the host portion.
+    if (host.includes('@')) {
+      try {
+        host = new URL(`http://${host}`).host;
+      } catch (e) {
+        return '';
+      }
+    }
+    return host;
