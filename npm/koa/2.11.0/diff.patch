+'use strict';
+
+const request = require('./helpers/context').request;
+const assert = require('assert');
+
+// Regression test for CVE-2025-25200 (GHSA-593f-38f6-jp5m):
+// ReDoS in the host/protocol/ips getters when app.proxy is enabled.
+// The vulnerable code split forwarded headers with the regexp /\s*,\s*/,
+// which is quadratic on crafted whitespace. The fix replaces it with a
+// plain String#split(',') followed by trim(). These tests assert the
+// fixed getters still parse forwarded values correctly and terminate
+// quickly on a malicious input.
+describe('CVE-2025-25200: redos on host/protocol/ips getters', () => {
+  it('req.host returns first X-Forwarded-Host value (trimmed) when proxy trusted', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-host'] = 'bar.com, baz.com';
+    assert.equal(req.host, 'bar.com');
+  });
+
+  it('req.protocol returns first X-Forwarded-Proto value (trimmed) when proxy trusted', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-proto'] = 'https, http';
+    assert.equal(req.protocol, 'https');
+  });
+
+  it('req.ips parses X-Forwarded-For into trimmed values when proxy trusted', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-for'] = '127.0.0.1, 127.0.0.2';
+    assert.deepEqual(req.ips, ['127.0.0.1', '127.0.0.2']);
+  });
+
+  it('does not hang on a ReDoS-crafted X-Forwarded-Host header', () => {
+    const req = request();
+    req.app.proxy = true;
+    // A long run of whitespace with no comma is the pathological input for
+    // the old /\s*,\s*/ regexp. The fixed splitter is linear.
+    const malicious = ' '.repeat(50000) + '\t'.repeat(50000);
+    req.header['x-forwarded-host'] = malicious;
+    const start = Date.now();
+    const host = req.host;
+    const elapsed = Date.now() - start;
+    assert.equal(host, malicious.trim());
+    assert.ok(elapsed < 1000, `host getter took too long: ${elapsed}ms`);
+  });
+});
