+'use strict';
+
+// Regression test for CVE-2026-27959: a malformed Host header containing an
+// "@" (userinfo) segment (e.g. "evil.com:fake@legitimate.com") must not be
+// returned verbatim. koa must reparse it with the URL parser so req.host
+// reflects the real host portion rather than an attacker-controlled value.
+
+const Stream = require('stream');
+const assert = require('assert');
+const Koa = require('../lib/application');
+
+function request(req) {
+  const socket = new Stream.Duplex();
+  req = Object.assign({ headers: {}, socket }, Stream.Readable.prototype, req);
+  const res = Object.assign({ _headers: {}, socket }, Stream.Writable.prototype);
+  req.socket.remoteAddress = req.socket.remoteAddress || '127.0.0.1';
+  res.getHeader = k => res._headers[k.toLowerCase()];
+  res.setHeader = (k, v) => (res._headers[k.toLowerCase()] = v);
+  res.removeHeader = k => delete res._headers[k.toLowerCase()];
+  return new Koa().createContext(req, res).request;
+}
+
+describe('CVE-2026-27959: req.host with Host header containing @', () => {
+  it('parses host from userinfo@host format', () => {
+    const req = request();
+    req.header.host = 'evil.com:fake@legitimate.com';
+    assert.strictEqual(req.host, 'legitimate.com');
+  });
+
+  it('parses host from user@host format', () => {
+    const req = request();
+    req.header.host = 'user@example.com';
+    assert.strictEqual(req.host, 'example.com');
+  });
+
+  it('parses host with port from userinfo@host:port format', () => {
+    const req = request();
+    req.header.host = 'user:pass@example.com:8080';
+    assert.strictEqual(req.host, 'example.com:8080');
+  });
+
+  it('honors @ in X-Forwarded-Host when proxy is trusted', () => {
+    const req = request();
+    req.app.proxy = true;
+    req.header['x-forwarded-host'] = 'evil.com:fake@legitimate.com';
+    req.header.host = 'foo.com';
+    assert.strictEqual(req.host, 'legitimate.com');
+  });
+
+  it('honors @ in :authority on HTTP/2', () => {
+    const req = request({ httpVersionMajor: 2, httpVersion: '2.0' });
+    req.header[':authority'] = 'evil.com:fake@legitimate.com';
+    req.header.host = 'foo.com';
+    assert.strictEqual(req.host, 'legitimate.com');
+  });
+
+  it('returns empty string for invalid host with @', () => {
+    const req = request();
+    req.header.host = 'user@';
+    assert.strictEqual(req.host, '');
+  });
+
+  it('leaves a normal host unchanged', () => {
+    const req = request();
+    req.header.host = 'foo.com:3000';
+    assert.strictEqual(req.host, 'foo.com:3000');
+  });
+});
