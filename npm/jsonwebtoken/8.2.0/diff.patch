--- /dev/null
+++ b/test/cve-2022-23529.test.js
@@ -0,0 +1,45 @@
+var jwt = require('../index');
+var assert = require('assert');
+var crypto = require('crypto');
+
+// Regression tests for CVE-2022-23529 (GHSA-27h2-hvpr-p74q): insecure input
+// validation in jwt.verify(). Before the fix, verify() called
+// secretOrPublicKey.toString() on caller-supplied key material. A malicious
+// object with an overridden toString() could therefore achieve arbitrary code
+// execution. Upstream v9.0.0 converts key material with
+// crypto.createPublicKey/createSecretKey first and rejects invalid input with
+// "secretOrPublicKey is not valid key material" without invoking toString.
+
+describe('CVE-2022-23529 - malicious secretOrPublicKey toString()', function () {
+  it('rejects a malicious object with overridden toString (no arbitrary execution)', function () {
+    var token = jwt.sign({ foo: 'bar' }, 'secret', { algorithm: 'HS256' });
+    var executed = false;
+    var malicious = {
+      toString: function () {
+        executed = true;
+        throw new Error('Arbitrary Code Execution');
+      }
+    };
+
+    assert.throws(function () {
+      jwt.verify(token, malicious);
+    }, /not valid key material/);
+    assert.strictEqual(executed, false);
+  });
+
+  it('still verifies a legitimate HS256 token with a string secret', function () {
+    var token = jwt.sign({ foo: 'bar' }, 'secret', { algorithm: 'HS256' });
+    var decoded = jwt.verify(token, 'secret', { algorithms: ['HS256'] });
+    assert.strictEqual(decoded.foo, 'bar');
+  });
+
+  it('rejects an HS256 token verified with an RSA public key', function () {
+    var pair = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 });
+    var pubPem = pair.publicKey.export({ type: 'spki', format: 'pem' });
+    var token = jwt.sign({ foo: 'bar' }, 'secret', { algorithm: 'HS256' });
+
+    assert.throws(function () {
+      jwt.verify(token, pubPem, { algorithms: ['HS256'] });
+    }, /secretOrPublicKey must be a symmetric key when using HS256/);
+  });
+});
