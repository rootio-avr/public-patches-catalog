+      allowedAlgorithms = ['RS256', 'RS384', 'RS512', 'ES256', 'ES384', 'ES512'];
+    } else {
+      allowedAlgorithms = ['HS256', 'HS384', 'HS512'];
+    }
+  }
+
+  if (allowedAlgorithms.indexOf(headerAlg) === -1) {
+    return callback(new Error('invalid algorithm'));
+  }
