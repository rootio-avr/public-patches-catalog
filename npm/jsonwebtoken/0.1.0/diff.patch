+  // instead of trusting the attacker-controlled JWT header. Without this, a
+  // forged 'alg' header (e.g. 'none', or an HMAC algorithm verified against an
+  // asymmetric public key) can defeat signature verification.
+  var decodedForHeader;
+  try {
+    decodedForHeader = jws.decode(jwtString);
+  } catch (e) {
+    decodedForHeader = null;
+  }
+
+  if (!decodedForHeader || !decodedForHeader.header || !decodedForHeader.header.alg) {
+    return callback(new Error('invalid token: missing algorithm header'));
+  }
+
+  var headerAlg = decodedForHeader.header.alg;
+
+  var allowedAlgorithms = options.algorithms;
