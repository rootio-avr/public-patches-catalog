+// Regression test for CVE-2022-23529
+// jwt.verify() must not trust the attacker-controlled JWT 'alg' header. It must
+// reject tokens whose algorithm is outside an allow-list — in particular
+// 'alg':'none' (signature bypass) and algorithm-confusion attempts where an
+// asymmetric public key would be used to verify an HMAC-signed token.
+var jwt = require('../index');
+var jws = require('jws');
+var fs = require('fs');
+var path = require('path');
+
+var assert = require('chai').assert;
+
+describe('CVE-2022-23529 algorithm allow-list', function() {
+  var secret = 'shhhhhh';
+
+  it('rejects a token forged with alg:none', function(done) {
+    // Craft an unsigned token declaring alg:none.
+    var header = new Buffer(JSON.stringify({ typ: 'JWT', alg: 'none' })).toString('base64');
+    var payload = new Buffer(JSON.stringify({ foo: 'bar' })).toString('base64');
+    var forged = header + '.' + payload + '.';
+
+    jwt.verify(forged, secret, function(err, decoded) {
+      assert.ok(err, 'expected verification of alg:none token to fail');
+      assert.notOk(decoded, 'no payload should be returned for a forged token');
+      done();
+    });
+  });
+
+  it('rejects an HS256 token when only asymmetric algorithms are allowed (algorithm confusion)', function(done) {
+    var pub = fs.readFileSync(path.join(__dirname, 'pub.pem'));
+    // Attacker signs with HMAC using the RSA public key bytes as the shared secret.
+    var forged = jws.sign({
+      header: { alg: 'HS256', typ: 'JWT' },
+      payload: { foo: 'bar' },
+      secret: pub
+    });
+
+    // Caller intends RSA verification (asymmetric key material supplied).
+    jwt.verify(forged, pub, function(err, decoded) {
+      assert.ok(err, 'expected HS256-vs-RSA confusion token to be rejected');
+      assert.notOk(decoded);
+      done();
+    });
+  });
+
+  it('honors an explicit options.algorithms allow-list', function(done) {
+    var token = jwt.sign({ foo: 'bar' }, secret, { algorithm: 'HS256' });
+    jwt.verify(token, secret, { algorithms: ['HS384'] }, function(err, decoded) {
+      assert.ok(err, 'HS256 token must be rejected when only HS384 is allowed');
+      assert.notOk(decoded);
+      done();
+    });
+  });
+
+  it('still verifies a legitimately signed HS256 token', function(done) {
+    var token = jwt.sign({ foo: 'bar' }, secret, { algorithm: 'HS256' });
+    jwt.verify(token, secret, function(err, decoded) {
+      assert.notOk(err, 'a genuine HS256 token should still verify');
+      assert.ok(decoded && decoded.foo === 'bar');
+      done();
+    });
+  });
+});

