Description: Fix CVE-2022-23529 — enforce a signature algorithm allow-list in jwt.verify()
 The 0.1.0 verify() delegates directly to jws.verify(jwtString, secretOrPublicKey)
 and lets the attacker-controlled JWT 'alg' header choose the verification
 algorithm. This permits algorithm confusion (an asymmetric public key verified
 as an HMAC secret) and the 'alg':'none' signature bypass. This patch decodes the
 token header first and rejects the token unless its declared algorithm is in an
 allow-list — either the caller-supplied options.algorithms, or a safe default
 derived from the supplied key material (HMAC for shared secrets, RSA/ECDSA for
 PEM keys). 'none' and missing/invalid alg headers are always rejected.
Origin: ai-synthesized, CVE-2022-23529
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-08-02

--- a/index.js
+++ b/index.js
@@ -28,6 +28,38 @@
   if ((typeof options === 'function') && !callback) callback = options;
   if (!options) options = {};

+  // CVE-2022-23529: restrict the accepted signature algorithm to an allow-list
+  // instead of trusting the attacker-controlled JWT header. Without this, a
+  // forged 'alg' header (e.g. 'none', or an HMAC algorithm verified against an
+  // asymmetric public key) can defeat signature verification.
+  var decodedForHeader;
+  try {
+    decodedForHeader = jws.decode(jwtString);
+  } catch (e) {
+    decodedForHeader = null;
+  }
+
+  if (!decodedForHeader || !decodedForHeader.header || !decodedForHeader.header.alg) {
+    return callback(new Error('invalid token: missing algorithm header'));
+  }
+
+  var headerAlg = decodedForHeader.header.alg;
+
+  var allowedAlgorithms = options.algorithms;
+  if (!allowedAlgorithms) {
+    var keyStr = secretOrPublicKey == null ? '' : secretOrPublicKey.toString();
+    if (/BEGIN (PUBLIC KEY|RSA PUBLIC KEY|CERTIFICATE|PGP PUBLIC KEY BLOCK)/.test(keyStr) ||
+        /BEGIN (PRIVATE KEY|RSA PRIVATE KEY|EC PRIVATE KEY|ENCRYPTED PRIVATE KEY)/.test(keyStr)) {
+      allowedAlgorithms = ['RS256', 'RS384', 'RS512', 'ES256', 'ES384', 'ES512'];
+    } else {
+      allowedAlgorithms = ['HS256', 'HS384', 'HS512'];
+    }
+  }
+
+  if (allowedAlgorithms.indexOf(headerAlg) === -1) {
+    return callback(new Error('invalid algorithm'));
+  }
+
   var valid;
   try {
     valid = jws.verify(jwtString, secretOrPublicKey);
