+// Regression test for CVE-2022-23539 (CWE-327).
+// jsonwebtoken@0.1.0 delegated verification to jws@~0.2.2, which selects the
+// algorithm from the attacker-controlled JWT header with no key-type/algorithm
+// compatibility check. verify() now rejects mismatched key-type/algorithm
+// pairings (algorithm confusion) before delegating to jws.verify().
+var jwt = require('../index');
+var fs = require('fs');
+var path = require('path');
+var assert = require('chai').assert;
+
+describe('CVE-2022-23539 key-type/algorithm confusion', function() {
+  var pub = fs.readFileSync(path.join(__dirname, 'pub.pem'));
+
+  it('rejects an HS256 token verified with an asymmetric (PEM) public key', function(done) {
+    // Attacker forges an HS256 token using the victim's PUBLIC key as the
+    // HMAC shared secret. Pre-fix jws would accept it; verify() must reject.
+    var forged = jwt.sign({ foo: 'bar' }, pub, { algorithm: 'HS256' });
+    jwt.verify(forged, pub, function(err, decoded) {
+      assert.isUndefined(decoded);
+      assert.isNotNull(err);
+      done();
+    });
+  });
+
+  it('rejects an RS256 token verified with a symmetric string secret', function(done) {
+    // Inverse confusion: asymmetric algorithm declared but a symmetric secret
+    // supplied for verification must be rejected before touching jws.
+    var forged = jwt.sign({ foo: 'bar' }, 'shhhhhh', { algorithm: 'RS256' });
+    jwt.verify(forged, 'shhhhhh', function(err, decoded) {
+      assert.isUndefined(decoded);
+      assert.isNotNull(err);
+      done();
+    });
+  });
+
+  it('enforces an explicit algorithms allow-list', function(done) {
+    var token = jwt.sign({ foo: 'bar' }, 'shhhhhh', { algorithm: 'HS256' });
+    jwt.verify(token, 'shhhhhh', { algorithms: ['HS512'] }, function(err, decoded) {
+      assert.isUndefined(decoded);
+      assert.isNotNull(err);
+      done();
+    });
+  });
+
+  it('still accepts a legitimate HS256 token with a symmetric secret', function(done) {
+    var token = jwt.sign({ foo: 'bar' }, 'shhhhhh', { algorithm: 'HS256' });
+    jwt.verify(token, 'shhhhhh', function(err, decoded) {
+      assert.isNull(err);
+      assert.equal('bar', decoded.foo);
+      done();
+    });
+  });
+});
