+// attacker-controlled JWT header and performs no key-type/algorithm
+// compatibility check. The helpers below let verify() reject mismatched
+// key-type/algorithm pairings (algorithm confusion, e.g. an RSA public key
+// used as an HMAC secret, or a DSA/EC key paired with an incompatible
+// algorithm) before delegating to jws.verify().
+function keyIsPEM(secretOrPublicKey) {
+  if (secretOrPublicKey == null) return false;
+  var s = Buffer.isBuffer(secretOrPublicKey) ?
+    secretOrPublicKey.toString('ascii') : String(secretOrPublicKey);
+  return s.indexOf('-----BEGIN') !== -1;
+}
+
+function detectAsymmetricKeyType(secretOrPublicKey) {
+  try {
+    var s = Buffer.isBuffer(secretOrPublicKey) ?
+      secretOrPublicKey.toString('ascii') : String(secretOrPublicKey);
+    if (s.indexOf('CERTIFICATE-----') !== -1 &&
+        typeof crypto.X509Certificate === 'function') {
+      return new crypto.X509Certificate(secretOrPublicKey).publicKey.asymmetricKeyType;
+    }
+    if (s.indexOf('PRIVATE KEY-----') !== -1 &&
+        typeof crypto.createPrivateKey === 'function') {
+      return crypto.createPrivateKey(secretOrPublicKey).asymmetricKeyType;
+    }
+    if (typeof crypto.createPublicKey === 'function') {
+      return crypto.createPublicKey(secretOrPublicKey).asymmetricKeyType;
+    }
