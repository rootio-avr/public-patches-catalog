+var jwt = require('../index');
+var crypto = require('crypto');
+var fs = require('fs');
+var path = require('path');
+
+var expect = require('chai').expect;
+
+// Regression tests for CVE-2022-23529 / GHSA-8cf7-32gw-wr33:
+// the key type must be compatible with the requested algorithm.
+describe('asymmetric key type validation', function() {
+  var rsaPriv = fs.readFileSync(path.join(__dirname, 'priv.pem'));
+  var rsaPub = fs.readFileSync(path.join(__dirname, 'pub.pem'));
+
+  var ec = crypto.generateKeyPairSync('ec', {
+    namedCurve: 'prime256v1',
+    publicKeyEncoding: { type: 'spki', format: 'pem' },
+    privateKeyEncoding: { type: 'pkcs8', format: 'pem' }
+  });
+
+  function b64(obj) {
+    return Buffer.from(JSON.stringify(obj)).toString('base64')
+      .replace(/=/g, '').replace(/\+/g, '-').replace(/\//g, '_');
+  }
+
+  it('should reject signing with an EC private key and an RSA algorithm', function() {
+    expect(function() {
+      jwt.sign({ foo: 'bar' }, ec.privateKey, { algorithm: 'RS256' });
+    }).to.throw(/"alg" parameter for "ec" key type must be one of: ES256, ES384, ES512/);
+  });
+
+  it('should reject signing with an RSA private key and an EC algorithm', function() {
+    expect(function() {
+      jwt.sign({ foo: 'bar' }, rsaPriv, { algorithm: 'ES256' });
+    }).to.throw(/"alg" parameter for "rsa" key type must be one of/);
+  });
+
+  it('should reject signing with an EC key on the wrong curve', function() {
+    var p384 = crypto.generateKeyPairSync('ec', {
+      namedCurve: 'secp384r1',
+      publicKeyEncoding: { type: 'spki', format: 'pem' },
+      privateKeyEncoding: { type: 'pkcs8', format: 'pem' }
+    });
+    if (!crypto.createPrivateKey(p384.privateKey).asymmetricKeyDetails) return;
+    expect(function() {
+      jwt.sign({ foo: 'bar' }, p384.privateKey, { algorithm: 'ES256' });
+    }).to.throw(/requires curve "prime256v1"/);
+  });
+
+  it('should reject verifying with an RSA public key and an EC algorithm', function(done) {
+    var token = b64({ typ: 'JWT', alg: 'ES256' }) + '.' + b64({ foo: 'bar' }) + '.c2ln';
+    jwt.verify(token, rsaPub, function(err, decoded) {
+      expect(decoded).to.equal(undefined);
+      expect(err).to.be.an.instanceof(Error);
+      expect(err.message).to.match(/"alg" parameter for "rsa" key type must be one of/);
+      done();
+    });
+  });
+
+  it('should reject verifying with an EC public key and an RSA algorithm', function(done) {
+    var token = b64({ typ: 'JWT', alg: 'RS256' }) + '.' + b64({ foo: 'bar' }) + '.c2ln';
+    jwt.verify(token, ec.publicKey, function(err, decoded) {
+      expect(decoded).to.equal(undefined);
+      expect(err).to.be.an.instanceof(Error);
+      expect(err.message).to.match(/"alg" parameter for "ec" key type must be one of/);
+      done();
+    });
+  });
+
+  it('should still accept a matching RSA key pair', function(done) {
+    var token = jwt.sign({ foo: 'bar' }, rsaPriv, { algorithm: 'RS256' });
+    jwt.verify(token, rsaPub, function(err, decoded) {
+      expect(err).to.equal(null);
+      expect(decoded.foo).to.equal('bar');
+      done();
+    });
+  });
+});

