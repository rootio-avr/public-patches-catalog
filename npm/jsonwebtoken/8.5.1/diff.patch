diff --git a/test/cve-2022-23529.test.js b/test/cve-2022-23529.test.js
new file mode 100644
index 0000000..c8a7c79
--- /dev/null
+++ b/test/cve-2022-23529.test.js
@@ -0,0 +1,78 @@
+// Regression test for CVE-2022-23529 (GHSA-8cf7-32gw-wr33):
+// key-type / algorithm confusion in jwt.verify(). Before the fix, jsonwebtoken
+// did not validate that the supplied key's type matched the algorithm in the
+// JWT header, so an asymmetric public key could be accepted for an HS* token
+// (and an asymmetric key could be used with a mismatched "alg"). The fix adds
+// lib/validateAsymmetricKey.js and wires key-material conversion + type checks
+// into verify.js.
+//
+// Grounded on the upstream regression suite added by the fix commit
+// (test/validateAsymmetricKey.tests.js) plus the public jwt.verify() path that
+// is the CVE's actual attack surface. Uses only fixtures already present in
+// this package's test directory. Plain node:assert so it is collectable by the
+// project's mocha runner without new dependencies.
+
+var assert = require('assert');
+var fs = require('fs');
+var path = require('path');
+var crypto = require('crypto');
+
+var jwt = require('../index');
+var validateAsymmetricKey = require('../lib/validateAsymmetricKey');
+
+function loadPrivateKey(filename) {
+  return crypto.createPrivateKey(fs.readFileSync(path.join(__dirname, filename)));
+}
+
+describe('CVE-2022-23529: key type / algorithm confusion in jwt.verify', function () {
+
+  // A well-formed HS256 token. The signature does not matter: the fix must
+  // reject the key-type mismatch before jws signature verification is reached.
+  var HS256_TOKEN = 'eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9' +
+    '.eyJmb28iOiJiYXIiLCJpYXQiOjE0MjY1NDY5MTl9' +
+    '.ETgkTn8BaxIX4YqvUWVFPmum3moNZ7oARZtSBXb_vP4';
+
+  it('rejects an HS256 token verified with an asymmetric (RSA) public key', function () {
+    var rsaPublicKey = fs.readFileSync(path.join(__dirname, 'pub.pem'), 'utf8');
+
+    // With no explicit algorithms, key-type inference must choose asymmetric
+    // algorithms for an RSA public key, so an HS256 token is an invalid
+    // algorithm rather than being blindly verified with the public key bytes
+    // as an HMAC secret.
+    assert.throws(function () {
+      jwt.verify(HS256_TOKEN, rsaPublicKey);
+    }, /invalid algorithm/);
+
+    // Even if the caller explicitly whitelists HS256, the key-type check must
+    // still refuse an asymmetric key for a symmetric algorithm.
+    assert.throws(function () {
+      jwt.verify(HS256_TOKEN, rsaPublicKey, { algorithms: ['HS256'] });
+    }, /secretOrPublicKey must be a symmetric key when using HS256/);
+  });
+
+  it('still verifies a legitimate HS256 token with a symmetric secret', function () {
+    // Control case: the fix must not break the normal symmetric path.
+    var token = jwt.sign({ foo: 'bar' }, 'shhhh', { algorithm: 'HS256' });
+    var decoded = jwt.verify(token, 'shhhh', { algorithms: ['HS256'] });
+    assert.strictEqual(decoded.foo, 'bar');
+  });
+
+  it('validateAsymmetricKey rejects an "alg" that does not match the key type', function () {
+    // Directly exercise the new validation module the same way the upstream
+    // regression suite does: an EC private key must not be accepted for RS256.
+    var ecKey = loadPrivateKey('ecdsa-private.pem');
+    assert.throws(function () {
+      validateAsymmetricKey('RS256', ecKey);
+    }, /"alg" parameter for "ec" key type must be one of:/);
+  });
+
+  it('validateAsymmetricKey is a no-op when algorithm or key is missing', function () {
+    // Matches upstream: missing parameters must pass through without throwing.
+    assert.doesNotThrow(function () {
+      validateAsymmetricKey('ES256');
+    });
+    assert.doesNotThrow(function () {
+      validateAsymmetricKey(null, loadPrivateKey('rsa-private.pem'));
+    });
+  });
+});
