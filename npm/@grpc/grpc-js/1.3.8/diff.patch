+/*
+ * Regression test for CVE-2026-48068.
+ *
+ * A gRPC server built on http2 must attach an 'error' listener to every
+ * inbound stream at the very start of its 'stream' handler. Before the fix,
+ * the only 'error' listener was installed by the Http2ServerCallStream
+ * constructor, which runs *after* the handler inspects the request (content
+ * type, server address, handler lookup). If the underlying HTTP/2 stream
+ * emitted an 'error' during that window (e.g. an invalid / abruptly reset
+ * request), Node would raise an uncaught 'error' exception and crash the
+ * whole server process.
+ *
+ * This test emits a controlled 'error' on a freshly opened server stream
+ * before any call object could be constructed, and asserts that the process
+ * survives (i.e. the listener is now installed by the 'stream' handler).
+ */
+'use strict';
+
+const assert = require('assert');
+const http2 = require('http2');
+const grpc = require('../build/src');
+
+describe('CVE-2026-48068: server survives early stream error', () => {
+  let server;
+  let port;
+
+  before((done) => {
+    server = new grpc.Server();
+    server.bindAsync(
+      '127.0.0.1:0',
+      grpc.ServerCredentials.createInsecure(),
+      (err, boundPort) => {
+        assert.ifError(err);
+        port = boundPort;
+        server.start();
+        done();
+      }
+    );
+  });
+
+  after((done) => {
+    server.tryShutdown(() => done());
+  });
+
+  it('does not crash when a stream errors before the call is constructed', (done) => {
+    let sawUncaught = false;
+    const onUncaught = () => {
+      sawUncaught = true;
+    };
+    process.once('uncaughtException', onUncaught);
+
+    const client = http2.connect(`http://127.0.0.1:${port}`);
+    client.on('error', () => {
+      /* client-side errors are expected and irrelevant here */
+    });
+
+    // Open a stream that looks like a gRPC request so the server's 'stream'
+    // handler begins processing it, then force a stream-level error via an
+    // abrupt RST so the 'error' event fires early in the handler.
+    const req = client.request({
+      ':path': '/does.not/Exist',
+      'content-type': 'application/grpc',
+    });
+    req.on('error', () => {
+      /* the RST surfaces as a client error too; ignore */
+    });
+    req.close(http2.constants.NGHTTP2_INTERNAL_ERROR);
+
+    // Give the server a tick to process the stream lifecycle, then assert the
+    // process did not crash with an uncaught 'error' exception.
+    setTimeout(() => {
+      process.removeListener('uncaughtException', onUncaught);
+      client.close();
+      assert.strictEqual(
+        sawUncaught,
+        false,
+        'server raised an uncaught exception on an early stream error'
+      );
+      done();
+    }, 200);
+  });
+});

Fix crashes when receiving malformed compressed data (CVE-2026-48069)

Malformed deflate/gzip payloads cause zlib.inflate()/zlib.unzip() to invoke
their callback with an error. In grpc-js 1.3.8 the callback-style decompression
handlers reject the promise with the raw zlib error object, which propagates as
an unstructured rejection and can crash the process while handling untrusted
compressed messages. Hand-adapted from upstream commit 2375eadc (which guards
the stream-based decompressor via an 'error' listener): reject with a structured
Status.INTERNAL gRPC error so malformed compressed data is handled gracefully.

