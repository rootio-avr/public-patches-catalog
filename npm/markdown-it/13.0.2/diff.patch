+// Regression test for AIKIDO-2026-549894
+// Quadratic complexity (ReDoS/DoS) in the smartquotes rule when quote
+// openers and closers are of mismatched types. Ported from upstream
+// test/markdown-it/pathological.test.mjs ("smartquotes with mismatched
+// opener and closer types"). Before the fix, rewinding the whole opener
+// stack for every closing quote made rendering O(n^2); the head-index
+// lookup plus MAX_OPENERS cap keeps it near-linear.
+'use strict';
+
+
+const assert = require('assert');
+const markdownit = require('../');
+
+
+describe('AIKIDO-2026-549894: smartquotes quadratic complexity', () => {
+  const md = markdownit({ typographer: true });
+
+  function assertFast(str, label) {
+    const t0 = Date.now();
+    md.render(str);
+    const elapsed = Date.now() - t0;
+    // A quadratic implementation takes many seconds (often >60s) on this
+    // input; the fixed implementation finishes in well under a second.
+    assert.ok(
+      elapsed < 5000,
+      label + ' took ' + elapsed + 'ms (expected < 5000ms; likely quadratic)'
+    );
+  }
+
+  it('mismatched double-then-single openers/closers stays fast', () => {
+    assertFast('"a '.repeat(100000) + "b' ".repeat(100000), 'double/single');
+  });
+
+  it('mismatched single-then-double openers/closers stays fast', () => {
+    assertFast("'a ".repeat(100000) + 'b" '.repeat(100000), 'single/double');
+  });
+
+  it('still applies smart quotes correctly for normal input', () => {
+    assert.strictEqual(md.render('"Hello," said the fox.'),
+      '<p>“Hello,” said the fox.</p>\n');
+    assert.strictEqual(md.render("it's a 'test'"),
+      '<p>it’s a ‘test’</p>\n');
+  });
+});
