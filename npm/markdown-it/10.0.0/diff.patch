+// Regression test for AIKIDO-2026-549894
+//
+// Quadratic (ReDoS-like) complexity in the smartquotes core rule. When a
+// document contained many quote openers whose type never matched a later
+// closer (e.g. many `"` openers followed by many `'` closers), the closing
+// scan rewound the entire opener stack on every quote, giving O(n^2) behaviour
+// and allowing a small input to hang the parser.
+//
+// Fix: index the topmost opener of each quote type in O(1) and cap the opener
+// stack at MAX_OPENERS (1000). This test guards against the pathological
+// slowdown returning and verifies normal typographic output is unchanged.
+'use strict';
+
+
+var assert     = require('chai').assert;
+var markdownit = require('../');
+
+
+describe('AIKIDO-2026-549894: smartquotes quadratic complexity', function () {
+  this.timeout(20000);
+
+  function timeRender(src) {
+    var md = markdownit({ typographer: true });
+    var t0 = Date.now();
+    md.render(src);
+    return Date.now() - t0;
+  }
+
+  it('handles mismatched opener/closer quote types quickly', function () {
+    // Pathological: N double-quote openers then N single-quote closers.
+    var src = '"a '.repeat(100000) + "b' ".repeat(100000);
+    var ms = timeRender(src);
+    // Pre-fix this was quadratic and took many seconds/minutes; with the fix
+    // it completes in well under a second. Allow generous slack for CI.
+    assert.isBelow(ms, 5000, 'smartquotes took too long: ' + ms + 'ms');
+  });
+
+  it('handles mismatched types in the other direction quickly', function () {
+    var src = "'a ".repeat(100000) + 'b" '.repeat(100000);
+    var ms = timeRender(src);
+    assert.isBelow(ms, 5000, 'smartquotes took too long: ' + ms + 'ms');
+  });
+
+  it('handles a huge run of identical quotes quickly', function () {
+    var ms = timeRender('"'.repeat(160000));
+    assert.isBelow(ms, 5000, 'smartquotes took too long: ' + ms + 'ms');
+  });
+
+  it('still produces correct typographic quotes', function () {
+    var md = markdownit({ typographer: true });
+    assert.strictEqual(md.render('"Hello" world'), '<p>“Hello” world</p>\n');
+    assert.strictEqual(md.render("It's a 'test' here"), '<p>It’s a ‘test’ here</p>\n');
+    assert.strictEqual(
+      md.render('nested "a \'b\' c" and \'d "e" f\''),
+      '<p>nested “a ‘b’ c” and ‘d “e” f’</p>\n'
+    );
+  });
+});
