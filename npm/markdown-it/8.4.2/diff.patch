@@ -0,0 +1,48 @@
+// Regression test for AIKIDO-2026-549894:
+// quadratic (ReDoS-like) complexity in the smartquotes rule when quote
+// types don't match. Ported from upstream
+// test/markdown-it/pathological.test.mjs ("a lot of smartquotes" and
+// "smartquotes with mismatched opener and closer types"), adapted from
+// node:test + worker_threads to the project's mocha/chai harness with a
+// wall-clock budget instead of a worker timeout.
+'use strict';
+
+
+var assert     = require('chai').assert;
+var markdownit = require('../');
+
+
+describe('AIKIDO-2026-549894: smartquotes quadratic complexity', function () {
+  // Generous budget: the vulnerable O(n^2) code takes many seconds on these
+  // inputs, the fixed O(n) code finishes in a few milliseconds.
+  this.timeout(10000);
+
+  function renderWithin(str, opts, budgetMs) {
+    var md = markdownit(opts || { typographer: true });
+    var t0 = Date.now();
+    md.render(str);
+    var elapsed = Date.now() - t0;
+    assert.isBelow(elapsed, budgetMs,
+      'smartquotes took ' + elapsed + 'ms (budget ' + budgetMs + 'ms) — ' +
+      'likely quadratic complexity regression');
+  }
+
+  it('handles a lot of quotes without blowing up', function () {
+    renderWithin(new Array(160000 + 1).join('"'), { typographer: true }, 5000);
+  });
+
+  it('handles mismatched opener and closer types without blowing up', function () {
+    var a = new Array(50000 + 1).join('"a ') + new Array(50000 + 1).join("b' ");
+    renderWithin(a, { typographer: true }, 5000);
+
+    var b = new Array(50000 + 1).join("'a ") + new Array(50000 + 1).join('b" ');
+    renderWithin(b, { typographer: true }, 5000);
+  });
+
+  it('still converts straight quotes to typographic ones', function () {
+    var md = markdownit({ typographer: true });
+    assert.strictEqual(md.renderInline('"Hello"'), '“Hello”');
+    assert.strictEqual(md.renderInline("'Hello'"), '‘Hello’');
+    assert.strictEqual(md.renderInline("it's"), 'it’s');
+  });
+});
