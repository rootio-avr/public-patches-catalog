--- a/plugins/removeScriptElement.js
+++ b/plugins/removeScriptElement.js
@@ -6,6 +6,52 @@ exports.active = false;
 
 exports.description = 'removes <script> elements (disabled by default)';
 
+/**
+ * Namespaces that support executable <script> elements.
+ *
+ * @type {Array<String>}
+ */
+var scriptNamespaces = [
+    'http://www.w3.org/2000/svg',
+    'http://www.w3.org/1999/xhtml'
+];
+
+/**
+ * Determine whether an element is a <script> in an executable namespace,
+ * taking XML namespace prefixes into account.
+ *
+ * A bare <script> uses the default (SVG) namespace, while a prefixed
+ * element such as <svg:script> or <xhtml:script> is executable only when
+ * its prefix is declared (via an xmlns:* attribute on the element or an
+ * ancestor) to be the SVG or XHTML namespace. A prefix bound to any other
+ * namespace (e.g. <filmmaker:script>) is left intact.
+ *
+ * @param {Object} item current iteration item
+ * @return {Boolean}
+ */
+function isScriptElem(item) {
+
+    // Bare <script> (no prefix) is in the default SVG namespace.
+    if (item.isElem('script') && (!item.prefix || item.prefix === 'xmlns')) {
+        return true;
+    }
+
+    // Prefixed element whose local name is "script".
+    if (item.local === 'script' && item.prefix) {
+
+        // Resolve the prefix to a namespace URI by walking up the tree,
+        // looking for the nearest xmlns:<prefix> declaration.
+        for (var elem = item; elem; elem = elem.parentNode) {
+            var attr = elem.attr && elem.attr('xmlns:' + item.prefix);
+            if (attr && attr.value) {
+                return scriptNamespaces.indexOf(attr.value) > -1;
+            }
+        }
+    }
+
+    return false;
+}
+
 /**
  * Remove <script>.
  *
@@ -18,6 +64,6 @@ exports.description = 'removes <script> elements (disabled by default)';
  */
 exports.fn = function(item) {
 
-    return !item.isElem('script');
+    return !isScriptElem(item);
 
