+'use strict';
+
+/**
+ * Regression test for AIKIDO-2026-858273 / CVE-2026-84370 / GHSA-w27v-7q3p-w38r.
+ *
+ * svgo 1.3.0's removeScriptElement plugin only stripped literal <script>
+ * elements and performed no URL-scheme or event-attribute sanitization, so
+ * namespace-prefixed anchors (svg:a) and disguised schemes such as
+ * "java\tscript:" (ASCII tab embedded in the scheme) survived sanitization
+ * and executed as XSS when the "sanitized" SVG was rendered.
+ *
+ * This test drives the plugin's exports.fn directly with jsAPI-style items,
+ * asserting that dangerous input is neutralized while benign input is kept.
+ */
+var plugin = require('../../plugins/removeScriptElement.js');
+
+function attr(name, value) {
+    var idx = name.lastIndexOf(':');
+    return {
+        name: name,
+        value: value,
+        prefix: idx === -1 ? '' : name.slice(0, idx),
+        local: idx === -1 ? name : name.slice(idx + 1)
+    };
+}
+
+function makeElem(name, attrList, parentNode) {
+    var idx = name.lastIndexOf(':');
+    var item = {
+        elem: name,
+        prefix: idx === -1 ? '' : name.slice(0, idx),
+        local: idx === -1 ? name : name.slice(idx + 1),
+        parentNode: parentNode || null
+    };
+    if (attrList) {
+        item.attrs = {};
+        attrList.forEach(function(a) { item.attrs[a.name] = a; });
+    }
+    return item;
+}
+
+describe('plugins/removeScriptElement (AIKIDO-2026-858273 / CVE-2026-84370)', function() {
+
+    it('removes literal <script> elements', function() {
+        plugin.fn(makeElem('script')).should.equal(false);
+    });
+
+    it('removes namespace-prefixed <svg:script> elements', function() {
+        plugin.fn(makeElem('svg:script')).should.equal(false);
+    });
+
+    it('strips disguised "java\\tscript:" href on a namespace-prefixed svg:a anchor', function() {
+        var item = makeElem('svg:a', [attr('href', 'java\tscript:alert(1)')]);
+        plugin.fn(item).should.equal(true);
+        (item.attrs === undefined || item.attrs.href === undefined).should.equal(true);
+    });
+
+    it('strips javascript: xlink:href on an <a> anchor', function() {
+        var item = makeElem('a', [attr('xlink:href', 'javascript:alert(1)')]);
+        plugin.fn(item);
+        (item.attrs === undefined || item.attrs['xlink:href'] === undefined).should.equal(true);
+    });
+
+    it('strips vbscript: and newline/CR disguised schemes on anchors', function() {
+        var item = makeElem('a', [attr('href', 'vb\r\nscript:msgbox(1)')]);
+        plugin.fn(item);
+        (item.attrs === undefined || item.attrs.href === undefined).should.equal(true);
+    });
+
+    it('preserves benign anchor hrefs', function() {
+        var item = makeElem('a', [attr('href', 'https://example.com/page')]);
+        plugin.fn(item).should.equal(true);
+        item.attrs.href.value.should.equal('https://example.com/page');
+    });
+
+    it('strips on* event handler attributes', function() {
+        var item = makeElem('rect', [attr('onload', 'alert(1)'), attr('width', '10')]);
+        plugin.fn(item);
+        (item.attrs.onload === undefined).should.equal(true);
+        item.attrs.width.value.should.equal('10');
+    });
+
+    it('strips executable URL and srcdoc attributes inside foreignObject', function() {
+        var fo = makeElem('foreignObject');
+        var iframe = makeElem('iframe', [
+            attr('src', 'javascript:alert(1)'),
+            attr('srcdoc', '<script>alert(1)</script>')
+        ], fo);
+        plugin.fn(iframe);
+        (iframe.attrs === undefined || iframe.attrs.src === undefined).should.equal(true);
+        (iframe.attrs === undefined || iframe.attrs.srcdoc === undefined).should.equal(true);
+    });
+
+    it('preserves inert data: URLs but rejects active document data: media types', function() {
+        var inert = makeElem('a', [attr('href', 'data:image/png;base64,AAAA')]);
+        plugin.fn(inert);
+        inert.attrs.href.value.should.equal('data:image/png;base64,AAAA');
+
+        var active = makeElem('a', [attr('href', 'data:text/html,<script>alert(1)</script>')]);
+        plugin.fn(active);
+        (active.attrs === undefined || active.attrs.href === undefined).should.equal(true);
+    });
+
+});

