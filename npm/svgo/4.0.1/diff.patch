--- a/test/plugins/removeScripts.06.svg.txt
+++ b/test/plugins/removeScripts.06.svg.txt
@@ -0,0 +1,20 @@
+Removes <script> elements even when script is declared with an explicit
+SVG or XHTML namespace.
+
+===
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xhtml="http://www.w3.org/1999/xhtml" viewBox="0 0 100 100" version="1.1">
+  <script>
+    alert('This alert is from the default namespace.');
+  </script>
+  <svg:script>
+    alert('This alert is from the explicit/prefixed SVG namespace.');
+  </svg:script>
+  <xhtml:script>
+    alert('This alert is from the explicit/prefixed XHTML namespace.');
+  </xhtml:script>
+</svg>
+
+@@@
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xhtml="http://www.w3.org/1999/xhtml" viewBox="0 0 100 100" version="1.1"/>
--- a/test/plugins/removeScripts.07.svg.txt
+++ b/test/plugins/removeScripts.07.svg.txt
@@ -0,0 +1,24 @@
+Does not remove <script> elements even when script is declared with an explicit
+namespace that isn't default SVG, or the explicit SVG or XHTML namespace.
+
+Our custom namespace should be treated separately by clients and is not
+executable.
+
+===
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:filmmaker="http://teaparty.diy" viewBox="0 0 100 100" version="1.1">
+  <script>
+    alert('uwu');
+  </script>
+  <filmmaker:script>
+    This is not executable JavaScript!
+  </filmmaker:script>
+</svg>
+
+@@@
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:filmmaker="http://teaparty.diy" viewBox="0 0 100 100" version="1.1">
+    <filmmaker:script>
+        This is not executable JavaScript!
+    </filmmaker:script>
+</svg>
--- a/test/plugins/removeScripts.08.svg.txt
+++ b/test/plugins/removeScripts.08.svg.txt
@@ -0,0 +1,20 @@
+Removes hrefs to JavaScript URIs, including unconventional namespaces, even when
+the JavaScript URI is written with uppercase characters.
+
+===
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:uwu="http://www.w3.org/1999/xlink" viewBox="0 0 100 100" version="1.1">
+  <a href="JAVASCRIPT:(() => { alert('Default namespace with uppercase URI scheme.') })();">
+    <text y="20">uwu</text>
+  </a>
+  <a uwu:href="JavaScript:(() => { alert('Explicit/prefixed namespace with mixed-case URI scheme.') })();">
+    <text y="30">uwu</text>
+  </a>
+</svg>
+
+@@@
+
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:uwu="http://www.w3.org/1999/xlink" viewBox="0 0 100 100" version="1.1">
+    <text y="20">uwu</text>
+    <text y="30">uwu</text>
+</svg>
