+'use strict'
+// Regression test for CVE-2026-73566 / GHSA-r292-9mhp-454m.
+// filesFilter's mapHas() walks path.dirname() once per segment. tar 6.2.0
+// has a private copy in both lib/list.js (tar.t) and lib/extract.js (tar.x);
+// upstream v7 only had to patch src/list.ts because extract imports it.
+// A member-selection list that does not itself contain the deep path forces
+// the full walk. 12000 segments overflows Node's stack without the cap.
+const t = require('tap')
+const zlib = require('zlib')
+const list = require('../lib/list.js')
+const extract = require('../lib/extract.js')
+const Header = require('../lib/header.js')
+
+const deep = new Array(12000).fill('a').join('/') + '/file.txt'
+
+const gnuLongPathTar = entryPath => {
+  const body = Buffer.from(entryPath + '\0')
+  const longHeader = Buffer.alloc(512)
+  new Header({
+    path: '././@LongLink',
+    mode: 0o644,
+    size: body.length,
+    type: 'NextFileHasLongPath',
+    mtime: new Date(0),
+  }).encode(longHeader)
+  const fileHeader = Buffer.alloc(512)
+  new Header({
+    path: 'x',
+    mode: 0o644,
+    size: 0,
+    type: 'File',
+    mtime: new Date(0),
+  }).encode(fileHeader)
+  const bodyBuf = Buffer.alloc(512 * Math.ceil(body.length / 512))
+  body.copy(bodyBuf)
+  return Buffer.concat([longHeader, bodyBuf, fileHeader, Buffer.alloc(1024)])
+}
+
+t.test('mapHas is bounded for list and extract', t => {
+  t.doesNotThrow(() => {
+    t.equal(list(['wanted.txt']).filter(deep, {}), false)
+  }, 'list filter does not overflow')
+  t.doesNotThrow(() => {
+    t.equal(extract(['wanted.txt']).filter(deep, {}), false)
+  }, 'extract filter does not overflow')
+  t.equal(list(['wanted.txt']).filter('wanted.txt', {}), true)
+  t.equal(extract(['dir']).filter('dir/a/b/file.txt', {}), true)
+  t.end()
+})
+
+t.test('parsing a GNU long path with member selection does not overflow', t => {
+  const data = gnuLongPathTar(deep)
+  const seen = []
+  t.doesNotThrow(() => {
+    list({
+      filter (file) {
+        seen.push(file)
+        return true
+      },
+    }, ['wanted.txt']).end(data)
+  }, 'list parse does not throw')
+  t.ok(seen.includes(deep), 'the long path reached the list filter')
+
+  const seenX = []
+  t.doesNotThrow(() => {
+    extract({
+      cwd: t.testdir(),
+      filter (file) {
+        seenX.push(file)
+        return true
+      },
+    }, ['wanted.txt']).end(data)
+  }, 'extract parse does not throw')
+  t.ok(seenX.includes(deep), 'the long path reached the extract filter')
+  t.end()
+})

