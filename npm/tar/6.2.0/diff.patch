@@ -0,0 +1,77 @@
+'use strict'
+// Regression test for CVE-2026-59873:
+// explosive (zip-bomb) decompression of gzip/brotli tar archives.
+// The Parser must abort once the ratio of decompressed to compressed
+// bytes exceeds maxDecompressionRatio (default 1000).
+const t = require('tap')
+const zlib = require('zlib')
+const Parse = require('../lib/parse.js')
+const Header = require('../lib/header.js')
+
+const makeFileTar = (name, payload) => {
+  const header = Buffer.alloc(512)
+  new Header({
+    path: name,
+    mode: 0o644,
+    size: payload.length,
+    type: 'File',
+    mtime: new Date(0),
+  }).encode(header)
+  const padLen = (512 - (payload.length % 512)) % 512
+  return Buffer.concat([header, payload, Buffer.alloc(padLen), Buffer.alloc(1024)])
+}
+
+const makeCompressedBomb = () => {
+  const payload = Buffer.alloc(8 * 1024 * 1024)
+  return zlib.gzipSync(makeFileTar('bomb', payload))
+}
+
+t.test('max decompression ratio', t => {
+  const bomb = makeCompressedBomb()
+
+  t.test('parsing aborts by default', t => {
+    const p = new Parse({})
+    t.throws(
+      () => p.end(bomb),
+      {
+        tarCode: 'TAR_ABORT',
+        recoverable: false,
+        message: /max decompression ratio exceeded/,
+      },
+      'parsing aborts on a compressed bomb',
+    )
+    // aborting again is a no-op (does not throw a second time)
+    p.abort(new Error('hello'))
+    t.end()
+  })
+
+  t.test('aborting only happens one time', t => {
+    const p = new Parse({})
+    t.throws(() => p.abort(new Error('hello')), {
+      message: 'hello',
+      tarCode: 'TAR_ABORT',
+      recoverable: false,
+    })
+    // this is ignored, no second throw
+    p.end(bomb)
+    t.end()
+  })
+
+  t.test('parsing can disable the limit explicitly', t => {
+    let bytesRead = 0
+    const p = new Parse({
+      maxDecompressionRatio: Infinity,
+      onentry (e) {
+        e.on('data', c => (bytesRead += c.length))
+        e.resume()
+      },
+    })
+    p.on('end', () => {
+      t.equal(bytesRead, 8 * 1024 * 1024)
+      t.end()
+    })
+    p.end(bomb)
+  })
+
+  t.end()
+})
