+'use strict'
+
+// Regression test for CVE-2026-24842 / GHSA-8qq5-rm4j-mr97:
+// hardlink entries whose linkpath contains '..' could escape the
+// extraction directory and clobber files outside of cwd. The Unpack
+// CHECKPATH logic must reject such hardlinks (type 'Link').
+//
+// In this target (tar@6.1.13) the guard is provided by the sibling
+// linkpath-sanitization fix; this test asserts the exploit vector
+// stays closed regardless of which fix supplies the guard.
+
+const t = require('tap')
+const fs = require('fs')
+const path = require('path')
+const Unpack = require('../lib/unpack.js')
+const makeTar = require('./make-tar.js')
+
+// Build a tar containing a directory and a hardlink inside it whose
+// target uses '..' to point at a file outside the extraction root.
+const getExploitTar = () => makeTar([
+  {
+    path: 'sub/',
+    type: 'Directory',
+    size: 0,
+  },
+  {
+    path: 'sub/exploit_sub',
+    type: 'Link',
+    size: 0,
+    linkpath: '../secret.txt',
+  },
+  '',
+  '',
+])
+
+t.test('hardlink with .. in linkpath is rejected', t => {
+  const dir = t.testdir({
+    'secret.txt': 'ORIGINAL DATA',
+    out: {},
+  })
+  const out = path.resolve(dir, 'out')
+  const secret = path.resolve(dir, 'secret.txt')
+
+  const warnings = []
+  const u = new Unpack({
+    cwd: out,
+    onwarn: (code, msg) => warnings.push({ code, msg }),
+  })
+
+  u.on('end', () => {
+    // the escaping hardlink must not have been created
+    t.throws(
+      () => fs.lstatSync(path.resolve(out, 'sub/exploit_sub')),
+      { code: 'ENOENT' },
+      'escaping hardlink is not extracted'
+    )
+
+    // and the file outside cwd must be untouched
+    t.equal(
+      fs.readFileSync(secret, 'utf8'),
+      'ORIGINAL DATA',
+      'file outside cwd is not clobbered'
+    )
+
+    t.ok(
+      warnings.some(w => /linkpath (contains '\.\.'|escapes)/.test(w.msg)),
+      'warns that linkpath contains ..'
+    )
+    t.end()
+  })
+
+  u.end(getExploitTar())
+})
+
+t.test('hardlink with safe linkpath is allowed', t => {
+  const dir = t.testdir({ out: {} })
+  const out = path.resolve(dir, 'out')
+
+  const u = new Unpack({ cwd: out })
+  u.on('end', () => {
+    t.equal(
+      fs.readFileSync(path.resolve(out, 'link'), 'utf8'),
+      'hello',
+      'safe hardlink is extracted normally'
+    )
+    t.end()
+  })
+
+  u.end(makeTar([
+    {
+      path: 'target.txt',
+      type: 'File',
+      size: 5,
+    },
+    'hello',
+    {
+      path: 'link',
+      type: 'Link',
+      size: 0,
+      linkpath: 'target.txt',
+    },
+    '',
+    '',
+  ]))
+})

