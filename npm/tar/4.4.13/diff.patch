+'use strict'
+// Regression test for CVE-2026-31802 (GHSA-9ppj-qmqm-q256):
+// symlink/hardlink linkpaths must not escape the extraction directory,
+// including drive-relative paths such as c:..\..\foo
+const t = require('tap')
+const fs = require('fs')
+const path = require('path')
+const rimraf = require('rimraf')
+const Header = require('../lib/header.js')
+const Unpack = require('../lib/unpack.js')
+
+const dir = path.resolve(__dirname, 'cve-2026-31802')
+const out = path.resolve(dir, 'out')
+
+t.teardown(_ => rimraf.sync(dir))
+t.beforeEach(cb => {
+  rimraf.sync(dir)
+  fs.mkdirSync(dir)
+  fs.mkdirSync(out)
+  cb()
+})
+
+const entry = (p, type, linkpath) => {
+  const buf = Buffer.alloc(512)
+  new Header({ path: p, type: type, linkpath: linkpath, size: 0 }).encode(buf, 0)
+  return buf
+}
+
+const extract = (entries, sync, cb) => {
+  const warnings = []
+  const u = sync ? new Unpack.Sync({ cwd: out }) : new Unpack({ cwd: out })
+  u.on('warn', (msg, data) => warnings.push(msg))
+  u.on('close', _ => cb(warnings))
+  u.end(Buffer.concat(entries.concat([Buffer.alloc(1024)])))
+}
+
+const exists = p => {
+  try {
+    fs.lstatSync(path.resolve(out, p))
+    return true
+  } catch (er) {
+    return false
+  }
+}
+
+;[true, false].forEach(sync => {
+  t.test('linkpath containment, sync=' + sync, t => {
+    extract([
+      entry('a/escape', 'SymbolicLink', '../../outside'),
+      entry('a/driveescape', 'SymbolicLink', 'c:..\\..\\..\\..\\foo\\bar'),
+      entry('a/rootescape', 'SymbolicLink', '/../../../foo'),
+      entry('a/hardescape', 'Link', '../../outside'),
