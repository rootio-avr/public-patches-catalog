--- /dev/null
+++ b/test/cve-2026-24842.test.js
@@ -0,0 +1,49 @@
+'use strict'
+// CVE-2026-24842: hard link entries whose linkpath contains '..' must be
+// rejected, since hard links are resolved relative to the extraction cwd.
+const t = require('tap')
+const fs = require('fs')
+const path = require('path')
+const Header = require('../lib/header.js')
+const Unpack = require('../lib/unpack.js')
+
+const dir = path.resolve(__dirname, 'cve-2026-24842')
+const out = path.join(dir, 'out')
+
+t.teardown(() => require('rimraf').sync(dir))
+
+const secret = path.join(dir, 'secret.txt')
+require('mkdirp').sync(out)
+fs.writeFileSync(secret, 'ORIGINAL DATA')
+
+const chunks = []
+const add = (props) => {
+  const buf = Buffer.alloc(512)
+  new Header(props).encode(buf, 0)
+  chunks.push(buf)
+}
+add({ path: 'exploit_hard', type: 'Link', size: 0, linkpath: '../secret.txt' })
+add({ path: 'sub/', type: 'Directory', size: 0 })
+add({ path: 'sub/exploit_sub', type: 'Link', size: 0, linkpath: '../secret.txt' })
+add({ path: 'ok.txt', type: 'File', size: 2 })
+const body = Buffer.alloc(512)
+body.write('ok')
+chunks.push(body)
+chunks.push(Buffer.alloc(1024))
+const tarball = Buffer.concat(chunks)
+
+t.test('hardlinks containing .. are rejected', t => {
+  const warnings = []
+  const u = new Unpack({ cwd: out })
+  u.on('warn', (m, d) => warnings.push(m))
+  u.on('close', () => {
+    t.notOk(fs.existsSync(path.join(out, 'exploit_hard')), 'no top-level hardlink')
+    t.notOk(fs.existsSync(path.join(out, 'sub/exploit_sub')), 'no nested hardlink')
+    t.equal(fs.readFileSync(path.join(out, 'ok.txt'), 'utf8').slice(0, 2), 'ok',
+      'normal entries still extracted')
+    t.equal(warnings.filter(w => /linkpath contains/.test(w)).length, 2)
+    t.equal(fs.readFileSync(secret, 'utf8'), 'ORIGINAL DATA')
+    t.end()
+  })
+  u.end(tarball)
+})

