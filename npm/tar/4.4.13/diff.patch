diff --git a/test/cve-2026-29786.test.js b/test/cve-2026-29786.test.js
new file mode 100644
index 0000000..ca7285e
--- /dev/null
+++ b/test/cve-2026-29786.test.js
@@ -0,0 +1,56 @@
+'use strict'
+// CVE-2026-29786 / GHSA-qffp-2rhf-9h96
+// a drive-relative path like 'c:..\foo\bar' must have its root parsed off
+// *before* checking for '..' portions, otherwise it is stripped to
+// '..\foo\bar' after the check and can escape the extraction target.
+const t = require('tap')
+const fs = require('fs')
+const path = require('path')
+const Header = require('../lib/header.js')
+const Unpack = require('../lib/unpack.js')
+
+const dir = path.resolve(__dirname, 'fixtures', 'cve-2026-29786')
+const out = path.resolve(dir, 'out')
+
+t.teardown(() => require('rimraf').sync(dir))
+
+const entry = (p, type) => {
+  const buf = Buffer.alloc(512)
+  new Header({ path: p, type: type || 'File', size: 0 }).encode(buf, 0)
+  return buf
+}
+
+t.test('drive-relative path with .. is rejected', t => {
+  require('mkdirp').sync(out)
+  const warnings = []
+  const u = new Unpack({ cwd: out })
+  u.on('warn', (msg, data) => warnings.push([msg, data]))
+  u.on('close', () => {
+    t.ok(warnings.some(w => /path contains '\.\.'/.test(w[0])),
+      'warned about ..')
+    t.equal(fs.readdirSync(out).length, 0, 'nothing extracted')
+    t.end()
+  })
+  u.end(Buffer.concat([
+    entry('c:..\\foo\\bar'),
+    entry('c:../foo/bar'),
+    Buffer.alloc(1024),
+  ]))
+})
+
+t.test('drive-relative path without .. has root stripped', t => {
+  require('mkdirp').sync(out)
+  const warnings = []
+  const u = new Unpack({ cwd: out })
+  u.on('warn', (msg, data) => warnings.push([msg, data]))
+  u.on('close', () => {
+    t.ok(warnings.some(w => /stripping c: from absolute path/.test(w[0])),
+      'warned about stripping root')
+    t.ok(fs.existsSync(path.resolve(out, 'foo', 'bar')), 'extracted safely')
+    t.end()
+  })
+  u.end(Buffer.concat([
+    entry('c:foo/bar'),
+    Buffer.alloc(1024),
+  ]))
+})

