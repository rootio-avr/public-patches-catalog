+'use strict'
+
+const t = require('tap')
+const fs = require('fs')
+const path = require('path')
+const Header = require('../lib/header.js')
+const x = require('../lib/extract.js')
+
+const targetSym = '/some/absolute/path'
+
+const getExploitTar = secret => {
+  const exploitTar = Buffer.alloc(512 + 512 + 1024)
+
+  new Header({
+    path: 'exploit_hard',
+    type: 'Link',
+    size: 0,
+    linkpath: secret,
+  }).encode(exploitTar, 0)
+
+  new Header({
+    path: 'exploit_sym',
+    type: 'SymbolicLink',
+    size: 0,
+    linkpath: targetSym,
+  }).encode(exploitTar, 512)
+
+  return exploitTar
+}
+
+const dir = path.resolve(__dirname, 'ghsa-8qq5-rm4j-mr97')
+const out = path.resolve(dir, 'out_repro')
+const secret = path.resolve(dir, 'secret.txt')
+const tarFile = path.resolve(dir, 'exploit.tar')
+
+t.teardown(() => require('rimraf').sync(dir))
+t.test('setup', t => {
+  require('rimraf').sync(dir)
+  fs.mkdirSync(out, { recursive: true })
+  fs.writeFileSync(secret, 'ORIGINAL DATA')
+  fs.writeFileSync(tarFile, getExploitTar(secret))
+  t.end()
+})
+
+t.test('verify that linkpaths get sanitized properly', t => {
+  x({ cwd: out, file: tarFile, preservePaths: false }, er => {
+    if (er)
+      return t.threw(er)
+    try {
+      fs.writeFileSync(path.resolve(out, 'exploit_hard'), 'OVERWRITTEN')
+    } catch (_) {
+      // hardlink target may not exist inside cwd, which is fine
+    }
+    t.equal(fs.readFileSync(secret, 'utf8'), 'ORIGINAL DATA')
+    t.not(fs.readlinkSync(path.resolve(out, 'exploit_sym')), targetSym)
+    t.end()
+  })
+})

