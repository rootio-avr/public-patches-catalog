diff --git a/test/cve-2026-59873.js b/test/cve-2026-59873.js
new file mode 100644
index 0000000..5f3797e
--- /dev/null
+++ b/test/cve-2026-59873.js
@@ -0,0 +1,63 @@
+'use strict'
+// Regression test for CVE-2026-59873: decompression-bomb DoS in node-tar.
+// A tiny gzip payload can inflate to an enormous tar stream. The parser now
+// tracks the ratio of decompressed to compressed bytes and aborts once it
+// exceeds maxDecompressionRatio (default 1000; Infinity disables the guard).
+const t = require('tap')
+const Parse = require('../lib/parse.js')
+const makeTar = require('./make-tar.js')
+const zlib = require('zlib')
+
+const makeCompressedBomb = () => {
+  const payload = Buffer.alloc(8 * 1024 * 1024)
+  return zlib.gzipSync(makeTar([
+    { path: 'bomb', size: payload.length, type: 'File' },
+    payload,
+    '',
+    '',
+  ]))
+}
+const bomb = makeCompressedBomb()
+
+t.test('parsing aborts by default', t => {
+  const p = new Parse({})
+  t.throws(
+    () => p.end(bomb),
+    {
+      tarCode: 'TAR_ABORT',
+      recoverable: false,
+      message: /max decompression ratio exceeded/,
+    },
+    'parsing aborts on decompression bomb'
+  )
+  // abort is idempotent: a second abort is a no-op and does not throw again
+  p.abort(new Error('hello'))
+  t.end()
+})
+
+t.test('aborting only happens one time', t => {
+  const p = new Parse({})
+  t.throws(() => p.abort(new Error('hello')), {
+    message: 'hello',
+    tarCode: 'TAR_ABORT',
+    recoverable: false,
+  })
+  // already aborted, so this bomb is ignored (no throw)
+  p.end(bomb)
+  t.end()
+})
+
+t.test('parsing can disable the limit explicitly', t => {
+  let bytesRead = 0
+  const p = new Parse({
+    maxDecompressionRatio: Infinity,
+    onentry (e) {
+      e.on('data', c => (bytesRead += c.byteLength))
+    },
+  })
+  p.on('end', () => {
+    t.equal(bytesRead, 8 * 1024 * 1024)
+    t.end()
+  })
+  p.end(bomb)
+})

