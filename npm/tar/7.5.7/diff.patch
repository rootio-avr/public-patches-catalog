+++ b/test/cve-2026-73566.test.js
@@ -0,0 +1,47 @@
+import t from 'tap'
+import { filesFilter } from '../dist/esm/list.js'
+
+// Regression test for CVE-2026-73566 / GHSA-r292-9mhp-454m
+//
+// A crafted archive whose entry carries a GNU 'L' (or PAX 'x') long-path
+// header with tens of thousands of slash-separated segments made the
+// recursive mapHas() helper in filesFilter walk the path upward via
+// path.dirname() once per segment, with no depth cap. That overflowed the
+// JS call stack and threw an uncatchable RangeError, crashing the process.
+//
+// The fix caps recursion at MAX = 100 levels. Exercising filesFilter with a
+// pathological long path must therefore complete without throwing.
+
+t.test('deep long-path does not overflow the stack', t => {
+  // ~12,000 'a/' segments, mirroring the advisory's crafted long-path header.
+  const deep = 'a/'.repeat(12000) + 'file'
+  const opt = {}
+
+  // Build the file-selection filter over a member list.
+  filesFilter(opt, ['some-member'])
+  t.type(opt.filter, 'function', 'filesFilter installs a filter')
+
+  // Before the fix this recursed once per path segment and threw a
+  // RangeError (Maximum call stack size exceeded).
+  let result
+  t.doesNotThrow(() => {
+    result = opt.filter(deep, {})
+  }, 'filtering a pathological long path does not overflow the stack')
+
+  // The crafted path is not one of the selected members, so it is excluded.
+  t.equal(result, false, 'unrelated deep path is filtered out')
+
+  t.end()
+})
+
+t.test('normal member selection still works', t => {
+  const opt = {}
+  filesFilter(opt, ['a/b/c'])
+
+  // The selected member and its descendants are included; unrelated files are not.
+  t.equal(opt.filter('a/b/c', {}), true, 'selected member is included')
+  t.equal(opt.filter('a/b/c/d', {}), true, 'child of selected member is included')
+  t.equal(opt.filter('x/y/z', {}), false, 'unrelated file is excluded')
+
+  t.end()
+})

