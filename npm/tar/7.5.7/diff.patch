+// Regression test for CVE-2026-59873
+// gzip-bomb (decompression bomb) DoS during archive parsing/extraction.
+// The Parser must abort with TAR_ABORT when the decompressed:compressed byte
+// ratio exceeds maxDecompressionRatio (default 1000), and must allow the limit
+// to be disabled explicitly via `maxDecompressionRatio: Infinity`.
+//
+// Grounded on the upstream test added in fix commit
+// 2812e9338665659b183aa7226518c307044957d3 (test/parse.js
+// "max decompression ratio"). Uses the compiled dist Parser that ships in the
+// published npm tarball.
+const t = require('tap')
+const zlib = require('zlib')
+const { Parser } = require('../dist/commonjs/parse.js')
+
+// Build a minimal tar archive from a list of blocks (headers/bodies), matching
+// the upstream makeTar helper closely enough to produce a highly compressible
+// (all-zero) payload that decompresses far beyond the 1000x default ratio.
+const makeTarHeader = (path, size) => {
+  const block = Buffer.alloc(512)
+  block.write(path, 0, 'utf8')
+  // mode, uid, gid
+  block.write('0000755\0', 100, 'utf8')
+  block.write('0000000\0', 108, 'utf8')
+  block.write('0000000\0', 116, 'utf8')
+  // size (octal, 11 digits + space)
+  block.write(size.toString(8).padStart(11, '0') + ' ', 124, 'utf8')
+  // mtime
+  block.write('00000000000 ', 136, 'utf8')
+  // typeflag '0' = file
+  block.write('0', 156, 'utf8')
+  // ustar magic
+  block.write('ustar\0', 257, 'utf8')
+  block.write('00', 263, 'utf8')
+  // checksum: fill with spaces, sum, then write octal
+  for (let i = 148; i < 156; i++) block[i] = 0x20
+  let sum = 0
+  for (let i = 0; i < 512; i++) sum += block[i]
+  block.write(sum.toString(8).padStart(6, '0') + '\0 ', 148, 'utf8')
+  return block
+}
+
+const makeCompressedBomb = () => {
+  const payloadSize = 8 * 1024 * 1024
+  const payload = Buffer.alloc(payloadSize) // all zeros -> compresses tiny
+  const header = makeTarHeader('bomb', payloadSize)
+  // trailing null blocks to end the archive
+  const end = Buffer.alloc(1024)
+  const tar = Buffer.concat([header, payload, end])
+  return zlib.gzipSync(tar)
+}
+
+const bomb = makeCompressedBomb()
+
+t.test('parsing aborts by default when ratio exceeded', t => {
+  const p = new Parser({})
+  t.throws(
+    () => p.end(bomb),
+    {
+      tarCode: 'TAR_ABORT',
+      recoverable: false,
+      message: /max decompression ratio exceeded/,
+    },
+    'parsing aborts on decompression bomb',
+  )
+  // aborting again is a no-op (does not throw a second time here)
+  p.abort(new Error('hello'))
+  t.end()
+})
+
+t.test('aborting only happens one time', t => {
+  const p = new Parser({})
+  t.throws(() => p.abort(new Error('hello')), {
+    message: 'hello',
+    tarCode: 'TAR_ABORT',
+    recoverable: false,
+  })
+  // this is ignored because already aborted
+  p.end(bomb)
+  t.end()
+})
+
+t.test('parsing can disable the limit explicitly', async t => {
+  let bytesRead = 0
+  await new Promise(res =>
+    new Parser({
+      maxDecompressionRatio: Infinity,
+      onReadEntry(e) {
+        e.on('data', c => (bytesRead += c.byteLength))
+      },
+    })
+      .on('end', res)
+      .end(bomb)
+      .resume(),
+  )
+  t.equal(bytesRead, 8 * 1024 * 1024)
+  t.end()
+})
