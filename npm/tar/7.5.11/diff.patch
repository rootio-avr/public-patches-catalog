+// Regression test for CVE-2026-59874 / GHSA-8x88-c5mf-7j5w
+import t from 'tap'
+import { Header } from '../dist/esm/header.js'
+import { Pax } from '../dist/esm/pax.js'
+
+t.test('Header refuses a negative size', t => {
+  t.equal(new Header({ size: -1000 }).size, undefined)
+  t.end()
+})
+
+t.test('Pax drops a negative size but keeps a valid one', t => {
+  t.equal(Pax.parse('14 size=-1000\n').size, undefined)
+  t.equal(Pax.parse('13 size=1000\n').size, 1000)
+  t.end()
+})

