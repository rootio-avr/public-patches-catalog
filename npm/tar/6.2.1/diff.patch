+  // backport of https://github.com/isaacs/node-tar/commit/631ae59121bf8fc8a22bbae35f074cb9b789cd4a
+  const MAX = 100
+  const mapHas = (file, r, depth = 0) => {
+    if (depth >= MAX) {
+      map.set(file, false)
+      return false
+    }
     const root = r || path.parse(file).root || '.'
     const ret = file === root ? false
       : map.has(file) ? map.get(file)
-      : mapHas(path.dirname(file), root)
+      : mapHas(path.dirname(file), root, depth + 1)
 
     map.set(file, ret)
     return ret
