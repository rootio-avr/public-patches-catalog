@@ -0,0 +1,76 @@
+// Regression test for CVE-2026-59873 / GHSA-23hp-3jrh-7fpw
+// Parser must abort when decompressed:compressed ratio exceeds maxDecompressionRatio.
+import t from 'tap'
+import zlib from 'node:zlib'
+import { Parser } from '../dist/esm/parse.js'
+import { Header } from '../dist/esm/header.js'
+
+const makeTar = (blocks) => {
+  const bufs = []
+  for (const block of blocks) {
+    if (typeof block === 'string' || Buffer.isBuffer(block)) {
+      const b = Buffer.isBuffer(block) ? block : Buffer.from(block)
+      const pad = 512 - (b.length % 512 || 512)
+      bufs.push(Buffer.concat([b, Buffer.alloc(pad)]))
+    } else {
+      const h = new Header(block)
+      const buf = Buffer.alloc(512)
+      h.encode(buf)
+      bufs.push(buf)
+    }
+  }
+  return Buffer.concat(bufs)
+}
+
+const makeCompressedBomb = () => {
+  const payload = Buffer.alloc(8 * 1024 * 1024)
+  return zlib.gzipSync(makeTar([
+    { path: 'bomb', size: payload.length, type: 'File' },
+    payload,
+    '',
+    '',
+  ]))
+}
+
+t.test('max decompression ratio (CVE-2026-59873)', t => {
+  const bomb = makeCompressedBomb()
+
+  t.test('parsing aborts by default', t => {
+    const p = new Parser({})
+    t.throws(() => p.end(bomb), {
+      tarCode: 'TAR_ABORT',
+      recoverable: false,
+      message: /max decompression ratio exceeded/,
+    })
+    p.abort(new Error('hello'))
+    t.end()
+  })
+
+  t.test('aborting only happens one time', t => {
+    const p = new Parser({})
+    t.throws(() => p.abort(new Error('hello')), {
+      message: 'hello',
+      tarCode: 'TAR_ABORT',
+      recoverable: false,
+    })
+    p.end(bomb)
+    t.end()
+  })
+
+  t.test('parsing can disable the limit explicitly', t => {
+    let bytesRead = 0
+    const p = new Parser({
+      maxDecompressionRatio: Infinity,
+      onReadEntry (e) {
+        e.on('data', c => { bytesRead += c.length })
+      },
+    })
+    p.on('end', () => {
+      t.equal(bytesRead, 8 * 1024 * 1024)
+      t.end()
+    })
+    p.end(bomb)
+  })
+
+  t.end()
+})

