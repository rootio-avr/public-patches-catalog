--- /dev/null
+++ b/test/cve-2026-59871.test.js
@@ -0,0 +1,25 @@
+// Regression test for CVE-2026-59871 / GHSA-w8wr-v893-vjvp
+// All-digit PAX path/linkpath values must stay strings, not JS numbers.
+import t from 'tap'
+import { Pax } from '../dist/esm/pax.js'
+import { normalizeWindowsPath } from '../dist/esm/normalize-windows-path.js'
+
+t.test('string PAX fields stay strings (CVE-2026-59871)', t => {
+  const parsed = Pax.parse(
+    '14 path=12345\n18 linkpath=54321\n13 WAT=12345\n15 ctime=12345\n',
+    null,
+    false,
+  )
+  t.equal(parsed.path, '12345')
+  t.equal(parsed.linkpath, '54321')
+  t.equal(typeof parsed.path, 'string')
+  t.equal(typeof parsed.linkpath, 'string')
+  t.equal(+parsed.ctime, +new Date('1970-01-01T03:25:45.000Z'))
+  t.equal(parsed.WAT, undefined)
+  t.end()
+})
+
+t.test('normalizeWindowsPath coerces numeric paths to strings', t => {
+  t.equal(normalizeWindowsPath(12345), '12345')
+  t.end()
+})

