@@ -0,0 +1,34 @@
+'use strict';
+
+const assert = require('assert');
+const CachePolicy = require('..');
+
+const req = (headers = {}) => ({ url: '/', method: 'GET', headers: { host: 'example.com', ...headers } });
+
+describe('CVE-2026-93748: max-stale must not override reuse restrictions', function() {
+    const cases = {
+        'no-cache': { 'cache-control': 'no-cache, max-age=100' },
+        'no-store': { 'cache-control': 'no-store, max-age=100' },
+        'private (shared cache)': { 'cache-control': 'private, max-age=100' },
+        'shared with set-cookie': { 'cache-control': 'max-age=100', 'set-cookie': 'a=b' },
+        'proxy-revalidate': { 'cache-control': 'public, proxy-revalidate, max-age=100' },
+    };
+
+    for (const name of Object.keys(cases)) {
+        it(`${name}: max-stale does not serve from cache`, function() {
+            const policy = new CachePolicy(req(), { status: 200, headers: cases[name] }, { shared: true });
+            const result = policy.evaluateRequest(req({ 'cache-control': 'max-stale' }));
+            assert(!result.response, 'must not be served from cache');
+            assert(result.revalidation, 'must be revalidated or refetched');
+
+            const result2 = policy.evaluateRequest(req({ 'cache-control': 'max-stale=999999' }));
+            assert(!result2.response, 'must not be served from cache');
+        });
+    }
+
+    it('max-stale still works for ordinarily expired responses', function() {
+        const policy = new CachePolicy(req(), { status: 200, headers: { 'cache-control': 'max-age=0' } });
+        const result = policy.evaluateRequest(req({ 'cache-control': 'max-stale' }));
+        assert(result.response, 'expired-but-storable response may be served with max-stale');
+    });
+});
