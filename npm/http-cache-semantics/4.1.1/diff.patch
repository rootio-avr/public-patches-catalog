+'use strict';
+
+const assert = require('assert');
+const CachePolicy = require('..');
+
+describe('CVE-2026-93748: max-stale must not override revalidation requirements', function() {
+    const req = { url: '/', headers: { host: 'example.com' } };
+    const staleReq = {
+        url: '/',
+        headers: { host: 'example.com', 'cache-control': 'max-stale' },
+    };
+
+    function policy(resHeaders, opts) {
+        return new CachePolicy(
+            req,
+            { status: 200, headers: resHeaders },
+            opts
+        );
+    }
+
+    it('shared cache: proxy-revalidate ignores max-stale', function() {
+        const p = policy({ 'cache-control': 'max-age=0, proxy-revalidate' });
+        assert.strictEqual(p.satisfiesWithoutRevalidation(staleReq), false);
+    });
+
+    it('shared cache: Set-Cookie without public ignores max-stale', function() {
+        const p = policy({
+            'cache-control': 'max-age=0',
+            'set-cookie': 'a=b',
+        });
+        assert.strictEqual(p.satisfiesWithoutRevalidation(staleReq), false);
+        const numeric = {
+            url: '/',
+            headers: { host: 'example.com', 'cache-control': 'max-stale=1000' },
+        };
+        assert.strictEqual(p.satisfiesWithoutRevalidation(numeric), false);
+    });
+
+    it('response no-cache ignores max-stale', function() {
+        const p = policy({ 'cache-control': 'no-cache' });
+        assert.strictEqual(p.satisfiesWithoutRevalidation(staleReq), false);
+    });
+
+    it('private cache: proxy-revalidate does not block max-stale', function() {
+        const p = policy(
+            { 'cache-control': 'max-age=0, proxy-revalidate' },
+            { shared: false }
+        );
+        assert.strictEqual(p.satisfiesWithoutRevalidation(staleReq), true);
+    });
+
+    it('shared cache: ordinarily stale response still honours max-stale', function() {
+        const p = policy({
+            'cache-control': 'max-age=0',
+            date: new Date().toUTCString(),
+        });
+        assert.strictEqual(p.satisfiesWithoutRevalidation(staleReq), true);
+    });
+
+    it('shared cache: public Set-Cookie response still honours max-stale', function() {
+        const p = policy({
+            'cache-control': 'public, max-age=0',
+            'set-cookie': 'a=b',
+        });
+        assert.strictEqual(p.satisfiesWithoutRevalidation(staleReq), true);
+    });
+});
