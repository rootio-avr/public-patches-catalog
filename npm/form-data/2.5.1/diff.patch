--- /dev/null
+++ b/test/integration/test-boundary-prediction.js
@@ -0,0 +1,43 @@
+var common = require('../common');
+var assert = common.assert;
+
+var FormData = require(common.dir.lib + '/form_data');
+
+/*
+ * Regression test for CVE-2025-7783.
+ *
+ * Boundary values used to be generated with `Math.random()`, which is not a
+ * cryptographically secure PRNG and whose output can be predicted by an
+ * attacker who observes a handful of prior `Math.random()` values. A predicted
+ * boundary lets an attacker inject additional multipart parts (parameter
+ * pollution). The fix switches boundary generation to `crypto.randomBytes`.
+ *
+ * The old, vulnerable implementation was:
+ *   for (var i = 0; i < 24; i++) {
+ *     boundary += Math.floor(Math.random() * 10).toString(16);
+ *   }
+ * which can ONLY ever emit the decimal digits 0-9 in the random segment.
+ * The crypto-based implementation emits full hex (0-9a-f). We assert that the
+ * random segment is drawn from the full hex alphabet, which the vulnerable
+ * Math.random() code could never satisfy.
+ */
+(function testBoundaryUsesFullHexAlphabet() {
+  var seenHexLetters = false;
+
+  for (var attempt = 0; attempt < 50; attempt++) {
+    var boundary = new FormData().getBoundary();
+    assert.strictEqual(boundary.length, 50);
+
+    // strip the fixed 26-dash prefix, leaving the 24-char random segment
+    var randomSegment = boundary.slice(26);
+    assert.strictEqual(randomSegment.length, 24);
+    assert.ok(/^[0-9a-f]{24}$/.test(randomSegment), 'random segment must be hex');
+
+    if (/[a-f]/.test(randomSegment)) {
+      seenHexLetters = true;
+    }
+  }
+
+  // Across 50 boundaries (1200 hex chars) the probability of never seeing an
+  // a-f nibble from a CSPRNG is negligible; the vulnerable code never can.
+  assert.ok(seenHexLetters, 'boundary must use crypto random (full hex), not Math.random digits');
+})();
+
+(function testUniqueBoundaryPerForm() {
+  assert.notEqual(new FormData().getBoundary(), new FormData().getBoundary());
+})();

