+++ b/test/braces.maxdepth.js
@@ -0,0 +1,69 @@
+'use strict';
+
+require('mocha');
+var assert = require('assert');
+var braces = require('..');
+
+function nest(n) {
+  var str = 'x';
+  for (var i = 0; i < n; i++) {
+    str = '{a,' + str + '}';
+  }
+  return str;
+}
+
+describe('max nesting depth (CVE-2026-93687)', function() {
+  it('should not overflow the stack on deeply nested braces', function() {
+    [true, false].forEach(function(expand) {
+      assert.throws(function() {
+        braces(nest(4000), {expand: expand, cache: false, maxLength: 1000000});
+      }, function(err) {
+        return err instanceof SyntaxError && /exceeds max depth/.test(err.message);
+      });
+    });
+  });
+
+  it('should throw a SyntaxError from .expand and .makeRe', function() {
+    assert.throws(function() {
+      braces.expand(nest(4000), {maxLength: 1000000});
+    }, SyntaxError);
+    assert.throws(function() {
+      braces.makeRe(nest(4000), {maxLength: 1000000});
+    }, SyntaxError);
+  });
+
+  it('should allow nesting up to the default limit', function() {
+    assert.doesNotThrow(function() {
+      braces.parse(nest(100));
+    });
+    assert.throws(function() {
+      braces.parse(nest(101));
+    }, SyntaxError);
+  });
+
+  it('should respect options.maxDepth', function() {
+    assert.doesNotThrow(function() {
+      braces('{a,{b,c}}', {maxDepth: 2, cache: false});
+    });
+    assert.throws(function() {
+      braces('{a,{b,c}}', {maxDepth: 1, cache: false});
+    }, SyntaxError);
+  });
+
+  it('should enforce fractional maxDepth values', function() {
+    assert.throws(function() {
+      braces('{a,{b,c}}', {maxDepth: 1.5, cache: false});
+    }, SyntaxError);
+  });
+
+  it('should not allow options.maxDepth to raise the default limit', function() {
+    assert.throws(function() {
+      braces.parse(nest(101), {maxDepth: 1000});
+    }, SyntaxError);
+  });
+
+  it('should still expand shallow nested braces', function() {
+    var expected = ['z', 'c', 'z', 'c', 'az', 'ac'].sort();
+    assert.deepEqual(braces.expand('{,{a,}}{z,c}', {cache: false}).sort(), expected);
+  });
+});
