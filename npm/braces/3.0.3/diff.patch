+++ b/test/cve-2026-93687.test.js
@@ -0,0 +1,65 @@
+'use strict';
+
+require('mocha');
+const assert = require('assert').strict;
+const vm = require('vm');
+const compile = require('../lib/compile');
+const expand = require('../lib/expand');
+const parse = require('../lib/parse');
+const stringify = require('../lib/stringify');
+
+const deepAst = () => {
+  let ast = { type: 'text', value: 'a' };
+  for (let i = 0; i < 101; i++) ast = { type: 'brace', nodes: [ast] };
+  return { type: 'root', nodes: [ast] };
+};
+
+describe('CVE-2026-93687: nesting depth limit', () => {
+  it('parse should throw when nesting exceeds the maximum depth', () => {
+    assert.throws(() => parse('{'.repeat(101) + 'a,b' + '}'.repeat(101)), /exceeds max depth/);
+    assert.throws(() => parse('('.repeat(101) + ')'.repeat(101)), /exceeds max depth/);
+  });
+
+  it('parse should support a lower maximum depth', () => {
+    assert.throws(() => parse('{{a,b},c}', { maxDepth: 1 }), /exceeds max depth/);
+    assert.doesNotThrow(() => parse('{{a,b},c}', { maxDepth: 2 }));
+  });
+
+  it('parse should enforce fractional maximum depth values', () => {
+    assert.doesNotThrow(() => parse('{a,b}', { maxDepth: 1.5 }));
+    assert.throws(() => parse('{{a,b},c}', { maxDepth: 1.5 }), /exceeds max depth/);
+    assert.doesNotThrow(() => parse('(a)', { maxDepth: 1.5 }));
+    assert.throws(() => parse('((a))', { maxDepth: 1.5 }), /exceeds max depth/);
+  });
+
+  it('compile should reject deeply nested ASTs', () => {
+    assert.throws(() => compile(deepAst()), /exceeds max depth/);
+  });
+
+  it('expand should reject deeply nested ASTs', () => {
+    assert.throws(() => expand(deepAst()), /exceeds max depth/);
+  });
+
+  it('stringify should reject deeply nested ASTs', () => {
+    assert.throws(() => stringify(deepAst()), /exceeds max depth/);
+  });
+
+  it('expand should reject a self-referencing AST parent', () => {
+    const ast = { type: 'paren', nodes: [{ type: 'text', value: 'a' }] };
+    ast.parent = ast;
+    assert.throws(
+      () => vm.runInNewContext('expand(ast)', { expand, ast }, { timeout: 250 }),
+      error => error instanceof RangeError && /parent chain contains a cycle/.test(error.message)
+    );
+  });
+
+  it('expand should still expand parsed parentheses with ordinary parent links', () => {
+    assert.deepEqual(expand(parse('foo/({a,b})')), ['foo/(a)', 'foo/(b)']);
+  });
+
+  it('stringify should not escape valid nested braces when escapeInvalid is set', () => {
+    for (const pattern of ['{{a}}', '{a,{b}}', '{{x}y}', '{a,{b,{c}}', '{}{a}']) {
+      assert.equal(stringify(parse(pattern), { escapeInvalid: true }), pattern);
+    }
+  });
+});
