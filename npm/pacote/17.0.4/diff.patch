Description: Fix CVE-2026-9496 - avoid ReDoS in addGitSha committish stripping
 The non-hosted branch of addGitSha stripped the committish from a git
 remote spec with the regular expression /#.*$/. On a maliciously crafted
 rawSpec this pattern exhibits catastrophic backtracking (ReDoS). Replace
 the regex with a linear indexOf/slice scan.
 .
 The upstream fix also updates test/util/add-git-sha.js, but the published
 npm tarball for pacote@17.0.4 ships only lib/ (no test/ directory), so the
 test hunk is omitted here to keep the patch applicable to the distributed
 package.
Origin: upstream, https://github.com/npm/pacote/commit/ce804fb1647fe1699b2f87efd01ea9f4efed8508
--- a/lib/util/add-git-sha.js
+++ b/lib/util/add-git-sha.js
@@ -8,7 +8,10 @@ const addGitSha = (spec, sha) => {
     return `${base}#${sha}`
   } else {
     // don't use new URL for this, because it doesn't handle scp urls
-    return spec.rawSpec.replace(/#.*$/, '') + `#${sha}`
+    // strip the committish with indexOf/slice to avoid a regexp redos
+    const hashIndex = spec.rawSpec.indexOf('#')
+    const base = hashIndex === -1 ? spec.rawSpec : spec.rawSpec.slice(0, hashIndex)
+    return `${base}#${sha}`
   }
 }
