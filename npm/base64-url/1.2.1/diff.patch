+++ b/test/nswg-eco-434.test.js
@@ -0,0 +1,31 @@
+'use strict';
+
+// Regression test for NSWG-ECO-434 (GHSA-j4mr-9xw3-c9jx).
+//
+// Root cause: base64url.encode/decode used the deprecated `new Buffer(arg)`
+// constructor. When `arg` is a number, `new Buffer(n)` allocates an
+// UNINITIALIZED buffer of length n, exposing previously-freed heap memory in
+// the base64 output (CWE-125, out-of-bounds read / information disclosure).
+// The fix replaces `new Buffer(...)` with `Buffer.from(...)`, which rejects a
+// numeric argument (throws TypeError) instead of leaking uninitialized memory.
+//
+// Note: the Buffer.from fix in index.js is applied by GHSA-j4mr-9xw3-c9jx
+// (same advisory); this patch only adds the NSWG-ECO-434 regression test.
+
+var tape = require('tape');
+var base64url = require('../index');
+
+tape('NSWG-ECO-434: numeric input must not leak uninitialized memory', function (assert) {
+  // Buffer.from(number) throws; new Buffer(number) leaked uninitialized memory.
+  assert.throws(
+    function () { base64url.encode(1024); },
+    /TypeError|argument|string/i,
+    'encode(number) must throw instead of allocating uninitialized memory'
+  );
+  assert.end();
+});
+
+tape('NSWG-ECO-434: string round-trip still works after the fix', function (assert) {
+  var text = 'Node.js is awesome.';
+  var encoded = base64url.encode(text);
+  assert.ok(encoded, 'encode: ' + encoded);
+  assert.equal(base64url.decode(encoded), text, 'decode round-trips to original');
+  assert.end();
+});
