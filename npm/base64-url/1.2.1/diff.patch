+++ b/test/ghsa-j4mr-9xw3-c9jx.test.js
@@ -0,0 +1,23 @@
+'use strict';
+
+// Regression test for GHSA-j4mr-9xw3-c9jx (CWE-125):
+// new Buffer(number) allocated uninitialized memory, allowing an
+// out-of-bounds read / information disclosure when a numeric value was
+// passed to encode(). Buffer.from(number) throws instead of allocating,
+// so a numeric input must never yield leaked buffer contents.
+var tape = require('tape');
+var base64url = require('../index');
+
+tape('GHSA-j4mr-9xw3-c9jx: numeric input must not leak uninitialized memory', function (assert) {
+  // A numeric argument must not be coerced into an uninitialized buffer.
+  assert.throws(function () {
+    base64url.encode(100);
+  }, 'encode(number) must throw rather than allocate uninitialized memory');
+
+  // Normal string round-trip still works after the fix.
+  var text = 'Node.js is awesome.';
+  assert.equal(base64url.decode(base64url.encode(text)), text,
+    'string round-trip is preserved');
+
+  assert.end();
+});

