--- /dev/null
+++ b/test/ghsa-mrv2-3pqr-j5jr.test.js
@@ -0,0 +1,101 @@
+/* jshint node: true, esnext: true */
+'use strict';
+
+const assert = require('node:assert');
+const { JSDOM } = require('jsdom');
+const createDOMPurify = require('../dist/purify.cjs');
+
+const { window } = new JSDOM('');
+const DOMPurify = createDOMPurify(window);
+
+let failures = 0;
+function check(name, fn) {
+  try {
+    fn();
+    console.log('ok - ' + name);
+  } catch (err) {
+    failures++;
+    console.log('not ok - ' + name);
+    console.log(String(err && err.stack ? err.stack : err));
+  }
+}
+
+function build(html) {
+  const root = window.document.createElement('div');
+  root.innerHTML = html;
+  return root;
+}
+
+check('IN_PLACE: hook removing a parent leaves no armed handler (GHSA-mrv2-3pqr-j5jr)', function () {
+  const root = build(
+    '<div id="p"><i id="first"></i><img id="victim" src="x" onerror="alert(1)"></div>'
+  );
+  const victim = root.querySelector('#victim');
+  DOMPurify.addHook('beforeSanitizeElements', function (node) {
+    if (node.id === 'first') {
+      node.parentNode.remove();
+    }
+  });
+  try {
+    DOMPurify.sanitize(root, { IN_PLACE: true });
+  } finally {
+    DOMPurify.removeHook('beforeSanitizeElements');
+  }
+  assert.ok(!victim.isConnected || !root.contains(victim), 'victim detached');
+  assert.strictEqual(
+    victim.getAttribute('onerror'),
+    null,
+    'onerror must be stripped from the subtree a hook detached'
+  );
+});
+
+check('IN_PLACE: hook removing an unvisited later sibling leaves no armed handler', function () {
+  const root = build(
+    '<p id="a"></p><div id="later"><img id="victim" src="x" onerror="alert(1)"></div>'
+  );
+  const victim = root.querySelector('#victim');
+  DOMPurify.addHook('uponSanitizeElement', function (node) {
+    if (node.id === 'a') {
+      root.querySelector('#later').remove();
+    }
+  });
+  try {
+    DOMPurify.sanitize(root, { IN_PLACE: true });
+  } finally {
+    DOMPurify.removeHook('uponSanitizeElement');
+  }
+  assert.strictEqual(victim.getAttribute('onerror'), null);
+});
+
+check('IN_PLACE: a throwing hook still neutralizes what it detached', function () {
+  const root = build(
+    '<p id="a"></p><div id="later"><img id="victim" src="x" onerror="alert(1)"></div>'
+  );
+  const victim = root.querySelector('#victim');
+  DOMPurify.addHook('beforeSanitizeElements', function (node) {
+    if (node.id === 'a') {
+      root.querySelector('#later').remove();
+      throw new Error('hook failure');
+    }
+  });
+  try {
+    assert.throws(function () {
+      DOMPurify.sanitize(root, { IN_PLACE: true });
+    }, /hook failure/);
+  } finally {
+    DOMPurify.removeHook('beforeSanitizeElements');
+  }
+  assert.strictEqual(victim.getAttribute('onerror'), null);
+});
+
+check('IN_PLACE: ordinary sanitization is unchanged', function () {
+  const root = build('<b onclick="x()">ok</b><img src="x" onerror="x()">');
+  DOMPurify.sanitize(root, { IN_PLACE: true });
+  assert.strictEqual(root.innerHTML, '<b>ok</b><img src="x">');
+});
+
+if (failures > 0) {
+  console.error('\n' + failures + ' GHSA-mrv2-3pqr-j5jr regression check(s) failed');
+  process.exit(1);
+}
+console.log('\nAll GHSA-mrv2-3pqr-j5jr regression checks passed');
