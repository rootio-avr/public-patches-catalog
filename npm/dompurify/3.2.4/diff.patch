@@ -0,0 +1,30 @@
+/* Regression test for CVE-2026-65913 (GHSA-cj63-jhhr-wcxv).
+ *
+ * When USE_PROFILES is set, ALLOWED_ATTR must be a null-prototype object
+ * so Array.prototype pollution cannot smuggle event-handler attributes.
+ */
+'use strict';
+
+const assert = require('node:assert');
+const createDOMPurify = require('../dist/purify.cjs');
+const { JSDOM } = require('jsdom');
+
+const window = new JSDOM('').window;
+const DOMPurify = createDOMPurify(window);
+
+/* eslint-disable no-extend-native */
+Array.prototype.onclick = true;
+try {
+  const dirty = '<img src=x onclick=alert(1)>';
+  const clean = DOMPurify.sanitize(dirty, { USE_PROFILES: { html: true } });
+  assert.strictEqual(
+    /onclick/i.test(clean),
+    false,
+    'onclick attribute must be stripped despite Array.prototype pollution: ' + clean
+  );
+} finally {
+  delete Array.prototype.onclick;
+}
+/* eslint-enable no-extend-native */
+
+console.log('CVE-2026-65913 regression test passed');

