diff --git a/test/cve-2026-65914.test.js b/test/cve-2026-65914.test.js
new file mode 100644
index 0000000..ae27e08
--- /dev/null
+++ b/test/cve-2026-65914.test.js
@@ -0,0 +1,70 @@
+/* jshint node: true, esnext: true */
+'use strict';
+
+const assert = require('node:assert');
+const { JSDOM } = require('jsdom');
+const createDOMPurify = require('../dist/purify.cjs');
+
+const { window } = new JSDOM('');
+const DOMPurify = createDOMPurify(window);
+
+let failures = 0;
+function check(name, fn) {
+  try {
+    fn();
+    console.log('ok - ' + name);
+  } catch (err) {
+    failures++;
+    console.log('not ok - ' + name);
+    console.log(String(err && err.stack ? err.stack : err));
+  }
+}
+
+check('noembed attribute mutation-XSS is neutralized', function () {
+  const dirty =
+    "a<noembed><p id='</noembed><img src=x onerror=alert(1)>'></p></noembed>";
+  const clean = DOMPurify.sanitize(dirty, { ADD_TAGS: ['noembed'] });
+  assert.ok(
+    !/onerror\s*=\s*alert/i.test(clean),
+    'sanitized output must not contain an executable onerror handler: ' + clean
+  );
+});
+
+check('noframes/xmp text integration point payload is neutralized', function () {
+  const dirty = "x<noframes><svg><b><xmp><b title='</xmp><img>";
+  const clean = DOMPurify.sanitize(dirty, { ADD_TAGS: ['xmp'] });
+  assert.ok(
+    clean.indexOf('x') !== -1,
+    'benign leading text should be preserved: ' + clean
+  );
+  assert.ok(
+    !/onerror\s*=\s*alert/i.test(clean),
+    'sanitized output must not contain an executable onerror handler: ' + clean
+  );
+});
+
+check('raw-text closing tags in attribute value are stripped', function () {
+  ['iframe', 'noscript', 'script', 'textarea'].forEach(function (tag) {
+    const dirty =
+      '<p title="</' + tag + '><img src=x onerror=alert(1)>">hello</p>';
+    const clean = DOMPurify.sanitize(dirty);
+    assert.ok(
+      !/onerror\s*=\s*alert/i.test(clean),
+      'onerror handler leaked for wrapper ' + tag + ': ' + clean
+    );
+  });
+});
+
+check('benign attribute values are preserved', function () {
+  const clean = DOMPurify.sanitize('<a title="hello world">link</a>');
+  assert.ok(
+    /title="hello world"/.test(clean),
+    'benign title attribute should be preserved: ' + clean
+  );
+});
+
+if (failures > 0) {
+  console.error('\n' + failures + ' CVE-2026-65914 regression check(s) failed');
+  process.exit(1);
+}
+console.log('\nAll CVE-2026-65914 regression checks passed');

