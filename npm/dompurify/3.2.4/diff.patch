diff --git a/test/cve-2026-65903.test.js b/test/cve-2026-65903.test.js
new file mode 100644
index 0000000..4f2b0ac
--- /dev/null
+++ b/test/cve-2026-65903.test.js
@@ -0,0 +1,42 @@
+/* Regression test for CVE-2026-65903 (GHSA-39q2-94rc-95cp).
+ *
+ * Operator-precedence / short-circuit logic error in the element-removal
+ * check: FORBID_TAGS must always win when deciding whether an element is
+ * removed.
+ *
+ * Standalone node:assert test; run with `node test/cve-2026-65903.test.js`.
+ */
+'use strict';
+
+const assert = require('node:assert');
+const createDOMPurify = require('../dist/purify.cjs');
+const { JSDOM } = require('jsdom');
+
+const window = new JSDOM('').window;
+const DOMPurify = createDOMPurify(window);
+
+const clean1 = DOMPurify.sanitize('<article>keep</article><section>drop</section>', {
+  ADD_TAGS: ['article', 'section'],
+  FORBID_TAGS: ['section'],
+});
+assert.strictEqual(
+  clean1.indexOf('<section'),
+  -1,
+  'FORBID_TAGS must win: forbidden <section> should be removed'
+);
+assert.ok(
+  clean1.indexOf('<article') !== -1,
+  'non-forbidden allowed <article> should be retained'
+);
+
+const clean2 = DOMPurify.sanitize('<b>hello</b><i>world</i>', {
+  FORBID_TAGS: ['i'],
+});
+assert.strictEqual(clean2.indexOf('<i>'), -1, 'forbidden <i> should be removed');
+assert.ok(clean2.indexOf('<b>hello</b>') !== -1, 'benign <b> should be retained');
+
+const clean3 = DOMPurify.sanitize('<img src=x onerror=alert(1)//><b>ok</b>');
+assert.strictEqual(clean3.indexOf('onerror'), -1, 'dangerous attribute must be stripped');
+assert.ok(clean3.indexOf('ok') !== -1, 'benign content must survive');
+
+console.log('CVE-2026-65903 regression test passed');

