@@ -0,0 +1,39 @@
+/* Regression test for CVE-2026-65898 (GHSA-cmwh-pvxp-8882).
+ *
+ * setConfig() path must restore pristine allowlists so hook widening
+ * cannot leak across calls; unknown hook keys must not pollute Object.prototype.
+ */
+'use strict';
+
+const assert = require('node:assert');
+const createDOMPurify = require('../dist/purify.cjs');
+const { JSDOM } = require('jsdom');
+
+const window = new JSDOM('').window;
+const DOMPurify = createDOMPurify(window);
+
+DOMPurify.setConfig({ ALLOWED_TAGS: ['img'], ALLOWED_ATTR: ['src'] });
+DOMPurify.addHook('uponSanitizeAttribute', function (node, data) {
+  if (node.getAttribute && node.getAttribute('data-trusted') === '1') {
+    data.allowedAttributes['onerror'] = true;
+  }
+});
+assert.ok(
+  DOMPurify.sanitize('<img data-trusted="1" src="x" onerror="ok()">').indexOf('onerror') !== -1,
+  'in-call widening works for the trusted element under setConfig'
+);
+assert.strictEqual(
+  DOMPurify.sanitize('<img src="x" onerror="alert(1)">'),
+  '<img src="x">',
+  'untrusted call after trusted render strips onerror'
+);
+DOMPurify.removeHooks('uponSanitizeAttribute');
+DOMPurify.clearConfig();
+
+DOMPurify.addHook('__proto__', function () {});
+assert.strictEqual(({}).polluted, undefined, 'addHook with __proto__ key does not pollute Object.prototype');
+assert.strictEqual(typeof ({}).length, 'undefined', 'Object.prototype not given a bogus hook array');
+DOMPurify.removeHook('__proto__');
+DOMPurify.removeHooks('__proto__');
+
+console.log('CVE-2026-65898 regression test passed');

