diff --git a/test/cve-2026-65902.test.js b/test/cve-2026-65902.test.js
new file mode 100644
index 0000000..d7eb041
--- /dev/null
+++ b/test/cve-2026-65902.test.js
@@ -0,0 +1,52 @@
+/* Regression test for CVE-2026-65902 (GHSA-76mc-f452-cxcm).
+ *
+ * Hook-driven allowlist pollution must not persist after hooks are removed.
+ */
+'use strict';
+
+const assert = require('node:assert');
+const createDOMPurify = require('../dist/purify.cjs');
+const { JSDOM } = require('jsdom');
+
+const window = new JSDOM('').window;
+
+const purify = createDOMPurify(window);
+assert.strictEqual(
+  purify.sanitize('<svg><script>alert(1)</script></svg>'),
+  '<svg></svg>',
+  'fresh default sanitize strips <script>'
+);
+
+purify.addHook('uponSanitizeElement', function (node, data) {
+  data.allowedTags['script'] = true;
+});
+assert.strictEqual(
+  purify.sanitize('<svg><script>1</script></svg>'),
+  '<svg><script>1</script></svg>',
+  'in-call widening still works while hook is registered'
+);
+purify.removeAllHooks();
+purify.clearConfig();
+assert.strictEqual(
+  purify.sanitize('<svg><script>alert(1)</script></svg>'),
+  '<svg></svg>',
+  'default sanitize after element-hook removal strips <script>'
+);
+
+const purify2 = createDOMPurify(window);
+purify2.addHook('uponSanitizeAttribute', function (node, data) {
+  data.allowedAttributes['onclick'] = true;
+});
+assert.ok(
+  purify2.sanitize('<a onclick="alert(1)">x</a>').indexOf('onclick') !== -1,
+  'in-call widening still works for attribute hook'
+);
+purify2.removeAllHooks();
+purify2.clearConfig();
+assert.strictEqual(
+  purify2.sanitize('<a onclick="alert(1)">x</a>'),
+  '<a>x</a>',
+  'default sanitize after attr-hook removal strips onclick'
+);
+
+console.log('CVE-2026-65902 regression test passed');

