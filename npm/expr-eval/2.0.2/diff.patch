2.43.0


Description: Fix CVE-2026-12866 — code injection via toJSFunction() value serialization
 escapeValue() only serialized strings safely and returned every other value
 unchanged. In toJSFunction() those non-string values are concatenated into a
 new Function() body and coerced via an attacker-controllable toString()/
 valueOf(), allowing arbitrary JavaScript execution (RCE in Node.js). Restrict
 escapeValue() to emit safe literals for the value types math expressions
 legitimately produce (string, number, boolean, null, undefined) and refuse any
 other type (object, function, symbol, bigint), which previously could only
 yield invalid JS or an injection payload.
Origin: ai-synthesized, CVE-2026-12866
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-09-23

--- a/dist/bundle.js
+++ b/dist/bundle.js
@@ -419,7 +419,10 @@
     if (typeof v === 'string') {
       return JSON.stringify(v).replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
     }
-    return v;
+    if (typeof v === 'number' || typeof v === 'boolean' || v === null || typeof v === 'undefined') {
+      return String(v);
+    }
+    throw new Error('expr-eval: cannot serialize value of type ' + (typeof v) + ' to a JavaScript expression');
   }
 
   function contains(array, obj) {
--- a/dist/index.mjs
+++ b/dist/index.mjs
@@ -413,7 +413,10 @@ function escapeValue(v) {
   if (typeof v === 'string') {
     return JSON.stringify(v).replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
   }
-  return v;
+  if (typeof v === 'number' || typeof v === 'boolean' || v === null || typeof v === 'undefined') {
+    return String(v);
+  }
+  throw new Error('expr-eval: cannot serialize value of type ' + (typeof v) + ' to a JavaScript expression');
 }
 
 function contains(array, obj) {
--- /dev/null
+++ b/test/cve_2026_12866.js
@@ -0,0 +1,66 @@
+/* global describe, it */
+
+'use strict';
+
+// Regression test for CVE-2026-12866 (CWE-94): code injection via
+// Expression.prototype.toJSFunction(). A non-string variable value was emitted
+// verbatim into the generated new Function() body and coerced through an
+// attacker-controllable toString()/valueOf(), allowing arbitrary JS execution
+// (RCE in Node.js). The fix hardens escapeValue() so only safe primitive
+// literals are emitted and any object/function/symbol/bigint value is rejected
+// with an Error before the function is ever compiled.
+//
+// Note: a bare variable expression ('x') is used so the malicious value is
+// carried straight into code generation. Combining it with an operator (e.g.
+// 'x + 1') would let simplify() fold the value before emission, which is not
+// the vulnerable path being guarded here.
+
+var assert = require('assert');
+var Parser = require('../dist/bundle').Parser;
+
+describe('CVE-2026-12866 toJSFunction() code injection', function () {
+  it('refuses to compile an object variable value with a malicious toString()', function () {
+    var parser = new Parser();
+    var payload = {
+      toString: function () {
+        return 'globalThis.__exprEvalPwned = true, 0';
+      }
+    };
+    global.__exprEvalPwned = undefined;
+    assert.throws(function () {
+      parser.parse('x').toJSFunction([], { x: payload });
+    }, /cannot serialize value of type object/);
+    assert.strictEqual(global.__exprEvalPwned, undefined,
+      'injected code must not have executed');
+  });
+
+  it('rejects a function-typed variable value rather than emitting it raw', function () {
+    var parser = new Parser();
+    assert.throws(function () {
+      parser.parse('x').toJSFunction([], { x: function () { return 1; } });
+    }, /cannot serialize value of type function/);
+  });
+
+  it('still folds legitimate numeric variable values correctly', function () {
+    var parser = new Parser();
+    var f = parser.parse('2 * x + 1').toJSFunction([], { x: 3 });
+    assert.strictEqual(f(), 7);
+  });
+
+  it('still emits a legitimate boolean variable value as a literal', function () {
+    var parser = new Parser();
+    var f = parser.parse('x').toJSFunction([], { x: true });
+    assert.strictEqual(f(), true);
+  });
+
+  it('still handles string literals in generated functions', function () {
+    var parser = new Parser();
+    var f = parser.parse('"a" == "a"').toJSFunction([]);
+    assert.strictEqual(f(), true);
+  });
+
+  it('still compiles a plain expression with runtime parameters', function () {
+    var parser = new Parser();
+    assert.strictEqual(parser.parse('2 ^ x').toJSFunction('x')(3), 8);
+  });
+});
