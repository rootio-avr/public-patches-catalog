@@ -0,0 +1,58 @@
+var express = require("express");
+var assert = require("assert");
+var url = require("url");
+var concat = require("concat-stream");
+var server = require("./lib/test-server")({ http: 3600 });
+var http = require("..").http;
+var util = require("./lib/util");
+var redirectsTo = util.redirectsTo;
+var asPromise = util.asPromise;
+
+describe("CVE-2022-0155: confidential headers on cross-host redirects", function () {
+  var app;
+  beforeEach(function () {
+    app = express();
+  });
+  afterEach(function () {
+    return server.stop();
+  });
+
+  function request(target, headers) {
+    app.get("/a", redirectsTo(302, target));
+    app.get("/b", function (req, res) {
+      res.end(JSON.stringify(req.headers));
+    });
+    var opts = url.parse("http://127.0.0.1:3600/a");
+    opts.headers = headers;
+    return server.start(app)
+      .then(asPromise(function (resolve, reject) {
+        http.get(opts, resolve).on("error", reject);
+      }))
+      .then(asPromise(function (resolve, reject, res) {
+        res.pipe(concat({ encoding: "string" }, resolve)).on("error", reject);
+      }))
+      .then(JSON.parse);
+  }
+
+  ["Authorization", "Cookie"].forEach(function (header) {
+    var name = header.toLowerCase();
+
+    it("drops " + header + " when redirected to another host", function () {
+      var headers = { host: "localhost" };
+      headers[header] = "secret";
+      return request("http://localhost:3600/b", headers).then(function (body) {
+        assert.equal(body.host, "localhost:3600");
+        assert.equal(body[name], undefined);
+      });
+    });
+
+    it("keeps " + header + " when redirected to the same host", function () {
+      var headers = { host: "localhost:3600" };
+      headers[header] = "secret";
+      return request("http://localhost:3600/b", headers).then(function (body) {
+        assert.equal(body.host, "localhost:3600");
+        assert.equal(body[name], "secret");
+      });
+    });
+  });
+});
