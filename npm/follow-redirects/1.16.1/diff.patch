+++ b/test/cve-2026-116689.test.js
@@ -0,0 +1,41 @@
+var express = require("express");
+var assert = require("assert");
+var vm = require("vm");
+var url = require("url");
+var server = require("./server")({ https: 3601, http: 3600 });
+var followRedirects = require("..");
+var http = followRedirects.http;
+var util = require("./util");
+var concatJson = util.concatJson;
+var redirectsTo = util.redirectsTo;
+var asPromise = util.asPromise;
+
+describe("CVE-2026-116689: sensitiveHeaders from another realm", function () {
+  afterEach(function () {
+    return server.stop();
+  });
+
+  it("honors a sensitiveHeaders array created in a different realm", function () {
+    var app = express();
+    app.get("/a", redirectsTo(302, "http://localhost:3600/b"));
+    app.get("/b", function (req, res) {
+      res.end(JSON.stringify(req.headers));
+    });
+
+    var opts = url.parse("http://127.0.0.1:3600/a");
+    opts.headers = { "X-Secret": "secret", host: "localhost" };
+    // An array from another realm is not `instanceof Array` in this realm
+    opts.sensitiveHeaders = vm.runInNewContext("['X-Secret']");
+    assert.ok(Array.isArray(opts.sensitiveHeaders));
+    assert.ok(!(opts.sensitiveHeaders instanceof Array));
+
+    return server.start(app)
+      .then(asPromise(function (resolve, reject) {
+        http.get(opts, concatJson(resolve, reject)).on("error", reject);
+      }))
+      .then(function (res) {
+        assert.equal(res.parsedJson.host, "localhost:3600");
+        assert.equal(res.parsedJson["x-secret"], undefined);
+      });
+  });
+});
