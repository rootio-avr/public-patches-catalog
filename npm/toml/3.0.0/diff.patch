+
+// Regression test for CVE-2026-77465 / GHSA-82x6-q7mm-w9cf: deeply nested
+// arrays or inline tables must not overflow the recursive-descent parser's
+// call stack. They should raise a catchable parse error (with line/column
+// info) instead of an uncatchable RangeError.
+function nestArray(depth) {
+  return "a=" + Array(depth + 1).join("[") + "1" + Array(depth + 1).join("]");
+}
+
+function nestInlineTable(depth) {
+  return "a=" + Array(depth + 1).join("{b=") + "1" + Array(depth + 1).join("}");
+}
+
+exports.testRejectsDeeplyNestedArrays = function(test) {
+  try {
+    toml.parse(nestArray(5000));
+    test.ok(false, "Should have thrown");
+  } catch (e) {
+    test.strictEqual(e instanceof RangeError, false);
+    test.strictEqual(typeof e.line, "number");
+  }
+  test.done();
+};
+
+exports.testRejectsDeeplyNestedInlineTables = function(test) {
+  try {
+    toml.parse(nestInlineTable(5000));
+    test.ok(false, "Should have thrown");
+  } catch (e) {
+    test.strictEqual(e instanceof RangeError, false);
+    test.strictEqual(typeof e.line, "number");
+  }
+  test.done();
+};
+
+exports.testAllowsNestingUpToDefaultLimit = function(test) {
+  // The innermost scalar is itself a value, so N brackets reach depth N + 1.
+  test.doesNotThrow(function() {
+    toml.parse(nestArray(499));
+  });
+  test.done();
+};
+
+exports.testRejectsNestingPastDefaultLimit = function(test) {
+  test.throws(function() {
+    toml.parse(nestArray(500));
+  });
+  test.done();
+};
+
+exports.testHonorsCustomMaxDepth = function(test) {
+  test.doesNotThrow(function() {
+    toml.parse(nestArray(9), { maxDepth: 10 });
+  });
+  test.throws(function() {
+    toml.parse(nestArray(10), { maxDepth: 10 });
+  });
+  test.done();
+};
+
+exports.testDoesNotMiscountSiblingsViaBacktracking = function(test) {
+  // Each trailing comma triggers a failed `value` probe that the parser
+  // backtracks over; the guard must not leak depth across these siblings.
+  var siblings = [];
+  for (var i = 0; i < 2000; i++) siblings.push("[1,]");
+  var result = toml.parse("a=[" + siblings.join(",") + "]", { maxDepth: 4 });
+  test.strictEqual(result.a.length, 2000);
+  test.done();
+};
