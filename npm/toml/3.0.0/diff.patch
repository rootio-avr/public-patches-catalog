+// Regression test for CVE-2026-114141 (GHSA-h895-cgqg-jf52, GHSA-9j65-hcg3-gc64,
+// GHSA-4qx8-w7c3-pj3p). Grounded in the upstream "prototype pollution
+// hardening" and performance suites added in commit df2bd01 (test/test_toml.js).
+//
+// The compiler used to decide whether a key could be defined, extended or
+// appended to by consulting string-keyed path sets. Distinct key paths could
+// render to the same string (an array-of-tables header cleared the guard on an
+// unrelated key sharing its prefix), and the bookkeeping was quadratic in the
+// number of headers. Table origin is now tracked on the table itself.
+"use strict";
+
+var toml = require('../');
+
+// Parse `tomlStr` and assert it does NOT mutate Object.prototype[propertyName].
+// The parse itself is expected to throw (the malicious path is rejected).
+function rejectsWithoutObjectPrototypeMutation(test, tomlStr, propertyName) {
+  delete Object.prototype[propertyName];
+  try {
+    test.throws(function() {
+      toml.parse(tomlStr);
+    });
+    test.strictEqual(Object.prototype[propertyName], undefined);
+  } finally {
+    delete Object.prototype[propertyName];
+  }
+}
+
+exports.testArrayOfTablesDoesNotClearUnrelatedPrefixedTable = function(test) {
+  // `[[a]]` must not forget the already defined table `[ab]` just because
+  // "ab" starts with "a"; redefining `[ab]` is an error.
+  test.throws(function() {
+    toml.parse("[ab]\nx = 1\n[[a]]\n[ab]\ny = 2");
+  });
+  test.done();
+};
+
+exports.testRejectsTablePathDescendingThroughDateAfterTableArray = function(test) {
+  rejectsWithoutObjectPrototypeMutation(
+    test,
+    "a = 1979-05-27T07:32:00Z\n[[b]]\n[a.__proto__.__proto__]\npolluted = \"yes\"",
+    "polluted"
+  );
+  test.done();
+};
+
+exports.testRejectsTablePathDescendingThroughStaticArray = function(test) {
+  rejectsWithoutObjectPrototypeMutation(
+    test,
+    "a = [1, 2]\n[a.__proto__.__proto__]\npolluted = \"yes\"",
+    "polluted"
+  );
+  test.done();
+};
+
+exports.testRejectsAppendingToStaticArray = function(test) {
+  test.throws(function() {
+    toml.parse("a = [1, 2]\n[[a]]\nx = 1");
+  });
+  test.done();
+};
+
+exports.testRejectsExtendingInlineTable = function(test) {
+  test.throws(function() {
+    toml.parse("a = { x = 1 }\n[a.y]\nz = 1");
+  });
+  test.done();
+};
+
+exports.testStillAllowsImplicitTableToBeDefinedLater = function(test) {
+  test.deepEqual(
+    toml.parse("[a.b]\nc = 1\n[a]\nd = 2"),
+    { a: { b: { c: 1 }, d: 2 } }
