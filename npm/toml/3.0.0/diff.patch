--- /dev/null
+++ b/test/test_cve_2026_63376.js
@@ -0,0 +1,74 @@
+// Regression test for CVE-2026-63376 / GHSA-v5mp-jgw5-2x6j.
+//
+// Table paths must not be able to traverse through an existing scalar value's
+// prototype chain (e.g. `[a.b.y.__proto__.__proto__]`) and mutate
+// Object.prototype. Grounded in the upstream "prototype pollution hardening"
+// suite added in commit dfaff662 (test/test_toml.js).
+"use strict";
+
+var toml = require('../');
+
+// Parse `tomlStr` and assert it does NOT mutate Object.prototype[propertyName].
+// The parse itself is expected to throw (the malicious path is rejected).
+function rejectsWithoutObjectPrototypeMutation(test, tomlStr, propertyName) {
+  delete Object.prototype[propertyName];
+  try {
+    test.throws(function() {
+      toml.parse(tomlStr);
+    });
+    test.strictEqual(Object.prototype[propertyName], undefined);
+  } finally {
+    delete Object.prototype[propertyName];
+  }
+}
+
+exports.testRejectsTablePathDescendingThroughScalar = function(test) {
+  rejectsWithoutObjectPrototypeMutation(
+    test,
+    "[a.b]\ny = 1\n[a.b.y.__proto__.__proto__]\npolluted = \"yes\"",
+    "polluted"
+  );
+  test.done();
+};
+
+exports.testRejectsScalarDescentAfterTableArrayState = function(test) {
+  rejectsWithoutObjectPrototypeMutation(
+    test,
+    "aa = 1\n[[a]]\n[aa.__proto__.__proto__]\npolluted = \"yes\"",
+    "polluted"
+  );
+  test.done();
+};
+
+exports.testDoesNotInjectNestedObjectsIntoObjectPrototype = function(test) {
+  rejectsWithoutObjectPrototypeMutation(
+    test,
+    "[a.b]\ny = 1\n[a.b.y.__proto__.__proto__.code]\nval = \"arbitrary\"",
+    "code"
+  );
+  test.done();
+};
+
+exports.testKeepsDirectProtoTablesAsOwnResultProperties = function(test) {
+  delete Object.prototype.value;
+  var result = toml.parse("[__proto__]\nvalue = \"safe\"");
+
+  test.strictEqual(Object.prototype.value, undefined);
+  test.strictEqual(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  test.strictEqual(result.__proto__.value, "safe");
+  delete Object.prototype.value;
+  test.done();
+};
+
+// Guard must not regress legitimate nested table / table-array construction.
+exports.testAllowsLegitimateNestedTables = function(test) {
+  test.deepEqual(
+    toml.parse("[a.b]\nc = 1\n\n[a]\nd = 2"),
+    { a: { b: { c: 1 }, d: 2 } }
+  );
+  test.deepEqual(
+    toml.parse("[[fruit]]\nname = \"apple\"\n[fruit.physical]\ncolor = \"red\""),
+    { fruit: [ { name: "apple", physical: { color: "red" } } ] }
+  );
+  test.done();
+};

