@@ -0,0 +1,95 @@
+// Regression test for CVE-2026-114142 (upstream "Track table origin on the
+// table instead of in string-keyed path sets", GHSA-4qx8-w7c3-pj3p and
+// GHSA-h895-cgqg-jf52).
+//
+// The compiler used to keep string-keyed path lists and rescan all of them for
+// every array-of-tables header, which was quadratic in the number of headers
+// and let an array-of-tables header clear the guard on unrelated paths.
+// Table origin is now tracked on the table itself.
+"use strict";
+
+var toml = require('../');
+var compiler = require('../lib/compiler');
+
+// Build compiler input directly so that only the compiler is measured.
+function arrayPathNodes(count) {
+  var nodes = [];
+  for (var i = 0; i < count; i++) {
+    nodes.push({ type: "ArrayPath", value: ["t" + i], line: i + 1, column: 1 });
+    nodes.push({
+      type: "Assign", key: "v", line: i + 1, column: 1,
+      value: { type: "Integer", value: 1, line: i + 1, column: 5 }
+    });
+  }
+  return nodes;
+}
+
+exports.testManyArrayOfTablesHeadersCompileInLinearTime = function(test) {
+  var count = 50000;
+  var nodes = arrayPathNodes(count);
+  var start = Date.now();
+  var result = compiler.compile(nodes);
+  var elapsed = Date.now() - start;
+
+  test.strictEqual(result["t" + (count - 1)][0].v, 1);
+  // The rescanning implementation needs minutes for this input.
+  test.ok(elapsed < 5000, "compiling array-of-tables headers took " + elapsed + "ms");
+  test.done();
+};
+
+exports.testManyRepeatedArrayOfTablesElements = function(test) {
+  var count = 50000;
+  var nodes = [];
+  for (var i = 0; i < count; i++) {
+    nodes.push({ type: "ArrayPath", value: ["a"], line: i + 1, column: 1 });
+  }
+  var start = Date.now();
+  var result = compiler.compile(nodes);
+  var elapsed = Date.now() - start;
+
+  test.strictEqual(result.a.length, count);
+  test.ok(elapsed < 5000, "appending to an array of tables took " + elapsed + "ms");
+  test.done();
+};
+
+exports.testArrayOfTablesDoesNotClearUnrelatedPrefixedTable = function(test) {
+  test.throws(function() {
+    toml.parse("[ab]\nx = 1\n[[a]]\n[ab]\ny = 2");
+  });
+  test.done();
+};
+
+exports.testArrayOfTablesDoesNotClearGuardOnSiblingValue = function(test) {
+  var before = Object.prototype.polluted;
+  test.throws(function() {
+    toml.parse("a = 1979-05-27T07:32:00Z\n[[b]]\n[a.__proto__.__proto__]\npolluted = \"yes\"");
+  });
+  test.strictEqual(Object.prototype.polluted, before);
+  delete Object.prototype.polluted;
+  test.done();
+};
+
+exports.testNestedTablesOfEachArrayElementAreIndependent = function(test) {
+  test.deepEqual(
+    toml.parse("[[a]]\n[a.b]\nx = 1\n[[a]]\n[a.b]\nx = 2"),
+    { a: [ { b: { x: 1 } }, { b: { x: 2 } } ] }
+  );
+  test.done();
+};
+
+exports.testStillRejectsRedefinitions = function(test) {
+  [
+    "[a]\n[a]",
+    "a = 1\n[a]",
+    "a = 1\n[[a]]",
+    "a = [1]\n[[a]]",
+    "a = { b = 1 }\n[a.b]",
+    "[a]\n[[a]]",
+    "[[a]]\n[a]"
+  ].forEach(function(str) {
+    test.throws(function() {
+      toml.parse(str);
+    }, undefined, JSON.stringify(str));
+  });
+  test.done();
+};
