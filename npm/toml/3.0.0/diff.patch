+  test.done();
+};
+
+exports.testStillRejectsRedefiningTable = function(test) {
+  test.throws(function() {
+    toml.parse("[a]\nx = 1\n[a]\ny = 2");
+  });
+  test.done();
+};
+
+exports.testSubTablesOfEachTableArrayElementAreIndependent = function(test) {
+  test.deepEqual(
+    toml.parse("[[a]]\n[a.b]\nx = 1\n[[a]]\n[a.b]\nx = 2"),
+    { a: [ { b: { x: 1 } }, { b: { x: 2 } } ] }
+  );
+  test.done();
+};
+
+exports.testManyArrayOfTablesHeadersParseInLinearTime = function(test) {
+  var doc = "";
+  for (var i = 0; i < 20000; i++) {
+    doc += "[[t" + i + "]]\nv = 1\n";
