diff --git a/test/test_cve_2026_114144.js b/test/test_cve_2026_114144.js
new file mode 100644
index 0000000..30a0785
--- /dev/null
+++ b/test/test_cve_2026_114144.js
@@ -0,0 +1,43 @@
+// Regression test for CVE-2026-114144 (GHSA-9qmh-m7c6-f92p): integer literals
+// of unbounded length must be rejected instead of being converted wholesale.
+"use strict";
+
+var toml = require('../');
+
+function digits(n) {
+  return new Array(n + 1).join("9");
+}
+
+exports.testRejectsOverlongIntegerLiteral = function(test) {
+  var inputs = [
+    "a = " + digits(20),
+    "a = -" + digits(20),
+    "a = +" + digits(20),
+    "a = " + digits(100000),
+    "a = [1, " + digits(100000) + "]"
+  ];
+  inputs.forEach(function(input) {
+    try {
+      toml.parse(input);
+      test.ok(false, "Should have thrown");
+    } catch (e) {
+      test.strictEqual(typeof e.line, "number");
+      test.strictEqual(typeof e.column, "number");
+    }
+  });
+  test.done();
+};
+
+exports.testAcceptsIntegersWithinInt64Digits = function(test) {
+  test.strictEqual(toml.parse("a = 9223372036854775807").a, 9223372036854775807);
+  test.strictEqual(toml.parse("a = -9223372036854775808").a, -9223372036854775808);
+  test.strictEqual(toml.parse("a = 1_000_000").a, 1000000);
+  test.strictEqual(toml.parse("a = 42").a, 42);
+  test.strictEqual(toml.parse("a = 0").a, 0);
+  test.done();
+};
+
+exports.testLeadingZerosDoNotCountTowardsLimit = function(test) {
+  test.strictEqual(toml.parse("a = 000000000000000000000000001").a, 1);
+  test.done();
+};

