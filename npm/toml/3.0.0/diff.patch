+++ b/test/test_cve_2026_114143.js
@@ -0,0 +1,86 @@
+// Regression test for CVE-2026-114143.
+//
+// The compiler used to rebuild the full dotted path string for every segment
+// of a table header (and rescan its path lists for every header), which made
+// a header with many segments quadratic in time. Table headers are now
+// resolved segment by segment in constant time per segment, using the origin
+// recorded on each table the compiler created.
+"use strict";
+
+var toml = require('../');
+
+function longHeader(open, close, segments) {
+  var parts = [];
+  for (var i = 0; i < segments; i++) parts.push("k" + i);
+  return open + parts.join(".") + close;
+}
+
+function depthOf(obj) {
+  var depth = 0;
+  while (obj && typeof obj === "object" && Object.keys(obj).length === 1) {
+    obj = obj[Object.keys(obj)[0]];
+    depth++;
+  }
+  return depth;
+}
+
+exports.testLongTableHeaderIsParsedInLinearTime = function(test) {
+  var segments = 30000;
+  var start = Date.now();
+  var result = toml.parse(longHeader("[", "]", segments) + "\nv = 1");
+  var elapsed = Date.now() - start;
+
+  test.strictEqual(depthOf(result), segments + 1); // the innermost table holds the single key "v"
+  // The quadratic implementation needs many seconds for this input.
+  test.ok(elapsed < 2500, "long table header took " + elapsed + "ms");
+  test.done();
+};
+
+exports.testLongTableArrayHeaderIsParsedInLinearTime = function(test) {
+  var segments = 30000;
+  var start = Date.now();
+  var result = toml.parse(longHeader("[", "]", segments - 1) + "\n" + longHeader("[[", "]]", segments) + "\nv = 1");
+  var elapsed = Date.now() - start;
+
+  test.strictEqual(typeof result.k0, "object");
+  test.ok(elapsed < 2500, "long array-of-tables header took " + elapsed + "ms");
+  test.done();
+};
+
+exports.testTableArrayElementsGetFreshSubTables = function(test) {
+  test.deepEqual(
+    toml.parse("[[a]]\n[a.b]\nx = 1\n[[a]]\n[a.b]\nx = 2"),
+    { a: [ { b: { x: 1 } }, { b: { x: 2 } } ] }
+  );
+  test.done();
+};
+
+exports.testImplicitTableCanBeDefinedOnceAfterwards = function(test) {
+  test.deepEqual(
+    toml.parse("[a.b]\nx = 1\n[a]\ny = 2"),
+    { a: { b: { x: 1 }, y: 2 } }
+  );
+  test.throws(function() {
+    toml.parse("[a.b]\n[a]\n[a]");
+  });
+  test.done();
+};
+
+exports.testStillRejectsRedefinitions = function(test) {
+  [
+    "[a]\n[a]",
+    "a = 1\n[a]",
+    "a = { b = 1 }\n[a.b]",
+    "a = [1]\n[[a]]",
+    "[a]\n[[a]]",
+    "[[a]]\n[a]",
+    "a = 1\n[[a]]",
+    "a = 1\n[a.b]",
+    "[[a]]\n[[a.b]]\n[a.b]"
+  ].forEach(function(str) {
+    test.throws(function() {
+      toml.parse(str);
+    }, undefined, JSON.stringify(str));
+  });
+  test.done();
+};

