@@ -0,0 +1,54 @@
+"use strict";
+
+// Regression test for CVE-2026-114143: the compiler decides whether a key may
+// be defined, extended or appended to from the way the containing table was
+// created, so redefinition rules must keep rejecting invalid documents and
+// keep accepting valid ones.
+
+var { describe, it } = require("node:test");
+var assert = require("node:assert");
+var toml = require("../");
+
+describe("CVE-2026-114143 table redefinition rules", function() {
+  it("rejects dotted keys that extend a table defined by a header", function() {
+    assert.throws(function() {
+      toml.parse("[a.b]\nx = 1\n[a]\nb.y = 2\n");
+    }, /Cannot use dotted keys to extend table/);
+  });
+
+  it("rejects extending an inline table", function() {
+    assert.throws(function() {
+      toml.parse("a = { b = 1 }\na.c = 2\n");
+    }, /Cannot redefine existing key|Cannot extend inline table/);
+  });
+
+  it("rejects dotted keys that descend into a parsed non-table value", function() {
+    assert.throws(function() {
+      toml.parse("a = 1979-05-27\na.b = 1\n");
+    }, /Cannot redefine existing key/);
+  });
+
+  it("rejects appending to a statically defined array", function() {
+    assert.throws(function() {
+      toml.parse("a = [1, 2]\n[[a]]\nb = 1\n");
+    }, /Cannot append to statically defined array/);
+  });
+
+  it("rejects defining the same table twice", function() {
+    assert.throws(function() {
+      toml.parse("[a]\nx = 1\n[a]\ny = 2\n");
+    }, /Cannot redefine existing key/);
+  });
+
+  it("still accepts valid dotted keys, implicit tables and arrays of tables", function() {
+    var result = toml.parse(
+      "a.b = 1\na.c = 2\n[x.y]\nz = 1\n[x]\nw = 2\n[[t]]\nn = 1\n[[t]]\nn = 2\n[t.sub]\nm = 3\n"
+    );
+    assert.strictEqual(result.a.b, 1);
+    assert.strictEqual(result.a.c, 2);
+    assert.strictEqual(result.x.y.z, 1);
+    assert.strictEqual(result.x.w, 2);
+    assert.strictEqual(result.t.length, 2);
+    assert.strictEqual(result.t[1].sub.m, 3);
+  });
+});
