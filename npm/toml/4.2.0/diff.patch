+++ b/test/cve-2026-114144.test.js
@@ -0,0 +1,34 @@
+"use strict";
+
+var { describe, it } = require("node:test");
+var assert = require("node:assert");
+var toml = require("../");
+
+// Integer literals that cannot fit in a signed 64-bit integer must be rejected
+// by length, before any conversion work is done on them.
+describe("CVE-2026-114144: oversized integer literals", function () {
+  it("rejects decimal literals longer than int64", function () {
+    assert.throws(function () { toml.parse("a = " + "9".repeat(20)); }, /64-bit/);
+    assert.throws(function () { toml.parse("a = -" + "9".repeat(20)); }, /64-bit/);
+  });
+
+  it("rejects hex, octal and binary literals longer than int64", function () {
+    assert.throws(function () { toml.parse("a = 0x" + "f".repeat(17)); }, /64-bit/);
+    assert.throws(function () { toml.parse("a = 0o" + "7".repeat(22)); }, /64-bit/);
+    assert.throws(function () { toml.parse("a = 0b" + "1".repeat(64)); }, /64-bit/);
+  });
+
+  it("rejects a multi-megabyte literal quickly", function () {
+    var start = Date.now();
+    assert.throws(function () { toml.parse("a = " + "1".repeat(1000000)); }, /64-bit/);
+    assert.ok(Date.now() - start < 5000);
+  });
+
+  it("ignores underscores and leading zeros when counting digits", function () {
+    assert.strictEqual(toml.parse("a = 1_000_000").a, 1000000);
+    assert.strictEqual(toml.parse("a = 0x00000000000000ff").a, 255);
+    assert.strictEqual(toml.parse("a = 0b" + "0".repeat(10) + "101").a, 5);
+    assert.strictEqual(toml.parse("a = -123").a, -123);
+    assert.strictEqual(toml.parse("a = +0").a, 0);
+  });
+});

