@@ -0,0 +1,43 @@
+"use strict";
+// Regression test for CVE-2026-77301 (adm-zip decompression size cap).
+// The fix commit (491600683) shipped no test, so this is a replacement test
+// grounded on the fixed behavior in methods/inflater.js:
+//   * the async (streaming) inflate path must enforce maxOutputLength, and
+//   * a declared uncompressed size of 0 must not disable the cap.
+const assert = require("assert");
+const zlib = require("zlib");
+const inflater = require("../methods/inflater");
+
+describe("CVE-2026-77301 - decompression size cap on async path", () => {
+    // Build raw-deflated data that inflates to `size` bytes.
+    const rawDeflate = (size) => zlib.deflateRawSync(Buffer.alloc(size, 0x41));
+
+    it("async path fails when output exceeds the declared size (bomb that lies about its size)", (done) => {
+        const declared = 8; // lie: claim tiny, actually inflates to 4096 bytes
+        const inbuf = rawDeflate(4096);
+        inflater(inbuf, declared).inflateAsync((result, err) => {
+            assert.ok(err instanceof Error, "expected an error for oversized output");
+            assert.match(err.message, /exceeds the declared uncompressed size/);
+            assert.strictEqual(result.length, 0, "no data returned on cap violation");
+            done();
+        });
+    });
+
+    it("async path enforces the cap even when declared size is 0", (done) => {
+        const inbuf = rawDeflate(1024); // declared 0 but actually 1024 bytes
+        inflater(inbuf, 0).inflateAsync((result, err) => {
+            assert.ok(err instanceof Error, "declared size 0 must not disable the cap");
+            assert.strictEqual(result.length, 0);
+            done();
+        });
+    });
+
+    it("async path still returns data for a legitimate entry within the declared size", (done) => {
+        const inbuf = rawDeflate(100);
+        inflater(inbuf, 100).inflateAsync((result, err) => {
+            assert.ok(!err, "no error for a within-size entry");
+            assert.strictEqual(result.length, 100);
+            done();
+        });
+    });
+});
