+"use strict";
+
+const { expect } = require("chai");
+const zlib = require("zlib");
+const Zip = require("../adm-zip");
+
+// Regression test for GHSA-rcw4-f5rp-g42v:
+// The decompression size cap was not enforced on the async streaming path
+// (getDataAsync / readFileAsync), and a declared uncompressed size of 0
+// disabled the cap entirely. A tiny crafted DEFLATED entry could therefore
+// inflate without bound. The cap must apply on both paths, and a declared
+// size of 0 must still be capped.
+
+const u16 = (n) => {
+    const b = Buffer.alloc(2);
+    b.writeUInt16LE(n >>> 0);
+    return b;
+};
+const u32 = (n) => {
+    const b = Buffer.alloc(4);
+    b.writeUInt32LE(n >>> 0);
+    return b;
+};
+
+function craftDeflatedZip(declaredSize, deflated, crc) {
+    const name = Buffer.from("a");
+    const method = 8; // DEFLATED
+    crc = crc >>> 0;
+    const lfh = Buffer.concat([
+        u32(0x04034b50), u16(20), u16(0), u16(method), u16(0), u16(0),
+        u32(crc), u32(deflated.length), u32(declaredSize),
+        u16(name.length), u16(0), name, deflated
+    ]);
+    const cd = Buffer.concat([
+        u32(0x02014b50), u16(20), u16(20), u16(0), u16(method), u16(0), u16(0),
+        u32(crc), u32(deflated.length), u32(declaredSize),
+        u16(name.length), u16(0), u16(0), u16(0), u16(0), u32(0), u32(0), name
+    ]);
+    const eocd = Buffer.concat([u32(0x06054b50), u16(0), u16(0), u16(1), u16(1), u32(cd.length), u32(lfh.length), u16(0)]);
+    return Buffer.concat([lfh, cd, eocd]);
+}
+
+describe("decompression size cap (async path / declared size 0) - GHSA-rcw4-f5rp-g42v", () => {
+    // 64 MB of zeros compresses to a tiny deflate stream.
+    const bomb = zlib.deflateRawSync(Buffer.alloc(64 * 1024 * 1024, 0));
+
+    it("rejects output larger than the declared size on the async path", (done) => {
+        const zip = new Zip(craftDeflatedZip(1024, bomb, 0));
+        zip.getEntries()[0].getDataAsync(function (data, err) {
+            try {
+                expect(err, "async cap must surface an error").to.be.an("error");
+                expect(data.length).to.equal(0);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+
+    it("rejects output larger than the declared size when the declared size is 0 (async)", (done) => {
+        const zip = new Zip(craftDeflatedZip(0, bomb, 0));
+        zip.getEntries()[0].getDataAsync(function (data, err) {
+            try {
+                expect(err, "size-0 entry must still be capped").to.be.an("error");
+                expect(data.length).to.equal(0);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+
+    it("rejects output larger than the declared size when the declared size is 0 (sync)", () => {
+        const zip = new Zip(craftDeflatedZip(0, bomb, 0));
+        expect(() => zip.getEntries()[0].getData()).to.throw();
+    });
+
+    it("still reads a legitimate DEFLATED entry asynchronously", (done) => {
+        const zip = new Zip();
+        const payload = Buffer.from("hello world ".repeat(5000));
+        zip.addFile("d.txt", payload);
+        const round = new Zip(zip.toBuffer());
+        round.readFileAsync("d.txt", function (data, err) {
+            try {
+                expect(err == null, "legit entry must not error: " + err).to.equal(true);
+                expect(data.equals(payload)).to.equal(true);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+});
