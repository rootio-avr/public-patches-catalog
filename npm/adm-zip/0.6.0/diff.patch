+"use strict";
+
+// CVE-2026-102282 (GHSA-679w-jf3m-wh39): the setuid (04000), setgid (02000) and
+// sticky (01000) bits are attacker-controlled archive metadata and must never be
+// restored on extraction, even with keepOriginalPermission.
+
+const assert = require("assert");
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const Zip = require("../adm-zip");
+
+// unix mode in the high 16 bits of the external attributes (regular file + mode)
+const unixAttr = (mode) => (((0o100000 | mode) << 16) | 0) >>> 0;
+
+function buildZip(mode) {
+    const zip = new Zip();
+    zip.addFile("bin/tool", Buffer.from("payload"));
+    zip.getEntry("bin/tool").header.attr = unixAttr(mode);
+    return new Zip(zip.toBuffer());
+}
+
+describe("CVE-2026-102282 - special permission bits are stripped", () => {
+    let out;
+    beforeEach(() => {
+        out = fs.mkdtempSync(path.join(os.tmpdir(), "adm-zip-cve-2026-102282-"));
+    });
+    afterEach(() => {
+        fs.rmSync(out, { recursive: true, force: true });
+    });
+
+    it("fileAttr drops setuid/setgid/sticky bits", () => {
+        for (const mode of [0o4755, 0o2755, 0o1755, 0o7755]) {
+            assert.strictEqual(buildZip(mode).getEntry("bin/tool").header.fileAttr, 0o755);
+        }
+    });
+
+    it("fileAttr keeps rwxrwxrwx bits", () => {
+        assert.strictEqual(buildZip(0o640).getEntry("bin/tool").header.fileAttr, 0o640);
+    });
+
+    it("extractAllTo(keepOriginalPermission) does not create a setuid file", () => {
+        buildZip(0o4755).extractAllTo(out, true, true);
+        const mode = fs.statSync(path.join(out, "bin", "tool")).mode;
+        assert.strictEqual(mode & 0o7000, 0);
+    });
+
+    it("extractEntryTo(keepOriginalPermission) does not create a setgid file", () => {
+        const zip = buildZip(0o2755);
+        zip.extractEntryTo(zip.getEntry("bin/tool"), out, false, true, true);
+        const mode = fs.statSync(path.join(out, "tool")).mode;
+        assert.strictEqual(mode & 0o7000, 0);
+    });
+
+    it("extractAllToAsync(keepOriginalPermission) does not create a setuid file", (done) => {
+        buildZip(0o4755).extractAllToAsync(out, true, true, (err) => {
+            if (err) return done(err);
+            try {
+                const mode = fs.statSync(path.join(out, "bin", "tool")).mode;
+                assert.strictEqual(mode & 0o7000, 0);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+});

