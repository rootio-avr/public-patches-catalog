+"use strict";
+
+const { expect } = require("chai");
+const zlib = require("zlib");
+const Zip = require("../adm-zip");
+
+// Regression test for CVE-2026-77301:
+// The sync inflate path caps decompression output at the declared uncompressed
+// size (maxOutputLength), but the async streaming path (getDataAsync) ignored
+// that cap entirely, and a declared size of 0 disabled the cap on both paths.
+// A tiny crafted DEFLATED entry could therefore stream an unbounded amount of
+// data on the async path (or when the declared size was 0), buffering it in
+// memory and exhausting the heap before any validation. The fix enforces the
+// cap by hand on the streaming path (rejecting with MAX_OUTPUT_EXCEEDED) and
+// uses a 1-byte floor when the declared size is 0.
+
+const u16 = (n) => {
+    const b = Buffer.alloc(2);
+    b.writeUInt16LE(n >>> 0);
+    return b;
+};
+const u32 = (n) => {
+    const b = Buffer.alloc(4);
+    b.writeUInt32LE(n >>> 0);
+    return b;
+};
+
+// Build a single-entry DEFLATED zip carrying `deflated` bytes while declaring
+// `declaredSize` uncompressed bytes.
+function craftDeflatedZip(declaredSize, deflated, crc) {
+    const name = Buffer.from("a");
+    const method = 8; // DEFLATED
+    crc = crc >>> 0;
+    const lfh = Buffer.concat([
+        u32(0x04034b50),
+        u16(20),
+        u16(0),
+        u16(method),
+        u16(0),
+        u16(0),
+        u32(crc),
+        u32(deflated.length),
+        u32(declaredSize),
+        u16(name.length),
+        u16(0),
+        name,
+        deflated
+    ]);
+    const cd = Buffer.concat([
+        u32(0x02014b50),
+        u16(20),
+        u16(20),
+        u16(0),
+        u16(method),
+        u16(0),
+        u16(0),
+        u32(crc),
+        u32(deflated.length),
+        u32(declaredSize),
+        u16(name.length),
+        u16(0),
+        u16(0),
+        u16(0),
+        u16(0),
+        u32(0),
+        u32(0),
+        name
+    ]);
+    const eocd = Buffer.concat([u32(0x06054b50), u16(0), u16(0), u16(1), u16(1), u32(cd.length), u32(lfh.length), u16(0)]);
+    return Buffer.concat([lfh, cd, eocd]);
+}
+
+describe("decompression bomb (async / size-0 cap) - CVE-2026-77301", () => {
+    // ~512 MB of zeros compresses to a tiny deflate stream: a classic bomb that,
+    // without the async cap, gets fully buffered before the CRC check fails.
+    const bigPayload = Buffer.alloc(512 * 1024 * 1024, 0);
+    const bigDeflated = zlib.deflateRawSync(bigPayload);
+
+    it("caps the async streaming path when the declared size is smaller than the output", (done) => {
+        // Declare only 1 KB while the stream inflates to ~512 MB.
+        const zip = new Zip(craftDeflatedZip(1024, bigDeflated, 0));
+        const before = process.memoryUsage().rss;
+        zip.getEntries()[0].getDataAsync(function (data, err) {
+            try {
+                expect(err, "async cap must surface an error").to.be.an("error");
+                const grewMB = (process.memoryUsage().rss - before) / (1024 * 1024);
+                expect(grewMB, "RSS growth must stay bounded by the declared size, not the real output").to.be.below(256);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+
+    it("does not disable the cap when the declared size is 0", (done) => {
+        // Declared size 0 must not mean "unlimited": the ~512 MB stream must be
+        // rejected without buffering it all.
+        const zip = new Zip(craftDeflatedZip(0, bigDeflated, 0));
+        const before = process.memoryUsage().rss;
+        zip.getEntries()[0].getDataAsync(function (data, err) {
+            try {
+                expect(err, "size-0 entry must still be capped").to.be.an("error");
+                const grewMB = (process.memoryUsage().rss - before) / (1024 * 1024);
+                expect(grewMB, "RSS growth must stay bounded even when the declared size is 0").to.be.below(256);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+
+    it("still reads a legitimate DEFLATED entry on the async path", (done) => {
+        const zip = new Zip();
+        const payload = Buffer.from("hello world ".repeat(5000));
+        zip.addFile("d.txt", payload);
+        const round = new Zip(zip.toBuffer());
+        round.readFileAsync("d.txt", function (data, err) {
+            try {
+                expect(err == null, "legit entry must not error: " + err).to.equal(true);
+                expect(data.equals(payload)).to.equal(true);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+});
