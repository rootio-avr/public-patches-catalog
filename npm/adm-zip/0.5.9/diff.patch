+"use strict";
+const { expect } = require("chai");
+const fs = require("fs");
+const os = require("os");
+const pth = require("path");
+const Zip = require("../adm-zip");
+
+describe("CVE-2026-102282 - setuid/setgid/sticky bits must not be preserved", () => {
+    const build = () => {
+        const zip = new Zip();
+        zip.addFile("suidbin", Buffer.from("#!/bin/sh\n"), "", 0o4755);
+        zip.addFile("sgidbin", Buffer.from("#!/bin/sh\n"), "", 0o2755);
+        zip.addFile("stickybin", Buffer.from("#!/bin/sh\n"), "", 0o1755);
+        zip.addFile("normal", Buffer.from("data"), "", 0o644);
+        return new Zip(zip.toBuffer());
+    };
+
+    it("header.fileAttr only exposes rwxrwxrwx bits", () => {
+        const zip = build();
+        expect(zip.getEntry("suidbin").header.fileAttr).to.equal(0o755);
+        expect(zip.getEntry("sgidbin").header.fileAttr).to.equal(0o755);
+        expect(zip.getEntry("stickybin").header.fileAttr).to.equal(0o755);
+        expect(zip.getEntry("normal").header.fileAttr).to.equal(0o644);
+    });
+
+    it("extractAllTo with keepOriginalPermission does not set special bits", function () {
+        if (process.platform === "win32") this.skip();
+        const dir = fs.mkdtempSync(pth.join(os.tmpdir(), "admzip-cve-"));
+        try {
+            build().extractAllTo(dir, true, true);
+            expect(fs.statSync(pth.join(dir, "suidbin")).mode & 0o7777).to.equal(0o755);
+            expect(fs.statSync(pth.join(dir, "sgidbin")).mode & 0o7777).to.equal(0o755);
+            expect(fs.statSync(pth.join(dir, "stickybin")).mode & 0o7777).to.equal(0o755);
+            expect(fs.statSync(pth.join(dir, "normal")).mode & 0o7777).to.equal(0o644);
+        } finally {
+            fs.rmSync(dir, { recursive: true, force: true });
+        }
+    });
+});

