+"use strict";
+const { expect } = require("chai");
+const zlib = require("zlib");
+const Inflater = require("../methods/inflater");
+const Errors = require("../util/errors");
+
+// Highly compressible payload: a small deflate stream that expands to 8 MiB.
+const BOMB_SIZE = 8 * 1024 * 1024;
+const bomb = zlib.deflateRawSync(Buffer.alloc(BOMB_SIZE));
+const nodeMajor = +process.versions.node.split(".")[0];
+
+describe("GHSA-rcw4-f5rp-g42v - decompression size cap", () => {
+    it("async path rejects output larger than the declared size", (done) => {
+        new Inflater(bomb, 1024).inflateAsync((result, err) => {
+            expect(err).to.be.an("error");
+            expect(err.message).to.equal(Errors.MAX_OUTPUT_EXCEEDED);
+            expect(result.length).to.equal(0);
+            done();
+        });
+    });
+
+    it("async path does not treat a declared size of 0 as unlimited", (done) => {
+        new Inflater(bomb, 0).inflateAsync((result, err) => {
+            expect(err).to.be.an("error");
+            expect(err.message).to.equal(Errors.MAX_OUTPUT_EXCEEDED);
+            expect(result.length).to.equal(0);
+            done();
+        });
+    });
+
+    it("sync path does not treat a declared size of 0 as unlimited", function () {
+        if (nodeMajor < 15) this.skip();
+        expect(() => new Inflater(bomb, 0).inflate()).to.throw();
+    });
+
+    it("async path still inflates data that matches the declared size", (done) => {
+        const plain = Buffer.from("hello hello hello hello");
+        new Inflater(zlib.deflateRawSync(plain), plain.length).inflateAsync((result, err) => {
+            expect(err).to.equal(undefined);
+            expect(result.equals(plain)).to.equal(true);
+            done();
+        });
+    });
+
+    it("an empty entry with declared size 0 still inflates to 0 bytes", (done) => {
+        const empty = zlib.deflateRawSync(Buffer.alloc(0));
+        expect(new Inflater(empty, 0).inflate().length).to.equal(0);
+        new Inflater(empty, 0).inflateAsync((result, err) => {
+            expect(err).to.equal(undefined);
+            expect(result.length).to.equal(0);
+            done();
+        });
+    });
+});
