+        u16(0),
+        u16(method),
+        u16(0),
+        u16(0),
+        u32(crc),
+        u32(content.length),
+        u32(declaredSize),
+        u16(name.length),
+        u16(0),
+        u16(0),
+        u16(0),
+        u16(0),
+        u32(0),
+        u32(0),
+        name
+    ]);
