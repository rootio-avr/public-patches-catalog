+"use strict";
+
+const { expect } = require("chai");
+const Zip = require("../adm-zip");
+
+// Regression test for GHSA-8238-w5pm-2374:
+// The async decompression path (getDataAsync / readFileAsync) created a zlib
+// inflate stream without an "error" listener. Malformed DEFLATE data makes zlib
+// emit an "error" event (Z_DATA_ERROR), which without a listener is re-thrown as
+// an uncaught exception and crashes the host process. The error must instead be
+// delivered through the callback.
+
+const u16 = (n) => {
+    const b = Buffer.alloc(2);
+    b.writeUInt16LE(n >>> 0);
+    return b;
+};
+const u32 = (n) => {
+    const b = Buffer.alloc(4);
+    b.writeUInt32LE(n >>> 0);
+    return b;
+};
+
+// Single-entry DEFLATED zip whose compressed payload is `deflated` (arbitrary bytes).
+function craftDeflatedZip(declaredSize, deflated) {
+    const name = Buffer.from("a");
+    const method = 8; // DEFLATED
+    const lfh = Buffer.concat([
+        u32(0x04034b50),
+        u16(20),
+        u16(0),
+        u16(method),
+        u16(0),
+        u16(0),
+        u32(0),
+        u32(deflated.length),
+        u32(declaredSize),
+        u16(name.length),
+        u16(0),
+        name,
+        deflated
+    ]);
+    const cd = Buffer.concat([
+        u32(0x02014b50),
+        u16(20),
+        u16(20),
+        u16(0),
+        u16(method),
+        u16(0),
+        u16(0),
+        u32(0),
+        u32(deflated.length),
+        u32(declaredSize),
+        u16(name.length),
+        u16(0),
+        u16(0),
+        u16(0),
+        u16(0),
+        u32(0),
+        u32(0),
+        name
+    ]);
+    const eocd = Buffer.concat([u32(0x06054b50), u16(0), u16(0), u16(1), u16(1), u32(cd.length), u32(lfh.length), u16(0)]);
+    return Buffer.concat([lfh, cd, eocd]);
+}
+
+describe("async decompression of malformed DEFLATE data - GHSA-8238-w5pm-2374", () => {
+    // 0xFF 0xFF ... => reserved/invalid DEFLATE block type, zlib raises Z_DATA_ERROR
+    const malformed = Buffer.alloc(32, 0xff);
+
+    it("getDataAsync reports an error through the callback instead of crashing", (done) => {
+        const zip = new Zip(craftDeflatedZip(64, malformed));
+        let calls = 0;
+        zip.getEntries()[0].getDataAsync(function (data, err) {
+            calls++;
+            try {
+                expect(err, "malformed data must surface an error").to.be.an("error");
+                expect(Buffer.isBuffer(data)).to.equal(true);
+                expect(data.length).to.equal(0);
+            } catch (e) {
+                return done(e);
+            }
+            // allow any (incorrect) extra callbacks to be observed before finishing
+            setTimeout(() => {
+                try {
+                    expect(calls, "callback must be invoked exactly once").to.equal(1);
+                    done();
+                } catch (e) {
+                    done(e);
+                }
+            }, 20);
+        });
+    });
+
+    it("readFileAsync reports an error through the callback instead of crashing", (done) => {
+        const zip = new Zip(craftDeflatedZip(64, malformed));
+        zip.readFileAsync("a", function (data, err) {
+            try {
+                expect(err, "malformed data must surface an error").to.be.an("error");
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+
+    it("still reads a legitimate DEFLATED entry on the async path", (done) => {
+        const zip = new Zip();
+        const payload = Buffer.from("hello world ".repeat(500));
+        zip.addFile("d.txt", payload);
+        const round = new Zip(zip.toBuffer());
+        round.readFileAsync("d.txt", function (data, err) {
+            try {
+                expect(err == null, "legit entry must not error: " + err).to.equal(true);
+                expect(data.equals(payload)).to.equal(true);
+                done();
+            } catch (e) {
+                done(e);
+            }
+        });
+    });
+});

