+const u16 = (n) => {
+    const b = Buffer.alloc(2);
+    b.writeUInt16LE(n >>> 0);
+    return b;
+};
+const u32 = (n) => {
+    const b = Buffer.alloc(4);
+    b.writeUInt32LE(n >>> 0);
+    return b;
+};
