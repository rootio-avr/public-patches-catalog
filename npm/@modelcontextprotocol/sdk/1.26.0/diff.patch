+// Regression test for CVE-2026-111768: McpServer `maxToolInputElements` bounds the number of
+// array elements and object members in tools/call arguments.
+const test = require('node:test');
+const assert = require('node:assert');
+const { z } = require('zod');
+const { McpServer } = require('../dist/cjs/server/mcp.js');
+const { Client } = require('../dist/cjs/client/index.js');
+const { InMemoryTransport } = require('../dist/cjs/inMemory.js');
+
+const ok = () => ({ content: [{ type: 'text', text: 'ok' }] });
+
+async function connect(options) {
+    const mcpServer = new McpServer({ name: 'test', version: '1.0' }, options);
+    let calls = 0;
+    mcpServer.registerTool('t', { inputSchema: { items: z.array(z.string()) } }, () => {
+        calls++;
+        return ok();
+    });
+    mcpServer.registerTool('plain', {}, ok);
+    const client = new Client({ name: 'c', version: '1.0' });
+    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+    await Promise.all([client.connect(clientTransport), mcpServer.server.connect(serverTransport)]);
+    return {
+        call: (name, args) => client.callTool({ name, arguments: args }),
+        calls: () => calls
+    };
+}
