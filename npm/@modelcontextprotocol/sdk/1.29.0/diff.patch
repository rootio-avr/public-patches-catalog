@@ -0,0 +1,35 @@
+'use strict';
+// Regression test for CVE-2026-111767: InMemoryTaskStore must keep tasks within the session that created them.
+const assert = require('node:assert');
+const { InMemoryTaskStore } = require('../dist/cjs/experimental/tasks/stores/in-memory.js');
+
+(async () => {
+    const store = new InMemoryTaskStore();
+    const request = { method: 'tools/call', params: { name: 'demo' } };
+    const taskA = await store.createTask({ ttl: null }, 1, request, 'session-a');
+    const unscoped = await store.createTask({ ttl: null }, 2, request);
+
+    // The creating session sees its task; another session gets the same answer as for an unknown task.
+    assert.ok(await store.getTask(taskA.taskId, 'session-a'));
+    assert.strictEqual(await store.getTask(taskA.taskId, 'session-b'), null);
+    await assert.rejects(store.getTaskResult(taskA.taskId, 'session-b'), /not found/);
+    await assert.rejects(store.updateTaskStatus(taskA.taskId, 'cancelled', undefined, 'session-b'), /not found/);
+    await assert.rejects(store.storeTaskResult(taskA.taskId, 'completed', { content: [] }, 'session-b'), /not found/);
+    assert.strictEqual((await store.getTask(taskA.taskId, 'session-a')).status, 'working');
+
+    // listTasks returns the caller's session tasks plus tasks created without a session.
+    const listedB = (await store.listTasks(undefined, 'session-b')).tasks.map(t => t.taskId);
+    assert.deepStrictEqual(listedB, [unscoped.taskId]);
+    const listedA = (await store.listTasks(undefined, 'session-a')).tasks.map(t => t.taskId).sort();
+    assert.deepStrictEqual(listedA, [taskA.taskId, unscoped.taskId].sort());
+
+    // Calls without a sessionId, and tasks created without a sessionId, stay unrestricted.
+    assert.ok(await store.getTask(taskA.taskId));
+    assert.ok(await store.getTask(unscoped.taskId, 'session-b'));
+
+    store.cleanup();
+    console.log('cve-2026-111767 regression test passed');
+})().catch(err => {
+    console.error(err);
+    process.exit(1);
+});
