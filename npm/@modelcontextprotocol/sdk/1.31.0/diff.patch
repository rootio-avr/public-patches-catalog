@@ -0,0 +1,75 @@
+'use strict';
+// Regression test for CVE-2026-111768: McpServer `maxToolInputElements` bounds the number of
+// array elements and object members in tools/call arguments.
+const test = require('node:test');
+const assert = require('node:assert');
+const { z } = require('zod');
+const { McpServer } = require('../dist/cjs/server/mcp.js');
+const { Client } = require('../dist/cjs/client/index.js');
+const { InMemoryTransport } = require('../dist/cjs/inMemory.js');
+
+const ok = () => ({ content: [{ type: 'text', text: 'ok' }] });
+
+async function connect(options) {
+    const mcpServer = new McpServer({ name: 'test', version: '1.0' }, options);
+    let calls = 0;
+    mcpServer.registerTool('t', { inputSchema: { items: z.array(z.string()) } }, () => {
+        calls++;
+        return ok();
+    });
+    mcpServer.registerTool('plain', {}, ok);
+    const client = new Client({ name: 'c', version: '1.0' });
+    const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+    await Promise.all([client.connect(clientTransport), mcpServer.server.connect(serverTransport)]);
+    return {
+        call: (name, args) => client.callTool({ name, arguments: args }),
+        calls: () => calls
+    };
+}
+
+test('accepts a large array when no limit is set', async () => {
+    const { call } = await connect();
+    const result = await call('t', { items: Array(60000).fill('x') });
+    assert.ok(!result.isError);
+    assert.strictEqual(result.content[0].text, 'ok');
+});
+
+test('refuses arguments past a configured limit without invoking the handler', async () => {
+    const { call, calls } = await connect({ maxToolInputElements: 1000 });
+    const result = await call('t', { items: Array(60000).fill('x') });
+    assert.strictEqual(result.isError, true);
+    assert.match(result.content[0].text, /more than the maximum/);
+    assert.strictEqual(calls(), 0);
+});
+
+test('accepts arguments within the limit, and keeps serving after a refused call', async () => {
+    const { call } = await connect({ maxToolInputElements: 2000 });
+    const refused = await call('t', { items: Array(60000).fill('x') });
+    assert.strictEqual(refused.isError, true);
+    const answered = await call('t', { items: Array(1000).fill('x') });
+    assert.ok(!answered.isError);
+    assert.strictEqual(answered.content[0].text, 'ok');
+});
+
+test('applies the limit to a tool registered without an input schema', async () => {
+    const { call } = await connect({ maxToolInputElements: 10 });
+    const result = await call('plain', { items: Array(20).fill('x') });
+    assert.strictEqual(result.isError, true);
+    assert.match(result.content[0].text, /more than the maximum/);
+});
+
+test('counts nested object members together with array elements', async () => {
+    const { call } = await connect({ maxToolInputElements: 5 });
+    // 1 member + 2 array elements + 2 object members = 5 (at limit)
+    const atLimit = await call('plain', { items: [{ a: 1 }, { b: 2 }] });
+    assert.ok(!atLimit.isError);
+    const pastLimit = await call('plain', { items: [{ a: 1 }, { b: 2, c: 3 }] });
+    assert.strictEqual(pastLimit.isError, true);
+});
+
+test('treats Infinity as no limit and rejects invalid limits at construction', () => {
+    assert.doesNotThrow(() => new McpServer({ name: 't', version: '1.0' }, { maxToolInputElements: Infinity }));
+    for (const bad of [Number.NaN, 0, 0.5, -1]) {
+        assert.throws(() => new McpServer({ name: 't', version: '1.0' }, { maxToolInputElements: bad }));
+    }
+});

