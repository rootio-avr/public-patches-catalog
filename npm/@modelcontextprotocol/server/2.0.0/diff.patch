+// Regression test for GHSA-f897-62hf-6gxq: HTTP request bodies are read with a
+// size limit (413) and JSON-RPC batches are bounded (400 / -32600).
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { createMcpHandler, McpServer, WebStandardStreamableHTTPServerTransport } from '../dist/index.mjs';
+
+const headers = { 'content-type': 'application/json', accept: 'application/json, text/event-stream' };
+
+const ping = id => ({ jsonrpc: '2.0', id, method: 'ping' });
+
+const post = (body, extra = {}) => new Request('http://localhost/mcp', { method: 'POST', headers: { ...headers, ...extra }, body });
+
+test('transport answers 413 for a body over maxRequestBodySize', async () => {
+    const transport = new WebStandardStreamableHTTPServerTransport({ sessionIdGenerator: undefined, maxRequestBodySize: 64 });
+    const response = await transport.handleRequest(post(JSON.stringify({ ...ping(1), padding: 'x'.repeat(1000) })));
+    assert.equal(response.status, 413);
+    const body = await response.json();
+    assert.equal(body.error.code, -32_000);
+});
+
+test('transport refuses an oversized streamed body that declares no Content-Length', async () => {
+    const transport = new WebStandardStreamableHTTPServerTransport({ sessionIdGenerator: undefined, maxRequestBodySize: 64 });
+    const stream = new ReadableStream({
+        pull(controller) {
+            controller.enqueue(new TextEncoder().encode('x'.repeat(40)));
+        }
+    });
+    const request = new Request('http://localhost/mcp', { method: 'POST', headers, body: stream, duplex: 'half' });
+    const response = await transport.handleRequest(request);
+    assert.equal(response.status, 413);
+});
+
+test('transport rejects a JSON-RPC batch of more than 100 messages', async () => {
+    const transport = new WebStandardStreamableHTTPServerTransport({ sessionIdGenerator: undefined });
+    const batch = Array.from({ length: 101 }, (_, i) => ping(i + 1));
+    const response = await transport.handleRequest(post(JSON.stringify(batch)));
+    assert.equal(response.status, 400);
+    const body = await response.json();
+    assert.equal(body.error.code, -32_600);
+});
+
+test('transport rejects an oversized batch passed as parsedBody', async () => {
+    const transport = new WebStandardStreamableHTTPServerTransport({ sessionIdGenerator: undefined });
+    const batch = Array.from({ length: 101 }, (_, i) => ping(i + 1));
+    const response = await transport.handleRequest(post('[]'), { parsedBody: batch });
+    assert.equal(response.status, 400);
+});
+
+test('transport still parses a normal body under the limit', async () => {
+    const transport = new WebStandardStreamableHTTPServerTransport({ sessionIdGenerator: undefined, maxRequestBodySize: 4096 });
+    const response = await transport.handleRequest(post('not json'));
+    assert.equal(response.status, 400);
+    assert.equal((await response.json()).error.code, -32_700);
+});
+
+test('createMcpHandler answers 413 before building any server for an oversized body', async () => {
+    let created = 0;
+    const handler = createMcpHandler(
+        () => {
+            created++;
+            return new McpServer({ name: 'test', version: '1.0.0' });
+        },
+        { maxRequestBodySize: 64 }
+    );
+    const response = await handler.fetch(post(JSON.stringify({ ...ping(1), padding: 'x'.repeat(1000) })));
+    assert.equal(response.status, 413);
+    assert.equal(created, 0);
+    await handler.close();
+});
+
+test('createMcpHandler rejects a non-positive maxRequestBodySize at construction', () => {
+    assert.throws(() => createMcpHandler(() => new McpServer({ name: 'test', version: '1.0.0' }), { maxRequestBodySize: 0 }), RangeError);
+});
