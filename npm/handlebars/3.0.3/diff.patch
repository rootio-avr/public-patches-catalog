+describe('CVE-2026-106446: AST validation in the compiler', function() {
+  if (!Handlebars.compile) {
+    return;
+  }
+
+  function mustache(path, params, hash) {
+    return {
+      type: 'Program',
+      body: [{
+        type: 'MustacheStatement',
+        escaped: true,
+        strip: {open: false, close: false},
+        path: path,
+        params: params || [],
+        hash: hash
+      }]
+    };
+  }
+
+  function pathNode(depth, parts) {
+    return {type: 'PathExpression', data: false, depth: depth, parts: parts, original: 'this'};
+  }
+
+  function shouldReject(ast, message, options) {
+    shouldThrow(function() {
+      Handlebars.compile(ast, options)();
+    }, Error, message);
+  }
+
+  it('should treat a missing PathExpression depth as 0', function() {
+    equal(Handlebars.compile(mustache(pathNode(undefined, ['name'])))({name: 'ok'}), 'ok');
+  });
+
+  it('should reject non-integer, negative and fractional depths', function() {
+    var message = 'Invalid AST: PathExpression depth must be a non-negative integer';
+    shouldReject(mustache(pathNode('0', ['this'])), message);
+    shouldReject(mustache(pathNode(-1, ['this'])), message);
+    shouldReject(mustache(pathNode(0.5, ['this'])), message);
+  });
+
+  it('should reject non-array PathExpression parts', function() {
+    shouldReject(mustache(pathNode(0, 'this')), 'Invalid AST: PathExpression parts must be an array');
+  });
+
+  it('should reject non-string PathExpression parts', function() {
+    shouldReject(mustache(pathNode(0, [{}])), 'Invalid AST: PathExpression parts must only contain strings');
+  });
+
+  it('should reject invalid parts of params in trackIds mode', function() {
+    var ast = mustache(pathNode(0, ['helper']), [pathNode(0, 'abc')]);
+    shouldReject(ast, 'Invalid AST: PathExpression parts must be an array', {trackIds: true});
+  });
+
+  it('should reject literals whose value has the wrong type', function() {
+    var payload = '1);process.exit(1);(';
+    shouldReject(mustache(pathNode(0, ['helper']), [{type: 'NumberLiteral', value: payload, original: 1}]),
+      'Invalid AST: NumberLiteral value must be a number');
+    shouldReject(mustache(pathNode(0, ['helper']), [{type: 'BooleanLiteral', value: payload, original: true}]),
+      'Invalid AST: BooleanLiteral value must be a boolean');
+    shouldReject(mustache(pathNode(0, ['helper']), [{type: 'StringLiteral', value: {}, original: 'x'}]),
+      'Invalid AST: StringLiteral value must be a string');
+  });
+
+  it('should reject wrongly typed literals in stringParams mode', function() {
+    var ast = mustache(pathNode(0, ['helper']), [{type: 'NumberLiteral', value: '1);process.exit(1);(', original: 1}]);
+    shouldReject(ast, 'Invalid AST: NumberLiteral value must be a number', {stringParams: true});
+  });
+
+  it('should reject non-string ContentStatement values', function() {
+    shouldReject({type: 'Program', body: [{type: 'ContentStatement', value: {}, original: 'x'}]},
+      'Invalid AST: ContentStatement value must be a string');
+  });
+
+  it('should reject invalid hash pairs', function() {
+    shouldReject(mustache(pathNode(0, ['helper']), [], {type: 'Hash', pairs: 'x'}),
+      'Invalid AST: Hash pairs must be an array');
+    shouldReject(mustache(pathNode(0, ['helper']), [], {type: 'Hash', pairs: [{type: 'HashPair', key: {}, value: pathNode(0, ['a'])}]}),
+      'Invalid AST: Hash pair keys must be strings');
+  });
+
+  it('should reject invalid Program blockParams', function() {
+    var ast = mustache(pathNode(0, ['name']));
+    ast.blockParams = 'abc';
+    shouldReject(ast, 'Invalid AST: Program blockParams must be an array');
+    ast.blockParams = [1];
+    shouldReject(ast, 'Invalid AST: Program blockParams must only contain strings');
+  });
+
+  it('should still compile valid parsed templates', function() {
+    var ast = Handlebars.parse('{{#each items as |item|}}{{item}}{{helper 1 true "s" k=2}}{{/each}}');
+    var template = Handlebars.compile(ast, {trackIds: true});
+    equal(template({items: ['a', 'b']}, {helpers: {helper: function() { return '.'; }}}), 'a.b.');
+  });
+});
