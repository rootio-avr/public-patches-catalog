+/*
+ * Regression test for CVE-2026-44705 / GHSA-ph9p-34f9-6g65.
+ *
+ * A malicious `prefix` or `postfix` option containing relative path
+ * components ("..") could be used to escape the intended tmp directory.
+ * The fix rejects any prefix/postfix value that contains "..".
+ *
+ * Grounded on the upstream test added in node-tmp commit 7ef2728
+ * (test/GHSA-ph9p-34f9-6g65-test.js). Written as a self-executing
+ * node:assert script so it runs regardless of the configured mocha UI.
+ */
+const assert = require('assert');
+const tmp = require('../lib/tmp');
+
+// attacker-controlled prefix must be rejected
+assert.throws(function () {
+  tmp.fileSync({ prefix: '../foo' });
+}, /^Error: Relative value not allowed/, 'prefix containing ".." must be rejected');
+
+// attacker-controlled postfix must be rejected
+assert.throws(function () {
+  tmp.fileSync({ postfix: '../foo' });
+}, /^Error: Relative value not allowed/, 'postfix containing ".." must be rejected');
+
+// a benign prefix/postfix must still be accepted and cleaned up
+const f = tmp.fileSync({ prefix: 'safe-prefix', postfix: 'safe-postfix' });
+assert.ok(f.name.indexOf('safe-prefix') !== -1, 'benign prefix should be honoured');
+assert.ok(f.name.indexOf('safe-postfix') !== -1, 'benign postfix should be honoured');
+f.removeCallback();
+
+console.log('GHSA-ph9p-34f9-6g65 regression test passed');
