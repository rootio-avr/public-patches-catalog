 /**
+ * Checks the prefix and postfix options for relative path components.
+ *
+ * A value containing '..' could be used to escape the intended tmp directory,
+ * so we reject it outright.
+ *
+ * @param {string} value
+ * @returns {string} the unchanged value if it is valid
+ * @throws {Error} if the value contains a relative path component
+ * @private
+ */
+function _assertPath(value) {
+  if (value.includes('..')) {
+    throw new Error('Relative value not allowed');
+  }
+
+  return value;
+}
