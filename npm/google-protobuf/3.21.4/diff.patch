+++ b/test/cve-2026-89418.test.js
@@ -0,0 +1,61 @@
+/**
+ * Regression test for CVE-2026-89418 (GHSA-5h29-r2cp-hfmr).
+ *
+ * The google-protobuf BinaryReader recursed without bound while decoding
+ * nested groups / submessages, so a maliciously deeply nested message could
+ * overflow the JS stack (uncaught RangeError -> DoS). The fix enforces the
+ * standard protobuf deserialization depth limit (200) and reports overruns as
+ * a SyntaxError instead of an uncaught RangeError.
+ *
+ * Exercises the shipped bundle (google-protobuf.js) the same way the package is
+ * consumed. Uses node:assert so it is runnable without extra dev deps.
+ */
+'use strict';
+const assert = require('assert');
+const jspb = require('../google-protobuf.js');
+const {BinaryWriter, BinaryReader} = jspb;
+
+function writeNestedGroups(writer, depth) {
+  if (depth <= 0) return;
+  writer.writeGroup(1, {}, () => writeNestedGroups(writer, depth - 1));
+}
+
+// 1. Nesting within the limit deserializes without throwing.
+(function testWithinLimitSucceeds() {
+  const writer = new BinaryWriter();
+  writeNestedGroups(writer, 200);
+  const reader = BinaryReader.alloc(writer.getResultBuffer());
+  assert.strictEqual(reader.nextField(), true);
+  assert.doesNotThrow(() => reader.skipGroup());
+  reader.free();
+})();
+
+// 2. Nesting past the limit throws a SyntaxError, not an uncaught RangeError.
+(function testOverLimitThrowsSyntaxError() {
+  const writer = new BinaryWriter();
+  writeNestedGroups(writer, 201);
+  const reader = BinaryReader.alloc(writer.getResultBuffer());
+  assert.strictEqual(reader.nextField(), true);
+  assert.throws(
+      () => reader.skipGroup(),
+      (err) => err instanceof SyntaxError &&
+          /Maximum protobuf recursion depth exceeded/.test(err.message));
+  reader.free();
+})();
+
+// 3. A RangeError raised inside readMessage is swapped to a SyntaxError.
+(function testReadMessageSwapsRangeError() {
+  const writer = new BinaryWriter();
+  writer.writeMessage(1, {}, () => {});
+  const reader = BinaryReader.alloc(writer.getResultBuffer());
+  assert.strictEqual(reader.nextField(), true);
+  assert.throws(
+      () => reader.readMessage({}, () => {
+        throw new RangeError('Maximum call stack size exceeded');
+      }),
+      (err) => err instanceof SyntaxError &&
+          /Maximum protobuf recursion depth exceeded/.test(err.message));
+  reader.free();
+})();
+
+console.log('CVE-2026-89418 regression tests passed');
