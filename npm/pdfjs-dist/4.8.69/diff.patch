+// Regression test for AIKIDO-2026-169371 (GHSA-wxrh-xgw3-3wqf and related).
+//
+// pdfjs-dist ships pre-bundled ESM (build/pdf*.mjs), not source, and does not
+// export the internal helpers touched by the fix (serializeFontFamily,
+// normalizeCSSFontFamily, validateFontName, XMLParserBase._resolveEntities,
+// parseXFAPath). This guards the shipped bundles against regressing the fixed
+// behavior: CSS font-family injection, catastrophic backtracking / ReDoS in
+// the XFA path and XML entity scanners, and throwing on invalid char refs.
+import assert from "node:assert";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const bundles = [
+  "../build/pdf.worker.mjs",
+  "../legacy/build/pdf.worker.mjs",
+].map(rel => fileURLToPath(new URL(rel, import.meta.url)));
+
+const displayBundles = [
+  "../build/pdf.mjs",
+  "../legacy/build/pdf.mjs",
+].map(rel => fileURLToPath(new URL(rel, import.meta.url)));
+
+for (const file of bundles) {
+  const src = readFileSync(file, "utf8");
+
+  // parseXFAPath: the position pattern must be anchored to avoid quadratic
+  // retrying at every character of a long component.
+  assert.ok(
+    src.includes("const positionPattern = /^(.+)\\[(\\d+)\\]$/;"),
+    `${file}: parseXFAPath position pattern is not anchored`
+  );
+  assert.ok(
+    !src.includes("const positionPattern = /(.+)\\[(\\d+)\\]$/;"),
+    `${file}: unanchored parseXFAPath position pattern still present`
+  );
+
+  // XML entity scanner must exclude "&" from entity names, keeping it linear,
+  // and must not throw on out-of-range / unparsable character references.
+  assert.ok(
+    src.includes("s.replaceAll(/&([^;&]+);/g"),
+    `${file}: XML entity regex does not exclude '&'`
+  );
+  assert.ok(
+    !src.includes("s.replaceAll(/&([^;]+);/g"),
+    `${file}: unbounded XML entity regex still present`
+  );
+  assert.ok(
+    src.includes("code >= 0 && code <= 0x10ffff"),
+    `${file}: invalid character reference is not range-checked`
+  );
+
+  // Font family must be serialized as a safe CSS <string>, not blindly quoted.
+  assert.ok(
+    src.includes("function serializeFontFamily("),
+    `${file}: serializeFontFamily helper is missing`
+  );
+  assert.ok(
+    src.includes("style.fontFamily = serializeFontFamily(name);"),
+    `${file}: XFA setFontFamily does not use serializeFontFamily`
+  );
+  assert.ok(
+    !src.includes("style.fontFamily = `\"${name}\"`;"),
+    `${file}: XFA setFontFamily still interpolates the raw typeface`
+  );
+
+  // Control characters in a quoted font family must be rejected.
+  assert.ok(
+    src.includes("FontFamily contains control characters:"),
+    `${file}: validateFontName does not reject control characters`
+  );
+
+  // normalizeCSSFontFamily must collapse spaces without backtracking (ReDoS).
+  assert.ok(
+    src.includes("function normalizeCSSFontFamily("),
+    `${file}: normalizeCSSFontFamily helper is missing`
+  );
+  assert.ok(
+    !src.includes('fontFamily.replaceAll(/[ ]+(\\d)/g, "$1")'),
+    `${file}: old space-stripping regex still present`
+  );
+}
+
+for (const file of displayBundles) {
+  const src = readFileSync(file, "utf8");
+
+  // @font-face rule and native FontFace must serialize the family safely to
+  // prevent arbitrary CSS rule injection from a hostile document.
+  assert.ok(
+    src.includes("function serializeFontFamily("),
+    `${file}: serializeFontFamily helper is missing`
+  );
+  assert.ok(
+    src.includes(
+      "new FontFace(serializeFontFamily(this.cssFontInfo.fontFamily), this.data, css)"
+    ),
+    `${file}: createNativeFontFace does not serialize the font family`
+  );
+  assert.ok(
+    src.includes("`@font-face {font-family:${fontFamily};${css}src:${url}}`"),
+    `${file}: createFontFaceRule does not use the serialized font family`
+  );
+  assert.ok(
+    !src.includes(
+      '`@font-face {font-family:"${this.cssFontInfo.fontFamily}";${css}src:${url}}`'
+    ),
+    `${file}: createFontFaceRule still interpolates the raw font family`
+  );
+}
+
+console.log("AIKIDO-2026-169371 regression checks passed");
