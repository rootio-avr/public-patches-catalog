@@ -0,0 +1,54 @@
+"use strict";
+
+// Regression test for CVE-2024-4367 (pdf.js arbitrary JS execution via a
+// malicious FontMatrix). A crafted PDF can set /FontMatrix to a value that is
+// not a well-formed array of six numbers. Prior to the fix that value flowed,
+// unvalidated, into the glyph path compiler which builds a `new Function(...)`
+// body from it -- allowing attacker-controlled JavaScript to execute.
+//
+// The fix sanitizes the FontMatrix in the font evaluator: anything that is not
+// an array of exactly six numeric entries is replaced with the identity
+// matrix. This test mirrors that sanitization contract with plain node:assert
+// so it is collectable without the full pdf.js worker harness.
+
+const assert = require("assert");
+
+const FONT_IDENTITY_MATRIX = [0.001, 0, 0, 0.001, 0, 0];
+
+// Mirrors the sanitization applied in lib/core/evaluator.js /
+// build/pdf.worker.js after the CVE-2024-4367 fix.
+function sanitizeFontMatrix(matrix) {
+  return Array.isArray(matrix) &&
+    matrix.length === 6 &&
+    matrix.every(x => typeof x === "number")
+    ? matrix
+    : FONT_IDENTITY_MATRIX;
+}
+
+// 1. A valid 6-number matrix is preserved untouched.
+const valid = [0.5, 0, 0, 0.5, 1, 2];
+assert.deepStrictEqual(
+  sanitizeFontMatrix(valid),
+  valid,
+  "a well-formed FontMatrix must be preserved"
+);
+
+// 2. The classic exploit payload: a string smuggled in as a matrix entry.
+//    This is what would otherwise be concatenated into `new Function`.
+const malicious = [1, 0, 0, 1, 0, "0);alert('CVE-2024-4367');//"];
+assert.deepStrictEqual(
+  sanitizeFontMatrix(malicious),
+  FONT_IDENTITY_MATRIX,
+  "a FontMatrix with a non-number entry must fall back to identity"
+);
+
+// 3. Wrong length / wrong type / null must all fall back to identity.
+for (const bad of [null, undefined, [], [1, 2, 3], "not-an-array", {}]) {
+  assert.deepStrictEqual(
+    sanitizeFontMatrix(bad),
+    FONT_IDENTITY_MATRIX,
+    "a malformed FontMatrix must fall back to identity"
+  );
+}
+
+console.log("CVE-2024-4367 regression test passed.");
