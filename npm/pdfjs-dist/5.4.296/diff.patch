+
+// Regression test for AIKIDO-2026-169371 (pdf.js ReDoS + CSS font-family
+// injection hardening; upstream PRs #21680/#21682/#21686/#21692/#21693/#21694
+// /#21699). pdfjs-dist ships pre-bundled distributables only, and the hardened
+// helpers are internal (not part of the public export surface), so this test
+// (a) asserts the hardened code is present in every shipped bundle, and
+// (b) exercises the serialization / regex logic directly, mirroring the
+// upstream test/unit/font_loader_spec.js and core_utils_spec.js assertions.
+
+import assert from "node:assert";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const pkgRoot = fileURLToPath(new URL("../", import.meta.url));
+const read = rel => readFileSync(pkgRoot + rel, "utf8");
+
+const WORKER_BUNDLES = ["build/pdf.worker.mjs", "legacy/build/pdf.worker.mjs"];
+const MAIN_BUNDLES = ["build/pdf.mjs", "legacy/build/pdf.mjs"];
+const VIEWER_BUNDLES = ["web/pdf_viewer.mjs", "legacy/web/pdf_viewer.mjs"];
+
+// --- 1. Static assertions: the vulnerable patterns are gone from the bundles.
+
+for (const f of WORKER_BUNDLES) {
+  const src = read(f);
+  // #21686: the XFA position regex must be anchored (no leading `.+` scan).
+  assert.ok(
+    src.includes("const positionPattern = /^(.+)\\[(\\d+)\\]$/;"),
+    `${f}: parseXFAPath regex must be anchored`
+  );
+  assert.ok(
+    !src.includes("const positionPattern = /(.+)\\[(\\d+)\\]$/;"),
+    `${f}: unanchored parseXFAPath regex must be removed`
+  );
+  // #21692: XML entity names must exclude '&' to keep the scan linear.
+  assert.ok(
+    src.includes("s.replaceAll(/&([^;&]+);/g"),
+    `${f}: XML entity regex must exclude '&'`
+  );
+  assert.ok(
+    !src.includes("s.replaceAll(/&([^;]+);/g"),
+    `${f}: old XML entity regex must be removed`
+  );
+  // #21694: font-family serialization + control-char rejection are present.
+  assert.ok(
+    src.includes("function serializeFontFamily("),
+    `${f}: serializeFontFamily helper must be present`
+  );
+  assert.ok(
+    src.includes("CONTROL_CHAR_REGEXP"),
+    `${f}: control-character guard must be present`
+  );
+}
+
+for (const f of MAIN_BUNDLES) {
+  const src = read(f);
+  // #21694: @font-face rule interpolates a serialized <string>, not a raw one.
+  assert.ok(
+    src.includes("function serializeFontFamily("),
+    `${f}: serializeFontFamily helper must be present`
+  );
+  assert.ok(
+    !src.includes('font-family:"${this.cssFontInfo.fontFamily}"'),
+    `${f}: raw font-family interpolation must be removed`
+  );
+}
+
+for (const f of VIEWER_BUNDLES) {
+  const src = read(f);
+  // #21693: the autolinker email parts must be length-bounded ({1,64}/{1,63}).
+  assert.ok(
+    /\{1,64\}@/.test(src),
+    `${f}: autolinker local part must be bounded to 64 chars`
+  );
+  assert.ok(
+    /\{1,63\}/.test(src),
+    `${f}: autolinker domain labels must be bounded to 63 chars`
+  );
+}
+
+// --- 2. Behavioral assertions: reproduce the hardened helpers and verify them.
+
+const CONTROL_CHAR_REGEXP = /\p{Cc}/u;
+function isCSSString(str) {
+  const quote = str[0];
+  if (str.length < 2 || (quote !== `"` && quote !== `'`) || str.at(-1) !== quote) {
+    return false;
+  }
+  const end = str.length - 1;
+  for (let i = 1; i < end; i++) {
+    const char = str[i];
+    if (char === quote || CONTROL_CHAR_REGEXP.test(char)) {
+      return false;
+    }
+    if (char === "\\") {
+      if (++i >= end || CONTROL_CHAR_REGEXP.test(str[i])) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+function serializeFontFamily(fontFamily) {
+  if (isCSSString(fontFamily)) {
+    return fontFamily;
+  }
+  const escaped = fontFamily.replaceAll(/["\\\p{Cc}]/gu, char =>
+    char === `"` || char === "\\"
+      ? `\\${char}`
+      : `\\${char.codePointAt(0).toString(16)} `
+  );
+  return `"${escaped}"`;
+}
+function normalizeCSSFontFamily(fontFamily) {
+  return fontFamily.replaceAll(/( +)(\d)?/g, (_, spaces, digit) => digit ?? " ");
+}
+
+// A well-formed <string> is kept verbatim (GHSA-wxrh-xgw3-3wqf).
+const wellFormed = `"};body{background-image:url(https://example.com/)};a{x:"`;
+assert.strictEqual(serializeFontFamily(wellFormed), wellFormed);
+
+// A non-<string> value is escaped so it cannot break out of the <string>.
+assert.strictEqual(
+  serializeFontFamily(String.raw`Foo"Bar\Baz`),
+  String.raw`"Foo\"Bar\\Baz"`
+);
+// A trailing backslash must not escape the closing quote.
+assert.strictEqual(
+  serializeFontFamily("Foo\\"),
+  String.raw`"Foo\\"`
+);
+// CSS line terminators are hex-escaped, never emitted verbatim.
+const ff = serializeFontFamily("safe\f}body{x:url(https://e/)}/*");
+assert.ok(!ff.includes("\f"));
+assert.strictEqual(ff, String.raw`"safe\c }body{x:url(https://e/)}/*"`);
+
+// normalizeCSSFontFamily strips spaces before digits, keeps other spaces.
+assert.strictEqual(normalizeCSSFontFamily("Wingdings   3"), "Wingdings3");
+assert.strictEqual(normalizeCSSFontFamily("Times New Roman"), "Times New Roman");
+
+// --- 3. Linear-time (ReDoS) guards: each must finish well under a second.
+
+function timed(fn) {
+  const start = performance.now();
+  fn();
+  return performance.now() - start;
+}
+assert.ok(
+  timed(() => normalizeCSSFontFamily("W" + " ".repeat(100000))) < 1000,
+  "normalizeCSSFontFamily must be linear in the number of spaces"
+);
+assert.ok(
+  timed(() => "a".repeat(200000).match(/^(.+)\[(\d+)\]$/)) < 1000,
+  "anchored XFA regex must be linear in the component length"
+);
+assert.ok(
+  timed(() => "&".repeat(100000).replaceAll(/&([^;&]+);/g, () => "")) < 1000,
+  "XML entity regex must be linear in the number of ampersands"
+);
+
+console.log("AIKIDO-2026-169371 regression test passed");
