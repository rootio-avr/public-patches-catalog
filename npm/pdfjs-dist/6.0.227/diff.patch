+++ b/test/cve-2026-16633.test.mjs
@@ -0,0 +1,215 @@
+// Regression test for CVE-2026-16633 (CWE-79): the XFA / rich-text layer must
+// only render a known allow-list of elements, attributes and CSS styles.
+//
+// Grounded on the upstream fix commit 6c18df5768a9cf12e725ebf12fc70e32358be1fa
+// ("Restrict the elements, attributes and styles the XFA layer can render"),
+// which added the equivalent assertions to test/unit/display_utils_spec.js.
+// The published pdfjs-dist npm package ships no test tree and no DOM, so this
+// self-contained variant installs a minimal DOM shim and exercises the shipped
+// build bundle directly. Run with: node test/cve-2026-16633.test.mjs
+//
+// SPDX-License-Identifier: Apache-2.0
+
+import assert from "node:assert";
+
+// --- Minimal DOM shim ------------------------------------------------------
+// Enough of the DOM surface for XfaLayer.render / renderRichText to run under
+// plain Node.js (the real code path runs in a browser).
+
+class FakeStyle {
+  setProperty() {}
+}
+
+class FakeClassList {
+  constructor() {
+    this._set = new Set();
+  }
+  add(...names) {
+    for (const n of names) {
+      if (n) {
+        this._set.add(n);
+      }
+    }
+  }
+  contains(n) {
+    return this._set.has(n);
+  }
+}
+
+class FakeNode {
+  constructor(name, namespaceURI = null) {
+    this.nodeName = name;
+    this.namespaceURI = namespaceURI;
+    this.localName = name;
+    this.childNodes = [];
+    this.attributes = new Map();
+    this.style = new FakeStyle();
+    this.classList = new FakeClassList();
+    this.parentNode = null;
+  }
+  get firstElementChild() {
+    return this.childNodes.find(c => c instanceof FakeNode) || null;
+  }
+  append(...nodes) {
+    for (const n of nodes) {
+      n.parentNode = this;
+      this.childNodes.push(n);
+    }
+  }
+  setAttribute(name, value) {
+    this.attributes.set(name, String(value));
+  }
+  removeAttribute(name) {
+    this.attributes.delete(name);
+  }
+  getAttribute(name) {
+    return this.attributes.has(name) ? this.attributes.get(name) : null;
+  }
+  hasAttribute(name) {
+    return this.attributes.has(name);
+  }
+  addEventListener() {}
+  querySelectorAll() {
+    return [];
+  }
+  // Walk descendants and return the first element whose lower-cased name
+  // matches the requested (element) selector.
+  querySelector(sel) {
+    const want = sel.toLowerCase();
+    const stack = [...this.childNodes];
+    while (stack.length) {
+      const n = stack.shift();
+      if (n instanceof FakeNode) {
+        if (n.nodeName.toLowerCase() === want) {
+          return n;
+        }
+        stack.unshift(...n.childNodes);
+      }
+    }
+    return null;
+  }
+  get textContent() {
+    let out = "";
+    for (const c of this.childNodes) {
+      out += c instanceof FakeText ? c.data : c.textContent;
+    }
+    return out;
+  }
+}
+
+class FakeText {
+  constructor(data) {
+    this.data = String(data);
+  }
+  get textContent() {
+    return this.data;
+  }
+}
+
+class FakeFragment extends FakeNode {
+  constructor() {
+    super("#document-fragment");
+  }
+}
+
+globalThis.document = {
+  createElement: name => new FakeNode(name),
+  createElementNS: (ns, name) => new FakeNode(name, ns),
+  createTextNode: data => new FakeText(data),
+  createDocumentFragment: () => new FakeFragment(),
+};
+globalThis.HTMLAnchorElement = class {};
+// The bundle evaluates a few browser globals at module-load time; stub the
+// ones needed just to import it under plain Node.js.
+globalThis.DOMMatrix ??= class DOMMatrix {};
+globalThis.Path2D ??= class Path2D {};
+
+// --- Load the shipped bundle ----------------------------------------------
+// Use the legacy build, which is the variant intended for Node.js environments.
+const { renderRichText } = await import("../legacy/build/pdf.mjs");
+
+let failures = 0;
+function test(desc, fn) {
+  try {
+    fn();
+    console.log(`ok - ${desc}`);
+  } catch (e) {
+    failures++;
+    console.error(`not ok - ${desc}\n  ${e && e.message}`);
+  }
+}
+
+// 1) Only supported rich-text elements are kept; disallowed ones are dropped.
+test("only keeps supported rich text elements", () => {
+  const container = new FakeNode("div");
+  const xfaHtml = {
+    name: "div",
+    children: [
+      { name: "p", value: "kept" },
+      { name: "section", children: [{ name: "span", value: "removed" }] },
+    ],
+  };
+  renderRichText({ html: xfaHtml, dir: "ltr", className: "foo" }, container);
+
+  assert.notStrictEqual(container.querySelector("p"), null, "p kept");
+  assert.strictEqual(container.querySelector("section"), null, "section dropped");
+  // The span only existed under the dropped <section>, so it must be gone too.
+  assert.strictEqual(container.querySelector("span"), null, "span dropped");
+});
+
+// 2) Only supported rich-text attributes are kept; event handlers / others go.
+test("only keeps supported rich text attributes", () => {
+  const container = new FakeNode("div");
+  const xfaHtml = {
+    name: "div",
+    children: [
+      {
+        name: "p",
+        attributes: {
+          class: ["bar"],
+          dir: "rtl",
+          title: "unsupported",
+          onclick: "alert(1)",
+        },
+        value: "text",
+      },
+    ],
+  };
+  renderRichText({ html: xfaHtml, dir: "ltr", className: "foo" }, container);
+  const p = container.querySelector("p");
+
+  assert.strictEqual(p.getAttribute("class"), "bar");
+  assert.strictEqual(p.getAttribute("dir"), "rtl");
+  assert.strictEqual(p.hasAttribute("title"), false, "unsupported attr dropped");
+  assert.strictEqual(
+    p.hasAttribute("onclick"),
+    false,
+    "event-handler attr dropped"
+  );
+});
+
+// 3) Only supported CSS style properties are applied.
+test("only applies supported rich text style properties", () => {
+  const container = new FakeNode("div");
+  const xfaHtml = {
+    name: "div",
+    children: [
+      {
+        name: "span",
+        attributes: { style: { color: "green", width: "100px" } },
+        value: "text",
+      },
+    ],
+  };
+  renderRichText({ html: xfaHtml, dir: "ltr", className: "foo" }, container);
+  const span = container.querySelector("span");
+  // color is in the allow-list; width is not.
+  assert.strictEqual(span.style.color, "green", "color applied");
+  assert.strictEqual(span.style.width, undefined, "width dropped");
+});
+
+if (failures > 0) {
+  console.error(`${failures} test(s) failed`);
+  process.exit(1);
+}
+console.log("All CVE-2026-16633 regression tests passed.");
