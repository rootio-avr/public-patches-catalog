+// Regression test for CVE-2026-27601 (underscore).
+//
+// Prior to the fix, both the internal `flatten` used by `_.flatten` and the
+// internal `eq` used by `_.isEqual` were recursive. Passing a sufficiently
+// deeply-nested array (to `_.flatten`) or two deeply-nested object graphs
+// (to `_.isEqual`) exhausted the JavaScript call stack and threw a
+// `RangeError: Maximum call stack size exceeded`, enabling a
+// denial-of-service. The fix reimplements both routines iteratively so that
+// deep structures are handled without unbounded recursion, while preserving
+// the original observable behavior.
+var assert = require('assert');
+var _ = require('../underscore');
+
+var failures = 0;
+function check(name, fn) {
+  try { fn(); console.log('ok - ' + name); }
+  catch (e) { failures++; console.error('not ok - ' + name + ': ' + (e && e.message)); }
+}
+
+// --- Behavior is preserved for ordinary inputs ---
+check('flatten deep-nests fully', function () {
+  assert.deepEqual(_.flatten([1, [2], [3, [[4]]]]), [1, 2, 3, 4]);
+});
+check('flatten shallow unwraps one level', function () {
+  assert.deepEqual(_.flatten([1, [2], [3, [[4]]]], true), [1, 2, 3, [[4]]]);
+});
+check('isEqual true for equal nested structures', function () {
+  assert.ok(_.isEqual({ a: 1, b: [1, 2, { c: 3 }] }, { a: 1, b: [1, 2, { c: 3 }] }));
+});
+check('isEqual false for differing structures', function () {
+  assert.ok(!_.isEqual({ a: 1, b: [1, 2, { c: 3 }] }, { a: 1, b: [1, 2, { c: 4 }] }));
+});
+check('isEqual handles cyclic structures', function () {
+  var a = {}; a.self = a;
+  var b = {}; b.self = b;
+  assert.ok(_.isEqual(a, b));
+});
+
+// --- Core regression: deep input must not overflow the stack ---
+check('flatten does not overflow on deeply nested arrays', function () {
+  var deep = 1;
+  for (var i = 0; i < 300000; i++) deep = [deep];
+  assert.deepEqual(_.flatten(deep), [1]);
+});
+check('isEqual does not overflow on deeply nested objects', function () {
+  function makeDeep() {
+    var root = { v: 1 }, cur = root;
+    for (var i = 0; i < 200000; i++) { cur.n = { v: 1 }; cur = cur.n; }
+    return root;
+  }
+  assert.ok(_.isEqual(makeDeep(), makeDeep()));
+});
+
+if (failures) {
+  console.error(failures + ' assertion(s) failed');
+  process.exit(1);
+}
+console.log('CVE-2026-27601 regression test passed');
