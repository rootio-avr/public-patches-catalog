@@ -0,0 +1,49 @@
+(function() {
+  var _ = typeof require == 'function' ? require('..') : window._;
+
+  QUnit.module('CVE-2026-27601');
+
+  // Regression tests for CVE-2026-27601: recursive `flatten` and `_.isEqual`
+  // could be driven into a stack overflow (DoS) by deeply nested input. The
+  // fix makes both operations non-recursive (trampolined on an explicit
+  // stack). Grounded on the upstream regression assertions added alongside the
+  // fix in test/arrays.js and test/objects.js.
+
+  QUnit.test('flatten handles extremely deeply nested arrays', function(assert) {
+    // Deeply wrapped array of values.
+    var x = _.range(100000);
+    for (var i = 0; i < 1000; i++) x = [x];
+    assert.deepEqual(_.flatten(x), _.range(100000), 'can handle very deep arrays');
+    assert.deepEqual(_.flatten(x, true), x[0], 'can handle very deep arrays in shallow mode');
+
+    var y = [1, 2, 3];
+    for (var j = 0; j < 100000; ++j) y = [y];
+    assert.deepEqual(_.flatten(y), [1, 2, 3], 'can handle extremely deeply nested arrays');
+
+    // Preserve normal shallow/deep/strict/depth semantics.
+    var list = [1, [2], [[3]], [[[4]]]];
+    assert.deepEqual(_.flatten(list), [1, 2, 3, 4], 'fully flattens by default');
+    assert.deepEqual(_.flatten(list, 2), [1, 2, 3, [4]], 'can flatten arrays to a given depth');
+    assert.deepEqual(_.flatten(list, 0), list, 'can flatten arrays to depth of 0');
+    assert.deepEqual(_.flatten([1, [2], 3], true), [1, 2, 3], 'shallow flatten');
+  });
+
+  QUnit.test('isEqual handles extremely deeply nested objects', function(assert) {
+    var a = 'v', b = 'v';
+    for (var i = 0; i < 30000; ++i) {
+      a = {x: a};
+      b = {x: b};
+    }
+    assert.ok(_.isEqual(a, b), 'Very deeply nested objects can be equal');
+    b = {x: b};
+    assert.ok(!_.isEqual(a, b), 'Very deeply nested objects can be different');
+    assert.ok(!_.isEqual(b, a), 'Commutative equality is implemented for very deeply nested objects');
+
+    // Preserve normal equality semantics.
+    assert.ok(_.isEqual({a: 1, b: [1, 2]}, {a: 1, b: [1, 2]}), 'nested structures compare equal');
+    assert.ok(!_.isEqual({a: 1, b: 2}, {a: 1}), 'objects of different sizes are not equal');
+    assert.ok(_.isEqual(NaN, NaN), 'NaN is equal to NaN');
+    assert.ok(!_.isEqual(0, -0), '0 is not equal to -0');
+  });
+
+}());
