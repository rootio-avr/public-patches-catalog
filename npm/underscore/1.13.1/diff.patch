+// Regression test for CVE-2026-27601 (CWE-674 uncontrolled recursion / stack
+// overflow DoS) in `_.flatten` and `_.isEqual`.
+//
+// Grounded on the upstream regression tests added alongside the fix:
+//   - test/arrays.js  "can handle extremely deeply nested arrays"
+//   - test/objects.js "Very deeply nested objects ..." (CVE-2026-27601)
+//
+// Before the fix these helpers recursed once per nesting level and threw
+// `RangeError: Maximum call stack size exceeded` on deeply nested input. The
+// fix makes both helpers iterative, so the calls below must complete and
+// return the expected results.
+
+var assert = require('assert');
+var _ = require('../underscore-umd.js');
+
+// --- _.flatten: extremely deeply nested arrays must not overflow the stack ---
+var y = [1, 2, 3];
+for (var i = 0; i < 100000; ++i) y = [y];
+assert.deepEqual(_.flatten(y), [1, 2, 3], 'can handle extremely deeply nested arrays');
+
+// Ordinary flatten behavior must be preserved.
+assert.deepEqual(_.flatten([1, [2], [3, [[4]]]]), [1, 2, 3, 4], 'deep flatten still works');
+assert.deepEqual(_.flatten([1, [2], [3, [[4]]]], true), [1, 2, 3, [[4]]], 'shallow flatten still works');
+
+// --- _.isEqual: extremely deeply nested objects must not overflow the stack ---
+var a, b;
+a = b = 'v';
+for (var j = 0; j < 30000; ++j) {
+  a = {x: a};
+  b = {x: b};
+}
+assert.ok(_.isEqual(a, b), 'Very deeply nested objects can be equal');
+b = {x: b};
+assert.ok(!_.isEqual(a, b), 'Very deeply nested objects can be different');
+assert.ok(!_.isEqual(b, a), 'Commutative equality is implemented for very deeply nested objects');
+
+// Ordinary isEqual behavior must be preserved.
+assert.ok(_.isEqual({a: 1, b: [1, 2]}, {a: 1, b: [1, 2]}), 'equal nested structures compare equal');
+assert.ok(!_.isEqual({a: 1}, {a: 2}), 'differing structures compare unequal');
+assert.ok(_.isEqual(NaN, NaN), 'NaN is equal to NaN');
+assert.ok(!_.isEqual(0, -0), '0 and -0 are not equal');
+
+console.log('CVE-2026-27601 regression test passed.');
