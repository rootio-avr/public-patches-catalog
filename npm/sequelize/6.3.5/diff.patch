+      if (char !== '$') {
+        continue;
+      }
+
+      const remainingString = sqlString.slice(i, sqlString.length);
+
+      const dollarStringStartMatch = remainingString.match(/^\$(?<name>[a-z_][0-9a-z_]*)?\$/i);
+      const tagName = dollarStringStartMatch && dollarStringStartMatch.groups.name;
+      if (dollarStringStartMatch && (currentDollarStringTagName === (tagName || ''))) {
+        currentDollarStringTagName = null;
+        // skip the rest of the closing tag
+        i += dollarStringStartMatch[0].length - 1;
+      }
+
+      continue;
+    }
+
+    if (isSingleLineComment) {
+      if (char === '\n') {
+        isSingleLineComment = false;
+      }
+
+      continue;
+    }
+
+    if (isCommentBlock) {
+      if (char === '*' && sqlString[i + 1] === '/') {
+        isCommentBlock = false;
+      }
+
+      continue;
+    }
+
+    if (char === dialect.TICK_CHAR_LEFT) {
+      isColumn = true;
+      continue;
+    }
+
+    if (char === '\'') {
+      isString = true;
+      continue;
+    }
+
+    if (char === '-' && sqlString.slice(i, i + 3) === '-- ') {
+      isSingleLineComment = true;
+      continue;
+    }
+
