+suite(Support.getTestDialectTeaser('SQL'), () => {
+  suite('QueryGenerator#getWhereConditions', () => {
+    const queryGenerator = current.dialect.QueryGenerator;
+
+    test('throws if called with invalid arguments', () => {
+      const User = current.define('User');
+
+      expect(() => {
+        queryGenerator.getWhereConditions(new Date(), User.getTableName(), User);
+      }).to.throw('Unsupported where option value');
+
+      expect(() => {
+        queryGenerator.getWhereConditions(true, User.getTableName(), User);
+      }).to.throw('Unsupported where option value');
+    });
+  });
+});
