--- /dev/null
+++ b/test/cve-2026-69240.test.js
@@ -0,0 +1,32 @@
+'use strict';
+
+// Regression test for CVE-2026-69240 (GHSA-v8fg-2rw7-q452).
+// Upstream, escape() returned strings starting with TO_DATE / TO_TIMESTAMP
+// verbatim for the Oracle dialect, allowing SQL injection. This version ships
+// no Oracle dialect; verify that escape() never passes such strings through
+// unescaped for any supported dialect.
+const assert = require('node:assert');
+const { escape } = require('../lib/sql-string');
+
+const payload = "TO_DATE('0','Y')||'' OR 1=1--";
+const tsPayload = "TO_TIMESTAMP_TZ('0','Y')||'' OR 1=1--";
+
+const expected = {
+  postgres: (s) => `'${s.replace(/'/g, "''")}'`,
+  sqlite: (s) => `'${s.replace(/'/g, "''")}'`,
+  mysql: (s) => `'${s.replace(/'/g, "\\'")}'`,
+  mariadb: (s) => `'${s.replace(/'/g, "\\'")}'`,
+};
+
+for (const [dialect, fn] of Object.entries(expected)) {
+  for (const value of [payload, tsPayload]) {
+    assert.strictEqual(escape(value, 'UTC', dialect), fn(value), `${dialect}: ${value} must be quoted and escaped`);
+  }
+}
+
+// An unknown dialect (e.g. oracle) must not pass the payload through verbatim.
+assert.notStrictEqual(escape(payload, 'UTC', 'oracle'), payload);
+
+// Normal input still works.
+assert.strictEqual(escape('hello', 'UTC', 'postgres'), "'hello'");
+console.log('cve-2026-69240 regression test passed');
