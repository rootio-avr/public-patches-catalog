+'use strict';
+
+const { expect } = require('chai');
+const Support = require('../support');
+const { injectReplacements } = require('../../../lib/utils/sql');
+
+const dialect = Support.sequelize.dialect;
+const L = dialect.TICK_CHAR_LEFT;
+const R = dialect.TICK_CHAR_RIGHT;
+
+describe('injectReplacements (named replacements)', () => {
+  it('does not replace named replacements inside strings or quoted identifiers', () => {
+    const sql = injectReplacements(`SELECT ${L}:id${R} FROM users WHERE id = ':id' OR id = :id OR id = ''':id'''`, dialect, { id: 1 });
+    expect(sql).to.equal(`SELECT ${L}:id${R} FROM users WHERE id = ':id' OR id = 1 OR id = ''':id'''`);
+  });
+
+  it('does not allow a replacement value to be re-interpreted as a replacement', () => {
+    const sql = injectReplacements('SELECT :a AS a, :b AS b', dialect, { a: ':b', b: 2 });
+    expect(sql).to.equal('SELECT \':b\' AS a, 2 AS b');
+  });
+
+  it('throws if a named replacement is not provided as an own property', () => {
+    expect(() => injectReplacements('SELECT * FROM users WHERE id = :toString', dialect, { id: 1 }))
+      .to.throw('Named replacement ":toString" has no entry in the replacement map.');
+  });
+
+  it('throws if replacements is neither an array nor a plain object', () => {
+    expect(() => injectReplacements('SELECT :a', dialect, 2))
+      .to.throw('"replacements" must be an array or a plain object, but received 2 instead.');
+  });
+
+  it('parses named replacements followed by cast syntax', () => {
+    expect(injectReplacements('SELECT * FROM users WHERE id = :id::string', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = 1::string');
+  });
+
+  it('only considers tokens following "(", ",", "=" or whitespace to be replacements', () => {
+    expect(injectReplacements('SELECT * FROM users WHERE id = fn(:id) OR id = fn(\'a\',:id) OR id=:id OR id = :id', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = fn(1) OR id = fn(\'a\',1) OR id=1 OR id = 1');
+  });
+
+  it('does not replace inside $ quoted strings', () => {
+    expect(injectReplacements('SELECT * FROM users WHERE id = $tag$ :id $tag$ OR id = $$ :id $$', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = $tag$ :id $tag$ OR id = $$ :id $$');
+    expect(injectReplacements('SELECT * FROM users WHERE id = $tag1$ $tag2$ :id $tag2$ $tag1$', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = $tag1$ $tag2$ :id $tag2$ $tag1$');
+  });
+
+  it('replaces between identifiers that merely look like $ quoted strings', () => {
+    expect(injectReplacements('SELECT z$$ :id x$$ * FROM users', dialect, { id: 1 }))
+      .to.equal('SELECT z$$ 1 x$$ * FROM users');
+  });
+
+  it('handles backslash escaped quotes', () => {
+    expect(injectReplacements('SELECT * FROM users WHERE id = \'\\\' :id\'', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = \'\\\' :id\'');
+    expect(injectReplacements('SELECT * FROM users WHERE id = \'\\\\\' OR id = :id', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = \'\\\\\' OR id = 1');
+    expect(injectReplacements('SELECT * FROM users WHERE id = \'\\\\\\\' :id\'', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users WHERE id = \'\\\\\\\' :id\'');
+  });
+
+  it('does not replace inside comments', () => {
+    expect(injectReplacements('SELECT * FROM users -- WHERE id = :id\nWHERE id = :id', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users -- WHERE id = :id\nWHERE id = 1');
+    expect(injectReplacements('SELECT * FROM users /* :id */ WHERE id = :id', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users /* :id */ WHERE id = 1');
+  });
+
+  it('is not confused by a string delimiter inside a comment', () => {
+    expect(injectReplacements('SELECT * FROM users -- \'\nWHERE id = \':id\' OR id = :id', dialect, { id: 1 }))
+      .to.equal('SELECT * FROM users -- \'\nWHERE id = \':id\' OR id = 1');
+  });
+
+  it('does not interpret ::x as a replacement, as it is a cast', () => {
+    expect(injectReplacements('SELECT 1::x, :a', dialect, { a: 2 })).to.equal('SELECT 1::x, 2');
+  });
+});
+
+describe('injectReplacements (positional replacements)', () => {
+  it('parses positional replacements', () => {
+    expect(injectReplacements(`SELECT ${L}?${R} FROM users WHERE id = '?' OR id = ? OR id = '''?'''`, dialect, [1]))
+      .to.equal(`SELECT ${L}?${R} FROM users WHERE id = '?' OR id = 1 OR id = '''?'''`);
+  });
+
+  it('does not allow a replacement value to be re-interpreted as a replacement', () => {
+    expect(injectReplacements('SELECT ? AS a, ? AS b', dialect, ['?', 2]))
+      .to.equal('SELECT \'?\' AS a, 2 AS b');
+  });
+
+  it('only considers tokens following "(", ",", "=" or whitespace to be replacements', () => {
+    expect(injectReplacements('SELECT * FROM users WHERE id = fn(?) OR id = fn(\'a\',?) OR id=? OR id = ?', dialect, [1, 2, 3, 4]))
+      .to.equal('SELECT * FROM users WHERE id = fn(1) OR id = fn(\'a\',2) OR id=3 OR id = 4');
+  });
+
+  it('does not replace inside $ quoted strings or comments', () => {
+    expect(injectReplacements('SELECT * FROM users WHERE id = $tag$ ? $tag$ OR id = $$ ? $$', dialect, [1]))
+      .to.equal('SELECT * FROM users WHERE id = $tag$ ? $tag$ OR id = $$ ? $$');
+    expect(injectReplacements('SELECT * FROM users -- WHERE id = ?\nWHERE id = ?', dialect, [1]))
+      .to.equal('SELECT * FROM users -- WHERE id = ?\nWHERE id = 1');
+  });
+
+  it('does not parse ?& and ?| operators as replacements', () => {
+    expect(injectReplacements('SELECT * FROM t WHERE c ?& ARRAY[\'a\'] AND c ?| ARRAY[\'b\'] AND id = ?', dialect, [1]))
+      .to.equal('SELECT * FROM t WHERE c ?& ARRAY[\'a\'] AND c ?| ARRAY[\'b\'] AND id = 1');
+  });
+
+  it('throws if a positional replacement is missing', () => {
+    expect(() => injectReplacements('SELECT ?, ?', dialect, [1]))
+      .to.throw('Positional replacement (?) 1 has no entry in the replacement map (replacements[1] is undefined).');
+  });
+});

