+import { describe, expect, it } from 'vitest';
+import { jsStringLiteralEscape } from './string';
+
+describe('jsStringLiteralEscape', () => {
+  it('leaves an ordinary media type untouched', () => {
+    expect(jsStringLiteralEscape('application/json')).toBe('application/json');
+  });
+
+  it('escapes a single quote so it cannot terminate the literal', () => {
+    // GHSA-rcpr-mq4m-jx9j: a single quote in a spec-controlled media type key
+    // was interpolated into a single-quoted string literal without escaping,
+    // terminating the literal and injecting arbitrary generated code.
+    const malicious = "application/json', evil: 'x";
+    const escaped = jsStringLiteralEscape(malicious);
+    expect(escaped).toBe("application/json\\', evil: \\'x");
+    // The escaped payload can be safely dropped inside a single-quoted literal.
+    expect(escaped).not.toMatch(/(^|[^\\])'/);
+  });
+
+  it('escapes backslashes', () => {
+    expect(jsStringLiteralEscape('a\\b')).toBe('a\\\\b');
+  });
+
+  it('escapes line terminators', () => {
+    expect(jsStringLiteralEscape('a\nb')).toBe('a\\nb');
+    expect(jsStringLiteralEscape('a\rb')).toBe('a\\rb');
+    expect(jsStringLiteralEscape('a b')).toBe('a\\u2028b');
+    expect(jsStringLiteralEscape('a b')).toBe('a\\u2029b');
+  });
+
+  it('does not add useless escapes for characters valid inside a literal', () => {
+    expect(jsStringLiteralEscape('text/*')).toBe('text/*');
+    expect(jsStringLiteralEscape('application/foo+json')).toBe(
+      'application/foo+json',
+    );
+  });
+});
