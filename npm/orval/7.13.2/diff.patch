+// ─── External $ref allow-list enforcement (GHSA-cxq5-97v7-87j8) ────────────
+//
+// External `$ref` values inside an OpenAPI spec are untrusted input: a
+// malicious spec can point a `$ref` at an arbitrary local file (LFI) or a
+// remote URL (SSRF/RFI) and orval would happily read/fetch it and inline the
+// result into the generated client.
+//
+// The top-level spec target is trusted (it is the user-configured
+// `input.target`); only the `$ref` values *inside* the spec are untrusted. So
+// before we hand the spec to SwaggerParser — which eagerly resolves every
+// `$ref` — we load the top-level document ourselves, scan it for external
+// `$ref`s and refuse to continue unless the user has explicitly opted in via
+// `parserOptions.externalRefs.allow`.
+
+const DISALLOWED_REFS_MESSAGE =
+  'External $ref targets are not allowed by default.';
+
+/**
+ * Strip the JSON pointer fragment (`#/...`) from a `$ref` value, leaving only
+ * the document target (file path or URL).
+ */
+const getRefDocument = (ref: string): string => {
+  const hashIndex = ref.indexOf('#');
+  return hashIndex === -1 ? ref : ref.slice(0, hashIndex);
+};
+
+/**
+ * Collect all external `$ref` document targets from a spec object. Per the
+ * JSON Reference rules a ref is external when it does not start with `#` (an
+ * in-document pointer). Returns deduplicated ref strings in their raw form.
+ */
+const collectExternalRefs = (obj: unknown): string[] => {
+  const refs = new Set<string>();
+  const walk = (val: unknown) => {
+    if (Array.isArray(val)) {
+      for (const item of val) walk(item);
+      return;
+    }
+    if (isObject(val)) {
+      const ref = (val as Record<string, unknown>).$ref;
+      if (isString(ref) && !ref.startsWith('#')) {
+        refs.add(ref);
+      }
+      for (const value of Object.values(val)) walk(value);
+    }
+  };
+  walk(obj);
+  return [...refs];
+};
+
+/**
+ * Resolve a ref document target (the part before `#`) to a canonical path or
+ * URL so it can be compared against allow-list entries that were resolved the
+ * same way. File paths resolve relative to the spec origin.
+ */
+const resolveRefTarget = (ref: string, origin?: string): string => {
+  const doc = getRefDocument(ref);
+  if (isUrl(doc)) {
+    return new URL(doc).href;
+  }
+  if (origin && isUrl(origin)) {
+    return new URL(doc, origin).href;
+  }
+  if (origin) {
+    return nodePath.resolve(nodePath.dirname(origin), doc);
+  }
+  return nodePath.resolve(doc);
+};
+
+/**
+ * Check whether a `$ref` is allowed by the user's allow-list. Both the ref and
+ * the allow-list entries are resolved against the spec origin so that
+ * `../schemas/pet.yaml` in the spec matches `../schemas/pet.yaml` in the
+ * config.
+ */
+const isAllowedRef = (
+  ref: string,
+  allowedExternalRefs: string[],
+  origin?: string,
+): boolean => {
+  const resolved = resolveRefTarget(ref, origin);
+  return allowedExternalRefs.some(
+    (entry) => resolveRefTarget(entry, origin) === resolved,
+  );
+};
+
+const formatDisallowedRefsError = (
+  disallowed: string[],
+  currentAllowed: string[],
+): string => {
+  const docs = [...new Set(disallowed.map(getRefDocument))];
+  const all = [...new Set([...currentAllowed, ...docs])];
+  const configSnippet = JSON.stringify(
+    {
+      input: {
+        parserOptions: { externalRefs: { allow: all } },
+      },
+    },
+    null,
+    2,
+  );
+  return (
+    `${DISALLOWED_REFS_MESSAGE}\n` +
+    `Add them to your config, or use externalRefs.allow: ['*'] to allow all.\n\n` +
+    `Disallowed refs:\n${disallowed.map((r) => `  - ${r}`).join('\n')}\n\n` +
+    `Suggested config:\n${configSnippet}`
+  );
+};
+
+/**
+ * Load the top-level spec into an inline object so we can scan it for external
+ * `$ref`s before SwaggerParser resolves them. The top-level target is trusted
+ * (user-configured `input.target`); only `$ref` values inside the spec are
