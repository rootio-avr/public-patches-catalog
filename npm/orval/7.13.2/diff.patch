+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+import { importSpecs } from './import-specs';
+import { normalizeOptions } from './utils/options';
+
+/**
+ * Regression tests for GHSA-cxq5-97v7-87j8 / CVE-2026-62680.
+ *
+ * A malicious OpenAPI spec can use an external `$ref` pointing at an arbitrary
+ * local file (LFI) or remote URL (SSRF/RFI). orval used to resolve these refs
+ * unconditionally. External refs must now be blocked by default and only
+ * resolved when the user explicitly opts in via
+ * `parserOptions.externalRefs.allow`.
+ */
+describe('externalRefs allow-list (CVE-2026-62680)', () => {
+  let workspace: string;
+  let specPath: string;
+
+  beforeEach(async () => {
+    workspace = await mkdtemp(path.join(os.tmpdir(), 'orval-external-ref-'));
+
+    const external = {
+      openapi: '3.0.0',
+      info: { title: 'external', version: '1.0' },
+      paths: {},
+      components: {
+        schemas: {
+          ProbeResponse: {
+            type: 'object',
+            properties: { probe_marker: { type: 'string' } },
+          },
+        },
+      },
+    };
+
+    const spec = {
+      openapi: '3.0.0',
+      info: { title: 'root', version: '1.0' },
+      paths: {
+        '/probe': {
+          get: {
+            operationId: 'getProbe',
+            responses: {
+              '200': {
+                description: 'ok',
+                content: {
+                  'application/json': {
+                    schema: {
+                      $ref: 'external.yaml#/components/schemas/ProbeResponse',
+                    },
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+    };
+
+    specPath = path.join(workspace, 'openapi.yaml');
+    await writeFile(
+      path.join(workspace, 'external.yaml'),
+      JSON.stringify(external),
+      'utf8',
+    );
+    await writeFile(specPath, JSON.stringify(spec), 'utf8');
+  });
+
+  afterEach(async () => {
+    await rm(workspace, { recursive: true, force: true });
+  });
+
+  it('blocks an external $ref by default and prints a config snippet', async () => {
+    const normalizedOptions = await normalizeOptions(
+      { output: { target: '' }, input: { target: specPath } },
+      workspace,
+      {},
+    );
+
+    await expect(importSpecs(workspace, normalizedOptions)).rejects.toThrow(
+      /External \$ref targets are not allowed by default/,
+    );
+  });
+
+  it('resolves an external $ref when explicitly allowed', async () => {
+    const normalizedOptions = await normalizeOptions(
+      {
+        output: { target: '' },
+        input: {
+          target: specPath,
+          parserOptions: { externalRefs: { allow: ['external.yaml'] } },
+        },
+      },
+      workspace,
+      {},
+    );
+
+    await expect(
+      importSpecs(workspace, normalizedOptions),
+    ).resolves.toBeDefined();
+  });
+
+  it('resolves all external $refs with the wildcard allow-list', async () => {
+    const normalizedOptions = await normalizeOptions(
+      {
+        output: { target: '' },
+        input: {
+          target: specPath,
+          parserOptions: { externalRefs: { allow: ['*'] } },
+        },
+      },
+      workspace,
+      {},
+    );
+
+    await expect(
+      importSpecs(workspace, normalizedOptions),
+    ).resolves.toBeDefined();
+  });
+});

