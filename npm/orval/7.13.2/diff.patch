+import { describe, expect, it } from 'vitest';
+
+import { getKey } from './keys';
+
+describe('getKey getter', () => {
+  it('returns a valid ES5 identifier unquoted', () => {
+    expect(getKey('validName')).toBe('validName');
+    expect(getKey('_private')).toBe('_private');
+    expect(getKey('$dollar')).toBe('$dollar');
+  });
+
+  it('single-quotes a non-identifier key', () => {
+    expect(getKey('with-dash')).toBe("'with-dash'");
+    expect(getKey('123')).toBe("'123'");
+  });
+
+  // Regression test for CVE-2026-72716 / GHSA-2w86-xfrc-g85r:
+  // a spec-controlled property name wrapped in single quotes must be escaped
+  // so it cannot break out of the string literal and inject code.
+  describe('single-quote injection (CVE-2026-72716)', () => {
+    it("escapes a single quote so the key can't break out", () => {
+      const result = getKey("evil'+process.exit(1)+'");
+      expect(result).not.toBe("'evil'+process.exit(1)+''");
+      // The inner single quotes must be backslash-escaped.
+      expect(result).toBe("'evil\\'+process.exit(1)+\\''");
+    });
+
+    it('escapes a backslash in the key', () => {
+      expect(getKey('a\\b')).toBe("'a\\\\b'");
+    });
+  });
+});
