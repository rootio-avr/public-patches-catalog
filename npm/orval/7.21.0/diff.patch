+/**
+ * Escape a string so it can be safely embedded inside a single-quoted
+ * JavaScript string literal in generated code.
+ *
+ * Unlike {@link jsStringEscape}, this only neutralizes the characters that
+ * can break out of a single-quoted string literal (single quote, backslash
+ * and line terminators). It intentionally leaves `/` and `*` untouched so it
+ * does not trip ESLint's `no-useless-escape` in generated code.
+ *
+ * @param input String to escape
+ */
+export const jsStringLiteralEscape = (input: string) =>
+  input.replaceAll(/['\\\n\r\u2028\u2029]/g, (character) => {
+    switch (character) {
+      case "'":
+      case '\\': {
+        return '\\' + character;
+      }
+      case '\n': {
+        return String.raw`\n`;
+      }
+      case '\r': {
+        return String.raw`\r`;
+      }
+      case '\u2028': {
+        return String.raw`\u2028`;
+      }
+      case '\u2029': {
+        return String.raw`\u2029`;
+      }
+      default: {
+        return '';
+      }
+    }
+  });

