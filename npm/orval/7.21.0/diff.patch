+/**
+ * Escape a spec-controlled string for safe embedding inside a backtick
+ * template literal.
+ *
+ * Neutralizes the backtick, the backslash and the `${` interpolation
+ * opener, plus the four line-terminator characters.
+ *
+ * @param input String to escape
+ */
+export const jsTemplateLiteralEscape = (input: string): string =>
+  input.replaceAll(/\$\{|[`\\\n\r\u2028\u2029]/g, (match) => {
+    switch (match) {
+      case '`':
+      case '\\': {
+        return '\\' + match;
+      }
+      case '${': {
+        return '\\${';
+      }
+      case '\n': {
+        return String.raw`\n`;
+      }
+      case '\r': {
+        return String.raw`\r`;
+      }
+      case '\u2028': {
+        return String.raw`\u2028`;
+      }
+      case '\u2029': {
+        return String.raw`\u2029`;
+      }
+      default: {
+        return match;
+      }
+    }
+  });

