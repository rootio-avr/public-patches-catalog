@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+import { generateMutatorConfig } from './options';
+import { Verbs } from '../types';
+import type { GetterBody, GetterResponse } from '../types';
+
+// Regression test for AIKIDO-2026-939997 / GHSA-rcpr-mq4m-jx9j.
+//
+// The OpenAPI requestBody.content media type key was interpolated into a
+// single-quoted string literal ('Content-Type': '<contentType>') in generated
+// code without escaping. A single quote in the media type terminated the
+// literal, allowing a crafted key to inject additional headers (or otherwise
+// backdoored code) into the generated request config. The fix routes the value
+// through jsStringLiteralEscape (provided by CVE-2026-71867).
+
+const minimalBody: GetterBody = {
+  originalSchema: {},
+  imports: [],
+  definition: '',
+  implementation: '',
+  schemas: [],
+  contentType: 'application/json',
+  isOptional: false,
+};
+
+const minimalResponse: GetterResponse = {
+  imports: [],
+  definition: { success: '', errors: '' },
+  isBlob: false,
+  types: { success: [], errors: [] },
+  contentTypes: [],
+  schemas: [],
+};
+
+describe('generateMutatorConfig content type escaping (AIKIDO-2026-939997)', () => {
+  it('should escape single quotes in the request body media type key', () => {
+    const result = generateMutatorConfig({
+      route: '/api/test',
+      body: {
+        ...minimalBody,
+        contentType: "application/json', 'X-Evil': 'injected",
+      },
+      headers: undefined,
+      queryParams: undefined,
+      response: minimalResponse,
+      verb: Verbs.POST,
+      isFormData: false,
+      isFormUrlEncoded: false,
+      hasSignal: false,
+      isExactOptionalPropertyTypes: false,
+    });
+
+    expect(result).toContain(
+      "'Content-Type': 'application/json\\', \\'X-Evil\\': \\'injected'",
+    );
+    expect(result).not.toContain("'X-Evil': 'injected'");
+  });
+
+  it('should leave a benign media type key unchanged', () => {
+    const result = generateMutatorConfig({
+      route: '/api/test',
+      body: { ...minimalBody, contentType: 'application/json' },
+      headers: undefined,
+      queryParams: undefined,
+      response: minimalResponse,
+      verb: Verbs.POST,
+      isFormData: false,
+      isFormUrlEncoded: false,
+      hasSignal: false,
+      isExactOptionalPropertyTypes: false,
+    });
+
+    expect(result).toContain("'Content-Type': 'application/json'");
+  });
+});
