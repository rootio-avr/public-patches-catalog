+'use strict';
+
+// CVE-2026-119192: RSASSA-PKCS1-v1_5 verification must require a canonical DER
+// DigestInfo (RFC 8017 8.2.2).
+
+var assert = require('assert');
+var forge = require('../lib/index');
+
+var pki = forge.pki;
+
+var DIGEST_INFO_ERROR =
+  /ASN\.1 object does not contain a valid RSASSA-PKCS1-v1_5 DigestInfo value/;
+
+var SHA256_OID_DER = '\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x01';
+
+describe('CVE-2026-119192 canonical DigestInfo', function() {
+  this.timeout(60000);
+
+  var keys = pki.rsa.generateKeyPair({bits: 1024, e: 0x10001});
+  var md = forge.md.sha256.create();
+  md.update('hello world!', 'utf8');
+  var digest = md.digest().getBytes();
+
+  // build signature from raw encoded block using the low level RSA op
+  function sign(digestInfo) {
+    var k = Math.ceil(keys.privateKey.n.bitLength() / 8);
+    var padLen = k - digestInfo.length - 3;
+    var em = '\x00\x01' + new Array(padLen + 1).join('\xff') + '\x00' +
+      digestInfo;
+    return pki.rsa.decrypt(em, keys.privateKey, false, false);
+  }
+
+  function der(tag, content) {
+    return tag + String.fromCharCode(content.length) + content;
+  }
+
+  var canonical = der('\x30',
+    der('\x30', SHA256_OID_DER + '\x05\x00') + der('\x04', digest));
+
+  it('should accept a canonical DigestInfo', function() {
+    assert.strictEqual(
+      keys.publicKey.verify(digest, sign(canonical)), true);
+    assert.strictEqual(
+      keys.publicKey.verify(digest, keys.privateKey.sign(md)), true);
+  });
+
+  it('should accept a canonical DigestInfo without NULL parameters',
+    function() {
+      var di = der('\x30',
+        der('\x30', SHA256_OID_DER) + der('\x04', digest));
+      assert.strictEqual(keys.publicKey.verify(digest, sign(di)), true);
+    });
+
+  it('should reject NULL parameters with content', function() {
+    var di = der('\x30',
+      der('\x30', SHA256_OID_DER + '\x05\x01\x00') + der('\x04', digest));
+    assert.throws(function() {
+      keys.publicKey.verify(digest, sign(di));
+    }, DIGEST_INFO_ERROR);
+  });
+
+  it('should reject non-minimal length encodings', function() {
+    var inner = SHA256_OID_DER + '\x05\x00';
+    // long-form length (0x81 0x0d) for a length that fits in short form
+    var algo = '\x30\x81' + String.fromCharCode(inner.length) + inner;
+    var di = der('\x30', algo + der('\x04', digest));
+    assert.throws(function() {
+      keys.publicKey.verify(digest, sign(di));
+    }, DIGEST_INFO_ERROR);
+  });
+
+  it('should reject non-canonical OID encodings', function() {
+    // sha256 OID with a redundant leading 0x80 continuation byte in the
+    // last arc: 2.16.840.1.101.3.4.2.1
+    var oid = '\x06\x0a\x60\x86\x48\x01\x65\x03\x04\x02\x80\x01';
+    var di = der('\x30',
+      der('\x30', oid + '\x05\x00') + der('\x04', digest));
+    assert.throws(function() {
+      keys.publicKey.verify(digest, sign(di));
+    });
+  });
+
+  it('should reject extra DigestAlgorithm elements', function() {
+    var di = der('\x30',
+      der('\x30', SHA256_OID_DER + '\x05\x00' + der('\x04', 'garbage')) +
+      der('\x04', digest));
+    assert.throws(function() {
+      keys.publicKey.verify(digest, sign(di));
+    }, DIGEST_INFO_ERROR);
+  });
+});

