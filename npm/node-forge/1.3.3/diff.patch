+'use strict';
+// Regression test for CVE-2026-118779 (GHSA-7wch-p9px-956x): ReDoS in pem.decode
+var assert = require('assert');
+var pem = require('../lib/pem');
+
+function repeat(str, count) {
+  return new Array(count + 1).join(str);
+}
+
+function checkInvalid(msg) {
+  assert.throws(function() {
+    pem.decode(msg);
+  }, /^Error: Invalid PEM formatted message.$/);
+}
+
+// previously each of these took minutes
+var start = Date.now();
+checkInvalid(repeat(' -----BEGIN I-----G-----END B', 2000) + '\x00');
+checkInvalid('-----BEGIN A-----\n' + repeat('\n', 256 * 1024));
+checkInvalid('-----BEGIN RSA-----\n' + repeat('\n\n', 128 * 1024) + 'ZZZZ');
+
+var msgs = pem.decode('-----BEGIN A-----\n' + repeat('A', 512 * 1024) +
+  '\n\nQUJD\n-----END A-----\n');
+assert.equal(msgs.length, 1);
+assert.equal(msgs[0].body, 'ABC');
+
+msgs = pem.decode('-----BEGIN A-----\n' +
+  'Proc-Type: 4,ENCRYPTED\n' +
+  'DEK-Info: DES-CBC,F8143EDE5960C597\n' +
+  'X-Header: ' + repeat(' ', 512 * 1024) + 'x\n' +
+  '\nQUJD\n-----END A-----\n');
+assert.equal(msgs.length, 1);
+assert.equal(msgs[0].body, 'ABC');
+assert.deepEqual(msgs[0].headers, [{name: 'X-Header', values: ['x']}]);
+
+assert.ok(Date.now() - start < 20000, 'pem.decode took too long (ReDoS)');
+
+// normal inputs still decode
+msgs = pem.decode('-----BEGIN A-----\r\n' +
+  'Proc-Type: 4,ENCRYPTED\r\n' +
+  'DEK-Info: DES-CBC,F8143EDE5960C597\r\n' +
+  'X-Header:  a, b   \r\n\r\nQUJD\r\n-----END A-----\r\n');
+assert.equal(msgs.length, 1);
+assert.equal(msgs[0].type, 'A');
+assert.equal(msgs[0].body, 'ABC');
+assert.deepEqual(msgs[0].dekInfo,
+  {algorithm: 'DES-CBC', parameters: 'F8143EDE5960C597'});
+assert.deepEqual(msgs[0].headers, [{name: 'X-Header', values: ['a', 'b']}]);
+assert.equal(pem.decode('-----BEGIN A-----QUJD-----END A-----')[0].body, 'ABC');
+
+// labels can't contain '--'
+checkInvalid('-----BEGIN A-----B-----\nQUJD\n-----END A-----B-----\n');
+console.log('cve-2026-118779 ok');

