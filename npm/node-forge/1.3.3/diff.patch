+// Regression test for CVE-2026-119187 (GHSA-hqq3-7jhf-c5jx):
+// tls c.process() recursed once per record, so a long run of small records
+// in one buffer exhausted the call stack.
+var assert = require('assert');
+var forge = require('../lib/index');
+
+// enough records to exhaust the call stack if each record is handled one
+// call level deeper than the previous one
+var COUNT = 50000;
+
+// heartbeat_response with empty payload, fatal handshake_failure alert
+var HB_RESPONSE = forge.util.hexToBytes('1803010003020000');
+var ALERT = forge.util.hexToBytes('15030100020228');
+
+function repeat(bytes, count) {
+  var b = forge.util.createBuffer();
+  for(var i = 0; i < count; ++i) {
+    b.putBytes(bytes);
+  }
+  return b.getBytes();
+}
+
+function createConnection(log) {
+  return forge.tls.createConnection({
+    server: true,
+    verify: function() {
+      return true;
+    },
+    tlsDataReady: function(c) {
+      c.tlsData.getBytes();
+    },
+    dataReady: function(c) {
+      c.data.getBytes();
+    },
+    heartbeatReceived: function() {
+      log.heartbeats++;
+    },
+    closed: function() {},
+    error: function(c, error) {
+      log.errors.push(error.message);
+    }
+  });
+}
+
+// many records in a single buffer must not overflow the stack
+(function() {
+  var log = {heartbeats: 0, errors: []};
+  var c = createConnection(log);
+  var rval = c.process(repeat(HB_RESPONSE, COUNT) + ALERT);
+  assert.strictEqual(rval, 0);
+  // the alert after all heartbeat records was processed
+  assert.deepStrictEqual(log.errors, ['Handshake failure.']);
+})();
+
+// records split across calls still report the bytes needed
+(function() {
+  var log = {heartbeats: 0, errors: []};
+  var c = createConnection(log);
+  var data = repeat(HB_RESPONSE, 3) + ALERT;
+  var rvals = [];
+  for(var i = 0; i < data.length; ++i) {
+    rvals.push(c.process(data.charAt(i)));
+  }
+  // bytes needed for the next header or fragment, 0 when complete
+  assert.deepStrictEqual(rvals.slice(0, 8), [4, 3, 2, 1, 3, 2, 1, 0]);
+  assert.deepStrictEqual(log.errors, ['Handshake failure.']);
+})();
+
+console.log('cve-2026-119187 regression test passed');

