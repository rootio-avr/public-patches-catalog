+'use strict';
+// Regression test for CVE-2026-119190 / GHSA-5x38-2vff-x55p:
+// chain verification must only honor basicConstraints OID 2.5.29.19 and must
+// reject non-leaf certificates lacking a genuine basicConstraints extension.
+var assert = require('assert');
+var forge = require('../lib/index');
+var pki = forge.pki;
+var asn1 = forge.asn1;
+
+var keys = pki.rsa.generateKeyPair({bits: 1024});
+
+function issue(subject, issuer, serial, extensions) {
+  var cert = pki.createCertificate();
+  cert.publicKey = keys.publicKey;
+  cert.serialNumber = '0' + serial;
+  cert.validity.notBefore = new Date();
+  cert.validity.notAfter = new Date();
+  cert.validity.notAfter.setFullYear(cert.validity.notBefore.getFullYear() + 1);
+  cert.setSubject([{name: 'commonName', value: subject}]);
+  cert.setIssuer([{name: 'commonName', value: issuer}]);
+  cert.setExtensions(extensions);
+  cert.sign(keys.privateKey, forge.md.sha256.create());
+  // round-trip so that the parsed extensions are what gets verified
+  return pki.certificateFromPem(pki.certificateToPem(cert));
+}
+
+// BasicConstraints ::= SEQUENCE { cA TRUE } under a given OID
+function bcExt(id, cA) {
+  return {
+    id: id,
+    critical: false,
+    value: asn1.toDer(
+      asn1.create(asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, [
+        asn1.create(asn1.Class.UNIVERSAL, asn1.Type.BOOLEAN, false,
+          String.fromCharCode(cA ? 0xff : 0x00))
+      ])).getBytes()
+  };
+}
+
+function verifyChain(middleExtensions) {
+  var root = issue('root', 'root', 1, [
+    {name: 'basicConstraints', cA: true},
+    {name: 'keyUsage', keyCertSign: true}
+  ]);
+  var middle = issue('middle', 'root', 2, middleExtensions);
+  var leaf = issue('leaf', 'middle', 3, []);
+  return pki.verifyCertificateChain(pki.createCaStore([root]), [leaf, middle]);
+}
+
+function throwsWith(fn, regex) {
+  assert.throws(fn, function(err) {
+    return regex.test(err.message) && err.error === 'forge.pki.BadCertificate';
+  });
+}
+
+describe('CVE-2026-119190 basicConstraints OID handling', function() {
+  this.timeout(60000);
+
+  it('should ignore forged 2.5.29.10 before genuine cA=false', function() {
+    throwsWith(function() {
+      verifyChain([
+        bcExt('2.5.29.10', true),
+        {name: 'basicConstraints', cA: false}
+      ]);
+    }, /basicConstraints indicates the certificate is not a CA/);
+  });
+
+  it('should reject non-leaf with only a forged 2.5.29.10', function() {
+    throwsWith(function() {
+      verifyChain([bcExt('2.5.29.10', true)]);
+    }, /missing basicConstraints extension/);
+  });
+
+  it('should reject non-leaf with no basicConstraints', function() {
+    throwsWith(function() {
+      verifyChain([]);
+    }, /missing basicConstraints extension/);
+  });
+
+  it('should verify a genuine CA using 2.5.29.19', function() {
+    assert.strictEqual(verifyChain([
+      {name: 'basicConstraints', cA: true},
+      {name: 'keyUsage', keyCertSign: true}
+    ]), true);
+  });
+});

