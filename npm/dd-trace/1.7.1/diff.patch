+'use strict'
+
+// Regression test for CVE-2026-50272 (CWE-770): the baggage extraction path
+// (TextMapPropagator._extractBaggageItems) must enforce the
+// DD_TRACE_BAGGAGE_MAX_ITEMS / DD_TRACE_BAGGAGE_MAX_BYTES caps so a malicious
+// carrier with an excessive number/size of ot-baggage-* headers cannot cause
+// unbounded per-item processing and resource exhaustion.
+
+describe('TextMapPropagator baggage extraction caps (CVE-2026-50272)', () => {
+  const propagationModulePath = require.resolve('../../../src/opentracing/propagation/text_map')
+
+  let TextMapPropagator
+  let propagator
+
+  const baseCarrier = {
+    'x-datadog-trace-id': '123',
+    'x-datadog-parent-id': '18446744073709551160'
+  }
+
+  function loadPropagator () {
+    delete require.cache[propagationModulePath]
+    TextMapPropagator = require('../../../src/opentracing/propagation/text_map')
+    propagator = new TextMapPropagator({ experimental: { b3: false } })
+  }
+
+  afterEach(() => {
+    delete process.env.DD_TRACE_BAGGAGE_MAX_ITEMS
+    delete process.env.DD_TRACE_BAGGAGE_MAX_BYTES
+    delete require.cache[propagationModulePath]
+  })
+
+  it('caps the number of extracted baggage items at DD_TRACE_BAGGAGE_MAX_ITEMS', () => {
+    process.env.DD_TRACE_BAGGAGE_MAX_ITEMS = '5'
+    process.env.DD_TRACE_BAGGAGE_MAX_BYTES = '1000000'
+    loadPropagator()
+
+    const carrier = Object.assign({}, baseCarrier)
+    for (let i = 0; i < 1000; i++) {
+      carrier[`ot-baggage-k${i}`] = `v${i}`
+    }
+
+    const spanContext = propagator.extract(carrier)
+    const items = Object.keys(spanContext._baggageItems)
+
+    // Must not accept all 1000 attacker-supplied items.
+    expect(items.length).to.equal(5)
+  })
+
+  it('caps the total byte size of extracted baggage at DD_TRACE_BAGGAGE_MAX_BYTES', () => {
+    process.env.DD_TRACE_BAGGAGE_MAX_ITEMS = '1000000'
+    process.env.DD_TRACE_BAGGAGE_MAX_BYTES = '50'
+    loadPropagator()
+
+    const carrier = Object.assign({}, baseCarrier)
+    for (let i = 0; i < 1000; i++) {
+      carrier[`ot-baggage-key${i}`] = 'x'.repeat(20)
+    }
+
+    const spanContext = propagator.extract(carrier)
+    const items = Object.keys(spanContext._baggageItems)
+
+    // Byte budget of 50 admits only a couple of small entries, never all 1000.
+    expect(items.length).to.be.greaterThan(0)
+    expect(items.length).to.be.lessThan(5)
+  })
+
+  it('still extracts legitimately sized baggage unchanged', () => {
+    loadPropagator()
+
+    const carrier = Object.assign({}, baseCarrier, {
+      'ot-baggage-foo': 'bar',
+      'ot-baggage-hello': 'world'
+    })
+
+    const spanContext = propagator.extract(carrier)
+
+    expect(spanContext._baggageItems).to.have.property('foo', 'bar')
+    expect(spanContext._baggageItems).to.have.property('hello', 'world')
+  })
+})
