@@ -0,0 +1,71 @@
+'use strict'
+
+// Regression test for CVE-2026-50272 (CWE-400 / CWE-770).
+// The legacy ot-baggage- extraction path in TextMapPropagator._extractBaggageItems()
+// previously allocated one _baggageItems entry per inbound ot-baggage-* header with
+// no cap on the number of items or their cumulative byte size, allowing an
+// unauthenticated attacker to exhaust CPU/memory via excessive/oversized baggage
+// headers. The fix caps extraction at baggageMaxItems (default 64) items and
+// baggageMaxBytes (default 8192) bytes.
+
+const id = require('../../../src/id')
+
+describe('TextMapPropagator baggage extraction limits (CVE-2026-50272)', () => {
+  let TextMapPropagator
+  let propagator
+
+  const baseCarrier = () => ({
+    'x-datadog-trace-id': '123',
+    'x-datadog-parent-id': '18446744073709551160'
+  })
+
+  beforeEach(() => {
+    TextMapPropagator = require('../../../src/opentracing/propagation/text_map')
+    propagator = new TextMapPropagator({ experimental: { b3: false }, tagsHeaderMaxLength: 512 })
+  })
+
+  it('should still extract a small, legitimate baggage set unchanged', () => {
+    const carrier = baseCarrier()
+    carrier['ot-baggage-foo'] = 'bar'
+    carrier['ot-baggage-baz'] = 'qux'
+
+    const spanContext = propagator.extract(carrier)
+
+    expect(spanContext._baggageItems.foo).to.equal('bar')
+    expect(spanContext._baggageItems.baz).to.equal('qux')
+    expect(Object.keys(spanContext._baggageItems)).to.have.length(2)
+  })
+
+  it('should cap the number of extracted baggage items at 64 (item-count DoS)', () => {
+    const carrier = baseCarrier()
+    for (let i = 0; i < 5000; i++) {
+      carrier[`ot-baggage-k${i}`] = 'v'
+    }
+
+    const spanContext = propagator.extract(carrier)
+
+    expect(Object.keys(spanContext._baggageItems).length).to.be.at.most(64)
+  })
+
+  it('should stop extraction once the byte cap is exceeded (oversized-value DoS)', () => {
+    const carrier = baseCarrier()
+    // A single oversized value beyond the 8192-byte default must not be committed.
+    carrier['ot-baggage-huge'] = 'A'.repeat(9000)
+
+    const spanContext = propagator.extract(carrier)
+
+    expect(spanContext._baggageItems).to.not.have.property('huge')
+  })
+
+  it('should not affect non-baggage context extraction', () => {
+    const carrier = baseCarrier()
+    for (let i = 0; i < 200; i++) {
+      carrier[`ot-baggage-k${i}`] = 'v'
+    }
+
+    const spanContext = propagator.extract(carrier)
+
+    expect(spanContext.toTraceId()).to.equal('123')
+    expect(spanContext.toSpanId()).to.equal(id('18446744073709551160', 10).toString())
+  })
+})
