Description: Fix CVE-2026-50272 — enforce item/byte caps on legacy ot-baggage- extraction
 dd-trace v3.12.1 predates the W3C baggage propagator that the upstream fix
 (commit a7d4c0da, PR #8255) hardens, but its legacy ot-baggage- extraction
 path in TextMapPropagator._extractBaggageItems() shares the identical
 missing-cap weakness: it allocates one _baggageItems entry per inbound
 ot-baggage-* header with no limit on the number of items or their cumulative
 byte size. An unauthenticated attacker can force unbounded per-request
 allocation via excessive or oversized baggage headers (CWE-400/CWE-770 DoS).
 This backport adds baggageMaxItems (DD_TRACE_BAGGAGE_MAX_ITEMS, default 64)
 and baggageMaxBytes (DD_TRACE_BAGGAGE_MAX_BYTES, default 8192) caps to the
 extraction loop, matching the env var names and default values described in
 the advisory.
Origin: ai-synthesized, CVE-2026-50272
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-09-01

--- a/packages/dd-trace/src/opentracing/propagation/text_map.js
+++ b/packages/dd-trace/src/opentracing/propagation/text_map.js
@@ -32,6 +32,17 @@ const logKeys = ddKeys.concat(b3Keys)
 const traceparentExpr = /^(\d{2})-([A-Fa-f0-9]{32})-([A-Fa-f0-9]{16})-(\d{2})$/i
 const traceparentKey = 'traceparent'
 
+// Cap the resources consumed while extracting attacker-controlled baggage
+// headers so a request carrying an excessive number of ot-baggage-* headers
+// (or oversized values) cannot exhaust CPU/memory (CVE-2026-50272,
+// CWE-400/CWE-770). Env var names and defaults mirror the upstream mitigation.
+const parsePositiveInt = (value, fallback) => {
+  const parsed = parseInt(value, 10)
+  return Number.isInteger(parsed) && parsed > 0 ? parsed : fallback
+}
+const baggageMaxItems = parsePositiveInt(process.env.DD_TRACE_BAGGAGE_MAX_ITEMS, 64)
+const baggageMaxBytes = parsePositiveInt(process.env.DD_TRACE_BAGGAGE_MAX_BYTES, 8192)
+
 class TextMapPropagator {
   constructor (config) {
     this._config = config
@@ -286,13 +297,26 @@ class TextMapPropagator {
   }
 
   _extractBaggageItems (carrier, spanContext) {
-    Object.keys(carrier).forEach(key => {
+    let itemCount = 0
+    let byteCount = 0
+    for (const key of Object.keys(carrier)) {
       const match = key.match(baggageExpr)
 
-      if (match) {
-        spanContext._baggageItems[match[1]] = carrier[key]
+      if (!match) continue
+
+      if (itemCount >= baggageMaxItems) {
+        log.error('Baggage items from carrier exceed the item limit, skipping remaining extraction.')
+        break
       }
-    })
+      const value = String(carrier[key])
+      byteCount += Buffer.byteLength(match[1]) + Buffer.byteLength(value)
+      if (byteCount > baggageMaxBytes) {
+        log.error('Baggage items from carrier exceed the byte limit, skipping remaining extraction.')
+        break
+      }
+      spanContext._baggageItems[match[1]] = carrier[key]
+      itemCount++
+    }
   }
 
