Description: CVE-2024-47178 - basic-auth-connect uses non-constant-time
 string comparison when validating username/password provided as plain
 strings, allowing a timing side-channel (CWE-208 / CWE-1254) that can
 leak credentials. Use tsscmp (timing-safe compare) for both the username
 and password comparisons.
Origin: upstream, https://github.com/expressjs/basic-auth-connect/commit/bac1e6a8530e1efd0028800b9b588a37adb0d203
--- a/index.js
+++ b/index.js
@@ -1,2 +1,3 @@
+var timingSafeCompare = require('tsscmp');
 var http = require('http');

@@ -55,3 +55,5 @@ module.exports = function basicAuth(callback, realm) {
     callback = function(user, pass){
-      return user == username && pass == password;
+      var usernameValid = timingSafeCompare(user, username);
+      var passwordValid = timingSafeCompare(pass, password);
+      return usernameValid && passwordValid;
     }
--- a/package.json
+++ b/package.json
@@ -26,4 +26,7 @@
   "scripts": {
     "test": "make test"
-  }
+  },
+  "dependencies": {
+    "tsscmp": "^1.0.6"
+  }
 }
