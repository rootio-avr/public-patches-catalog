@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { symmetricDecrypt, symmetricEncrypt } from "../dist/crypto/index.mjs";
+import { derivePurposeKey } from "../dist/crypto/purpose.mjs";
+
+const purposes = [
+	"oauth-state-cookie",
+	"oauth-proxy-state",
+	"oauth-proxy-package",
+	"oauth-proxy-profile",
+];
+
+test("OAuth ciphertexts decrypt only under their own purpose key", async () => {
+	const secret = "shared-secret-at-least-32-characters";
+	for (const purpose of purposes) {
+		const ciphertext = await symmetricEncrypt({
+			key: derivePurposeKey(secret, purpose),
+			data: "synthetic payload",
+		});
+		assert.equal(
+			await symmetricDecrypt({
+				key: derivePurposeKey(secret, purpose),
+				data: ciphertext,
+			}),
+			"synthetic payload",
+		);
+		for (const other of purposes.filter((p) => p !== purpose)) {
+			await assert.rejects(
+				symmetricDecrypt({ key: derivePurposeKey(secret, other), data: ciphertext }),
+			);
+		}
+		await assert.rejects(symmetricDecrypt({ key: secret, data: ciphertext }));
+	}
+});
+
+test("purpose keys preserve secret rotation without accepting the shared key", async () => {
+	const oldSecret = "old-secret-at-least-32-characters!!";
+	const rotated = {
+		keys: new Map([
+			[2, "new-secret-at-least-32-characters!!"],
+			[1, oldSecret],
+		]),
+		currentVersion: 2,
+		legacySecret: oldSecret,
+	};
+	const oldConfig = { keys: new Map([[1, oldSecret]]), currentVersion: 1 };
+	const ciphertext = await symmetricEncrypt({
+		key: derivePurposeKey(oldConfig, "oauth-proxy-profile"),
+		data: "old profile",
+	});
+	assert.equal(
+		await symmetricDecrypt({
+			key: derivePurposeKey(rotated, "oauth-proxy-profile"),
+			data: ciphertext,
+		}),
+		"old profile",
+	);
+	const legacy = await symmetricEncrypt({ key: oldSecret, data: "pre-upgrade" });
+	await assert.rejects(
+		symmetricDecrypt({
+			key: derivePurposeKey(rotated, "oauth-proxy-profile"),
+			data: legacy,
+		}),
+	);
+});
