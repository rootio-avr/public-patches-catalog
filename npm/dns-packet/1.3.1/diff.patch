--- /dev/null
+++ b/test/cve-2021-23386.test.js
@@ -0,0 +1,27 @@
+// Regression test for CVE-2021-23386 (dns-packet)
+// name.encodingLength() over-reported the buffer size for names that are
+// just '.' or that carry leading/trailing dots. The reported length must
+// match the number of bytes name.encode() actually writes, otherwise a
+// too-large buffer is allocated and uninitialized memory is exposed.
+var tape = require('tape')
+var packet = require('../')
+var Buffer = require('safe-buffer').Buffer
+
+tape('CVE-2021-23386: root name "." encodingLength', function (t) {
+  t.equal(packet.name.encodingLength('.'), 1, 'root "." encodes to a single byte')
+  t.end()
+})
+
+tape('CVE-2021-23386: encodingLength matches encoded bytes', function (t) {
+  var names = ['.', 'example.com', '.example.com', 'example.com.', '.example.com.']
+  names.forEach(function (n) {
+    var buf = Buffer.allocUnsafe(packet.name.encodingLength(n))
+    packet.name.encode(n, buf, 0)
+    t.equal(
+      packet.name.encodingLength(n),
+      packet.name.encode.bytes,
+      'encodingLength equals bytes written for "' + n + '"'
+    )
+  })
+  t.end()
+})
