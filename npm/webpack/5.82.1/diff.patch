Description: Fix CVE-2024-43788 - DOM Clobbering in AutoPublicPathRuntimeModule
 The runtime determines the auto public path via document.currentScript,
 which can be clobbered by an attacker-injected non-script DOM element
 with a matching id/name (e.g. <img name="currentScript">). This patch
 adds a tagName guard so only an actual <script> element is accepted as
 the source of the public path URL, mitigating the DOM clobbering -> XSS
 vector.
Origin: upstream, https://github.com/webpack/webpack/commit/955e057abc6cc83cbc3fa1e1ef67a49758bf5a61
Bug: https://github.com/webpack/webpack/security/advisories/GHSA-4vvj-4cpr-p986
Author: webpack maintainers
Last-Update: 2026-07-28

--- a/lib/runtime/AutoPublicPathRuntimeModule.js
+++ b/lib/runtime/AutoPublicPathRuntimeModule.js
@@ -42,7 +42,10 @@
 						`var document = ${RuntimeGlobals.global}.document;`,
 						"if (!scriptUrl && document) {",
 						Template.indent([
-							`if (document.currentScript)`,
+							// Technically we could use `document.currentScript instanceof window.HTMLScriptElement`,
+							// but an attacker could try to inject `<script>HTMLScriptElement = HTMLImageElement</script>`
+							// and use `<img name="currentScript" src="https://attacker.controlled.server/"></img>`
+							"if (document.currentScript && document.currentScript.tagName.toUpperCase() === 'SCRIPT')",
 							Template.indent(`scriptUrl = document.currentScript.src;`),
 							"if (!scriptUrl) {",
 							Template.indent([
