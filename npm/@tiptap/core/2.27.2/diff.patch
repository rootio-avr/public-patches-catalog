@@ -0,0 +1,33 @@
+// Regression test for AIKIDO-2026-613639 (GHSA-cp6q-959q-f8rh, CWE-1321/CWE-79):
+// mergeAttributes() must not let untrusted HTML attributes change the merged
+// object's prototype. Grounded on the upstream test added in the fix commit
+// (packages/core/__tests__/mergeAttributes.spec.ts,
+// "should not inherit attributes from an own __proto__ key").
+const assert = require('node:assert')
+const { mergeAttributes } = require('@tiptap/core')
+
+// A "__proto__" key coming from untrusted JSON must be set as an own data
+// property, NOT walked up the prototype chain / used to pollute Object.prototype.
+const attributes = mergeAttributes(
+  JSON.parse(
+    '{"__proto__":{"data-inherited-canary":"present","src":"x-invalid://canary","onerror":"boom"}}',
+  ),
+)
+
+// Prototype must remain the plain Object prototype (no pollution).
+assert.strictEqual(Object.getPrototypeOf(attributes), Object.prototype)
+// "__proto__" must be an own, enumerable data property on the result.
+assert.strictEqual(Object.prototype.hasOwnProperty.call(attributes, '__proto__'), true)
+// The nested payload keys must NOT have been inherited onto the object.
+assert.strictEqual(attributes['data-inherited-canary'], undefined)
+assert.strictEqual(attributes.src, undefined)
+assert.strictEqual(attributes.onerror, undefined)
+// Object.prototype itself must not have been polluted.
+assert.strictEqual({}['data-inherited-canary'], undefined)
+
+// Sanity: normal, benign merging still works as before.
+const merged = mergeAttributes({ class: 'a' }, { class: 'b' }, { style: 'color: red' })
+assert.strictEqual(merged.class, 'a b')
+assert.strictEqual(merged.style, 'color: red')
+
+console.log('AIKIDO-2026-613639 regression test passed')
