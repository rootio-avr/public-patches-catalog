+// Regression test for CVE-2026-53571
+// vite fs.deny bypass via NTFS Alternate Data Streams (`::$DATA`) and
+// Windows 8.3 short names (`~`). Grounded on the upstream playground
+// fs-serve matrix cases `unsafe-dotenv-ntfs-ads` and
+// `unsafe-dotenv-83-short-name`, which the dist-only npm package does not ship.
+//
+// The exported `isFileLoadingAllowed(config, filePath)` must return `false`
+// for a path that would otherwise be allowed once a `:` (NTFS ADS) suffix is
+// appended, since that stream resolves to the same underlying file content.
+import assert from 'node:assert'
+import { isFileLoadingAllowed } from 'vite'
+
+// Minimal config that would otherwise ALLOW the file: strict fs on, the
+// allow-list contains the serving root, and no deny globs / safe paths match.
+function makeConfig(root) {
+  return {
+    server: {
+      fs: {
+        strict: true,
+        allow: [root],
+      },
+    },
+    fsDenyGlob: () => false,
+    safeModulePaths: new Set(),
+  }
+}
+
+const root = '/project/root'
+const allowedFile = `${root}/src/main.js`
+
+// Sanity: a normal in-root file is allowed (guards against a test that
+// trivially denies everything).
+assert.strictEqual(
+  isFileLoadingAllowed(makeConfig(root), allowedFile),
+  true,
+  'a normal in-root file must still be allowed',
+)
+
+// NTFS ADS bypass: appending `::$DATA` must be denied because of the colon.
+assert.strictEqual(
+  isFileLoadingAllowed(makeConfig(root), `${root}/src/.env::$DATA`),
+  false,
+  'path containing a colon (NTFS ADS) must be denied',
+)
+
+// A bare colon anywhere in the path is likewise denied.
+assert.strictEqual(
+  isFileLoadingAllowed(makeConfig(root), `${root}/src/.env:stream`),
+  false,
+  'path containing a colon must be denied',
+)
+
+console.log('CVE-2026-53571 regression test passed')
