+++ b/test/cve-2026-27903.test.js
@@ -0,0 +1,39 @@
+// GHSA-7r86-cg39-jmmj / CVE-2026-27903
+// Patterns with many non-adjacent ** portions must not take
+// exponential time to match.
+var t = require('tap')
+var minimatch = require('../')
+
+function repeat (s, n) {
+  return new Array(n + 1).join(s)
+}
+
+t.test('many non-adjacent globstars are fast', function (t) {
+  var k = 50
+  var pattern = repeat('**/a/', k) + 'b/**'
+  var patha = repeat('a/', 100) + 'a'
+  var pathb = repeat('a/', 100) + 'b/c/d/.e/a/b'
+
+  var start = Date.now()
+  t.equal(minimatch(patha, pattern), false)
+  t.ok(Date.now() - start < 1000, 'mismatch found in under 1s')
+
+  start = Date.now()
+  t.equal(minimatch(pathb, pattern, { dot: true }), true)
+  t.ok(Date.now() - start < 1000, 'match found in under 1s')
+
+  start = Date.now()
+  t.equal(minimatch(pathb, pattern), false)
+  t.ok(Date.now() - start < 1000, 'dot mismatch found in under 1s')
+  t.end()
+})
+
+t.test('globstar matching is unchanged', function (t) {
+  t.equal(minimatch('a/b/x/y/z/c', 'a/**/b/**/c'), true)
+  t.equal(minimatch('a/x/y/z/b/c', 'a/**/b/**/c'), true)
+  t.equal(minimatch('a/b/c', 'a/**/b/**/c'), true)
+  t.equal(minimatch('a/x/y/z', 'a/**/b/**/c'), false)
+  t.equal(minimatch('a/.x/b', 'a/**/b'), false)
+  t.equal(minimatch('a/.x/b', 'a/**/b', { dot: true }), true)
+  t.end()
+})
