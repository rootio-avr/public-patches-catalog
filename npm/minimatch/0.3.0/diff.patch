@@ -0,0 +1,43 @@
+// CVE-2022-3517: the brace-expansion shortcut regexp /\{.*\}/ backtracks
+// quadratically on a long pattern containing many "{" and no closing "}".
+var tap = require("tap")
+  , minimatch = require("../")
+
+function repeat (s, n) {
+  return new Array(n + 1).join(s)
+}
+
+tap.test("many unclosed braces do not cause ReDoS", function (t) {
+  var pattern = repeat("{", 60000) + "a"
+  var start = Date.now()
+  minimatch.braceExpand(pattern)
+  var ms = Date.now() - start
+  t.ok(ms < 1000, "braceExpand took " + ms + "ms (< 1s)")
+
+  start = Date.now()
+  minimatch("a", pattern)
+  ms = Date.now() - start
+  t.ok(ms < 1000, "minimatch took " + ms + "ms (< 1s)")
+  t.end()
+})
+
+tap.test("brace expansion is unchanged for normal patterns", function (t) {
+  t.same(minimatch.braceExpand("a{b,c}d"), ["abd", "acd"])
+  t.same(minimatch.braceExpand("a{b}c"), ["a{b}c"])
+  t.same(minimatch.braceExpand("a{b,c{d,e}f}g"), ["abg", "acdfg", "acefg"])
+  t.same(minimatch.braceExpand("{a,b}", { nobrace: true }), ["{a,b}"])
+  t.end()
+})
+
+tap.test("invalid patterns are rejected before the cache lookup", function (t) {
+  ; [undefined, null, 1, {}, []].forEach(function (p) {
+    t.throws(function () { minimatch("a", p) }, TypeError)
+    t.throws(function () { new minimatch.Minimatch(p) }, TypeError)
+    t.throws(function () { minimatch.braceExpand(p) }, TypeError)
+  })
+  var tooLong = repeat("a", 1024 * 64 + 1)
+  t.throws(function () { minimatch("a", tooLong) }, TypeError)
+  t.throws(function () { new minimatch.Minimatch(tooLong) }, TypeError)
+  t.throws(function () { minimatch.braceExpand(tooLong) }, TypeError)
+  t.end()
+})

