+var t = require('tap')
+var minimatch = require('../')
+
+// Deeply nested extglobs used to generate regular expressions with
+// nested quantifiers, which backtrack catastrophically on a near-miss.
+// [pattern, number of "a" chars in the subject]
+var cases = [
+  ['*(+(*(a|b)|c)|d)', 15],
+  ['*(*(*(*(*(*(a|f)|g)|h)|i)|j)|k)', 15],
+  ['*(+(*(+(*(+(a|m)|n)|o)|p)|q)|r)', 15],
+  ['*(*(+(+(?(@(a|t)|u)|v)|w)|x)|y)', 15],
+  ['*(*(*(a|a)))', 15],
+  ['*(*(*(a|c)))', 17],
+  ['*(*(*(a|e)))', 19],
+  ['*(*(a|g))', 23],
+  ['*(a|i)', 101]
+]
+
+cases.forEach(function (c) {
+  var pattern = c[0]
+  var subject = new Array(c[1] + 1).join('a') + 'z'
+  var start = Date.now()
+  minimatch(subject, pattern)
+  var ms = Date.now() - start
+  t.ok(ms < 100, pattern + ' chars=' + c[1] + ' ms=' + ms)
