--- /dev/null
+++ b/test/pathological.js
@@ -0,0 +1,29 @@
+'use strict';
+
+/*eslint-env node,mocha*/
+
+var linkify = require('../');
+
+
+describe('pathological cases', function () {
+
+  it('should not hang on fuzzy links followed by an email marker', function () {
+    // ~1 MiB input
+    linkify().match('a.com '.repeat(174762) + '@');
+  }).timeout(10000);
+
+  it('should not hang on fuzzy emails followed by a link marker', function () {
+    // ~1 MiB input
+    linkify().match('a@b.com '.repeat(131071) + '.com');
+  }).timeout(10000);
+
+  it('should return all matches in order on repeated fuzzy input', function () {
+    var res = linkify().match('a.com b@c.com http://d.com e.org');
+
+    if (!res || res.length !== 4) { throw new Error('expected 4 matches, got ' + (res && res.length)); }
+    if (res[0].url !== 'http://a.com' || res[1].url !== 'mailto:b@c.com' ||
+        res[2].url !== 'http://d.com' || res[3].url !== 'http://e.org') {
+      throw new Error('unexpected matches: ' + JSON.stringify(res));
+    }
+  });
+});

