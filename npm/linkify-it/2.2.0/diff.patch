+'use strict';
+
+/*eslint-env node,mocha*/
+
+var linkify = require('../');
+
+// Regression test for CVE-2026-48801 (CWE-1333): quadratic blow-up in the
+// fuzzy link / email scanner. Before the fix, `match()` re-scanned the tail
+// of the string from scratch after every hit, so pathological inputs made of
+// many fuzzy candidates followed by a trailing marker took quadratic time and
+// could hang the process. The reworked scanner checks each pattern once with
+// global regexps, so these ~1 MiB inputs must complete quickly.
+
+describe('CVE-2026-48801: fuzzy scan DoS', function () {
+
+  it('should not hang on fuzzy links followed by an email marker', function () {
+    // ~1 MiB input
+    linkify().match('a.com '.repeat(174762) + '@');
+  }).timeout(10000);
+
+  it('should not hang on fuzzy emails followed by a link marker', function () {
+    // ~1 MiB input
+    linkify().match('a@b.com '.repeat(131071) + '.com');
+  }).timeout(10000);
+});
