Restrict scan length in email name and http auth

CVE-2026-59887: Bound the email local-part and HTTP auth scan lengths in
lib/re.mjs so the mailto: validator (and http auth parser) can no longer be
re-invoked at every occurrence and scan the remaining input to the end,
which caused quadratic (O(n^2)) CPU consumption / DoS on attacker-controlled
text such as `mailto:mailto:...`. Caps re.src_auth to {1,50} and
re.src_email_name to {0,63} (RFC 5321).

--- a/lib/re.mjs
+++ b/lib/re.mjs
@@ -31,7 +31,9 @@ export default function (opts) {
     '(?:(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)'

   // Prohibit any of "@/[]()" in user/pass to avoid wrong domain fetch.
-  re.src_auth = '(?:(?:(?!' + re.src_ZCc + '|[@/\\[\\]()]).)+@)?'
+  // Length is capped to exclude possible rescans till the end and avoid O(n^2)
+  // DoS. No standard limit, just take something reasonable.
+  re.src_auth = '(?:(?:(?!' + re.src_ZCc + '|[@/\\[\\]()]).){1,50}@)?'

   re.src_port =

@@ -88,9 +90,11 @@ export default function (opts) {

   // Allow anything in markdown spec, forbid quote (") at the first position
   // because emails enclosed in quotes are far more common
+  // Max name length capped to 64 chars (RFC 5321). This also prevents O(n^2)
+  // rescans to the end on inputs like `mailto:mailto:...`
   re.src_email_name =

-    '[\\-;:&=\\+\\$,\\.a-zA-Z0-9_][\\-;:&=\\+\\$,\\"\\.a-zA-Z0-9_]*'
+    '[\\-;:&=\\+\\$,\\.a-zA-Z0-9_][\\-;:&=\\+\\$,\\"\\.a-zA-Z0-9_]{0,63}'

   re.src_xn =
