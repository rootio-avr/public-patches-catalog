Description: CVE-2026-67213 - nanoid customAlphabet infinite loop on size <= 0 (React Native)
 When customAlphabet in async/index.native.js is called with a size of 0 or a
 negative number, the generator never reaches the exit condition (id.length === size),
 causing an unbounded loop that exhausts CPU/memory. nanoid 3.3.17 already includes
 the upstream fix in all other entry points; this backports the remaining React Native
 fix from 3.3.18 (upstream f9d13f150847d117877adee3460a46eceb0cf49b).
Origin: upstream, https://github.com/ai/nanoid/commit/f9d13f150847d117877adee3460a46eceb0cf49b
--- a/async/index.native.js
+++ b/async/index.native.js
@@ -20,7 +20,10 @@
       return tick(id, size)
     })
 
-  return size => tick('', size)
+  return (size = defaultSize) => {
+    if (size <= 0) return Promise.resolve('')
+    return tick('', size)
+  }
 }
 
 let nanoid = (size = 21) =>
