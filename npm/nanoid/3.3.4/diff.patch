 let customAlphabet = (alphabet, defaultSize = 21) => {
   return (size = defaultSize) => {
     let id = ''
+    // `> 0` stops a negative size from looping forever.
     let i = size
-    while (i--) {
+    while (i-- > 0) {
       id += alphabet[(Math.random() * alphabet.length) | 0]
     }
     return id
