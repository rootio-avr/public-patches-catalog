--- /dev/null
+++ b/test/cve-2026-67213.test.js
@@ -0,0 +1,55 @@
+let { test } = require('uvu')
+let { is } = require('uvu/assert')
+
+let browser = require('../index.browser.js')
+let node = require('../index.js')
+let asyncNode = require('../async/index.js')
+let asyncBrowser = require('../async/index.browser.js')
+
+test.before(() => {
+  global.crypto = {
+    getRandomValues(array) {
+      for (let i = 0; i < array.length; i++) {
+        array[i] = Math.floor(Math.random() * 256)
+      }
+      return array
+    }
+  }
+})
+
+test.after(() => {
+  delete global.crypto
+})
+
+// Regression test for CVE-2026-67213: customAlphabet/customRandom entered an
+// infinite loop (CWE-835) when called with a zero or negative size. The fix
+// returns an empty string for size <= 0 instead of looping forever.
+
+for (let type of ['node', 'browser']) {
+  let lib = type === 'node' ? node : browser
+
+  test(`${type} / customAlphabet / is ready for 0 and negative size`, () => {
+    is(lib.customAlphabet('abc')(0), '')
+    is(lib.customAlphabet('abc', 0)(), '')
+    is(lib.customAlphabet('abc')(-1), '')
+    is(lib.customAlphabet('abc', -5)(), '')
+  })
+
+  test(`${type} / customRandom / is ready for 0 size`, () => {
+    let nanoid0 = lib.customRandom('abc', 5, size => new Uint8Array(size))
+    is(nanoid0(0), '')
+  })
+}
+
+for (let type of ['node', 'browser']) {
+  let lib = type === 'node' ? asyncNode : asyncBrowser
+
+  test(`async ${type} / customAlphabet / is ready for 0 and negative size`, async () => {
+    is(await lib.customAlphabet('abc')(0), '')
+    is(await lib.customAlphabet('abc', 0)(), '')
+    is(await lib.customAlphabet('abc')(-1), '')
+    is(await lib.customAlphabet('abc', -5)(), '')
+  })
+}
+
+test.run()

Description: CVE-2026-73086 - integer overflow in fillPool corrupts CSPRNG pool
 nanoid(size) coerces size with `size |= 0` / `size -= 0`, so values like
 2147483648 wrap to negative and corrupt the process-wide poolOffset, causing
 subsequent IDs to become the deterministic string "uuuuuuuuuuuuuuuuuuuuu".
 Backports upstream commits 821dfed7 and b0036ed6 (nanoid 3.3.12).
Origin: upstream, https://github.com/ai/nanoid/commit/821dfed7b5db7f88e92f56c60eef32c8135077c3
