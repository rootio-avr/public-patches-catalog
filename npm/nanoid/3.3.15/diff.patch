Description: CVE-2026-67214 - nanoid/non-secure infinite loop on negative size
 When nanoid or customAlphabet from nanoid/non-secure is called with a negative
 size, `while (i--)` never terminates. Upstream fix uses `while (i-- > 0)` so
 negative sizes yield '' (same as size 0).
Origin: upstream, https://github.com/ai/nanoid/pull/600
--- a/non-secure/index.cjs
+++ b/non-secure/index.cjs
@@ -5,7 +5,7 @@
   return (size = defaultSize) => {
     let id = ''
     let i = size | 0
-    while (i--) {
+    while (i-- > 0) {
       id += alphabet[(Math.random() * alphabet.length) | 0]
     }
     return id
@@ -15,7 +15,7 @@
 let nanoid = (size = 21) => {
   let id = ''
   let i = size | 0
-  while (i--) {
+  while (i-- > 0) {
     id += urlAlphabet[(Math.random() * 64) | 0]
   }
   return id
