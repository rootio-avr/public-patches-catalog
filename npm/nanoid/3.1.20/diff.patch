Description: CVE-2026-67213 - nanoid customAlphabet/customRandom infinite loop on size <= 0
 When customAlphabet/customRandom (and the async variants) are called with a
 size of 0 or a negative number, the generator never reaches the exit condition
 (id.length === size), causing an unbounded loop that exhausts CPU/memory. This
 backports upstream fix f9d13f150847d117877adee3460a46eceb0cf49b to short-circuit
 and return an empty string for size <= 0. Adapted for nanoid@3.1.20 API where
 size is closed over at customAlphabet/customRandom creation time. Test-file
 hunks omitted because the published npm tarball ships no test/ dir. Also covers
 index.cjs, async/index.cjs, index.dev.js, and index.prod.js (package entrypoints).
Origin: upstream, https://github.com/ai/nanoid/commit/f9d13f150847d117877adee3460a46eceb0cf49b
--- a/async/index.browser.js
+++ b/async/index.browser.js
@@ -26,6 +26,7 @@
   let step = -~((1.6 * mask * size) / alphabet.length)
 
   return () => {
+    if (size <= 0) return Promise.resolve('')
     let id = ''
     while (true) {
       let bytes = crypto.getRandomValues(new Uint8Array(step))
--- a/async/index.cjs
+++ b/async/index.cjs
@@ -50,7 +50,10 @@
       return tick(id)
     })
 
-  return () => tick('')
+  return () => {
+    if (size <= 0) return Promise.resolve('')
+    return tick('')
+  }
 }
 
