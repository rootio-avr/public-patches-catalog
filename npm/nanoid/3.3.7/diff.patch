+++ b/test/cve-2026-73086.test.cjs
@@ -0,0 +1,39 @@
+let { test } = require('uvu')
+let { throws, not } = require('uvu/assert')
+
+let node = require('../index.js')
+
+test.before(() => {
+  global.crypto = {
+    getRandomValues(array) {
+      for (let i = 0; i < array.length; i++) {
+        array[i] = Math.floor(Math.random() * 256)
+      }
+      return array
+    }
+  }
+})
+
+test.after(() => {
+  delete global.crypto
+})
+
+// Regression test for CVE-2026-73086: nanoid must reject negative or
+// oversized ID lengths instead of allowing a pool-breaking allocation.
+test('nanoid throws on negative or too big ID length', () => {
+  throws(() => {
+    node.nanoid(2147483648)
+  }, /Wrong ID size|Invalid typed array length/)
+  throws(() => {
+    node.nanoid(-10)
+  }, /Wrong ID size|Invalid typed array length/)
+  throws(() => {
+    node.nanoid(1025)
+  }, /Wrong ID size/)
+  // A valid call after a rejected one still produces fresh, distinct IDs.
+  let a = node.nanoid()
+  let b = node.nanoid()
+  not.equal(a, b)
+})
+
+test.run()
