+'use strict'
+// Regression test for CVE-2026-0775 (ZDI-26-043 / ZDI-CAN-25430):
+// promise-inflight's optional `require('bluebird')` must never load a bluebird
+// that resolves OUTSIDE this package's trusted node_modules tree (e.g. a
+// world-writable drive-root C:\node_modules on Windows). The hardened module
+// only accepts a bluebird whose resolved path starts with the trusted
+// node_modules root; anything else falls back to the native Promise.
+const test = require('tap').test
+const path = require('path')
+
+// The trust predicate used by the patched inflight.js. Kept in sync with the
+// inline guard: accept only paths inside path.dirname(__dirname of the module).
+function isTrusted (resolvedPath, moduleDir) {
+  const trustedRoot = path.dirname(moduleDir) + path.sep
+  return typeof resolvedPath === 'string' && resolvedPath.indexOf(trustedRoot) === 0
+}
+
+test('untrusted drive-root bluebird is rejected (CVE-2026-0775)', function (t) {
+  const moduleDir = path.join(path.sep + 'opt', 'npm', 'node_modules', 'promise-inflight')
+  // Attacker-planted module at the world-writable drive root.
+  const untrusted = path.join(path.sep + 'node_modules', 'bluebird', 'index.js')
+  t.notOk(isTrusted(untrusted, moduleDir),
+    'drive-root node_modules bluebird must not be trusted')
+  // A sibling inside the trusted tree is still accepted (functionality preserved).
+  const trusted = path.join(path.sep + 'opt', 'npm', 'node_modules', 'bluebird', 'js', 'release', 'bluebird.js')
+  t.ok(isTrusted(trusted, moduleDir),
+    'bluebird inside the trusted node_modules tree is accepted')
+  t.end()
+})
+
+test('inflight still works with the safe fallback', function (t) {
+  const inflight = require('../inflight.js')
+  let calls = 0
+  const doFly = function () { calls++; return 'ok' }
+  return Promise.all([
+    inflight('key', doFly),
+    inflight('key', doFly)
+  ]).then(function (results) {
+    t.equal(results[0], 'ok', 'inflight resolves the deferred value')
+    t.equal(calls, 1, 'concurrent calls with same key coalesce into one execution')
+  })
+})
