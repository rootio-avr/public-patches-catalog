+/* eslint-env node, mocha */
+'use strict';
+
+// Regression test for GHSA-vjh7-7g9h-fjfh:
+// ec.sign() must validate its message input. Malformed array-like input
+// (out-of-range / negative bytes) previously slipped through and could be
+// coerced into a nonce that is not bijective to the message, enabling nonce
+// (k) reuse and private-key recovery. The fix adds input validation so such
+// inputs throw instead of producing a signature.
+
+var assert = require('assert');
+var elliptic = require('../');
+
+describe('GHSA-vjh7-7g9h-fjfh - ec.sign input validation', function() {
+  var ec = new elliptic.ec('secp256k1');
+  var key = ec.keyFromPrivate(
+    '79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798', 'hex');
+
+  it('rejects array-like message with out-of-range bytes', function() {
+    assert.throws(function() {
+      ec.sign([256, 0, 0, 0], key);
+    });
+  });
+
+  it('rejects array-like message with negative bytes', function() {
+    assert.throws(function() {
+      ec.sign([-1, 0, 0, 0], key);
+    });
+  });
+
+  it('rejects array-like message with a non-integer length', function() {
+    assert.throws(function() {
+      ec.sign({ length: -1 }, key);
+    });
+  });
+
+  it('still signs and verifies a valid hex message', function() {
+    var sig = ec.sign('deadbeef', key);
+    assert.ok(ec.verify('deadbeef', sig, key));
+  });
+});
