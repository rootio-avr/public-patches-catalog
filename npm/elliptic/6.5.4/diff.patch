+'use strict';
+
+var assert = require('assert');
+var Signature = require('../lib/elliptic/ec/signature');
+
+function importDER(bytes) {
+  return Object.create(Signature.prototype)._importDER(bytes);
+}
+
+function zeros(n) {
+  var out = [];
+  for (var i = 0; i < n; i++)
+    out.push(0);
+  return out;
+}
+
+function run() {
+  // Canonical DER: r = 1, s = 1
+  assert.strictEqual(importDER([0x30, 0x06, 0x02, 0x01, 0x01, 0x02, 0x01, 0x01]), true);
+
+  // r or s with the high bit set and no zero padding (negative INTEGER)
+  assert.strictEqual(importDER([0x30, 0x06, 0x02, 0x01, 0x80, 0x02, 0x01, 0x01]), false);
+  assert.strictEqual(importDER([0x30, 0x06, 0x02, 0x01, 0x01, 0x02, 0x01, 0x80]), false);
+
+  // Long-form length of 128 bytes: canonical 0x81 0x80 is accepted,
+  // the BER-style padded 0x82 0x00 0x80 must be rejected
+  var body = [0x02, 0x01, 0x01, 0x02, 0x7b, 0x40].concat(zeros(122));
+  assert.strictEqual(body.length, 128);
+  assert.strictEqual(importDER([0x30, 0x81, 0x80].concat(body)), true);
+  assert.strictEqual(importDER([0x30, 0x82, 0x00, 0x80].concat(body)), false);
+}
+
+if (typeof describe === 'function') {
+  describe('CVE-2024-42461 DER signature malleability', function () {
+    it('rejects non-canonical (BER) ECDSA signatures', run);
+  });
+} else {
+  run();
+}
