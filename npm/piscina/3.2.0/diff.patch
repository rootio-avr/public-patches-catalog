@@ -0,0 +1,65 @@
+import { resolve } from 'path';
+import Piscina from '..';
+import { test } from 'tap';
+
+// Regression test for AIKIDO-2026-266277: Piscina must harden its options
+// against prototype pollution. User-controlled option reads must come from
+// own properties only, and pool.options must be stored on a null-prototype
+// object so a polluted Object.prototype cannot influence worker
+// configuration or pool defaults.
+
+test('pool.options is a null-prototype object', async ({ equal, teardown }) => {
+  const pool = new Piscina({
+    filename: resolve(__dirname, 'fixtures/eval.js'),
+    minThreads: 1,
+    maxThreads: 1
+  });
+  teardown(() => pool.destroy());
+
+  equal(Object.getPrototypeOf(pool.options), null);
+});
+
+test('execArgv is not tampered via Object.prototype', async ({ equal, teardown }) => {
+  (Object.prototype as any).execArgv = ['--not-a-real-flag'];
+  teardown(() => { delete (Object.prototype as any).execArgv; });
+
+  const pool = new Piscina({
+    filename: resolve(__dirname, 'fixtures/eval.js'),
+    minThreads: 1,
+    maxThreads: 1
+  });
+  teardown(() => pool.destroy());
+
+  equal(pool.options.execArgv, undefined);
+  equal(await pool.run('42'), 42);
+});
+
+test('env is not tampered via Object.prototype', async ({ equal, teardown }) => {
+  (Object.prototype as any).env = { NODE_OPTIONS: '--title=polluted' };
+  teardown(() => { delete (Object.prototype as any).env; });
+
+  const pool = new Piscina({
+    filename: resolve(__dirname, 'fixtures/eval.js'),
+    minThreads: 1,
+    maxThreads: 1
+  });
+  teardown(() => pool.destroy());
+
+  equal(pool.options.env, undefined);
+  equal(await pool.run('42'), 42);
+});
+
+test('run() options are read from own properties only', async ({ equal, teardown }) => {
+  (Object.prototype as any).filename = resolve(__dirname, 'fixtures/eval.js');
+  teardown(() => { delete (Object.prototype as any).filename; });
+
+  const pool = new Piscina({
+    filename: resolve(__dirname, 'fixtures/eval.js'),
+    minThreads: 1,
+    maxThreads: 1
+  });
+  teardown(() => pool.destroy());
+
+  // A polluted prototype must not leak into per-task run options.
+  equal(await pool.run('42', {}), 42);
+});
