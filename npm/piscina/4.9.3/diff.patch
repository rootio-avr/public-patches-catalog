+++ b/test/cve-2026-102992.ts
@@ -0,0 +1,23 @@
+import Piscina from '..';
+import { test } from 'tap';
+import { resolve } from 'path';
+
+// Options must never be resolved through a polluted Object.prototype.
+test('CVE-2026-102992: polluted Object.prototype does not leak into pool options', async ({ equal }) => {
+  const proto = Object.prototype as any;
+  proto.execArgv = ['--this-flag-does-not-exist'];
+  proto.env = { POLLUTED: '1' };
+  let pool : Piscina | undefined;
+  try {
+    pool = new Piscina({
+      filename: resolve(__dirname, 'fixtures/eval.js'),
+      minThreads: 1,
+      maxThreads: 1
+    });
+    equal(await pool.run('typeof process.env.POLLUTED'), 'undefined');
+  } finally {
+    delete proto.execArgv;
+    delete proto.env;
+    await pool?.destroy();
+  }
+});
