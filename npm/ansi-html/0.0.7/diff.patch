--- /dev/null
+++ b/test/cve-2021-23424.test.js
@@ -0,0 +1,28 @@
+var assert = require('assert')
+var ansiHTML = require('../')
+
+var ESC = String.fromCharCode(27) // \033 / 
+
+// Regression test for CVE-2021-23424 (ReDoS via nested quantifier in the
+// ANSI escape regex /\033\[(\d+)*m/). An escape sequence with a long run of
+// digits and no terminating "m" used to trigger catastrophic backtracking.
+describe('CVE-2021-23424', function () {
+  it('does not hang on a long digit run in an ANSI escape sequence', function () {
+    // Prefix a valid sequence so the internal _regANSI guard passes, then
+    // append the ReDoS trigger: ESC[ + a long digit run with no closing "m".
+    var evil = ESC + '[0m' + ESC + '[' + new Array(50000).join('1')
+    var start = Date.now()
+    var out = ansiHTML(evil)
+    var elapsed = Date.now() - start
+    assert.ok(typeof out === 'string')
+    assert.ok(elapsed < 2000, 'ansiHTML took too long (' + elapsed + 'ms), possible ReDoS')
+  })
+
+  it('still converts a normal ANSI sequence correctly', function () {
+    // ESC[30m ... ESC[39m maps to the black foreground open tag.
+    var openTag = ansiHTML.tags.open['30']
+    var expected = (openTag[0] === '<' ? openTag : ('<span style="' + openTag + ';">')) +
+      'x' + ansiHTML.tags.close['39']
+    assert.equal(ansiHTML(ESC + '[30mx' + ESC + '[39m'), expected)
+  })
+})
