+'use strict';
+const assert = require('node:assert');
+const simpleGit = require('..').default || require('..');
+
+async function rejection(promise) {
+   try {
+      await promise;
+   } catch (err) {
+      return err;
+   }
+}
+
+function message(err) {
+   return String((err && err.message) || err || '');
+}
+
+(async () => {
+   const blocked = [
+      ['-c', 'include.path=/tmp/sg-attacker.cfg', 'status'],
+      ['-c', 'includeIf.gitdir:/tmp/.path=/tmp/sg-attacker.cfg', 'status'],
+      ['-cinclude.path=/tmp/sg-attacker.cfg', 'status'],
+      ['--config-env=include.path=PWN', 'status'],
+      ['--conf=include.path=/tmp/sg-attacker.cfg', 'status'],
+      ['--conf', 'include.path=/tmp/sg-attacker.cfg', 'status'],
+      ['-vc', 'include.path=/tmp/sg-attacker.cfg', 'status'],
+      ['config', 'includeIf.gitdir:/tmp/.path', '/tmp/sg-attacker.cfg'],
+   ];
+
+   for (const args of blocked) {
+      const err = await rejection(simpleGit({ unsafe: {} }).raw(...args));
+      assert.ok(
+         /allowUnsafeInclude/.test(message(err)),
+         `expected ${JSON.stringify(args)} to be blocked, got: ${message(err)}`
+      );
+   }
+
+   const allowed = [
+      ['config', '--get', 'include.path'],
+      ['-c', 'core.includeCommit=true', 'version'],
+      ['-c', 'user.name=include.path', 'version'],
+   ];
+
+   for (const args of allowed) {
+      const err = await rejection(simpleGit({ unsafe: {} }).raw(...args));
+      assert.ok(
+         !/allowUnsafeInclude/.test(message(err)),
+         `expected ${JSON.stringify(args)} not to be blocked, got: ${message(err)}`
+      );
+   }
+
+   const err = await rejection(
+      simpleGit({ unsafe: { allowUnsafeInclude: true } }).raw('-c', 'include.path=/nonexistent', 'version')
+   );
+   assert.ok(!/allowUnsafeInclude/.test(message(err)), 'override should permit include.path');
+})().then(
+   () => console.log('cve-2026-102826: ok'),
+   (err) => {
+      console.error(err);
+      process.exit(1);
+   }
+);
