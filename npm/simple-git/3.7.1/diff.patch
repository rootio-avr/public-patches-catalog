+   return /allowUnsafePack|potential exploit argument blocked/.test(message(err));
+}
+
+async function run(label, mod) {
+   const simpleGit = mod.simpleGit || mod.default || mod;
+   const cmd = 'touch /tmp/cve-2026-28291-pwned';
+
+   for (const option of ['-u', '-vu', '-uv', '-qu', '-uq', '-lu', '-su', '-nu', '-ou', '-bu']) {
+      const err = await rejection(simpleGit({ baseDir: '/tmp', unsafe: {} }).clone('./first', './a', [option, cmd]));
+      assert.ok(isBlocked(err), `[${label}] expected clone with ${option} to be blocked, got: ${message(err)}`);
+
+      const overridden = await rejection(
+         simpleGit({ baseDir: '/tmp', unsafe: { allowUnsafePack: true } }).clone(
+            '/nonexistent/cve-2026-28291',
+            '/tmp/cve-2026-28291-out',
+            [option, 'true']
+         )
+      );
+      assert.ok(!isBlocked(overridden), `[${label}] allowUnsafePack should permit ${option}, got: ${message(overridden)}`);
+   }
+
+   const allowed = await rejection(
+      simpleGit({ baseDir: '/tmp', unsafe: {} }).clone('/nonexistent/cve-2026-28291', '/tmp/cve-2026-28291-out', ['--depth=1', '-v'])
+   );
+   assert.ok(!isBlocked(allowed), `[${label}] expected --depth=1 -v not to be blocked, got: ${message(allowed)}`);
+}
+
+(async () => {
+   await run('cjs', require('../dist/cjs/index.js'));
+   await run('esm', await import('../dist/esm/index.js'));
+})().then(
+   () => console.log('ok'),
+   (err) => {
+      console.error(err);
+      process.exit(1);
+   }
+);
