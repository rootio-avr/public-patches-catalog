+import { promiseError } from '@kwsites/promise-result';
+import {
+   assertExecutedCommands,
+   assertGitError,
+   closeWithSuccess,
+   newSimpleGit,
+} from '../__fixtures__';
+
+describe('blockUnsafeOperationsPlugin clone -u variants', () => {
+   it.each([
+      ['-u'],
+      ['-vu'],
+      ['-uv'],
+      ['-nu'],
+      ['-ul'],
+      ['-qu'],
+      ['-lsu'],
+      ['-u touch /tmp/pwn'],
+      ['\0-u'],
+   ])('blocks clone option %j without override', async (option) => {
+      const git = newSimpleGit({ unsafe: {} });
+      const err = await promiseError(git.raw('clone', option, 'sh -c "touch /tmp/pwn"'));
+
+      assertGitError(err, 'allowUnsafePack');
+   });
+
+   it('blocks clone option disguised in git.clone options', async () => {
+      const git = newSimpleGit({ unsafe: {} });
+      const err = await promiseError(git.clone('./first', './second', ['-vu', 'touch /tmp/pwn']));
+
+      assertGitError(err, 'allowUnsafePack');
+   });
+
+   it('allows combined -u switch for clone with override', async () => {
+      const git = newSimpleGit({ unsafe: { allowUnsafePack: true } });
+      const err = promiseError(git.raw('clone', '-vu', 'touch /tmp/pwn'));
+
+      await closeWithSuccess();
+      expect(await err).toBeUndefined();
+      assertExecutedCommands('clone', '-vu', 'touch /tmp/pwn');
+   });
+
+   it.each([['-v'], ['-q'], ['-n'], ['-b'], ['--no-checkout'], ['--depth=1']])(
+      'allows clone option %s',
+      async (option) => {
+         const git = newSimpleGit({ unsafe: {} });
+         const err = promiseError(git.raw('clone', option));
+
+         await closeWithSuccess();
+         expect(await err).toBeUndefined();
+         assertExecutedCommands('clone', option);
+      }
+   );
+
+   it('allows combined -u switch for non-clone commands', async () => {
+      const git = newSimpleGit({ unsafe: {} });
+      const err = promiseError(git.raw('push', '-vu', 'origin/main'));
+
+      await closeWithSuccess();
+      expect(await err).toBeUndefined();
+      assertExecutedCommands('push', '-vu', 'origin/main');
+   });
+});

