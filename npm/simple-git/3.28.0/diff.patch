+import { promiseError } from '@kwsites/promise-result';
+import {
+   assertExecutedCommands,
+   assertGitError,
+   closeWithSuccess,
+   newSimpleGit,
+} from '../__fixtures__';
+
+describe('blockUnsafeOperationsPlugin: trailer command configuration', () => {
+   it.each([
+      [['config', 'trailer.foo.command', '!touch /tmp/pwn']],
+      [['config', 'trailer.foo.cmd', '!touch /tmp/pwn']],
+      [['config', 'trailer.cmd', '!touch /tmp/pwn']],
+      [['config', 'Trailer.Foo.Command', '!touch /tmp/pwn']],
+      [['-c', 'trailer.foo.command=!touch /tmp/pwn', 'interpret-trailers']],
+      [['--config-env=trailer.foo.cmd=PWN', 'interpret-trailers']],
+   ])('blocks %j without the override', async (args) => {
+      const err = await promiseError(newSimpleGit({ unsafe: {} }).raw(args));
+
+      assertGitError(err, 'allowUnsafeCommandBinaries');
+   });
+
+   it('allows trailer command configuration with the override', async () => {
+      const git = newSimpleGit({ unsafe: { allowUnsafeCommandBinaries: true } });
+      const err = promiseError(git.raw('config', 'trailer.foo.command', 'echo'));
+
+      await closeWithSuccess();
+      expect(await err).toBeUndefined();
+      assertExecutedCommands('config', 'trailer.foo.command', 'echo');
+   });
+
+   it('allows unrelated trailer configuration', async () => {
+      const git = newSimpleGit({ unsafe: {} });
+      const err = promiseError(git.raw('config', 'trailer.foo.key', 'Signed-off-by'));
+
+      await closeWithSuccess();
+      expect(await err).toBeUndefined();
+      assertExecutedCommands('config', 'trailer.foo.key', 'Signed-off-by');
+   });
+});
