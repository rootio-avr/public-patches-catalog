+         return {
+            ...data,
+            env: {
+               ...(data.env ?? process.env),
+               GIT_TEST_DISALLOW_ABBREVIATED_OPTIONS: String(!allowAbbreviatedOptions),
+            },
+         };
+      },
+   };
+}

