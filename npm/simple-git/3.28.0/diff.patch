+'use strict';
+// Regression test for CVE-2026-102827: unsafe exec-path / config-path / rebase exec /
+// config-injection vectors must be rejected unless explicitly enabled.
+const assert = require('node:assert');
+const { simpleGit } = require('../dist/cjs/index.js');
+
+async function rejects(args, env, pattern) {
+   const git = simpleGit({ unsafe: {} }).env({ ...process.env, ...env });
+   await assert.rejects(git.raw(args), pattern, `expected ${JSON.stringify(args)} to be blocked`);
+}
+
+async function main() {
+   await rejects(['--exec-path=/tmp/evil', 'status'], {}, /allowUnsafeExec/);
+   await rejects(['--exec-path', '/tmp/evil', 'status'], {}, /allowUnsafeExec/);
+   await rejects(['--git-dir=/tmp/evil', 'status'], {}, /allowUnsafeConfigPaths/);
+   await rejects(['--work-tree', '/tmp/evil', 'status'], {}, /allowUnsafeConfigPaths/);
+   await rejects(['-C', '/tmp/evil', 'status'], {}, /allowUnsafeConfigPaths/);
+   await rejects(['rebase', '-x', 'touch /tmp/pwned', 'HEAD'], {}, /allowUnsafeExec/);
+   await rejects(['rebase', '--exec=touch /tmp/pwned', 'HEAD'], {}, /allowUnsafeExec/);
+   await rejects(['rebase', '--ex', 'touch /tmp/pwned', 'HEAD'], {}, /allowUnsafeExec/);
+   await rejects(['config', 'include.path', '/tmp/evil'], {}, /allowUnsafeInclude/);
+   await rejects(['-c', 'filter.lfs.process=/tmp/evil', 'status'], {}, /allowUnsafeFilter/);
+   await rejects(['config', 'submodule.x.update', '!touch /tmp/pwned'], {}, /allowUnsafeSubmodule/);
+   await rejects(['config', 'trailer.x.cmd', '/tmp/evil'], {}, /allowUnsafeCommandBinaries/);
+   await rejects(['-c', 'trailer.x.command=/tmp/evil', 'status'], {}, /allowUnsafeCommandBinaries/);
+   await rejects(['-c', 'url.https://evil/.insteadOf=https://good/', 'status'], {}, /allowUnsafeUrlRewrite/);
+   await rejects(['status'], { GIT_EXEC_PATH: '/tmp/evil' }, /allowUnsafeExec/);
+   await rejects(['status'], { VISUAL: '/tmp/evil' }, /allowUnsafeEditor/);
+
+   // explicitly opting in lifts the block
+   const opted = simpleGit({ unsafe: { allowUnsafeExec: true } });
+   await opted
+      .raw(['--exec-path=/tmp/evil', 'status'])
+      .catch((err) => assert.ok(!/allowUnsafeExec/.test(String(err.message)), String(err.message)));
+
+   // ordinary usage is unaffected by the new checks
+   const safeArgs = [['--version'], ['--exec-path']];
+   for (const args of safeArgs) {
+      await simpleGit({ unsafe: {} })
+         .raw(args)
+         .catch((err) => assert.ok(!/allowUnsafe/.test(String(err.message)), String(err.message)));
+   }
+}
+
+main().then(
+   () => console.log('cve-2026-102827 regression test passed'),
+   (err) => {
+      console.error(err);
+      process.exit(1);
+   }
+);
