+   [/^include\.path$/, 'allowUnsafeInclude', 'include.path'],
+   [/^includeif\..+\.path$/, 'allowUnsafeInclude', 'includeIf.<condition>.path'],
+   [/^submodule(\..+)?\.update$/, 'allowUnsafeSubmodule', 'submodule.update'],
+   [/^trailer(\..+)?\.(cmd|command)$/, 'allowUnsafeCommandBinaries', 'trailer.cmd'],
+   [/^url(\..+)?\.insteadof$/, 'allowUnsafeUrlRewrite', 'url.insteadOf'],
+];
