+import {
+   assertExecutedCommands,
+   assertGitError,
+   closeWithSuccess,
+   newSimpleGit,
+} from '../__fixtures__';
+
+describe('blockUnsafeOperationsPlugin: clone -u switch variants', () => {
+   it.each([
+      ['-u'],
+      ['-u touch /tmp/pwn'],
+      ['-vu'],
+      ['-uv'],
+      ['-qu'],
+      ['-nu'],
+      ['-lu'],
+      ['-ul'],
+      ['-su'],
+      ['-ou'],
+      ['-bu'],
+      ['-cu'],
+      ['-jvu'],
+      ['-6u'],
+      ['--no-u'],
+   ])('blocks clone with %j without the override', async (option) => {
+      const git = newSimpleGit({ unsafe: {} });
+      const err = await promiseError(git.clone('file:///tmp/zero12', '/tmp/zero12-out', [option]));
+
+      assertGitError(err, 'allowUnsafePack');
+   });
+
+   it('allows clone with a combined -u switch when using the override', async () => {
+      const git = newSimpleGit({ unsafe: { allowUnsafePack: true } });
+      const err = promiseError(git.clone('file:///tmp/zero12', '/tmp/zero12-out', ['-vu']));
+
+      await closeWithSuccess();
+      expect(await err).toBeUndefined();
+      assertExecutedCommands('clone', '-vu', 'file:///tmp/zero12', '/tmp/zero12-out');
+   });
+
+   it('allows other clone switches that do not include -u', async () => {
+      const git = newSimpleGit({ unsafe: {} });
+      const err = promiseError(git.clone('file:///tmp/zero12', '/tmp/zero12-out', ['-v', '-q']));
+
+      await closeWithSuccess();
+      expect(await err).toBeUndefined();
+      assertExecutedCommands('clone', '-v', '-q', 'file:///tmp/zero12', '/tmp/zero12-out');
+   });
+});

