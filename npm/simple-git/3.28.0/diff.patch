+import type { SpawnOptions } from 'child_process';
+
+import type { SimpleGitPlugin } from './simple-git-plugin';
+
+export function abbreviatedOptionsPlugin(
+   allowAbbreviatedOptions = false
+): SimpleGitPlugin<'spawn.options'> {
+   return {
+      type: 'spawn.options',
+      action(data: Partial<SpawnOptions>) {
+         return {
+            ...data,
+            env: {
+               ...(data.env ?? process.env),
+               GIT_TEST_DISALLOW_ABBREVIATED_OPTIONS: String(!allowAbbreviatedOptions),
+            },
+         };
+      },
+   };
+}

