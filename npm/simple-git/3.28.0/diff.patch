+'use strict';
+// Regression test for CVE-2026-102828: trailer.<token>.cmd / trailer.<token>.command
+// configuration must be blocked unless `unsafe.allowUnsafeCommandBinaries` is enabled.
+const assert = require('node:assert');
+const { test } = require('node:test');
+const { simpleGit } = require('../dist/cjs/index.js');
+
+const MALICIOUS = [
+   ['-c', 'trailer.foo.command=malicious', 'commit', '--allow-empty', '-m', 'x'],
+   ['-c', 'trailer.foo.cmd=malicious', 'commit', '--allow-empty', '-m', 'x'],
+   ['-c', 'Trailer.Foo.Command=malicious', 'commit', '--allow-empty', '-m', 'x'],
+   ['-c', 'trailer.cmd=malicious', 'commit', '--allow-empty', '-m', 'x'],
+   ['-c', 'trailer.fo\no.command=malicious', 'commit', '--allow-empty', '-m', 'x'],
+   ['--config-env=trailer.foo.cmd=MALICIOUS', 'interpret-trailers'],
+   ['config', 'trailer.foo.command', 'malicious'],
+];
+
+test('trailer command config is blocked by default', async () => {
+   for (const args of MALICIOUS) {
+      await assert.rejects(
+         () => simpleGit().raw(args),
+         /allowUnsafeCommandBinaries/,
+         `expected ${JSON.stringify(args)} to be blocked`
+      );
+   }
+});
+
+test('benign trailer config is not blocked by the command binaries guard', async () => {
+   try {
+      await simpleGit().raw(['-c', 'trailer.ifexists=add', '--version']);
+   } catch (err) {
+      assert.doesNotMatch(String(err && err.message), /allowUnsafeCommandBinaries/);
+   }
+});
+
+test('trailer command config is permitted when explicitly enabled', async () => {
+   try {
+      await simpleGit({ unsafe: { allowUnsafeCommandBinaries: true } }).raw([
+         '-c',
+         'trailer.foo.command=true',
+         '--version',
+      ]);
+   } catch (err) {
+      assert.doesNotMatch(String(err && err.message), /allowUnsafeCommandBinaries/);
+   }
+});

