--- /dev/null
+++ b/test/cve-2026-28291.test.js
@@ -0,0 +1,66 @@
+'use strict';
+// Regression test for CVE-2026-28291: `git.clone` must refuse the `-u` (upload-pack)
+// switch even when it is combined with other single character options.
+const assert = require('assert');
+const os = require('os');
+const fs = require('fs');
+const path = require('path');
+
+const simpleGit = require('../src');
+const { blockUnsafeOperationsPlugin } = require('../src/lib/plugins');
+
+function blocked(plugin, args, method) {
+   try {
+      plugin.action(args.slice(), { method });
+   } catch (e) {
+      assert.ok(/not permitted/.test(String(e && e.message)), 'unexpected error: ' + e);
+      return true;
+   }
+   return false;
+}
+
+const plugin = blockUnsafeOperationsPlugin();
+const payload = 'sh -c "touch /tmp/pwned"';
+
+// plain and disguised forms of `-u` are all rejected for clone
+for (const switches of ['-u', '-vu', '-uv', '-qu', '-nu', '-lu', '-su', '-4u', '-6u', '-ul', ' -u', '--u', '--upload-pack=x']) {
+   assert.ok(blocked(plugin, ['clone', switches, payload, './first', './second'], 'clone'), `${switches} must be blocked`);
+}
+
+// ordinary clone arguments are still allowed
+for (const args of [['clone', './first', './second'], ['clone', '--bare', './first', './second'], ['clone', '-b', 'main', './first', './second']]) {
+   assert.ok(!blocked(plugin, args, 'clone'), `${args.join(' ')} must be allowed`);
+}
+
+// attached values of options that take one are not bundled switches
+for (const args of [['clone', '-cuser.name=x', './first', './second'], ['clone', '-cuser.email=u@u', './first'], ['clone', '-bbuild', './first'], ['clone', '-ouser', './first'], ['clone', '-j4', './first']]) {
+   assert.ok(!blocked(plugin, args, 'clone'), `${args.join(' ')} must be allowed`);
+}
+// ...but a switch bundled before the value is still blocked
+for (const switches of ['-vuc', '-4u', '-qub']) {
+   assert.ok(blocked(plugin, ['clone', switches, payload, './first'], 'clone'), `${switches} must be blocked`);
+}
+
+// opting in restores the old behaviour
+assert.ok(!blocked(blockUnsafeOperationsPlugin({ allowUnsafePack: true }), ['clone', '-vu', payload], 'clone'));
+
+// end to end through the public API: rejected before any process is spawned
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'cve-2026-28291-'));
+const pwned = path.join(root, 'touched');
+
+(async () => {
+   for (const switches of ['-u', '-vu', '-uv']) {
+      let error;
+      try {
+         await simpleGit(root).clone('./first', './second', [switches, `sh -c "touch ${pwned}"`]);
+      } catch (e) {
+         error = e;
+      }
+      assert.ok(error, `clone with ${switches} must be rejected`);
+      assert.ok(!fs.existsSync(pwned), 'payload must not run');
+   }
+   console.log('CVE-2026-28291 regression test passed');
+})().catch((e) => {
+   console.error(e);
+   process.exit(1);
+});
