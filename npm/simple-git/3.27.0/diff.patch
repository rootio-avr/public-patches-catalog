+// Regression test for CVE-2026-28292: `protocol.allow` override check must be case-insensitive.
+const assert = require('node:assert');
+const { simpleGit } = require('../dist/cjs/index.js');
+
+const variants = [
+  'protocol.allow=always',
+  'PROTOCOL.ALLOW=always',
+  'Protocol.Allow=always',
+  'PROTOCOL.allow=always',
+  'protocol.ALLOW=always',
+];
+
+(async () => {
+  for (const cmd of variants) {
+    const task = ['config', '-c', cmd, 'config', '--list'];
+
+    let blocked;
+    try {
+      await simpleGit().raw(...task);
+    } catch (e) {
+      blocked = e;
+    }
+    assert.ok(blocked, `expected ${cmd} to be blocked`);
+    assert.ok(
+      /allowUnsafeExtProtocol/.test(String(blocked.message)),
+      `expected unsafe protocol error for ${cmd}, got: ${blocked.message}`
+    );
+
+    // with the explicit override the plugin must not block the call
+    try {
+      await simpleGit({ unsafe: { allowUnsafeProtocolOverride: true } }).raw(...task);
+    } catch (e) {
+      assert.ok(
+        !/allowUnsafeExtProtocol/.test(String(e.message)),
+        `override should permit ${cmd}`
+      );
+    }
+  }
+  console.log('cve-2026-28292 ok');
+})().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});

