+++ b/test/cve-2026-102826.test.js
@@ -0,0 +1,49 @@
+'use strict';
+
+const assert = require('node:assert');
+const os = require('node:os');
+const { test } = require('node:test');
+const simpleGit = require('../dist/cjs/index.js').simpleGit;
+
+const cwd = os.tmpdir();
+const evil = '/tmp/evil.gitconfig';
+
+async function rejection(task) {
+  try {
+    await task;
+  } catch (e) {
+    return e;
+  }
+  return undefined;
+}
+
+test('clone customArgs include.path is blocked by default', async () => {
+  const err = await rejection(
+    simpleGit(cwd).clone('https://example.invalid/repo.git', '/tmp/cve-2026-102826-target', [
+      '-c',
+      `include.path=${evil}`,
+    ])
+  );
+  assert.ok(err, 'expected the clone to be rejected');
+  assert.match(String(err.message || err), /allowUnsafeInclude/);
+});
+
+test('inline includeIf.<condition>.path config is blocked by default', async () => {
+  for (const args of [
+    ['-c', `includeIf.gitdir:/tmp/.path=${evil}`, 'status'],
+    [`--config-env=include.path=EVIL_PATH`, 'status'],
+    ['--config-env', 'include.path=EVIL_PATH', 'status'],
+    ['config', 'include.path', evil],
+  ]) {
+    const err = await rejection(simpleGit(cwd).raw(...args));
+    assert.ok(err, `expected rejection for ${args.join(' ')}`);
+    assert.match(String(err.message || err), /allowUnsafeInclude/);
+  }
+});
+
+test('allowUnsafeInclude opt-in is not rejected by the plugin', async () => {
+  const err = await rejection(
+    simpleGit(cwd, { unsafe: { allowUnsafeInclude: true } }).raw('-c', 'include.path=/nonexistent', 'version')
+  );
+  assert.ok(!err || !/allowUnsafeInclude/.test(String(err.message || err)));
+});

