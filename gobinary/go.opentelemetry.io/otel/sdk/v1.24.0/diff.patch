+func TestHostIDReaderDarwinUsesFullIoregPath(t *testing.T) {
+	var gotName string
+	var gotArgs []string
+	reader := hostIDReaderDarwin{
+		execCommand: func(name string, args ...string) (string, error) {
+			gotName = name
+			gotArgs = args
+			return `"IOPlatformUUID" = "81895B8D-9EF9-4EBB-B5DE-B00069CF53F0"`, nil
+		},
+	}
+
+	hostID, err := reader.read()
+	require.NoError(t, err)
+	require.Equal(t, "81895B8D-9EF9-4EBB-B5DE-B00069CF53F0", hostID)
+	require.Equal(t, "/usr/sbin/ioreg", gotName)
+	require.Equal(t, []string{"-rd1", "-c", "IOPlatformExpertDevice"}, gotArgs)
+}

