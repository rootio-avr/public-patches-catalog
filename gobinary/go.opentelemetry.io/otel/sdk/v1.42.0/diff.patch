+// TestHostIDReaderBSDUsesAbsoluteKenvPath is a regression test for
+// CVE-2026-39883 (GHSA-hfvc-g4fc-pqhx). The BSD host id reader must invoke
+// kenv using an absolute path (/bin/kenv) rather than resolving "kenv" via
+// $PATH, which could allow an attacker-controlled binary earlier in PATH to
+// be executed (CWE-426: Untrusted Search Path).
+func TestHostIDReaderBSDUsesAbsoluteKenvPath(t *testing.T) {
+	var gotName string
+	capturingExec := func(name string, _ ...string) (string, error) {
+		gotName = name
+		return expectedHostID + "\n", nil
+	}
+
+	reader := hostIDReaderBSD{
+		// Force fallback to the command executor by failing the file read.
+		readFile:    readFileError,
+		execCommand: capturingExec,
+	}
+
+	hostID, err := reader.read()
+	require.NoError(t, err)
+	require.Equal(t, expectedHostID, hostID)
+	require.Equal(t, "/bin/kenv", gotName,
+		"kenv must be invoked with an absolute path to avoid untrusted PATH lookup")
+	require.NotEqual(t, "kenv", gotName,
+		"kenv must not be resolved via $PATH")
+}
