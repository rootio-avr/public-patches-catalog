+package transport
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+// TestTLSListenerHandshakeTimeout is a regression test for CVE-2026-73500.
+//
+// A client that opens a TCP connection to a TLS listener but never drives the
+// TLS handshake to completion used to tie up the accept-loop handshake
+// goroutine indefinitely, allowing a trivial resource-exhaustion DoS. The fix
+// installs a bounded per-connection deadline (tlsHandshakeTimeout) before
+// calling Handshake(), so a stalled handshake now fails and the server closes
+// the connection instead of blocking forever.
+func TestTLSListenerHandshakeTimeout(t *testing.T) {
+	// The fix must bound the handshake with a positive, finite deadline.
+	if tlsHandshakeTimeout <= 0 {
+		t.Fatalf("tlsHandshakeTimeout must be a positive duration, got %v", tlsHandshakeTimeout)
+	}
+
+	tlsInfo, del, err := createSelfCert()
+	if err != nil {
+		t.Fatalf("unable to create self-signed cert: %v", err)
+	}
+	defer del()
+
+	ln, err := NewListener("127.0.0.1:0", "https", tlsInfo)
+	if err != nil {
+		t.Fatalf("unexpected NewListener error: %v", err)
+	}
+	defer ln.Close()
+
+	// Stalled client: establish TCP, then never send any TLS handshake bytes.
+	rawConn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatalf("unexpected Dial error: %v", err)
+	}
+	defer rawConn.Close()
+
+	// With the deadline in place the server aborts the handshake and closes the
+	// connection, so a client read must observe EOF/error within a bounded time
+	// (tlsHandshakeTimeout plus scheduling margin). Without the fix this read
+	// would block until the outer test deadline.
+	deadline := time.Now().Add(tlsHandshakeTimeout + 15*time.Second)
+	if err := rawConn.SetReadDeadline(deadline); err != nil {
+		t.Fatalf("unable to set read deadline: %v", err)
+	}
+
+	buf := make([]byte, 1)
+	_, readErr := rawConn.Read(buf)
+	if readErr == nil {
+		t.Fatal("expected the server to close the stalled handshake connection, but read succeeded")
+	}
+	if ne, ok := readErr.(net.Error); ok && ne.Timeout() {
+		t.Fatalf("stalled handshake was not bounded by tlsHandshakeTimeout: %v", readErr)
+	}
+}
