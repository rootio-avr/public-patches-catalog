+package transport
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// TestTLSListenerHandshakeTimeout is a regression test for CVE-2026-73500.
+//
+// A client that establishes a TCP connection to a TLS listener but never
+// drives the TLS handshake used to pin a handshake goroutine forever,
+// allowing an unauthenticated peer to accumulate unbounded goroutines. The
+// fix arms a per-connection handshake deadline (tlsHandshakeTimeout) before
+// tls.Conn.Handshake so a stalled handshake is torn down instead of blocking
+// indefinitely.
+func TestTLSListenerHandshakeTimeout(t *testing.T) {
+	// The bound must be positive and finite; a zero/negative value would
+	// disable the deadline and reintroduce the unbounded-goroutine leak.
+	require.Positive(t, tlsHandshakeTimeout, "handshake timeout must be a positive, finite bound")
+
+	tlsInfo, err := createSelfCert(t)
+	require.NoError(t, err)
+
+	ln, err := NewTLSListener(newLocalListener(t), tlsInfo)
+	require.NoError(t, err)
+	defer ln.Close()
+
+	// Dial with a plain TCP connection and never send a ClientHello, so the
+	// server-side tls.Conn.Handshake blocks waiting on us.
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	require.NoError(t, err)
+	defer conn.Close()
+
+	// Without the fix, the server goroutine blocks in Handshake forever and
+	// this Read blocks until the test deadline. With the fix, the handshake
+	// deadline fires and the server closes the connection, so the Read
+	// unblocks with an error well before an unbounded wait.
+	require.NoError(t, conn.SetReadDeadline(time.Now().Add(tlsHandshakeTimeout+5*time.Second)))
+	start := time.Now()
+	buf := make([]byte, 1)
+	_, readErr := conn.Read(buf)
+	elapsed := time.Since(start)
+
+	require.Error(t, readErr, "stalled handshake should be torn down by the server, not accepted")
+	require.Lessf(t, elapsed, tlsHandshakeTimeout+3*time.Second,
+		"server should tear down a stalled handshake within the handshake timeout, took %s", elapsed)
+}
+
+func newLocalListener(t *testing.T) net.Listener {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	return ln
+}
