+package transport
+
+import (
+	"crypto/tls"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// TestTLSListenerHandshakeTimeout verifies that a client which connects but
+// never completes the TLS handshake is dropped once tlsHandshakeTimeout
+// elapses, rather than holding the server-side goroutine and connection
+// forever (CVE-2026-73500).
+func TestTLSListenerHandshakeTimeout(t *testing.T) {
+	tlsInfo, err := createSelfCert(t)
+	require.NoError(t, err)
+
+	failc := make(chan error, 1)
+	tlsInfo.HandshakeFailure = func(_ *tls.Conn, herr error) {
+		select {
+		case failc <- herr:
+		default:
+		}
+	}
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	tlsl, err := NewTLSListener(ln, tlsInfo)
+	require.NoError(t, err)
+	defer tlsl.Close()
+
+	// Connect with plain TCP and send nothing: the handshake can never finish.
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	require.NoError(t, err)
+	defer conn.Close()
+
+	start := time.Now()
+	select {
+	case herr := <-failc:
+		require.Error(t, herr)
+		require.GreaterOrEqual(t, time.Since(start), tlsHandshakeTimeout-time.Second)
+	case <-time.After(tlsHandshakeTimeout + 10*time.Second):
+		t.Fatalf("stalled TLS handshake was not terminated within %v", tlsHandshakeTimeout)
+	}
+}
