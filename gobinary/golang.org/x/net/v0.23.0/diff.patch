+func testServerSettingsFlowControlUpdate(t *testing.T, over uint32, wantGoAway bool) {
+	inHandler := make(chan bool)
+	proceed := make(chan bool)
+	st := newServerTester(t, func(w http.ResponseWriter, r *http.Request) {
+		w.(http.Flusher).Flush()
+		inHandler <- true
+		<-proceed
+		w.Write([]byte("hello"))
+		w.(http.Flusher).Flush()
+	})
+	defer st.Close()
+	defer close(proceed)
+	st.greet()
+	st.writeHeaders(HeadersFrameParam{
+		StreamID:      1, // clients send odd numbers
+		BlockFragment: st.encodeHeader(":method", "POST"),
+		EndStream:     false, // data coming
+		EndHeaders:    true,
+	})
+	<-inHandler
+	st.wantHeaders()
+
+	// Give this stream some additional flow control.
+	const windowIncrease = 1000
+	if err := st.fr.WriteWindowUpdate(1, windowIncrease); err != nil {
+		t.Fatal(err)
+	}
+
+	// Adjust the initial flow control window.
+	const maxWindowSize = (1 << 31) - 1 // RFC 9113, 6.9.1
+	const maxInitialWindowSize = maxWindowSize - windowIncrease
+	if err := st.fr.WriteSettings(Setting{SettingInitialWindowSize, maxInitialWindowSize + over}); err != nil {
+		t.Fatal(err)
+	}
+	st.wantSettingsAck()
+
+	// We detect this condition lazily. Write something to the stream so we notice.
+	proceed <- true
+
+	if wantGoAway {
+		gf := st.wantGoAway()
+		if gf.ErrCode != ErrCodeFlowControl {
+			t.Errorf("GOAWAY err = %v; want %v", gf.ErrCode, ErrCodeFlowControl)
+		}
+		return
+	}
+	if df := st.wantData(); string(df.Data()) != "hello" {
+		t.Errorf("DATA = %q; want %q", df.Data(), "hello")
 	}
 }
