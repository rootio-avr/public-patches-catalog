+// TestServer_HeaderTableSizeChanges tests that SETTINGS_HEADER_TABLE_SIZE
+// changes from the client are applied to the server's HPACK encoder lazily
+// (right before a frame is written, so as not to race with a frame write that
+// is using the encoder on another goroutine), and that the smallest and the
+// latest sizes are both signaled to the peer (RFC 7541, Section 4.2).
+func TestServer_HeaderTableSizeChanges(t *testing.T) {
+	st := newServerTester(t, func(w http.ResponseWriter, r *http.Request) {})
+	defer st.Close()
+	st.greet()
+
+	for _, size := range []uint32{0, 2048} {
+		if err := st.fr.WriteSettings(Setting{SettingHeaderTableSize, size}); err != nil {
+			t.Fatal(err)
+		}
+		st.wantSettingsAck()
+	}
+
+	st.bodylessReq1()
+	hf := st.wantHeaders()
+	var want bytes.Buffer
+	wantEnc := hpack.NewEncoder(&want)
+	wantEnc.SetMaxDynamicTableSize(0)
+	wantEnc.SetMaxDynamicTableSize(2048)
+	wantEnc.WriteField(hpack.HeaderField{Name: ":status", Value: "200"})
+	if got := hf.HeaderBlockFragment(); !bytes.HasPrefix(got, want.Bytes()) {
+		t.Errorf("response header block = %x, want prefix %x", got, want.Bytes())
+	}
+}
