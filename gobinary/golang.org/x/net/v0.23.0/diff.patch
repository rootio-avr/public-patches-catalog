+// attrLess reports whether x sorts before y, ordering attributes by
+// namespace, key and value.
+func attrLess(x, y Attribute) bool {
+	if x.Namespace != y.Namespace {
+		return x.Namespace < y.Namespace
+	}
+	if x.Key != y.Key {
+		return x.Key < y.Key
+	}
+	return x.Val < y.Val
+}
+
+// sortAttrs sorts attrs in place using attrLess.
+func sortAttrs(attrs []Attribute) {
+	sort.Slice(attrs, func(i, j int) bool { return attrLess(attrs[i], attrs[j]) })
+}
+
