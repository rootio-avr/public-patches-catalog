+	"testing"
+)
+
+// TestNoahsArkAttributeOrder checks that formatting elements whose attributes
+// are identical up to ordering are still treated as identical by the Noah's
+// Ark clause (CVE-2026-25680).
+func TestNoahsArkAttributeOrder(t *testing.T) {
+	doc, err := Parse(strings.NewReader(
+		`<p><b a=1 b=2><b b=2 a=1><b a=1 b=2><b b=2 a=1>x<p>y`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var find func(n *Node) *Node
+	find = func(n *Node) *Node {
+		if n.Type == TextNode && n.Data == "y" {
+			return n
+		}
+		for c := n.FirstChild; c != nil; c = c.NextSibling {
+			if r := find(c); r != nil {
+				return r
+			}
+		}
+		return nil
+	}
+	y := find(doc)
+	if y == nil {
+		t.Fatal(`text node "y" not found`)
+	}
+	depth := 0
+	for n := y.Parent; n != nil; n = n.Parent {
+		if n.Type == ElementNode && n.Data == "b" {
+			depth++
+		}
+	}
+	if depth != 3 {
+		t.Errorf("got %d reconstructed <b> ancestors, want 3", depth)
+	}
+}
+
+// TestNoahsArkManyAttributes parses many formatting elements with many
+// attributes, which used to take pathologically long in the Noah's Ark clause
+// (CVE-2026-25680).
+func TestNoahsArkManyAttributes(t *testing.T) {
+	const elements, attrs = 1000, 100
+	var sb strings.Builder
+	for i := 0; i < elements; i++ {
+		sb.WriteString("<b")
+		for j := 0; j < attrs; j++ {
+			v := 0
+			if j == attrs-1 {
+				v = i
+			}
+			fmt.Fprintf(&sb, " a%d=%d", j, v)
+		}
+		sb.WriteString(">")
+	}
+	if _, err := Parse(strings.NewReader(sb.String())); err != nil {
+		t.Fatal(err)
+	}
+}

