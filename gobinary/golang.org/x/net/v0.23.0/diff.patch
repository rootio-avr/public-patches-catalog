+			res := rt.response()
+			rt.wantBody([]byte("body"))
+
+			if diff := diffHeaders(res.Header, tt.wantHeader); diff != "" {
+				t.Errorf("unexpected response headers:\n%v", diff)
+			}
+		})
+	}
+}
