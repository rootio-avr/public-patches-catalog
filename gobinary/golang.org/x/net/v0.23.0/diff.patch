+func (cc *ClientConn) goAwayAndClose(code ErrCode) {
+	cc.mu.Lock()
+	closed := cc.closed
+	cc.closing = true
+	cc.closed = true
+	cc.mu.Unlock()
+	if closed {
+		return
+	}
+	if f := cc.t.CountError; f != nil {
+		f(fmt.Sprintf("conn_close_error_%s", code.stringToken()))
+	}
+	done := make(chan struct{})
+	cc.goRun(func() {
+		defer close(done)
+		cc.wmu.Lock()
+		cc.fr.WriteGoAway(0, code, nil)
+		cc.bw.Flush()
+		cc.wmu.Unlock()
+	})
+	timeout := cc.newTimer(250 * time.Millisecond)
+	defer timeout.Stop()
+	if cc.syncHooks != nil {
+		cc.syncHooks.blockUntil(func() bool {
+			select {
+			case <-done:
+			case <-timeout.C():
+			default:
+				return false
+			}
+			return true
+		})
+	}
+	select {
+	case <-done:
+	case <-timeout.C():
+	}
+	cc.closeForError(fmt.Errorf("http2: closing connection with %v", code))
+}
