+			// the stream has been reset. Conn-level flow control for the
+			// buffered data must be returned exactly once.
+			close(startRead)
+			<-readDone
+			st.wantWindowUpdate(0, size)
+			st.sync()
+			st.wantIdle()
+		})
+	}
