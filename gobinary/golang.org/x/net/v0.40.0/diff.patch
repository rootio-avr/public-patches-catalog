+// Regression tests for CVE-2026-78669: changes to SETTINGS_INITIAL_WINDOW_SIZE
+// must not require work proportional to the number of open streams, and a
+// change which pushes any stream's window over 2^31-1 is still a
+// connection-level FLOW_CONTROL_ERROR (detected lazily).
+
+func TestCVE202678669ConnOutflowInitialWindowChange(t *testing.T) {
+	var c connOutflow
+	c.init()
+	var s outflow
+	s.conn = &c
+
+	if !s.add(1000) {
+		t.Fatal("add(1000) failed")
+	}
+	// A change which leaves the stream within bounds is fine.
+	if !c.changeInitialWindowSize(maxFlowWindow - 1000) {
+		t.Fatal("changeInitialWindowSize(max-1000) failed")
+	}
+	if got, ok := s.available(); !ok || got != initialWindowSize {
+		t.Fatalf("available = %d, %v; want %d, true", got, ok, initialWindowSize)
+	}
+	// This change puts the stream over the limit. It is detected lazily.
+	if !c.changeInitialWindowSize(maxFlowWindow - 999) {
+		t.Fatal("changeInitialWindowSize(max-999) failed")
+	}
+	if c.flowErr {
+		t.Fatal("flowErr set before stream observed the change")
+	}
+	if got, ok := s.available(); ok {
+		t.Fatalf("available = %d, true; want false after exceeding limit", got)
+	}
+	if !c.flowErr {
+		t.Fatal("flowErr not set after stream exceeded limit")
+	}
+}
+
+func TestCVE202678669ConnOutflowInitialWindowTooLarge(t *testing.T) {
+	var c connOutflow
+	c.init()
+	if c.changeInitialWindowSize(maxFlowWindow + 1) {
+		t.Fatal("changeInitialWindowSize(2^31) succeeded; want failure")
+	}
+	if !c.flowErr {
+		t.Fatal("flowErr not set")
+	}
+}
