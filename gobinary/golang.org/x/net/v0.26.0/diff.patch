+func TestCVE_2026_39821(t *testing.T) {
+	cases := []string{
+		"xn--example-",
+		"xn--example-.com",
+		"xn--foo-",
+		"xn--abc-.example.com",
+	}
+	for _, in := range cases {
+		if u, err := ToUnicode(in); err == nil {
+			t.Errorf("ToUnicode(%q) = %q, nil; want non-nil error (decodes to all-ASCII)", in, u)
+		}
+		if a, err := ToASCII(in); err == nil {
+			t.Errorf("ToASCII(%q) = %q, nil; want non-nil error (decodes to all-ASCII)", in, a)
+		}
+	}
+	// Sanity check: a normal xn-- label that decodes to non-ASCII must still work.
+	if u, err := ToUnicode("xn--bcher-kva"); err != nil {
+		t.Errorf("ToUnicode(%q) returned error %v; want success", "xn--bcher-kva", err)
+	} else if u != "bücher" {
+		t.Errorf("ToUnicode(%q) = %q; want %q", "xn--bcher-kva", u, "bücher")
+	}
+}

