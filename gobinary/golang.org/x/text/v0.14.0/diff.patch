+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package precis
+
+import (
+	"bytes"
+	"testing"
+
+	"golang.org/x/text/transform"
+)
+
+// TestNicknameShortDst tests that the Nickname additional mapping rule never
+// writes out of bounds and returns transform.ErrShortDst when the destination
+// buffer is too small, and that feeding the output in small chunks yields the
+// same result as a single call with a large buffer.
+func TestNicknameShortDst(t *testing.T) {
+	src := []byte("a  b   c d  e")
+	want := []byte("a b c d e")
+	for _, size := range []int{1, 2, 3, 4, 5, 7, 64} {
+		tr := &nickAdditionalMapping{}
+		dst := make([]byte, size)
+		var got []byte
+		s := src
+		for i := 0; ; i++ {
+			if i > 1000 {
+				t.Fatalf("dst=%d: too many iterations", size)
+			}
+			nDst, nSrc, err := tr.Transform(dst, s, true)
+			if nDst > len(dst) {
+				t.Fatalf("dst=%d: nDst=%d exceeds buffer", size, nDst)
+			}
+			got = append(got, dst[:nDst]...)
+			s = s[nSrc:]
+			if err == nil {
+				break
+			}
+			if err != transform.ErrShortDst {
+				t.Fatalf("dst=%d: unexpected error %v", size, err)
+			}
+			if nDst == 0 && nSrc == 0 {
+				t.Fatalf("dst=%d: no progress", size)
+			}
+		}
+		if !bytes.Equal(got, want) {
+			t.Errorf("dst=%d: got %q, want %q", size, got, want)
+		}
+	}
+}
+
+// TestNicknameSpaceNeedsRoom tests that an interior space followed by a rune
+// that does not fit reports ErrShortDst rather than panicking.
+func TestNicknameSpaceNeedsRoom(t *testing.T) {
+	tr := &nickAdditionalMapping{}
+	dst := make([]byte, 1)
+	nDst, nSrc, err := tr.Transform(dst, []byte("a  b"), true)
+	if err != transform.ErrShortDst || nDst != 1 || nSrc != 3 {
+		t.Fatalf("got (%d, %d, %v), want (1, 3, ErrShortDst)", nDst, nSrc, err)
+	}
+	if string(dst[:nDst]) != "a" {
+		t.Errorf("got %q, want %q", dst[:nDst], "a")
+	}
+	dst = make([]byte, 2)
+	nDst, nSrc, err = tr.Transform(dst, []byte("b"), true)
+	if err != nil || nDst != 2 || nSrc != 1 || string(dst) != " b" {
+		t.Fatalf("got (%d, %d, %v, %q), want (2, 1, nil, \" b\")", nDst, nSrc, err, dst)
+	}
+}

