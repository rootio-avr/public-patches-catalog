diff --git a/internal/fipsgate/fipsgate.go b/internal/fipsgate/fipsgate.go
new file mode 100644
index 0000000..3aa771b
--- /dev/null
+++ b/internal/fipsgate/fipsgate.go
@@ -0,0 +1,29 @@
+// Copyright 2026 Root.io. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package fipsgate is the Root FIPS build's refusal of algorithms that are not
+// FIPS 140 approved. In FIPS 140 mode (GODEBUG=fips140=on or only, see
+// crypto/fips140.Enabled) the gated APIs refuse: those with an error result
+// return Error, the others panic with it, so none returns output computed with
+// a non-approved algorithm. Outside FIPS 140 mode they behave as upstream.
+package fipsgate
+
+import (
+	"crypto/fips140"
+	"errors"
+)
+
+// Enabled reports whether the binary runs in FIPS 140 mode.
+func Enabled() bool { return fips140.Enabled() }
+
+// Error is the refusal of algo by package pkg.
+func Error(pkg, algo string) error {
+	return errors.New(pkg + ": use of " + algo + " is not allowed in FIPS 140 mode")
+}
+
+// Check panics with Error(pkg, algo) in FIPS 140 mode.
+func Check(pkg, algo string) {
+	if Enabled() {
+		panic(Error(pkg, algo))
+	}
+}
