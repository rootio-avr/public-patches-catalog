+// Copyright 2026 Root.io. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package fipsgate_test
+
+import (
+	"bytes"
+	"crypto/fips140"
+	"encoding/hex"
+	"testing"
+
+	"golang.org/x/crypto/bcrypt"
+	"golang.org/x/crypto/blake2b"
+	"golang.org/x/crypto/nacl/box"
+	"golang.org/x/crypto/nacl/secretbox"
+)
+
+// Outside FIPS 140 mode the gated packages produce upstream's output
+// (vectors from unpatched x/crypto v0.55.0). fipstest covers FIPS 140 mode.
+func TestPlainModeKAT(t *testing.T) {
+	if fips140.Enabled() {
+		t.Skip("FIPS 140 mode: see fipstest")
+	}
+	var n24 [24]byte
+	var k [32]byte
+	for i := range k {
+		k[i] = byte(i + 1)
+	}
+	aPub, aPriv, _ := box.GenerateKey(bytes.NewReader(bytes.Repeat([]byte{1}, 32)))
+	bPub, bPriv, _ := box.GenerateKey(bytes.NewReader(bytes.Repeat([]byte{2}, 32)))
+	check := func(name, got, want string) {
+		if got != want {
+			t.Errorf("%s = %s, want %s", name, got, want)
+		}
+	}
+	check("box pub", hex.EncodeToString(aPub[:]), "a4e09292b651c278b9772c569f5fa9bb13d906b46ab68c9df9dc2b4409f8a209")
+	check("box.Seal", hex.EncodeToString(box.Seal(nil, []byte("m"), &n24, bPub, aPriv)), "b8bf51b17841cdce80540b66a15c1975e2")
+	check("secretbox.Seal", hex.EncodeToString(secretbox.Seal(nil, []byte("m"), &n24, &k)), "607c948b45d34979b38a01ff160f5ac360")
+	anon, _ := hex.DecodeString("5dfedd3b6bd47f6fa28ee15d969d5bb0ea53774d488bdaf9df1c6e0124b3ef220adec3edf2487c5f073e992f687a746510")
+	if m, ok := box.OpenAnonymous(nil, anon, bPub, bPriv); !ok || string(m) != "m" {
+		t.Errorf("box.OpenAnonymous = %q, %v", m, ok)
+	}
+	sum := blake2b.Sum256([]byte("x"))
+	check("blake2b.Sum256", hex.EncodeToString(sum[:]), "d161d71145abeec5ef15abcf0459cec60a27321e2f0ac0ef7ace5254f5944476")
+	if err := bcrypt.CompareHashAndPassword([]byte("$2a$04$QKq0nejlgO7F49ZaYv8Vkexr59rQoPFjH95UEubKsx1GzFpHOWtiu"), []byte("pw")); err != nil {
+		t.Errorf("bcrypt: %v", err)
+	}
+}
diff --git a/internal/fipsgate/fipstest/gates_test.go b/internal/fipsgate/fipstest/gates_test.go
new file mode 100644
index 0000000..31d58e0
--- /dev/null
+++ b/internal/fipsgate/fipstest/gates_test.go
@@ -0,0 +1,186 @@
+// Copyright 2026 Root.io. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:debug fips140=on
+
+// Package fipstest checks the Root FIPS build's gates in FIPS 140 mode
+// (fips140=on, the mode Root FIPS images ship). Its own package so the
+// //go:debug directive affects only this test binary.
+package fipstest
+
+import (
+	"crypto"
+	"crypto/fips140"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"testing"
+
+	"golang.org/x/crypto/argon2"
+	"golang.org/x/crypto/bcrypt"
+	"golang.org/x/crypto/blake2b"
+	"golang.org/x/crypto/blowfish"
+	"golang.org/x/crypto/chacha20"
+	"golang.org/x/crypto/chacha20poly1305"
+	"golang.org/x/crypto/curve25519"
+	"golang.org/x/crypto/ed25519"
+	"golang.org/x/crypto/hkdf"
+	"golang.org/x/crypto/nacl/box"
+	"golang.org/x/crypto/nacl/secretbox"
+	"golang.org/x/crypto/pbkdf2"
+	"golang.org/x/crypto/salsa20"
+	"golang.org/x/crypto/salsa20/salsa"
+	"golang.org/x/crypto/scrypt"
+)
+
+const refused = "is not allowed in FIPS 140 mode"
+
+var (
+	k32   [32]byte
+	n24   [24]byte
+	n16   [16]byte
+	b64   [64]byte
+	key32 = make([]byte, 32)
+)
+
+func TestFIPSModeOn(t *testing.T) {
+	if !fips140.Enabled() {
+		t.Fatal("fips140.Enabled() = false: the //go:debug fips140=on directive did not apply")
+	}
+}
+
+// Functions without an error result must panic with the refusal, never return.
+func TestPanics(t *testing.T) {
+	cases := map[string]func(){
+		"box.Precompute":              func() { box.Precompute(&k32, &k32, &k32) },
+		"box.Seal":                    func() { box.Seal(nil, []byte("m"), &n24, &k32, &k32) },
+		"box.SealAfterPrecomputation": func() { box.SealAfterPrecomputation(nil, []byte("m"), &n24, &k32) },
+		"secretbox.Seal":              func() { secretbox.Seal(nil, []byte("m"), &n24, &k32) },
+		"salsa20.XORKeyStream":        func() { salsa20.XORKeyStream(make([]byte, 1), []byte("m"), make([]byte, 8), &k32) },
+		"salsa.HSalsa20":              func() { salsa.HSalsa20(&k32, &n16, &k32, &n16) },
+		"salsa.XORKeyStream":          func() { salsa.XORKeyStream(make([]byte, 1), []byte("m"), &n16, &k32) },
+		"salsa.Core208":               func() { salsa.Core208(&b64, &b64) },
+		"curve25519.ScalarMult":       func() { curve25519.ScalarMult(&k32, &k32, &k32) },
+		"curve25519.ScalarBaseMult":   func() { curve25519.ScalarBaseMult(&k32, &k32) },
+		"blake2b.Sum512":              func() { blake2b.Sum512([]byte("x")) },
+		"blake2b.Sum384":              func() { blake2b.Sum384([]byte("x")) },
+		"blake2b.Sum256":              func() { blake2b.Sum256([]byte("x")) },
+		"crypto.BLAKE2b_256.New":      func() { crypto.BLAKE2b_256.New() },
+		"argon2.Key":                  func() { argon2.Key([]byte("pw"), []byte("saltsalt"), 1, 64, 1, 32) },
+		"argon2.IDKey":                func() { argon2.IDKey([]byte("pw"), []byte("saltsalt"), 1, 64, 1, 32) },
+		// Zero-value ciphers reach these without a constructor.
+		"blowfish.Cipher.Encrypt (zero value)":      func() { var c blowfish.Cipher; c.Encrypt(make([]byte, 8), make([]byte, 8)) },
+		"blowfish.Cipher.Decrypt (zero value)":      func() { var c blowfish.Cipher; c.Decrypt(make([]byte, 8), make([]byte, 8)) },
+		"blowfish.ExpandKey (zero value)":           func() { var c blowfish.Cipher; blowfish.ExpandKey(key32, &c) },
+		"chacha20.Cipher.XORKeyStream (zero value)": func() { var c chacha20.Cipher; c.XORKeyStream(make([]byte, 1), []byte("m")) },
+		"chacha20.Cipher.SetCounter (zero value)":   func() { var c chacha20.Cipher; c.SetCounter(1) },
+	}
+	for name, f := range cases {
+		t.Run(name, func(t *testing.T) {
+			defer func() {
+				r := recover()
+				if r == nil || !strings.Contains(fmt.Sprint(r), refused) {
+					t.Errorf("want panic containing %q, got %v", refused, r)
+				}
+			}()
+			f()
+		})
+	}
+}
+
+// Functions with an error result must return the refusal and no output.
+func TestErrors(t *testing.T) {
+	hash := []byte("$2a$04$QKq0nejlgO7F49ZaYv8Vkexr59rQoPFjH95UEubKsx1GzFpHOWtiu")
+	nonNil := func(v any) bool { return v != nil && fmt.Sprint(v) != "<nil>" && fmt.Sprint(v) != "[]" }
+	cases := map[string]func() (any, error){
+		"box.GenerateKey":                   func() (any, error) { p, _, err := box.GenerateKey(rand.Reader); return p, err },
+		"box.SealAnonymous":                 func() (any, error) { return box.SealAnonymous(nil, []byte("m"), &k32, rand.Reader) },
+		"chacha20.NewUnauthenticatedCipher": func() (any, error) { return chacha20.NewUnauthenticatedCipher(key32, make([]byte, 12)) },
+		"chacha20.HChaCha20":                func() (any, error) { return chacha20.HChaCha20(key32, make([]byte, 16)) },
+		"chacha20poly1305.New":              func() (any, error) { return chacha20poly1305.New(key32) },
+		"chacha20poly1305.NewX":             func() (any, error) { return chacha20poly1305.NewX(key32) },
+		"curve25519.X25519":                 func() (any, error) { return curve25519.X25519(key32, curve25519.Basepoint) },
+		"bcrypt.GenerateFromPassword":       func() (any, error) { return bcrypt.GenerateFromPassword([]byte("pw"), 4) },
+		"bcrypt.CompareHashAndPassword":     func() (any, error) { return nil, bcrypt.CompareHashAndPassword(hash, []byte("pw")) },
+		"blowfish.NewCipher":                func() (any, error) { return blowfish.NewCipher(key32) },
+		"blowfish.NewSaltedCipher":          func() (any, error) { return blowfish.NewSaltedCipher(key32, key32) },
+		"blake2b.New512":                    func() (any, error) { return blake2b.New512(nil) },
+		"blake2b.New384":                    func() (any, error) { return blake2b.New384(nil) },
+		"blake2b.New256":                    func() (any, error) { return blake2b.New256(nil) },
+		"blake2b.New":                       func() (any, error) { return blake2b.New(32, nil) },
+		"blake2b.NewXOF":                    func() (any, error) { return blake2b.NewXOF(32, nil) },
+		"scrypt.Key":                        func() (any, error) { return scrypt.Key([]byte("pw"), []byte("salt"), 16, 1, 1, 32) },
+	}
+	for name, f := range cases {
+		t.Run(name, func(t *testing.T) {
+			out, err := f()
+			if err == nil || !strings.Contains(err.Error(), refused) {
+				t.Errorf("want error containing %q, got %v", refused, err)
+			}
+			if nonNil(out) {
+				t.Errorf("want no output, got %v", out)
+			}
+		})
+	}
+}
+
+// Open functions refuse valid ciphertexts (sealed by upstream x/crypto v0.55.0 with
+// these keys; see the plain-mode KATs in package fipsgate).
+func TestOpensFail(t *testing.T) {
+	var bPriv, aPub, k [32]byte
+	for i := range k {
+		bPriv[i], k[i] = 2, byte(i+1)
+	}
+	copy(aPub[:], unhex("a4e09292b651c278b9772c569f5fa9bb13d906b46ab68c9df9dc2b4409f8a209"))
+	bPub := bPubKey()
+	if _, ok := box.Open(nil, unhex(boxCT), &n24, &aPub, &bPriv); ok {
+		t.Error("box.Open accepted a box ciphertext")
+	}
+	if _, ok := box.OpenAfterPrecomputation(nil, unhex(secretboxCT), &n24, &k); ok {
+		t.Error("box.OpenAfterPrecomputation accepted a ciphertext")
+	}
+	if _, ok := box.OpenAnonymous(nil, unhex(anonCT), &bPub, &bPriv); ok {
+		t.Error("box.OpenAnonymous accepted a ciphertext")
+	}
+	if _, ok := secretbox.Open(nil, unhex(secretboxCT), &n24, &k); ok {
+		t.Error("secretbox.Open accepted a ciphertext")
+	}
+}
+
+const (
+	boxCT       = "b8bf51b17841cdce80540b66a15c1975e2"
+	secretboxCT = "607c948b45d34979b38a01ff160f5ac360"
+	anonCT      = "5dfedd3b6bd47f6fa28ee15d969d5bb0ea53774d488bdaf9df1c6e0124b3ef220adec3edf2487c5f073e992f687a746510"
+)
+
+func bPubKey() (p [32]byte) {
+	copy(p[:], unhex("ce8d3ad1ccb633ec7b70c17814a5c76ecd029685050d344745ba05870e587d59"))
+	return p
+}
+
+func unhex(s string) []byte {
+	b, err := hex.DecodeString(s)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+// Approved algorithms reached through x/crypto keep working.
+func TestApprovedUnaffected(t *testing.T) {
+	// RFC 7914 / RFC 6070-style PBKDF2-HMAC-SHA256 vector (password "passwd", salt "salt", 1 iter, 64 bytes).
+	got := fmt.Sprintf("%x", pbkdf2.Key([]byte("passwd"), []byte("salt"), 1, 64, sha256.New))
+	if want := "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"; got != want {
+		t.Errorf("pbkdf2 = %s, want %s", got, want)
+	}
+	r := hkdf.New(sha256.New, []byte("secret-input-key"), []byte("salt-salt-salt"), nil)
+	if _, err := r.Read(make([]byte, 32)); err != nil {
+		t.Errorf("hkdf: %v", err)
+	}
+	pub, priv, err := ed25519.GenerateKey(nil)
+	if err != nil || !ed25519.Verify(pub, []byte("m"), ed25519.Sign(priv, []byte("m"))) {
+		t.Errorf("ed25519: %v", err)
+	}
+}
diff --git a/internal/fipsgate/fipstest/ssh_kex_test.go b/internal/fipsgate/fipstest/ssh_kex_test.go
new file mode 100644
index 0000000..ca38609
--- /dev/null
+++ b/internal/fipsgate/fipstest/ssh_kex_test.go
@@ -0,0 +1,142 @@
+// Copyright 2026 Root.io. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package fipstest
+
+import (
+	"crypto/ed25519"
+	"crypto/fips140"
+	"net"
+	"os"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+
+	"golang.org/x/crypto/ssh"
+)
+
+// Every X25519-based KEX, the standalone names and the ML-KEM hybrid.
+var x25519Kex = []string{"curve25519-sha256", "curve25519-sha256@libssh.org", "mlkem768x25519-sha256"}
+
+// A peer that prefers X25519 KEX, then falls back to NIST ECDH.
+var prefersX25519 = append(slices.Clone(x25519Kex), "ecdh-sha2-nistp256", "ecdh-sha2-nistp384")
+
+const peerAddrEnv = "FIPSTEST_SSH_ADDR"
+
+// sshServer accepts one connection on l in FIPS 140 mode (default server config,
+// ed25519 host key) and returns the negotiated KEX, or the handshake error.
+func sshServer(t *testing.T, l net.Listener) <-chan string {
+	t.Helper()
+	_, priv, err := ed25519.GenerateKey(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signer, err := ssh.NewSignerFromKey(priv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := &ssh.ServerConfig{NoClientAuth: true}
+	cfg.AddHostKey(signer)
+	got := make(chan string, 1)
+	go func() {
+		c, err := l.Accept()
+		if err != nil {
+			got <- "accept: " + err.Error()
+			return
+		}
+		defer c.Close()
+		sc, _, _, err := ssh.NewServerConn(c, cfg)
+		if err != nil {
+			got <- "handshake: " + err.Error()
+			return
+		}
+		defer sc.Close()
+		got <- sc.Conn.(ssh.AlgorithmsConnMetadata).Algorithms().KeyExchange
+	}()
+	return got
+}
+
+func clientConfig(kex []string) *ssh.ClientConfig {
+	return &ssh.ClientConfig{
+		User:            "u",
+		HostKeyCallback: ssh.InsecureIgnoreHostKey(),
+		Config:          ssh.Config{KeyExchanges: kex},
+	}
+}
+
+func listen(t *testing.T) net.Listener {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { l.Close() })
+	return l
+}
+
+// In FIPS 140 mode no X25519 KEX is advertised or accepted: a peer that prefers
+// one completes the handshake on NIST ECDH instead of aborting on the refused X25519.
+func TestSSHKexPeerPrefersX25519(t *testing.T) {
+	approved := func(t *testing.T, kex string) {
+		t.Helper()
+		if !strings.HasPrefix(kex, "ecdh-sha2-nistp") {
+			t.Errorf("negotiated %q, want ecdh-sha2-nistp*", kex)
+		}
+	}
+	t.Run("FIPS-mode client", func(t *testing.T) {
+		l := listen(t)
+		got := sshServer(t, l)
+		c, err := ssh.Dial("tcp", l.Addr().String(), clientConfig(prefersX25519))
+		if err != nil {
+			t.Fatalf("handshake: %v", err)
+		}
+		defer c.Close()
+		approved(t, c.Conn.(ssh.AlgorithmsConnMetadata).Algorithms().KeyExchange)
+		approved(t, <-got)
+	})
+	// A plain-mode peer advertises X25519 first, as OpenSSH does.
+	t.Run("plain-mode client process", func(t *testing.T) {
+		l := listen(t)
+		got := sshServer(t, l)
+		cmd := exec.Command(os.Args[0], "-test.run=^TestSSHPlainPeerHelper$", "-test.v")
+		cmd.Env = append(os.Environ(), "GODEBUG=fips140=off", peerAddrEnv+"="+l.Addr().String())
+		out, err := cmd.CombinedOutput()
+		if err != nil || !strings.Contains(string(out), "PLAIN-PEER-OK") {
+			t.Fatalf("plain peer: %v\n%s", err, out)
+		}
+		approved(t, <-got)
+	})
+	// A peer offering only X25519 KEX is refused, never served with X25519.
+	t.Run("X25519-only plain-mode client process", func(t *testing.T) {
+		l := listen(t)
+		got := sshServer(t, l)
+		cmd := exec.Command(os.Args[0], "-test.run=^TestSSHPlainPeerHelper$", "-test.v")
+		cmd.Env = append(os.Environ(), "GODEBUG=fips140=off", peerAddrEnv+"="+l.Addr().String(), "FIPSTEST_SSH_X25519_ONLY=1")
+		cmd.CombinedOutput()
+		if r := <-got; !strings.Contains(r, "no common algorithm for key exchange") {
+			t.Errorf("server: %q, want no common key exchange", r)
+		}
+	})
+}
+
+// Run by TestSSHKexPeerPrefersX25519 in a child process with GODEBUG=fips140=off.
+func TestSSHPlainPeerHelper(t *testing.T) {
+	addr := os.Getenv(peerAddrEnv)
+	if addr == "" {
+		t.Skip("helper process only")
+	}
+	if fips140.Enabled() {
+		t.Fatal("helper must run outside FIPS 140 mode")
+	}
+	kex := prefersX25519
+	if os.Getenv("FIPSTEST_SSH_X25519_ONLY") != "" {
+		kex = x25519Kex
+	}
+	c, err := ssh.Dial("tcp", addr, clientConfig(kex))
+	if err != nil {
+		t.Fatalf("handshake: %v", err)
+	}
+	defer c.Close()
+	t.Log("PLAIN-PEER-OK kex=" + c.Conn.(ssh.AlgorithmsConnMetadata).Algorithms().KeyExchange)
+}
