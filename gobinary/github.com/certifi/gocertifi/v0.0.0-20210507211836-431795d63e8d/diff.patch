+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package gocertifi
+
+import (
+	"bytes"
+	"crypto/x509"
+	"encoding/pem"
+	"testing"
+)
+
+func TestDistrustedRootsExcluded(t *testing.T) {
+	pool, err := CACerts()
+	if err != nil || pool == nil {
+		t.Fatalf("CACerts failed: %v", err)
+	}
+	subjects := pool.Subjects()
+	has := func(raw []byte) bool {
+		for _, s := range subjects {
+			if bytes.Equal(s, raw) {
+				return true
+			}
+		}
+		return false
+	}
+
+	rest := []byte(pemcerts)
+	trusted := 0
+	for len(rest) > 0 {
+		var block *pem.Block
+		block, rest = pem.Decode(rest)
+		if block == nil {
+			break
+		}
+		cert, err := x509.ParseCertificate(block.Bytes)
+		if err != nil {
+			continue
+		}
+		if isDistrusted(cert) {
+			if has(cert.RawSubject) {
+				t.Errorf("distrusted root %q is still in the pool", cert.Subject.CommonName)
+			}
+			continue
+		}
+		trusted++
+		if !has(cert.RawSubject) {
+			t.Errorf("trusted root %q is missing from the pool", cert.Subject.CommonName)
+		}
+	}
+	if trusted == 0 {
+		t.Errorf("no trusted roots found in the bundle")
+	}
+}
+
+func TestDistrustedSPKIListed(t *testing.T) {
+	if len(distrustedSPKI) != 5 {
+		t.Errorf("expected 5 denylisted keys, got %d", len(distrustedSPKI))
+	}
+}
