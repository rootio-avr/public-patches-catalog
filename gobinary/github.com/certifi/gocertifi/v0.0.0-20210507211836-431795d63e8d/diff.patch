+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package gocertifi
+
+import (
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/pem"
+)
+
+// distrustedSPKI lists the hex-encoded SHA-256 digests of the
+// SubjectPublicKeyInfo of roots that must not be trusted: the eMudhra (emSign)
+// roots and the Sectigo/Comodo "AAA Certificate Services" root that
+// cross-signed the compromised eMudhra intermediates. Matching on the public
+// key (rather than the whole certificate) also rejects re-issued or
+// cross-signed variants of the same keys.
+var distrustedSPKI = map[string]string{
+	"bd153ed7b0434f6886b17bce8bbe84ed340c7132d702a8f4fa318f756ecbd6f3": "AAA Certificate Services (Comodo/Sectigo)",
+	"376a1a7082a593dccc20d561d119e9ab8d30f11cc321d0a37fa41f0df284e01c": "emSign Root CA - G1",
+	"8d417db2dd8bf5e3084d1e3f196d583849d81bdd4c00c70b9d39369e96b8c782": "emSign ECC Root CA - G3",
+	"b7408b4d2be0238ba37004dd34e276c6019bd2f24c9db7d4980f5f6c359a4bcc": "emSign Root CA - C1",
+	"eabc185c4e82d942b1a5978ba3c0181487d6b3b9974e5c49f72f6d0bd9637150": "emSign ECC Root CA - C3",
+}
+
+// isDistrusted reports whether cert's public key is on the denylist.
+func isDistrusted(cert *x509.Certificate) bool {
+	sum := sha256.Sum256(cert.RawSubjectPublicKeyInfo)
+	_, bad := distrustedSPKI[hex.EncodeToString(sum[:])]
+	return bad
+}
+
+// newTrustedPool builds a certificate pool from the PEM bundle, skipping
+// every certificate whose public key is on the denylist.
+func newTrustedPool(bundle []byte) *x509.CertPool {
+	pool := x509.NewCertPool()
+	for len(bundle) > 0 {
+		var block *pem.Block
+		block, bundle = pem.Decode(bundle)
+		if block == nil {
+			break
+		}
+		if block.Type != "CERTIFICATE" || len(block.Headers) != 0 {
+			continue
+		}
+		cert, err := x509.ParseCertificate(block.Bytes)
+		if err != nil || isDistrusted(cert) {
+			continue
+		}
+		pool.AddCert(cert)
+	}
+	return pool
+}
