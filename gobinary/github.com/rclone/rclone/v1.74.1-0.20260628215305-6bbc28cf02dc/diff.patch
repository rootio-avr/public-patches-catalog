+package rcserver
+
+import "testing"
+
+// TestCVE202649980CheckServeRemote is a regression test for CVE-2026-49980.
+//
+// rclone rcd --rc-serve accepted unauthenticated GET/HEAD requests to paths of
+// the form /[remote:path]/object, passing the request-derived remote straight
+// into backend initialisation. Inline remote definitions and connection-string
+// options can execute local commands during initialisation (e.g. sftp ssh,
+// webdav bearer_token_command), so a single unauthenticated request could run a
+// command as the rclone process user (CWE-306/CWE-78, CVSS 9.8). This bypassed
+// the earlier POST-path fix from CVE-2026-41179.
+//
+// The fix gates instantiation behind checkServeRemote: on an unauthenticated
+// server only pre-configured named remotes are allowed, and global.* connection
+// string options (which mutate process-wide config) are never honoured on a
+// served remote even when the request is authenticated.
+//
+// This test grounds on the upstream regression tests added in fix commits
+// 48da1774 and 9222ed2c and asserts the guard is present and correct.
+func TestCVE202649980CheckServeRemote(t *testing.T) {
+	for _, test := range []struct {
+		name          string
+		fsName        string
+		authenticated bool
+		wantErr       string // substring of expected error, "" means no error
+	}{
+		// Pre-configured named remotes stay allowed regardless of auth.
+		{name: "named remote unauth allowed", fsName: "remote:path", wantErr: ""},
+		{name: "named remote auth allowed", fsName: "remote:path", authenticated: true, wantErr: ""},
+
+		// Unauthenticated inline remotes that can execute commands must be rejected.
+		{name: "inline webdav bearer_token_command unauth rejected", fsName: ":webdav,url=http://localhost,bearer_token_command=id:", wantErr: "inline remotes"},
+		{name: "inline sftp ssh unauth rejected", fsName: ":sftp,ssh=id:", wantErr: "inline remotes"},
+
+		// Unauthenticated bare local paths (arbitrary file access) must be rejected.
+		{name: "bare local path unauth rejected", fsName: "/etc/passwd", wantErr: "local paths"},
+
+		// Unauthenticated connection string overrides must be rejected.
+		{name: "connection string unauth rejected", fsName: "remote,vendor=other:path", wantErr: "connection string"},
+
+		// global.* mutates process-wide config and must be rejected even when authed.
+		{name: "global option unauth rejected", fsName: "remote,global.http_proxy=x:path", wantErr: "global.http_proxy"},
+		{name: "global option authed still rejected", fsName: "remote,global.http_proxy=x:path", authenticated: true, wantErr: "global.http_proxy"},
+
+		// Once authenticated, inline remotes and local paths are permitted.
+		{name: "inline local authed allowed", fsName: ":local:/etc", authenticated: true, wantErr: ""},
+		{name: "bare local path authed allowed", fsName: "/etc/passwd", authenticated: true, wantErr: ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := checkServeRemote(test.fsName, test.authenticated)
+			if test.wantErr == "" {
+				if err != nil {
+					t.Fatalf("checkServeRemote(%q, %v) = %v, want no error", test.fsName, test.authenticated, err)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatalf("checkServeRemote(%q, %v) = nil, want error containing %q", test.fsName, test.authenticated, test.wantErr)
+			}
+			if got := err.Error(); !contains(got, test.wantErr) {
+				t.Fatalf("checkServeRemote(%q, %v) error = %q, want substring %q", test.fsName, test.authenticated, got, test.wantErr)
+			}
+		})
+	}
+}
+
+func contains(s, substr string) bool {
+	for i := 0; i+len(substr) <= len(s); i++ {
+		if s[i:i+len(substr)] == substr {
+			return true
+		}
+	}
+	return len(substr) == 0
+}

