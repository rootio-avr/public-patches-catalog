+// Regression test for CVE-2026-88044 (GHSA-p569-5gjg-9cmj):
+// RC per-server auth-proxy bypass. The FTP server constructor must decide
+// whether to enable the auth proxy based on the per-server proxyOpt.AuthProxy
+// that was passed in (as RC-started servers supply), NOT the process-global
+// proxy.Opt.AuthProxy. Checking the global caused a fail-open condition for
+// RC-started servers using a per-server proxy option object.
+
+//go:build !plan9
+
+package ftp
+
+import (
+	"context"
+	"testing"
+
+	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/cmd/serve/proxy"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestSecurityValidationRCPerServerAuthProxyFTP proves that the per-server
+// proxyOpt controls whether the auth proxy is enabled, independently of the
+// process-global proxy.Opt.
+func TestSecurityValidationRCPerServerAuthProxyFTP(t *testing.T) {
+	ctx := context.Background()
+
+	f, err := fs.NewFs(ctx, t.TempDir())
+	require.NoError(t, err)
+
+	// Ensure the process-global auth proxy is DISABLED, simulating a
+	// CLI/global config that does not use an auth proxy.
+	savedGlobal := proxy.Opt.AuthProxy
+	proxy.Opt.AuthProxy = ""
+	defer func() { proxy.Opt.AuthProxy = savedGlobal }()
+
+	newOpt := func() Options {
+		opt := Opt
+		opt.ListenAddr = "localhost:0"
+		opt.PassivePorts = "30000-32000"
+		return opt
+	}
+
+	// Case 1: per-server proxyOpt REQUESTS an auth proxy while the global is
+	// empty. The server must honour the per-server request and enable the
+	// proxy (pre-fix it fell open, using the fixed global VFS instead).
+	t.Run("PerServerAuthProxyEnabled", func(t *testing.T) {
+		opt := newOpt()
+		proxyOpt := proxy.Opt
+		proxyOpt.AuthProxy = "/bin/true" // any non-empty command enables the proxy
+
+		d, err := newServer(ctx, f, &opt, &vfscommon.Opt, &proxyOpt)
+		require.NoError(t, err)
+		defer func() { _ = d.Shutdown() }()
+
+		assert.NotNil(t, d.proxy, "per-server proxyOpt.AuthProxy must enable the auth proxy")
+		assert.Nil(t, d.globalVFS, "auth-proxy server must not fall open to a fixed global VFS")
+	})
+
+	// Case 2: per-server proxyOpt does NOT request a proxy - the server uses
+	// the fixed VFS. This confirms the decision follows the per-server option.
+	t.Run("PerServerAuthProxyDisabled", func(t *testing.T) {
+		opt := newOpt()
+		proxyOpt := proxy.Opt
+		proxyOpt.AuthProxy = ""
+
+		d, err := newServer(ctx, f, &opt, &vfscommon.Opt, &proxyOpt)
+		require.NoError(t, err)
+		defer func() { _ = d.Shutdown() }()
+
+		assert.Nil(t, d.proxy, "no per-server proxyOpt.AuthProxy must not enable the auth proxy")
+		assert.NotNil(t, d.globalVFS, "non-proxy server must use a fixed VFS")
+	})
+}
