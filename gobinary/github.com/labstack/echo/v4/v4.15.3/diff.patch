+// configured MaxDecompressedSize must be rejected with HTTP 413.
+func TestCVE2026118261Decompress(t *testing.T) {
+	zipped, err := gzipString(strings.Repeat("A", 64*1024))
+	require.NoError(t, err)
+
+	run := func(limit int64) *httptest.ResponseRecorder {
+		e := echo.New()
+		e.Use(DecompressWithConfig(DecompressConfig{MaxDecompressedSize: limit}))
+		e.POST("/", func(c echo.Context) error {
