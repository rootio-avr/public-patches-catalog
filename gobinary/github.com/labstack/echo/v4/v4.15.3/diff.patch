+// CVE-2026-118260: BodyDump buffered whole request and response bodies in memory
+// without any cap. The dump callback must only receive a bounded capture while
+// the request handler and the client still observe the complete payloads.
+func TestBodyDumpCVE2026118260UnboundedBuffering(t *testing.T) {
+	const (
+		total = 8 << 20
+		limit = 1 << 20
+	)
+	payload := bytes.Repeat([]byte("A"), total)
+
+	var dumpedReq, dumpedRes []byte
+	e := echo.New()
+	e.Use(BodyDumpWithConfig(BodyDumpConfig{
+		MaxRequestBytes:  limit,
+		MaxResponseBytes: limit,
+		Handler: func(_ echo.Context, req, res []byte) {
+			dumpedReq, dumpedRes = req, res
+		},
+	}))
+	e.POST("/", func(c echo.Context) error {
+		body, err := io.ReadAll(c.Request().Body)
+		if err != nil {
+			return err
+		}
+		require.Len(t, body, total)
+		c.Response().WriteHeader(http.StatusOK)
+		for off := 0; off < len(body); off += 64 << 10 {
+			if _, err := c.Response().Write(body[off : off+(64<<10)]); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/", bytes.NewReader(payload)))
+
+	require.Equal(t, http.StatusOK, rec.Code)
+	require.Equal(t, total, rec.Body.Len(), "client must receive the full response")
+	require.Len(t, dumpedReq, limit, "request capture must be capped")
+	require.Len(t, dumpedRes, limit, "response capture must be capped")
+}
