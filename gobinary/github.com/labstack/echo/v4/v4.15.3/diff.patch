+type bodyDumpLimitedWriter struct {
+	writer    io.Writer
+	buffer    *bytes.Buffer
+	remaining int64
+}
+
+func (w *bodyDumpLimitedWriter) Write(p []byte) (int, error) {
+	n, err := w.writer.Write(p)
+	if w.remaining > 0 {
+		captured := min(int64(n), w.remaining)
+		_, _ = w.buffer.Write(p[:captured])
+		w.remaining -= captured
+	}
+	return n, err
