+			if err != nil {
+				return err
+			}
+			return c.NoContent(http.StatusOK)
+		})
+		req := httptest.NewRequest(http.MethodPost, "/", bytes.NewReader(zipped))
+		req.Header.Set(echo.HeaderContentEncoding, GZIPEncoding)
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		return rec
+	}
+
+	require.Equal(t, http.StatusRequestEntityTooLarge, run(1024).Code)
+	require.Equal(t, http.StatusOK, run(64*1024).Code)
+	require.Equal(t, http.StatusOK, run(-1).Code)
+}

