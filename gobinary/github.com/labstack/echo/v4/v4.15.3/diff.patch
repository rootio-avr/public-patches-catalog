+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: © 2015 LabStack LLC and Echo contributors
+
+package middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/labstack/echo/v4"
+	"github.com/stretchr/testify/assert"
+)
+
+func newStaticTestRoot(t *testing.T) string {
+	root := t.TempDir()
+	assert.NoError(t, os.MkdirAll(filepath.Join(root, "admin"), 0o755))
+	assert.NoError(t, os.MkdirAll(filepath.Join(root, "assets"), 0o755))
+	assert.NoError(t, os.WriteFile(filepath.Join(root, "admin", "secret.txt"), []byte("TOP-SECRET"), 0o644))
+	assert.NoError(t, os.WriteFile(filepath.Join(root, "index.html"), []byte("public"), 0o644))
+	assert.NoError(t, os.WriteFile(filepath.Join(root, "café.txt"), []byte("coffee"), 0o644))
+	return root
+}
+
+// Regression for GHSA-375p-5qhx-8wq4 and GHSA-3pmx-cf9f-34xr (v4 backport): the middleware must resolve the file from
+// the path the router matched and must not serve paths with dot segments, otherwise route guards can be bypassed.
+func TestStatic_EncodedOrDotPathDoesNotBypassRouteGuard(t *testing.T) {
+	root := newStaticTestRoot(t)
+
+	e := echo.New()
+	e.Use(StaticWithConfig(StaticConfig{Root: root}))
+	g := e.Group("/admin", func(next echo.HandlerFunc) echo.HandlerFunc {
+		return func(c echo.Context) error { return c.String(http.StatusForbidden, "denied") }
+	})
+	g.GET("/*", func(c echo.Context) error { return c.String(http.StatusOK, "reached-protected-handler") })
+
+	cases := []string{
+		"/admin%2Fsecret.txt",
+		"/admin%2fsecret.txt",
+		"/%61dmin/secret.txt",
+		"/assets/../admin/secret.txt",
+		"/./admin/secret.txt",
+		"//admin/secret.txt",
+		"/assets/%2e%2e/admin/secret.txt",
+	}
+	for _, target := range cases {
+		req := httptest.NewRequest(http.MethodGet, target, nil)
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		assert.Equal(t, http.StatusNotFound, rec.Code, "GET %s", target)
+		assert.NotContains(t, rec.Body.String(), "TOP-SECRET", "GET %s leaked protected file", target)
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/index.html", nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	assert.Equal(t, http.StatusOK, rec.Code)
+	assert.Equal(t, "public", rec.Body.String())
+}
+
+func TestStatic_DotPathIsNotServedInGroup(t *testing.T) {
+	root := newStaticTestRoot(t)
+
+	e := echo.New()
+	g := e.Group("/files", StaticWithConfig(StaticConfig{Root: root}))
+	g.GET("/*", func(c echo.Context) error { return echo.ErrNotFound })
+
+	for _, target := range []string{"/files/assets/../admin/secret.txt", "/files/%61dmin/secret.txt"} {
+		req := httptest.NewRequest(http.MethodGet, target, nil)
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		assert.Equal(t, http.StatusNotFound, rec.Code, "GET %s", target)
+		assert.NotContains(t, rec.Body.String(), "TOP-SECRET", "GET %s leaked protected file", target)
+	}
+}
+
+func TestStatic_EnablePathUnescaping(t *testing.T) {
+	root := newStaticTestRoot(t)
+
+	cases := []struct {
+		name     string
+		enabled  bool
+		target   string
+		wantCode int
+	}{
+		{"disabled: non-default escaping is not decoded", false, "/caf%c3%a9.txt", http.StatusNotFound},
+		{"enabled: non-default escaping is decoded", true, "/caf%c3%a9.txt", http.StatusOK},
+		{"enabled: encoded dot segments are rejected", true, "/assets/%2e%2e/admin/secret.txt", http.StatusNotFound},
+		{"enabled: encoded separator is rejected", true, "/admin%2fsecret.txt", http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := echo.New()
+			e.Use(StaticWithConfig(StaticConfig{Root: root, EnablePathUnescaping: tc.enabled}))
+
+			req := httptest.NewRequest(http.MethodGet, tc.target, nil)
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, req)
+			assert.Equal(t, tc.wantCode, rec.Code)
+			assert.NotContains(t, rec.Body.String(), "TOP-SECRET")
+		})
+	}
+}
