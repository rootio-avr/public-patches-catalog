+
+type limitedGzipReader struct {
+	*gzip.Reader
+	remaining int64
+}
+
+func (r *limitedGzipReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if r.remaining < 0 {
+		return 0, echo.ErrStatusRequestEntityTooLarge
+	}
+	if r.remaining == 0 {
+		var probe [1]byte
+		n, err := r.Reader.Read(probe[:])
+		if n > 0 {
+			r.remaining = -1
+			return 0, echo.ErrStatusRequestEntityTooLarge
+		}
+		return 0, err
+	}
+	if int64(len(p)) > r.remaining {
+		p = p[:r.remaining]
+	}
+	n, err := r.Reader.Read(p)
+	r.remaining -= int64(n)
+	return n, err
 }
