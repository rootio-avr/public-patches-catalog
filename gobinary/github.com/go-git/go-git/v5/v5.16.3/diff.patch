+package git
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/go-git/go-git/v5/plumbing/object"
+	"github.com/stretchr/testify/assert"
+)
+
+// symlinkTestRepo creates a repository on the OS filesystem with a single
+// commit that tracks the given files. It returns the worktree, the commit,
+// and the path of a directory living outside of the worktree.
+func symlinkTestRepo(t *testing.T, files map[string]string) (*Worktree, *object.Commit, string, string) {
+	t.Helper()
+
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not reliably available on windows")
+	}
+
+	base := t.TempDir()
+	root := filepath.Join(base, "wt")
+	outside := filepath.Join(base, "outside")
+	if err := os.MkdirAll(outside, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	r, err := PlainInit(root, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w, err := r.Worktree()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for name, content := range files {
+		p := filepath.Join(root, filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := w.Add(name); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	h, err := w.Commit("tracked files", defaultTestCommitOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := r.CommitObject(h)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	return w, c, root, outside
+}
+
+func TestCheckoutFileDoesNotFollowLeadingSymlink(t *testing.T) {
+	w, c, root, outside := symlinkTestRepo(t, map[string]string{"s/config": "tracked"})
+
+	// Replace the tracked directory by a symlink pointing out of the worktree.
+	if err := os.RemoveAll(filepath.Join(root, "s")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "s")); err != nil {
+		t.Fatal(err)
+	}
+
+	f, err := c.File("s/config")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := w.checkoutFile(f); err != nil {
+		t.Fatal(err)
+	}
+
+	_, err = os.Lstat(filepath.Join(outside, "config"))
+	assert.True(t, os.IsNotExist(err), "checkout wrote through a symlink outside of the worktree")
+
+	fi, err := os.Lstat(filepath.Join(root, "s"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert.True(t, fi.IsDir(), "blocking symlink should have been replaced by a directory")
+
+	got, err := os.ReadFile(filepath.Join(root, "s", "config"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert.Equal(t, "tracked", string(got))
+}
+
+func TestCheckoutFileDoesNotFollowFinalSymlink(t *testing.T) {
+	w, c, root, outside := symlinkTestRepo(t, map[string]string{"f": "tracked"})
+
+	victim := filepath.Join(outside, "victim")
+	if err := os.WriteFile(victim, []byte("original"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// Replace the tracked file by a symlink pointing to a file outside.
+	if err := os.Remove(filepath.Join(root, "f")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(victim, filepath.Join(root, "f")); err != nil {
+		t.Fatal(err)
+	}
+
+	f, err := c.File("f")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := w.checkoutFile(f); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := os.ReadFile(victim)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert.Equal(t, "original", string(got), "checkout clobbered a file outside of the worktree")
+
+	fi, err := os.Lstat(filepath.Join(root, "f"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert.True(t, fi.Mode().IsRegular(), "blocking symlink should have been replaced by a regular file")
+}
+
+func TestRemoveDoesNotFollowLeadingSymlink(t *testing.T) {
+	w, _, root, outside := symlinkTestRepo(t, map[string]string{"s/config": "tracked"})
+
+	victim := filepath.Join(outside, "victim")
+	if err := os.WriteFile(victim, []byte("original"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := os.RemoveAll(filepath.Join(root, "s")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "s")); err != nil {
+		t.Fatal(err)
+	}
+
+	err := rmFileAndDirsIfEmpty(w.Filesystem, "s/victim")
+	assert.Error(t, err)
+
+	_, err = os.Stat(victim)
+	assert.NoError(t, err, "delete followed a symlink outside of the worktree")
+}
