+
+// TestCVE202645022CommitVerifyUsesRawBytes is a regression test for
+// CVE-2026-45022 (CWE-345: Insufficient Verification of Data Authenticity).
+//
+// go-git used to compute the PGP verification payload by re-encoding a commit
+// from its parsed struct fields. Because Decode normalizes malformed objects
+// (e.g. a duplicated "author" header collapses to a single field), the
+// reconstructed payload could differ from the exact bytes that were signed,
+// letting a tampered object verify against a signature made over a different,
+// canonical object. The fix streams the payload from the original source bytes
+// with only the signature headers stripped, so the verification payload always
+// matches what was actually signed.
+//
+// Grounded on the upstream tests/objectverify "duplicate-author" case.
+func TestCVE202645022CommitVerifyUsesRawBytes(t *testing.T) {
+	// Commit with a duplicated author header and a gpgsig signature header.
+	raw := "tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\n" +
+		"parent 1111111111111111111111111111111111111111\n" +
+		"author Test Author <author@example.local> 1700000000 +0000\n" +
+		"author Override Author <override@example.local> 1700000001 +0000\n" +
+		"committer Test Committer <committer@example.local> 1700000000 +0000\n" +
+		"gpgsig -----BEGIN PGP SIGNATURE-----\n" +
+		" \n" +
+		" iHUEABYKAB0WIQTMqU0ycQ3f6g3PMoWMmmmF4LuV8QUCYGebVwAKCRCMmmmF4LuV\n" +
+		" -----END PGP SIGNATURE-----\n" +
+		"\n" +
+		"signed commit message\n"
+
+	o := &plumbing.MemoryObject{}
+	o.SetType(plumbing.CommitObject)
+	if _, err := o.Write([]byte(raw)); err != nil {
+		t.Fatalf("write object: %v", err)
+	}
+
+	commit := &Commit{}
+	if err := commit.Decode(o); err != nil {
+		t.Fatalf("decode commit: %v", err)
+	}
+
+	encoded := &plumbing.MemoryObject{}
+	if err := commit.EncodeWithoutSignature(encoded); err != nil {
+		t.Fatalf("encode without signature: %v", err)
+	}
+	er, err := encoded.Reader()
+	if err != nil {
+		t.Fatalf("reader: %v", err)
+	}
+	payload, err := io.ReadAll(er)
+	if err != nil {
+		t.Fatalf("read payload: %v", err)
+	}
+
+	got := string(payload)
+
+	// The signature headers must be stripped from the payload.
+	if strings.Contains(got, "gpgsig") || strings.Contains(got, "BEGIN PGP SIGNATURE") {
+		t.Fatalf("verification payload still contains signature headers:\n%s", got)
+	}
+
+	// The payload must preserve the ORIGINAL bytes (including the duplicated
+	// author header), not a normalized re-encoding. Before the fix the
+	// duplicated header was silently dropped, which is the bypass.
+	if strings.Count(got, "author ") != 2 {
+		t.Fatalf("verification payload dropped the duplicated author header; "+
+			"payload is a normalized re-encoding, not the signed bytes:\n%s", got)
+	}
+
+	want := "tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\n" +
+		"parent 1111111111111111111111111111111111111111\n" +
+		"author Test Author <author@example.local> 1700000000 +0000\n" +
+		"author Override Author <override@example.local> 1700000001 +0000\n" +
+		"committer Test Committer <committer@example.local> 1700000000 +0000\n" +
+		"\n" +
+		"signed commit message\n"
+	if got != want {
+		t.Fatalf("verification payload does not match signed bytes.\n got:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+// TestCVE202645022RejectsMultipleSignatures verifies that a commit carrying
+// more than one armored signature block is rejected, mirroring upstream's
+// tests/objectverify "double-signature" case. Multi-signature payloads cannot
+// be reduced to a single authoritative signer and must not verify.
+func TestCVE202645022RejectsMultipleSignatures(t *testing.T) {
+	sigBlock := "-----BEGIN PGP SIGNATURE-----\n" +
+		"\n" +
+		"iHUEABYKAB0WIQTMqU0ycQ3f6g3PMoWMmmmF4LuV8QUCYGebVwAKCRCMmmmF4LuV\n" +
+		"-----END PGP SIGNATURE-----\n"
+
+	commit := &Commit{
+		PGPSignature: sigBlock + sigBlock,
+	}
+
+	// The keyring argument is irrelevant: the multi-signature check happens
+	// before any keyring parsing.
+	_, err := commit.Verify("")
+	if err != ErrMultipleSignatures {
+		t.Fatalf("expected ErrMultipleSignatures, got %v", err)
+	}
+}
