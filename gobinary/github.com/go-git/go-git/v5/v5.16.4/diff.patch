+package git
+
+import (
+	"os"
+	"testing"
+
+	"github.com/go-git/go-billy/v5"
+	"github.com/go-git/go-billy/v5/memfs"
+	"github.com/go-git/go-billy/v5/osfs"
+	"github.com/go-git/go-billy/v5/util"
+	"github.com/go-git/go-git/v5/plumbing"
+	"github.com/go-git/go-git/v5/plumbing/filemode"
+	"github.com/go-git/go-git/v5/plumbing/object"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestCVE_2026_71556_CheckoutReplacesBlockingFinalSymlink pins the
+// final-component case at the checkout materialisation boundary: writing a
+// tracked regular file at a path that already exists as a symlink must
+// replace the symlink, not follow it and overwrite the link's target.
+// Grounded on upstream worktree_fs_test.go's
+// TestCheckoutReplacesBlockingFinalSymlink for fix commit 008a78f2.
+func TestCVE_2026_71556_CheckoutReplacesBlockingFinalSymlink(t *testing.T) {
+	run := func(t *testing.T, base billy.Filesystem) {
+		t.Helper()
+
+		w := &Worktree{Filesystem: base}
+
+		require.NoError(t, util.WriteFile(base, "target.txt", []byte("keep"), 0o644))
+		if err := base.Symlink("target.txt", "tracked.txt"); err != nil {
+			if isSymlinkWindowsNonAdmin(err) {
+				t.Skipf("symlink creation requires elevated privileges: %v", err)
+			}
+			require.NoError(t, err)
+		}
+
+		blobObj := &plumbing.MemoryObject{}
+		blobObj.SetType(plumbing.BlobObject)
+		_, err := blobObj.Write([]byte("replacement"))
+		require.NoError(t, err)
+		blob, err := object.DecodeBlob(blobObj)
+		require.NoError(t, err)
+
+		require.NoError(t, w.checkoutFile(object.NewFile("tracked.txt", filemode.Regular, blob)))
+
+		got, err := util.ReadFile(base, "tracked.txt")
+		require.NoError(t, err)
+		assert.Equal(t, "replacement", string(got))
+
+		// The symlink target must be untouched.
+		target, err := util.ReadFile(base, "target.txt")
+		require.NoError(t, err)
+		assert.Equal(t, "keep", string(target))
+
+		fi, err := base.Lstat("tracked.txt")
+		require.NoError(t, err)
+		assert.Zero(t, fi.Mode()&os.ModeSymlink, "tracked.txt must be a regular file, not a symlink")
+	}
+
+	t.Run("memfs", func(t *testing.T) { run(t, memfs.New()) })
+	t.Run("osfs", func(t *testing.T) { run(t, osfs.New(t.TempDir())) })
+}
+
+// TestCVE_2026_71556_CheckoutReplacesLeadingSymlink covers the symlink-mask
+// bypass (CVE-2021-21300 class): a leading directory component that already
+// exists as a symlink must be removed before the file is materialised, so
+// the write cannot escape the worktree by traversing the planted link.
+// Grounded on upstream TestForceCheckoutReplacesLeadingSymlink.
+func TestCVE_2026_71556_CheckoutReplacesLeadingSymlink(t *testing.T) {
+	run := func(t *testing.T, base billy.Filesystem) {
+		t.Helper()
+
+		w := &Worktree{Filesystem: base}
+
+		// A directory outside the intended write path, standing in for a
+		// sensitive location (e.g. .git) an attacker wants to redirect into.
+		require.NoError(t, base.MkdirAll("secret", 0o755))
+		require.NoError(t, util.WriteFile(base, "secret/keep.txt", []byte("keep"), 0o644))
+
+		// Plant the masking symlink: "s" -> "secret". A tracked entry at
+		// "s/planted.txt" would land in "secret" if the link were followed.
+		if err := base.Symlink("secret", "s"); err != nil {
+			if isSymlinkWindowsNonAdmin(err) {
+				t.Skipf("symlink creation requires elevated privileges: %v", err)
+			}
+			require.NoError(t, err)
+		}
+
+		blobObj := &plumbing.MemoryObject{}
+		blobObj.SetType(plumbing.BlobObject)
+		_, err := blobObj.Write([]byte("payload"))
+		require.NoError(t, err)
+		blob, err := object.DecodeBlob(blobObj)
+		require.NoError(t, err)
+
+		require.NoError(t, w.checkoutFile(object.NewFile("s/planted.txt", filemode.Regular, blob)))
+
+		// The leading symlink must have been replaced by a real directory.
+		fi, err := base.Lstat("s")
+		require.NoError(t, err)
+		assert.Zero(t, fi.Mode()&os.ModeSymlink, "leading symlink %q must be replaced by a real directory", "s")
+
+		// The file lands safely inside the worktree, not under the target.
+		got, err := util.ReadFile(base, "s/planted.txt")
+		require.NoError(t, err)
+		assert.Equal(t, "payload", string(got))
+
+		// The masked directory's contents must be untouched.
+		_, statErr := base.Lstat("secret/planted.txt")
+		assert.Error(t, statErr, "checkout must not write through the symlink into %q", "secret")
+	}
+
+	t.Run("memfs", func(t *testing.T) { run(t, memfs.New()) })
+	t.Run("osfs", func(t *testing.T) { run(t, osfs.New(t.TempDir())) })
+}
