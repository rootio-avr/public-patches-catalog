@@ -0,0 +1,66 @@
+package jsonparser
+
+import "testing"
+
+// Regression test for CVE-2020-35381 (CWE-125).
+//
+// Malformed bracket array-index path segments such as "[" or "[]" must not
+// cause an out-of-bounds slice / panic. The searchKeys() path was hardened in
+// v1.1.1; this test also covers the parallel bracket-index parse inside
+// EachKey(), which previously validated segments only with len >= 2 and
+// discarded the strconv.Atoi error.
+func TestCVE202035381_MalformedBracketPathsDoNotPanic(t *testing.T) {
+	data := []byte(`{"a":[1,2,3],"b":"x"}`)
+
+	malformed := [][]string{
+		{"["},
+		{"[]"},
+		{"[", "a"},
+		{"a", "["},
+		{"a", "[]"},
+	}
+
+	for _, path := range malformed {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("EachKey panicked on malformed path %v: %v", path, r)
+				}
+			}()
+			// Should return without panic and without invoking the callback
+			// for a malformed array-index segment.
+			EachKey(data, func(idx int, value []byte, vt ValueType, err error) {
+				t.Fatalf("callback unexpectedly fired for malformed path %v (idx=%d)", path, idx)
+			}, path)
+		}()
+
+		// Get/searchKeys path must also stay safe.
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("Get panicked on malformed path %v: %v", path, r)
+				}
+			}()
+			if _, _, _, err := Get(data, path...); err == nil {
+				t.Fatalf("expected error for malformed path %v, got nil", path)
+			}
+		}()
+	}
+}
+
+// Normal well-formed array-index paths must still resolve after the fix.
+func TestCVE202035381_WellFormedBracketPathStillWorks(t *testing.T) {
+	data := []byte(`{"a":[10,20,30]}`)
+
+	called := false
+	EachKey(data, func(idx int, value []byte, vt ValueType, err error) {
+		called = true
+		if string(value) != "20" {
+			t.Fatalf("expected value 20 for a[1], got %q", string(value))
+		}
+	}, []string{"a", "[1]"})
+
+	if !called {
+		t.Fatal("expected callback to fire for well-formed path a[1]")
+	}
+}
