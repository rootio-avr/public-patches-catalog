+
+package opts
+
+import (
+	"context"
+	"testing"
+
+	"github.com/containerd/containerd/containers"
+	"github.com/containerd/containerd/oci"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	runtime "k8s.io/cri-api/pkg/apis/runtime/v1"
+	runtimespec "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// TestWithCDIRefusesAnnotationSourcedDevices is a regression test for
+// CVE-2026-53492. CDI device references carried in free-form, attacker
+// controlled container annotations must NOT be trusted and injected: only
+// devices explicitly requested through the enforced CRI Config.CDIDevices
+// field are authorized. When a CDI device is present only in annotations, it
+// must be refused, and — because no authorized device remains — WithCDI must
+// return without attempting any host CDI registry lookup or device injection.
+func TestWithCDIRefusesAnnotationSourcedDevices(t *testing.T) {
+	// Attacker-controlled annotation naming a CDI device that was never
+	// authorized via the enforced CRI CDIDevices field.
+	annotations := map[string]string{
+		"cdi.k8s.io/vendor0": "vendor0.com/device=all",
+	}
+
+	spec := &oci.Spec{Linux: &runtimespec.Linux{}}
+	ctr := &containers.Container{ID: "cve-2026-53492"}
+
+	// No CDIDevices supplied: the only device reference is the untrusted one
+	// smuggled via annotations.
+	err := WithCDI(annotations, nil)(context.Background(), nil, ctr, spec)
+
+	// The device is refused, so no injection is attempted and the call
+	// succeeds without needing a matching host CDI spec.
+	require.NoError(t, err)
+
+	// The untrusted device must not have been injected into the OCI spec.
+	if spec.Linux != nil {
+		assert.Empty(t, spec.Linux.Devices,
+			"annotation-sourced CDI device must not be injected (CVE-2026-53492)")
+	}
+	assert.Nil(t, spec.Hooks,
+		"annotation-sourced CDI edits (hooks) must not be injected (CVE-2026-53492)")
+}
