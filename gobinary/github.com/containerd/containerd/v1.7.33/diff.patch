Description: Defensively reject checkpoint OCI images in CRI CreateContainer
 CVE-2026-50195 affects containerd v2.1 and later, where CRI checkpoint
 restore consumed attacker-controlled base-image metadata and created a local
 image tag from it. containerd v1.7.33 does not contain that restore path.
 This defense-in-depth patch makes both v1.7 CRI implementations fail closed
 when an OCI index carries the checkpoint marker, preventing checkpoint
 metadata from becoming a future or downstream image-tag poisoning path.
 Regression tests verify ordinary OCI indexes remain accepted while
 checkpoint indexes are rejected.
Origin: ai-synthesized, CVE-2026-50195
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-30

--- a/pkg/cri/server/container_create.go
+++ b/pkg/cri/server/container_create.go
@@ -18,6 +18,7 @@ package server
 
 import (
 	"context"
+	"encoding/json"
 	"errors"
 	"fmt"
 	"path/filepath"
@@ -33,6 +34,8 @@ import (
 
 	"github.com/containerd/containerd"
 	"github.com/containerd/containerd/containers"
+	"github.com/containerd/containerd/content"
+	"github.com/containerd/containerd/images"
 	"github.com/containerd/containerd/oci"
 	criconfig "github.com/containerd/containerd/pkg/cri/config"
 	cio "github.com/containerd/containerd/pkg/cri/io"
@@ -102,6 +105,15 @@ func (c *criService) CreateContainer(ctx context.Context, r *runtime.CreateConta
 	if err != nil {
 		return nil, fmt.Errorf("failed to get image from containerd %q: %w", image.ID, err)
 	}
+	if images.IsIndexType(containerdImage.Target().MediaType) {
+		rawIndex, err := content.ReadBlob(ctx, c.client.ContentStore(), containerdImage.Target())
+		if err != nil {
+			return nil, fmt.Errorf("failed to inspect image %q for checkpoint metadata: %w", image.ID, err)
+		}
+		if err := rejectCheckpointIndex(rawIndex); err != nil {
+			return nil, err
+		}
+	}
 
 	start := time.Now()
 	// Run container using the same runtime with sandbox.
@@ -310,6 +322,26 @@ func (c *criService) CreateContainer(ctx context.Context, r *runtime.CreateConta
 	return &runtime.CreateContainerResponse{ContainerId: id}, nil
 }
 
+const checkpointContainerNameAnnotation = "org.criu.checkpoint.container.name"
+
+// rejectCheckpointIndex fails closed for checkpoint OCI images. containerd
+// 1.7 does not implement checkpoint restore through CRI CreateContainer; in
+// particular, it must never consume attacker-controlled checkpoint metadata
+// or use it to create local image tags (CVE-2026-50195).
+func rejectCheckpointIndex(rawIndex []byte) error {
+	var index imagespec.Index
+	if err := json.Unmarshal(rawIndex, &index); err != nil {
+		return fmt.Errorf("failed to decode OCI image index: %w", err)
+	}
+	if checkpointName, ok := index.Annotations[checkpointContainerNameAnnotation]; ok {
+		return fmt.Errorf(
+			"checkpoint restore via CRI CreateContainer is unsupported; refusing checkpoint image for container %q (CVE-2026-50195)",
+			checkpointName,
+		)
+	}
+	return nil
+}
+
 // volumeMounts sets up image volumes for container. Rely on the removal of container
 // root directory to do cleanup. Note that image volume will be skipped, if there is criMounts
 // specified with the same destination.
