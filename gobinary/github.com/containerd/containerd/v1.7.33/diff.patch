Description: Fix CVE-2026-53492 — refuse CDI devices sourced from untrusted container annotations
 containerd's CRI WithCDI() spec option trusted CDI device references parsed
 from free-form, author-controlled container annotations and injected them into
 the OCI runtime spec. This let a user with pod-creation rights smuggle CDI
 edits (host device nodes, host mounts, hooks) that were never authorized
 through the kubelet device-plugin / resource-allocation path (the enforced CRI
 Config.CDIDevices field), bypassing Kubernetes resource enforcement. This patch
 hardens the reachable annotation-trust sink: only devices explicitly requested
 via the enforced Config.CDIDevices field are injected; devices found solely in
 annotations are logged and refused.
 .
 This is a novel, AI-synthesized defensive patch. The published upstream fixes
 exist only for the github.com/containerd/containerd/v2 module line (the
 checkpoint/restore delivery vector, which is an Unimplemented stub in v1.7.x);
 the underlying CWE-20 annotation-trust sink is nevertheless present and
 reachable in v1.7.33 via WithCDI() and is hardened here.
Origin: ai-synthesized, CVE-2026-53492
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-08-19

--- a/pkg/cri/opts/spec_linux.go
+++ b/pkg/cri/opts/spec_linux.go
@@ -158,17 +158,22 @@ func WithCDI(annotations map[string]string, CDIDevices []*runtime.CDIDevice) oci
 		}
 
 		if devsFromAnnotations != nil {
-			log.G(ctx).Infof("Container %v: CDI devices from annotations: %v", c.ID, devsFromAnnotations)
+			// CVE-2026-53492: CDI device references carried in free-form
+			// container annotations are attacker-controlled and are NOT
+			// authorized through the kubelet device-plugin / resource
+			// allocation path (which populates the CRI Config.CDIDevices
+			// field). Trusting them here would let a user with pod-creation
+			// rights inject arbitrary host CDI edits (device nodes, host
+			// mounts, hooks) and bypass resource enforcement. Only devices
+			// explicitly requested via the enforced Config.CDIDevices field
+			// are injected; annotation-sourced devices are refused.
 			for _, deviceName := range devsFromAnnotations {
 				if ctrdutil.InStringSlice(devices, deviceName) {
-					// TODO: change to Warning when passing CDI devices as annotations is deprecated
-					log.G(ctx).Debugf("Skipping duplicated CDI device %s", deviceName)
+					// Also requested via the enforced CRI field: allowed.
 					continue
 				}
-				devices = append(devices, deviceName)
+				log.G(ctx).Warnf("Container %v: refusing CDI device %q requested via untrusted annotations; pass it through the CRI CDIDevices field instead (CVE-2026-53492)", c.ID, deviceName)
 			}
-			// TODO: change to Warning when passing CDI devices as annotations is deprecated
-			log.G(ctx).Debug("Passing CDI devices as annotations will be deprecated soon, please use CRI CDIDevices instead")
 		}
 
 		if len(devices) == 0 {
