+// TestSliceMapToSlice_CVE_2026_77354 verifies that sliceMapToSlice rejects
+// attacker-controlled sparse array indexes (as produced by deepObject query
+// parameters) instead of allocating a slice sized to the raw index. A ~24-byte
+// input such as param[items][50000000]=x previously forced a multi-gigabyte
+// heap allocation before schema validation (maxItems) ever ran.
+func TestSliceMapToSlice_CVE_2026_77354(t *testing.T) {
+	// A single huge index with only one supplied element must be rejected
+	// rather than driving an allocation proportional to the index.
+	_, err := sliceMapToSlice(map[string]any{"50000000": "x"})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "too sparse")
+
+	// A gap of exactly maxSliceMapToSliceGap+1 (with a single element) is
+	// still too sparse and must be rejected.
+	{
+		idx := fmt.Sprintf("%d", maxSliceMapToSliceGap+1)
+		_, err := sliceMapToSlice(map[string]any{idx: "x"})
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "too sparse")
+	}
+
+	// Negative indexes must be rejected outright.
+	_, err = sliceMapToSlice(map[string]any{"-1": "x"})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "must not be negative")
+
+	// Non-integer indexes remain rejected as before.
+	_, err = sliceMapToSlice(map[string]any{"abc": "x"})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "must be integers")
+
+	// A dense, well-formed sparse array within the allowed gap must still
+	// decode successfully and preserve holes as nil.
+	got, err := sliceMapToSlice(map[string]any{"0": "a", "2": "c"})
+	require.NoError(t, err)
+	require.Equal(t, []any{"a", nil, "c"}, got)
+
+	// A large-but-bounded sparse array (max index == maxSliceMapToSliceGap,
+	// gap within the allowed limit) must still decode successfully.
+	{
+		idx := fmt.Sprintf("%d", maxSliceMapToSliceGap)
+		got, err := sliceMapToSlice(map[string]any{"0": "a", idx: "z"})
+		require.NoError(t, err)
+		require.Len(t, got, maxSliceMapToSliceGap+1)
+	}
+}
