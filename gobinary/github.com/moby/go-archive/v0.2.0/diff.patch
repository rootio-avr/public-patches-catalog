+package archive
+
+import (
+	"archive/tar"
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestUntarSymlinkBreakout is a regression test for CVE-2026-17106: a crafted
+// archive that chains symlinks to escape the extraction directory and write a
+// file at an arbitrary path (link following / path traversal). It ports the
+// upstream regression test added in moby/go-archive df55fdf.
+//
+// The archive creates "inner/go_up" -> ".." and then "inner/go_up/escape" ->
+// "../victim"; a following regular-file entry "inner/go_up/escape/newfile"
+// would, without containment, be written into the sibling "victim" directory
+// outside dest. The extractor must either reject the traversal or redirect the
+// write back inside dest, so victim/newfile must never appear.
+func TestUntarSymlinkBreakout(t *testing.T) {
+	tmpdir := t.TempDir()
+	dest := filepath.Join(tmpdir, "dest")
+	victim := filepath.Join(tmpdir, "victim")
+	if err := os.Mkdir(dest, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(victim, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	buf := &bytes.Buffer{}
+	tw := tar.NewWriter(buf)
+	for _, hdr := range []*tar.Header{
+		{Name: "inner", Typeflag: tar.TypeDir, Mode: 0o755},
+		{Name: "inner/go_up", Typeflag: tar.TypeSymlink, Linkname: ".."},
+		{Name: "inner/go_up/escape", Typeflag: tar.TypeSymlink, Linkname: "../victim"},
+		{Name: "inner/go_up/escape/newfile", Typeflag: tar.TypeReg, Mode: 0o644},
+	} {
+		if err := tw.WriteHeader(hdr); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_ = tw.Close()
+
+	// Ignore any extraction error: a breakoutError means the escape was
+	// caught; no error means the write was safely redirected within dest.
+	// NoLchown suppresses the ownership call so the test runs without root.
+	_ = Untar(buf, dest, &TarOptions{NoLchown: true})
+
+	// victim/newfile must not exist; its presence proves a breakout.
+	if _, err := os.Lstat(filepath.Join(victim, "newfile")); err == nil {
+		t.Fatal("archive breakout: newfile was written outside extraction root via symlink chain")
+	}
+}
+
+// TestUntarRejectsParentTraversal verifies that an entry whose name escapes the
+// destination via ".." components is rejected rather than written outside dest.
+func TestUntarRejectsParentTraversal(t *testing.T) {
+	tmpdir := t.TempDir()
+	dest := filepath.Join(tmpdir, "dest")
+	if err := os.Mkdir(dest, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	buf := &bytes.Buffer{}
+	tw := tar.NewWriter(buf)
+	if err := tw.WriteHeader(&tar.Header{
+		Name:     "../escape.txt",
+		Typeflag: tar.TypeReg,
+		Mode:     0o644,
+		Size:     int64(len("pwned")),
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tw.Write([]byte("pwned")); err != nil {
+		t.Fatal(err)
+	}
+	_ = tw.Close()
+
+	err := Untar(buf, dest, &TarOptions{NoLchown: true})
+	if err == nil {
+		t.Fatal("expected Untar to reject an entry escaping the destination via '..'")
+	}
+
+	// escape.txt must not have been written in the parent (tmpdir) of dest.
+	if _, statErr := os.Lstat(filepath.Join(tmpdir, "escape.txt")); statErr == nil {
+		t.Fatal("archive breakout: escape.txt was written outside the extraction root")
+	}
+}
