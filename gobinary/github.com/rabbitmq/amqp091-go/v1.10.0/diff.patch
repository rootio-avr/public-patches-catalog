+// size below the AMQP spec minimum floor (frameMinSize, 4096 bytes), which
+// would otherwise force extreme frame fragmentation and CPU overhead.
+func TestNegotiationEnforcesFrameMinSize(t *testing.T) {
+	tests := []struct {
+		name             string
+		clientFrameSize  int
+		serverFrameMax   int
+		expectedFrameMin int
