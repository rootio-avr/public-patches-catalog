+
+// Regression test for CVE-2026-77411: readLongstr must return an error when the
+// declared longstr length exceeds max int32, instead of silently returning an
+// empty string. The oversized bytes must never be treated as valid frame data.
+func TestReadLongstrOversizeLengthReturnsError(t *testing.T) {
+	testCases := []struct {
+		name    string
+		encoded []byte
+	}{
+		{
+			// 0x80000000 = max_int32 + 1 — first value past the accepted range.
+			name:    "max-int32-plus-one",
+			encoded: []byte{0x80, 0x00, 0x00, 0x00},
+		},
+		{
+			// 0xFFFFFFFF = max uint32 — largest possible declared length.
+			name:    "max-uint32",
+			encoded: []byte{0xFF, 0xFF, 0xFF, 0xFF},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := readLongstr(bytes.NewReader(tc.encoded))
+			if err == nil {
+				t.Fatal("expected error for oversized longstr length, got nil")
+			}
+		})
+	}
+}
+
+// A well-formed short longstr must still decode successfully after the fix.
+func TestReadLongstrValidLengthStillDecodes(t *testing.T) {
+	var buf bytes.Buffer
+	buf.Write([]byte{0x00, 0x00, 0x00, 0x05}) // declared length = 5
+	buf.WriteString("hello")
+
+	v, err := readLongstr(&buf)
+	if err != nil {
+		t.Fatalf("unexpected error for valid longstr: %v", err)
+	}
+	if v != "hello" {
+		t.Fatalf("expected %q, got %q", "hello", v)
+	}
+}

