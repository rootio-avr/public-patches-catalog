+package amqp091
+
+import (
+	"testing"
+)
+
+// TestConnectionOpenCompleteZerosSASLCredentials is a replacement regression
+// test for CVE-2026-77407. The upstream unit test lives in
+// connection_unit_test.go which is not shipped in v1.10.0, and the Reconnect()
+// restoration test it also contains relies on recovery infrastructure absent
+// from this release. This test verifies the backported core: plaintext SASL
+// passwords are zeroed out after openComplete runs.
+func TestConnectionOpenCompleteZerosSASLCredentials(t *testing.T) {
+	pa := &PlainAuth{Username: "user", Password: "secretpassword"}
+	apa := &AMQPlainAuth{Username: "user", Password: "secretpassword"}
+
+	c := &Connection{
+		Config: Config{
+			SASL: []Authentication{pa, apa},
+		},
+	}
+
+	if err := c.openComplete(); err != nil {
+		t.Fatalf("unexpected error from openComplete: %v", err)
+	}
+
+	if pa.Password != "" {
+		t.Errorf("expected PlainAuth password to be zeroed out, got %q", pa.Password)
+	}
+
+	if apa.Password != "" {
+		t.Errorf("expected AMQPlainAuth password to be zeroed out, got %q", apa.Password)
+	}
+}

