+		t.Fatalf("expected ErrFrameTooLarge one byte over the limit, got: %v", err)
+	}
+
+	var unlimited atomic.Uint32
+	r = reader{r: bytes.NewReader(build(negotiatedMax * 4)), maxFrameSize: &unlimited}
+	if _, err := r.ReadFrame(); err != nil {
