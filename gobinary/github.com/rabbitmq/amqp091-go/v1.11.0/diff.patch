+// Regression tests for reader hardening (CVE-2026-77410): heartbeat frames on
+// non-zero channels, allocation driven by attacker-declared lengths, and
+// unbounded nesting/size of field arrays and tables.
+
+package amqp091
+
+import (
+	"bytes"
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func be32(n int) []byte {
+	b := make([]byte, 4)
+	binary.BigEndian.PutUint32(b, uint32(n))
+	return b
+}
+
+func TestReadFrameRejectsHeartbeatOnNonZeroChannel(t *testing.T) {
+	r := reader{strings.NewReader("\x08\x00\x01\x00\x00\x00\x00\xce")}
+	f, err := r.ReadFrame()
+	if err == nil {
+		t.Fatalf("expected an error for a heartbeat on channel 1, got frame %#v", f)
+	}
+
+	// A heartbeat on channel 0 remains valid.
+	r = reader{strings.NewReader("\x08\x00\x00\x00\x00\x00\x00\xce")}
+	f, err = r.ReadFrame()
+	if err != nil {
+		t.Fatalf("unexpected error for heartbeat on channel 0: %v", err)
+	}
+	if _, ok := f.(*heartbeatFrame); !ok {
+		t.Fatalf("expected *heartbeatFrame, got %T", f)
+	}
+}
+
+func TestReadFrameBodyDeclaredSizeExceedsData(t *testing.T) {
+	// Body frame on channel 1 declaring a ~4GiB payload but carrying 3 bytes.
+	r := reader{strings.NewReader("\x03\x00\x01\xff\xff\xff\xffabc")}
+	if _, err := r.ReadFrame(); err == nil {
+		t.Fatal("expected an error for a truncated body frame")
+	}
+
+	// A well-formed body frame still parses.
+	r = reader{strings.NewReader("\x03\x00\x01\x00\x00\x00\x03abc\xce")}
+	f, err := r.ReadFrame()
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	bf, ok := f.(*bodyFrame)
+	if !ok || string(bf.Body) != "abc" {
+		t.Fatalf("unexpected frame: %#v", f)
+	}
+}
+
+func TestReadBytes(t *testing.T) {
+	if _, err := readBytes(strings.NewReader("abc"), 1<<30); err == nil {
+		t.Fatal("expected an error when declared length exceeds available data")
+	}
+	if _, err := readBytes(strings.NewReader("abc"), -1); err == nil {
+		t.Fatal("expected an error for a negative length")
+	}
+
+	want := bytes.Repeat([]byte{'x'}, 3*readAllocChunk+5)
+	got, err := readBytes(bytes.NewReader(want), int64(len(want)))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatal("readBytes returned unexpected data")
+	}
+}
+
+func nestedArray(depth int) []byte {
+	var payload []byte
+	for i := 0; i < depth; i++ {
+		inner := append([]byte{'A'}, be32(len(payload))...)
+		payload = append(inner, payload...)
+	}
+	return append(be32(len(payload)), payload...)
+}
+
+func TestReadArrayRejectsExcessiveNesting(t *testing.T) {
+	if _, err := readArray(bytes.NewReader(nestedArray(maxFieldDepth * 4))); err == nil {
+		t.Fatal("expected an error for deeply nested arrays")
+	}
+	if _, err := readArray(bytes.NewReader(nestedArray(3))); err != nil {
+		t.Fatalf("unexpected error for shallow nesting: %v", err)
+	}
+}
+
+func TestReadArrayRejectsTooManyElements(t *testing.T) {
+	// Each 'V' (void) element is a single wire byte but a full `any` slot.
+	n := maxContainerElements + 1
+	data := append(be32(n), bytes.Repeat([]byte{'V'}, n)...)
+	if _, err := readArray(bytes.NewReader(data)); err == nil {
+		t.Fatal("expected an error for an oversized array")
+	}
+
+	data = append(be32(10), bytes.Repeat([]byte{'V'}, 10)...)
+	arr, err := readArray(bytes.NewReader(data))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(arr) != 10 {
+		t.Fatalf("expected 10 elements, got %d", len(arr))
+	}
+}
