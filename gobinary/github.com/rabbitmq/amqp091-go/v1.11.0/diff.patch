+func TestReadFrameAcceptsFrameAtLimit(t *testing.T) {
+	const negotiatedMax = 4096
+
+	build := func(payload int) []byte {
+		b := make([]byte, 7, 7+payload+1)
+		b[0] = frameBody
+		binary.BigEndian.PutUint16(b[1:3], 1)
+		binary.BigEndian.PutUint32(b[3:7], uint32(payload))
+		b = append(b, make([]byte, payload)...)
+		return append(b, frameEnd)
+	}
+
+	var maxFrameSize atomic.Uint32
+	maxFrameSize.Store(negotiatedMax)
+
+	r := reader{r: bytes.NewReader(build(negotiatedMax - frameHeaderSize)), maxFrameSize: &maxFrameSize}
+	if _, err := r.ReadFrame(); err != nil {
