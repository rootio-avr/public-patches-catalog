@@ -1367,6 +1367,14 @@
 	}
 	return min(client, server)
 }
+
+func negotiateFrameSize(client, server int) int {
+	size := pick(client, server)
+	if size > 0 && size < frameMinSize {
+		return frameMinSize
+	}
+	return size
+}

