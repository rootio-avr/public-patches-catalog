new file mode 100644
index 0000000..7f214ef
--- /dev/null
+++ b/fips_test.go
@@ -0,0 +1,51 @@
+// Copyright 2026 Root.io. Licensed under the Apache License, Version 2.0.
+
+package nkeys
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/fips140"
+	"crypto/rand"
+	"encoding/hex"
+	"testing"
+)
+
+// nkeys#94: NewKeyFromSeed derives the same keys GenerateKey(bytes.NewReader(seed)) did.
+func TestKeysFromSeedUnchanged(t *testing.T) {
+	for i := 0; i < 1000; i++ {
+		seed := make([]byte, ed25519.SeedSize)
+		rand.Read(seed)
+		wantPub, wantPriv, _ := ed25519.GenerateKey(bytes.NewReader(seed))
+		enc, err := EncodeSeed(PrefixByteUser, seed)
+		if err != nil {
+			t.Fatal(err)
+		}
+		pub, priv, err := (&kp{enc}).keys()
+		if err != nil || !bytes.Equal(pub, wantPub) || !bytes.Equal(priv, wantPriv) {
+			t.Fatalf("seed %x: keys differ (err %v)", seed, err)
+		}
+	}
+}
+
+// Golden values from upstream nkeys v0.4.16 (plain mode).
+func TestGoldenUserKey(t *testing.T) {
+	kp, err := FromSeed([]byte("SUAAOBYHA4DQOBYHA4DQOBYHA4DQOBYHA4DQOBYHA4DQOBYHA4DQOBZ5FE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if pub, _ := kp.PublicKey(); pub != "UDVEU3DD4KOFECV66VIHWEZOYX4ZKR3WV27L464SIIPOU2IUI3JCYSJF" {
+		t.Errorf("PublicKey = %s", pub)
+	}
+	sig, _ := kp.Sign([]byte("m"))
+	if hex.EncodeToString(sig) != "058030d4a08971a38d20eb455bad733e673d4b2d94e5c712a2447aa3b0020b2c51ae4efd222d4ffbc7088ce868472db660b315d6d3a8bf8d2e4691d05ba23d02" {
+		t.Errorf("Sign = %x", sig)
+	}
+	if fips140.Enabled() {
+		return
+	}
+	ck, _ := FromCurveSeed([]byte("SXAAGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGA6CQY"))
+	if pub, _ := ck.PublicKey(); pub != "XBO75XJ3NPKH635CR3QV3FU5LOYOUU3XJVEIXWXZ34OG4AJEWPXSFWVH" {
+		t.Errorf("curve PublicKey = %s", pub)
+	}
+}
diff --git a/fipstest/fips_test.go b/fipstest/fips_test.go
new file mode 100644
index 0000000..f9794f8
--- /dev/null
+++ b/fipstest/fips_test.go
@@ -0,0 +1,76 @@
+// Copyright 2026 Root.io. Licensed under the Apache License, Version 2.0.
+
+//go:debug fips140=on
+
+// Package fipstest checks the Root FIPS build of nkeys in FIPS 140 mode (the
+// fips140=on mode Root FIPS images ship); its own package so the //go:debug
+// directive affects only this test binary.
+package fipstest
+
+import (
+	"bytes"
+	"crypto/fips140"
+	"errors"
+	"testing"
+
+	"github.com/nats-io/nkeys"
+)
+
+func TestFIPSModeOn(t *testing.T) {
+	if !fips140.Enabled() {
+		t.Fatal("fips140.Enabled() = false: the //go:debug directive did not apply")
+	}
+}
+
+// Ed25519 nkeys (users, accounts, operators, servers) keep working.
+func TestEd25519Unaffected(t *testing.T) {
+	kp, err := nkeys.CreateUser()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sig, err := kp.Sign([]byte("m"))
+	if err != nil || kp.Verify([]byte("m"), sig) != nil {
+		t.Fatalf("sign/verify: %v", err)
+	}
+	pub, _ := kp.PublicKey()
+	pk, err := nkeys.FromPublicKey(pub)
+	if err != nil || pk.Verify([]byte("m"), sig) != nil {
+		t.Fatalf("verify by public key: %v", err)
+	}
+}
+
+// Curve (xkv1, X25519 + XSalsa20-Poly1305) operations return ErrFIPSCurve, never panic.
+func TestCurveRefused(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("panic: %v", r)
+		}
+	}()
+	// nats-server < 2.12.1 does `xkp, _ := nkeys.CreateCurveKeys(); xpub, _ := xkp.PublicKey()`.
+	xkp, err := nkeys.CreateCurveKeys()
+	if err != nil || xkp == nil {
+		t.Fatalf("CreateCurveKeys = %v, %v", xkp, err)
+	}
+	if _, err := xkp.Seed(); err != nil {
+		t.Errorf("Seed: %v", err)
+	}
+	if _, err := xkp.PrivateKey(); err != nil {
+		t.Errorf("PrivateKey: %v", err)
+	}
+	if pub, err := xkp.PublicKey(); pub != "" || !errors.Is(err, nkeys.ErrFIPSCurve) {
+		t.Errorf("PublicKey = %q, %v", pub, err)
+	}
+	recip := "XBO75XJ3NPKH635CR3QV3FU5LOYOUU3XJVEIXWXZ34OG4AJEWPXSFWVH"
+	if ct, err := xkp.Seal([]byte("m"), recip); ct != nil || !errors.Is(err, nkeys.ErrFIPSCurve) {
+		t.Errorf("Seal = %x, %v", ct, err)
+	}
+	if ct, err := xkp.SealWithRand([]byte("m"), recip, bytes.NewReader(make([]byte, 24))); ct != nil || !errors.Is(err, nkeys.ErrFIPSCurve) {
+		t.Errorf("SealWithRand = %x, %v", ct, err)
+	}
+	if pt, err := xkp.Open(make([]byte, 64), recip); pt != nil || !errors.Is(err, nkeys.ErrFIPSCurve) {
+		t.Errorf("Open = %x, %v", pt, err)
+	}
+	if _, err := nkeys.FromCurveSeed([]byte("SXAAGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGA6CQY")); err != nil {
+		t.Errorf("FromCurveSeed: %v", err)
+	}
+}
