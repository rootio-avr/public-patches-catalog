+// A wire-declared element count that the remaining bytes cannot possibly back
+// must be rejected before it is handed to the caller, which uses it to size an
+// allocation.
+func TestContainerSizeExceedsRemainingBytes(t *testing.T) {
+	const bogusCount = 1000000
+
+	for _, c := range []struct {
+		name    string
+		factory TProtocolFactory
+	}{
+		{"binary", NewTBinaryProtocolFactoryConf(&TConfiguration{})},
+		{"compact", NewTCompactProtocolFactoryConf(&TConfiguration{})},
+		{"json", NewTJSONProtocolFactory()},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			trans := NewTMemoryBuffer()
+			writeTruncatedListHeader(t, c.factory.GetProtocol(trans), bogusCount)
+
+			read := NewTMemoryBuffer()
+			read.Write(trans.Bytes())
+			size, err := readListHeader(t, c.factory.GetProtocol(read))
+			if err == nil {
+				t.Fatalf("ReadListBegin accepted size %d with only %d bytes of payload",
+					size, len(trans.Bytes()))
+			}
+			requireSizeLimit(t, err)
+		})
+	}
+}
+
+// The same count must still be accepted when the transport cannot report how
+// many bytes remain: rejecting there would break streaming transports.
+func TestContainerSizeUnknownRemainingBytes(t *testing.T) {
+	const count = 1000000
+
+	buf := NewTMemoryBuffer()
+	writeTruncatedListHeader(t, NewTBinaryProtocolConf(buf, &TConfiguration{}), count)
+
+	trans := NewStreamTransportR(bytes.NewReader(buf.Bytes()))
+	if got := trans.RemainingBytes(); got != UnknownRemainingBytes {
+		t.Fatalf("precondition: StreamTransport.RemainingBytes() = %d, want UnknownRemainingBytes", got)
+	}
+	size, err := readListHeader(t, NewTBinaryProtocolConf(trans, &TConfiguration{}))
+	if err != nil {
+		t.Fatalf("ReadListBegin rejected size on an unknown-size transport: %v", err)
+	}
+	if size != count {
+		t.Errorf("size = %d, want %d", size, count)
+	}
+}
+
+// Layered transports must report their own readable bytes, or unknown, but
+// never the (stale) value of the transport below them.
+func TestLayeredTransportRemainingBytes(t *testing.T) {
+	payload := bytes.Repeat([]byte{1}, 64)
+
+	zlibTrans, err := NewTZlibTransport(NewTMemoryBuffer(), 6)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := zlibTrans.RemainingBytes(); got != UnknownRemainingBytes {
+		t.Errorf("TZlibTransport.RemainingBytes() = %d, want UnknownRemainingBytes", got)
+	}
+
+	buffered := NewTBufferedTransport(NewTMemoryBuffer(), 128)
+	if _, err := buffered.tp.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	one := make([]byte, 1)
+	if _, err := buffered.Read(one); err != nil {
+		t.Fatal(err)
+	}
+	// One byte consumed; the other 63 sit in the bufio.Reader, not in the
+	// underlying memory buffer, and must still be counted.
+	if got, want := buffered.RemainingBytes(), uint64(len(payload)-1); got != want {
+		t.Errorf("TBufferedTransport.RemainingBytes() = %d, want %d", got, want)
+	}
+}
