+func TestGetMaxContainerSize(t *testing.T) {
+	var nilCfg *TConfiguration
+	if got := nilCfg.GetMaxContainerSize(); got <= 0 {
+		t.Errorf("nil config: expected no limit, got %d", got)
+	}
+	if got := (&TConfiguration{}).GetMaxContainerSize(); got <= 0 {
+		t.Errorf("zero config: expected no limit, got %d", got)
+	}
+	if got := (&TConfiguration{MaxContainerSize: 7}).GetMaxContainerSize(); got != 7 {
+		t.Errorf("expected 7, got %d", got)
+	}
+}
