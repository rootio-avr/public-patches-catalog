+func TestCheckContainerSizeForProtocol(t *testing.T) {
+	for _, c := range []struct {
+		label     string
+		size      int64
+		minElem   int32
+		remaining uint64
+		cfg       *TConfiguration
+		wantError bool
+	}{
+		{"small", 10, 8, UnknownRemainingBytes, &TConfiguration{}, false},
+		{"negative", -1, 8, UnknownRemainingBytes, &TConfiguration{}, true},
+		// 0x20000000 * 8 == 1<<32, i.e. 0 taken as a signed 32-bit product.
+		{"int32-product", 0x20000000, 8, UnknownRemainingBytes, &TConfiguration{}, true},
+		{"int64-count", 0x100000000, 2, UnknownRemainingBytes, &TConfiguration{}, true},
+		{"int64-product", 0x4000000000000000, 2, UnknownRemainingBytes, &TConfiguration{}, true},
+		{"fits-remaining", 10, 8, 80, &TConfiguration{}, false},
+		{"exceeds-remaining", 11, 8, 80, &TConfiguration{}, true},
+		{"nothing-remaining", 1, 1, 0, &TConfiguration{}, true},
+		{"empty-container", 0, 1, 0, &TConfiguration{}, false},
+		{"under-container-limit", 5, 1, UnknownRemainingBytes, &TConfiguration{MaxContainerSize: 5}, false},
+		{"over-container-limit", 6, 1, UnknownRemainingBytes, &TConfiguration{MaxContainerSize: 5}, true},
+		{"nil-config", 10, 1, UnknownRemainingBytes, nil, false},
+	} {
+		t.Run(c.label, func(t *testing.T) {
+			err := checkContainerSizeForProtocol(c.size, c.minElem, c.remaining, c.cfg)
+			if c.wantError && err == nil {
+				t.Errorf("size=%d minElem=%d: expected error, got nil", c.size, c.minElem)
+			}
+			if !c.wantError && err != nil {
+				t.Errorf("size=%d minElem=%d: unexpected error: %v", c.size, c.minElem, err)
+			}
+		})
+	}
+}
