+	n, err := l.r.Read(p)
+	if l.read+int64(n) > l.limit {
+		l.err = NewTProtocolExceptionWithType(
+			SIZE_LIMIT,
+			fmt.Errorf("frame too large after transform: more than %d bytes", l.limit),
+		)
+		n = int(l.limit - l.read)
+		l.read = l.limit
+		return n, l.err
+	}
+	l.read += int64(n)
+	return n, err
