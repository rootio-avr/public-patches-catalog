+// A list header that declares far more elements than the buffer holds must be
+// rejected before any element is read.
+func TestBinaryProtocolContainerCountExceedsRemaining(t *testing.T) {
+	ctx := context.Background()
+	for _, label := range []string{"list", "set", "map"} {
+		t.Run(label, func(t *testing.T) {
+			buf := NewTMemoryBuffer()
+			if label == "map" {
+				buf.Write([]byte{byte(I32), byte(I32)})
+			} else {
+				buf.Write([]byte{byte(I32)})
+			}
+			var size [4]byte
+			binary.BigEndian.PutUint32(size[:], 1<<20)
+			buf.Write(size[:])
+			buf.Write([]byte{0, 0, 0, 1}) // a single element's worth of data
+			p := NewTBinaryProtocolConf(buf, &TConfiguration{})
+			var err error
+			switch label {
+			case "list":
+				_, _, err = p.ReadListBegin(ctx)
+			case "set":
+				_, _, err = p.ReadSetBegin(ctx)
+			case "map":
+				_, _, _, err = p.ReadMapBegin(ctx)
+			}
+			if err == nil {
+				t.Fatal("expected error for count exceeding remaining bytes, got nil")
+			}
+		})
+	}
+}
