+func TestSafeReadBytesBounded(t *testing.T) {
+	// A huge declared size backed by little data must not allocate for the
+	// declared size.
+	src := bytes.NewReader([]byte("short"))
+	b, err := safeReadBytes(1<<30, src)
+	if err == nil {
+		t.Error("expected an error for short data")
+	}
+	if string(b) != "short" {
+		t.Errorf("unexpected bytes read: %q", b)
+	}
+	if cap(b) > 1<<20 {
+		t.Errorf("over-allocated %d bytes for 5 bytes of data", cap(b))
+	}
+
+	// A complete read ends in a buffer of exactly the requested size.
+	for _, size := range []int{0, 1, bytes.MinRead, bytes.MinRead + 1, 32 * 1024, 100000} {
+		data := bytes.Repeat([]byte{7}, size)
+		got, err := safeReadBytes(int32(size), bytes.NewReader(data))
+		if err != nil {
+			t.Fatalf("size %d: unexpected error: %v", size, err)
+		}
+		if !bytes.Equal(got, data) {
+			t.Errorf("size %d: data mismatch", size)
+		}
+		if size > bytes.MinRead && cap(got) != size {
+			t.Errorf("size %d: capacity %d, want exactly %d", size, cap(got), size)
+		}
+	}
