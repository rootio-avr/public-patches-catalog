+package v3
+
+import "testing"
+
+func TestLuaStringEscape(t *testing.T) {
+	cases := map[string]string{
+		`/app`:                         `/app`,
+		`/app" ); os.execute("id") --`: `/app\" ); os.execute(\"id\") --`,
+		`a\b`:                          `a\\b`,
+		`a\"b`:                         `a\\\"b`,
+	}
+	for input, want := range cases {
+		if got := luaStringEscape(input); got != want {
+			t.Errorf("luaStringEscape(%q) = %q, want %q", input, got, want)
+		}
+	}
+}
