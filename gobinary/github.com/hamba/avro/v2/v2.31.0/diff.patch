+			require.NoError(t, enc.Encode(int64(1)))
+			require.NoError(t, enc.Close())
+
+			raw := buf.Bytes()
+			sync := raw[len(raw)-16:]
+			headerEnd := bytes.Index(raw, sync) + 16
+			require.Equal(t, byte(0x02), raw[headerEnd])
+			sizeOffset := headerEnd + 1
+
+			w := avro.NewWriter(nil, 0)
