+package transport
+
+import (
+	"testing"
+	"time"
+)
+
+// controlBufferShortTimeout is a short duration used to assert that an
+// operation blocks. Defined locally because this version predates the shared
+// defaultTestShortTimeout constant in the transport test package.
+const controlBufferShortTimeout = 10 * time.Millisecond
+
+// TestControlBuffer_Throttle is a regression test for the HTTP/2 Rapid Reset
+// mitigation-bypass portion of GHSA-hrxh-6v49-42gf. Every control-buffer item
+// other than outgoing HEADERS and DATA frames must count toward the throttling
+// limit, so filling the buffer with throttled items (here, pings) must cause
+// throttle() to block until an item is consumed.
+func (s) TestControlBuffer_Throttle(t *testing.T) {
+	done := make(chan struct{})
+	defer close(done)
+	cb := newControlBuffer(done)
+
+	// Fill the control buffer up to the limit with throttled items.
+	for i := 0; i < maxQueuedControlBufferItems; i++ {
+		cb.put(&ping{})
+	}
+
+	// The next call to throttle should block.
+	throttleDone := make(chan struct{})
+	go func() {
+		cb.throttle()
+		close(throttleDone)
+	}()
+
+	select {
+	case <-throttleDone:
+		t.Fatal("throttle() did not block when the buffer was full")
+	case <-time.After(controlBufferShortTimeout):
+	}
+
+	// Consume one item from the control buffer.
+	if _, err := cb.get(true); err != nil {
+		t.Fatalf("cb.get(true) failed: %v", err)
+	}
+
+	// Now throttle() should unblock.
+	select {
+	case <-throttleDone:
+	case <-time.After(time.Second):
+		t.Fatal("throttle() did not unblock after an item was consumed")
+	}
+}
+
+// TestControlBuffer_NoThrottleForNonThrottledItems verifies that outgoing DATA
+// frames (and, by the same isThrottled contract, HEADERS frames) never count
+// toward the throttling limit, so they cannot deadlock a well-behaved peer.
+func (s) TestControlBuffer_NoThrottleForNonThrottledItems(t *testing.T) {
+	done := make(chan struct{})
+	defer close(done)
+	cb := newControlBuffer(done)
+
+	// Fill the control buffer with many more than limit number of non-throttled
+	// items.
+	for i := 0; i < maxQueuedControlBufferItems+10; i++ {
+		cb.put(&dataFrame{})
+	}
+
+	// throttle() should not block.
+	throttled := make(chan struct{})
+	go func() {
+		cb.throttle()
+		close(throttled)
+	}()
+
+	select {
+	case <-throttled:
+	case <-time.After(controlBufferShortTimeout):
+		t.Fatal("throttle() blocked for non-throttled items")
+	}
+}
