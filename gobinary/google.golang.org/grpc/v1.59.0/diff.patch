+package transport
+
+import "testing"
+
+// TestGHSA_hrxh_6v49_42gf_ControlBufferItemsThrottled verifies that all control
+// buffer items other than HEADERS and DATA frames now count towards the overall
+// throttling limit. Before the fix only a small subset of "transport response"
+// frames were counted, allowing a peer (e.g. via HTTP/2 Rapid Reset) to force
+// the server to queue an unbounded number of control frames such as
+// RST_STREAM (cleanupStream) and WINDOW_UPDATE without ever being throttled.
+func TestGHSA_hrxh_6v49_42gf_ControlBufferItemsThrottled(t *testing.T) {
+	throttled := []cbItem{
+		&cleanupStream{rst: true},
+		&cleanupStream{rst: false}, // even non-RST cleanups must be throttled now.
+		&earlyAbortStream{},
+		&registerStream{},
+		&incomingWindowUpdate{},
+		&outgoingWindowUpdate{},
+		&incomingSettings{},
+		&outgoingSettings{},
+		&incomingGoAway{},
+		&goAway{},
+		&ping{},
+		&outFlowControlSizeRequest{},
+		closeConnection{},
+	}
+	for _, it := range throttled {
+		if !it.isThrottled() {
+			t.Errorf("item %T isThrottled() = false, want true", it)
+		}
+	}
+
+	// HEADERS and DATA frames must NOT be throttled, otherwise legitimate
+	// streaming traffic would be starved.
+	notThrottled := []cbItem{
+		&headerFrame{},
+		&dataFrame{},
+	}
+	for _, it := range notThrottled {
+		if it.isThrottled() {
+			t.Errorf("item %T isThrottled() = true, want false", it)
+		}
+	}
+}
+
+// TestGHSA_hrxh_6v49_42gf_ControlBufferThrottleTriggers verifies that once the
+// number of queued throttled items reaches maxQueuedControlBufferItems, a
+// throttling channel is created so that throttle() blocks new reads.
+func TestGHSA_hrxh_6v49_42gf_ControlBufferThrottleTriggers(t *testing.T) {
+	done := make(chan struct{})
+	defer close(done)
+	cb := newControlBuffer(done)
+
+	// Before reaching the limit, throttle() must not block.
+	for i := 0; i < maxQueuedControlBufferItems-1; i++ {
+		if err := cb.put(&cleanupStream{rst: true}); err != nil {
+			t.Fatalf("put failed: %v", err)
+		}
+	}
+	if ch, _ := cb.trfChan.Load().(chan struct{}); ch != nil {
+		t.Fatalf("throttling channel created before reaching limit")
+	}
+
+	// The item that reaches the limit must create the throttling channel.
+	if err := cb.put(&cleanupStream{rst: true}); err != nil {
+		t.Fatalf("put failed: %v", err)
+	}
+	if ch, _ := cb.trfChan.Load().(chan struct{}); ch == nil {
+		t.Fatalf("throttling channel not created after reaching limit")
+	}
+}
