+package rbac
+
+import (
+	"testing"
+
+	v3rbacpb "github.com/envoyproxy/go-control-plane/envoy/config/rbac/v3"
+	v3matcherpb "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+)
+
+// TestGHSA_hrxh_6v49_42gf_NotRuleGuard verifies that a NotRule permission whose
+// inner rule is unsupported (and therefore produces zero matchers) returns an
+// error instead of panicking on an out-of-range slice index. Before the fix,
+// mList[0] would panic when the inner rule produced no matchers.
+func TestGHSA_hrxh_6v49_42gf_NotRuleGuard(t *testing.T) {
+	// A NotRule wrapping a rule with no oneof value set is unsupported and must
+	// not panic; it must return an error.
+	perms := []*v3rbacpb.Permission{
+		{Rule: &v3rbacpb.Permission_NotRule{NotRule: &v3rbacpb.Permission{}}},
+	}
+	if _, err := matchersFromPermissions(perms); err == nil {
+		t.Fatalf("matchersFromPermissions(NotRule with unsupported inner rule) = nil error, want error")
+	}
+}
+
+// TestGHSA_hrxh_6v49_42gf_NotIdGuard verifies the same protection for a NotId
+// principal wrapping an unsupported identifier.
+func TestGHSA_hrxh_6v49_42gf_NotIdGuard(t *testing.T) {
+	principals := []*v3rbacpb.Principal{
+		{Identifier: &v3rbacpb.Principal_NotId{NotId: &v3rbacpb.Principal{}}},
+	}
+	if _, err := matchersFromPrincipals(principals); err == nil {
+		t.Fatalf("matchersFromPrincipals(NotId with unsupported inner id) = nil error, want error")
+	}
+}
+
+// TestGHSA_hrxh_6v49_42gf_UnsupportedPermissionErrors verifies that a
+// permission with no recognized rule set is rejected with an error rather than
+// being silently treated as a no-op (which the OR semantics turned into an
+// authorization bypass).
+func TestGHSA_hrxh_6v49_42gf_UnsupportedPermissionErrors(t *testing.T) {
+	perms := []*v3rbacpb.Permission{{}}
+	if _, err := matchersFromPermissions(perms); err == nil {
+		t.Fatalf("matchersFromPermissions(unsupported permission) = nil error, want error")
+	}
+}
+
+// TestGHSA_hrxh_6v49_42gf_UnsupportedPrincipalErrors verifies the same for
+// principals.
+func TestGHSA_hrxh_6v49_42gf_UnsupportedPrincipalErrors(t *testing.T) {
+	principals := []*v3rbacpb.Principal{{}}
+	if _, err := matchersFromPrincipals(principals); err == nil {
+		t.Fatalf("matchersFromPrincipals(unsupported principal) = nil error, want error")
+	}
+}
+
+// TestGHSA_hrxh_6v49_42gf_MetadataNeverMatches verifies that a non-inverted
+// Metadata permission is compiled into a matcher that never matches, rather
+// than being dropped (which would leave an empty orMatcher that matches
+// everything and bypass authorization).
+func TestGHSA_hrxh_6v49_42gf_MetadataNeverMatches(t *testing.T) {
+	perms := []*v3rbacpb.Permission{
+		{Rule: &v3rbacpb.Permission_Metadata{Metadata: &v3matcherpb.MetadataMatcher{}}},
+	}
+	matchers, err := matchersFromPermissions(perms)
+	if err != nil {
+		t.Fatalf("matchersFromPermissions(Metadata) unexpected error: %v", err)
+	}
+	if len(matchers) != 1 {
+		t.Fatalf("matchersFromPermissions(Metadata) produced %d matchers, want 1", len(matchers))
+	}
+	if matchers[0].match(&rpcData{}) {
+		t.Fatalf("non-inverted Metadata permission matched, want no match")
+	}
+}

