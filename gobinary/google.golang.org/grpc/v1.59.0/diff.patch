+// TestRecvBufferCompaction is a replacement regression test for
+// CVE-2026-84304. The upstream test relies on the internal/mem package and
+// mem.BufferPool, which do not exist in this release; it is re-derived against
+// this version's *bytes.Buffer-based recvBuffer. It verifies that a long run
+// of tiny data frames in the backlog is coalesced into a single buffer once
+// the compaction threshold is crossed, bounding per-frame memory overhead.
+func (s) TestRecvBufferCompaction(t *testing.T) {
+	b := newRecvBuffer(nil)
+
+	// For N messages in the backlog, each of 1 byte:
+	//   uncompactedSuffixLen = N, uncompactedBytes = N
+	//   backlogHeapSize = N*(recvMsgSize+1)
+	// Compaction triggers once backlogHeapSize > compactionThreshold, i.e.
+	// once N > bufferPoolingThreshold. The first put goes to the channel, so
+	// we need bufferPoolingThreshold+2 total puts to place
+	// bufferPoolingThreshold+1 messages into the backlog.
+	numMessages := bufferPoolingThreshold + 2
+	payload := []byte{0x0a}
+
+	for i := 0; i < numMessages-1; i++ {
+		b.put(makeRecvMsg(payload))
+	}
+
+	// No compaction should have occurred yet.
+	if got, want := len(b.backlog), numMessages-2; got != want {
+		t.Fatalf("Got backlog length %d, want %d", got, want)
+	}
+
+	b.put(makeRecvMsg(payload))
+
+	// The trailing suffix should now be compacted into a single message.
+	if got, want := len(b.backlog), 1; got != want {
+		t.Fatalf("Got backlog length %d after compaction, want %d", got, want)
+	}
+	if b.uncompactedSuffixLen != 0 {
+		t.Fatalf("Got uncompactedSuffixLen %d, want 0", b.uncompactedSuffixLen)
+	}
+	if b.uncompactedBytes != 0 {
+		t.Fatalf("Got uncompactedBytes %d, want 0", b.uncompactedBytes)
+	}
+
+	// The first message is uncompacted, sitting in the channel.
+	select {
+	case msg1 := <-b.c:
+		if !bytes.Equal(msg1.buffer.Bytes(), payload) {
+			t.Errorf("Unexpected first message: %v", msg1.buffer.Bytes())
+		}
+	default:
+		t.Fatal("Expected first message to be in the channel")
+	}
+
+	b.load()
+
+	// The compacted message should hold every remaining 1-byte payload.
+	select {
+	case msgCompacted := <-b.c:
+		wantLen := numMessages - 1
+		if msgCompacted.buffer.Len() != wantLen {
+			t.Errorf("Got compacted buffer length %d, want %d", msgCompacted.buffer.Len(), wantLen)
+		}
+		wantPayload := bytes.Repeat(payload, wantLen)
+		if !bytes.Equal(msgCompacted.buffer.Bytes(), wantPayload) {
+			t.Errorf("Compacted payload mismatch")
+		}
