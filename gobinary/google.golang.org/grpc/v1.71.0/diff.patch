+// TestMatchersFromPermissions_NotRuleUnsupported verifies that a NotRule
+// wrapping an unsupported field returns an error rather than producing an
+// empty matcher that would panic at match time (GHSA-hrxh-6v49-42gf, xDS RBAC
+// server panic).
+func (s) TestMatchersFromPermissions_NotRuleUnsupported(t *testing.T) {
+	perms := []*v3rbacpb.Permission{{
+		Rule: &v3rbacpb.Permission_NotRule{
+			NotRule: &v3rbacpb.Permission{
+				// A nil rule is unsupported and must produce an error, not an
+				// empty matcher list that would be indexed out of range.
+				Rule: nil,
+			},
+		},
+	}}
+	if _, err := matchersFromPermissions(perms); err == nil {
+		t.Fatal("matchersFromPermissions() with NotRule over unsupported field succeeded, want error")
+	}
+}
