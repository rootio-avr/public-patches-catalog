+	}}
+	matchers, err := matchersFromPermissions(perms)
+	if err != nil {
+		t.Fatalf("matchersFromPermissions() failed: %v", err)
+	}
+	if len(matchers) != 1 {
+		t.Fatalf("matchersFromPermissions() returned %d matchers, want 1", len(matchers))
+	}
+	if _, ok := matchers[0].(*requestedServerNameMatcher); !ok {
+		t.Fatalf("matchersFromPermissions() = %T, want *requestedServerNameMatcher", matchers[0])
+	}
+	// An exact match on "" should match, since the requested server name is
+	// always compared against "".
+	if !matchers[0].match(&rpcData{}) {
+		t.Fatal("requestedServerNameMatcher.match() = false, want true")
+	}
+}
