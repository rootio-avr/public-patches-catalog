+// and that an inverted Metadata permission always matches. Previously the
+// non-inverted case produced no matcher at all, causing policy evaluation to
+// fail open (GHSA-hrxh-6v49-42gf, xDS RBAC authorization bypass).
+func (s) TestMatchersFromPermissions_Metadata(t *testing.T) {
+	perms := []*v3rbacpb.Permission{{
+		Rule: &v3rbacpb.Permission_Metadata{Metadata: &v3matcherpb.MetadataMatcher{}},
+	}}
+	matchers, err := matchersFromPermissions(perms)
+	if err != nil {
+		t.Fatalf("matchersFromPermissions() failed: %v", err)
+	}
+	if len(matchers) != 1 {
+		t.Fatalf("matchersFromPermissions() returned %d matchers, want 1", len(matchers))
+	}
+	if _, ok := matchers[0].(*neverMatcher); !ok {
+		t.Fatalf("matchersFromPermissions() = %T, want *neverMatcher", matchers[0])
+	}
+	if matchers[0].match(&rpcData{}) {
+		t.Fatal("neverMatcher.match() = true, want false")
+	}
+}
