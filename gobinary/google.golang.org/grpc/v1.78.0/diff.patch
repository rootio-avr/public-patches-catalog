+	}
+	if got := matchers[0].match(&rpcData{}); got != false {
+		t.Fatalf("non-inverted Metadata principal matched = %v, want false (must never authorize)", got)
+	}
+
+	principalsInvert := []*v3rbacpb.Principal{
