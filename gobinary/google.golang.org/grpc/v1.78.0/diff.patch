+// TestGHSAhrxh6v49_42gfMetadataPermissionNeverMatches is a regression test for
+// GHSA-hrxh-6v49-42gf (CWE-863). Prior to the fix, a Permission typed as
+// Metadata produced no matcher at all when Invert was false. Because a
+// permission list is combined with an orMatcher, an empty matcher list makes
+// the orMatcher unable to match, but the silent no-op semantics meant such a
+// permission was treated inconsistently. The fix makes a non-inverted Metadata
+// permission construct an explicit neverMatcher (never authorizes), and an
+// inverted Metadata permission an alwaysMatcher. This test asserts exactly one
+// matcher is produced in each case and that it evaluates to the correct result.
+func TestGHSAhrxh6v49_42gfMetadataPermissionNeverMatches(t *testing.T) {
+	// Non-inverted Metadata permission must map to a neverMatcher.
+	perms := []*v3rbacpb.Permission{
+		{Rule: &v3rbacpb.Permission_Metadata{Metadata: &v3matcherpb.MetadataMatcher{Invert: false}}},
+	}
+	matchers, err := matchersFromPermissions(perms)
+	if err != nil {
+		t.Fatalf("matchersFromPermissions(non-inverted Metadata) returned err: %v", err)
+	}
+	if len(matchers) != 1 {
+		t.Fatalf("matchersFromPermissions(non-inverted Metadata) produced %d matchers, want 1", len(matchers))
+	}
+	if got := matchers[0].match(&rpcData{}); got != false {
+		t.Fatalf("non-inverted Metadata permission matched = %v, want false (must never authorize)", got)
+	}
+
+	// Inverted Metadata permission must map to an alwaysMatcher.
+	permsInvert := []*v3rbacpb.Permission{
+		{Rule: &v3rbacpb.Permission_Metadata{Metadata: &v3matcherpb.MetadataMatcher{Invert: true}}},
+	}
+	matchersInvert, err := matchersFromPermissions(permsInvert)
+	if err != nil {
+		t.Fatalf("matchersFromPermissions(inverted Metadata) returned err: %v", err)
+	}
+	if len(matchersInvert) != 1 {
+		t.Fatalf("matchersFromPermissions(inverted Metadata) produced %d matchers, want 1", len(matchersInvert))
+	}
+	if got := matchersInvert[0].match(&rpcData{}); got != true {
+		t.Fatalf("inverted Metadata permission matched = %v, want true", got)
+	}
+}
