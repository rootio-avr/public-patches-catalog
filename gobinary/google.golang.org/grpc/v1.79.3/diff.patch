+
+	v3rbacpb "github.com/envoyproxy/go-control-plane/envoy/config/rbac/v3"
+	v3matcherpb "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+)
+
+// TestMatchersFromPermissions_Metadata verifies the fix for the xDS RBAC
+// authorization bypass / fail-open behavior (GHSA-hrxh-6v49-42gf). Prior to the
+// fix, a non-inverted Metadata permission was silently dropped (a no-op),
+// which removed the restriction entirely and could turn a deny into an allow.
+// After the fix, a non-inverted Metadata permission must translate to a
+// neverMatcher (fail-closed), and an inverted one to an alwaysMatcher.
+func (s) TestMatchersFromPermissions_Metadata(t *testing.T) {
+	tests := []struct {
+		name       string
+		invert     bool
+		wantNever  bool
+		wantAlways bool
+	}{
+		{name: "non-inverted metadata is fail-closed", invert: false, wantNever: true},
+		{name: "inverted metadata always matches", invert: true, wantAlways: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			perms := []*v3rbacpb.Permission{
+				{Rule: &v3rbacpb.Permission_Metadata{Metadata: &v3matcherpb.MetadataMatcher{Invert: test.invert}}},
+			}
+			matchers, err := matchersFromPermissions(perms)
+			if err != nil {
+				t.Fatalf("matchersFromPermissions() failed: %v", err)
+			}
+			if len(matchers) != 1 {
+				t.Fatalf("matchersFromPermissions() returned %d matchers, want 1", len(matchers))
+			}
+			if test.wantNever {
+				if _, ok := matchers[0].(*neverMatcher); !ok {
+					t.Fatalf("matchersFromPermissions() returned %T, want *neverMatcher", matchers[0])
+				}
+				if matchers[0].match(&rpcData{}) {
+					t.Fatal("neverMatcher.match() = true, want false")
+				}
+			}
+			if test.wantAlways {
+				if _, ok := matchers[0].(*alwaysMatcher); !ok {
+					t.Fatalf("matchersFromPermissions() returned %T, want *alwaysMatcher", matchers[0])
+				}
+			}
+		})
+	}
+}
+
+// TestMatchersFromPrincipals_Metadata verifies the same fail-closed behavior
+// for Metadata principals, which were also previously treated as a silent
+// no-op.
+func (s) TestMatchersFromPrincipals_Metadata(t *testing.T) {
+	principals := []*v3rbacpb.Principal{
+		{Identifier: &v3rbacpb.Principal_Metadata{Metadata: &v3matcherpb.MetadataMatcher{Invert: false}}},
+	}
+	matchers, err := matchersFromPrincipals(principals)
+	if err != nil {
+		t.Fatalf("matchersFromPrincipals() failed: %v", err)
+	}
+	if len(matchers) != 1 {
+		t.Fatalf("matchersFromPrincipals() returned %d matchers, want 1", len(matchers))
+	}
+	if _, ok := matchers[0].(*neverMatcher); !ok {
+		t.Fatalf("matchersFromPrincipals() returned %T, want *neverMatcher", matchers[0])
+	}
+}
+
+// TestMatchersFromPermissions_RequestedServerName verifies that a
+// RequestedServerName permission is now translated into a real matcher (that
+// matches against "") rather than being dropped as an unsupported no-op.
+func (s) TestMatchersFromPermissions_RequestedServerName(t *testing.T) {
+	tests := []struct {
+		name  string
+		exact string
+		want  bool
+	}{
+		{name: "matches empty string", exact: "", want: true},
+		{name: "does not match non-empty string", exact: "foo", want: false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			perms := []*v3rbacpb.Permission{
+				{Rule: &v3rbacpb.Permission_RequestedServerName{
+					RequestedServerName: &v3matcherpb.StringMatcher{
+						MatchPattern: &v3matcherpb.StringMatcher_Exact{Exact: test.exact},
+					},
+				}},
+			}
+			matchers, err := matchersFromPermissions(perms)
+			if err != nil {
+				t.Fatalf("matchersFromPermissions() failed: %v", err)
+			}
+			if len(matchers) != 1 {
+				t.Fatalf("matchersFromPermissions() returned %d matchers, want 1", len(matchers))
+			}
+			if _, ok := matchers[0].(*requestedServerNameMatcher); !ok {
+				t.Fatalf("matchersFromPermissions() returned %T, want *requestedServerNameMatcher", matchers[0])
+			}
+			if got := matchers[0].match(&rpcData{}); got != test.want {
+				t.Fatalf("requestedServerNameMatcher.match() = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
+
+// TestMatchersFromPermissions_NotRuleUnsupported verifies the panic fix
+// (GHSA-hrxh-6v49-42gf): a NotRule wrapping an unsupported field previously
+// produced an empty matcher list and then indexed mList[0], causing an
+// out-of-range panic. After the fix, the unsupported inner rule returns an
+// error which propagates safely instead of panicking.
+func (s) TestMatchersFromPermissions_NotRuleUnsupported(t *testing.T) {
+	perms := []*v3rbacpb.Permission{
+		{Rule: &v3rbacpb.Permission_NotRule{
+			// An empty inner Permission has no recognized rule set, which used
+			// to yield an empty matcher list.
+			NotRule: &v3rbacpb.Permission{},
+		}},
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("matchersFromPermissions() panicked on unsupported NotRule: %v", r)
+		}
+	}()
+	if _, err := matchersFromPermissions(perms); err == nil {
+		t.Fatal("matchersFromPermissions() succeeded on unsupported NotRule, want error")
+	}
+}
+
+// TestMatchersFromPrincipals_NotIdUnsupported verifies the analogous panic fix
+// for NotId principals wrapping an unsupported identifier.
+func (s) TestMatchersFromPrincipals_NotIdUnsupported(t *testing.T) {
+	principals := []*v3rbacpb.Principal{
+		{Identifier: &v3rbacpb.Principal_NotId{
+			NotId: &v3rbacpb.Principal{},
+		}},
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("matchersFromPrincipals() panicked on unsupported NotId: %v", r)
+		}
+	}()
+	if _, err := matchersFromPrincipals(principals); err == nil {
+		t.Fatal("matchersFromPrincipals() succeeded on unsupported NotId, want error")
+	}
+}

