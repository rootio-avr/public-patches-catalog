+func (s) TestRecvBufferCompactionSkippedLargeBuffer(t *testing.T) {
+	if !envconfig.EnableReceiveBufferCompaction {
+		t.Skip("receive buffer compaction is disabled")
+	}
+	b := newRecvBuffer()
+
+	// Put bufferPoolingThreshold single-byte messages into the backlog
+	// (bufferPoolingThreshold+1 total, one of which goes to the channel).
+	numSmallMessages := bufferPoolingThreshold + 1
+	payload := []byte{0x0a}
+	for i := 0; i < numSmallMessages; i++ {
+		b.put(recvMsg{buffer: bytes.NewBuffer(append([]byte(nil), payload...))})
+	}
+
+	if got, want := len(b.backlog), bufferPoolingThreshold; got != want {
+		t.Fatalf("Got backlog length %d, want %d", got, want)
+	}
+
+	// Send a large buffer sized so the utilization-factor check is satisfied.
+	largeSize := bufferPoolingThreshold*(recvMsgSize-1) + recvMsgSize
+	largePayload := make([]byte, largeSize)
+	b.put(recvMsg{buffer: bytes.NewBuffer(largePayload)})
+
+	// Verify that compaction was skipped and the counters were reset.
+	if got, want := len(b.backlog), bufferPoolingThreshold+1; got != want {
+		t.Fatalf("Got backlog length %d after large buffer (compaction skipped), want %d", got, want)
+	}
+	if b.uncompactedSuffixLen != 0 {
+		t.Fatalf("Got uncompactedSuffixLen %d, want 0", b.uncompactedSuffixLen)
+	}
+	if b.uncompactedBytes != 0 {
+		t.Fatalf("Got uncompactedBytes %d, want 0", b.uncompactedBytes)
+	}
+}
+
+// TestRecvBufferCompactionDisabled verifies that setting the escape-hatch env
+// var disables compaction entirely.
+func (s) TestRecvBufferCompactionDisabled(t *testing.T) {
+	orig := envconfig.EnableReceiveBufferCompaction
+	envconfig.EnableReceiveBufferCompaction = false
+	defer func() { envconfig.EnableReceiveBufferCompaction = orig }()
+
+	b := newRecvBuffer()
+
+	numMessages := bufferPoolingThreshold + 2
+	payload := []byte{0x0a}
+	for i := 0; i < numMessages; i++ {
+		b.put(recvMsg{buffer: bytes.NewBuffer(append([]byte(nil), payload...))})
+	}
+
+	// With compaction disabled, all but the first message stay in the backlog.
+	if got, want := len(b.backlog), numMessages-1; got != want {
+		t.Fatalf("Got backlog length %d, want %d", got, want)
+	}
+}

