+// TestRecvBufferCompaction verifies that once a large number of small data
+// frames accumulate in the recvBuffer backlog, they are coalesced into a
+// single buffer to restrict the memory overhead (CVE-2026-84304 regression).
+func (s) TestRecvBufferCompaction(t *testing.T) {
+	if !envconfig.EnableReceiveBufferCompaction {
+		t.Skip("receive buffer compaction is disabled")
+	}
+	b := newRecvBuffer()
+
+	// Compaction triggers once more than bufferPoolingThreshold single-byte
+	// messages accumulate in the backlog. The first message put goes directly
+	// to the channel, subsequent ones go to the backlog, so we need
+	// bufferPoolingThreshold+2 total messages.
+	numMessages := bufferPoolingThreshold + 2
+	payload := []byte{0x0a}
+
+	for i := 0; i < numMessages-1; i++ {
+		b.put(recvMsg{buffer: bytes.NewBuffer(append([]byte(nil), payload...))})
+	}
+
+	// Verify no compaction has occurred yet.
+	if got, want := len(b.backlog), numMessages-2; got != want {
+		t.Fatalf("Got backlog length %d, want %d", got, want)
+	}
+
+	b.put(recvMsg{buffer: bytes.NewBuffer(append([]byte(nil), payload...))})
+
+	// Verify that compaction occurred: the backlog should collapse to a single
+	// message.
+	if got, want := len(b.backlog), 1; got != want {
+		t.Fatalf("Got backlog length %d after compaction, want %d", got, want)
+	}
+	if b.uncompactedSuffixLen != 0 {
+		t.Fatalf("Got uncompactedSuffixLen %d, want 0", b.uncompactedSuffixLen)
+	}
+	if b.uncompactedBytes != 0 {
+		t.Fatalf("Got uncompactedBytes %d, want 0", b.uncompactedBytes)
+	}
+
+	// The first (uncompacted) message is in the channel.
+	select {
+	case msg1 := <-b.c:
+		if !bytes.Equal(msg1.buffer.Bytes(), payload) {
+			t.Errorf("Unexpected first message: %v", msg1.buffer.Bytes())
+		}
+	default:
+		t.Fatal("Expected first message to be in the channel")
+	}
+
+	b.load()
+
+	// Verify the compacted message.
+	select {
+	case msgCompacted := <-b.c:
+		wantLen := numMessages - 1
+		if msgCompacted.buffer.Len() != wantLen {
+			t.Errorf("Got compacted buffer length %d, want %d", msgCompacted.buffer.Len(), wantLen)
+		}
+		wantPayload := bytes.Repeat(payload, wantLen)
+		if !bytes.Equal(msgCompacted.buffer.Bytes(), wantPayload) {
+			t.Errorf("Compacted payload mismatch")
+		}
+	default:
+		t.Fatal("Expected compacted message to be loaded into the channel")
+	}
