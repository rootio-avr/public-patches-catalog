+// authorityTestConn is a net.Conn that also carries a usable route
+// configuration, matching the interface that routeAndProcess extracts from the
+// connection stored in the context.
+type authorityTestConn struct {
+	net.Conn
+	rc xdsresource.UsableRouteConfiguration
+}
+
+func (c *authorityTestConn) UsableRouteConfiguration() xdsresource.UsableRouteConfiguration {
+	return c.rc
+}
+
+// authorityTestStream is a minimal ServerTransportStream used to provide a
+// method name in the context.
+type authorityTestStream struct {
+	method string
+}
+
+func (s *authorityTestStream) Method() string               { return s.method }
+func (s *authorityTestStream) SetHeader(metadata.MD) error  { return nil }
+func (s *authorityTestStream) SendHeader(metadata.MD) error { return nil }
+func (s *authorityTestStream) SetTrailer(metadata.MD) error { return nil }
+
+// TestRouteAndProcessMissingAuthority is a regression test for CVE-2026-84445.
+// It verifies that routeAndProcess defensively rejects an RPC whose incoming
+// metadata is missing the :authority header, returning codes.Internal instead
+// of panicking on authority[0].
+func (s) TestRouteAndProcessMissingAuthority(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), defaultTestTimeout)
+	defer cancel()
+
+	conn := &authorityTestConn{rc: xdsresource.UsableRouteConfiguration{}}
+	ctx = transport.SetConnection(ctx, conn)
+	ctx = grpc.NewContextWithServerTransportStream(ctx, &authorityTestStream{method: "/test.Service/Method"})
+	// Incoming metadata that lacks a :authority header.
+	ctx = metadata.NewIncomingContext(ctx, metadata.MD{})
+
+	err := routeAndProcess(ctx)
+	if status.Code(err) != codes.Internal {
+		t.Fatalf("routeAndProcess() returned error code %v, want %v", status.Code(err), codes.Internal)
+	}
+	if err == nil || !strings.Contains(err.Error(), "no :authority header present") {
+		t.Fatalf("routeAndProcess() returned error %v, want error containing %q", err, "no :authority header present")
+	}
+}
