+// authorityTestStream is a minimal ServerTransportStream used to provide a
+// method name to routeAndProcess via the context.
+type authorityTestStream struct {
+	method string
+}
+
+func (s *authorityTestStream) Method() string               { return s.method }
+func (s *authorityTestStream) SetHeader(metadata.MD) error  { return nil }
+func (s *authorityTestStream) SendHeader(metadata.MD) error { return nil }
+func (s *authorityTestStream) SetTrailer(metadata.MD) error { return nil }
