+	principals := []*v3rbacpb.Principal{
+		{Identifier: &v3rbacpb.Principal_Metadata{Metadata: &v3matcherpb.MetadataMatcher{Invert: false}}},
+	}
+	matchers, err := matchersFromPrincipals(principals)
+	if err != nil {
+		t.Fatalf("matchersFromPrincipals() failed: %v", err)
+	}
+	if len(matchers) != 1 {
+		t.Fatalf("matchersFromPrincipals() returned %d matchers, want 1", len(matchers))
+	}
+	if _, ok := matchers[0].(*neverMatcher); !ok {
+		t.Fatalf("matchersFromPrincipals() returned %T, want *neverMatcher", matchers[0])
+	}
+}
