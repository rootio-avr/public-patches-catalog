+// authorityTestConn is a fake net.Conn that also exposes a usable route
+// configuration, mirroring the interface routeAndProcess expects from the xDS
+// connection wrapper.
+type authorityTestConn struct {
+	net.Conn
+	urc xdsresource.UsableRouteConfiguration
+}
+
+func (c *authorityTestConn) UsableRouteConfiguration() xdsresource.UsableRouteConfiguration {
+	return c.urc
+}
+
+// authorityTestStream is a minimal grpc.ServerTransportStream used to supply a
+// method name to routeAndProcess.
+type authorityTestStream struct {
+	method string
+}
+
+func (s *authorityTestStream) Method() string               { return s.method }
+func (s *authorityTestStream) SetHeader(metadata.MD) error  { return nil }
+func (s *authorityTestStream) SendHeader(metadata.MD) error { return nil }
+func (s *authorityTestStream) SetTrailer(metadata.MD) error { return nil }
+
+// TestRouteAndProcessMissingAuthority verifies that routeAndProcess rejects an
+// incoming RPC whose metadata carries no :authority header instead of panicking
+// while indexing into the (empty) authority slice (CWE-129).
+func (s) TestRouteAndProcessMissingAuthority(t *testing.T) {
+	cw := &authorityTestConn{urc: xdsresource.UsableRouteConfiguration{}}
+	ctx, cancel := context.WithTimeout(context.Background(), defaultTestTimeout)
+	defer cancel()
+	ctx = transport.SetConnection(ctx, cw)
+	ctx = grpc.NewContextWithServerTransportStream(ctx, &authorityTestStream{method: "/test.Service/Method"})
+	ctx = metadata.NewIncomingContext(ctx, metadata.MD{})
+
+	err := routeAndProcess(ctx)
+	if status.Code(err) != codes.Internal {
+		t.Fatalf("routeAndProcess() returned error code %v, want %v", status.Code(err), codes.Internal)
+	}
+	if !strings.Contains(err.Error(), "no :authority header present") {
+		t.Fatalf("routeAndProcess() returned error %q, want it to contain %q", err.Error(), "no :authority header present")
+	}
