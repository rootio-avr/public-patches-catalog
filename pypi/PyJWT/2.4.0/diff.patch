+class _JWKSetCache:
+    """In-memory time-based cache for JWK Set responses.
+
+    Kept as a private helper (leading underscore) to avoid introducing a
+    new public module while still providing the caching behavior needed
+    to fix CVE-2026-48524 (GHSA-fhv5-28vv-h8m8).
+    """
+
+    def __init__(self, lifespan: float) -> None:
+        self.jwk_set: Any = None
+        self.timestamp: float = 0.0
+        self.lifespan = lifespan
+
+    def put(self, jwk_set: Any) -> None:
+        if jwk_set is not None:
+            self.jwk_set = jwk_set
+            self.timestamp = time.monotonic()
+        else:
+            self.jwk_set = None
+            self.timestamp = 0.0
+
+    def get(self) -> Any:
+        if self.jwk_set is None or self.is_expired():
+            return None
+        return self.jwk_set
+
+    def is_expired(self) -> bool:
+        return (
+            self.jwk_set is not None
+            and self.lifespan > -1
+            and time.monotonic() > self.timestamp + self.lifespan
+        )
