@@ -0,0 +1,128 @@
+"""Regression tests for CVE-2026-114613 (C unpacker reference ownership)."""
+
+import gc
+import weakref
+
+import pytest
+
+from msgpack import OutOfData, Unpacker, unpackb
+
+HAS_C_EXT = "fallback" not in Unpacker.__module__
+
+
+class Tracked:
+    """Weak-referenceable object created by ext_hook."""
+
+    refs = []
+
+    def __init__(self, code, data):
+        self.code = code
+        self.data = data
+        Tracked.refs.append(weakref.ref(self))
+
+
+def _ext_hook(code, data):
+    return Tracked(code, data)
+
+
+def _alive():
+    gc.collect()
+    return [r for r in Tracked.refs if r() is not None]
+
+
+@pytest.fixture(autouse=True)
+def _reset_tracked():
+    Tracked.refs = []
+    yield
+    Tracked.refs = []
+
+
+# fixmap(1): key 1 (int, rejected by strict_map_key), value fixext1 -> Tracked
+REJECTED_KEY_MAP = b"\x81\x01\xd4\x01\x00"
+# nested: {"a": {1: ext}}
+NESTED_REJECTED_KEY_MAP = b"\x81\xa1a" + REJECTED_KEY_MAP
+# [ext, {1: ext}]: first element already stored in the array when the map fails
+ARRAY_THEN_REJECTED = b"\x92\xd4\x01\x00" + REJECTED_KEY_MAP
+
+
+@pytest.mark.parametrize(
+    "packed", [REJECTED_KEY_MAP, NESTED_REJECTED_KEY_MAP, ARRAY_THEN_REJECTED]
+)
+def test_unpackb_rejected_map_key_does_not_leak(packed):
+    for _ in range(5):
+        with pytest.raises(ValueError):
+            unpackb(packed, ext_hook=_ext_hook)
+    assert _alive() == []
+
+
+@pytest.mark.parametrize(
+    "packed", [REJECTED_KEY_MAP, NESTED_REJECTED_KEY_MAP, ARRAY_THEN_REJECTED]
+)
+def test_unpacker_rejected_map_key_does_not_leak(packed):
+    for _ in range(5):
+        up = Unpacker(ext_hook=_ext_hook)
+        up.feed(packed)
+        with pytest.raises(ValueError):
+            up.unpack()
+        del up
+    assert _alive() == []
+
+
+def test_unpacker_rejected_map_key_with_pairs_hook_does_not_leak():
+    up = Unpacker(ext_hook=_ext_hook, object_pairs_hook=list)
+    up.feed(REJECTED_KEY_MAP)
+    with pytest.raises(ValueError):
+        up.unpack()
+    del up
+    assert _alive() == []
+
+
+def test_hook_failure_does_not_leak():
+    def bad_hook(obj):
+        raise RuntimeError("boom")
+
+    # list_hook / object_hook fail after all children were built.
+    packed = b"\x91\xd4\x01\x00"
+    with pytest.raises(RuntimeError):
+        unpackb(packed, ext_hook=_ext_hook, list_hook=bad_hook)
+    packed = b"\x81\xa1k\xd4\x01\x00"
+    with pytest.raises(RuntimeError):
+        unpackb(packed, ext_hook=_ext_hook, object_hook=bad_hook)
+    assert _alive() == []
+
+
+def test_incomplete_unpacker_released_on_dealloc():
+    up = Unpacker(ext_hook=_ext_hook)
+    up.feed(b"\x92\xd4\x01\x00")  # array of 2, only first element available
+    with pytest.raises(OutOfData):
+        up.unpack()
+    del up
+    assert _alive() == []
+
+
+@pytest.mark.skipif(not HAS_C_EXT, reason="C extension only")
+def test_unpacker_usable_after_rejected_key():
+    up = Unpacker(ext_hook=_ext_hook)
+    up.feed(REJECTED_KEY_MAP)
+    with pytest.raises(ValueError):
+        up.unpack()
+    up.feed(b"\x81\xa1k\x2a")
+    # The parser state was reset, so a fresh object decodes cleanly.
+    assert list(up)[-1] == {"k": 42}
+    assert _alive() == []
+
+
+@pytest.mark.skipif(not HAS_C_EXT, reason="C extension only")
+def test_cannot_switch_method_while_incomplete():
+    up = Unpacker()
+    up.feed(b"\x92\x01")  # array(2) with only one element
+    with pytest.raises(OutOfData):
+        up.skip()
+    with pytest.raises(ValueError):
+        up.unpack()
+    with pytest.raises(ValueError):
+        up.read_bytes(1)
+    up.feed(b"\x02")
+    assert up.skip() is None
+    up.feed(b"\x05")
+    assert up.unpack() == 5
