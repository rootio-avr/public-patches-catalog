+def test_unpacker_hook_error_then_reuse():
+    def hook(d):
+        raise RuntimeError("hook")
+
+    up = Unpacker(object_hook=hook)
+    up.feed(packb({"a": {"b": 1}}))
+    with raises(RuntimeError):
+        up.unpack()
+    up.feed(packb([1, 2, 3]))
+    assert up.unpack() == [1, 2, 3]
+
