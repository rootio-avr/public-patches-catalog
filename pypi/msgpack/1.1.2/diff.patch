+def test_unpacker_switch_method_while_incomplete():
+    if not C_EXT:
+        return
+    up = Unpacker()
+    up.feed(b"\x92\x01")
+    with raises(OutOfData):
+        up.unpack()
+    with raises(ValueError):
+        up.skip()
+    with raises(ValueError):
+        up.read_array_header()
+    with raises(ValueError):
+        up.read_bytes(1)
+    up.feed(b"\x02")
+    assert up.unpack() == [1, 2]
+
+
+def test_unpacker_recursive_call_from_hook():
+    if not C_EXT:
+        return
+    up = Unpacker()
+
+    def hook(d):
+        return up.unpack()
+
+    up = Unpacker(object_hook=hook)
+    up.feed(packb({"a": 1}))
+    with raises(RuntimeError):
+        up.unpack()
+    up.feed(packb(7))
+    assert up.unpack() == 7
