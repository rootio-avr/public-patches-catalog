+def test_unpackb_hook_error_does_not_leak():
+    _reset()
+    packed = b"\x93" + _ext(1) + _ext(1) + _ext(2)
+    with raises(ValueError):
+        unpackb(packed, ext_hook=_failing_ext_hook)
+    assert _alive() == []
+
