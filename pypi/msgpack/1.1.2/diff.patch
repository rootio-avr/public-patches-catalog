+def test_unpacker_skip_after_error_does_not_crash():
+    up = Unpacker()
+    up.feed(b"\x83\x73\xc4\x00")
+    with raises(ValueError):
+        up.unpack()
+    up.feed(packb(1))
+    up.skip()
