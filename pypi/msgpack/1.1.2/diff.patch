+def test_unpacker_resume_after_out_of_data():
+    up = Unpacker()
+    packed = packb([1, [2, 3], {"a": b"bin"}])
+    up.feed(packed[:5])
+    with raises(OutOfData):
+        up.unpack()
+    up.feed(packed[5:])
+    assert up.unpack() == [1, [2, 3], {"a": b"bin"}]
