+"""Regression tests for the Unpacker/unpackb reference leaks and
+state-corruption problems on error and incomplete-input paths."""
+
+import gc
+import weakref
+
+from pytest import raises
+
+import msgpack
+from msgpack import ExtType, OutOfData, Unpacker, packb, unpackb
+from msgpack import fallback
+
+C_EXT = Unpacker is not fallback.Unpacker
+
+
+class Tracked:
+    """Weak-referenceable object produced by ext_hook."""
+
+    instances = []
+
+    def __init__(self):
+        Tracked.instances.append(weakref.ref(self))
+
+
+def _reset():
+    Tracked.instances = []
+
+
+def _alive():
+    gc.collect()
+    return [r for r in Tracked.instances if r() is not None]
+
+
+def _ext_hook(code, data):
+    return Tracked()
+
+
+def _failing_ext_hook(code, data):
+    if code == 2:
+        raise ValueError("boom")
+    return Tracked()
+
+
+def _ext(code):
+    return packb(ExtType(code, b"x"))
+
+
+def test_unpacker_dropped_while_incomplete_does_not_leak():
+    _reset()
+    up = Unpacker(ext_hook=_ext_hook)
+    # array(3): two complete ext items followed by a truncated third item
+    up.feed(b"\x93" + _ext(1) + _ext(1) + b"\xc4")
+    with raises(OutOfData):
+        up.unpack()
+    assert len(Tracked.instances) == 2
+    del up
+    assert _alive() == []
+
+
+def test_unpacker_nested_incomplete_does_not_leak():
+    _reset()
+    up = Unpacker(ext_hook=_ext_hook)
+    # {key: [ext, ext, <truncated>]}
+    up.feed(b"\x81\xa1k\x93" + _ext(1) + _ext(1))
+    with raises(OutOfData):
+        up.unpack()
+    del up
+    assert _alive() == []
+
+
+def test_unpacker_reinit_while_incomplete_does_not_leak():
+    _reset()
+    up = Unpacker(ext_hook=_ext_hook)
+    up.feed(b"\x92" + _ext(1))
+    with raises(OutOfData):
+        up.unpack()
+    up.__init__(ext_hook=_ext_hook)
+    assert _alive() == []
+    up.feed(packb([1, 2]))
+    assert up.unpack() == [1, 2]
+
