@@ -0,0 +1,81 @@
+"""Regression tests for CVE-2026-114613 (C unpacker reference ownership)."""
+import gc
+import weakref
+
+from pytest import mark, raises
+
+import msgpack
+from msgpack import Unpacker, unpackb
+
+has_cext = msgpack.Unpacker.__module__ != "msgpack.fallback"
+
+
+class Tracked:
+    pass
+
+
+def _make_hook(refs):
+    def hook(_obj):
+        t = Tracked()
+        refs.append(weakref.ref(t))
+        return t
+
+    return hook
+
+
+def test_rejected_map_key_releases_value_unpackb():
+    refs = []
+    # int key is rejected by strict_map_key=True; the decoded value must be freed.
+    with raises(ValueError):
+        unpackb(msgpack.packb({1: {}}), object_hook=_make_hook(refs))
+    gc.collect()
+    assert refs
+    assert all(r() is None for r in refs)
+
+
+def test_rejected_map_key_releases_value_unpacker():
+    refs = []
+    u = Unpacker(object_hook=_make_hook(refs))
+    u.feed(msgpack.packb({1: {}}))
+    with raises(ValueError):
+        u.unpack()
+    gc.collect()
+    assert refs
+    assert all(r() is None for r in refs)
+
+
+def test_hook_failure_releases_container():
+    refs = []
+
+    def bad_hook(obj):
+        t = Tracked()
+        refs.append(weakref.ref(t))
+        raise RuntimeError("boom")
+
+    with raises(RuntimeError):
+        unpackb(msgpack.packb([{}]), object_hook=bad_hook)
+    gc.collect()
+    assert all(r() is None for r in refs)
+
+
+def test_skip_then_unpack_is_safe():
+    u = Unpacker()
+    u.feed(msgpack.packb([1, [2, 3], {"a": [4]}]))
+    u.skip()
+    u.feed(msgpack.packb([5, {"b": 6}]))
+    assert u.unpack() == [5, {"b": 6}]
+
+
+@mark.skipif(not has_cext, reason="C extension only")
+def test_cannot_switch_method_while_incomplete():
+    packed = msgpack.packb([1, 2, 3])
+    u = Unpacker()
+    u.feed(packed[:2])
+    with raises(msgpack.OutOfData):
+        u.unpack()
+    with raises(ValueError):
+        u.skip()
+    with raises(ValueError):
+        u.read_bytes(1)
+    u.feed(packed[2:])
+    assert u.unpack() == [1, 2, 3]
