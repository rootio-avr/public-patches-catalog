+import gc
+
+import pytest
+
+from msgpack import ExtType, FormatError, OutOfData, Unpacker, unpackb
+
+try:
+    from msgpack import _cmsgpack  # noqa: F401
+
+    HAS_C_EXT = True
+except ImportError:
+    HAS_C_EXT = False
+
+
+class Tracked:
+    live = 0
+
+    def __init__(self, code, data):
+        Tracked.live += 1
+
+    def __del__(self):
+        Tracked.live -= 1
+
+
+def ext_hook(code, data):
+    return Tracked(code, data)
+
+
+def check_no_leak(func):
+    gc.collect()
+    before = Tracked.live
+    for _ in range(3):
+        func()
+    gc.collect()
+    assert Tracked.live == before
+
+
+def test_strict_map_key_failure_does_not_leak():
+    # {ext: ext} -- the key is neither str nor bytes, so strict_map_key rejects it.
+    packed = b"\x81\xd4\x01A\xd4\x01B"
+
+    def run():
+        with pytest.raises(ValueError):
+            unpackb(packed, ext_hook=ext_hook, strict_map_key=True)
+
+    check_no_leak(run)
+
+
+def test_strict_map_key_failure_nested_does_not_leak():
+    # [[1, {ext: ext}], ext]
+    packed = b"\x92\x92\x01\x81\xd4\x01A\xd4\x01B\xd4\x01C"
+
+    def run():
+        with pytest.raises(ValueError):
+            unpackb(packed, ext_hook=ext_hook, strict_map_key=True)
+
+    check_no_leak(run)
+
+
+def test_unhashable_map_key_failure_does_not_leak():
+    # {[]: ext}: list keys cannot be hashed.
+    packed = b"\x81\x90\xd4\x01B"
+
+    def run():
+        with pytest.raises(TypeError):
+            unpackb(packed, ext_hook=ext_hook, strict_map_key=False)
+
+    check_no_leak(run)
+
+
+def test_object_hook_failure_does_not_leak():
+    packed = b"\x92\xd4\x01A\x81\xa1k\xd4\x01B"
+
+    def bad_hook(obj):
+        raise RuntimeError("boom")
+
+    def run():
+        with pytest.raises(RuntimeError):
+            unpackb(packed, ext_hook=ext_hook, object_hook=bad_hook)
+
+    check_no_leak(run)
+
+
+def test_list_hook_failure_does_not_leak():
+    packed = b"\x91\x92\xd4\x01A\xd4\x01B"
+
+    def bad_hook(obj):
+        raise RuntimeError("boom")
+
+    def run():
+        with pytest.raises(RuntimeError):
+            unpackb(packed, ext_hook=ext_hook, list_hook=bad_hook)
+
+    check_no_leak(run)
+
+
+def test_streaming_unpacker_failure_does_not_leak():
+    packed = b"\x81\xd4\x01A\xd4\x01B"
+
+    def run():
+        unpacker = Unpacker(ext_hook=ext_hook, strict_map_key=True)
+        unpacker.feed(packed)
+        with pytest.raises(ValueError):
+            unpacker.unpack()
+
+    check_no_leak(run)
+
+
+def test_incomplete_unpacker_is_released():
+    def run():
+        unpacker = Unpacker(ext_hook=ext_hook)
+        unpacker.feed(b"\x92\xd4\x01A")
+        with pytest.raises(OutOfData):
+            unpacker.unpack()
+        del unpacker
+
+    check_no_leak(run)
+
+
+def test_resume_after_more_data():
+    unpacker = Unpacker()
+    unpacker.feed(b"\x92\x01")
+    with pytest.raises(OutOfData):
+        unpacker.unpack()
+    unpacker.feed(b"\x02")
+    assert unpacker.unpack() == [1, 2]
+
+
+@pytest.mark.skipif(not HAS_C_EXT, reason="requires the C extension")
+@pytest.mark.parametrize("switch", ["skip", "read_array_header", "read_map_header", "read_bytes"])
+def test_cannot_switch_methods_mid_object(switch):
+    unpacker = Unpacker()
+    unpacker.feed(b"\x92\x01")
+    with pytest.raises(OutOfData):
+        unpacker.unpack()
+    with pytest.raises(ValueError):
+        getattr(unpacker, switch)(1) if switch == "read_bytes" else getattr(unpacker, switch)()
+    # the original operation can still be resumed
+    unpacker.feed(b"\x02")
+    assert unpacker.unpack() == [1, 2]
+
+
+@pytest.mark.skipif(not HAS_C_EXT, reason="requires the C extension")
+def test_recursive_unpack_from_hook_is_rejected():
+    holder = {}
+
+    def hook(obj):
+        holder["unpacker"].unpack()
+        return obj
+
+    unpacker = Unpacker(list_hook=hook)
+    holder["unpacker"] = unpacker
+    unpacker.feed(b"\x91\x01\xc0")
+    with pytest.raises(RuntimeError):
+        unpacker.unpack()
+
+
+def test_invalid_format_still_raises():
