+    def test_cve_2025_50817_no_test_module_alias(self):
+        """
+        Regression test for CVE-2025-50817.
+
+        future must not shadow the CPython private ``test`` package (nor
+        register a bogus ``test.support`` alias) when aliases are installed.
+        Doing so allowed the stdlib ``test`` package to be replaced, which
+        could be abused for code execution / import confusion.
+        """
+        # 'test' must no longer be treated as a replaced module.
+        self.assertNotIn('test', standard_library.REPLACED_MODULES)
+
+        # install_aliases() must not register a fake 'test.support' alias.
+        standard_library.install_aliases()
+        support = sys.modules.get('test.support')
+        if support is not None:
+            # Only acceptable if it is the genuine CPython test.support,
+            # never the future.moves shim.
+            self.assertNotIn('future.moves',
+                             getattr(support, '__name__', '') +
+                             getattr(support, '__file__', ''))
