+++ b/test/test_ghsa_6rj2_96f5_chj9.py
@@ -0,0 +1,89 @@
+# This module is part of GitPython and is released under the
+# 3-Clause BSD License: https://opensource.org/license/bsd-3-clause/
+
+"""Regression tests for GHSA-6rj2-96f5-chj9 / CVE-2026-78679 (CWE-88).
+
+GitPython's ``TagReference.create()`` failed to validate positional (as
+opposed to keyword) arguments for unsafe git options. A caller-controlled
+positional ``reference`` value could smuggle a ``--file=/path`` option past
+the kwargs-only unsafe-option guard, causing ``git tag`` to read an arbitrary
+file into the annotated tag message (argument injection / arbitrary file
+read). The same class of file-reading options is now blocked on the
+``blame``/``blame_incremental`` and ``diff`` APIs too.
+
+These assertions mirror the upstream fix commit
+1b0d2d9b91575f7db44ef4ff58ac37fc9335e5f6 (across test_refs.py, test_repo.py,
+and test_diff.py), reduced to a single self-contained module because the
+target version (3.1.47) predates the upstream tests these hunks extend.
+"""
+
+import os.path as osp
+import tempfile
+
+from git.exc import UnsafeOptionError
+from git.refs.tag import TagReference
+
+from test.lib import TestBase, with_rw_repo
+
+
+class TestGHSA6rj296f5chj9(TestBase):
+    @with_rw_repo("HEAD")
+    def test_tag_create_rejects_unsafe_positional_reference(self, rw_repo):
+        with tempfile.NamedTemporaryFile("w", encoding="utf-8") as message:
+            message.write("private tag message")
+            message.flush()
+
+            # The core vulnerability: a positional ``reference`` that spells a
+            # file-reading option must be rejected before ``git tag`` runs.
+            for args in (
+                ("unsafe-positional", f"--file={message.name}"),
+                (f"--file={message.name}", "HEAD"),
+                (f"-eF{message.name}", "HEAD"),
+                (f"-iF{message.name}", "HEAD"),
+            ):
+                with self.assertRaises(UnsafeOptionError):
+                    TagReference.create(rw_repo, *args)
+
+            # The legacy ``ref=`` keyword must be validated as well.
+            with self.assertRaises(UnsafeOptionError):
+                TagReference.create(rw_repo, "unsafe-ref-kwarg", ref=f"--file={message.name}")
+
+            # A benign legacy ``ref=`` value still resolves as before when the
+            # caller explicitly opts in to unsafe options.
+            tag = TagReference.create(rw_repo, "legacy-ref", ref="HEAD", allow_unsafe_options=True)
+            self.assertEqual(tag.commit, rw_repo.head.commit)
+
+            # An explicitly allowed file-reading option is still honored.
+            tag = TagReference.create(rw_repo, "allowed-file", F=message.name, allow_unsafe_options=True)
+            self.assertEqual(tag.tag.message, "private tag message")
+
+    def test_blame_rejects_file_reading_options(self):
+        with tempfile.TemporaryDirectory() as tdir:
+            marker = osp.join(tdir, "pwn")
+            for option in ("--output", "--contents", "-S", "-wS", "--ignore-revs-file"):
+                with self.assertRaises(UnsafeOptionError):
+                    self.rorepo.blame(f"{option}={marker}", "README.md")
+                with self.assertRaises(UnsafeOptionError):
+                    list(self.rorepo.blame_incremental(f"{option}={marker}", "README.md"))
+            self.assertFalse(osp.exists(marker))
+
+    def test_diff_rejects_file_reading_options(self):
+        commit = self.rorepo.head.commit
+
+        # -S is a safe pickaxe option for diff and must remain allowed.
+        commit.diff(S="needle")
+
+        with tempfile.TemporaryDirectory() as tdir:
+            marker = osp.join(tdir, "pwn")
+            unsafe_calls = (
+                lambda target: commit.diff(output=target),
+                lambda target: commit.diff(other=f"--output={target}"),
+                lambda target: commit.diff(O=target),
+                lambda target: commit.diff(orderfile=target),
+                lambda target: commit.diff(other=f"--orderfile={target}"),
+                lambda target: commit.diff(other=f"-pO{target}"),
+            )
+            for call in unsafe_calls:
+                with self.assertRaises(UnsafeOptionError):
+                    call(marker)
+            self.assertFalse(osp.exists(marker))
