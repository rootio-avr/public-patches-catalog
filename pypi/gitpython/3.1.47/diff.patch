@@ -0,0 +1,40 @@
+# This module is part of GitPython and is released under the
+# 3-Clause BSD License: https://opensource.org/license/bsd-3-clause/
+
+"""Regression test for CVE-2026-78677 (GHSA-8mcc-hrx5-hvxc).
+
+The ``--separate-git-dir`` / ``separate_git_dir`` clone option redirects the
+repository metadata to a caller-controlled path and must be rejected by default,
+exactly like the other unsafe clone options. See PR #2210.
+"""
+
+import pytest
+
+from git import Repo
+from git.cmd import Git
+from git.exc import UnsafeOptionError
+
+
+def test_separate_git_dir_is_a_denylisted_clone_option():
+    # The flag must be part of the unsafe clone-option denylist.
+    assert "--separate-git-dir" in Repo.unsafe_git_clone_options
+
+
+@pytest.mark.parametrize(
+    "option",
+    [
+        "--separate-git-dir=/tmp/evil",
+        "separate_git_dir",
+        "separate-git-dir",
+    ],
+)
+def test_separate_git_dir_is_blocked(option):
+    # check_unsafe_options must raise for the flag in any spelling git accepts.
+    with pytest.raises(UnsafeOptionError):
+        Git.check_unsafe_options([option], Repo.unsafe_git_clone_options)
+
+
+def test_separate_git_dir_allowed_when_not_checked():
+    # When the option is not in the denylist, it passes (sanity check that the
+    # guard is specific to the denylisted flag and not a blanket rejection).
+    Git.check_unsafe_options(["separate_git_dir"], ["--upload-pack"])

