+"""Head.checkout must validate the reference it passes to Git as a positional operand."""
+
+from unittest import mock
+
+import pytest
+
+from git import Git, Head, Repo
+from git.exc import UnsafeOptionError
+
+
+@pytest.mark.parametrize("option_name", ["--pathspec-from-file", "--pathspec-from"])
+def test_head_checkout_rejects_option_shaped_reference(tmp_path, option_name):
+    repo = Repo.init(tmp_path)
+    branch = Head(repo, f"refs/heads/{option_name}=pathspecs")
+    with mock.patch.object(Git, "_call_process", side_effect=AssertionError("Git must not run")) as run:
+        with pytest.raises(UnsafeOptionError):
+            branch.checkout()
+        run.assert_not_called()
+
+
+def test_head_checkout_rejects_option_shaped_reference_with_keywords(tmp_path):
+    repo = Repo.init(tmp_path)
+    branch = Head(repo, "refs/heads/--pathspec-from-file=pathspecs")
+    with pytest.raises(UnsafeOptionError):
+        branch.checkout(force=True)
+
+
+def test_head_checkout_ordinary_reference_is_not_rejected(tmp_path):
+    repo = Repo.init(tmp_path)
+    branch = Head(repo, "refs/heads/main")
+    Git.check_unsafe_options(options=Git._option_candidates([branch], {}), unsafe_options=Git.unsafe_git_pathspec_from_file_options)
