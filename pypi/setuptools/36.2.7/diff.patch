+"""Regression test for CVE-2022-40897.
+
+The REL regex in setuptools.package_index used unbounded whitespace
+matching around 'rel=' which allowed a contrived HTML string to cause
+catastrophic backtracking (ReDoS). It should not hang on such input.
+"""
+import pytest
+
+import setuptools.package_index
+
+
+@pytest.mark.timeout(1)
+def test_REL_DoS():
+    """
+    REL should not hang on a contrived attack string.
+    """
+    setuptools.package_index.REL.search('< rel=' + ' ' * 2**12)

