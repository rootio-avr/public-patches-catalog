@@ -0,0 +1,33 @@
+"""Regression test for CVE-2025-47273.
+
+PackageIndex._download_url derived the download target filename by joining the
+tmpdir with a name taken from the (percent-decoded) URL path. A crafted URL
+such as ``https://anyhost/%2fhome%2fuser%2f.ssh%2fauthorized_keys`` decodes to
+an absolute path, so ``os.path.join(tmpdir, name)`` escaped the tmpdir and let
+an attacker write to an arbitrary location. The fix rejects any resolved
+filename that does not stay within tmpdir.
+"""
+
+import os
+
+import pytest
+
+from setuptools.package_index import PackageIndex
+
+
+def test_download_url_rejects_path_escape(tmpdir):
+    """A URL that resolves outside tmpdir must be rejected."""
+    index = PackageIndex()
+    malicious = 'https://anyhost/%2fhome%2fuser%2f.ssh%2fauthorized_keys'
+    with pytest.raises(ValueError):
+        index._download_url('http', malicious, str(tmpdir))
+
+
+def test_download_url_allows_contained_name(tmpdir):
+    """A benign name stays within tmpdir and passes the containment guard."""
+    index = PackageIndex()
+    benign = 'file:///anyhost/setuptools-78.1.0.tar.gz'
+    # 'file' scheme returns a local path without performing any network I/O;
+    # the important part is that the containment guard does not raise.
+    result = index._download_url('file', benign, str(tmpdir))
+    assert result is not None
