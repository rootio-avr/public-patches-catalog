+    def test_vcs_download_no_shell_injection(self, tmpdir, monkeypatch):
+        """
+        Regression test for CVE-2024-6345.
+
+        The VCS download helpers (_download_svn/_download_git/_download_hg)
+        must invoke the version-control tools via subprocess.check_call with an
+        argument *list* rather than a shell string built with os.system.  A
+        shell string allows attacker-controlled URLs/revisions to inject
+        arbitrary commands (e.g. ``... ;rm -rf ~``).  This test asserts that
+        the argument vector is a list whose first element is the VCS binary and
+        that no shell metacharacters from the malicious input are ever passed
+        as a single interpolated string.
+        """
+        calls = []
+
+        def fake_check_call(cmd, *args, **kwargs):
+            # A safe (non-shell) invocation always passes a list/tuple argv;
+            # os.system would have received a single interpolated string.
+            assert isinstance(cmd, (list, tuple)), (
+                "VCS command must be an argv list, not a shell string: %r" % (cmd,)
+            )
+            calls.append(list(cmd))
+            return 0
+
+        monkeypatch.setattr(
+            setuptools.package_index.subprocess, 'check_call', fake_check_call
+        )
+
+        index = setuptools.package_index.PackageIndex()
+        # An attacker-controlled revision containing shell metacharacters.
+        payload = 'foo;touch$IFS/tmp/pwned'
+
+        index._download_git(
+            'git+https://example.com/repo@%s' % payload,
+            str(tmpdir / 'repo'),
+        )
+
+        assert calls, "expected subprocess.check_call to be invoked"
+        assert calls[0][0] == 'git'
+        # The malicious revision must survive intact as a single argv element
+        # (i.e. never split/expanded by a shell), and must not be embedded in
+        # any shell command string.
+        assert payload in calls[-1]
+        for cmd in calls:
+            for part in cmd:
+                assert not (isinstance(part, str) and part.startswith('git clone')), (
+                    "argv element looks like an unsplit shell string: %r" % (part,)
+                )
+
