From 250a6d17978f9f6ac3ac887091f2d32886fbbb0b Mon Sep 17 00:00:00 2001
From: "Jason R. Coombs" <jaraco@jaraco.com>
Date: Sat, 19 Apr 2025 13:03:47 -0400
Subject: [PATCH] Add a check to ensure the name resolves relative to the
 tmpdir.

Closes #4946

CVE-2025-47273: Path traversal vulnerability fix
Prevents writing files to arbitrary locations via URL manipulation.

This patch adds a security check to ensure that the resolved filename
stays within the tmpdir directory, preventing path traversal attacks
where malicious URLs with encoded paths (e.g., %2fhome%2fuser%2f.ssh)
could write files to arbitrary locations on the filesystem.

The vulnerability allows attackers to bypass the existing '..' sanitization
by using URL-encoded slashes (e.g., %2f) which are not properly validated.
The fix adds a check to ensure the resolved path always starts with tmpdir.

Adapted for setuptools 75.3.0 where the logic resides in _download_url
method instead of the separate _resolve_download_filename method found
in newer versions.

Reference: https://github.com/pypa/setuptools/commit/250a6d17978f9f6ac3ac887091f2d32886fbbb0b
---
 setuptools/package_index.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/setuptools/package_index.py b/setuptools/package_index.py
index 2a05b35..58205c6 100644
--- a/setuptools/package_index.py
+++ b/setuptools/package_index.py
@@ -833,6 +833,13 @@ class PackageIndex(Environment):
 
         filename = os.path.join(tmpdir, name)
 
+        # ensure path resolves within the tmpdir
+        # CVE-2025-47273: Prevent path traversal attacks
+        # This check prevents malicious URLs from writing files outside tmpdir
+        if not filename.startswith(str(tmpdir)):
+            raise ValueError(f"Invalid filename {filename}")
+
+
         return self._download_vcs(url, filename) or self._download_other(url, filename)
 
     @staticmethod

--- a/setuptools/_vendor/jaraco/context.py
+++ b/setuptools/_vendor/jaraco/context.py
@@ -62,7 +62,7 @@
     try:
         req = urllib.request.urlopen(url)
         with tarfile.open(fileobj=req, mode='r|*') as tf:
-            tf.extractall(path=target_dir, filter=strip_first_component)
+            tf.extractall(path=target_dir, filter=_default_filter)
         yield target_dir
     finally:
         shutil.rmtree(target_dir)
@@ -76,6 +76,16 @@
     return member
 
 
+def _compose_tarfile_filters(*filters):
+    def compose_two(f1, f2):
+        return lambda member, path: f1(f2(member, path), path)
+
+    return functools.reduce(compose_two, filters, lambda member, path: member)
+
+
+_default_filter = _compose_tarfile_filters(tarfile.data_filter, strip_first_component)
+
+
 def _compose(*cmgrs):
     """
     Compose any number of dependent context managers into a single one.
