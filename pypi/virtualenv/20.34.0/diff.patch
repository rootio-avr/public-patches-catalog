+
+    class MockInterpreter:
+        pass
+
+    interpreter = MockInterpreter()
+    interpreter.tcl_lib = f"/tcl/(touch {marker})/lib"
+    interpreter.tk_lib = "/tk/lib"
+
+    class MockCreator:
