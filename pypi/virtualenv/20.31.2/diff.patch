@@ -0,0 +1,64 @@
+"""Regression test for AIKIDO-2026-785880 (GHSA-x78j-v8h9-3j2q).
+
+``@set "VAR=value"`` is the only place a value from ``--prompt`` (or any other replacement) reaches
+cmd.exe, and cmd.exe treats several characters as live syntax there regardless of the surrounding
+quotes. The invariant that matters is that none of those characters can survive ``BatchActivator.quote()``.
+
+Re-authored as a plain pytest module (the upstream property/hypothesis test is not shipped in this
+target tree).
+"""
+
+from __future__ import annotations
+
+from virtualenv.activation.batch import BatchActivator
+
+# Confirmed live syntax inside @set "VAR=value" on a real Windows runner.
+DANGEROUS = '"&|<>^!'
+LINE_BOUNDARIES = "\n\r\v\f\x1c\x1d\x1e\x85" + chr(0x2028) + chr(0x2029)
+
+PAYLOADS = [
+    'x" & type nul > pwned.marker & "',  # the confirmed exploit payload
+    "x^& type nul ^> pwned.marker ^& ",  # caret-escaped: still live outside a quoted context
+    "x\n@type nul > pwned.marker\n@rem ",  # newline: a full extra statement, not just a breakout
+    'a"&type nul>pwned.marker&"b',
+    "x!DELAYED! & echo pwned",  # delayed-expansion leak via '!'
+]
+
+
+def test_quote_strips_every_dangerous_character():
+    for value in PAYLOADS:
+        quoted = BatchActivator.quote(value)
+        assert not (set(quoted) & set(DANGEROUS)), value
+        assert not (set(quoted) & set(LINE_BOUNDARIES)), value
+
+
+def test_quote_leaves_parentheses_untouched():
+    """Parentheses are inert in a bare value; neutering them would corrupt ``Program Files (x86)`` paths."""
+    assert BatchActivator.quote("(x86)") == "(x86)"
+
+
+def test_quote_keeps_percent_literal_and_balanced():
+    """Every ``%`` must survive doubled, never as a lone character that triggers expansion."""
+    for value in ["100%", "a%b%c", "%PATH%"]:
+        quoted = BatchActivator.quote(value)
+        assert quoted.replace("%%", "").count("%") == 0, value
+
+
+def test_embedding_in_the_set_statement_stays_one_well_formed_line():
+    """The exact shape the template uses: a single ``@set "VAR=value"`` statement."""
+    for value in PAYLOADS:
+        rendered = f'@set "VIRTUAL_ENV_PROMPT={BatchActivator.quote(value)}"'
+        assert rendered.count("\n") == 0, value
+        assert rendered.count('"') == 2, value
+
+
+def test_generate_refuses_destination_with_ampersand(tmp_path, caplog):
+    """``&`` cannot be kept literal in a path inside ``@set "VAR=value"``, so no scripts are written."""
+    from types import SimpleNamespace
+
+    activator = BatchActivator(SimpleNamespace(prompt=None))
+    dest = tmp_path / "a&b"
+    creator = SimpleNamespace(dest=dest, bin_dir=dest / "Scripts", env_name="a&b")
+
+    assert activator.generate(creator) == []
+    assert "skipping batch activation scripts" in caplog.text
