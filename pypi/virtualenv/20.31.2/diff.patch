+"""Regression test for CVE-2026-102925 (GHSA-p58f-9548-mpm2).
+
+A virtual environment path containing shell metacharacters must never be executed as commands when the
+generated bash/fish activation script is sourced.
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+from argparse import Namespace
+from types import SimpleNamespace
+
+import pytest
+
+from virtualenv.activation import BashActivator, FishActivator
+from virtualenv.info import IS_WIN
+
+PAYLOADS = [
+    pytest.param("x'$(touch PWNED)'y", id="command-substitution"),
+    pytest.param("x'`touch PWNED`'y", id="backticks"),
+    pytest.param("a';touch PWNED;'b", id="statement-separator"),
+    pytest.param("has(touch PWNED)paren", id="parentheses"),
+]
+FISH = shutil.which("fish")
+
+
+def _render(activator_class, tmp_path, name):
+    dest = tmp_path / name
+    creator = SimpleNamespace(
+        dest=dest,
+        bin_dir=dest / "bin",
+        interpreter=SimpleNamespace(tcl_lib=None, tk_lib=None),
+        pyenv_cfg={},
+        env_name=name,
+    )
+    creator.bin_dir.mkdir(parents=True)
+    activator_class(Namespace(prompt=None)).generate(creator)
+    work_dir = tmp_path / "workdir"
+    work_dir.mkdir()
+    return creator.bin_dir, work_dir
+
+
+@pytest.mark.skipif(IS_WIN, reason="Github Actions ships with WSL bash")
+@pytest.mark.skipif(shutil.which("bash") is None, reason="bash is not installed")
+@pytest.mark.parametrize("payload", PAYLOADS)
+def test_bash_activate_does_not_run_path_commands(tmp_path, payload) -> None:
+    bin_dir, work_dir = _render(BashActivator, tmp_path, payload)
+    script = bin_dir / "activate"
+
+    result = subprocess.run(
+        ["bash", "-c", 'source "$1" && echo "$VIRTUAL_ENV"', "bash", str(script)],
+        capture_output=True,
+        text=True,
+        cwd=str(work_dir),
+        encoding="utf-8",
+        check=False,
+    )
+
+    assert not (work_dir / "PWNED").exists()
+    assert result.stdout.strip() == str(tmp_path / payload)
+
+
+@pytest.mark.skipif(IS_WIN, reason="fish is not available on Windows")
+@pytest.mark.skipif(FISH is None, reason="fish is not installed")
+@pytest.mark.parametrize("payload", PAYLOADS)
+def test_fish_activate_does_not_run_path_commands(tmp_path, payload) -> None:
+    bin_dir, work_dir = _render(FishActivator, tmp_path, payload)
+    script = bin_dir / "activate.fish"
+
+    subprocess.run(
+        [FISH, "-c", 'source "$argv[1]"', str(script)],
+        capture_output=True,
+        text=True,
+        cwd=str(work_dir),
+        timeout=60,
+        check=False,
+    )
+
+    assert not (work_dir / "PWNED").exists()

