+@pytest.mark.parametrize(
+    "value",
+    [
+        'x" & type nul > pwned.marker & "',
+        "x^& type nul ^> pwned.marker ^& ",
+        "x\n@type nul > pwned.marker\n@rem ",
+        'a"&type nul>pwned.marker&"b',
+        "foo!SECRET!bar",
+        "x\r\ny\x0bz\x85w\u2028v",
+    ],
+)
+def test_batch_quote_strips_dangerous_characters(value) -> None:
+    quoted = BatchActivator.quote(value)
+
+    assert not (set(quoted) & set('"&|<>^!'))
+    assert not (set(quoted) & set("\n\r\v\f\x1c\x1d\x1e\x85\u2028\u2029"))
+    rendered = f'@set "VIRTUAL_ENV_PROMPT={quoted}"'
+    assert "\n" not in rendered
+    assert rendered.count('"') == 2
+
+
