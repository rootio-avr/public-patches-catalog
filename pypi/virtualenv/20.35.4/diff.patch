@@ -0,0 +1,70 @@
+r"""Regression tests for BatchActivator.quote() (CVE-2026-102937).
+
+``@set "VAR=value"`` is the only place a value from ``--prompt`` (or any other replacement) reaches cmd.exe, and cmd.exe
+treats several characters as live syntax there regardless of the surrounding quotes. None of those characters may
+survive ``quote()``. ``(`` and ``)`` are deliberately left alone: they are only special as control-flow block
+delimiters, and neutering them would corrupt ``C:\Program Files (x86)\...``.
+
+"""
+
+from __future__ import annotations
+
+import itertools
+import random
+
+import pytest
+
+from virtualenv.activation.batch import BatchActivator
+
+DANGEROUS = '"&|<>^!'
+SAFE_IN_THIS_CONTEXT = "()"
+LINE_BOUNDARIES = "\n\r\v\f\x1c\x1d\x1e\x85" + chr(0x2028) + chr(0x2029)
+
+
+def _generated_values():
+    rng = random.Random(3250)  # noqa: S311 - deterministic test data, not security sensitive
+    alphabet = DANGEROUS + LINE_BOUNDARIES + SAFE_IN_THIS_CONTEXT + "%ab c:\\"
+    yield from ("".join(chars) for chars in itertools.product(alphabet, repeat=2))
+    for _ in range(500):
+        yield "".join(rng.choice(alphabet) for _ in range(rng.randint(0, 24)))
+
+
+PAYLOADS = [
+    'x" & type nul > pwned.marker & "',  # the confirmed exploit payload
+    "x^& type nul ^> pwned.marker ^& ",  # caret-escaped: still live outside a quoted context
+    "x\n@type nul > pwned.marker\n@rem ",  # newline: a full extra statement, not just a breakout
+    'a"&type nul>pwned.marker&"b',
+    "foo!SECRET!bar",  # delayed-expansion variable substitution
+    "a\rb\vc\fd\x85e" + chr(0x2028) + "f" + chr(0x2029) + "g",  # every line boundary
+    *_generated_values(),
+]
+
+
+@pytest.mark.parametrize("value", PAYLOADS)
+def test_quote_strips_every_dangerous_character(value: str) -> None:
+    quoted = BatchActivator.quote(value)
+
+    assert not (set(quoted) & set(DANGEROUS))
+    assert not (set(quoted) & set(LINE_BOUNDARIES))
+
+
+@pytest.mark.parametrize("value", ["(x86)", "C:\\Program Files (x86)\\Python", "()", "(a)(b)"])
+def test_quote_leaves_parentheses_untouched(value: str) -> None:
+    assert BatchActivator.quote(value) == value
+
+
+@pytest.mark.parametrize("value", ["100%done", "%PATH%", "a%b%c", "%%already", "", *PAYLOADS])
+def test_quote_keeps_percent_literal_and_balanced(value: str) -> None:
+    """Every ``%`` must survive doubled, never as a lone character that triggers expansion."""
+    quoted = BatchActivator.quote(value)
+
+    assert quoted.replace("%%", "").count("%") == 0
+
+
+@pytest.mark.parametrize("value", PAYLOADS)
+def test_embedding_in_the_set_statement_stays_one_well_formed_line(value: str) -> None:
+    """The exact shape the template uses: a single ``@set "VAR=value"`` statement."""
+    rendered = f'@set "VIRTUAL_ENV_PROMPT={BatchActivator.quote(value)}"'
+
+    assert rendered.count("\n") == 0
+    assert rendered.count('"') == 2

