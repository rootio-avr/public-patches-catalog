@@ -6,6 +6,81 @@ import pytest
 
 from virtualenv.activation import BatchActivator
 
+# Characters cmd.exe treats as live syntax inside `@set "VAR=value"`, regardless of the surrounding
+# quotes, plus the line-boundary characters that would start a brand-new statement. None may survive
+# BatchActivator.quote(). See AIKIDO-2026-785880 (activate.bat command injection via --prompt).
+_DANGEROUS = '"&|<>^!'
+_LINE_BOUNDARIES = "\n\r\v\f\x1c\x1d\x1e\x85" + chr(0x2028) + chr(0x2029)
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        'x" & type nul > pwned.marker & "',  # the confirmed exploit payload
+        "x^& type nul ^> pwned.marker ^& ",  # caret-escaped: still live outside a quoted context
+        "x\n@type nul > pwned.marker\n@rem ",  # newline: a full extra statement, not just a breakout
+        'a"&type nul>pwned.marker&"b',
+        "foo!SECRET!bar",  # delayed-expansion variable substitution, live under cmd /V:ON
+        "a\rb\vc\fd\x85e" + chr(0x2028) + "f" + chr(0x2029) + "g",  # every line boundary
+    ],
+)
+def test_quote_strips_every_dangerous_character(payload):
+    quoted = BatchActivator.quote(payload)
+
+    assert not (set(quoted) & set(_DANGEROUS))
+    assert not (set(quoted) & set(_LINE_BOUNDARIES))
+
+
+@pytest.mark.parametrize("value", ["(x86)", "C:\\Program Files (x86)\\Python", "()", "(a)(b)"])
+def test_quote_leaves_parentheses_untouched(value):
+    # `(` and `)` are only special to cmd.exe as control-flow block delimiters, never as bare
+    # characters in a value, so quoting them would needlessly corrupt "Program Files (x86)" paths.
+    assert BatchActivator.quote(value) == value
+
+
+@pytest.mark.parametrize("value", ["100%done", "%PATH%", "a%b%c", "%%already", ""])
+def test_quote_keeps_percent_literal_and_balanced(value):
+    """Every `%` must survive doubled, never as a lone character that triggers expansion."""
+    quoted = BatchActivator.quote(value)
+
+    assert quoted.replace("%%", "").count("%") == 0
+
+
+def test_quote_embedding_in_set_statement_stays_one_well_formed_line():
+    """The exact shape the template uses: a single `@set "VAR=value"` statement."""
+    rendered = f'@set "VIRTUAL_ENV_PROMPT={BatchActivator.quote(chr(34) + " & type nul > pwned.marker & " + chr(34))}"'
+
+    assert rendered.count("\n") == 0
+    assert rendered.count('"') == 2
+
+
+def test_batch_skips_destination_with_ampersand(tmp_path, caplog):
+    """An `&` in the destination can never be represented, so generation must skip it, not guess."""
+
+    class MockInterpreter:
+        os = "nt"
+        tcl_lib = None
+        tk_lib = None
+
+    class MockCreator:
+        def __init__(self, dest) -> None:
+            self.dest = dest
+            self.bin_dir = dest / "Scripts"
+            self.bin_dir.mkdir(parents=True)
+            self.interpreter = MockInterpreter()
+            self.pyenv_cfg = {}
+            self.env_name = "test-env"
+
+    creator = MockCreator(tmp_path / "weird&dest")
+    activator = BatchActivator(Namespace(prompt=None))
+
+    generated = activator.generate(creator)
+
+    assert generated == []
+    assert list(creator.bin_dir.iterdir()) == []
+    assert "skipping batch activation scripts" in caplog.text
+    assert "&" in caplog.text
