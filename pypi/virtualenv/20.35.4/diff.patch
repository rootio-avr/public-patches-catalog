+def test_fish_tkinter_path_does_not_run_commands(tmp_path):
+    # GIVEN a Tcl/Tk library path containing a fish command substitution payload
+    marker = tmp_path / "PWNED"
+
+    class MockInterpreter:
+        tcl_lib = f"/tcl/(touch {marker})/lib"
+        tk_lib = "/tk/lib"
+
+    class MockCreator:
+        def __init__(self, dest):
+            self.dest = dest
+            self.bin_dir = dest / "bin"
+            self.bin_dir.mkdir()
+            self.interpreter = MockInterpreter()
+            self.pyenv_cfg = {}
+            self.env_name = "my-env"
+
+    creator = MockCreator(tmp_path)
+    FishActivator(Namespace(prompt=None)).generate(creator)
+    script = creator.bin_dir / "activate.fish"
+
+    # WHEN the generated activation script is sourced by fish
+    subprocess.run([FISH, "-c", f"source '{script}'"], capture_output=True, text=True, timeout=60, check=False)
+
+    # THEN the embedded command must not have executed
+    assert not marker.exists()
+
