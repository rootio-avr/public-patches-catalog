+def shell_shebang(executable: str, post_interp: bytes = b"") -> bytes:
+    # The exec line is read by both sh and Python; double-quoted backslashes survive both readers.
+    quoted = shlex.quote(executable).replace("\\", "'\"\\\\\"'")
