+def test_bash_placeholder_in_parent_dir_does_not_run_commands(tmp_path, current_fastest) -> None:
+    dest = tmp_path / "A__VIRTUAL_NAME__B" / "x'$(touch PWNED)'y"
+    cli_run(["--without-pip", str(dest), "--creator", current_fastest, "--no-periodic-update", "--activators", "bash"])
+    work_dir = tmp_path / "workdir"
+    work_dir.mkdir()
+
+    subprocess.run(
+        ["bash", "-c", f"source {shlex.quote(str(dest / 'bin' / 'activate'))} 2>/dev/null"],
+        capture_output=True,
+        text=True,
+        cwd=str(work_dir),
+        check=False,
+    )
+
+    assert not (work_dir / "PWNED").exists()
+    assert not (dest.parent / "PWNED").exists()

