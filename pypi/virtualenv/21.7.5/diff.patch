+@pytest.mark.parametrize("activator", ["bash", "fish"])
+def test_placeholder_in_path_stays_data(tmp_path, current_fastest, activator) -> None:
+    # a path component that spells a template placeholder must not be rewritten from inside an already quoted value
+    dest = tmp_path / "A__VIRTUAL_NAME__B" / "x'$(touch PWNED)'y"
+    cli_run([
+        "--without-pip",
+        str(dest),
+        "--creator",
+        current_fastest,
+        "--no-periodic-update",
+        "--activators",
+        activator,
+    ])
+    script = {"bash": "activate", "fish": "activate.fish"}[activator]
+    content = (dest / "bin" / script).read_text(encoding="utf-8")
+    assert shlex.quote(str(dest)) in content
+
+
