+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from virtualenv.activation.bash import BashActivator
+from virtualenv.activation.via_template import ViaTemplateActivator
+
+
+class _Activator(ViaTemplateActivator):
+    def templates(self):
+        yield "unused"
+
+
+@pytest.mark.parametrize("activator_class", [_Activator, BashActivator])
+def test_placeholder_in_replacement_value_stays_data(activator_class, monkeypatch) -> None:
+    import virtualenv.activation.via_template as via_template  # noqa: PLC0415
+
+    template = "A=__VIRTUAL_ENV__\nB=__VIRTUAL_NAME__\n"
+    monkeypatch.setattr(via_template, "read_binary", lambda _module, _name: template.encode("utf-8"))
+    activator = activator_class(SimpleNamespace(prompt=None))
+    env_dir = "/tmp/x__VIRTUAL_NAME__y/'$(touch PWNED)'z"
+    replacements = {"__VIRTUAL_ENV__": env_dir, "__VIRTUAL_NAME__": "name"}
+
+    result = activator.instantiate_template(replacements, "unused", SimpleNamespace())
+
+    expected = f"A={activator.quote(env_dir)}\nB={activator.quote('name')}\n"
+    assert result == expected
+    assert "x__VIRTUAL_NAME__y" in result

