+    quoted = FishActivator.quote(value)
+    body = quoted[1:-1]
+    assert quoted[0] == quoted[-1] == "'"
+    # every quote or backslash in the body must be consumed as part of an escape pair
+    index = 0
+    while index < len(body):
+        if body[index] == "\\":
+            assert body[index + 1] in "\\'"
+            index += 2
+        else:
+            assert body[index] != "'"
+            index += 1

