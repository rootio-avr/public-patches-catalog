+def test_placeholder_in_replacement_value_is_not_resubstituted(tmp_path: Path) -> None:
+    # a path component named like another placeholder must stay data and not be rewritten from inside the quoted literal
+    evil = "A__VIRTUAL_NAME__B/x'$(touch PWNED)'y"
+    creator = SimpleNamespace(env_name="myenv", dest=tmp_path / evil, interpreter=SimpleNamespace())
+    activator = BashActivator(Namespace(prompt=None))
+    replacements = {
+        "__VIRTUAL_ENV__": str(creator.dest),
+        "__VIRTUAL_NAME__": creator.env_name,
+        "__VIRTUAL_PROMPT__": "",
+    }
+
+    substitutions = activator.substitutions(replacements, creator)
+    assert substitutions["__VIRTUAL_ENV__"] == activator.quote(str(creator.dest))
+
+    text = activator.instantiate_template(replacements, "activate", creator)
+    assert substitutions["__VIRTUAL_ENV__"] in text
+    assert "AmyenvB" not in text

