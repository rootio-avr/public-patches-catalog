+"""Regression test for AIKIDO-2026-674766 (GHSA-p58f-9548-mpm2).
+
+The bash/fish activation templates embedded the virtual-environment path and
+the interpreter Tcl/Tk library paths inside literal quotes. Because the Python
+template renderer already applies ``shlex.quote`` to every replacement value,
+the extra surrounding quotes re-opened a command-injection hole (CWE-78): a
+path such as ``x'$(id)'y`` broke out of the wrapping quotes and its command
+substitution ran when the script was sourced.
+
+The fix removes the redundant surrounding quotes so the already-quoted value is
+the only quoting in the rendered script. These tests render the activation
+scripts with hostile paths and assert the dangerous unquoted payload never
+appears verbatim in the output.
+"""
+
+from __future__ import annotations
+
+import shlex
+from argparse import Namespace
+from types import SimpleNamespace
+
+from virtualenv.activation import BashActivator, FishActivator
+
+
+def _make_creator(tmp_path, tcl_lib=None, tk_lib=None):
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    return SimpleNamespace(
+        dest=tmp_path,
+        bin_dir=bin_dir,
+        interpreter=SimpleNamespace(tcl_lib=tcl_lib, tk_lib=tk_lib),
+        pyenv_cfg={},
+        env_name="my-env",
+    )
+
+
+def test_fish_tcl_tk_library_is_shell_quoted(tmp_path):
+    tcl_lib = "/tcl/x'$(touch PWNED)'y/lib"
+    tk_lib = "/tk/`touch PWNED2`/lib"
+    creator = _make_creator(tmp_path, tcl_lib=tcl_lib, tk_lib=tk_lib)
+
+    FishActivator(Namespace(prompt=None)).generate(creator)
+    content = (creator.bin_dir / "activate.fish").read_text(encoding="utf-8")
+
+    # The value must be shlex-quoted exactly once, with no extra wrapping quotes.
+    assert f"set -gx TCL_LIBRARY {shlex.quote(tcl_lib)}\n" in content
+    assert f"set -gx TK_LIBRARY {shlex.quote(tk_lib)}\n" in content
+    # The old, vulnerable double-quoted-around-quoted form must be gone.
+    assert "set -gx TCL_LIBRARY '" + tcl_lib + "'" not in content
+    assert "$(touch PWNED)" not in content
+    assert "`touch PWNED2`" not in content
+
+
+def test_bash_virtual_env_path_is_shell_quoted(tmp_path):
+    hostile = tmp_path / "x'$(touch PWNED)'y"
+    hostile.mkdir()
+    creator = _make_creator(hostile)
+
+    BashActivator(Namespace(prompt=None)).generate(creator)
+    content = (creator.bin_dir / "activate").read_text(encoding="utf-8")
+
+    # The path is emitted as a shlex-quoted token, never inside a double-quoted
+    # string that would let the command substitution run.
+    assert shlex.quote(str(hostile)) in content
+    assert '"Virtual environment directory ' + str(hostile) not in content
+    assert "$(touch PWNED)" not in content

