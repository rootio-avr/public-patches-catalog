+        f"{_PATH_REPLACEMENT_NAMES[key]} ({value!r}) contains {''.join(found)!r}, and cmd.exe has no way "
+        f'to keep that literal inside the @set "VAR=value" lines activate.bat relies on'
+    )
 
 
