@@ -5,6 +5,89 @@ from argparse import Namespace
 import pytest
 
 from virtualenv.activation import BatchActivator
+from virtualenv.activation.batch import _unsafe_path_reason
+
+# cmd.exe treats these as live syntax inside `@set "VAR=value"` regardless of the surrounding quotes
+# (confirmed on a real Windows runner). `!` is live under delayed expansion (`cmd /V:ON`). None may
+# survive quote(). `(` and `)` are deliberately excluded: they round-trip safely and neutering them
+# would corrupt a "C:\\Program Files (x86)\\..." path.
+DANGEROUS = '"&|<>^!'
+SAFE_IN_THIS_CONTEXT = "()"
+LINE_BOUNDARIES = "\n\r\v\f\x1c\x1d\x1e\x85" + chr(0x2028) + chr(0x2029)
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        'x" & type nul > pwned.marker & "',  # the confirmed GHSA-x78j-v8h9-3j2q exploit payload
+        'x" & calc & "',
+        "x^& type nul ^> pwned.marker ^& ",  # caret-escaped: still live outside a quoted context
+        "x\n@type nul > pwned.marker\n@rem ",  # newline: a full extra statement, not just a breakout
+        'a"&type nul>pwned.marker&"b',
+        "foo!SECRET!bar",  # delayed-expansion variable substitution, confirmed under cmd /V:ON
+    ],
+)
+def test_quote_strips_every_dangerous_character(payload):
+    quoted = BatchActivator.quote(payload)
+
+    assert not (set(quoted) & set(DANGEROUS))
+    assert not (set(quoted) & set(LINE_BOUNDARIES))
+
+
+def test_quote_keeps_percent_literal_and_balanced():
+    quoted = BatchActivator.quote("100%done %PATH% %%literal")
+
+    assert quoted.replace("%%", "").count("%") == 0
+
+
+def test_quote_leaves_parentheses_untouched():
+    assert BatchActivator.quote("(x86)") == "(x86)"
+
+
+def test_embedding_in_the_set_statement_stays_one_well_formed_line():
+    rendered = f'@set "VIRTUAL_ENV_PROMPT={BatchActivator.quote(chr(34) + " & type nul > pwned.marker & " + chr(34))}"'
+
+    assert rendered.count("\n") == 0
+    assert rendered.count('"') == 2
+
+
+def test_path_without_ampersand_has_no_reason_to_skip():
+    assert _unsafe_path_reason("__VIRTUAL_ENV__", "C:\\Program Files (x86)\\Python39\\tcl") is None
+
+
+def test_path_with_ampersand_has_a_reason_to_skip():
+    reason = _unsafe_path_reason("__VIRTUAL_ENV__", "C:\\weird&dest")
+
+    assert reason is not None
+    assert "&" in reason
+
+
+def test_batch_skips_destination_with_ampersand(tmp_path, caplog):
+    """An `&` in the destination can never be represented, so generation must skip it, not guess."""
+
+    class MockInterpreter:
+        os = "nt"
+        tcl_lib = None
+        tk_lib = None
+
+    class MockCreator:
+        def __init__(self, dest) -> None:
+            self.dest = dest
+            self.bin_dir = dest / "Scripts"
+            self.bin_dir.mkdir(parents=True)
+            self.interpreter = MockInterpreter()
+            self.pyenv_cfg = {}
+            self.env_name = "test-env"
+
+    creator = MockCreator(tmp_path / "weird&dest")
+    activator = BatchActivator(Namespace(prompt=None))
+
+    generated = activator.generate(creator)
+
+    assert generated == []
+    assert list(creator.bin_dir.iterdir()) == []
+    assert "skipping batch activation scripts" in caplog.text
+    assert "&" in caplog.text
 
 
