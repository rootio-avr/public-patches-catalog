+@pytest.mark.skipif(IS_WIN or _BASH is None, reason="requires POSIX bash")
+@pytest.mark.parametrize("setup", [pytest.param("", id="default"), pytest.param("BASH_COMPAT=42; ", id="compat42")])
+def test_bash_prompt_stored_form(tmp_path: Path, current_fastest: str, setup: str) -> None:
+    session: Final = cli_run([
+        "--without-pip",
+        str(tmp_path / "env"),
+        "--creator",
+        current_fastest,
+        "--no-periodic-update",
+        "--activators",
+        "bash",
+        "--prompt",
+        "a\\b$c`d",
+    ])
+    result: Final = subprocess.run(
+        [
+            "bash",
+            "--norc",
+            "--noprofile",
+            "-c",
+            f'{setup}PS1=__END__; . "$1"; printf "%s" "$PS1"',
+            "test",
+            str(session.creator.bin_dir / "activate"),
+        ],
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        check=True,
+    )
+
+    assert result.stdout == "(a\\\\\\\\b\\$c\\`d) __END__"
+
+
+@pytest.mark.skipif(IS_WIN or _BASH is None, reason="requires POSIX bash")
+@pytest.mark.parametrize(
+    "child",
+    [
+        pytest.param(["bash", "--noprofile", "--norc", "-i"], id="child-bash"),
+        pytest.param(["dash", "-i"], id="child-dash"),
+    ],
+)
+def test_bash_child_shell_does_not_run_prompt_commands(
+    tmp_path: Path, current_fastest: str, child: list[str]
+) -> None:
+    if shutil.which(child[0]) is None:
+        pytest.skip(f"{child[0]} is not installed")
+    session: Final = cli_run([
+        "--without-pip",
+        str(tmp_path / "env"),
+        "--creator",
+        current_fastest,
+        "--no-periodic-update",
+        "--activators",
+        "bash",
+        "--prompt",
+        "x$(touch PWNED)y`touch PWNED`z",
+    ])
+    work_dir: Final = tmp_path / "workdir"
+    work_dir.mkdir()
+    subprocess.run(
+        [
+            "bash",
+            "--norc",
+            "--noprofile",
+            "-c",
+            f'. "$1"; export PS1; {shlex.join(child)} <<<exit',
+            "test",
+            str(session.creator.bin_dir / "activate"),
+        ],
+        cwd=work_dir,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        check=True,
+    )
+
+    assert not (work_dir / "PWNED").exists()
