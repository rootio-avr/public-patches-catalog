+"""Regression test for CVE-2026-102925.
+
+The bash ``activate`` and fish ``activate.fish`` templates must never evaluate shell metacharacters that
+originate from the virtual environment path or from the interpreter's Tcl/Tk library paths. The template
+substitution already applies ``shlex.quote``; the vulnerable templates additionally wrapped the placeholders in
+quotes, which let an embedded quote break out of the string and run commands.
+"""
+
+from __future__ import annotations
+
+import shlex
+import shutil
+import subprocess
+from argparse import Namespace
+from types import SimpleNamespace
+
+import pytest
+
+from virtualenv.activation import BashActivator, FishActivator
+from virtualenv.info import IS_WIN
+
+
+def _generate(activator_cls, dest, tcl_lib=None, tk_lib=None):
+    bin_dir = dest / "bin"
+    bin_dir.mkdir(parents=True)
+    creator = SimpleNamespace(
+        dest=dest,
+        bin_dir=bin_dir,
+        interpreter=SimpleNamespace(tcl_lib=tcl_lib, tk_lib=tk_lib),
+        pyenv_cfg={},
+        env_name="my-env",
+    )
+    activator_cls(Namespace(prompt=None)).generate(creator)
+    return bin_dir
+
+
+def test_bash_missing_dir_message_does_not_wrap_placeholder_in_quotes(tmp_path):
+    bin_dir = _generate(BashActivator, tmp_path / "env")
+    content = (bin_dir / "activate").read_text(encoding="utf-8")
+
+    assert 'echo "Virtual environment directory" ' in content
+    assert '"Virtual environment directory ' not in content
+
+
+@pytest.mark.parametrize("payload", ["/tcl/'$(touch PWNED)'/lib", "/tcl/';touch PWNED;'/lib"])
+def test_fish_tcl_tk_values_are_not_wrapped_in_extra_quotes(tmp_path, payload):
+    bin_dir = _generate(FishActivator, tmp_path / "env", tcl_lib=payload, tk_lib=payload)
+    content = (bin_dir / "activate.fish").read_text(encoding="utf-8")
+
+    assert f"set -gx TCL_LIBRARY {shlex.quote(payload)}\n" in content
+    assert f"set -gx TK_LIBRARY {shlex.quote(payload)}\n" in content
+    assert f"'{shlex.quote(payload)}'" not in content
+
+
+@pytest.mark.skipif(IS_WIN or shutil.which("bash") is None, reason="requires bash")
+@pytest.mark.parametrize(
+    "name",
+    [
+        "x'$(touch PWNED)'y",
+        "x'`touch PWNED`'y",
+        "a';touch PWNED;'b",
+    ],
+)
+def test_bash_activate_does_not_run_commands_from_venv_path(tmp_path, name):
+    bin_dir = _generate(BashActivator, tmp_path / name)
+    relocated = tmp_path / "relocated"
+    shutil.move(str(bin_dir.parent), str(relocated))
+    work_dir = tmp_path / "workdir"
+    work_dir.mkdir()
+
+    subprocess.run(
+        ["bash", "-c", f'source "{relocated / "bin" / "activate"}" >/dev/null 2>&1'],
+        cwd=str(work_dir),
+        check=False,
+        capture_output=True,
+    )
+
+    assert not (work_dir / "PWNED").exists()

