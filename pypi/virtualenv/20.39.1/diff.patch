 from __future__ import annotations
 
+import logging
 import os
 
 from virtualenv.activation.via_template import ViaTemplateActivator
+from virtualenv.util.text import collapse_line_boundaries
 
+LOGGER = logging.getLogger(__name__)
 
+# cmd.exe's own command-line parser looks for these regardless of surrounding quotes: on a real
+# Windows runner `@set "VAR=x & cmd"` still runs `cmd` as a second statement even though the whole
+# VAR=value expression is quoted. `(` and `)` are not in this set: `@set "VAR=C:\Program Files (x86)\..."`
+# round-trips unchanged, since parentheses are only special to cmd.exe as block delimiters in
+# control-flow syntax (if/for), not as bare characters in a value. `!` is only live when the caller
+# already has delayed expansion enabled, but is neutered unconditionally so a crafted prompt cannot
+# leak the value of an existing variable.
+_CMD_OPERATORS = ("&", "|", "<", ">", "^", "!", '"')
+
+# Of _CMD_OPERATORS, only `&` can actually occur in a real Windows path: `|`, `<`, `>` and `"` are
+# already illegal in Windows filenames. quote() can neuter `&` in free text like the prompt, but doing
+# that to a path would silently point activate.bat at a directory that does not exist, so refuse instead.
+_PATH_UNSAFE_CHARS = ("&",)
+
+_PATH_REPLACEMENT_NAMES = {
+    "__VIRTUAL_ENV__": "the destination directory",
+    "__TCL_LIBRARY__": "the interpreter's Tcl library path",
+    "__TK_LIBRARY__": "the interpreter's Tk library path",
+}
+
