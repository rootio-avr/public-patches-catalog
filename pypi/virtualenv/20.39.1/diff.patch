+"""Regression test for AIKIDO-2026-674766.
+
+Command injection via the virtual environment path (bash ``activate``) and via
+the interpreter Tcl/Tk library paths (fish ``activate.fish``). The activation
+scripts must treat these values as data, never letting embedded shell
+metacharacters be evaluated as commands.
+
+Grounded on the upstream fix commit
+4d5a105ec2a2723b8c7f4571bb68f4f71d01e3f6 tests
+(tests/unit/activation/test_bash.py, tests/unit/activation/test_fish.py).
+"""
+
+from __future__ import annotations
+
+from argparse import Namespace
+from types import SimpleNamespace
+
+from virtualenv.activation import BashActivator, FishActivator
+
+
+def _render(activator_cls, template_name, tmp_path, tcl_lib, tk_lib):
+    creator = SimpleNamespace(
+        dest=tmp_path,
+        bin_dir=tmp_path / "bin",
+        interpreter=SimpleNamespace(tcl_lib=tcl_lib, tk_lib=tk_lib),
+        pyenv_cfg={},
+        env_name="my-env",
+    )
+    creator.bin_dir.mkdir()
+    activator_cls(Namespace(prompt=None)).generate(creator)
+    return (creator.bin_dir / template_name).read_text(encoding="utf-8")
+
+
+def test_bash_tcl_library_path_is_quoted(tmp_path):
+    # A Tcl library path carrying a command-substitution payload must be
+    # single-quoted (shlex.quote) so bash cannot execute it.
+    payload = "/tcl/$(touch PWNED)/lib"
+    content = _render(BashActivator, "activate", tmp_path, payload, "/path/to/tk")
+
+    assert "$(touch PWNED)" not in content.replace("'" + payload + "'", "")
+    assert "'" + payload + "'" in content
+
+
+def test_fish_tcl_library_path_is_quoted(tmp_path):
+    # The fish template must no longer wrap the substituted value in naive
+    # single quotes; shlex.quote handles the quoting so embedded command
+    # substitutions like (touch PWNED) are never evaluated.
+    payload = "/tcl/(touch PWNED)/lib"
+    content = _render(FishActivator, "activate.fish", tmp_path, payload, "/path/to/tk")
+
+    # The dangerous literal, unquoted, must not appear in a set command.
+    assert "set -gx TCL_LIBRARY (touch PWNED)" not in content
+    # The value is present only in its shlex.quoted form.
+    import shlex
+
+    assert f"set -gx TCL_LIBRARY {shlex.quote(payload)}" in content
+
+
+def test_bash_tk_library_path_is_quoted(tmp_path):
+    payload = "/tk/`id`/lib"
+    content = _render(BashActivator, "activate", tmp_path, "/path/to/tcl", payload)
+
+    import shlex
+
+    assert f"TK_LIBRARY={shlex.quote(payload)}" in content
