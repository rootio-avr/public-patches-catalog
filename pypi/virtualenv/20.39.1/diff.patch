@@ -0,0 +1,51 @@
+"""Regression test for the batch activation injection fix (AIKIDO-2026-785880).
+
+``@set "VAR=value"`` is the only place a value from ``--prompt`` (or any other replacement) reaches
+cmd.exe, and cmd.exe treats several characters as live syntax there regardless of the surrounding
+quotes. The invariant that matters is that none of those characters can survive ``quote()``.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from virtualenv.activation.batch import BatchActivator
+
+# Confirmed live syntax inside @set "VAR=value" on a real Windows runner.
+DANGEROUS = '"&|<>()^'
+LINE_BOUNDARIES = "\n\r\v\f\x1c\x1d\x1e\x85" + chr(0x2028) + chr(0x2029)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        'x" & type nul > pwned.marker & "',  # the confirmed exploit payload
+        "x^& type nul ^> pwned.marker ^& ",  # caret-escaped: still live outside a quoted context
+        "x\n@type nul > pwned.marker\n@rem ",  # newline: a full extra statement, not just a breakout
+        'a"&type nul>pwned.marker&"b',
+        "plain-value",
+        "with space and 100% done",
+    ],
+)
+def test_quote_strips_every_dangerous_character(value):
+    quoted = BatchActivator.quote(value)
+
+    assert not (set(quoted) & set(DANGEROUS))
+    assert not (set(quoted) & set(LINE_BOUNDARIES))
+
+
+@pytest.mark.parametrize("value", ["100%", "%PATH%", "a%%b", "no-percent"])
+def test_quote_keeps_percent_literal_and_balanced(value):
+    """Every ``%`` must survive doubled, never as a lone character that triggers expansion."""
+    quoted = BatchActivator.quote(value)
+
+    assert quoted.replace("%%", "").count("%") == 0
+
+
+def test_embedding_in_the_set_statement_stays_one_well_formed_line():
+    """The exact shape the template uses: a single ``@set "VAR=value"`` statement."""
+    value = 'x" & type nul > pwned.marker & "'
+    rendered = f'@set "VIRTUAL_ENV_PROMPT={BatchActivator.quote(value)}"'
+
+    assert rendered.count("\n") == 0
+    assert rendered.count('"') == 2
