+# -*- coding: utf-8 -*-
+"""Regression test for CVE-2026-28356.
+
+Catastrophic backtracking (ReDoS) in the ``_value`` header grammar used by
+``parse_options_header``. The slow quoted-string alternative used ``[^"]``,
+which also matched a backslash and thus overlapped with the ``\\.`` escape
+branch. A crafted Content-Disposition value made of many backslashes without a
+terminating quote caused exponential backtracking. The fix restricts the
+alternative to ``[^\\"]`` so backslashes are only consumed by the escape
+branch, making matching linear.
+"""
+import time
+import unittest
+
+import multipart
+
+
+class TestCVE202628356(unittest.TestCase):
+    def test_redos_payload_completes_quickly(self):
+        # Unterminated quoted string with many backslashes: the vulnerable
+        # regex backtracks exponentially over these before failing to match.
+        payload = 'form-data; name="Test"; filename="' + ("\\" * 40)
+        start = time.perf_counter()
+        multipart.parse_options_header(payload)
+        elapsed = time.perf_counter() - start
+        self.assertLess(
+            elapsed, 2.0,
+            "parse_options_header took %.3fs on ReDoS payload (backtracking)"
+            % elapsed,
+        )
+
+    def test_normal_values_still_parse(self):
+        # The fix must not change parsing of well-formed values.
+        head = 'form-data; name="Test"; '
+        ctype, opts = multipart.parse_options_header(head + 'filename="Test.txt"')
+        self.assertEqual(ctype, 'form-data')
+        self.assertEqual(opts['name'], 'Test')
+        self.assertEqual(opts['filename'], 'Test.txt')
+        # Escaped quote inside a quoted string is preserved.
+        _, opts2 = multipart.parse_options_header(head + 'filename="Te\\"st.txt"')
+        self.assertEqual(opts2['filename'], 'Te"st.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
