+import zlib
+
+
+class DecodeRatioError(Exception):
+    """Output-to-input amplification ratio exceeded the configured limit."""
+
+
+class DecodeLimitError(Exception):
+    """Total output length exceeded the hard limit."""
+
+
+class DecoderProtocol(object):
+    """Interface of incremental decoders."""
+
+    @property
+    def needs_input(self):
+        raise NotImplementedError
+
+    def decode(self, b):
+        raise NotImplementedError
+
+    def flush(self):
+        raise NotImplementedError
+
+    def consume_bytes(self, data, chunk_size=64 << 10):
+        out = bytearray()
+        if chunk_size == 0:
+            chunk_size = len(data)
+        for i in range(0, len(data), max(chunk_size, 1)):
+            chunk = data[i : i + chunk_size]
+            out.extend(self.decode(chunk))
+        out.extend(self.flush())
+        return bytes(out)
+
+
+class ZlibDecoder(DecoderProtocol):
+    """
+    Thin wrapper around zlib.decompressobj conforming to the Decoder interface.
+
+    Note: zlib pushes all available decompressed data immediately upon receiving
+    input. It never holds back output requiring `decode(b"")` to extract it.
+    Thus, `needs_input` naturally remains True until end of stream.
+    """
+
+    __slots__ = ("_decoder",)
+
+    WBITS_DEFLATE = -15
+    WBITS_ZLIB = 15
+    WBITS_GZIP = 15 | 16
+    WBITS_AUTO_GZIP_ZLIB = 15 | 32  # but not raw deflate
+
+    def __init__(self, wbits=WBITS_AUTO_GZIP_ZLIB):
+        self._decoder = zlib.decompressobj(wbits)
+
+    @property
+    def needs_input(self):
+        if self._decoder is None:
+            raise RuntimeError("used after flush()")
+        return not self._decoder.eof
+
+    def decode(self, b):
+        if self._decoder is None:
+            raise RuntimeError("used after flush()")
+        return self._decoder.decompress(b)
+
+    def flush(self):
+        if self._decoder is None:
+            raise RuntimeError("used after flush()")
+        result = self._decoder.flush()
+        self._decoder = None
+        return result
+
+
+def DeflateDecoder():
+    return ZlibDecoder(ZlibDecoder.WBITS_DEFLATE)
+
+
+class LimitDecoder(DecoderProtocol):
+    """
+    Wraps another decoder and enforces limits on decompressed output:
+      - hard_limit: maximum total output length (0 disables)
+      - safe_limit: output shorter than this is never subject to the ratio check
+      - ratio: maximum output/input amplification above safe_limit (0 disables)
+    Input is fed to the wrapped decoder in chunks of `chunk_size` bytes so that
+    limits are checked before large amounts of output accumulate.
+    """
+
+    __slots__ = (
+        "_decoder",
+        "_ratio",
+        "_chunk_size",
+        "_safe_limit",
+        "_hard_limit",
+        "_consumed_length",
+        "_output_length",
+        "_input_buffer",
+        "_flushed",
+    )
+
+    def __init__(
+        self,
+        decoder,
+        ratio=100,
+        chunk_size=64 << 10,
+        safe_limit=10 << 20,
+        hard_limit=10 << 30,
+    ):
+        if ratio < 0:
+            raise ValueError("LimitDecoder() ratio=%s expected >= 0" % (ratio,))
+        if chunk_size < 0:
+            raise ValueError("LimitDecoder() chunk_size=%s expected >= 0" % (chunk_size,))
+        if safe_limit < 0:
+            raise ValueError("LimitDecoder() safe_limit=%s expected >= 0" % (safe_limit,))
+        if hard_limit < 0:
+            raise ValueError("LimitDecoder() hard_limit=%s expected >= 0" % (hard_limit,))
+
+        self._decoder = decoder
+        self._ratio = ratio
+        self._chunk_size = chunk_size
+        self._safe_limit = safe_limit
+        self._hard_limit = hard_limit
+        self._consumed_length = 0
+        self._output_length = 0
+        self._input_buffer = bytearray()
+        self._flushed = False
+
+    def _check_limits(self):
+        if (self._hard_limit > 0) and (self._output_length > self._hard_limit):
+            raise DecodeLimitError(
+                "Output length %d exceeds hard limit %d" % (self._output_length, self._hard_limit)
+            )
+        if (self._safe_limit > 0) and (self._output_length < self._safe_limit):
+            return
+        if (self._ratio > 0) and (self._output_length > self._consumed_length * self._ratio):
+            actual_ratio = (
+                self._output_length / self._consumed_length if self._consumed_length > 0 else float("inf")
+            )
+            raise DecodeRatioError(
+                "Amplification ratio %.1f (%d/%d) exceeds limit %s"
+                % (actual_ratio, self._output_length, self._consumed_length, self._ratio)
+            )
+
+    @property
+    def needs_input(self):
+        return self._decoder.needs_input
+
+    def decode(self, b):
+        if self._flushed:
+            raise RuntimeError("decode() called after flush()")
+        output = self._pump(b)
+        return bytes(output)
+
+    def flush(self):
+        if self._flushed:
+            raise RuntimeError("flush() called more than once")
+        self._flushed = True
+
+        output = self._pump(b"")
+
+        data = self._decoder.flush()
+        output.extend(data)
+        self._output_length += len(data)
+        self._check_limits()
+
+        return bytes(output)
+
+    def _pump(self, b):
+        self._input_buffer.extend(b)
+
+        output = bytearray()
+        while True:
+            if not self._decoder.needs_input:
+                data = self._decoder.decode(b"")
+                if data:
+                    output.extend(data)
+                    self._output_length += len(data)
+                    self._check_limits()
+                    continue
+
+            if self._input_buffer:
+                # chunk_size == 0 means "no re-chunking"
+                size = self._chunk_size or len(self._input_buffer)
+                chunk = bytes(self._input_buffer[:size])
+                del self._input_buffer[:size]
+
+                data = self._decoder.decode(chunk)
+                self._consumed_length += len(chunk)
+
+                if data:
+                    output.extend(data)
+                    self._output_length += len(data)
+                    self._check_limits()
+
+                continue
+
+            # neither input nor decoder progress
+            break
+
+        return output
