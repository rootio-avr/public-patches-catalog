+"""Regression test for CVE-2026-35523.
+
+The legacy ``graphql-ws`` handler executed ``start`` messages without checking
+that the ``connection_init``/``connection_ack`` handshake had completed, so any
+authentication performed during connection init could be skipped entirely.
+A ``start`` sent before ``connection_init`` must now close the socket with
+WebSocket code 4401 ("Unauthorized").
+
+Grounded on the upstream test ``test_start_without_connection_init_is_rejected``
+added in fix commit 0977a4e6b41b7cfe3e9d8ba84a43458a2b0c54c2. The upstream test
+relies on HTTP/WebSocket client fixtures that do not exist in this older tree,
+so this is a self-contained port driving the base handler directly.
+"""
+
+import asyncio
+from typing import Any, List, Optional, Tuple
+
+from strawberry.subscriptions.protocols.graphql_ws.handlers import (
+    BaseGraphQLWSHandler,
+)
+
+
+class _FakeHandler(BaseGraphQLWSHandler):
+    """Minimal concrete handler recording sent messages and close calls."""
+
+    def __init__(self) -> None:
+        super().__init__(
+            schema=None, debug=False, keep_alive=False, keep_alive_interval=1.0
+        )
+        self.sent: List[dict] = []
+        self.closed_with: Optional[Tuple[int, Optional[str]]] = None
+
+    async def get_context(self) -> Any:  # pragma: no cover - unused here
+        return {}
+
+    async def get_root_value(self) -> Any:  # pragma: no cover - unused here
+        return None
+
+    async def send_json(self, data) -> None:
+        self.sent.append(dict(data))
+
+    async def close(self, code: int = 1000, reason: Optional[str] = None) -> None:
+        self.closed_with = (code, reason)
+
+    async def handle_request(self) -> Any:  # pragma: no cover - unused here
+        return None
+
+
+def _run(coro):
+    return asyncio.new_event_loop().run_until_complete(coro)
+
+
+def test_start_without_connection_init_is_rejected():
+    handler = _FakeHandler()
+    assert handler.connection_acknowledged is False
+
+    _run(
+        handler.handle_start(
+            {
+                "type": "start",
+                "id": "1",
+                "payload": {"query": "subscription { listener }"},
+            }
+        )
+    )
+
+    # Connection closed as Unauthorized, and no operation was registered.
+    assert handler.closed_with == (4401, "Unauthorized")
+    assert handler.tasks == {}
+    assert handler.subscriptions == {}
+    assert handler.sent == []
+
+
+def test_connection_init_marks_connection_acknowledged():
+    handler = _FakeHandler()
+
+    _run(handler.handle_connection_init({"type": "connection_init"}))
+
+    assert handler.connection_acknowledged is True
+    assert handler.closed_with is None
+    assert handler.sent == [{"type": "connection_ack"}]
+
+
+def test_rejected_connection_init_does_not_acknowledge():
+    handler = _FakeHandler()
+
+    # A malformed payload is rejected, so the connection must stay unauthorized
+    # and a following `start` must still be refused.
+    _run(
+        handler.handle_connection_init(
+            {"type": "connection_init", "payload": "not-a-dict"}
+        )
+    )
+    assert handler.connection_acknowledged is False
+
+    _run(
+        handler.handle_start(
+            {
+                "type": "start",
+                "id": "1",
+                "payload": {"query": "subscription { listener }"},
+            }
+        )
+    )
+    assert handler.closed_with == (4401, "Unauthorized")
+    assert handler.tasks == {}

