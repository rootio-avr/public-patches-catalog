+"""Regression test for CVE-2026-35526.
+
+Sending a 'start' message without a prior 'connection_init' must be rejected
+with WebSocket close code 4401 ("Unauthorized"). This ensures the
+on_ws_connect authentication hook cannot be bypassed by skipping the
+connection_init handshake.
+
+Grounded on the upstream test
+``test_start_without_connection_init_is_rejected`` added in fix commit
+0977a4e6b41b7cfe3e9d8ba84a43458a2b0c54c2, reduced to a minimal, dependency-free
+unit test that drives the base handler directly.
+"""
+
+import asyncio
+
+import strawberry
+from strawberry.subscriptions.protocols.graphql_ws import GQL_START
+from strawberry.subscriptions.protocols.graphql_ws.handlers import (
+    BaseGraphQLWSHandler,
+)
+
+
+@strawberry.type
+class Query:
+    @strawberry.field
+    def hello(self) -> str:
+        return "world"
+
+
+@strawberry.type
+class Subscription:
+    @strawberry.subscription
+    async def listener(self) -> "int":
+        yield 1
+
+
+schema = strawberry.Schema(query=Query, subscription=Subscription)
+
+
+class RecordingHandler(BaseGraphQLWSHandler):
+    def __init__(self) -> None:
+        super().__init__(
+            schema=schema, debug=False, keep_alive=False, keep_alive_interval=1.0
+        )
+        self.sent = []
+        self.close_calls = []
+
+    async def get_context(self):
+        return {}
+
+    async def get_root_value(self):
+        return None
+
+    async def send_json(self, data) -> None:
+        self.sent.append(data)
+
+    async def close(self, code: int = 1000, reason=None) -> None:
+        self.close_calls.append((code, reason))
+
+    async def handle_request(self):  # pragma: no cover - not exercised here
+        return None
+
+
+def test_start_without_connection_init_is_rejected():
+    handler = RecordingHandler()
+
+    assert handler.connection_acknowledged is False
+
+    message = {
+        "type": GQL_START,
+        "id": "1",
+        "payload": {"query": "subscription { listener }"},
+    }
+
+    asyncio.get_event_loop().run_until_complete(handler.handle_start(message))
+
+    # The unauthorized 'start' must be rejected by closing the socket with 4401
+    # and no subscription task must be created.
+    assert handler.close_calls == [(4401, "Unauthorized")]
+    assert handler.tasks == {}
+    assert handler.subscriptions == {}
+
+
+def test_connection_init_sets_acknowledged_flag():
+    handler = RecordingHandler()
+
+    asyncio.get_event_loop().run_until_complete(
+        handler.handle_connection_init({"type": "connection_init"})
+    )
+
+    assert handler.connection_acknowledged is True
+    assert handler.close_calls == []
