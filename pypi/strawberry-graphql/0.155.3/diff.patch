@@ -0,0 +1,154 @@
+"""Regression test for CVE-2026-35526.
+
+Neither WebSocket subscription handler bounded the number of concurrent
+operations a single connection could start, letting one client exhaust server
+resources. Both handlers now enforce ``max_subscriptions_per_connection`` and
+reject operations beyond the limit with an ``error`` message whose payload is
+``{"message": "Subscription limit reached"}``.
+
+Grounded on the upstream test ``test_max_subscriptions_per_connection`` added
+in fix commit 0977a4e6b41b7cfe3e9d8ba84a43458a2b0c54c2. The upstream test
+relies on HTTP/WebSocket client fixtures that do not exist in this older tree,
+so this is a self-contained port driving the base handlers directly.
+"""
+
+import asyncio
+from datetime import timedelta
+from typing import Any, List, Optional, Tuple
+
+from strawberry.subscriptions.protocols.graphql_transport_ws.handlers import (
+    BaseGraphQLTransportWSHandler,
+)
+from strawberry.subscriptions.protocols.graphql_transport_ws.types import (
+    SubscribeMessage,
+    SubscribeMessagePayload,
+)
+from strawberry.subscriptions.protocols.graphql_ws.handlers import (
+    BaseGraphQLWSHandler,
+)
+
+QUERY = "subscription { listener }"
+
+
+class _FakeWSHandler(BaseGraphQLWSHandler):
+    """Legacy `graphql-ws` handler recording sent messages and close calls."""
+
+    def __init__(self, max_subscriptions_per_connection: Optional[int] = 100):
+        super().__init__(
+            schema=None, debug=False, keep_alive=False, keep_alive_interval=1.0
+        )
+        self.max_subscriptions_per_connection = max_subscriptions_per_connection
+        self.connection_acknowledged = True
+        self.sent: List[dict] = []
+        self.closed_with: Optional[Tuple[int, Optional[str]]] = None
+
+    async def get_context(self) -> Any:  # pragma: no cover - unused here
+        return {}
+
+    async def get_root_value(self) -> Any:  # pragma: no cover - unused here
+        return None
+
+    async def send_json(self, data) -> None:
+        self.sent.append(dict(data))
+
+    async def close(self, code: int = 1000, reason: Optional[str] = None) -> None:
+        self.closed_with = (code, reason)
+
+    async def handle_request(self) -> Any:  # pragma: no cover - unused here
+        return None
+
+
+class _FakeTransportWSHandler(BaseGraphQLTransportWSHandler):
+    """`graphql-transport-ws` handler recording sent messages and close calls."""
+
+    def __init__(self, max_subscriptions_per_connection: Optional[int] = 100):
+        super().__init__(
+            schema=None,
+            debug=False,
+            connection_init_wait_timeout=timedelta(minutes=1),
+        )
+        self.max_subscriptions_per_connection = max_subscriptions_per_connection
+        self.connection_acknowledged = True
+        self.sent: List[dict] = []
+        self.closed_with: Optional[Tuple[int, Optional[str]]] = None
+
+    async def get_context(self) -> Any:  # pragma: no cover - unused here
+        return {}
+
+    async def get_root_value(self) -> Any:  # pragma: no cover - unused here
+        return None
+
+    async def send_json(self, data: dict) -> None:
+        self.sent.append(dict(data))
+
+    async def close(self, code: int, reason: str) -> None:
+        self.closed_with = (code, reason)
+
+    async def handle_request(self) -> Any:  # pragma: no cover - unused here
+        return None
+
+
+def _run(coro):
+    return asyncio.new_event_loop().run_until_complete(coro)
+
+
+def _start(operation_id: str) -> dict:
+    return {"type": "start", "id": operation_id, "payload": {"query": QUERY}}
+
+
+def test_graphql_ws_rejects_operations_beyond_the_limit():
+    handler = _FakeWSHandler(max_subscriptions_per_connection=2)
+    # Pretend two operations are already in flight.
+    handler.tasks = {"sub1": object(), "sub2": object()}
+
+    _run(handler.handle_start(_start("sub3")))
+
+    assert handler.closed_with is None
+    assert handler.sent == [
+        {
+            "type": "error",
+            "id": "sub3",
+            "payload": {"message": "Subscription limit reached"},
+        }
+    ]
+    # The rejected operation must not be registered.
+    assert "sub3" not in handler.tasks
+
+
+def test_graphql_ws_limit_can_be_disabled():
+    handler = _FakeWSHandler(max_subscriptions_per_connection=None)
+    handler.tasks = {str(i): object() for i in range(500)}
+
+    # With the limit disabled the request is not short-circuited, so it reaches
+    # schema execution -- which fails here because there is no schema. What
+    # matters is that no "Subscription limit reached" error was emitted.
+    try:
+        _run(handler.handle_start(_start("extra")))
+    except AttributeError:
+        pass
+
+    assert handler.sent == []
+
+
+def test_graphql_transport_ws_rejects_operations_beyond_the_limit():
+    handler = _FakeTransportWSHandler(max_subscriptions_per_connection=2)
+    handler.subscriptions = {"sub1": object(), "sub2": object()}
+
+    _run(
+        handler.handle_subscribe(
+            SubscribeMessage(id="sub3", payload=SubscribeMessagePayload(query=QUERY))
+        )
+    )
+
+    assert handler.closed_with is None
+    assert len(handler.sent) == 1
+    error = handler.sent[0]
+    assert error["type"] == "error"
+    assert error["id"] == "sub3"
+    assert error["payload"][0]["message"] == "Subscription limit reached"
+    assert "sub3" not in handler.subscriptions
+
+
+def test_default_limit_is_enforced_on_both_handlers():
+    assert BaseGraphQLWSHandler.max_subscriptions_per_connection == 100
+    assert BaseGraphQLTransportWSHandler.max_subscriptions_per_connection == 100
