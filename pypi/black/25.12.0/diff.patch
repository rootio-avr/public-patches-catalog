@@ -0,0 +1,98 @@
+"""Tests for the version handling of the GitHub Action in `action/main.py`."""
+
+import ast
+import sys
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+ACTION_MAIN = Path(__file__).parent.parent / "action" / "main.py"
+
+pytestmark = pytest.mark.skipif(
+    sys.version_info < (3, 11), reason="use_pyproject requires tomllib"
+)
+
+
+def _load_action_functions() -> dict[str, Any]:
+    """Return the functions of `action/main.py` without running the action.
+
+    The module creates a virtualenv and runs pip at import time, so only its
+    imports, compiled regexes and function definitions are executed.
+    """
+    tree = ast.parse(ACTION_MAIN.read_text(encoding="utf-8"))
+    body: list[ast.stmt] = [
+        node
+        for node in tree.body
+        if isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef))
+        or (
+            isinstance(node, ast.Assign)
+            and isinstance(node.value, ast.Call)
+            and isinstance(node.value.func, ast.Attribute)
+            and node.value.func.attr == "compile"
+        )
+    ]
+    namespace: dict[str, Any] = {}
+    exec(
+        compile(ast.Module(body=body, type_ignores=[]), str(ACTION_MAIN), "exec"),
+        namespace,
+    )
+    return namespace
+
+
+@pytest.fixture
+def read_from_pyproject(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> Callable[[str], str]:
+    read: Callable[[], str] = _load_action_functions()[
+        "read_version_specifier_from_pyproject"
+    ]
+    monkeypatch.chdir(tmp_path)
+
+    def run(content: str) -> str:
+        (tmp_path / "pyproject.toml").write_text(content, encoding="utf-8")
+        return read()
+
+    return run
+
+
+def _required_version(value: str) -> str:
+    return f"[tool.black]\nrequired-version = {value!r}\n"
+
+
+def _dependency(value: str) -> str:
+    return f"[project]\nname = 'x'\ndependencies = [{value!r}]\n"
+
+
+@pytest.mark.parametrize(
+    "content, expected",
+    [
+        (_required_version("25.12.0"), "==25.12.0"),
+        (_required_version("25"), "~=25.0"),
+        (_dependency("black==25.12.0"), "==25.12.0"),
+        (_dependency("black>=25,<26"), ">=25,<26"),
+        (_dependency("black[jupyter]~=25.1"), "~=25.1"),
+    ],
+)
+def test_pyproject_version_accepts_specifiers(
+    read_from_pyproject: Callable[[str], str], content: str, expected: str
+) -> None:
+    assert read_from_pyproject(content) == expected
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        _required_version("1.0 @ https://example.invalid/black.whl"),
+        _required_version("not a version"),
+        _dependency("black @ https://example.invalid/black.whl"),
+        _dependency("black>=25 @ https://example.invalid/black.whl"),
+        _dependency("black>=25 --index-url https://example.invalid/simple"),
+    ],
+)
+def test_pyproject_version_rejects_non_specifiers(
+    read_from_pyproject: Callable[[str], str], content: str
+) -> None:
+    with pytest.raises(SystemExit):
+        read_from_pyproject(content)
