+"""SQLite must not act on names another account can create beside a lock database (CVE-2026-112940)."""
+
+from __future__ import annotations
+
+import os
+import sqlite3
+import subprocess
+import sys
+from typing import TYPE_CHECKING
+
+import pytest
+
+from filelock import ReadWriteLock
+from filelock._read_write import _host_digest
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from pytest_mock import MockerFixture
+
+pytestmark = pytest.mark.skipif(
+    sys.platform == "win32" or not hasattr(os, "link") or not hasattr(os, "geteuid") or not hasattr(os, "fork"),
+    reason="the private link guards POSIX side files and needs os.link, os.geteuid and os.fork",
+)
+
+
+@pytest.fixture(autouse=True)
+def _fresh_sweep_registry(mocker: MockerFixture) -> None:
+    # Inode numbers repeat across short-lived test directories, which would skip a sweep the test expects.
+    mocker.patch("filelock._read_write._SWEPT_DATABASES", set())
+
+
+@pytest.fixture
+def shared_directory(tmp_path: Path) -> Path:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)  # any other account may create names here, so SQLite must not use them
+    return directory
+
+
+def _leave_hot_journal(database: Path) -> None:
+    with sqlite3.connect(database, isolation_level=None) as connection:
+        connection.execute("PRAGMA journal_mode=DELETE")
+        connection.execute("CREATE TABLE t(a)")
+        connection.execute("BEGIN")
+        for _ in range(50):
+            connection.execute("INSERT INTO t VALUES (zeroblob(4000))")
+        connection.execute("COMMIT")
+    connection.close()
+    pid = os.fork()
+    if pid == 0:  # pragma: forked child
+        child = sqlite3.connect(database, isolation_level=None)
+        child.execute("PRAGMA journal_mode=DELETE")
+        child.execute("PRAGMA cache_size=2")
+        child.execute("BEGIN")
+        child.execute("UPDATE t SET a=zeroblob(3999)")
+        os._exit(0)  # dies mid-transaction, leaving a journal that SQLite would replay and delete
+    os.waitpid(pid, 0)
+
+
+def test_hot_journal_beside_shared_database_is_left_alone(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    _leave_hot_journal(database)
+    journal = shared_directory / "lock.db-journal"
+    assert journal.exists()
+    size = journal.stat().st_size
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+
+    assert journal.exists()
+    assert journal.stat().st_size == size
+
+
+def test_shared_directory_connects_through_a_private_link(shared_directory: Path, mocker: MockerFixture) -> None:
+    database = shared_directory / "lock.db"
+    spy = mocker.spy(sqlite3, "connect")
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.read_lock():
+        connected = [call.args[0] for call in spy.call_args_list]
+        assert connected
+        for target in connected:
+            assert os.fspath(database) != target
+            assert os.path.dirname(os.path.dirname(os.path.dirname(target))) == os.fspath(shared_directory)
+            assert os.path.basename(os.path.dirname(os.path.dirname(target))).startswith(".filelock-")
+        assert os.stat(connected[-1]).st_ino == database.stat().st_ino  # the validation connection's link is gone
+    lock.close()
+
+    assert [entry.name for entry in shared_directory.iterdir()] == ["lock.db"]
+
+
+def test_private_directory_connects_by_name(tmp_path: Path, mocker: MockerFixture) -> None:
+    database = tmp_path / "lock.db"
+    spy = mocker.spy(sqlite3, "connect")
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+
+    assert {call.args[0] for call in spy.call_args_list} == {os.fspath(database)}
+    assert [entry.name for entry in tmp_path.iterdir()] == ["lock.db"]
+
+
+def test_two_locks_in_shared_directory_exclude_each_other(shared_directory: Path) -> None:
+    database = str(shared_directory / "lock.db")
+    first = ReadWriteLock(database, is_singleton=False)
+    second = ReadWriteLock(database, is_singleton=False)
+    with first.write_lock():
+        from filelock import Timeout  # noqa: PLC0415
+
+        with pytest.raises(Timeout):
+            second.acquire_read(timeout=0.2)
+        with pytest.raises(Timeout):
+            second.acquire_write(timeout=0.2)
+    with second.write_lock():
+        pass
+    first.close()
+    second.close()
+
