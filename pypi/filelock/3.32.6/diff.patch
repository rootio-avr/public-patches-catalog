+def test_symlink_planted_at_the_database_name_is_refused(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    victim = shared_directory / "victim"
+    victim.write_text("precious")
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    database.unlink()
+    database.symlink_to(victim)
+
+    with pytest.raises(OSError, match="non-regular|symbolic link|Symbolic link|Too many levels"):
+        lock.acquire_write(timeout=1)
+
+    assert victim.read_text() == "precious"
+    assert sorted(entry.name for entry in shared_directory.iterdir()) == ["lock.db", "victim"]
+    lock.close()
+
+
+def test_schema_too_large_to_load_is_refused(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    with sqlite3.connect(database) as connection:
+        columns = ", ".join(f"column_number_{index} INTEGER" for index in range(400))
+        connection.execute(f"CREATE TABLE t({columns})")
+    connection.close()
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with pytest.raises(ValueError, match="schema is too large"):
+        lock.acquire_read(timeout=1)
+    lock.close()
+
+
+def test_links_of_a_dead_process_are_swept(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    database.touch()
+    finished = subprocess.run([sys.executable, "-c", "import os; print(os.getpid())"], capture_output=True, check=True)
+    dead_pid = int(finished.stdout)
+    from filelock._identity import host_name  # noqa: PLC0415
