+@pytest.mark.skipif(sys.platform == "win32", reason="POSIX permission bits decide which directories are private")
+def test_read_write_lock_ignores_a_journal_planted_beside_the_database(tmp_path: Path) -> None:
+    shared = tmp_path / "shared"
+    shared.mkdir()
+    shared.chmod(0o777)
+    lock_path = shared / "lock.db"
+    victim = tmp_path / "victim"
+    victim.write_bytes(b"precious")
+    (shared / "lock.db-journal").symlink_to(victim)
+    lock = ReadWriteLock(lock_path, is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+    assert victim.read_bytes() == b"precious"
