+@pytest.mark.skipif(sys.platform == "win32", reason="POSIX permission bits decide which directories are private")
+def test_read_write_lock_connects_through_a_private_link_in_a_shared_directory(
+    tmp_path: Path, mocker: MockerFixture
+) -> None:
+    # A directory other accounts can write lets them plant -journal, -wal and -shm names beside the database, so SQLite
+    # must open a private hard link inside a directory only this account can write, and never the shared name itself.
+    shared = tmp_path / "shared"
+    shared.mkdir()
+    shared.chmod(0o777)
+    lock_path = shared / "lock.db"
+    opened: list[str] = []
+    real_connect = sqlite3.connect
+
+    def spy(database: str, *args: object, **kwargs: object) -> sqlite3.Connection:
+        opened.append(os.fsdecode(database))
+        return real_connect(database, *args, **kwargs)  # type: ignore[arg-type]
+
+    mocker.patch("filelock._read_write.sqlite3.connect", side_effect=spy)
+    lock = ReadWriteLock(lock_path, is_singleton=False)
+    lock.acquire_write()
+    try:
+        assert opened
+        assert all(name != str(lock_path) and not name.startswith(("/proc/self/fd/", "/dev/fd/")) for name in opened)
+        assert all(name.startswith(str(shared / ".filelock-")) for name in opened)
+        assert_read_write_lock_state(str(lock_path), "read", available=False)
+    finally:
+        lock.close()
+    assert [entry.name for entry in shared.iterdir()] == ["lock.db"]
+
