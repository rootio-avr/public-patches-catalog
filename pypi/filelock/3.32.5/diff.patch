+def _link_database(database: str) -> None:  # pragma: needs hard-link
+    # Closing a descriptor on an inode a peer connection holds locked would drop that peer's POSIX locks, so an existing
+    # database is only ever linked, never opened; a missing one is created exclusively, which no peer can have locked.
+    try:
+        descriptor = os.open(database, os.O_RDWR | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
+    except FileExistsError:
+        return
+    os.close(descriptor)
