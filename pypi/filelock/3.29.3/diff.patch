+_LINK_PREFIX = ".filelock-"
+_LINK_NAME = "lock.db"
+# O_NONBLOCK keeps an open from blocking on a FIFO planted at the path; the regular-file check then rejects it.
+_DB_OPEN_FLAGS = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
+_DIRECTORY_FLAGS = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
