+class _LinkDirectory(NamedTuple):
+    path: pathlib.Path
+    identity: tuple[int, int]
+    # Made through a descriptor of path, which nobody else can list, so a directory another process swaps in under
+    # path cannot hold this name and SQLite fails to open instead of following the swap.
+    name: str
+    pid: int
+
+    @property
+    def database(self) -> pathlib.Path:
+        return self.path / self.name / _LINK_NAME
+
+
+_link_directories: dict[sqlite3.Connection, _LinkDirectory] = {}
+
+
+def _names_are_private(directory: pathlib.Path, owner: int) -> bool:
+    status = os.lstat(directory)
+    # The sticky bit still lets others create names, so a directory anyone else may write to never qualifies.
+    return status.st_uid in {owner, 0} and not status.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
+
+
+def _open_lock_database(database: str) -> int:
+    fd = os.open(database, _DB_OPEN_FLAGS, 0o644)
+    if not stat.S_ISREG(os.fstat(fd).st_mode):
+        os.close(fd)
+        msg = f"refusing a non-regular lock database: {database!r}"
+        raise OSError(msg)
+    return fd
+
+
+def _raise_if_wal(fd: int, database: str) -> None:
+    # WAL never blocks readers behind a writer, so the lock cannot work on such a database.
+    header = os.pread(fd, _HEADER_SIZE, 0)
+    if header.startswith(_SQLITE_MAGIC) and _WAL_FORMAT_VERSION in header[18:20]:
+        msg = f"refusing a WAL-mode lock database: {database!r}; give ReadWriteLock a file of its own"
+        raise ValueError(msg)
+
+
+def _connect(database: str) -> tuple[sqlite3.Connection, _LinkDirectory | None]:
+    """
+    Open the SQLite database without letting another account's names steer SQLite.
+
+    SQLite opens the name it is given, following symlinks, and uses the ``-journal``, ``-wal`` and ``-shm`` names beside
+    it, so the database name is safe only where no other account can create names. Elsewhere SQLite is pointed at a
+    hard link to the validated inode inside a directory only this account can write.
+
+    """
+    if sys.platform == "win32":  # pragma: win32 cover
+        return sqlite3.connect(database, check_same_thread=False), None
+    owner = os.geteuid()  # pragma: win32 no cover
+    fd = _open_lock_database(database)
+    try:
+        _raise_if_wal(fd, database)
+        identity = os.fstat(fd)
+        link: _LinkDirectory | None = None
+        target = database
+        if not _names_are_private(pathlib.Path(database).parent, owner):
+            link = _link_beside(database, (identity.st_dev, identity.st_ino), owner)
+            target = os.fspath(link.database)
+        try:
+            return sqlite3.connect(target, check_same_thread=False), link
+        except BaseException:
+            if link is not None:
+                _remove_link_directory(link)
+            raise
+    finally:
+        os.close(fd)
+
+
+def _link_beside(database: str, identity: tuple[int, int], owner: int) -> _LinkDirectory:
+    # Beside the database because a link cannot cross filesystems, and TMPDIR is often on another one.
+    parent = pathlib.Path(database).parent
+    path = pathlib.Path(tempfile.mkdtemp(prefix=f"{_LINK_PREFIX}{os.getpid()}-", dir=parent))
+    fd = os.open(path, _DIRECTORY_FLAGS)
+    try:
+        made = os.fstat(fd)
+        # Whoever can rename in the parent can put another directory under the new name before it opens.
+        if made.st_uid != owner or made.st_mode & 0o077:
+            msg = f"link directory {os.fspath(path)!r} was replaced while opening"
+            raise OSError(msg)
+        link = _LinkDirectory(path, (made.st_dev, made.st_ino), secrets.token_hex(8), os.getpid())
+        try:
+            os.mkdir(link.name, 0o700, dir_fd=fd)
+            os.link(database, link.database, follow_symlinks=False)
+            linked = link.database.stat(follow_symlinks=False)
+        except BaseException:
+            _remove_link_directory(link)
+            raise
+    finally:
+        os.close(fd)
+    if (linked.st_dev, linked.st_ino) != identity:
+        _remove_link_directory(link)
+        msg = f"lock database changed while opening: {database!r}"
+        raise OSError(msg)
+    return link
+
+
+def _remove_link_directory(link: _LinkDirectory) -> None:
+    # A rename in the parent may have put any directory under this name, so entries go through a descriptor checked
+    # to be the directory made, and the name goes only through rmdir, which refuses a non-empty directory.
+    try:
+        fd = os.open(link.path, _DIRECTORY_FLAGS)
+    except OSError:
+        return
+    try:
+        opened = os.fstat(fd)
+        if (opened.st_dev, opened.st_ino) != link.identity:
+            return
+        for suffix in ("", "-journal", "-wal", "-shm"):
+            with suppress(OSError):
+                os.unlink(f"{link.name}/{_LINK_NAME}{suffix}", dir_fd=fd)
+        with suppress(OSError):
+            os.rmdir(link.name, dir_fd=fd)
+    finally:
+        os.close(fd)
+    # The link is gone, so a failure here leaves one stray empty directory and is not worth failing a release for.
+    with suppress(OSError):
+        link.path.rmdir()
+
+
+def _release_link(connection: sqlite3.Connection) -> None:
+    with _all_connections_lock:
+        link = _link_directories.pop(connection, None)
+    # A forked child shares the parent's link directory, which only the process that made it removes.
+    if link is not None and link.pid == os.getpid():
+        _remove_link_directory(link)
+
+
+@contextmanager
+def _bounded_schema(connection: sqlite3.Connection, database: str) -> Generator[None]:
+    # The first statement loads the file's complete schema, which no timeout bounds, and a lock database has none.
+    # Waiting for a lock runs no virtual machine steps, so a step budget bounds only that load.
+    calls = count()
+    if (limit := getattr(sqlite3, "SQLITE_LIMIT_LENGTH", None)) is not None and hasattr(connection, "setlimit"):
+        connection.setlimit(limit, _SCHEMA_MAX_LENGTH)
+    connection.set_progress_handler(lambda: next(calls) >= _SCHEMA_MAX_CALLS, 1000)
+    try:
+        yield
+    except sqlite3.DatabaseError as error:
+        # An interrupted schema load reports a malformed schema rather than the interrupt.
+        if isinstance(error, sqlite3.DataError) or next(calls) > _SCHEMA_MAX_CALLS:
+            msg = (
+                f"refusing a lock database whose schema is too large to load: {database!r}; "
+                "give ReadWriteLock a file of its own"
+            )
+            raise ValueError(msg) from error
+        raise
+    finally:
+        connection.set_progress_handler(None, 0)
+
