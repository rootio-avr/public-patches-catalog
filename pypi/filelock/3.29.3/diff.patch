+def test_oversized_schema_is_refused(tmp_path: Path) -> None:
+    database = tmp_path / "big.db"
+    with closing(sqlite3.connect(database)) as con:
+        columns = ", ".join(f"column_{i} INTEGER" for i in range(2000))
+        con.execute(f"CREATE TABLE t ({columns})")
+        con.commit()
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    try:
+        for acquire in (lock.acquire_read, lock.acquire_write):
+            with pytest.raises(ValueError, match="schema is too large"):
+                acquire()
+    finally:
+        lock.close()
+
