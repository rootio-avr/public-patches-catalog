+from __future__ import annotations
+
+import os
+import sqlite3
+import stat
+import sys
+from typing import TYPE_CHECKING, Final
+
+import pytest
+
+from filelock import ReadWriteLock, Timeout, _read_write
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from pytest_mock import MockerFixture
+
+pytestmark = [
+    pytest.mark.skipif(sys.platform == "win32", reason="private links apply to POSIX directories"),
+    pytest.mark.skipif(not hasattr(os, "link"), reason="needs hard links"),
+]
+
+_PLANTED: Final[bytes] = b"not a journal, and not this lock's to touch"
+
+
+@pytest.fixture
+def shared_directory(tmp_path: Path) -> Path:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)  # no sticky bit: another account may rename and create names here
+    return directory
+
+
+def _link_directories(directory: Path) -> list[str]:
+    return [entry.name for entry in directory.iterdir() if entry.name.startswith(_read_write._LINK_PREFIX)]
+
+
+def test_directory_privacy(tmp_path: Path) -> None:
+    owner = os.geteuid()
+    directory = tmp_path / "d"
+    directory.mkdir()
+    directory.chmod(0o700)
+    assert _read_write._names_are_private(directory, owner)
+    directory.chmod(0o755)
+    assert _read_write._names_are_private(directory, owner)
+    directory.chmod(0o775)
+    assert not _read_write._names_are_private(directory, owner)
+    directory.chmod(0o777 | stat.S_ISVTX)
+    assert not _read_write._names_are_private(directory, owner)
+    directory.chmod(0o700)
+    if owner != 0:  # root's own directories are trusted by every account
+        assert not _read_write._names_are_private(directory, owner + 1)
+
+
+def test_private_directory_opens_the_database_by_name(tmp_path: Path, mocker: MockerFixture) -> None:
+    private = tmp_path / "private"
+    private.mkdir(mode=0o700)
+    lock_path = private / "lock.db"
+    connect = mocker.spy(sqlite3, "connect")
+    lock = ReadWriteLock(str(lock_path), is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+    assert {call.args[0] for call in connect.call_args_list} == {os.fspath(lock_path.resolve())}
+
+
+def test_shared_directory_opens_a_private_link(shared_directory: Path, mocker: MockerFixture) -> None:
+    lock_path = shared_directory / "lock.db"
+    connect = mocker.spy(sqlite3, "connect")
+    lock = ReadWriteLock(str(lock_path), is_singleton=False)
+    with lock.write_lock():
+        targets = [call.args[0] for call in connect.call_args_list]
+        assert os.fspath(lock_path.resolve()) not in targets
+        target = targets[-1]  # the connection that holds the lock; earlier ones were closed with their links
+        assert os.path.samefile(target, lock_path)
+        link_directory = os.path.dirname(os.path.dirname(target))
+        assert os.path.basename(link_directory).startswith(_read_write._LINK_PREFIX)
+        assert stat.S_IMODE(os.stat(link_directory).st_mode) == 0o700
+        assert stat.S_IMODE(os.stat(os.path.dirname(target)).st_mode) == 0o700
+    lock.close()
+    assert _link_directories(shared_directory) == []
+    assert lock_path.stat().st_nlink == 1
+
+
+def test_shared_directory_still_excludes_across_instances(shared_directory: Path) -> None:
+    lock_path = str(shared_directory / "lock.db")
+    writer = ReadWriteLock(lock_path, is_singleton=False)
+    reader = ReadWriteLock(lock_path, is_singleton=False)
+    with writer.write_lock():
+        with pytest.raises(Timeout):
+            reader.acquire_read(blocking=False)
+    with reader.read_lock():
+        pass
+    writer.close()
+    reader.close()
+    assert _link_directories(shared_directory) == []
+
+
+@pytest.mark.parametrize("suffix", ["-journal", "-wal", "-shm"])
+def test_planted_side_files_are_left_alone(shared_directory: Path, suffix: str) -> None:
+    lock_path = shared_directory / "lock.db"
+    planted = shared_directory / f"lock.db{suffix}"
+    planted.write_bytes(_PLANTED)
+    victim = shared_directory / f"victim{suffix}"
+    victim.write_bytes(_PLANTED)
+    lock = ReadWriteLock(str(lock_path), is_singleton=False)
+    with lock.write_lock():
+        pass
+    with lock.read_lock():
+        pass
+    lock.close()
+    assert planted.read_bytes() == _PLANTED
+    assert victim.read_bytes() == _PLANTED
+
+
+def test_planted_side_file_symlink_is_not_followed(shared_directory: Path, tmp_path: Path) -> None:
+    victim = tmp_path / "victim"
+    victim.write_bytes(_PLANTED)
+    (shared_directory / "lock.db-journal").symlink_to(victim)
+    lock = ReadWriteLock(str(shared_directory / "lock.db"), is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+    assert victim.read_bytes() == _PLANTED
+
+
+def test_symlinked_database_name_is_refused(shared_directory: Path, tmp_path: Path) -> None:
+    target = tmp_path / "target.db"
+    target.write_bytes(b"")
+    lock = ReadWriteLock(str(shared_directory / "lock.db"), is_singleton=False)
+    lock.close()
+    (shared_directory / "lock.db").unlink()
+    (shared_directory / "lock.db").symlink_to(target)
+    with pytest.raises(OSError, match="changed while opening|not a regular file"):
+        _read_write._link_beside(str(shared_directory / "lock.db"), os.geteuid())
+    assert _link_directories(shared_directory) == []
+
+
+def test_links_of_a_dead_process_are_swept(
+    shared_directory: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(_read_write, "_SWEPT_DATABASES", set())
+    lock_path = shared_directory / "lock.db"
+    lock_path.write_bytes(b"")
+    digest = _read_write._host_digest(_read_write.host_name())
+    stale = shared_directory / f"{_read_write._LINK_PREFIX}999999999--{digest}-abcdef"
+    (stale / "inner").mkdir(parents=True)
+    os.link(lock_path, stale / "inner" / "lock.db")
+    foreign = shared_directory / f"{_read_write._LINK_PREFIX}999999999--{'0' * 16}-abcdef"
+    foreign.mkdir()
+    assert lock_path.stat().st_nlink == 2
+    lock = ReadWriteLock(str(lock_path), is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+    assert not stale.exists()
+    assert foreign.exists()
+    assert lock_path.stat().st_nlink == 1
+
+
+@pytest.mark.skipif(not hasattr(sqlite3.Connection, "setlimit"), reason="sqlite3.Connection.setlimit needs 3.11")
+@pytest.mark.parametrize("shared", [False, True])
+def test_oversized_schema_is_refused(tmp_path: Path, shared_directory: Path, *, shared: bool) -> None:
+    lock_path = (shared_directory if shared else tmp_path) / "lock.db"
+    columns = ", ".join(f"column_{index:04d}_{'x' * 40} INTEGER" for index in range(200))
+    with sqlite3.connect(lock_path) as connection:
+        connection.execute(f"CREATE TABLE big ({columns})")
+    connection.close()
+    lock = ReadWriteLock(str(lock_path), is_singleton=False)
+    with pytest.raises(ValueError, match="schema is too large"):
+        lock.acquire_read()
+    lock.close()
+    assert _link_directories(shared_directory) == []
