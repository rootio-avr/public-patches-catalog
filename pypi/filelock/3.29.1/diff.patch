+class _PrivateLink(NamedTuple):
+    path: pathlib.Path
+    identity: tuple[int, int]
+    name: str
+
+    @property
+    def database(self) -> pathlib.Path:
+        return self.path / self.name / "lock.db"
+
+
+def _names_are_private(directory: pathlib.Path) -> bool:
+    status = os.lstat(directory)
+    # Group or other write lets another account create a name here, sticky bit included.
+    return status.st_uid in {os.geteuid(), 0} and not status.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
+
+
+def _private_hard_link(database: str, identity: tuple[int, int]) -> _PrivateLink:
+    """Hard-link *database* into a 0700 directory and return that link.
+
+    SQLite opens the path it is given and derives ``-journal``, ``-wal`` and ``-shm`` beside it. A check of those
+    names before the statement can be won by a writer of the parent directory, so the statement runs against a path
+    only this account can create names in.
+    """
+    parent = pathlib.Path(database).parent
+    path = pathlib.Path(tempfile.mkdtemp(prefix=".filelock-", dir=parent))
+    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
+    fd = os.open(path, flags)
+    link: _PrivateLink | None = None
+    try:
+        made = os.fstat(fd)
+        if made.st_uid not in {os.geteuid(), 0} or made.st_mode & 0o077:
+            msg = f"link directory {os.fspath(path)!r} was replaced while opening"
+            raise OSError(msg)
+        link = _PrivateLink(path, (made.st_dev, made.st_ino), secrets.token_hex(8))
+        os.mkdir(link.name, 0o700, dir_fd=fd)
+        os.link(database, link.database, follow_symlinks=False)
+        linked = link.database.stat(follow_symlinks=False)
+        if not stat.S_ISREG(linked.st_mode) or (linked.st_dev, linked.st_ino) != identity:
+            msg = f"lock database changed while opening: {database!r}"
+            raise OSError(msg)
+    except BaseException:
+        os.close(fd)
+        if link is None:
+            with suppress(OSError):
+                path.rmdir()
+        else:
+            _remove_private_link(link)
+        raise
+    os.close(fd)
+    return link
+
+
+def _remove_private_link(link: _PrivateLink) -> None:
+    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        fd = os.open(link.path, flags)
+    except OSError:
+        return
+    try:
+        opened = os.fstat(fd)
+        if (opened.st_dev, opened.st_ino) != link.identity:
+            return
+        try:
+            nested = os.open(link.name, flags, dir_fd=fd)
+        except OSError:
+            nested = -1
+        if nested != -1:
+            try:
+                for suffix in ("", "-journal", "-wal", "-shm"):
+                    with suppress(FileNotFoundError):
+                        os.unlink(f"lock.db{suffix}", dir_fd=nested)
+            finally:
+                os.close(nested)
+            with suppress(OSError):
+                os.rmdir(link.name, dir_fd=fd)
+    finally:
+        os.close(fd)
+    with suppress(OSError):
+        link.path.rmdir()
+
+
+@contextmanager
+def _pin_database_against_reparse(database: str) -> Generator[None]:
+    """On Windows, refuse a reparse point and hold the name across ``sqlite3.connect``."""
+    if sys.platform != "win32":
+        yield
+        return
+    handle = _windows_open_without_following(database)
+    try:
+        yield
+    finally:
+        _windows_close(handle)
+
+
+def _windows_open_without_following(database: str) -> int:
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel32.CreateFileW.restype = wintypes.HANDLE
+    kernel32.CreateFileW.argtypes = (
+        wintypes.LPCWSTR,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        ctypes.c_void_p,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.HANDLE,
+    )
+    kernel32.GetFileInformationByHandle.argtypes = (wintypes.HANDLE, ctypes.c_void_p)
+    kernel32.GetFileInformationByHandle.restype = wintypes.BOOL
+
+    class _FileTime(ctypes.Structure):
+        _fields_ = [("dwLowDateTime", wintypes.DWORD), ("dwHighDateTime", wintypes.DWORD)]
+
+    class _ByHandle(ctypes.Structure):
+        _fields_ = [
+            ("dwFileAttributes", wintypes.DWORD),
+            ("ftCreationTime", _FileTime),
+            ("ftLastAccessTime", _FileTime),
+            ("ftLastWriteTime", _FileTime),
+            ("dwVolumeSerialNumber", wintypes.DWORD),
+            ("nFileSizeHigh", wintypes.DWORD),
+            ("nFileSizeLow", wintypes.DWORD),
+            ("nNumberOfLinks", wintypes.DWORD),
+            ("nFileIndexHigh", wintypes.DWORD),
+            ("nFileIndexLow", wintypes.DWORD),
+        ]
+
+    # OPEN_ALWAYS (4) creates a normal file when the name is missing. FILE_FLAG_OPEN_REPARSE_POINT (0x00200000) makes a
+    # symlink the file we see. Share mode is read|write and omits delete, so the name cannot be swapped while held.
+    handle = kernel32.CreateFileW(database, 0x80000000, 0x00000003, None, 4, 0x00200000, None)
+    invalid = ctypes.c_void_p(-1).value
+    if handle is None or handle == invalid:
+        raise ctypes.WinError(ctypes.get_last_error())
+    info = _ByHandle()
+    if not kernel32.GetFileInformationByHandle(handle, ctypes.byref(info)):
+        error = ctypes.get_last_error()
+        kernel32.CloseHandle(handle)
+        raise ctypes.WinError(error)
+    if info.dwFileAttributes & 0x00000400:
+        kernel32.CloseHandle(handle)
+        msg = f"refusing a reparse point as a lock database: {database!r}"
+        raise OSError(msg)
+    return handle
+
+
+def _windows_close(handle: int) -> None:
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel32.CloseHandle.argtypes = (wintypes.HANDLE,)
+    kernel32.CloseHandle(handle)
 
 
