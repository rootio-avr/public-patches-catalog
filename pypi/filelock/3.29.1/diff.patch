+++ b/tests/test_cve_2026_112940.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+import os
+import sqlite3
+import sys
+from typing import TYPE_CHECKING
+
+import pytest
+
+pytest.importorskip("sqlite3")
+
+from filelock._read_write import ReadWriteLock
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+posix_only = pytest.mark.skipif(sys.platform == "win32", reason="symlinks and inode identity are POSIX-specific")
+
+
+@pytest.fixture(autouse=True)
+def _clear_singleton_cache() -> None:
+    ReadWriteLock._instances.clear()
+
+
+@posix_only
+def test_symlinked_lock_database_is_refused(tmp_path: Path) -> None:
+    victim = tmp_path / "victim.txt"
+    victim.write_text("precious")
+    link = tmp_path / "lock.db"
+    link.symlink_to(victim)
+    with pytest.raises(OSError):  # noqa: PT011
+        ReadWriteLock(str(link), is_singleton=False)
+    assert victim.read_text() == "precious"
+
+
+@posix_only
+def test_non_regular_lock_database_is_refused(tmp_path: Path) -> None:
+    fifo = tmp_path / "lock.db"
+    os.mkfifo(fifo)
+    with pytest.raises(OSError):  # noqa: PT011
+        ReadWriteLock(str(fifo), is_singleton=False)
+
+
+@posix_only
+def test_symlinked_journal_side_file_is_refused(tmp_path: Path) -> None:
+    victim = tmp_path / "victim.txt"
+    victim.write_text("precious")
+    db = tmp_path / "lock.db"
+    (tmp_path / "lock.db-journal").symlink_to(victim)
+    with pytest.raises(OSError):  # noqa: PT011
+        ReadWriteLock(str(db), is_singleton=False)
+    assert victim.read_text() == "precious"
+
+
+@posix_only
+def test_replaced_lock_database_is_refused_on_acquire(tmp_path: Path) -> None:
+    db = tmp_path / "lock.db"
+    lock = ReadWriteLock(str(db), is_singleton=False)
+    try:
+        db.unlink()
+        db.write_bytes(b"")
+        with pytest.raises(OSError, match="replaced"):
+            lock.acquire_write(timeout=1)
+        assert lock._lock_level == 0
+    finally:
+        lock.close()
+
+
+def test_regular_lock_database_still_works(tmp_path: Path) -> None:
+    lock = ReadWriteLock(str(tmp_path / "lock.db"), is_singleton=False)
+    try:
+        with lock.read_lock():
+            assert lock._current_mode == "read"
+        with lock.write_lock():
+            assert lock._current_mode == "write"
+    finally:
+        lock.close()
+
+
+def test_oversized_schema_is_refused(tmp_path: Path) -> None:
+    db = tmp_path / "lock.db"
+    con = sqlite3.connect(db)
+    con.execute("CREATE TABLE t (a)")
+    for i in range(2000):
+        con.execute(f"CREATE TABLE table_with_a_long_name_{i} (column_one, column_two, column_three)")
+    con.commit()
+    con.close()
+    lock = ReadWriteLock(str(db), is_singleton=False)
+    try:
+        with pytest.raises(ValueError, match="schema is too large"):
+            lock.acquire_read(timeout=5)
+        assert lock._lock_level == 0
+    finally:
+        lock.close()
