+_DB_OPEN_FLAGS = (
+    os.O_RDWR
+    | os.O_CREAT
+    | getattr(os, "O_NOFOLLOW", 0)
+    | getattr(os, "O_NONBLOCK", 0)
+    | getattr(os, "O_CLOEXEC", 0)
+    | getattr(os, "O_BINARY", 0)
+)
+_SIDE_FILE_SUFFIXES = ("-journal", "-wal", "-shm")
+_SCHEMA_STEP_BUDGET = 10  # progress-handler calls (1000 VM steps each) allowed while the schema loads
+_SCHEMA_MAX_LENGTH = 4096
+
+
+def _open_lock_database(database: str) -> tuple[int, int] | None:
+    """
+    Create (if needed) and vet the lock database, returning its ``(st_dev, st_ino)`` identity.
+
+    The name is opened without following a symlink and must be a regular file, so SQLite is never pointed at a
+    redirected or special file. The identity is ``None`` on Windows, where SQLite's open handle already pins the name.
+
+    """
+    fd = os.open(database, _DB_OPEN_FLAGS, 0o644)
+    try:
+        info = os.fstat(fd)
+    finally:
+        os.close(fd)
+    if not stat.S_ISREG(info.st_mode):
+        msg = f"refusing a non-regular lock database: {database!r}"
+        raise OSError(msg)
+    return None if sys.platform == "win32" else (info.st_dev, info.st_ino)
+
+
+def _raise_if_unsafe_side_files(database: str) -> None:
+    # SQLite derives -journal/-wal/-shm names from the database name and acts on whatever those names hold: a hot
+    # journal is replayed into the database and a symlink is followed. None of them exists for a healthy lock database.
+    for suffix in _SIDE_FILE_SUFFIXES:
+        side = f"{database}{suffix}"
+        try:
+            info = os.lstat(side)
+        except FileNotFoundError:
+            continue
+        if not stat.S_ISREG(info.st_mode) or (suffix != "-shm" and info.st_size > 0):
+            msg = f"refusing lock database {database!r}: unexpected SQLite side file {side!r}"
+            raise OSError(msg)
+
+
+def _raise_if_database_replaced(database: str, identity: tuple[int, int] | None) -> None:
+    if identity is None:
+        return
+    try:
+        current = os.lstat(database)
+    except FileNotFoundError:
+        current = None
+    # The lock lives on the inode, so one taken after the name moved on excludes no later opener.
+    if current is None or (current.st_dev, current.st_ino) != identity:
+        msg = f"lock database {database!r} was unlinked or replaced; leave it in place"
+        raise OSError(msg)
+
+
+@contextmanager
+def _bounded_schema(connection: sqlite3.Connection, database: str) -> Generator[None]:
+    # The first statement loads the file's complete schema, which no timeout bounds, and a lock database has none.
+    # Waiting for a lock runs no virtual machine steps, so a step budget bounds only that load.
+    calls = count()
+    # Connection.setlimit is 3.11+; the progress handler alone still bounds the load on 3.10.
+    if hasattr(connection, "setlimit"):
+        connection.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, _SCHEMA_MAX_LENGTH)
+    connection.set_progress_handler(lambda: next(calls) >= _SCHEMA_STEP_BUDGET, 1000)
+    try:
+        yield
+    except sqlite3.DatabaseError as error:
+        # An interrupted schema load reports a malformed schema rather than the interrupt.
+        if isinstance(error, sqlite3.DataError) or next(calls) > _SCHEMA_STEP_BUDGET:
+            msg = (
+                f"refusing a lock database whose schema is too large to load: {database!r}; "
+                "give ReadWriteLock a file of its own"
+            )
+            raise ValueError(msg) from error
+        raise
+    finally:
+        connection.set_progress_handler(None, 0)
+
