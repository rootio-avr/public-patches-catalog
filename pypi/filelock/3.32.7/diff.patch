+def _names_are_private(directory: pathlib.Path, owner: int) -> bool:
+    try:
+        status: Final = os.lstat(directory)
+    except OSError:
+        return True  # SQLite reports the unusable directory itself
+    # The sticky bit still lets others create names, so a directory anyone else may write to never qualifies.
+    return (
+        stat.S_ISDIR(status.st_mode)
+        and status.st_uid in {owner, 0}
+        and not status.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
     )
