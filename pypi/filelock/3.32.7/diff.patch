+from __future__ import annotations
+
+import os
+import sqlite3
+import sys
+from typing import TYPE_CHECKING
+
+import pytest
+
+from filelock import ReadWriteLock, Timeout
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="POSIX name handling")
+
+
+def _record_connects(monkeypatch: pytest.MonkeyPatch) -> list[str]:
+    targets: list[str] = []
+    real_connect = sqlite3.connect
+
+    def connect(database: str, *args: object, **kwargs: object) -> sqlite3.Connection:
+        targets.append(os.fspath(database))
+        return real_connect(database, *args, **kwargs)  # type: ignore[arg-type]
+
+    monkeypatch.setattr(sqlite3, "connect", connect)
+    return targets
+
+
+@pytest.fixture
+def shared_directory(tmp_path: Path) -> Path:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)
+    return directory
+
+
+def test_private_directory_opens_database_by_name(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    directory = tmp_path / "private"
+    directory.mkdir(mode=0o700)
+    database = directory / "lock.db"
+    targets = _record_connects(monkeypatch)
+
+    lock = ReadWriteLock(database, is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+
+    assert targets
+    assert set(targets) == {str(database)}
+    assert [entry.name for entry in directory.iterdir()] == ["lock.db"]
+
+
+def test_shared_directory_opens_private_link_not_shared_name(
+    shared_directory: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    database = shared_directory / "lock.db"
+    targets = _record_connects(monkeypatch)
+
+    lock = ReadWriteLock(database, is_singleton=False)
+    with lock.write_lock():
+        assert str(database) not in targets
+        link = next(shared_directory.glob(".filelock-*"))
+        assert link.is_dir()
+        assert (link.stat().st_mode & 0o077) == 0
+        assert targets[-1].startswith(str(shared_directory / ".filelock-"))
+        assert os.stat(targets[-1]).st_ino == database.stat().st_ino
+    lock.close()
+
+    assert str(database) not in targets
+    assert sorted(entry.name for entry in shared_directory.iterdir()) == ["lock.db"]
+
+
+def test_shared_directory_ignores_planted_journal(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    journal = shared_directory / "lock.db-journal"
+    journal.write_bytes(b"not a journal of this lock" * 8)
+    planted = journal.read_bytes()
+
+    lock = ReadWriteLock(database, is_singleton=False)
+    with lock.write_lock():
+        pass
+    with lock.read_lock():
+        pass
+    lock.close()
+
+    assert journal.read_bytes() == planted
+
+
+def test_shared_directory_does_not_follow_planted_symlink(tmp_path: Path, shared_directory: Path) -> None:
+    victim = tmp_path / "victim"
+    victim.write_bytes(b"precious")
+    database = shared_directory / "lock.db"
+    lock = ReadWriteLock(database, is_singleton=False)
+    database.unlink()
+    database.symlink_to(victim)
+
+    with pytest.raises(OSError, match="not a regular file"):
+        lock.acquire_write()
+
+    lock.close()
+    assert victim.read_bytes() == b"precious"
+    assert sorted(entry.name for entry in shared_directory.iterdir()) == ["lock.db"]
+
+
+def test_shared_directory_detects_replaced_database(shared_directory: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    database = shared_directory / "lock.db"
+    lock = ReadWriteLock(database, is_singleton=False)
+    real_connect = sqlite3.connect
+
+    def connect_then_replace(target: str, *args: object, **kwargs: object) -> sqlite3.Connection:
+        connection = real_connect(target, *args, **kwargs)  # type: ignore[arg-type]
+        database.unlink()
+        database.write_bytes(b"")
+        return connection
+
+    monkeypatch.setattr(sqlite3, "connect", connect_then_replace)
+    with pytest.raises(OSError, match="unlinked or replaced"):
+        lock.acquire_write()
+    monkeypatch.undo()
+
+    lock.close()
+    assert sorted(entry.name for entry in shared_directory.iterdir()) == ["lock.db"]
+
+
+def test_shared_directory_excludes_across_instances(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    writer = ReadWriteLock(database, is_singleton=False)
+    reader = ReadWriteLock(database, is_singleton=False)
+    with writer.write_lock():
+        with pytest.raises(Timeout):
+            reader.acquire_read(blocking=False)
+    with reader.read_lock():
+        pass
+    writer.close()
+    reader.close()
+
+
+@pytest.mark.skipif(not hasattr(sqlite3.Connection, "setlimit"), reason="needs sqlite3.Connection.setlimit")
+def test_oversized_schema_is_refused(tmp_path: Path) -> None:
+    database = tmp_path / "lock.db"
+    with sqlite3.connect(database) as connection:
+        columns = ", ".join(f"column_{index} INTEGER" for index in range(600))
+        connection.execute(f"CREATE TABLE big ({columns})")
+    connection.close()
+
+    lock = ReadWriteLock(database, is_singleton=False)
+    with pytest.raises(ValueError, match="schema is too large"):
+        lock.acquire_read()
+    lock.close()
