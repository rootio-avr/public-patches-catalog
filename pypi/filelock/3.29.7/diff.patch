+_DB_OPEN_FLAGS = os.O_RDWR | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
+_DIRECTORY_FLAGS = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
+_LINK_PREFIX = ".filelock-"
+_LINK_NAME = "lock.db"
+_LINK_NAME_PARTS = 3  # <pid>-<host digest>-<random>
+_SWEPT_DATABASES: set[tuple[int, int]] = set()
+
+
+class _LinkDirectory(NamedTuple):
+    path: pathlib.Path
+    identity: tuple[int, int]
+    # Made through a descriptor of path, which nobody else can list, so a directory another process swaps in under
+    # path cannot hold this name and SQLite fails to open instead of following the swap.
+    name: str
+    pid: int
+
+    @property
+    def database(self) -> pathlib.Path:
+        return self.path / self.name / _LINK_NAME
+
+
+_all_links: dict[sqlite3.Connection, _LinkDirectory] = {}
+
+
+def _discard_link(con: sqlite3.Connection) -> None:
+    if (link := _all_links.pop(con, None)) is not None:
+        _remove_link_directory(link)
+
+
+def _host_digest() -> str:
+    return hashlib.sha256(socket.gethostname().encode()).hexdigest()[:16]
+
+
+def _names_are_private(directory: pathlib.Path) -> bool:
+    # SQLite opens the name it is given, following symlinks, and uses the -journal, -wal and -shm names beside it, so
+    # the database name is safe only where no other account can create names. The sticky bit still lets others create
+    # names, so a directory anyone else may write to never qualifies.
+    status = os.lstat(directory)
+    return status.st_uid in {os.geteuid(), 0} and not status.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
+
+
+def _connect(database: str) -> tuple[sqlite3.Connection, _LinkDirectory | None]:
+    if sys.platform == "win32" or not hasattr(os, "geteuid"):
+        return sqlite3.connect(database, check_same_thread=False), None
+    try:
+        private = _names_are_private(pathlib.Path(database).parent)
+    except OSError:
+        private = True  # let SQLite report the unusable directory the way it always has
+    if private:
+        return sqlite3.connect(database, check_same_thread=False), None
+    link = _link_beside(database)
+    try:
+        return sqlite3.connect(os.fspath(link.database), check_same_thread=False), link
+    except BaseException:
+        _remove_link_directory(link)
+        raise
+
+
+def _link_beside(database: str) -> _LinkDirectory:
+    # Beside the database because a hard link cannot cross filesystems, and TMPDIR is often on another one.
+    parent = pathlib.Path(database).parent
+    owner = os.geteuid()
+    prefix = f"{_LINK_PREFIX}{os.getpid()}-{_host_digest()}-"
+    path = pathlib.Path(tempfile.mkdtemp(prefix=prefix, dir=parent))
+    fd = os.open(path, _DIRECTORY_FLAGS)
+    try:
+        made = os.fstat(fd)
+        # Whoever can rename in the parent can put another directory under the new name before it opens.
+        if made.st_uid != owner or made.st_mode & 0o077:
+            msg = f"link directory {os.fspath(path)!r} was replaced while opening"
+            raise OSError(msg)
+        link = _LinkDirectory(path, (made.st_dev, made.st_ino), secrets.token_hex(8), os.getpid())
+        try:
+            os.mkdir(link.name, 0o700, dir_fd=fd)
+            _link_database(database, fd, f"{link.name}/{_LINK_NAME}")
+            linked = os.stat(f"{link.name}/{_LINK_NAME}", dir_fd=fd, follow_symlinks=False)
+            # A symlink or FIFO under the lock name would be followed or blocked on by SQLite, not locked.
+            if not stat.S_ISREG(linked.st_mode):
+                msg = f"lock database is not a regular file: {database!r}"
+                raise OSError(msg)
+        except BaseException:
+            _remove_link_directory(link)
+            raise
+    except BaseException:
+        os.close(fd)
+        with suppress(OSError):
+            path.rmdir()
+        raise
+    os.close(fd)
+    _sweep_links_of_the_dead(parent, (linked.st_dev, linked.st_ino), owner)
+    return link
+
+
+def _link_database(database: str, dir_fd: int, name: str) -> None:
+    try:
+        try:
+            os.link(database, name, dst_dir_fd=dir_fd, follow_symlinks=False)
+        except FileNotFoundError:
+            # Create the database as SQLite would, but never through a symlink and never over an existing file.
+            with suppress(FileExistsError):
+                os.close(os.open(database, _DB_OPEN_FLAGS, 0o644))
+            os.link(database, name, dst_dir_fd=dir_fd, follow_symlinks=False)
+    except NotImplementedError as exc:  # hard links that do not honor follow_symlinks
+        msg = f"cannot link the lock database {database!r} on this platform"
+        raise OSError(msg) from exc
+
+
+def _sweep_links_of_the_dead(parent: pathlib.Path, identity: tuple[int, int], owner: int) -> None:
+    # A process killed while it held a link leaves the directory, and an extra link to the database, behind for good.
+    if identity in _SWEPT_DATABASES:
+        return
+    _SWEPT_DATABASES.add(identity)
+    try:
+        with os.scandir(parent) as entries:
+            names = [e.name for e in entries if e.name.startswith(_LINK_PREFIX) and e.is_dir(follow_symlinks=False)]
+    except OSError:
+        return
+    for name in names:
+        # A peer sweeping alongside, or a directory this user cannot remove, must not fail the connect.
+        with suppress(OSError):
+            _remove_dead_links(parent / name, identity, owner)
+
+
+def _owner_is_gone(name: str) -> bool:
+    # A peer can plant a malformed name; leave it untouched rather than probing a forged PID during acquisition.
+    parts = name.removeprefix(_LINK_PREFIX).split("-")
+    if len(parts) != _LINK_NAME_PARTS or not (parts[0].isascii() and parts[0].isdigit()) or parts[1] != _host_digest():
+        return False
+    try:
+        os.kill(int(parts[0]), 0)
+    except ProcessLookupError:
+        return True
+    except (PermissionError, OverflowError, ValueError):
+        return False
+    return False
+
+
+def _remove_dead_links(path: pathlib.Path, identity: tuple[int, int], owner: int) -> None:
+    # Any directory can carry a dead holder's name after a rename in the parent, so only hard links to this database
+    # go, and the directory only once that leaves it empty.
+    fd = os.open(path, _DIRECTORY_FLAGS)
+    try:
+        # Only a directory this account made carries a holder of its own.
+        if os.fstat(fd).st_uid != owner or not _owner_is_gone(path.name):
+            return
+        with os.scandir(fd) as entries:
+            names = [entry.name for entry in entries]
+        for entry in names:
+            try:
+                nested = os.open(entry, _DIRECTORY_FLAGS, dir_fd=fd)
+            except OSError:
+                continue
+            try:
+                with suppress(OSError):
+                    linked = os.stat(_LINK_NAME, dir_fd=nested, follow_symlinks=False)
+                    if (linked.st_dev, linked.st_ino) == identity:
+                        os.unlink(_LINK_NAME, dir_fd=nested)
+            finally:
+                os.close(nested)
+            with suppress(OSError):
+                os.rmdir(entry, dir_fd=fd)
+    finally:
+        os.close(fd)
+    with suppress(OSError):
+        path.rmdir()
+
+
+def _remove_link_directory(link: _LinkDirectory) -> None:
+    if link.pid != os.getpid():
+        return  # a forked child shares the parent's link, which the parent still uses
+    # A rename in the parent may have put any directory under this name, so entries go through a descriptor checked
+    # to be the directory made, and the name goes only through rmdir, which refuses a non-empty directory.
+    try:
+        fd = os.open(link.path, _DIRECTORY_FLAGS)
+    except OSError:
+        return
+    try:
+        opened = os.fstat(fd)
+        if (opened.st_dev, opened.st_ino) != link.identity:
+            return
+        for suffix in ("", "-journal", "-wal", "-shm"):
+            with suppress(FileNotFoundError):
+                os.unlink(f"{link.name}/{_LINK_NAME}{suffix}", dir_fd=fd)
+        with suppress(FileNotFoundError):
+            os.rmdir(link.name, dir_fd=fd)
+    finally:
+        os.close(fd)
+    # The link is gone, so a failure here leaves one stray empty directory and is not worth failing a release for.
+    with suppress(OSError):
+        link.path.rmdir()
+
+
+@contextmanager
+def _bounded_schema(connection: sqlite3.Connection, database: str) -> Generator[None]:
+    # The first statement loads the file's complete schema, which no timeout bounds, and a lock database has none.
+    # Waiting for a lock runs no virtual machine steps, so a step budget bounds only that load.
+    calls = count()
+    max_calls = 10
+    if hasattr(connection, "setlimit"):  # Python 3.11+
+        connection.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, 4096)
+    connection.set_progress_handler(lambda: next(calls) >= max_calls, 1000)
+    try:
+        yield
+    except sqlite3.DatabaseError as error:
+        # An interrupted schema load reports a malformed schema rather than the interrupt.
+        if isinstance(error, sqlite3.DataError) or next(calls) > max_calls:
+            # A read acquire may have begun its transaction already; end it so the next acquire can start one.
+            with suppress(sqlite3.Error):
+                connection.rollback()
+            msg = (
+                f"refusing a lock database whose schema is too large to load: {database!r}; "
+                "give ReadWriteLock a file of its own"
+            )
+            raise ValueError(msg) from error
+        raise
+    finally:
+        connection.set_progress_handler(None, 0)
+
