+from __future__ import annotations
+
+import os
+import sqlite3
+import stat
+import sys
+from typing import TYPE_CHECKING
+
+import pytest
+
+pytest.importorskip("sqlite3")
+
+from filelock._read_write import ReadWriteLock, _all_links, _names_are_private
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="POSIX directory permissions")
+
+
+@pytest.fixture
+def shared_directory(tmp_path: Path) -> Path:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)  # other accounts can create names here, as in a shared /tmp
+    return directory
+
+
+def test_names_are_private_rejects_writable_directory(tmp_path: Path, shared_directory: Path) -> None:
+    private = tmp_path / "private"
+    private.mkdir(mode=0o755)
+
+    assert _names_are_private(private)
+    assert not _names_are_private(shared_directory)
+    shared_directory.chmod(0o1777)  # the sticky bit still lets others create names
+    assert not _names_are_private(shared_directory)
+
+
+def test_private_directory_connects_by_name(tmp_path: Path) -> None:
+    directory = tmp_path / "private"
+    directory.mkdir(mode=0o700)
+    lock = ReadWriteLock(directory / "lock.db", is_singleton=False)
+    try:
+        assert lock._con not in _all_links
+        with lock.write_lock():
+            assert {p.name for p in directory.iterdir()} == {"lock.db"}
+    finally:
+        lock.close()
+
+
+def test_shared_directory_keeps_sqlite_off_the_shared_names(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    lock = ReadWriteLock(database, is_singleton=False)
+    try:
+        link = _all_links[lock._con]
+        assert link.database != database
+        assert link.database.parent.parent == link.path
+        assert not stat.S_IMODE(link.path.stat().st_mode) & 0o077
+        assert link.database.stat().st_ino == database.stat().st_ino  # a second name for the same file
+        with lock.write_lock():
+            # SQLite works beside the link, so nothing appears under the shared journal, WAL or shared-memory names
+            assert {p.name for p in shared_directory.iterdir()} == {"lock.db", link.path.name}
+        with lock.read_lock():
+            pass
+    finally:
+        lock.close()
+
+    assert not link.path.exists()
+    assert {p.name for p in shared_directory.iterdir()} == {"lock.db"}
+
+
+def test_shared_directory_still_excludes_other_instances(shared_directory: Path) -> None:
+    from filelock import Timeout  # noqa: PLC0415
+
+    database = shared_directory / "lock.db"
+    writer = ReadWriteLock(database, is_singleton=False)
+    reader = ReadWriteLock(database, is_singleton=False)
+    try:
+        with writer.write_lock():
+            with pytest.raises(Timeout):
+                reader.acquire_read(timeout=0.2)
+            with pytest.raises(Timeout):
+                reader.acquire_write(blocking=False)
+        with reader.read_lock():
+            pass
+    finally:
+        reader.close()
+        writer.close()
+
+
+def test_shared_directory_ignores_a_planted_journal_symlink(shared_directory: Path, tmp_path: Path) -> None:
+    victim = tmp_path / "victim.txt"
+    victim.write_bytes(b"precious")
+    database = shared_directory / "lock.db"
+    sqlite3.connect(database).close()
+    for suffix in ("-journal", "-wal", "-shm"):
+        (shared_directory / f"lock.db{suffix}").symlink_to(victim)
+
+    lock = ReadWriteLock(database, is_singleton=False)
+    try:
+        with lock.write_lock():
+            pass
+        with lock.read_lock():
+            pass
+    finally:
+        lock.close()
+
+    assert victim.read_bytes() == b"precious"
+    assert all((shared_directory / f"lock.db{s}").is_symlink() for s in ("-journal", "-wal", "-shm"))
+
+
+def test_shared_directory_refuses_a_symlinked_database(shared_directory: Path, tmp_path: Path) -> None:
+    victim = tmp_path / "victim.txt"
+    victim.write_bytes(b"precious")
+    (shared_directory / "lock.db").symlink_to(victim)
+
+    with pytest.raises(OSError, match="regular file"):
+        ReadWriteLock(shared_directory / "lock.db", is_singleton=False)
+
+    assert victim.read_bytes() == b"precious"
+    assert {p.name for p in shared_directory.iterdir()} == {"lock.db"}
+
+
+def test_shared_directory_sweeps_links_of_a_dead_process(shared_directory: Path) -> None:
+    from filelock import _read_write  # noqa: PLC0415
+
+    database = shared_directory / "lock.db"
+    sqlite3.connect(database).close()
+    dead_pid = 2**22 + 12345  # above the default pid_max of every common system
+    stale = shared_directory / f".filelock-{dead_pid}-{_read_write._host_digest()}-stale"
+    stale.mkdir(mode=0o700)
+    (stale / "nested").mkdir(mode=0o700)
+    os.link(database, stale / "nested" / "lock.db")
+    _read_write._SWEPT_DATABASES.clear()
+
+    lock = ReadWriteLock(database, is_singleton=False)
+    try:
+        assert not stale.exists()
+        assert database.stat().st_nlink == 2  # the database name and this lock's own link
+    finally:
+        lock.close()
+
+
+@pytest.mark.skipif(not hasattr(sqlite3.Connection, "setlimit"), reason="needs Python 3.11+")
+@pytest.mark.parametrize("mode", ["read", "write"])
+def test_schema_larger_than_a_lock_needs_is_refused(tmp_path: Path, mode: str) -> None:
+    database = tmp_path / "lock.db"
+    with sqlite3.connect(database) as connection:
+        connection.execute(f"CREATE TABLE big ({','.join(f'column_number_{i}' for i in range(400))})")
+    connection.close()
+    lock = ReadWriteLock(database, is_singleton=False)
+    try:
+        with pytest.raises(ValueError, match="schema"):
+            (lock.acquire_read if mode == "read" else lock.acquire_write)(timeout=1)
+        assert not lock._con.in_transaction
+    finally:
+        lock.close()
