+def _create_or_check_database(database: str) -> _DatabaseIdentity:
+    # No descriptor stays open on the file: closing any descriptor of an inode would drop the POSIX locks SQLite holds
+    # on it in this process, so the file is only inspected by name, and created exclusively when it is missing.
+    try:
+        status = os.lstat(database)
+    except FileNotFoundError:
+        try:
+            os.close(os.open(database, _CREATE_FLAGS, 0o600))
+        except FileExistsError:
+            pass
+        status = os.lstat(database)
+    # A symlink would make SQLite open, lock, or create its target; a FIFO or device would hang or misbehave.
+    if not stat.S_ISREG(status.st_mode):
+        msg = f"refusing a non-regular lock database: {database!r}"
+        raise OSError(msg)
+    return status.st_dev, status.st_ino
+
