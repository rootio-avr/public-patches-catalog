+from __future__ import annotations
+
+import os
+import sqlite3
+import sys
+from typing import TYPE_CHECKING
+
+import pytest
+
+pytest.importorskip("sqlite3")
+
+from filelock import ReadWriteLock
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from pytest_mock import MockerFixture
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="SQLite is opened by name on Windows")
+
+
+def _record_connect_targets(mocker: MockerFixture) -> list[str]:
+    targets: list[str] = []
+    real_connect = sqlite3.connect
+
+    def connect(database: str, *args: object, **kwargs: object) -> sqlite3.Connection:
+        targets.append(os.fspath(database))
+        return real_connect(database, *args, **kwargs)  # type: ignore[arg-type]
+
+    mocker.patch("sqlite3.connect", side_effect=connect)
+    return targets
+
+
+def test_private_directory_names_the_database_directly(tmp_path: Path, mocker: MockerFixture) -> None:
+    directory = tmp_path / "private"
+    directory.mkdir(mode=0o700)
+    database = directory / "lock.db"
+    targets = _record_connect_targets(mocker)
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.write_lock():
+        assert not any(name.startswith(".filelock-") for name in os.listdir(directory))
+    lock.close()
+
+    assert targets
+    assert set(targets) == {os.fspath(database.resolve())}
+
+
+def test_shared_directory_is_refused(tmp_path: Path, mocker: MockerFixture) -> None:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)
+    database = directory / "lock.db"
+    connect = mocker.spy(sqlite3, "connect")
+
+    with pytest.raises(OSError, match="other accounts can write"):
+        ReadWriteLock(str(database), is_singleton=False).acquire_write()
+
+    assert not connect.called
+    assert not any(name.startswith(".filelock-") for name in os.listdir(directory))
+
+
+def test_shared_directory_side_files_are_refused_and_untouched(tmp_path: Path) -> None:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)
+    victim = tmp_path / "victim"
+    victim.write_bytes(b"precious")
+    for suffix in ("-journal", "-wal", "-shm"):
+        (directory / f"lock.db{suffix}").symlink_to(victim)
+
+    with pytest.raises(OSError, match="other accounts can write"):
+        ReadWriteLock(str(directory / "lock.db"), is_singleton=False).acquire_write()
+
+    assert victim.read_bytes() == b"precious"
+    for suffix in ("-journal", "-wal", "-shm"):
+        assert (directory / f"lock.db{suffix}").is_symlink()
+
+
+def test_symlink_swapped_in_for_the_database_is_refused(tmp_path: Path) -> None:
+    database = tmp_path / "lock.db"
+    victim = tmp_path / "victim"
+    victim.write_bytes(b"precious")
