+        check_same_thread: bool,
+        factory: type[sqlite3.Connection],
+        cached_statements: int,
+        timeout: float,
+    ) -> sqlite3.Connection:
+        private.rename(moved)
+        private.mkdir(mode=0o700)
+        if replacement == "symlink":
+            (private / "lock.db").symlink_to(tmp_path / "elsewhere.txt")
+        else:
