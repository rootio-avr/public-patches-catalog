+from __future__ import annotations
+
+import os
+import sqlite3
+import sys
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+import pytest
+
+pytest.importorskip("sqlite3")
+
+from filelock import ReadWriteLock
+
+if TYPE_CHECKING:
+    from pytest_mock import MockerFixture
+
+pytestmark = [
+    pytest.mark.skipif(sys.platform == "win32", reason="SQLite is opened by name on Windows"),
+]
+
+
+@pytest.fixture
+def private_database(tmp_path: Path) -> Path:
+    directory = tmp_path / "private"
+    directory.mkdir(mode=0o700)
+    directory.chmod(0o700)
+    return directory / "lock.db"
+
+
+@pytest.fixture
+def shared_database(tmp_path: Path) -> Path:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)
+    return directory / "lock.db"
+
+
+def test_private_directory_connects_by_name(private_database: Path, mocker: MockerFixture) -> None:
+    connect = mocker.spy(sqlite3, "connect")
+    with ReadWriteLock(private_database, is_singleton=False).read_lock():
+        assert Path(connect.call_args.args[0]) == private_database
+        assert list(private_database.parent.glob(".filelock-*")) == []
+
+
+def test_shared_directory_is_refused(shared_database: Path, mocker: MockerFixture) -> None:
+    connect = mocker.spy(sqlite3, "connect")
+    with pytest.raises(OSError, match="other accounts can write"):
+        ReadWriteLock(shared_database, is_singleton=False).acquire_read()
+    assert not connect.called
+    assert list(shared_database.parent.glob(".filelock-*")) == []
+
+
+def test_shared_directory_side_files_are_refused_and_untouched(shared_database: Path, tmp_path: Path) -> None:
+    victim = tmp_path / "victim.txt"
+    victim.write_text("keep")
+    for suffix in ("-journal", "-wal", "-shm"):
+        Path(f"{shared_database}{suffix}").symlink_to(victim)
+    with pytest.raises(OSError, match="other accounts can write"):
+        ReadWriteLock(shared_database, is_singleton=False).acquire_write()
+    assert victim.read_text() == "keep"
+    assert all(Path(f"{shared_database}{suffix}").is_symlink() for suffix in ("-journal", "-wal", "-shm"))
+
+
+def test_refuses_a_database_swapped_while_acquiring(private_database: Path, mocker: MockerFixture) -> None:
+    lock = ReadWriteLock(private_database, is_singleton=False)
+    real_begin = ReadWriteLock._raise_if_database_replaced  # noqa: SLF001
+    swapped = private_database.with_name("swapped.db")
+
+    def swap_then_check(self: ReadWriteLock, connection: object) -> None:
+        if not swapped.exists():
+            swapped.touch()
+            swapped.replace(private_database)
+        real_begin(self, connection)  # type: ignore[arg-type]
+
+    mocker.patch.object(ReadWriteLock, "_raise_if_database_replaced", swap_then_check)
+    with pytest.raises(OSError, match="unlinked or replaced"):
+        lock.acquire_read()
+    lock.close()
+
+
+def test_refuses_a_database_with_an_oversized_schema(private_database: Path) -> None:
+    connection = sqlite3.connect(private_database)
+    for index in range(3000):
+        connection.execute(f"CREATE TABLE t{index} (a)")
+    connection.commit()
+    connection.close()
+    with pytest.raises(ValueError, match="schema is too large"):
+        ReadWriteLock(private_database, is_singleton=False).acquire_read()
+
+
+def test_refuses_a_wal_database(private_database: Path) -> None:
+    connection = sqlite3.connect(private_database)
+    connection.execute("PRAGMA journal_mode=WAL")
+    connection.execute("CREATE TABLE t (a)")
+    connection.commit()
+    connection.close()
+    with pytest.raises(ValueError, match="WAL-mode"):
+        ReadWriteLock(private_database, is_singleton=False)
