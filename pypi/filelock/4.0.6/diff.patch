+@contextmanager
+def _pin_database_against_reparse(database: str) -> Generator[None]:
+    """On Windows, refuse a reparse point and hold the name across ``sqlite3.connect``."""
+    if sys.platform != "win32":
+        yield
+        return
+    handle = _windows_open_without_following(database)
+    try:
+        yield
+    finally:
+        _windows_close(handle)
+
+
+def _windows_open_without_following(database: str) -> int:
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel32.CreateFileW.restype = wintypes.HANDLE
+    kernel32.CreateFileW.argtypes = (
+        wintypes.LPCWSTR,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        ctypes.c_void_p,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.HANDLE,
+    )
+    kernel32.GetFileInformationByHandle.argtypes = (wintypes.HANDLE, ctypes.c_void_p)
+    kernel32.GetFileInformationByHandle.restype = wintypes.BOOL
+
+    class _FileTime(ctypes.Structure):
+        _fields_ = [("dwLowDateTime", wintypes.DWORD), ("dwHighDateTime", wintypes.DWORD)]
+
+    class _ByHandle(ctypes.Structure):
+        _fields_ = [
+            ("dwFileAttributes", wintypes.DWORD),
+            ("ftCreationTime", _FileTime),
+            ("ftLastAccessTime", _FileTime),
+            ("ftLastWriteTime", _FileTime),
+            ("dwVolumeSerialNumber", wintypes.DWORD),
+            ("nFileSizeHigh", wintypes.DWORD),
+            ("nFileSizeLow", wintypes.DWORD),
+            ("nNumberOfLinks", wintypes.DWORD),
+            ("nFileIndexHigh", wintypes.DWORD),
+            ("nFileIndexLow", wintypes.DWORD),
+        ]
+
+    # OPEN_ALWAYS (4) creates a normal file when the name is missing. FILE_FLAG_OPEN_REPARSE_POINT (0x00200000) makes a
+    # symlink the file we see. Share mode is read|write and omits delete, so the name cannot be swapped while held.
+    handle = kernel32.CreateFileW(database, 0x80000000, 0x00000003, None, 4, 0x00200000, None)
+    invalid = ctypes.c_void_p(-1).value
+    if handle is None or handle == invalid:
+        raise ctypes.WinError(ctypes.get_last_error())
+    info = _ByHandle()
+    if not kernel32.GetFileInformationByHandle(handle, ctypes.byref(info)):
+        error = ctypes.get_last_error()
+        kernel32.CloseHandle(handle)
+        raise ctypes.WinError(error)
+    if info.dwFileAttributes & 0x00000400:
+        kernel32.CloseHandle(handle)
+        msg = f"refusing a reparse point as a lock database: {database!r}"
+        raise OSError(msg)
+    return handle
+
+
+def _windows_close(handle: int) -> None:
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel32.CloseHandle.argtypes = (wintypes.HANDLE,)
+    kernel32.CloseHandle(handle)
+
