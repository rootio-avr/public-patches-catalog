@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+import os
+import sqlite3
+import sys
+from typing import TYPE_CHECKING
+
+import pytest
+
+from filelock import ReadWriteLock
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from pytest_mock import MockerFixture
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="POSIX directory permissions")
+
+
+@pytest.fixture
+def shared_directory(tmp_path: Path) -> Path:
+    directory = tmp_path / "shared"
+    directory.mkdir()
+    directory.chmod(0o777)  # other accounts can create names here, as in /tmp
+    return directory
+
+
+def _spy_connect(mocker: MockerFixture) -> list[str]:
+    seen: list[str] = []
+    real_connect = sqlite3.connect
+
+    def connect(database: str, *args: object, **kwargs: object) -> sqlite3.Connection:
+        seen.append(database)
+        return real_connect(database, *args, **kwargs)  # type: ignore[arg-type]
+
+    mocker.patch("filelock._read_write.sqlite3.connect", side_effect=connect)
+    return seen
+
+
+def test_shared_directory_hands_sqlite_a_private_link(shared_directory: Path, mocker: MockerFixture) -> None:
+    seen = _spy_connect(mocker)
+    database = shared_directory / "lock.db"
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.write_lock():
+        assert seen
+        assert all(name != str(database) for name in seen)
+        link = seen[-1]
+        assert os.path.dirname(link) != str(shared_directory)
+        assert os.path.samefile(link, database)
+        assert not (shared_directory / "lock.db-journal").exists()
+    lock.close()
+
+    assert [entry.name for entry in shared_directory.iterdir()] == ["lock.db"]
+
+
+def test_private_directory_keeps_plain_database_name(tmp_path: Path, mocker: MockerFixture) -> None:
+    tmp_path.chmod(0o700)
+    seen = _spy_connect(mocker)
+    database = tmp_path / "lock.db"
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.read_lock():
+        pass
+    lock.close()
+
+    assert set(seen) == {str(database.resolve())}
+
+
+def test_shared_directory_refuses_database_replaced_by_symlink(shared_directory: Path) -> None:
+    database = shared_directory / "lock.db"
+    victim = shared_directory.parent / "victim"
+    victim.write_bytes(b"precious")
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    database.unlink()
+    database.symlink_to(victim)
+
+    with pytest.raises(OSError, match=r"."):
+        lock.acquire_write()
+
+    assert victim.read_bytes() == b"precious"
+    lock.close()
+    assert not [entry for entry in shared_directory.iterdir() if entry.name.startswith(".filelock-")]
+
+
+def test_shared_directory_ignores_planted_journal_names(shared_directory: Path) -> None:
+    victim = shared_directory.parent / "victim"
+    victim.write_bytes(b"precious")
+    database = shared_directory / "lock.db"
+    for suffix in ("-journal", "-wal", "-shm"):
+        (shared_directory / f"lock.db{suffix}").symlink_to(victim)
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with lock.write_lock():
+        pass
+    lock.close()
+
+    assert victim.read_bytes() == b"precious"
+
+
+@pytest.mark.skipif(not hasattr(sqlite3.Connection, "setlimit"), reason="needs Connection.setlimit (Python 3.11+)")
+def test_oversized_schema_is_refused(tmp_path: Path) -> None:
+    database = tmp_path / "lock.db"
+    columns = ", ".join(f"column_{index}_{'x' * 40}" for index in range(300))
+    connection = sqlite3.connect(database)
+    connection.execute(f"CREATE TABLE big ({columns})")
+    connection.commit()
+    connection.close()
+
+    lock = ReadWriteLock(str(database), is_singleton=False)
+    with pytest.raises(ValueError, match="schema is too large"):
+        lock.acquire_read()
+    lock.close()
