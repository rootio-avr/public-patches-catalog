--- a/cairosvg/test_api.py
+++ b/cairosvg/test_api.py
@@ -214,3 +214,21 @@
             # to how Windows/NT handles the same file being opened twice at
             # the same time.
             pass
+
+
+def test_path_many_segments():
+    # Parsing paths and markers must not have quadratic complexity
+    segments = ' '.join(f'L {i % 100} {i % 50}' for i in range(30000))
+    svg = (
+        '<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100">'
+        '<marker id="m" markerWidth="1" markerHeight="1">'
+        '<rect width="1" height="1"/></marker>'
+        f'<path d="M 0 0 {segments} z" marker-mid="url(#m)"/></svg>')
+    assert svg2png(svg.encode())[:8] == MAGIC_NUMBERS['PNG']
+
+
+def test_path_implicit_commands():
+    svg = (
+        '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10">'
+        '<path d="m1 1 2 0 0 2 -2 0z M5 5 3 0 0 3-3 0z"/></svg>')
+    assert svg2png(svg.encode())[:8] == MAGIC_NUMBERS['PNG']
