+"""Regression test for CVE-2024-24762 (ReDoS in parse_options_header).
+
+The vulnerable implementation parsed Content-Type header options with a
+custom regular expression (OPTION_RE) that exhibited catastrophic
+backtracking on crafted input, enabling a denial of service (CWE-400).
+The fix replaces the regex with the standard library email header parser.
+
+These assertions are grounded on the upstream TestParseOptionsHeader suite
+and additionally verify that a malicious ReDoS payload parses in bounded
+time.
+"""
+
+import time
+
+from multipart.multipart import parse_options_header
+
+
+def test_simple():
+    t, p = parse_options_header('application/json')
+    assert t == b'application/json'
+    assert p == {}
+
+
+def test_blank():
+    t, p = parse_options_header('')
+    assert t == b''
+    assert p == {}
+
+
+def test_single_param():
+    t, p = parse_options_header('application/json;par=val')
+    assert t == b'application/json'
+    assert p == {b'par': b'val'}
+
+
+def test_multiple_params():
+    t, p = parse_options_header(b'application/json;par=val;asdf=foo')
+    assert t == b'application/json'
+    assert p == {b'par': b'val', b'asdf': b'foo'}
+
+
+def test_quoted_param_with_semicolon():
+    t, p = parse_options_header(b'application/json;param="quoted;with;semicolons"')
+    assert p[b'param'] == b'quoted;with;semicolons'
+
+
+def test_handles_ie6_bug():
+    t, p = parse_options_header(
+        b'text/plain; filename="C:\\this\\is\\a\\path\\file.txt"')
+    assert p[b'filename'] == b'file.txt'
+
+
+def test_redos_payload_parses_in_bounded_time():
+    # Crafted payload that triggered catastrophic backtracking in the old
+    # regex-based parser. It must parse quickly and not hang.
+    payload = b'application/json' + b';' + b'a' * 5000 + b'"' * 5000
+    start = time.time()
+    parse_options_header(payload)
+    elapsed = time.time() - start
+    assert elapsed < 1.0, "parse_options_header took too long: %f s" % elapsed

