+class TestMultipartParserHeaderLimits(unittest.TestCase):
+    """Regression tests for CVE-2026-42561.
+
+    A maliciously-crafted multipart body could contain an unbounded number of
+    headers, or a single header line of unbounded length, allowing an attacker
+    to exhaust server memory/CPU.  The parser now enforces a maximum header
+    count per part and a maximum size for a single header line.
+    """
+
+    boundary = b'boundary'
+
+    def _build_body(self, headers):
+        body = b'--' + self.boundary + b'\r\n'
+        for name, value in headers:
+            body += name + b': ' + value + b'\r\n'
+        body += b'\r\ndata\r\n--' + self.boundary + b'--\r\n'
+        return body
+
+    def test_too_many_headers_raises(self):
+        # More headers than DEFAULT_MAX_HEADER_COUNT (8) must be rejected.
+        headers = [(b'abc' + bytes(bytearray([ord('a') + i])), b'value')
+                   for i in range(DEFAULT_MAX_HEADER_COUNT + 5)]
+        parser = MultipartParser(self.boundary, {})
+        with self.assertRaises(MultipartParseError):
+            parser.write(self._build_body(headers))
+            parser.finalize()
+
+    def test_oversized_single_header_raises(self):
+        # A single header line larger than DEFAULT_MAX_HEADER_SIZE must be
+        # rejected.
+        big_value = b'A' * (DEFAULT_MAX_HEADER_SIZE + 100)
+        parser = MultipartParser(self.boundary, {})
+        with self.assertRaises(MultipartParseError):
+            parser.write(self._build_body([(b'abc', big_value)]))
+            parser.finalize()
+
+    def test_within_limits_parses(self):
+        # A well-formed request within the limits must still parse cleanly.
+        collected = []
+        callbacks = {
+            'on_header_field': lambda d, s, e: None,
+            'on_header_value': lambda d, s, e: None,
+            'on_headers_finished': lambda: None,
+            'on_part_data': lambda d, s, e: collected.append(d[s:e]),
+        }
+        headers = [(b'abc' + bytes(bytearray([ord('a') + i])), b'value')
+                   for i in range(DEFAULT_MAX_HEADER_COUNT - 2)]
+        parser = MultipartParser(self.boundary, callbacks)
+        parser.write(self._build_body(headers))
+        parser.finalize()
+        self.assertEqual(b''.join(collected), b'data')
+
+    def test_custom_limits_are_honored(self):
+        # Explicit lower limits should be enforced.
+        headers = [(b'aaa', b'value'), (b'bbb', b'value'), (b'ccc', b'value')]
+        parser = MultipartParser(self.boundary, {}, max_header_count=2)
+        with self.assertRaises(MultipartParseError):
+            parser.write(self._build_body(headers))
+            parser.finalize()
+
+
