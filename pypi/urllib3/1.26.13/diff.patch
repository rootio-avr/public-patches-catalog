@@ -0,0 +1,83 @@
+"""
+Regression test for CVE-2026-97687 (CWE-295).
+
+The TLS handshake with an HTTPS forwarding proxy must be governed only by the
+proxy's TLS settings and must be isolated from the destination's TLS settings
+(SNI, ``assert_hostname``, ``assert_fingerprint``, client certificates,
+``cert_reqs``). The proxy SSL context must never be mutated by them.
+"""
+
+import ssl
+
+import mock
+
+from urllib3.poolmanager import ProxyManager
+from urllib3.util.ssl_ import create_urllib3_context
+
+
+def _forwarding_connection(proxy, **pool_kw):
+    pool = proxy.connection_from_host(
+        "example.com", 443, scheme="https", pool_kwargs=pool_kw
+    )
+    return pool._new_conn()
+
+
+def _connect(conn):
+    with mock.patch.object(type(conn), "_new_conn", return_value=mock.Mock()):
+        with mock.patch("urllib3.connection.ssl_wrap_socket") as wrap:
+            with mock.patch("urllib3.connection._match_hostname"):
+                wrap.return_value = mock.Mock()
+                conn.connect()
+    return wrap
+
+
+class TestForwardingProxyTLSIsolation(object):
+    def test_destination_settings_not_applied_to_proxy_handshake(self):
+        proxy_ctx = create_urllib3_context()
+        proxy_ctx.verify_mode = ssl.CERT_REQUIRED
+
+        with ProxyManager(
+            "https://proxy.example.com:8443",
+            proxy_ssl_context=proxy_ctx,
+            use_forwarding_for_https=True,
+        ) as proxy:
+            conn = _forwarding_connection(
+                proxy,
+                cert_reqs="CERT_NONE",
+                assert_hostname="target.example.org",
+                assert_fingerprint="aa:" * 19 + "aa",
+                server_hostname="target.example.org",
+                cert_file="client.crt",
+                key_file="client.key",
+                ca_certs="target-ca.pem",
+            )
+            wrap = _connect(conn)
+
+        assert wrap.call_count == 1
+        kwargs = wrap.call_args[1]
+        # Handshake uses the proxy's context and the proxy's hostname only.
+        assert kwargs["ssl_context"] is proxy_ctx
+        assert kwargs["server_hostname"] == "proxy.example.com"
+        for key in ("keyfile", "certfile", "ca_certs", "ca_cert_dir", "ca_cert_data"):
+            assert not kwargs.get(key)
+        # Destination cert_reqs must not leak into the proxy's context.
+        assert proxy_ctx.verify_mode == ssl.CERT_REQUIRED
+        assert conn.proxy_is_verified is True
+
+    def test_no_proxy_context_uses_proxy_hostname_not_target_sni(self):
+        with ProxyManager(
+            "https://proxy.example.com:8443", use_forwarding_for_https=True
+        ) as proxy:
+            conn = _forwarding_connection(
+                proxy,
+                server_hostname="target.example.org",
+                assert_hostname="target.example.org",
+                cert_file="client.crt",
+                key_file="client.key",
+            )
+            wrap = _connect(conn)
+
+        kwargs = wrap.call_args[1]
+        assert kwargs["server_hostname"] == "proxy.example.com"
+        assert not kwargs.get("keyfile")
+        assert not kwargs.get("certfile")

