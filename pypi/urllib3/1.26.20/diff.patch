@@ -0,0 +1,171 @@
+"""Regression tests for CVE-2026-97687.
+
+The TLS handshake with an HTTPS *forwarding* proxy (``use_forwarding_for_https``)
+must be governed by proxy-specific settings only. The destination server's
+SNI override, ``assert_hostname``, ``assert_fingerprint`` and client
+certificate must not be applied to the proxy handshake, and a relaxed
+destination ``cert_reqs`` must never overwrite the proxy context's
+``verify_mode``.
+
+These tests do not touch the network: ``ssl_wrap_socket`` is stubbed and the
+arguments of the proxy handshake are recorded.
+"""
+import ssl
+import warnings
+
+import pytest
+
+import urllib3.connection as connection_module
+from urllib3.poolmanager import ProxyManager
+
+
+class _FakeTLSSocket(object):
+    def __init__(self, cert=None):
+        self._cert = cert if cert is not None else {}
+
+    def version(self):
+        return "TLSv1.3"
+
+    def getpeercert(self, binary_form=False):
+        if binary_form:
+            return b"proxy-der-cert"
+        return self._cert
+
+
+def _connect_through_forwarding_proxy(
+    monkeypatch, proxy_context, cert=None, **pool_kw
+):
+    calls = []
+
+    def recording_wrapper(*args, **kwargs):
+        calls.append(kwargs)
+        return _FakeTLSSocket(cert)
+
+    monkeypatch.setattr(connection_module, "ssl_wrap_socket", recording_wrapper)
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", FutureWarning)
+        manager = ProxyManager(
+            "https://proxy.invalid:443",
+            proxy_ssl_context=proxy_context,
+            use_forwarding_for_https=True,
+            **pool_kw
+        )
+    pool = manager.connection_from_url("https://target.invalid:443")
+    conn = pool._new_conn()
+    # Avoid opening a real socket.
+    monkeypatch.setattr(conn, "_new_conn", lambda: object())
+    conn.connect()
+    return conn, calls
+
+
+def test_target_sni_override_not_sent_to_proxy(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    conn, calls = _connect_through_forwarding_proxy(
+        monkeypatch, proxy_context, server_hostname="target.invalid"
+    )
+    assert len(calls) == 1
+    assert calls[0]["server_hostname"] == "proxy.invalid"
+    assert calls[0]["ssl_context"] is proxy_context
+
+
+def test_target_client_cert_not_sent_to_proxy(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    conn, calls = _connect_through_forwarding_proxy(
+        monkeypatch,
+        proxy_context,
+        cert_file="/nonexistent/client.pem",
+        key_file="/nonexistent/client.key",
+    )
+    assert len(calls) == 1
+    assert calls[0]["certfile"] is None
+    assert calls[0]["keyfile"] is None
+
+
+def test_target_client_cert_not_sent_to_proxy_without_proxy_context(monkeypatch):
+    # Deprecated fallback to ``ssl_context`` must still not leak credentials.
+    target_context = ssl.create_default_context()
+    conn, calls = _connect_through_forwarding_proxy(
+        monkeypatch,
+        None,
+        ssl_context=target_context,
+        cert_file="/nonexistent/client.pem",
+        key_file="/nonexistent/client.key",
+    )
+    assert len(calls) == 1
+    assert calls[0]["certfile"] is None
+    assert calls[0]["keyfile"] is None
+    assert calls[0]["ssl_context"] is target_context
+
+
+def test_target_assert_hostname_not_applied_to_proxy(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    proxy_context.check_hostname = False
+    cert = {"subjectAltName": (("DNS", "proxy.invalid"),)}
+    # Would raise CertificateError if "target.invalid" were asserted against
+    # the proxy certificate.
+    conn, calls = _connect_through_forwarding_proxy(
+        monkeypatch, proxy_context, cert=cert, assert_hostname="target.invalid"
+    )
+    assert conn.proxy_is_verified is True
+
+
+def test_proxy_hostname_still_verified(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    proxy_context.check_hostname = False
+    cert = {"subjectAltName": (("DNS", "other.invalid"),)}
+    with pytest.raises(Exception) as e:
+        _connect_through_forwarding_proxy(
+            monkeypatch, proxy_context, cert=cert, assert_hostname=False
+        )
+    assert "proxy.invalid" in str(e.value)
+
+
+def test_target_assert_fingerprint_not_applied_to_proxy(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    conn, calls = _connect_through_forwarding_proxy(
+        monkeypatch, proxy_context, assert_fingerprint="aa" * 20
+    )
+    # No SSLError for a mismatching fingerprint, and the fingerprint does not
+    # make the proxy "verified".
+    assert conn.proxy_is_verified is True
+    assert conn.is_verified is False
+
+
+def test_target_cert_reqs_none_does_not_relax_proxy(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    target_context = ssl.create_default_context()
+    conn, calls = _connect_through_forwarding_proxy(
+        monkeypatch,
+        proxy_context,
+        ssl_context=target_context,
+        cert_reqs=ssl.CERT_NONE,
+    )
+    assert calls[0]["ssl_context"] is proxy_context
+    assert proxy_context.verify_mode == ssl.CERT_REQUIRED
+    assert conn.proxy_is_verified is True
+
+
+def test_ssl_context_with_forwarding_warns_and_falls_back():
+    target_context = ssl.create_default_context()
+    with pytest.warns(FutureWarning, match="proxy_ssl_context"):
+        manager = ProxyManager(
+            "https://proxy.invalid:443",
+            use_forwarding_for_https=True,
+            ssl_context=target_context,
+        )
+    assert manager.proxy_ssl_context is target_context
+    # Connections only ever receive explicit proxy policy.
+    assert manager.proxy_config.ssl_context is None
+
+
+def test_no_warning_without_forwarding():
+    with warnings.catch_warnings():
+        warnings.simplefilter("error", FutureWarning)
+        ProxyManager(
+            "https://proxy.invalid:443", ssl_context=ssl.create_default_context()
+        )
+
+
+if __name__ == "__main__":
+    raise SystemExit(pytest.main([__file__, "-v"]))

