+++ b/test/test_aikido_2026_499214.py
@@ -0,0 +1,106 @@
+"""Regression test for AIKIDO-2026-499214.
+
+A forwarding HTTPS proxy connection (``use_forwarding_for_https=True``, no
+CONNECT tunnel) must perform its TLS handshake against the *proxy* using the
+proxy's own certificate policy. Before the fix, ``HTTPSConnection.connect()``
+wrapped the proxy socket with the *destination* server's ``ssl_context`` and
+overwrote that context's ``verify_mode`` in place with the destination's
+``cert_reqs``. Setting a target's ``verify_mode`` to ``CERT_NONE`` could then
+persistently disable verification of the proxy connection, enabling proxy
+impersonation.
+
+This test does not touch the network: it stubs ``ssl_wrap_socket`` and records
+which SSL context the proxy handshake was performed with.
+"""
+import ssl
+
+import pytest
+
+import urllib3.connection as connection_module
+from urllib3.poolmanager import ProxyManager
+
+
+class _FakeTLSSocket(object):
+    def version(self):
+        return "TLSv1.3"
+
+    def getpeercert(self, binary_form=False):
+        return {}
+
+    def selected_alpn_protocol(self):
+        return None
+
+
+def _build_forwarding_proxy_conn(monkeypatch, proxy_context, target_context):
+    calls = []
+
+    def recording_wrapper(*args, **kwargs):
+        calls.append(kwargs.get("ssl_context"))
+        return _FakeTLSSocket()
+
+    monkeypatch.setattr(connection_module, "ssl_wrap_socket", recording_wrapper)
+
+    manager = ProxyManager(
+        "https://proxy.invalid:443",
+        proxy_ssl_context=proxy_context,
+        use_forwarding_for_https=True,
+        ssl_context=target_context,
+        cert_reqs=ssl.CERT_NONE,
+    )
+    pool = manager.connection_from_url("https://target.invalid:443")
+    conn = pool._new_conn()
+    # Avoid opening a real socket.
+    monkeypatch.setattr(conn, "_new_conn", lambda: object())
+    conn.connect()
+    return conn, calls
+
+
+def test_forwarding_proxy_prefers_proxy_ssl_context(monkeypatch):
+    proxy_context = ssl.create_default_context()
+    assert proxy_context.verify_mode == ssl.CERT_REQUIRED
+
+    target_context = ssl.create_default_context()
+    target_context.check_hostname = False
+    target_context.verify_mode = ssl.CERT_NONE
+
+    conn, calls = _build_forwarding_proxy_conn(
+        monkeypatch, proxy_context, target_context
+    )
+
+    # Exactly one TLS handshake happened (to the proxy) and it used the
+    # proxy's own SSL context -- not the destination's relaxed context.
+    assert len(calls) == 1
+    assert calls[0] is proxy_context
+
+    # The destination's CERT_NONE policy must not have overwritten the
+    # proxy context's verify_mode in place.
+    assert proxy_context.verify_mode == ssl.CERT_REQUIRED
+
+    # The proxy connection is recorded as verified; the destination is not
+    # verified by this proxy handshake.
+    assert conn.proxy_is_verified is True
+    assert conn.is_verified is False
+
+
+def test_forwarding_proxy_records_unverified_proxy(monkeypatch):
+    # A proxy context configured with CERT_NONE should surface as an
+    # unverified proxy connection (so the pool can warn), independent of the
+    # destination's settings.
+    proxy_context = ssl.create_default_context()
+    proxy_context.check_hostname = False
+    proxy_context.verify_mode = ssl.CERT_NONE
+
+    target_context = ssl.create_default_context()
+
+    conn, calls = _build_forwarding_proxy_conn(
+        monkeypatch, proxy_context, target_context
+    )
+
+    assert len(calls) == 1
+    assert calls[0] is proxy_context
+    assert proxy_context.verify_mode == ssl.CERT_NONE
+    assert conn.proxy_is_verified is False
+
+
+if __name__ == "__main__":
+    raise SystemExit(pytest.main([__file__, "-v"]))

