+class TestMaximumDepth:
+    def test_default(self, impl) -> None:
+        # Regression test for CVE-2026-26209: deeply nested containers must not
+        # be able to exhaust the interpreter stack. Decoding beyond the default
+        # nesting limit raises CBORDecodeError instead of crashing.
+        with pytest.raises(
+            impl.CBORDecodeError,
+            match=r"maximum container nesting depth \(400\) exceeded",
+        ):
+            impl.loads(b"\x81" * 401 + b"\x80")
+
+    def test_explicit(self, impl) -> None:
+        # A caller-supplied max_depth must also be honoured.
+        with pytest.raises(
+            impl.CBORDecodeError,
+            match=r"maximum container nesting depth \(9\) exceeded",
+        ):
+            impl.loads(b"\x81" * 10 + b"\x80", max_depth=9)
+
+    def test_within_limit(self, impl) -> None:
+        # Nesting at or below the limit still decodes normally.
+        result = impl.loads(b"\x81" * 5 + b"\x80")
+        assert result == [[[[[[]]]]]]
