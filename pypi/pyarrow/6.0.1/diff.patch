From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patch-platoon <patch-platoon@example.com>
Date: Mon, 06 Nov 2023 23:20:05 +0100
Subject: [PATCH] Fix numpy build dependency for Python 3.11+ compatibility

This patch fixes the build dependency constraint to allow PyArrow 6.0.1
to build with Python 3.11+. The original numpy==1.21.3 constraint for
Python > 3.9 doesn't support Python 3.11, which requires numpy >= 1.23.0.

This is a build-time fix only and does not affect the security patch.

The patch searches for the numpy==1.21.3 constraint in pyproject.toml files
and updates it to support Python 3.11+ by using numpy>=1.23.0.

---
--- a/python/pyproject.toml
+++ b/python/pyproject.toml
@@ -20,9 +20,10 @@ requires = [
     "cython >= 0.29",
     "numpy==1.16.6; python_version<'3.8'",
     "numpy==1.17.3; python_version=='3.8'",
     "numpy==1.19.4; python_version=='3.9'",
-    "numpy==1.21.3; python_version>'3.9'",
+    "numpy==1.21.3; python_version>'3.9' and python_version<'3.11'",
+    "numpy>=1.23.0; python_version>='3.11'",
     "setuptools < 58.5",  # ARROW-14584
     "setuptools_scm",
     "wheel"
 ]

