+def test_py_extension_type_auto_load_disabled():
+    # CVE-2023-47248: pickle payloads embedded in IPC metadata must not be
+    # executed unless auto-loading is explicitly enabled.
+    pa.PyExtensionType.set_auto_load(False)
+    batch = pa.RecordBatch.from_arrays(
+        [pa.ExtensionArray.from_storage(
+            LegacyIntType(), pa.array([1, 2, 3], pa.int8()))], ['ext'])
+    buf = ipc_write_batch(batch)
+    del _legacy_loaded[:]
+
+    with pytest.warns(RuntimeWarning, match="set_auto_load"):
+        result = ipc_read_batch(buf)
+    assert _legacy_loaded == []
+    assert isinstance(result.schema.field('ext').type,
+                      pa.UnknownExtensionType)
+
+    # The unknown type can still be round-tripped without being unpickled
+    buf2 = ipc_write_batch(result)
+    with pytest.warns(RuntimeWarning, match="set_auto_load"):
+        result = ipc_read_batch(buf2)
+    assert _legacy_loaded == []
+
+    # Explicitly re-enabling auto-load restores the legacy behavior
+    pa.PyExtensionType.set_auto_load(True)
+    result = ipc_read_batch(buf)
+    assert _legacy_loaded == [True]
+    assert isinstance(result.schema.field('ext').type, LegacyIntType)
