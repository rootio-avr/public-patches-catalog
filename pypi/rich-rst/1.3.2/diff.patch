@@ -0,0 +1,113 @@
+"""File-reading directives are disabled by default and confined when enabled."""
+
+import os
+import sys
+
+import pytest
+
+from rich_rst import RestructuredText
+from rich_rst.__main__ import main
+
+CANARY = "CANARY_SECRET_d41d8cd9"
+
+
+@pytest.fixture
+def layout(tmp_path):
+    docs = tmp_path / "docs"
+    docs.mkdir()
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    secret = outside / "secret.txt"
+    secret.write_text(f"{CANARY}\n", encoding="utf-8")
+    secret_csv = outside / "secret.csv"
+    secret_csv.write_text(f"a,b\n{CANARY},x\n", encoding="utf-8")
+    return docs, secret, secret_csv
+
+
+def _leaking_directives(secret, secret_csv):
+    return {
+        "raw file": f".. raw:: text\n   :file: {secret}\n",
+        "raw url": f".. raw:: text\n   :url: {secret.as_uri()}\n",
+        "include": f".. include:: {secret}\n",
+        "csv-table file": f".. csv-table:: t\n   :file: {secret_csv}\n",
+        "csv-table url": f".. csv-table:: t\n   :url: {secret_csv.as_uri()}\n",
+    }
+
+
+def _render(markup, width=120, **kwargs):
+    from rich.console import Console
+
+    console = Console(width=width, record=True, force_terminal=False)
+    console.print(RestructuredText(markup, **kwargs))
+    return console.export_text()
+
+
+@pytest.mark.parametrize("directive", ["raw file", "raw url", "include", "csv-table file", "csv-table url"])
+def test_file_access_disabled_by_default(layout, directive):
+    docs, secret, secret_csv = layout
+    markup = _leaking_directives(secret, secret_csv)[directive]
+    for filename in ("<rst-document>", str(docs / "doc.rst")):
+        out = _render(markup, filename=filename)
+        assert CANARY not in out
+
+
+def test_cli_file_access_disabled_by_default(layout, monkeypatch, capsys):
+    docs, secret, _ = layout
+    document = docs / "doc.rst"
+    document.write_text(f".. include:: {secret}\n\n.. raw:: text\n   :file: {secret}\n")
+    monkeypatch.setattr(sys, "argv", ["rich-rst", str(document)])
+    main()
+    assert CANARY not in capsys.readouterr().out
+
+
+@pytest.mark.parametrize("kind", ["absolute", "parent", "symlink"])
+def test_allowed_include_is_confined_to_source_directory(layout, kind):
+    docs, secret, _ = layout
+    if kind == "absolute":
+        target = str(secret)
+    elif kind == "parent":
+        target = os.path.relpath(secret, docs)
+    else:
+        link = docs / "link.txt"
+        try:
+            link.symlink_to(secret)
+        except (OSError, NotImplementedError):
+            pytest.skip("symlinks not supported")
+        target = "link.txt"
+
+    out = _render(
+        f".. include:: {target}\n",
+        filename=str(docs / "doc.rst"),
+        allow_file_access=True,
+    )
+    assert CANARY not in out
+    assert "Rejected include path outside source directory" in out
+
+
+def test_allowed_include_reads_files_inside_source_directory(layout):
+    docs, _, _ = layout
+    (docs / "part.rst").write_text("Included paragraph.\n", encoding="utf-8")
+    out = _render(
+        ".. include:: part.rst\n",
+        filename=str(docs / "doc.rst"),
+        allow_file_access=True,
+    )
+    assert "Included paragraph." in out
+
+
+def test_default_disabled_after_enabled_render(layout):
+    docs, _, _ = layout
+    (docs / "part.rst").write_text("Included paragraph.\n", encoding="utf-8")
+    _render("x", filename=str(docs / "doc.rst"), allow_file_access=True)
+    out = _render(".. include:: part.rst\n", filename=str(docs / "doc.rst"))
+    assert "Included paragraph." not in out
+
+
+def test_cli_allow_file_access_flag(layout, monkeypatch, capsys):
+    docs, _, _ = layout
+    (docs / "part.rst").write_text("Included paragraph.\n", encoding="utf-8")
+    document = docs / "doc.rst"
+    document.write_text(".. include:: part.rst\n")
+    monkeypatch.setattr(sys, "argv", ["rich-rst", "--allow-file-access", str(document)])
+    main()
+    assert "Included paragraph." in capsys.readouterr().out
