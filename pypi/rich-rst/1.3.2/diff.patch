+"""Regression tests: file-reading directives are disabled by default."""
+
+import pytest
+
+from rich_rst import RestructuredText
+
+CANARY = "CANARY_SECRET_d41d8cd9"
+
+
+@pytest.fixture
+def secrets(tmp_path):
+    secret = tmp_path / "secret.txt"
+    secret.write_text(CANARY + "\n", encoding="utf-8")
+    secret_csv = tmp_path / "secret.csv"
+    secret_csv.write_text("a,b\n" + CANARY + ",x\n", encoding="utf-8")
+    return secret, secret_csv
+
+
+def _markups(secret, secret_csv):
+    return [
+        ".. raw:: text\n   :file: %s\n" % secret,
+        ".. raw:: text\n   :url: %s\n" % secret.as_uri(),
+        ".. include:: %s\n" % secret,
+        ".. csv-table:: t\n   :file: %s\n" % secret_csv,
+        ".. csv-table:: t\n   :url: %s\n" % secret_csv.as_uri(),
+    ]
+
+
+def _render(markup, **kwargs):
+    from rich.console import Console
+
+    console = Console(width=120, record=True, force_terminal=False)
+    console.print(RestructuredText(markup, **kwargs))
+    return console.export_text()
+
+
+def test_file_access_disabled_by_default(secrets):
+    for markup in _markups(*secrets):
+        assert CANARY not in _render(markup)
+
+
+def test_file_access_can_be_enabled(secrets):
+    secret, _ = secrets
+    out = _render(".. include:: %s\n" % secret, allow_file_access=True)
+    assert CANARY in out
+
+
+def test_normal_markup_still_renders():
+    assert "hello" in _render("hello *world*\n")

