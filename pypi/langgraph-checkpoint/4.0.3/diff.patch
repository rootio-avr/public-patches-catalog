+def test_lc2_json_method_field_is_ignored() -> None:
+    """The `method` field on lc=2 envelopes is ignored.
+
+    Regression test for GHSA-fjqc-hq36-qh5p: `_revive_lc2` previously resolved
+    `getattr(cls, method)` from the envelope, which let an attacker pivot a
+    safe pydantic class (e.g. AIMessage) to `parse_raw(..., allow_pickle=True)`
+    and reach `pickle.loads`. Revival now uses only the default constructor.
+    """
+    from langchain_core.messages import AIMessage
+
+    serde = JsonPlusSerializer(
+        allowed_json_modules=[("langchain_core", "messages", "ai", "AIMessage")]
+    )
+    load = {
+        "lc": 2,
+        "type": "constructor",
+        "id": ["langchain_core", "messages", "ai", "AIMessage"],
+        "method": "parse_raw",
+        "args": ["default-ctor-ran"],
+        "kwargs": {"content_type": "application/pickle", "allow_pickle": True},
+    }
+    result = serde._revive_lc2(load)
+    # The default constructor takes `content` as its first positional argument.
+    # Had `parse_raw` been invoked it would have attempted pickle parsing and
+    # raised (or run the gadget); neither produces this result.
+    assert isinstance(result, AIMessage)
+    assert result.content == "default-ctor-ran"
+
+
+def test_lc2_json_init_still_works() -> None:
+    """lc=2 revival without a `method` field still constructs the class."""
+    from langchain_core.messages import AIMessage
+
+    serde = JsonPlusSerializer(
+        allowed_json_modules=[("langchain_core", "messages", "ai", "AIMessage")]
+    )
+    load = {
+        "lc": 2,
+        "type": "constructor",
+        "id": ["langchain_core", "messages", "ai", "AIMessage"],
+        "kwargs": {"content": "hi", "type": "ai"},
+    }
+    result = serde._revive_lc2(load)
+    assert isinstance(result, AIMessage)
+    assert result.content == "hi"
+
+
+def test_lc2_json_legacy_pydantic_method_list_uses_default_ctor() -> None:
+    """Legacy ``method=(None, "construct")`` envelopes revive via the default ctor.
+
+    Pre-October-2025 langgraph emitted pydantic models with
+    ``method=(None, "construct")``, meaning "try the default constructor, fall
+    back to pydantic ``construct``". The first entry (``None``) was always the
+    default constructor, which is what happens unconditionally now, so these
+    envelopes keep working as long as the kwargs are valid.
+    """
+    from langchain_core.messages import AIMessage
+
+    serde = JsonPlusSerializer(
+        allowed_json_modules=[("langchain_core", "messages", "ai", "AIMessage")]
+    )
+    load = {
+        "lc": 2,
+        "type": "constructor",
+        "id": ["langchain_core", "messages", "ai", "AIMessage"],
+        "method": [None, "construct"],
+        "kwargs": {"content": "legacy", "type": "ai"},
+    }
+    result = serde._revive_lc2(load)
+    assert isinstance(result, AIMessage)
+    assert result.content == "legacy"
+
+
+def test_lc2_json_legacy_construct_payload_logs_warning_when_init_rejects(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """Legacy `construct` payloads the default ctor rejects revive to None and warn.
+
+    Removing method dispatch also removed the `cls.construct(**kwargs)`
+    fallback, so these payloads now fail validation. The warning makes that
+    observable instead of letting the envelope quietly degrade.
+    """
+    serde = JsonPlusSerializer(
+        allowed_json_modules=[("langchain_core", "messages", "ai", "AIMessage")]
+    )
+    load = {
+        "lc": 2,
+        "type": "constructor",
+        "id": ["langchain_core", "messages", "ai", "AIMessage"],
+        "method": [None, "construct"],
+        # `type` fails AIMessage's Literal["ai"] validator under the default
+        # constructor. Before this fix it fell back to `cls.construct(**kwargs)`.
+        "kwargs": {"content": "legacy", "type": "not-a-real-message-type"},
+    }
+
+    with caplog.at_level(
+        logging.WARNING, logger="langgraph.checkpoint.serde.jsonplus"
+    ):
+        result = serde._revive_lc2(load)
+
+    assert result is None
+    assert [
+        r
+        for r in caplog.records
+        if r.name == "langgraph.checkpoint.serde.jsonplus"
+        and r.levelno == logging.WARNING
+        and "langchain_core.messages.ai.AIMessage" in r.getMessage()
+        and "legacy_method_field=True" in r.getMessage()
+    ], [(r.name, r.levelname, r.getMessage()) for r in caplog.records]
+
+
+def test_lc2_json_pickle_payload_does_not_execute() -> None:
+    """End-to-end: a `parse_raw` pickle gadget payload must not run."""
+    import os
+    import pickle
+    import tempfile
+
+    marker = tempfile.NamedTemporaryFile(
+        prefix="lc2_block_proof_", suffix=".out", delete=False
+    ).name
+    os.remove(marker)  # ensure absent before the test runs
+
+    class _Gadget:
+        def __reduce__(self) -> tuple:
+            return (os.system, (f"touch {marker}",))
+
+    gadget_bytes = pickle.dumps(_Gadget(), protocol=0).decode("latin1")
+    envelope = {
+        "lc": 2,
+        "type": "constructor",
+        "id": ["langchain_core", "messages", "ai", "AIMessage"],
+        "method": "parse_raw",
+        "args": [gadget_bytes],
+        "kwargs": {"content_type": "application/pickle", "allow_pickle": True},
+    }
+
+    serde = JsonPlusSerializer(
+        allowed_json_modules=[("langchain_core", "messages", "ai", "AIMessage")]
+    )
+    try:
+        serde.loads_typed(("json", json.dumps(envelope).encode()))
+    except Exception:
+        pass
+
+    assert not os.path.exists(marker), (
+        "Pickle gadget executed via parse_raw on AIMessage lc=2 envelope"
+    )
