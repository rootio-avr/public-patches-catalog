+# Regression test for CVE-2026-96749: signed 32-bit overflow in the size
+# arithmetic of bson/buffer.c (buffer_assure_space).
+from __future__ import annotations
+
+import sys
+import unittest
+
+sys.path[0:0] = [""]
+
+import bson
+from bson import decode, encode
+
+
+@unittest.skipUnless(bson.has_c(), "This test requires the C extension")
+class TestBufferSizeOverflow(unittest.TestCase):
+    def test_normal_document_round_trips(self):
+        doc = {"a": "x" * 1000, "b": [1, 2, 3], "c": {"d": 1}}
+        self.assertEqual(doc, decode(encode(doc)))
+
+    def test_encode_exceeding_int_max_raises_value_error(self):
+        # Two ~1 GiB values push the encoded size past INT_MAX (2**31 - 1).
+        # This must raise ValueError rather than wrapping the size
+        # computation and writing outside the allocated buffer.
+        try:
+            big_value = "a" * (1 << 30)
+        except MemoryError:
+            self.skipTest("not enough memory to build a 1 GiB value")
+        with self.assertRaises(ValueError):
+            encode({"a": big_value, "b": big_value, "c": big_value})
+
+
+if __name__ == "__main__":
+    unittest.main()
