From fb008dd700b761d955210d9692475c3e2f379453 Mon Sep 17 00:00:00 2001
From: Marcelo Trylesinski <marcelotryle@gmail.com>
Date: Sun, 2 Aug 2026 09:36:34 +0100
Subject: [PATCH] Start TLS for wss scheme in SOCKS5 proxy connections (#1104)

CVE-2026-84381: Upgrade SOCKS5 tunnels to TLS for wss origins. Backported from
https://github.com/pydantic/httpx2/commit/fb008dd700b761d955210d9692475c3e2f379453
---
--- a/httpcore2/_async/socks_proxy.py
+++ b/httpcore2/_async/socks_proxy.py
@@ -240,7 +240,7 @@
                         trace.return_value = stream
 
                     # Upgrade the stream to SSL
-                    if self._remote_origin.scheme == b"https":
+                    if self._remote_origin.scheme in (b"https", b"wss"):
                         ssl_context = default_ssl_context() if self._ssl_context is None else self._ssl_context
                         alpn_protocols = ["http/1.1", "h2"] if self._http2 else ["http/1.1"]
                         ssl_context.set_alpn_protocols(alpn_protocols)
--- a/httpcore2/_sync/socks_proxy.py
+++ b/httpcore2/_sync/socks_proxy.py
@@ -240,7 +240,7 @@
                         trace.return_value = stream
 
                     # Upgrade the stream to SSL
-                    if self._remote_origin.scheme == b"https":
+                    if self._remote_origin.scheme in (b"https", b"wss"):
                         ssl_context = default_ssl_context() if self._ssl_context is None else self._ssl_context
                         alpn_protocols = ["http/1.1", "h2"] if self._http2 else ["http/1.1"]
                         ssl_context.set_alpn_protocols(alpn_protocols)
