+    def match_ancestor(self, el: 'bs4.Tag', relation: ct.SelectorList) -> bool:
+        """
+        Match descendant combinator.
+
+        A selector with several descendant combinators tries every ancestor for each one, which is
+        a polynomial of the depth with a degree of the number of combinators. Every element visited
+        on the walk shares the result, so cache whether each one is or has a matching ancestor.
+
+        The cache must stay small for deep documents with many combinators, as it holds a result for every
+        ancestor and every relation. Each ancestor is given a compact index once, and the results of a
+        relation are stored as a single byte per ancestor (0: unknown, 1: no match, 2: match) instead of
+        one dictionary entry per ancestor and relation.
+        """
+
+        found = False
+        visited = []  # type: List[int]
+        index = self.anc_index
+        table = self.anc_cache.setdefault((id(relation), self.iframe_restrict), bytearray())
+        parent = self.get_parent(el, no_iframe=self.iframe_restrict)
+        while not found and parent:
+            pos = index.get(id(parent))
+            if pos is None:
+                pos = index[id(parent)] = len(index)
+            elif pos < len(table) and table[pos]:
+                found = table[pos] == 2
+                break
+            visited.append(pos)
+            found = self.match_selectors(parent, relation)
+            parent = self.get_parent(parent, no_iframe=self.iframe_restrict)
+
+        if visited:
+            size = max(visited) + 1
+            if len(table) < size:
+                table.extend(bytes(size - len(table)))
+            value = 2 if found else 1
+            for pos in visited:
+                table[pos] = value
+
+        return found
