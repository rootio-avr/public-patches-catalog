+"""Test that the CSS parsing patterns do not suffer from catastrophic backtracking."""
+import time
+import unittest
+import soupsieve as sv
+
+
+class TestRegexBacktracking(unittest.TestCase):
+    """Test that malformed selectors are rejected (or parsed) in a reasonable amount of time."""
+
+    # Generous upper bound, these inputs used to take minutes to hours.
+    LIMIT = 5.0
+
+    def assert_fast(self, pattern):
+        """Compile the pattern and make sure it completes quickly, whether it is accepted or rejected."""
+
+        start = time.time()
+        try:
+            sv.compile(pattern)
+        except (sv.SelectorSyntaxError, ValueError):
+            pass
+        self.assertLess(time.time() - start, self.LIMIT)
+
+    def test_escapes_in_unterminated_attribute(self):
+        """Test repeated escapes in an attribute selector that is never closed."""
+
+        self.assert_fast('[a' + '\\9' * 30 + '=x')
+        self.assert_fast('[a' + '\\9' * 30 + '=x]')
+
+    def test_hex_escapes_in_unterminated_attribute(self):
+        """Test repeated hex escapes of varying length in an attribute selector that is never closed."""
+
+        self.assert_fast('[a' + '\\1' * 30 + '="')
+        self.assert_fast('[a' + '\\aaaaaa' * 30 + '=x')
+        self.assert_fast('[a=' + '\\1f' * 30 + '!')
+
+    def test_unterminated_quoted_values(self):
+        """Test long unterminated quoted values."""
+
+        self.assert_fast('[a="' + 'b' * 40)
+        self.assert_fast("[a='" + 'b' * 40)
+        self.assert_fast(':lang("' + 'b' * 40)
+
+    def test_unquoted_identifier_values(self):
+        """Test long identifier values that are followed by invalid content."""
+
+        self.assert_fast('[a=' + 'b' * 40 + '!')
+        self.assert_fast('[a=b' + '\\9' * 30 + '!')
+        self.assert_fast('.a' + 'b' * 40 + '!')
+
+    def test_valid_escapes_still_match(self):
+        """Test that the stricter escape patterns still accept all valid escape forms."""
+
+        for pattern in (
+            '.\\31 23', '.\\000031', '.\\0000311', '.a\\31\r\nb', '.\\g', '.\\;', '.\\A9', '[a\\9="x"]',
+            '[a="\\\r\nb"]', "[a='\\\\']", '[a=b\\31 i]', ':lang(a\\31 , "b")'
+        ):
+            sv.compile(pattern)

