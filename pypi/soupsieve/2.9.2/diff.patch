+"""Regression tests for CVE-2026-126191 (catastrophic regex backtracking in CSS escape parsing)."""
+import signal
+import sys
+import time
+import unittest
+
+import soupsieve as sv
+from soupsieve.util import SelectorSyntaxError
+
+
+class Timeout(Exception):
+    """Timeout exception."""
+
+
+def _raise_timeout(*_args):
+    """Raise a timeout."""
+
+    raise Timeout()
+
+
+@unittest.skipUnless(not sys.platform.startswith('win'), "Unix/Linux test")
+class TestCVE2026126191(unittest.TestCase):
+    """Test that repeated CSS escapes do not cause exponential backtracking."""
+
+    LIMIT = 5.0
+
+    def assert_fast(self, selector):
+        """Assert that compiling the selector finishes quickly (success or syntax error)."""
+
+        signal.signal(signal.SIGALRM, _raise_timeout)
+        signal.setitimer(signal.ITIMER_REAL, self.LIMIT)
+        start = time.perf_counter()
+        try:
+            try:
+                sv.compile(selector)
+            except SelectorSyntaxError:
+                pass
+            elapsed = time.perf_counter() - start
+        except Timeout:
+            self.fail('Selector took longer than %.0f s: %r' % (self.LIMIT, selector[:40]))
+        finally:
+            signal.setitimer(signal.ITIMER_REAL, 0)
+
+        self.assertLess(elapsed, 1.0, 'Selector took %.3f s: %r' % (elapsed, selector[:40]))
+
+    def test_escape_backtracking(self):
+        """Repeated escapes in an unterminated attribute selector must fail fast."""
+
+        for n in (24, 40, 200, 2000):
+            self.assert_fast('[' + '\\a' * n)
+            self.assert_fast('[' + '\\a' * n + ' ')
+            self.assert_fast('[a=' + '\\a' * n)
+            self.assert_fast('[a' + '\\a' * n)
+            self.assert_fast(':is(' + '\\a' * n)
+
+    def test_valid_escapes_still_work(self):
+        """Escaped identifiers and attribute selectors still parse and match."""
+
+        from bs4 import BeautifulSoup as bs
+
+        markup = '<div id="a"><p lang="en-US" class="x:y">t</p><span data-v="b c"></span></div>'
+        soup = bs(markup, 'html.parser')
+        self.assertEqual(len(sv.select('.x\\:y', soup)), 1)
+        self.assertEqual(len(sv.select('.\\78 \\3a y', soup)), 1)
+        self.assertEqual(len(sv.select('[lang|=en]', soup)), 1)
+        self.assertEqual(len(sv.select('[lang|="en-US" i]', soup)), 1)
+        self.assertEqual(len(sv.select('[data-v~="c"]', soup)), 1)
+        self.assertEqual(len(sv.select('div > p:nth-child(1)', soup)), 1)
+        self.assertEqual(len(sv.select('p:nth-child( 1n + 0 )', soup)), 1)
+        self.assertEqual(len(sv.select(':is(p, span):lang(en)', soup)), 1)

