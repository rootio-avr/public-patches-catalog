+    def test_performance_escape_runs(self):
+        """Test that runs of ambiguous CSS escapes do not cause exponential backtracking."""
+
+        for n in (16, 64, 256, 1024):
+            self.assert_performance("[" + "\\9" * n + "!")
+            self.assert_performance("[" + "\\99" * n + "!")
+            self.assert_performance("[" + "\\aaaaaa" * n + "!")
+            self.assert_performance("\\aaaaaa" * n + "|!")
+            self.assert_performance("\\9" * n + "|")

