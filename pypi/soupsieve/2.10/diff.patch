@@ -0,0 +1,108 @@
+"""Test CSS parsing does not suffer from excessive regular expression backtracking."""
+import time
+import unittest
+from .. import util
+import soupsieve as sv
+
+
+class TestBacktracking(util.TestCase):
+    """Test CSS parser regular expression backtracking."""
+
+    MARKUP = """
+    <div id="div">
+    <p id="0" class="a" data-x="1">Text</p>
+    <p id="1" class="b" data-x="2">Text</p>
+    <p id="2" class="c" data-x="3">Text</p>
+    </div>
+    """
+
+    def assert_fast_syntax_error(self, pattern):
+        """Assert the pattern fails with a syntax error quickly."""
+
+        start = time.perf_counter()
+        with self.assertRaises(sv.SelectorSyntaxError):
+            sv.compile(pattern)
+        self.assertLess(time.perf_counter() - start, 1)
+
+    def test_attribute_whitespace_backtracking(self):
+        """A malformed attribute with a long run of whitespace should fail quickly."""
+
+        start = time.perf_counter()
+        for selector in ('[a' + ' ' * 20000 + '!', '[a=b' + ' ' * 20000 + '!'):
+            with self.assertRaises(sv.SelectorSyntaxError):
+                sv.compile(selector)
+        self.assertLess(time.perf_counter() - start, 5)
+
+    def test_attribute_escape_backtracking(self):
+        """A malformed attribute value with many escapes should fail quickly on every Python version."""
+
+        # One-digit hex escapes: each could match as hex or as a non-hex escape.
+        self.assert_fast_syntax_error('[a=' + ('\\9' * 1000) + '!]')
+        # Multi-digit hex escapes that could be split into several shorter escapes.
+        self.assert_fast_syntax_error('[a=' + ('\\123' * 1000) + '!]')
+        self.assert_fast_syntax_error('[a=' + ('\\123456' * 1000) + '!]')
+        self.assert_fast_syntax_error('[a=' + ('\\aaaaaaa' * 1000) + '!]')
+
+    def test_attribute_whitespace_still_matches(self):
+        """Whitespace and comments within attribute selectors still parse."""
+
+        self.assert_selector(
+            self.MARKUP,
+            '[ /* c */ data-x \t = \r\n "2" /* c */ i ]',
+            ['1'],
+            flags=util.HTML
+        )
+
+    def test_nth_whitespace_comments_still_match(self):
+        """Whitespace and comments within `nth` selectors still parse."""
+
+        self.assert_selector(
+            self.MARKUP,
+            'p:nth-child( 2n /* c */ + /* c */ 1 )',
+            ['0', '2'],
+            flags=util.HTML
+        )
+        self.assert_selector(
+            self.MARKUP,
+            'p:nth-child(1 /* c */ of /* c */ .b)',
+            ['1'],
+            flags=util.HTML
+        )
+
+    def test_combinators_still_match(self):
+        """Combinators surrounded by whitespace, newlines and comments still parse."""
+
+        self.assert_selector(
+            self.MARKUP,
+            '#div /* c */\r\n>\r\n/* c */ p.a ,\n\f p.c',
+            ['0', '2'],
+            flags=util.HTML
+        )
+
+    def test_escapes_still_match(self):
+        """CSS escapes still parse, including uppercase hex and the 6-digit form."""
+
+        self.assert_selector(
+            self.MARKUP,
+            '#\\31 , #\\32',
+            ['1', '2'],
+            flags=util.HTML
+        )
+        self.assert_selector(
+            self.MARKUP,
+            '[data-x=\\31]',
+            ['0'],
+            flags=util.HTML
+        )
+        self.assert_selector(
+            self.MARKUP,
+            '[data-x=\\000032]',
+            ['1'],
+            flags=util.HTML
+        )
+        self.assert_selector(
+            self.MARKUP,
+            '.\\62 ',
+            ['1'],
+            flags=util.HTML
+        )

