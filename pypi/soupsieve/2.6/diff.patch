@@ -0,0 +1,62 @@
+"""Test that selector parsing does not suffer from excessive regular expression backtracking."""
+import time
+import unittest
+import soupsieve as sv
+from .. import util
+
+
+class TestRegexBacktracking(util.TestCase):
+    """Test patterns that previously caused excessive regular expression backtracking."""
+
+    # Generous upper bound. Fixed code finishes in a few milliseconds.
+    LIMIT = 1.0
+
+    def assert_fast_syntax_error(self, pattern):
+        """Assert the pattern fails with a syntax error quickly."""
+
+        start = time.time()
+        with self.assertRaises(sv.SelectorSyntaxError):
+            sv.compile(pattern)
+        self.assertLess(time.time() - start, self.LIMIT)
+
+    def test_unterminated_attribute_identifier(self):
+        """Test a long identifier attribute value that is never closed."""
+
+        self.assert_fast_syntax_error('[a=' + ('a' * 16) + '!')
+
+    def test_long_identifier_followed_by_namespace_separator(self):
+        """Test a long identifier followed by an incomplete namespace."""
+
+        self.assert_fast_syntax_error(('a' * 8000) + '|')
+
+    def test_trailing_whitespace_then_invalid(self):
+        """Test long whitespace runs inside a pattern."""
+
+        self.assert_fast_syntax_error('a' + (' ' * 8000) + '!')
+        self.assert_fast_syntax_error(':is(a' + (' ' * 8000) + 'x')
+
+    def test_trailing_whitespace_and_comments_ignored(self):
+        """Test leading and trailing whitespace and comments are still ignored."""
+
+        markup = '<div><p id="a" class="b">text</p></div>'
+        soup = self.soup(markup, 'html.parser')
+        for pattern in (
+            ' /* c */ p.b \t\r\n/* c */ \n ',
+            'p.b' + (' ' * 5000),
+            '[id=a]  /**/ ',
+            '[id="a"]\r\n',
+            '.\\62 ' + ' ',
+        ):
+            self.assertEqual(len(sv.select(pattern, soup)), 1)
+
+    def test_identifier_escapes(self):
+        """Test identifier escapes still parse correctly."""
+
+        markup = '<div><p id="a" class="bc">text</p></div>'
+        soup = self.soup(markup, 'html.parser')
+        for pattern in ('.\\62 c', '.\\000062c', '.b\\63', '[id=\\61]', '[id=\\61 ]'):
+            self.assertEqual(len(sv.select(pattern, soup)), 1, pattern)
+
+
+if __name__ == '__main__':  # pragma: no cover
+    unittest.main()

