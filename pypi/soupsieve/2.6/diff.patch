@@ -0,0 +1,77 @@
+"""Test that CSS parsing patterns do not suffer from excessive backtracking."""
+import signal
+import unittest
+
+import soupsieve as sv
+
+from .. import util
+
+
+class _Timeout(Exception):
+    """Timeout exception."""
+
+
+def _timeout_handler(signum, frame):
+    """Raise on timeout."""
+
+    raise _Timeout
+
+
+@unittest.skipUnless(hasattr(signal, 'SIGALRM'), 'SIGALRM is not available')
+class TestBacktracking(util.TestCase):
+    """Test patterns that previously triggered catastrophic backtracking."""
+
+    def assert_fast(self, selector, expected=None):
+        """Assert that compiling the selector completes quickly."""
+
+        old = signal.signal(signal.SIGALRM, _timeout_handler)
+        signal.alarm(3)
+        try:
+            if expected is None:
+                sv.compile(selector)
+            else:
+                with self.assertRaises(expected):
+                    sv.compile(selector)
+        except _Timeout:
+            self.fail('Selector compilation took too long')
+        finally:
+            signal.alarm(0)
+            signal.signal(signal.SIGALRM, old)
+
+    def test_ambiguous_hex_escapes(self):
+        """Test repeated escapes that could be matched in more than one way."""
+
+        self.assert_fast('[a' + ('\\9' * 40) + '=x]')
+
+    def test_ambiguous_hex_escapes_identifier(self):
+        """Test repeated escapes in an identifier."""
+
+        self.assert_fast('.a' + ('\\9' * 40))
+
+    def test_long_hex_escapes(self):
+        """Test long hex escapes."""
+
+        self.assert_fast('[a' + ('\\012345' * 500) + '=x]')
+
+    def test_unclosed_value_escapes(self):
+        """Test an unclosed attribute value with many escapes."""
+
+        self.assert_fast('[a=x' + ('\\9' * 40) + '!]', sv.SelectorSyntaxError)
+
+    def test_trailing_whitespace(self):
+        """Test a large amount of whitespace followed by invalid content."""
+
+        self.assert_fast('div' + (' ' * 20000) + '!', sv.SelectorSyntaxError)
+
+    def test_escaped_identifier_still_matches(self):
+        """Test escaped identifiers and attribute values still match as expected."""
+
+        markup = """
+        <div id="0"><p id="1" class="bc" data-x="a b">x</p><p id="2" class="d" data-x="'q">y</p></div>
+        """
+
+        self.assert_selector(markup, r'.\62\63', ['1'], flags=util.HTML)
+        self.assert_selector(markup, r'.\62 \63', ['1'], flags=util.HTML)
+        self.assert_selector(markup, r'[data-x="a\20 b"]', ['1'], flags=util.HTML)
+        self.assert_selector(markup, r"[data-x='\'q']", ['2'], flags=util.HTML)
+        self.assert_selector(markup, r'[d\61 ta-x=\61]', [], flags=util.HTML)

