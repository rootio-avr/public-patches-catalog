+"""Test that selector parsing does not exhibit excessive regex backtracking (ReDoS)."""
+import sys
+import time
+import unittest
+import soupsieve as sv
+
+SIZE = 20000
+LIMIT = 2.0
+
+
+class TestRegexBacktracking(unittest.TestCase):
+    """Test selector parsing with pathological input."""
+
+    def assert_fast_failure(self, selector):
+        """Compile an invalid selector and ensure it fails promptly instead of backtracking."""
+
+        start = time.perf_counter()
+        with self.assertRaises(sv.SelectorSyntaxError):
+            sv.compile(selector)
+        self.assertLess(time.perf_counter() - start, LIMIT)
+
+    @unittest.skipIf(sys.version_info < (3, 11), 'Possessive quantifiers require Python 3.11+')
+    def test_pathological_selectors(self):
+        """Test pathological selectors fail quickly."""
+
+        spaces = ' ' * SIZE
+        selectors = [
+            f'div{spaces}x!',
+            f'{spaces}!',
+            f'[a=b{spaces}x',
+            f':nth-child(1{spaces}x',
+            f':nth-child(n{spaces}+',
+            f':nth-child(1 {spaces}x',
+            f':lang("a"{spaces}x',
+            f':dir(ltr{spaces}x',
+            f':is(a{spaces}x',
+            f'a{spaces}!',
+            'a' + '\\1' * (SIZE // 2) + '!',
+            'a' + ' /**/' * (SIZE // 5) + '!',
+            '[a' + ' /**/' * (SIZE // 5) + '=',
+            'a' + '\r\n' * (SIZE // 2) + '!',
+            ('a' * SIZE) + '|',
+        ]
+        for selector in selectors:
+            with self.subTest(selector=selector[:30]):
+                self.assert_fast_failure(selector)
+
+    def test_attribute_namespace_operator(self):
+        """Test that `|=` is not mistaken for a namespace separator."""
+
+        self.assertEqual(len(sv.compile('[lang|=en]').selectors), 1)
+        self.assertEqual(len(sv.compile('[ns|lang|=en]').selectors), 1)
+        self.assertEqual(len(sv.compile('[*|lang]').selectors), 1)
+
+    def test_long_valid_selectors(self):
+        """Test long but valid selectors still compile."""
+
+        sv.compile('div' + ' /**/ ' * 1000 + 'p')
+        sv.compile('[a="' + 'x' * SIZE + '"]')
+        sv.compile('.' + 'a' * SIZE)
+        sv.compile('a' + ' ' * SIZE)

