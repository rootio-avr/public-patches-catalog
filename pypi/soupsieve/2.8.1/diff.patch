+"""Test that ambiguous CSS escape sequences do not cause catastrophic backtracking."""
+import platform
+from .. import util
+import soupsieve as sv
+
+
+class TestEscapeBacktracking(util.TestCase):
+    """Test escape sequence backtracking."""
+
+    def _run_with_timeout(self, pattern, seconds=3):
+        """Compile the pattern, failing if it does not complete in a reasonable time."""
+
+        if platform.system() == 'Windows':  # pragma: no cover
+            try:
+                sv.compile(pattern)
+            except sv.SelectorSyntaxError:
+                pass
+            return
+
+        import signal
+
+        def timeout_handler(signum, frame):
+            raise TimeoutError
+
+        signal.signal(signal.SIGALRM, timeout_handler)
+        signal.alarm(seconds)
+        try:
+            try:
+                sv.compile(pattern)
+            except sv.SelectorSyntaxError:
+                pass
+        except TimeoutError:  # pragma: no cover
+            self.fail('Selector compile timed out due to excessive backtracking')
+        finally:
+            signal.alarm(0)
+
+    def test_ambiguous_escapes_attribute_name(self):
+        """Test a series of ambiguous digit escapes in an attribute name."""
+
+        self._run_with_timeout('[' + ('\\11' * 40) + '!')
+
+    def test_ambiguous_escapes_tag(self):
+        """Test a series of ambiguous digit escapes in a tag name."""
+
+        self._run_with_timeout(('\\11' * 40) + '!')
+
+    def test_long_identifier_with_escapes(self):
+        """Test long valid identifiers with escapes still parse."""
+
+        self.assert_selector(
+            '<div><p id="a1b">text</p></div>',
+            '#a\\31 b',
+            ['a1b'],
+            flags=util.HTML
+        )
+        self.assertIsNotNone(sv.compile('[\\31 23' + 'a' * 5000 + ']'))
