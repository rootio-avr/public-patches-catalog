+            key = (id(parent), id(relation), self.iframe_restrict)
+            if key in self.cached_ancestors:
+                found = self.cached_ancestors[key]
+                break
+            visited.append(key)
+            found = self.match_selectors(parent, relation)
+            parent = self.get_parent(parent, no_iframe=self.iframe_restrict)
+
+        for key in visited:
+            self.cached_ancestors[key] = found
+
+        return found
