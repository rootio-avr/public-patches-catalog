+"""Test that malformed selectors are rejected quickly (no catastrophic regular expression backtracking)."""
+import time
+import unittest
+import soupsieve as sv
+
+MAX_SECONDS = 5.0
+
+
+class TestRegexBacktracking(unittest.TestCase):
+    """Test that malformed input does not cause excessive backtracking."""
+
+    def assert_fast(self, selector):
+        """Compile a (possibly invalid) selector and ensure it finishes quickly."""
+
+        start = time.time()
+        try:
+            sv.compile(selector)
+        except sv.util.SelectorSyntaxError:
+            pass
+        self.assertLess(time.time() - start, MAX_SECONDS)
+
+    def test_unterminated_double_quote(self):
+        """Test unterminated double quoted attribute value."""
+
+        self.assert_fast('[a="' + 'a' * 5000)
+
+    def test_unterminated_single_quote(self):
+        """Test unterminated single quoted attribute value."""
+
+        self.assert_fast("[a='" + 'a' * 5000)
+
+    def test_identifier_value_bad_end(self):
+        """Test long identifier value followed by invalid content."""
+
+        self.assert_fast('[a=' + 'a' * 5000 + '!]')
+
+    def test_identifier_escapes(self):
+        """Test long identifier made of escapes followed by invalid content."""
+
+        self.assert_fast('#' + '\\aa' * 2000 + '!')
+        self.assert_fast('[a=' + '\\aaaaaaa' * 1000 + '!]')
+
+    def test_lang_unterminated(self):
+        """Test unterminated quoted string in `:lang()`."""
+
+        self.assert_fast(':lang("' + 'a' * 5000)
+
+    def test_trailing_whitespace(self):
+        """Test a long run of whitespace before invalid content."""
+
+        self.assert_fast('a' + ' ' * 20000 + '!')
+        self.assert_fast('[a=b' + ' ' * 20000 + 'x]')
+
+    def test_escapes_still_parse(self):
+        """Test that escape handling is unchanged for valid input."""
+
+        self.assertEqual(
+            sv.compile('#\\31 23, .a\\:b, [a="b\\"c"], [a=\\61bc]').selectors[0].ids,
+            ('123',)
+        )
+        self.assertEqual(
+            sv.compile('#\\00006123').selectors[0].ids,
+            ('a23',)
+        )

