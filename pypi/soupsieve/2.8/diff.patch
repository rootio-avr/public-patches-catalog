+"""Regression tests for CVE-2026-126191 (ReDoS via catastrophic backtracking in CSS parsing regexes)."""
+import time
+import pytest
+import soupsieve as sv
+from soupsieve import SelectorSyntaxError
+
+# Generous upper bound: the vulnerable patterns need minutes (or effectively forever) on these inputs.
+TIME_LIMIT = 2.0
+
+
+def _timed_compile(selector):
+    """Compile a selector, returning the elapsed time and the exception raised (if any)."""
+
+    start = time.perf_counter()
+    error = None
+    try:
+        sv.compile(selector)
+    except SelectorSyntaxError as e:
+        error = e
+    return time.perf_counter() - start, error
+
+
+@pytest.mark.parametrize(
+    'selector',
+    [
+        '[' + '\\9' * 40 + '!',
+        '\\9' * 40 + '!',
+        '[' + '\\123456' * 40 + '!',
+        '[' + '\\1234567' * 40 + '!',
+        '[a=' + 'a' * 40 + '!',
+        '[a="' + 'a' * 5000,
+        '[a="' + '\\9' * 40,
+        ':lang(' + '\\9' * 40 + '!',
+    ]
+)
+def test_malformed_selector_does_not_backtrack_exponentially(selector):
+    """Malformed selectors with ambiguous escape runs must fail fast."""
+
+    elapsed, error = _timed_compile(selector)
+    assert elapsed < TIME_LIMIT
+    assert error is not None
+
+
+def test_escapes_still_parse():
+    """Valid escapes, hex escapes of various lengths, and quoted values are unaffected."""
+
+    for selector in (
+        '\\9',
+        '\\31 23',
+        '\\000031',
+        '#\\31 23',
+        '.\\31\\32\\33',
+        '[\\9="\\9 value"]',
+        '[a="va\\"lue"]',
+        "[a='va\\'lue']",
+        '[a=value i]',
+        '--custom',
+        '-a\\-b',
+        ':lang("*-de", en)',
+    ):
+        elapsed, error = _timed_compile(selector)
+        assert elapsed < TIME_LIMIT
+        assert error is None, selector

