+    def test_escape_backtracking(self):
+        """Test that runs of ambiguous escapes do not cause catastrophic backtracking (ReDoS)."""
+
+        import time
+        import soupsieve as sv
+
+        for selector in (
+            '[' + '\\9' * 40 + '!',
+            '\\9' * 40 + '!',
+            '\\1' * 40 + '!',
+            '.' + '\\a' * 40 + '!',
+            '[' + '\\9' * 40,
+        ):
+            start = time.time()
+            with self.assertRaises(sv.SelectorSyntaxError):
+                sv.compile(selector)
+            self.assertLess(time.time() - start, 5)
+
+        # Hex escapes still consume at most 6 digits followed by an optional whitespace.
+        markup = """
+        <div>
+        <p id="0" class="bar1">Text</p>
+        <p id="1" class="barz">Text</p>
+        </div>
+        """
+
+        self.assert_selector(
+            markup,
+            ".\\000062ar1",
+            ["0"],
+            flags=util.HTML
+        )
+
+        self.assert_selector(
+            markup,
+            ".\\62 arz",
+            ["1"],
+            flags=util.HTML
+        )

