+        self.assert_selector(markup, "section p span", ["4", "12"], flags=util.HTML)
+        self.assert_selector(markup, "div p, section span", ["3", "4", "7", "11", "12"], flags=util.HTML)
+        self.assert_selector(markup, "div section p span", ["12"], flags=util.HTML)
+        self.assert_selector(markup, "section :not(div p)", ["2", "4", "5", "12"], flags=util.HTML)
+
+    def test_many_descendant_combinators(self):
+        """Test that every combinator tries each ancestor once in a deeply nested document."""
+
+        import soupsieve as sv
+        from bs4 import BeautifulSoup
+        from unittest import mock
+
+        n = 32
