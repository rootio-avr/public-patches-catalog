@@ -0,0 +1,84 @@
+"""Test that selector parsing does not suffer from excessive regex backtracking."""
+import platform
+import unittest
+import soupsieve as sv
+
+SIZE = 5000
+
+
+class TestRegexBacktracking(unittest.TestCase):
+    """Test pathological inputs fail (or pass) quickly instead of backtracking excessively."""
+
+    def run_timed(self, func):
+        """Run the function, failing if it does not complete in a reasonable amount of time."""
+
+        if platform.system() == 'Windows':
+            func()
+            return
+
+        import signal
+
+        def timeout_handler(signum, frame):
+            raise TimeoutError
+
+        old = signal.signal(signal.SIGALRM, timeout_handler)
+        signal.alarm(3)
+        passed = False
+        try:
+            func()
+            passed = True
+        except TimeoutError:
+            pass
+        finally:
+            signal.alarm(0)
+            signal.signal(signal.SIGALRM, old)
+        self.assertTrue(passed, 'Selector parsing took too long')
+
+    def assert_syntax_error(self, pattern):
+        """Assert the pattern is rejected with a syntax error, and does so quickly."""
+
+        def func():
+            with self.assertRaises(sv.SelectorSyntaxError):
+                sv.compile(pattern)
+
+        self.run_timed(func)
+
+    def test_unquoted_attribute_value(self):
+        """Test an unclosed attribute with a long unquoted value."""
+
+        self.assert_syntax_error('[a=' + ('x' * SIZE))
+
+    def test_unquoted_attribute_value_escapes(self):
+        """Test an unclosed attribute with a long unquoted value containing escapes."""
+
+        self.assert_syntax_error('[a=' + ('x\\a' * SIZE) + '"')
+        self.assert_syntax_error('[a=' + ('\\aaaaaa' * SIZE) + '"')
+
+    def test_lang_value(self):
+        """Test a malformed `:lang()` with a long value."""
+
+        self.assert_syntax_error(':lang(' + ('a-' * SIZE) + '\x00')
+
+    def test_namespace_identifier(self):
+        """Test long identifiers that fail to match as a namespace."""
+
+        self.assert_syntax_error('a' * SIZE + '|')
+        self.assert_syntax_error('[' + ('a' * SIZE) + '|')
+
+    def test_trailing_whitespace_and_comments(self):
+        """Test long runs of whitespace and comments around an invalid selector."""
+
+        self.assert_syntax_error('a' + (' ' * SIZE) + '!')
+        self.assert_syntax_error('a !' + (' ' * SIZE))
+        self.assert_syntax_error('a' + ('/**/' * SIZE) + '!')
+        self.assert_syntax_error('a !' + ('/**/' * SIZE))
+
+    def test_long_valid_selectors_still_parse(self):
+        """Test that the reworked patterns still accept valid identifiers, escapes, and trailing whitespace."""
+
+        def func():
+            sv.compile('[a=' + ('x' * SIZE) + ']')
+            sv.compile('.' + ('\\000061' * 100) + '  /* comment */  \n')
+            sv.compile('#a\\61 b\\000061c\\0000610 > p   ')
+
+        self.run_timed(func)

