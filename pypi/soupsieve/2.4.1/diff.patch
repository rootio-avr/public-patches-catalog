@@ -0,0 +1,61 @@
+"""Test that CSS parsing patterns do not exhibit catastrophic regex backtracking."""
+import time
+import unittest
+
+import soupsieve as sv
+
+
+class TestRegexBacktracking(unittest.TestCase):
+    """Test patterns that previously caused exponential regex backtracking."""
+
+    # Each case previously took seconds to minutes (exponential in `n`) with `n` this small.
+    MAX_TIME = 2.0
+
+    def assert_fast(self, selector):
+        """Compile the selector, ignoring syntax errors, and ensure it completes quickly."""
+
+        start = time.time()
+        try:
+            sv.compile(selector)
+        except sv.SelectorSyntaxError:
+            pass
+        self.assertLess(time.time() - start, self.MAX_TIME)
+
+    def test_ambiguous_escapes_attribute(self):
+        """Test repeated ambiguous escapes in an attribute name."""
+
+        self.assert_fast('[a' + '\\9' * 40 + '=x]')
+        self.assert_fast('[a' + '\\9' * 40)
+
+    def test_ambiguous_escapes_tag(self):
+        """Test repeated ambiguous escapes in a tag name."""
+
+        self.assert_fast('a' + '\\9' * 40 + '!')
+
+    def test_multi_digit_escapes(self):
+        """Test repeated multi-digit hex escapes."""
+
+        self.assert_fast('[a' + '\\12345' * 40 + '=x')
+
+    def test_unterminated_string(self):
+        """Test unterminated quoted values."""
+
+        self.assert_fast('[a="' + 'a' * 5000)
+        self.assert_fast('[a="' + '\\9' * 40)
+
+    def test_value_identifier(self):
+        """Test long identifiers used as values."""
+
+        self.assert_fast('[a=' + 'b' * 40 + '!')
+        self.assert_fast(':lang(' + 'a' * 40 + '!')
+        self.assert_fast(':lang(' + '\\9' * 40 + '!')
+        self.assert_fast(':-soup-contains(' + 'a' * 40 + '!')
+
+    def test_escapes_still_match(self):
+        """Test that valid escapes are still parsed correctly."""
+
+        self.assertEqual(sv.compile('\\31 23').selectors[0].tag.name, '123')
+        self.assertEqual(sv.compile('a\\31 23').selectors[0].tag.name, 'a123')
+        self.assertEqual(sv.compile('\\000031').selectors[0].tag.name, '1')
+        self.assertEqual(sv.compile('\\0000311').selectors[0].tag.name, '11')
+        self.assertEqual(sv.compile('\\.a').selectors[0].tag.name, '.a')
