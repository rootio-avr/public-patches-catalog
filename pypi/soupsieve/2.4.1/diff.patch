+"""Test that malformed selectors do not cause catastrophic regular expression backtracking."""
+import time
+import unittest
+import soupsieve as sv
+
+
+class TestReDoS(unittest.TestCase):
+    """Test selector compilation of pathological input completes quickly."""
+
+    # Generous upper bound; vulnerable code needs minutes to years for these inputs.
+    LIMIT = 5.0
+
+    def assert_fast_failure(self, pattern):
+        """Assert that an invalid pattern is rejected promptly."""
+
+        start = time.time()
+        with self.assertRaises(sv.SelectorSyntaxError):
+            sv.compile(pattern)
+        self.assertLess(time.time() - start, self.LIMIT)
+
+    def test_attribute_name_escapes(self):
+        """Test a run of ambiguous escapes in an attribute name."""
+
+        self.assert_fast_failure('[' + '\\9' * 40 + '!]')
+
+    def test_attribute_name_hex_escapes(self):
+        """Test a run of six digit escapes in an attribute name."""
+
+        self.assert_fast_failure('[' + '\\aaaaaa' * 40 + '!]')
+
+    def test_tag_escapes(self):
+        """Test a run of ambiguous escapes in a tag name."""
+
+        self.assert_fast_failure('\\9' * 40 + '!')
+
+    def test_attribute_value_escapes(self):
+        """Test a run of ambiguous escapes in an attribute value."""
+
+        self.assert_fast_failure('[a=' + '\\9' * 40 + '!]')
+
+    def test_attribute_value_identifier(self):
+        """Test a long unquoted attribute value that fails to terminate."""
+
+        self.assert_fast_failure('[a=' + 'a' * 400 + '!')
+
+    def test_unterminated_string_value(self):
+        """Test a long unterminated quoted string value."""
+
+        self.assert_fast_failure('[a="' + 'ab' * 400)
+
+    def test_valid_escapes_still_match(self):
+        """Test that escapes are still parsed correctly."""
+
+        self.assertEqual(sv.compile('[\\61 b\\62=c\\\\d]').pattern, '[\\61 b\\62=c\\\\d]')
+        self.assertEqual(sv.compile('.\\31 23\\65 f').pattern, '.\\31 23\\65 f')
+        self.assertEqual(sv.compile('[a="x\\\r\ny"]').pattern, '[a="x\\\r\ny"]')

