+++ b/tests/test_extra/test_regex_backtracking.py
@@ -0,0 +1,40 @@
+"""Test that the CSS parsing regular expressions do not backtrack catastrophically."""
+import time
+import pytest
+import soupsieve as sv
+
+# Each payload is crafted so that an ambiguous escape/newline pattern can be matched in many ways
+# before the overall match fails.
+PAYLOADS = [
+    '[' + r'\1' * 60 + '!',
+    '[a=' + r'\000000' * 30 + '!',
+    '.' + r'\1' * 60 + '|!',
+    ':lang(' + r'\1' * 60 + '!',
+    ':is(' + r'\1' * 60 + ')x',
+    '[a="' + '\\\r' * 60,
+    "[a='" + '\\\r' * 60,
+    '[a="' + '\\\r\n' * 60 + '!',
+]
+
+
+@pytest.mark.parametrize('pattern', PAYLOADS)
+def test_no_catastrophic_backtracking(pattern):
+    """Malformed selectors should fail (or pass) quickly instead of hanging."""
+
+    start = time.perf_counter()
+    try:
+        sv.compile(pattern)
+    except sv.SelectorSyntaxError:
+        pass
+    assert time.perf_counter() - start < 2.0
+
+
+def test_escapes_still_parse():
+    """Escapes should still be parsed correctly."""
+
+    assert sv.compile(r'.\31 23').selectors
+    assert sv.compile(r'.\000031 23').selectors
+    assert sv.compile(r'.\0000417').selectors
+    assert sv.compile(r'.a\:b\!c').selectors
+    assert sv.compile('[a="b\\\r\nc"]').selectors
+    assert sv.compile("[a='b\\\rc']").selectors
