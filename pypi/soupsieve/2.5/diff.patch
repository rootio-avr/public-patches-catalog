+++ b/tests/test_cve_2026_126191.py
@@ -0,0 +1,77 @@
+"""Regression tests for excessive regular expression backtracking when parsing CSS selectors (CVE-2026-126191)."""
+import signal
+import unittest
+import soupsieve as sv
+
+TIMEOUT = 10
+
+
+class Timeout(Exception):
+    """Selector parsing did not finish in time."""
+
+
+def _on_alarm(signum, frame):
+    """Abort a runaway parse."""
+
+    raise Timeout()
+
+
+def compile_with_timeout(pattern):
+    """Compile a selector and fail instead of hanging if parsing does not finish in time."""
+
+    old = signal.signal(signal.SIGALRM, _on_alarm)
+    signal.alarm(TIMEOUT)
+    try:
+        sv.compile(pattern)
+        return 'ok'
+    except sv.SelectorSyntaxError:
+        return 'error'
+    except Timeout:
+        return 'timeout'
+    finally:
+        signal.alarm(0)
+        signal.signal(signal.SIGALRM, old)
+
+
+@unittest.skipUnless(hasattr(signal, 'SIGALRM'), 'Requires SIGALRM to guard against runaway regular expressions')
+class TestBacktracking(unittest.TestCase):
+    """Test that crafted selectors are rejected or parsed quickly rather than backtracking excessively."""
+
+    def test_unterminated_quoted_value(self):
+        """Unterminated quoted strings used to cause exponential backtracking."""
+
+        for quote in ('"', "'"):
+            for pattern in (
+                '[a={q}{v}'.format(q=quote, v='a' * 64),
+                '[a={q}{v}'.format(q=quote, v='ab\\a' * 32),
+                ':-soup-contains({q}{v}'.format(q=quote, v='a' * 64),
+                ':lang({q}{v}'.format(q=quote, v='a' * 64),
+            ):
+                self.assertEqual(compile_with_timeout(pattern), 'error', pattern)
+
+    def test_long_whitespace(self):
+        """Long runs of whitespace used to be rescanned from every position, taking quadratic time."""
+
+        for pattern in (
+            'a' + ' ' * 50000 + '\x00',
+            '[a' + ' ' * 50000 + '!',
+            ':is(' + ' ' * 50000 + '!',
+            ':nth-child(n' + ' ' * 50000 + 'x',
+        ):
+            self.assertNotEqual(compile_with_timeout(pattern), 'timeout', pattern[:20])
+
+    def test_valid_selectors_still_parse(self):
+        """Valid selectors, including strings, escapes, and surrounding whitespace and comments, still parse."""
+
+        for pattern in (
+            '[a="b c"]',
+            "[a='b\\'c' i]",
+            '[a="b\\\nc"]',
+            '[ns|a|=b]',
+            'ns|a',
+            ':nth-child(2n + 1 of p)',
+            ':lang("en", fr)',
+            '.\\31 23',
+            '/* start */ div > p /* end */  \n',
+        ):
+            self.assertEqual(compile_with_timeout(pattern), 'ok', pattern)
