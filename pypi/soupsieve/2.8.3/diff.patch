+def trailing_ws_start(pattern: str) -> int:
+    """
+    Find the start of the whitespace and comments that trail the pattern.
+
+    Equivalent to searching for `{WSC}*$`, but scans the pattern once instead of retrying from every
+    position, which is quadratic for patterns with long runs of whitespace or comments.
