@@ -0,0 +1,56 @@
+"""Test that hex escapes stay unambiguous after the possessive-quantifier hardening."""
+import signal
+import unittest
+import soupsieve as sv
+
+
+class TestHexEscapeBacktracking(unittest.TestCase):
+    """Malformed hex escapes must fail as syntax errors, not by timing out."""
+
+    def assert_syntax_error_quickly(self, pattern):
+        """Compile a bad pattern and make sure it fails for syntax reasons and not by timing out."""
+
+        def timeout_handler(signum, frame):
+            raise TimeoutError
+
+        signal.signal(signal.SIGALRM, timeout_handler)
+        signal.alarm(3)
+        passed = False
+        try:
+            with self.assertRaises(sv.SelectorSyntaxError):
+                sv.compile(pattern)
+            passed = True
+        except TimeoutError:
+            pass
+        finally:
+            signal.alarm(0)
+        self.assertTrue(passed, 'Selector took too long to parse')
+
+    def test_attribute_name_escapes(self):
+        """Test a chain of ambiguous escapes in an attribute name."""
+
+        self.assert_syntax_error_quickly('[' + '\\9' * 200 + '!')
+
+    def test_tag_escapes(self):
+        """Test a chain of ambiguous escapes in a tag name."""
+
+        self.assert_syntax_error_quickly('\\9' * 200 + '!')
+
+    def test_long_hex_escapes(self):
+        """Test a chain of escapes with more hex digits than an escape can consume."""
+
+        self.assert_syntax_error_quickly('[' + '\\aaaaaaa' * 200 + '!')
+
+    def test_unclosed_string_escapes(self):
+        """Test an unclosed string full of escaped newlines."""
+
+        self.assert_syntax_error_quickly('[a="' + '\\\r' * 200)
+        self.assert_syntax_error_quickly("[a='" + '\\\f' * 200)
+
+    def test_escapes_still_parse(self):
+        """Test that valid escapes are still parsed as before."""
+
+        self.assertEqual(sv.compile('\\31 23').selectors[0].tag.name, '123')
+        self.assertEqual(sv.compile('\\000031 23').selectors[0].tag.name, '123')
+        self.assertEqual(sv.compile('\\0000311').selectors[0].tag.name, '11')
+        self.assertEqual(sv.compile('\\9 a\\@b').selectors[0].tag.name, '\ta@b')
