+    length = len(pattern)
+    # A comment can only be closed if there is a `*/` after the opening `/*`
+    close = pattern.rfind('*/')
+    start = -1
+    pos = 0
+
+    while pos < length:
+        if start < 0:
+            # Not in a run of whitespace/comments, skip ahead to where one could start.
+            m = RE_WS_FIND.search(pattern, pos)
+            if m is None:
+                break
+            pos = m.start(0)
+
