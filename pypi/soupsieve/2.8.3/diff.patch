@@ -0,0 +1,108 @@
+"""Test that selector parsing does not exhibit catastrophic or quadratic backtracking (ReDoS)."""
+import signal
+import time
+import unittest
+
+import soupsieve as sv
+from soupsieve import css_parser as cp
+from .. import util
+
+# Possessive quantifiers are only used on Python versions that support them reliably.
+POSSESSIVE = bool(cp.PQ)
+
+# Time allowed for compiling a pathological selector. Without the fix these take many seconds to minutes.
+LIMIT = 3
+
+
+class TestReDoS(util.TestCase):
+    """Test that pathological selectors fail (or compile) quickly."""
+
+    def compile_quickly(self, pattern, **kwargs):
+        """Compile the pattern, failing the test if it takes too long. Return the exception or `None`."""
+
+        def timeout_handler(signum, frame):
+            raise TimeoutError
+
+        signal.signal(signal.SIGALRM, timeout_handler)
+        signal.alarm(LIMIT)
+        start = time.time()
+        error = None
+        try:
+            sv.compile(pattern, **kwargs)
+        except TimeoutError:
+            self.fail('Selector took too long to parse')
+        except (sv.SelectorSyntaxError, NotImplementedError) as e:
+            error = e
+        finally:
+            signal.alarm(0)
+        self.assertLess(time.time() - start, LIMIT)
+        return error
+
+    def test_trailing_whitespace(self):
+        """Test a long run of whitespace that is not at the end of the pattern."""
+
+        self.assertIsNotNone(self.compile_quickly('a' + (' ' * 50000) + '@'))
+
+    def test_trailing_comments(self):
+        """Test a long run of comments that is not at the end of the pattern."""
+
+        self.assertIsNotNone(self.compile_quickly('a' + ('/**/' * 20000) + '/'))
+
+    def test_unclosed_comments(self):
+        """Test many unclosed comments."""
+
+        self.assertIsNotNone(self.compile_quickly('a' + ('/*x' * 20000)))
+
+    def test_pseudo_class_whitespace(self):
+        """Test long whitespace in pseudo-classes."""
+
+        for selector in (':is(a' + (' ' * 50000) + 'x', ':nth-child(1n' + (' ' * 50000) + 'x', ':dir(ltr' + (' ' * 50000) + '!'):
+            self.assertIsNotNone(self.compile_quickly(selector))
+
+    def test_attribute_whitespace(self):
+        """Test long whitespace in attribute selectors."""
+
+        self.assertIsNotNone(self.compile_quickly('[a=b' + (' ' * 50000) + 'x'))
+
+    @unittest.skipUnless(POSSESSIVE, 'Requires possessive quantifier support (Python 3.11.5+)')
+    def test_attribute_unclosed(self):
+        """Test long identifiers and namespaces in unclosed attribute selectors."""
+
