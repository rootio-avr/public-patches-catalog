+"""Regression test for CVE-2026-63349 / GHSA-3w57-8xmc-8v26.
+
+``anyio.open_process()`` mistakenly forwarded the value of the ``group``
+argument to the backend under the ``extra_groups`` keyword, so callers that
+supplied ``extra_groups`` had that value silently ignored (and the ``group``
+value applied instead).  This is a privilege-management flaw (CWE-266): a
+process could be launched with different supplementary groups than the caller
+requested.  The test below ensures every argument -- and ``extra_groups`` in
+particular -- is passed through to the backend unchanged.
+
+The test suite runs with ``anyio_mode = "auto"``, so the async test function
+is collected automatically without an explicit marker.
+"""
+
+from __future__ import annotations
+
+import sys
+from subprocess import DEVNULL
+from typing import Any
+
+from pytest_mock.plugin import MockerFixture
+
+from anyio import open_process
+from anyio._core._eventloop import get_async_backend
+
+
+async def test_extra_groups_passed_through(mocker: MockerFixture) -> None:
+    command = [sys.executable, "-c", "pass"]
+    kwargs: dict[str, Any] = {
+        "stdin": DEVNULL,
+        "stdout": DEVNULL,
+        "stderr": DEVNULL,
+        "cwd": "/tmp",
+        "env": {"FOO": "bar"},
+        "start_new_session": True,
+        "user": "myuser",
+        "group": "mygroup",
+        "extra_groups": [1, 2, "foo"],
+        "umask": 123,
+    }
+    mock_open_process = mocker.patch.object(get_async_backend(), "open_process")
+    await open_process(command, **kwargs)
+
+    mock_open_process.assert_called_once_with(command, **kwargs)
+    _, forwarded = mock_open_process.call_args
+    # The regression: extra_groups must forward its own value, not `group`.
+    assert forwarded["extra_groups"] == [1, 2, "foo"]
+    assert forwarded["extra_groups"] != forwarded["group"]
