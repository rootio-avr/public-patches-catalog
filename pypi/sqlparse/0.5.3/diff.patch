+"""Regression test for CVE-2026-54284.
+
+Quadratic-time grouping DoS (CWE-407): TokenList group values were
+recomputed by re-flattening the whole subtree (``str(self)`` /
+``str(start)``) on every grouping step, making deeply nested statements
+scale quadratically and enabling a denial of service. The fix builds the
+group value directly from child token values instead.
+
+This test guards against a performance regression by ensuring a deeply
+nested input parses well within a generous time budget, and that parsing
+still round-trips the input unchanged.
+"""
+import time
+
+import sqlparse
+
+
+def test_deep_nesting_parses_quickly():
+    # Deeply nested parentheses previously triggered quadratic grouping.
+    depth = 500
+    sql = 'select ' + '(' * depth + '1' + ')' * depth
+
+    start = time.monotonic()
+    parsed = sqlparse.parse(sql)
+    elapsed = time.monotonic() - start
+
+    assert parsed
+    # Round-trip must be preserved by the group-value change.
+    assert str(parsed[0]) == sql
+    # Generous budget: the quadratic behavior blows well past this.
+    assert elapsed < 10.0
+
+
+def test_group_value_matches_flattened():
+    # The group value must equal the concatenation of child values.
+    parsed = sqlparse.parse('select (a + (b + c)) from t')[0]
+    assert str(parsed) == 'select (a + (b + c)) from t'

