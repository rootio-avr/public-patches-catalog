+"""Regression test for CVE-2026-71491 / GHSA-f2ff-p2ww-7p4p.
+
+Quadratic (O(n**2)) CPU consumption in ``group_comments`` on comment-only
+input. A statement made only of single-line comments lexes in O(n), but the
+vulnerable ``group_comments`` rescanned the O(n) remaining tokens for every
+comment token, giving O(n**2) total work. ``group_comments`` runs before the
+``MAX_GROUPING_TOKENS`` guard, so the token cap did not protect this vector.
+
+Grounded on the upstream benchmark ``benchmarks/validate_group_comments_dos.py``
+added by fix commit ef2012a5eeb491e604dea2b00d516904a3830c87. The patched code
+scales roughly linearly; the vulnerable code scales quadratically.
+"""
+
+import time
+
+import sqlparse
+
+
+def _payload(n):
+    """A comment-only statement of ``n`` single-line comments."""
+    return '-- c\n' * n
+
+
+def test_comment_only_input_still_parses():
+    # Correctness must be preserved: comment-only input still parses and the
+    # comment content survives round-tripping.
+    sql = _payload(5)
+    parsed = sqlparse.parse(sql)
+    assert parsed
+    assert str(parsed[0]) == sql
+
+
+def test_group_comments_scales_linearly():
+    # With the quadratic bug, doubling the input roughly quadruples the time;
+    # once fixed it roughly doubles. Measure the average per-doubling growth
+    # ratio and require it to be closer to linear (2x) than quadratic (4x).
+    sizes = (1000, 2000, 4000, 8000)
+    timings = []
+    for n in sizes:
+        sql = _payload(n)
+        t0 = time.perf_counter()
+        sqlparse.parse(sql)
+        timings.append(time.perf_counter() - t0)
+
+    ratios = [b / a for a, b in zip(timings, timings[1:]) if a > 0]
+    assert ratios, "timing measurement produced no usable ratios"
+    avg = sum(ratios) / len(ratios)
+    # Midpoint between linear (2x) and quadratic (4x) is 3x. The unpatched
+    # code sits near 4x; the patched code near 2x.
+    assert avg < 3.0, f"group_comments scaling looks quadratic (avg {avg:.2f}x)"
+
+
+def test_strip_comments_on_comment_only_input():
+    # The vulnerable path is also reachable via format(strip_comments=True).
+    out = sqlparse.format(_payload(50), strip_comments=True)
+    assert '-- c' not in out

