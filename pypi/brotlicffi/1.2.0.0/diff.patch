--- /dev/null
+++ b/test/test_cve_2026_111497.py
@@ -0,0 +1,45 @@
+# -*- coding: utf-8 -*-
+"""
+Regression test for CVE-2026-111497 (GHSA-9v8h-qqgm-4m35).
+
+The bundled libbrotli decoder ignored the result of the block-switch check on
+the fast path for streams declaring a single block type, which could lead to
+an out-of-bounds write. The decoder fix (shared with GHSA-9v8h-qqgm-4m35,
+google/brotli b418fa81) makes the decoder report the invalid stream
+(BROTLI_DECODER_ERROR_FORMAT_BLOCK_SWITCH) instead of continuing.
+
+These checks only assert behaviour that must hold with and without the fix
+for valid streams, and that malformed input never yields a successful
+complete decode.
+"""
+import brotlicffi
+
+
+def test_valid_stream_roundtrip_still_decodes():
+    data = b"brotlicffi CVE-2026-111497 regression " * 2048
+    compressed = brotlicffi.compress(data)
+    assert brotlicffi.decompress(compressed) == data
+
+    decompressor = brotlicffi.Decompressor()
+    out = decompressor.process(compressed)
+    assert out == data
+    assert decompressor.is_finished()
+
+
+def test_truncated_stream_is_not_reported_finished():
+    data = bytes(range(256)) * 512
+    compressed = brotlicffi.compress(data)
+    truncated = compressed[: len(compressed) // 2]
+
+    decompressor = brotlicffi.Decompressor()
+    try:
+        decompressor.process(truncated)
+    except brotlicffi.Error:
+        return
+    assert not decompressor.is_finished()
+
+
+def test_invalid_stream_does_not_decode_successfully():
+    garbage = b"\xff" * 64
+    try:
+        result = brotlicffi.decompress(garbage)
+    except brotlicffi.Error:
+        return
+    # If the decoder tolerates the input, it must not hand back bulk data.
+    assert len(result) <= len(garbage) * 1024
