@@ -0,0 +1,47 @@
+import pytest
+
+from starlette.datastructures import URL
+
+
+def _scope(host, path="/foo", **extra):
+    scope = {
+        "scheme": "http",
+        "path": path,
+        "query_string": b"",
+        "headers": [(b"host", host)],
+        "server": ("testserver", 80),
+    }
+    scope.update(extra)
+    return scope
+
+
+@pytest.mark.parametrize(
+    "host",
+    [
+        b"example.com",
+        b"example.com:8000",
+        b"127.0.0.1:80",
+        b"[::1]",
+        b"[2001:db8::1]:8080",
+    ],
+)
+def test_valid_host_header_is_used(host):
+    url = URL(scope=_scope(host))
+    assert str(url) == "http://%s/foo" % host.decode()
+    assert url.path == "/foo"
+
+
+@pytest.mark.parametrize(
+    "host",
+    [
+        b"example.com/evil",
+        b"example.com?x=",
+        b"example.com#frag",
+        b"user@example.com",
+        b"example.com/admin#",
+    ],
+)
+def test_malformed_host_header_does_not_alter_path(host):
+    url = URL(scope=_scope(host, path="/public"))
+    assert url.path == "/public"
+    assert url.hostname == "testserver"
