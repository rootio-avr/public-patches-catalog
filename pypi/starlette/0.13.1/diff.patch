--- a/tests/test_cve_2026_48710.py
+++ b/tests/test_cve_2026_48710.py
@@ -0,0 +1,42 @@
+import pytest
+
+from starlette.datastructures import URL
+
+
+def _scope(host, server=None):
+    return {
+        "scheme": "http",
+        "path": "/safe",
+        "query_string": b"",
+        "headers": [(b"host", host.encode("latin-1"))],
+        "server": server,
+    }
+
+
+@pytest.mark.parametrize(
+    "host",
+    ["evil.com/injected?", "evil.com#", "user@evil.com", "evil.com?x=", "a b"],
+)
+def test_url_ignores_malformed_host_header(host):
+    url = URL(scope=_scope(host))
+    assert url.path == "/safe"
+    assert url.netloc == ""
+
+    url = URL(scope=_scope(host, server=("example.org", 80)))
+    assert url.path == "/safe"
+    assert url.netloc == "example.org"
+
+
+@pytest.mark.parametrize(
+    "host,netloc",
+    [
+        ("example.org", "example.org"),
+        ("example.org:8000", "example.org:8000"),
+        ("127.0.0.1:80", "127.0.0.1:80"),
+        ("[::1]:8000", "[::1]:8000"),
+    ],
+)
+def test_url_accepts_valid_host_header(host, netloc):
+    url = URL(scope=_scope(host))
+    assert url.path == "/safe"
+    assert url.netloc == netloc
