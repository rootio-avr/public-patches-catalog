+def _png_chunk(tag, data):
+    return (
+        struct.pack(">I", len(data))
+        + tag
+        + data
+        + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
+    )
+
+
+def test_icns_decompression_bomb():
+    # An ICNS container holding a PNG that reports an enormous size must be
+    # rejected before any pixel memory is allocated.
+    ihdr = struct.pack(">IIBBBBB", 65535, 65535, 8, 6, 0, 0, 0)
+    png = (
+        b"\x89PNG\r\n\x1a\n"
+        + _png_chunk(b"IHDR", ihdr)
+        + _png_chunk(b"IDAT", b"")
+    )
+    block = b"ic10" + struct.pack(">I", 8 + len(png)) + png
+    data = b"icns" + struct.pack(">I", 8 + len(block)) + block
+
+    with pytest.raises(Image.DecompressionBombError):
+        with Image.open(io.BytesIO(data)) as im:
+            im.load()

