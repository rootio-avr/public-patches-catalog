+@pytest.mark.parametrize("bpc", [1, 2])
+def test_rle_oob_read(tmp_path, bpc):
+    # CVE-2021-25293: RLE data running past the end of the file must raise
+    # an error instead of reading out of bounds.
+    header = bytearray(512)
+    header[0:2] = b"\x01\xda"  # magic
+    header[2] = 1  # storage: RLE
+    header[3] = bpc
+    header[4:6] = (2).to_bytes(2, "big")  # dimension
+    header[6:8] = (8).to_bytes(2, "big")  # xsize
+    header[8:10] = (1).to_bytes(2, "big")  # ysize
+    header[10:12] = (1).to_bytes(2, "big")  # zsize
+    header[16:20] = (1).to_bytes(4, "big")  # pixmin/max
+    # offset table, length table: one row starting at the very end of the
+    # file, claiming several RLE chunks
+    tables = (512 + 8).to_bytes(4, "big") + (200).to_bytes(4, "big")
+    # a copy chunk of 7 atoms with no data following it
+    data = bytes(header) + tables + (b"\x00\x87" if bpc == 2 else b"\x87")
+
+    path = tmp_path / "oob.sgi"
+    path.write_bytes(data)
+
+    with Image.open(str(path)) as im:
+        with pytest.raises(OSError):
+            im.load()

