+
+def test_mic_n_frames_not_reset_by_tiff_reopen():
+    # MicImageFile re-opens an embedded TIFF on every seek(); that must not
+    # overwrite the frame count, otherwise TiffImageFile.n_frames can loop
+    # forever on a crafted file (CVE-2026-112390).
+    with Image.open(TEST_FILE) as im:
+        assert isinstance(im, MicImagePlugin.MicImageFile)
+        assert im.n_frames == 1
+
+        im._n_frames = 2
+        im.frame = -1
+        im.seek(0)
+        assert im.n_frames == 2
+
+
+def test_mic_is_animated_not_reset_by_tiff_reopen():
+    with Image.open(TEST_FILE) as im:
+        assert isinstance(im, MicImagePlugin.MicImageFile)
+        assert not im.is_animated
+
+        im.is_animated = True
+        im.frame = -1
+        im.seek(0)
+        assert im.is_animated
+
+
+def test_mic_still_loads():
+    with Image.open(TEST_FILE) as im:
+        im.load()
+        assert im.size == (128, 128)
