+++ b/Tests/test_cve_2026_112892.py
@@ -0,0 +1,27 @@
+import io
+import struct
+
+from PIL import Image
+
+
+def _rle_msp(width, height, rows):
+    header = bytearray(b"LinS")
+    header += struct.pack("<HH", width, height)
+    header += b"\x00" * (32 - len(header))
+    checksum = 0
+    for i in range(0, 32, 2):
+        checksum ^= struct.unpack_from("<H", header, i)[0]
+    struct.pack_into("<H", header, 12, checksum)
+    rowmap = struct.pack(f"<{height}H", *(len(r) for r in rows))
+    return bytes(header) + rowmap + b"".join(rows)
+
+
+def test_oversized_rle_run_is_clamped():
+    # The first run claims 255 bytes although the row only needs 1 byte;
+    # the decoder must not produce more than the image width for a row.
+    rows = [b"\x00\xff\xaa", b"\x01\x55"]
+    data = _rle_msp(8, 2, rows)
+    with Image.open(io.BytesIO(data)) as im:
+        im.load()
+        assert im.size == (8, 2)
+        assert im.tobytes() == b"\xaa\xaa"
