+def test_trailer_loop():
+    b = BytesIO()
+    with PdfParser(f=b, mode="wb") as pdf:
+        pdf.start_writing()
+        pdf.write_header()
+        pdf.write_catalog()
+        # Make the trailer's /Prev point to its own xref section
+        pdf.last_xref_section_offset = b.tell()
+        pdf.write_xref_and_trailer()
+
+    with pytest.raises(PdfFormatError, match="trailer loop found"):
+        PdfParser(f=b)
+
+
+def test_long_trailer_chain():
+    b = BytesIO()
+    with PdfParser(f=b, mode="wb") as pdf:
+        pdf.start_writing()
+        pdf.write_header()
+
+        pdf.write_catalog()
+        for _ in range(3000):
+            pdf.write_xref_and_trailer()
+        pdf.write_xref_and_trailer()
+
+    with PdfParser(f=b):
+        pass
+
+
+def _write_page_tree(depth, loop=False):
+    b = BytesIO()
+    with PdfParser(f=b, mode="wb") as pdf:
+        pdf.start_writing()
+        pdf.write_header()
+
+        root_ref = pdf.next_object_id(b.tell())
+        refs = [pdf.next_object_id(0)]
+        pdf.write_obj(root_ref, Type=PdfName(b"Catalog"), Pages=refs[0])
+        for _ in range(depth):
+            refs.append(pdf.next_object_id(0))
+        for i, ref in enumerate(refs):
+            if i + 1 < len(refs):
+                kids = [refs[i + 1]]
+            else:
+                kids = [refs[0]] if loop else []
+            pdf.write_obj(ref, Type=PdfName(b"Pages"), Count=0, Kids=kids)
+        pdf.root_ref = root_ref
+        pdf.write_xref_and_trailer()
+    return b
+
+
+def test_page_tree_loop():
+    b = _write_page_tree(1, loop=True)
+    with pytest.raises(PdfFormatError, match="cyclic or duplicate reference"):
+        PdfParser(f=b)
+
+
+def test_deep_page_tree():
+    b = _write_page_tree(3000)
+    with PdfParser(f=b) as pdf:
+        assert pdf.pages == []

