Reject undersized buffer strides in ImagingMapBuffer (CVE-2026-54058)

Pillow before 12.3.0 only recalculated stride when it was <= 0. A crafted
McIDAS (or other memory-mapped) image could declare a positive stride smaller
than a full row, causing row pointers to be laid out inside the mapped buffer
and reading past it. Always force stride to at least xsize * pixelsize.

--- a/src/map.c
+++ b/src/map.c
@@ -84,14 +84,16 @@
 
     const ModeID mode = findModeID(mode_name);
 
-    if (stride <= 0) {
-        if (mode == IMAGING_MODE_L || mode == IMAGING_MODE_P) {
-            stride = xsize;
-        } else if (isModeI16(mode)) {
-            stride = xsize * 2;
-        } else {
-            stride = xsize * 4;
-        }
+    int pixelsize;
+    if (mode == IMAGING_MODE_L || mode == IMAGING_MODE_P) {
+        pixelsize = 1;
+    } else if (isModeI16(mode)) {
+        pixelsize = 2;
+    } else {
+        pixelsize = 4;
+    }
+    if (stride <= xsize * pixelsize) {
+        stride = xsize * pixelsize;
     }
 
     if (stride > 0 && ysize > PY_SSIZE_T_MAX / stride) {
--- a/Tests/test_file_mcidas.py
+++ b/Tests/test_file_mcidas.py
@@ -1,5 +1,8 @@
