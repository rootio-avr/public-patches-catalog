+def import_module_class(dotted_path, model_name_or_path=None, trust_remote_code=False):
+    """
+    Import a module class referenced by a model's configuration, enforcing a trust gate.
+
+    A model configuration (``modules.json``, ``config.json``, ``wordembedding_config.json``, ...)
+    controls which class is imported for each module. Classes inside the ``sentence_transformers.*``
+    namespace ship with this package and are always safe to import. Any other dotted path is code
+    selected by a (potentially untrusted) model, and importing it executes arbitrary third-party
+    code. Such an import is therefore only permitted when the caller explicitly passes
+    ``trust_remote_code=True``.
+
+    A locally-existing model directory is intentionally NOT treated as implicitly trusted: an
+    attacker who can influence the contents of a local model directory (e.g. a downloaded, cloned
+    or mounted model repository) could otherwise achieve arbitrary code execution even though the
+    caller explicitly passed ``trust_remote_code=False`` (CVE-2026-68770).
+
+    Raises ValueError when an untrusted, non-sentence_transformers class is referenced without
+    ``trust_remote_code=True``.
+    """
+    if dotted_path.startswith("sentence_transformers."):
+        return import_from_string(dotted_path)
+
+    if not trust_remote_code:
+        raise ValueError(
+            "The model {!r} references the module class {!r}, which is not part of "
+            "`sentence_transformers`. Importing it executes arbitrary third-party code. If you "
+            "trust this model, pass `trust_remote_code=True` to allow loading it.".format(
+                model_name_or_path, dotted_path
+            )
+        )
+
+    return import_from_string(dotted_path)
+
