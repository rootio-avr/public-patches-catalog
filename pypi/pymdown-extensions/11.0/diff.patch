@@ -0,0 +1,50 @@
+"""Regression test for CVE-2026-67422 (ReDoS in BetterEm, Caret, Tilde, MagicLink).
+
+The vulnerable regex patterns allowed catastrophic backtracking on crafted
+input. The fix rewrites the nested-emphasis / URL patterns so malicious input
+completes quickly, while normal markup still renders correctly.
+"""
+import time
+import markdown
+
+
+def _render(text, extensions):
+    return markdown.markdown(text, extensions=extensions)
+
+
+def test_caret_redos_terminates_quickly():
+    """A long run of carets must not hang (catastrophic backtracking)."""
+    payload = '^' + ('a^' * 5000)
+    start = time.time()
+    _render(payload, ['pymdownx.caret'])
+    assert time.time() - start < 5
+
+
+def test_tilde_redos_terminates_quickly():
+    payload = '~' + ('a~' * 5000)
+    start = time.time()
+    _render(payload, ['pymdownx.tilde'])
+    assert time.time() - start < 5
+
+
+def test_betterem_redos_terminates_quickly():
+    payload = '*' + ('a*' * 5000)
+    start = time.time()
+    _render(payload, ['pymdownx.betterem'])
+    assert time.time() - start < 5
+
+
+def test_magiclink_redos_terminates_quickly():
+    payload = 'http://' + ('a.' * 5000)
+    start = time.time()
+    _render(payload, ['pymdownx.magiclink'])
+    assert time.time() - start < 5
+
+
+def test_semantics_preserved():
+    """Normal emphasis / sub / sup / autolink markup still renders."""
+    assert '<sup>' in _render('^test^', ['pymdownx.caret'])
+    assert '<sub>' in _render('~test~', ['pymdownx.tilde'])
+    assert '<em>' in _render('*test*', ['pymdownx.betterem'])
+    out = _render('Visit http://www.example.com now', ['pymdownx.magiclink'])
+    assert '<a href="http://www.example.com"' in out
