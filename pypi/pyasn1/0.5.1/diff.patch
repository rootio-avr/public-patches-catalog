+
+                    assert supplied < len(substrate), 'Decoder did not resume'
+                    position = stream.tell()
+                    stream.seek(0, io.SEEK_END)
+                    supplied += stream.write(substrate[supplied:supplied + 3])
+                    stream.seek(position)
+                    underruns += 1
