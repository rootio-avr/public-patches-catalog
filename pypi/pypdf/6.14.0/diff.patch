Avoid infinite loops for incomplete ASCII85 and ASCIIHex inline images

CVE-2026-59935: When decoding inline images with the ASCIIHexDecode or
ASCII85Decode filters, extract_inline__ascii_hex_decode and
extract_inline__ascii85_decode read data with
`read_non_whitespace(stream) + stream.read(BUFFER_SIZE)`. When the stream
is truncated, `stream.read(BUFFER_SIZE)` returns b"" while
`read_non_whitespace` may still return the trailing buffered byte, so
`data_buffered` never becomes empty. The loop then keeps seeking back by
two bytes without ever making progress, resulting in an infinite loop
(denial of service) on malformed/incomplete inline images.

Detect the actual end of stream by inspecting the freshly read bytes and
raise PdfReadError when nothing more can be read.

--- a/pypdf/generic/_image_inline.py
+++ b/pypdf/generic/_image_inline.py
@@ -61,9 +61,9 @@ def extract_inline__ascii_hex_decode(stream: StreamType) -> bytes:
     data_out = bytearray()
     # Read data until delimiter > and EI as backup.
     while True:
-        data_buffered = read_non_whitespace(stream) + stream.read(BUFFER_SIZE)
-        if not data_buffered:
-            raise PdfReadError("Unexpected end of stream")
+        data_buffered = read_non_whitespace(stream) + (read_bytes := stream.read(BUFFER_SIZE))
+        if not data_buffered or not read_bytes:
+            raise PdfReadError("Unexpected end of stream.")
         pos_tok = data_buffered.find(b">")
         if pos_tok >= 0:  # found >
             data_out += data_buffered[: pos_tok + 1]
@@ -81,13 +81,13 @@ def extract_inline__ascii_hex_decode(stream: StreamType) -> bytes:
             break
         if len(data_buffered) == 2:
             data_out += data_buffered
-            raise PdfReadError("Unexpected end of stream")
+            raise PdfReadError("Unexpected end of stream.")
         # Neither > nor EI found
         data_out += data_buffered[:-2]
         stream.seek(-2, 1)

     if not _check_end_image_marker(stream):
-        raise PdfReadError("EI stream not found")
+        raise PdfReadError("EI stream not found.")
     return bytes(data_out)


@@ -99,9 +99,9 @@ def extract_inline__ascii85_decode(stream: StreamType) -> bytes:
     data_out = bytearray()
     # Read data until delimiter ~>
     while True:
-        data_buffered = read_non_whitespace(stream) + stream.read(BUFFER_SIZE)
-        if not data_buffered:
-            raise PdfReadError("Unexpected end of stream")
+        data_buffered = read_non_whitespace(stream) + (read_bytes := stream.read(BUFFER_SIZE))
+        if not data_buffered or not read_bytes:
+            raise PdfReadError("Unexpected end of stream.")
         pos_tok = data_buffered.find(b"~>")
         if pos_tok >= 0:  # found!
             data_out += data_buffered[: pos_tok + 2]
@@ -109,14 +109,14 @@ def extract_inline__ascii85_decode(stream: StreamType) -> bytes:
             break
         if len(data_buffered) == 2:  # end of buffer
             data_out += data_buffered
-            raise PdfReadError("Unexpected end of stream")
+            raise PdfReadError("Unexpected end of stream.")
         data_out += data_buffered[
             :-2
         ]  # back by one char in case of in the middle of ~>
         stream.seek(-2, 1)

     if not _check_end_image_marker(stream):
-        raise PdfReadError("EI stream not found")
+        raise PdfReadError("EI stream not found.")
     return bytes(data_out)


