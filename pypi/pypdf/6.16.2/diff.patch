+def get_stream_data(stream: StreamType) -> bytes:
+    """
+    Get the full data of the stream without changing its current position.
+
+    Args:
+        stream: The data stream to read from.
+
+    Returns:
+        The complete data of the stream.
+
+    """
+    if hasattr(stream, "getbuffer"):
+        return bytes(stream.getbuffer())
+
+    position = stream.tell()
+    stream.seek(0, SEEK_SET)
+    data = stream.read(-1)
+    stream.seek(position)
+    return cast(bytes, data)
 
 
