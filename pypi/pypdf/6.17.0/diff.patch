+    ) if should_raise else nullcontext()
+    with context:
+        obj = function(stream)
+        assert obj.idnum == int("2" * 64)
+        assert obj.generation == 2
+
+    stream = BytesIO(b"2" * 100)
+    with context:
+        obj = function(stream)
+        assert obj.idnum == int("2" * 64)
