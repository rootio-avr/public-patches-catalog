+"""Regression test for CVE-2026-59936.
+
+Detect end of stream during inline image end marker detection so that a
+broken/truncated content stream raises a controlled PdfStreamError instead
+of looping/hanging. Grounded on the upstream fix commit
+ec3b14596186c40caca7cf8ab9b2155203e01b5b.
+"""
+from io import BytesIO
+
+import pytest
+
+from pypdf.errors import PdfStreamError
+from pypdf.generic import ContentStream
+
+
+def test_content_stream__read_inline_image__end_of_stream() -> None:
+    # Broken content stream, for example due to filter errors.
+    # Specific example:
+    #   Error -3 while decompressing data: invalid distance too far back
+    #   b'q 0.1 0 0 0.1 0 0 cm\n/R7 gs\n0 g\nq 4.8 0 0 -135.6 2155.08 7150.48 cm\nBI\n/IM true\n/W001'
+    content_stream = ContentStream(stream=None, pdf=None)
+
+    with pytest.raises(
+        expected_exception=PdfStreamError, match=r"^Unexpected end of stream\.$"
+    ):
+        content_stream._read_inline_image(BytesIO(b"\n/IM true\n/W001"))

