+import hashlib
+import base64
+from unittest import TestCase
+
+from oauthlib.oauth2.rfc6749.grant_types import authorization_code as ac
+
+
+class PKCECompareTest(TestCase):
+    """PKCE verifier/challenge comparison must be constant-time and robust."""
+
+    def test_s256_valid(self):
+        verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
+        challenge = base64.urlsafe_b64encode(
+            hashlib.sha256(verifier.encode()).digest()
+        ).decode().rstrip('=')
+        self.assertTrue(ac.code_challenge_method_s256(verifier, challenge))
+        self.assertFalse(ac.code_challenge_method_s256(verifier, challenge[:-1] + "x"))
+
+    def test_s256_non_ascii_challenge(self):
+        self.assertFalse(ac.code_challenge_method_s256("verifier", "café"))
+
+    def test_plain(self):
