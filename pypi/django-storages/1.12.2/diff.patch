+def _validate_file_name(name):
+    """
+    Reject names that could escape the storage location. Equivalent to
+    django.core.files.utils.validate_file_name(name, allow_relative_path=True)
+    which is not available (or lacks ``allow_relative_path``) in older Django.
+    """
+    if os.path.basename(name) in {"", ".", ".."}:
+        raise SuspiciousFileOperation(
+            "Could not derive file name from '%s'" % name
+        )
+    path = pathlib.PurePosixPath(str(name).replace("\\", "/"))
+    if path.is_absolute() or ".." in path.parts:
+        raise SuspiciousFileOperation(
+            "Detected path traversal attempt in '%s'" % name
+        )
+    return name
+
