@@ -0,0 +1,14 @@
+from __future__ import annotations
+
+import pytest
+
+from airflow.utils.log.secrets_masker import DEFAULT_SENSITIVE_FIELDS, should_hide_value_for_key
+
+
+@pytest.mark.parametrize("key", ["proxy", "proxies", "HTTP_PROXY", "https_proxy", "proxies_config"])
+def test_proxy_keys_are_sensitive(key):
+    assert should_hide_value_for_key(key)
+
+
+def test_proxy_in_default_sensitive_fields():
+    assert {"proxy", "proxies"} <= DEFAULT_SENSITIVE_FIELDS
