From fb008dd700b761d955210d9692475c3e2f379453 Mon Sep 17 00:00:00 2001
From: Marcelo Trylesinski <marcelotryle@gmail.com>
Date: Sun, 2 Aug 2026 09:36:34 +0100
Subject: [PATCH] Start TLS for wss scheme in SOCKS5 proxy connections (#1104)

CVE-2026-84381: httpx2 2.7.0 pins httpcore2==2.7.0, where wss through SOCKS5
skips TLS. Require the fixed httpcore2 release and make the sdist buildable
outside the monorepo. Upstream fix:
https://github.com/pydantic/httpx2/commit/fb008dd700b761d955210d9692475c3e2f379453
---
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -2,9 +2,6 @@
 requires = ["hatchling", "hatch-fancy-pypi-readme", "uv-dynamic-versioning>=0.8.0"]
 build-backend = "hatchling.build"
 
-[tool.hatch.version]
-source = "uv-dynamic-versioning"
-
 [tool.uv-dynamic-versioning]
 vcs = "git"
 style = "pep440"
@@ -13,6 +10,7 @@
 
 [project]
 name = "httpx2"
+version = "2.7.0"
 description = "The next generation HTTP client."
 license = "BSD-3-Clause"
 requires-python = ">=3.10"
@@ -40,12 +38,12 @@
     "Programming Language :: Python :: 3.14",
     "Topic :: Internet :: WWW/HTTP",
 ]
-dynamic = ["readme", "version", "dependencies"]
+dynamic = ["readme", "dependencies"]
 
 [tool.hatch.metadata.hooks.uv-dynamic-versioning]
 dependencies = [
     "truststore>=0.10",
-    "httpcore2=={{ version }}",
+    "httpcore2>=2.10.0",
     "anyio>=4.10",
     "idna>=3.18",
     "typing_extensions>=4.5.0; python_version < '3.13'",
@@ -84,11 +82,7 @@
 Source = "https://github.com/pydantic/httpx2"
 
 [tool.hatch.build.targets.sdist]
-include = ["/httpx2", "/CHANGELOG.md"]
-
-[tool.hatch.build.targets.sdist.force-include]
-"../../README.md" = "README.md"
-"../../LICENSE.md" = "LICENSE.md"
+include = ["/httpx2", "/CHANGELOG.md", "/README.md", "/LICENSE.md"]
 
 [tool.hatch.build.targets.wheel]
 packages = ["httpx2"]
--- a/PKG-INFO
+++ b/PKG-INFO
@@ -26,7 +26,7 @@
 Classifier: Topic :: Internet :: WWW/HTTP
 Requires-Python: >=3.10
 Requires-Dist: anyio>=4.10
-Requires-Dist: httpcore2==2.7.0
+Requires-Dist: httpcore2>=2.10.0
 Requires-Dist: idna>=3.18
 Requires-Dist: truststore>=0.10
 Requires-Dist: typing-extensions>=4.5.0; python_version < '3.13'

From 4fd0c70a3f207c618b145934792f791bccfb39f8 Mon Sep 17 00:00:00 2001
From: Marcelo Trylesinski <marcelotryle@gmail.com>
Date: Tue, 18 Aug 2026 15:12:47 +0200
Subject: [PATCH] Decode compressed response bodies incrementally (#1126)

CVE-2026-84382: Bound peak memory while streaming gzip/deflate/br/zstd
responses. Backported from
https://github.com/pydantic/httpx2/commit/4fd0c70a3f207c618b145934792f791bccfb39f8
---
--- a/httpx2/_decoders.py
+++ b/httpx2/_decoders.py
