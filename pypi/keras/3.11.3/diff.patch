+"""Regression tests: `from_config` fails closed when `safe_mode` is unset."""
+
+import pytest
+
+from keras.src import layers
+from keras.src import testing
+from keras.src.saving.serialization_lib import SafeModeScope
+
+
+class FailClosedSafeModeTest(testing.TestCase):
+    def test_lambda_from_config_fails_closed_without_scope(self):
+        config = layers.Lambda(lambda x: x**2).get_config()
+        with self.assertRaisesRegex(ValueError, "Lambda"):
+            layers.Lambda.from_config(config)
+
+    def test_lambda_from_config_explicit_opt_out(self):
+        config = layers.Lambda(lambda x: x**2).get_config()
+        layer = layers.Lambda.from_config(config, safe_mode=False)
+        self.assertIsInstance(layer, layers.Lambda)
+        with SafeModeScope(safe_mode=False):
+            layer = layers.Lambda.from_config(
+                layers.Lambda(lambda x: x**2).get_config()
+            )
+        self.assertIsInstance(layer, layers.Lambda)
+
+    def test_torch_module_wrapper_from_config_fails_closed(self):
+        torch = pytest.importorskip("torch")
+        from keras.src.utils.torch_utils import TorchModuleWrapper
+
+        module = torch.nn.Sequential(torch.nn.Linear(2, 4))
+        config = TorchModuleWrapper(module).get_config()
+        with self.assertRaisesRegex(ValueError, "torch.load"):
+            TorchModuleWrapper.from_config(dict(config))
+        new_mw = TorchModuleWrapper.from_config(dict(config), safe_mode=False)
+        self.assertIsInstance(new_mw, TorchModuleWrapper)

