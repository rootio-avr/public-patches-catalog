@@ -0,0 +1,29 @@
+"""Regression test for AIKIDO-2026-949486.
+
+The vendored certifi CA bundle must not trust the compromised eMudhra
+"emSign ECC Root CA - G3" root, and must still be a usable PEM bundle.
+"""
+import os
+
+from pip._vendor import certifi
+
+
+def _read_bundle():
+    with open(certifi.where()) as f:
+        return f.read()
+
+
+def test_cabundle_exists():
+    assert os.path.exists(certifi.where())
+
+
+def test_bundle_contains_certificates():
+    assert "-----BEGIN CERTIFICATE-----" in _read_bundle()
+
+
+def test_compromised_emudhra_root_removed():
+    assert "emSign ECC Root CA - G3" not in _read_bundle()
+
+
+def test_certifi_version_bumped():
+    assert certifi.__version__ == "2026.10.19"

