+"""Regression test: distrusted CA roots must not be in the vendored bundle."""
+
+from pip._vendor import certifi
+
+DISTRUSTED_FINGERPRINTS = {
+    # Atos TrustedRoot 2011
+    "f3:56:be:a2:44:b7:a9:1e:b3:5d:53:ca:9a:d7:86:4a:ce:01:8e:2d:35:d5:f8:f9:6d:df:68:a6:f4:1a:a4:74",
+    # emSign ECC Root CA - G3
+    "86:a1:ec:ba:08:9c:4a:8d:3b:be:27:34:c6:12:ba:34:1d:81:3e:04:3c:f9:e8:a8:62:cd:5c:57:a3:6b:be:6b",
+}
+
+DISTRUSTED_LABELS = (
+    '# Label: "Atos TrustedRoot 2011"',
+    '# Label: "emSign ECC Root CA - G3"',
+)
+
+
+def test_distrusted_roots_removed_from_bundle() -> None:
+    content = certifi.contents().lower()
+    for fingerprint in DISTRUSTED_FINGERPRINTS:
+        assert fingerprint not in content
+    for label in DISTRUSTED_LABELS:
+        assert label.lower() not in content
+
+
+def test_bundle_still_contains_certificates() -> None:
+    assert "-----BEGIN CERTIFICATE-----" in certifi.contents()
