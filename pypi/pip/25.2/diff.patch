+"""Regression test for AIKIDO-2026-949486.
+
+The vendored certifi bundle must no longer trust the distrusted
+"Atos TrustedRoot 2011" and "emSign ECC Root CA - G3" roots.
+"""
+
+import os
+
+from pip._vendor import certifi
+
+REMOVED_ROOTS = (
+    "Atos TrustedRoot 2011",
+    "emSign ECC Root CA - G3",
+)
+
+
+def test_cabundle_exists() -> None:
+    assert os.path.exists(certifi.where())
+
+
+def test_read_contents() -> None:
+    assert "-----BEGIN CERTIFICATE-----" in certifi.contents()
+
+
+def test_distrusted_roots_removed() -> None:
+    content = certifi.contents()
+    for name in REMOVED_ROOTS:
+        assert f'# Label: "{name}"' not in content
+        assert f"CN={name} " not in content
