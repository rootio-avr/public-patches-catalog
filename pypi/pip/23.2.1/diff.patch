--- /dev/null
+++ b/tests/unit/test_vendor_certifi_bundle.py
@@ -0,0 +1,31 @@
+import base64
+import hashlib
+import re
+
+from pip._vendor import certifi
+
+# SHA-256 fingerprint of "emSign ECC Root CA - G3" (eMudhra), which is
+# distrusted because of compromised intermediate CA keys.
+DISTRUSTED_SHA256 = {
+    "86a1ecba089c4a8d3bbe2734c612ba341d813e043cf9e8a862cd5c57a36bbe6b",
+}
+
+
+def _bundle_fingerprints() -> set:
+    pem = certifi.contents()
+    fingerprints = set()
+    for body in re.findall(
+        r"-----BEGIN CERTIFICATE-----(.*?)-----END CERTIFICATE-----", pem, re.S
+    ):
+        der = base64.b64decode("".join(body.split()))
+        fingerprints.add(hashlib.sha256(der).hexdigest())
+    return fingerprints
+
+
+def test_bundle_is_not_empty() -> None:
+    assert _bundle_fingerprints()
+
+
+def test_compromised_emudhra_root_not_trusted() -> None:
+    assert not (_bundle_fingerprints() & DISTRUSTED_SHA256)
+    assert "emSign ECC Root CA - G3" not in certifi.contents()
