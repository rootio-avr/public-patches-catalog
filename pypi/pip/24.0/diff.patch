+import os
+
+from pip._vendor import certifi
+
+
+def test_cabundle_exists() -> None:
+    assert os.path.exists(certifi.where())
+
+
+def test_read_contents() -> None:
+    content = certifi.contents()
+    assert "-----BEGIN CERTIFICATE-----" in content
+
+
+def test_distrusted_emsign_ecc_root_g3_removed() -> None:
+    content = certifi.contents()
+    assert "emSign ECC Root CA - G3" not in content
+    # Other emSign roots remain trusted.
+    assert "emSign Root CA - G1" in content
+    assert "emSign ECC Root CA - C3" in content
