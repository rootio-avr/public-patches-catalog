+"""Regression test for CVE-2021-3572.
+
+Git.get_full_refs must not split ``git show-ref`` output on unicode line
+separators (e.g. U+0085 NEL, U+2028 LINE SEPARATOR). Using ``str.splitlines``
+would treat such characters embedded in a ref name as line breaks, letting a
+malicious remote smuggle a ref that resolves to a different revision than the
+one the user requested.
+"""
+from mock import Mock
+
+from pip.vcs.git import Git
+
+
+def _refs(output):
+    git = Git()
+    git.run_command = Mock(return_value=output)
+    return dict(git.get_full_refs('/does/not/matter'))
+
+
+def test_get_full_refs_ignores_unicode_line_separators():
+    # A ref name containing a unicode separator must stay a single ref and
+    # must NOT be split into an extra (fake) ref/revision.
+    malicious = 'refs/tags/1.0 refs/tags/evil'
+    output = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa %s\n' % malicious
+    refs = _refs(output)
+    assert refs == {'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa': malicious}
+    # The attacker-controlled trailing segment must not become its own commit.
+    assert 'evil' not in ''.join(refs.keys())
+
+
+def test_get_full_refs_parses_normal_output():
+    output = (
+        'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa refs/heads/master\r\n'
+        'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb refs/tags/1.0\n'
+        '\n'
+    )
+    refs = _refs(output)
+    assert refs == {
+        'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa': 'refs/heads/master',
+        'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb': 'refs/tags/1.0',
+    }

