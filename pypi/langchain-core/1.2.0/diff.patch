+
+        received_kwargs: list[dict[str, Any]] = []
+
+        def capture_kwargs(
+            _class_path: tuple[str, ...], kwargs: dict[str, Any]
+        ) -> None:
+            received_kwargs.append(kwargs)
+
+        load(serialized, allowed_objects=[AIMessage], init_validator=capture_kwargs)
