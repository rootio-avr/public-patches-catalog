From dee85b7039c8fb857c3c86524632265dd95c06ca Mon Sep 17 00:00:00 2001
Date: Mon, 3 Nov 2025 21:34:14 +0530
Subject: [PATCH] Implement trusted hosts feature for debugger and update
 documentation. Only allow requests from specified hosts (localhost,
 .localhost, 127.0.0.1) to enhance security. Update CHANGES.rst for version
 3.0.3 and clarify production usage warnings in debug documentation.

---
 CHANGES.rst                           | 12 +++++++++
 docs/debug.rst                        | 35 +++++++++++++++++++++++----
 src/werkzeug/debug/__init__.py        | 31 +++++++++++++++++++++---
 src/werkzeug/debug/shared/debugger.js |  4 +--
 src/werkzeug/sansio/utils.py          |  2 +-
 src/werkzeug/serving.py               |  3 +++
 6 files changed, 76 insertions(+), 11 deletions(-)

diff --git a/CHANGES.rst b/CHANGES.rst
index 41353ad9..b9d63bf8 100644
--- a/CHANGES.rst
+++ b/CHANGES.rst
@@ -1,5 +1,17 @@
 .. currentmodule:: werkzeug
 
+Version 3.0.3
+-------------
+
+Unreleased
+
+-   Only allow ``localhost``, ``.localhost``, ``127.0.0.1``, or the specified
+    hostname when running the dev server, to make debugger requests. Additional
+    hosts can be added by using the debugger middleware directly. The debugger
+    UI makes requests using the full URL rather than only the path.
+    :ghsa:`2g68-c3qc-8985`
+
+
 Version 2.1.2
 -------------
 
