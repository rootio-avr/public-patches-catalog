+    def testCompressionChainWithLabels(self):
+        # A chain of exactly MAX_COMPRESSION_POINTER_CHAIN pointers that ends
+        # at a real name must decode; one more pointer must be refused.
+        limit = dns.name.MAX_COMPRESSION_POINTER_CHAIN
+        base = b"\x03foo\x00"
+        # Each pointer targets the previous one (or the name for the first).
+        w = base
+        prev = 0
+        for _ in range(limit):
+            start = len(w)
+            w += bytes([0xC0 | (prev >> 8), prev & 0xFF])
+            prev = start
+        name, consumed = dns.name.from_wire(w, prev)
+        self.assertEqual(name, dns.name.from_text("foo."))
+        self.assertEqual(consumed, 2)
+        start = len(w)
+        w += bytes([0xC0 | (prev >> 8), prev & 0xFF])
+        self.assertRaises(dns.name.PointerChainTooLong, dns.name.from_wire, w, start)
+
     def testParent1(self):
         n = dns.name.from_text("foo.bar.")
         self.assertEqual(n.parent(), dns.name.from_text("bar."))
