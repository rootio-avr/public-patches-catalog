--- /dev/null
+++ b/tests/test_aikido_2026_676775.py
@@ -0,0 +1,25 @@
+# Regression test for AIKIDO-2026-676775: unbounded WKS bitmap allocation.
+
+import time
+
+import dns.exception
+import dns.rdata
+import dns.rdataclass
+import dns.rdatatype
+
+
+def test_wks_huge_service_rejected_quickly():
+    start = time.monotonic()
+    for service in ("4294967296", "99999999999", "65536", "-1"):
+        try:
+            dns.rdata.from_text("IN", "WKS", "10.0.0.1 tcp " + service)
+        except dns.exception.SyntaxError:
+            pass
+        else:
+            raise AssertionError("service %s was accepted" % service)
+    assert time.monotonic() - start < 5
+
+
+def test_wks_max_service_bounded_bitmap():
+    rd = dns.rdata.from_text("IN", "WKS", "10.0.0.1 tcp 65535")
+    assert len(rd.bitmap) == 8192
