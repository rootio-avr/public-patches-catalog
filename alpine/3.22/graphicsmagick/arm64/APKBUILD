url="http://www.graphicsmagick.org/"
arch="all"
license="MIT"
makedepends="
	freetype-dev
	libheif-dev
	libltdl
	libpng-dev
	libtool
	libwebp-dev
	libwmf-dev
	libxml2-dev
	tiff-dev
	"
subpackages="$pkgname-dev $pkgname-c++:cpp $pkgname-doc"
source="https://downloads.sourceforge.net/graphicsmagick/graphicsmagick/$pkgver/GraphicsMagick-$pkgver.tar.xz CVE-2007-0770_CVE-2007-0770.patch CVE-2025-27795_CVE-2025-27795.patch CVE-2025-27796_CVE-2025-27796.patch CVE-2025-32460_CVE-2025-32460.patch"
options="libtool"
builddir="$srcdir"/GraphicsMagick-$pkgver

