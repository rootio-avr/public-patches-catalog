+ *
+ * This software is licensed as described in the file COPYING, which
+ * you should have received as part of this distribution. The terms
+ * are also available at https://curl.se/docs/copyright.html.
+ *
+ * You may opt to use, copy, modify, merge, publish, distribute and/or sell
+ * copies of the Software, and permit persons to whom the Software is
+ * furnished to do so, under the terms of the COPYING file.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ * SPDX-License-Identifier: curl
+ *
+ ***************************************************************************/
+/*
+ * Regression test for CVE-2026-6276: a custom Host: header derived cookie
+ * host must NOT survive on a reused easy handle. First request sends a
+ * custom "Host: victim.internal" header; the second request on the same
+ * handle sends no custom Host: header. The second request must send the
+ * real Host: (server IP:port), proving the stale cookiehost was cleared.
+ */
+#include "test.h"
+
+#include "memdebug.h"
+
+static size_t sink2504(char *ptr, size_t size, size_t nmemb, void *ud)
+{
+  (void)ptr;
+  (void)ud;
+  return size * nmemb;
+}
+
+int test(char *URL)
+{
+  CURL *curl = NULL;
+  CURLcode res = CURLE_OK;
+  struct curl_slist *hdrs = NULL;
+
+  global_init(CURL_GLOBAL_ALL);
+
+  easy_init(curl);
+
+  hdrs = curl_slist_append(hdrs, "Host: victim.internal");
+  if(!hdrs) {
+    fprintf(stderr, "curl_slist_append() failed\n");
+    res = TEST_ERR_MAJOR_BAD;
+    goto test_cleanup;
+  }
+
+  /* first request: custom Host: header on a fresh handle */
+  easy_setopt(curl, CURLOPT_WRITEFUNCTION, sink2504);
+  easy_setopt(curl, CURLOPT_COOKIEFILE, "");
+  easy_setopt(curl, CURLOPT_HTTPHEADER, hdrs);
+  easy_setopt(curl, CURLOPT_URL, URL);
+
+  res = curl_easy_perform(curl);
+  printf("req1=%d\n", (int)res);
+  if(res)
+    goto test_cleanup;
+
+  /* second request: reuse the same handle WITHOUT a custom Host: header.
+     The stale cookiehost must have been cleared so the real host is used. */
+  easy_setopt(curl, CURLOPT_HTTPHEADER, NULL);
+  easy_setopt(curl, CURLOPT_URL, URL);
+
+  res = curl_easy_perform(curl);
+  printf("req2=%d\n", (int)res);
+
+test_cleanup:
+  curl_slist_free_all(hdrs);
+  curl_easy_cleanup(curl);
+  curl_global_cleanup();
+
+  return (int)res;
+}
