url="https://gitlab.com/libtiff/libtiff"
arch="all"
license="libtiff"
depends_dev="
	zlib-dev
	zstd-dev
	"
makedepends="
	$depends_dev
	cmake
	libjpeg-turbo-dev
	libwebp-dev
	python3
	samurai
	"
checkdepends="diffutils"
subpackages="$pkgname-doc $pkgname-dev $pkgname-tools libtiffxx"
source="tiff-$pkgver.tar.gz::https://distfiles.alpinelinux.org/distfiles/v3.20/tiff-$pkgver.tar.gz CVE-2025-61144_CVE-2025-61144.patch CVE-2025-8176_CVE-2025-8176.patch CVE-2025-8177_CVE-2025-8177.patch CVE-2026-4775_CVE-2026-4775.patch"

