Patch-Source: https://github.com/nginx/nginx/compare/b81dcfb0b0437190cba5413751c01d7d23d91bfa..97e40e59b7b4ad6aa36f54ce4f1e64d1e98f24cb
#
# CVE-2026-42533: heap buffer overflow in the nginx script engine when a map
# directive uses regex matching (or a non-cacheable variable) and a string
# expression is evaluated in two passes with disagreeing lengths.
#
# This is the Alpine 3.21 1.26.3-r2 backport (5 upstream commits) rebased onto
# vanilla nginx 1.26.3 for Alpine 3.20, which does not carry the later 3.21
# CVE patches that the original aports hunks were generated against.
#
# Commits:
#   1. Script: simplified copy capture codes
#   2. Script: buffer overrun protection (ngx_http_script_check_length / e->end)
#   3. Access log: buffer overrun protection
#   4. Script: buffer overrun protection in direct script usage
#   5. Script: avoid garbage at the end of the result string
#
# Packaging: Alpine 3.20 still fetches nginx-tests and njs from hg.nginx.org,
# which now returns HTML. These APKBUILD hunks retarget both to GitHub
# (alpine-patcher applies them to APKBUILD and strips them from source=).
#
--- a/APKBUILD
+++ b/APKBUILD
@@ -49,3 +49,4 @@
 # Revision of nginx-tests to use for check().
-_tests_hgrev=898407c62387
+# hg.nginx.org is decommissioned; GitHub commit matching former hg 898407c62387.
+_tests_rev=e5b70d2723e17543272370e0ace915c4d3f264dc
 _njs_ver=0.8.4
@@ -92,8 +93,8 @@
 install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-upgrade $pkgname.post-upgrade"
 subpackages="$pkgname-debug $pkgname-doc $pkgname-openrc $pkgname-vim::noarch"
 source="https://nginx.org/download/nginx-$pkgver.tar.gz
-	$pkgname-tests-$_tests_hgrev.tar.gz::https://hg.nginx.org/nginx-tests/archive/$_tests_hgrev.tar.gz
-	$pkgname-njs-$_njs_ver.tar.gz::https://hg.nginx.org/njs/archive/$_njs_ver.tar.gz
+	$pkgname-tests-$_tests_rev.tar.gz::https://github.com/nginx/nginx-tests/archive/$_tests_rev.tar.gz
+	$pkgname-njs-github-$_njs_ver.tar.gz::https://github.com/nginx/njs/archive/$_njs_ver.tar.gz
 	nginx-dav-ext-module~pr-56.patch::https://github.com/arut/nginx-dav-ext-module/pull/56.patch
 	nginx-dav-ext-module~pr-62.patch::https://github.com/arut/nginx-dav-ext-module/commit/bbf93f75ca58657fb0f8376b0898f854f13cef91.patch
 	no-werror.patch

