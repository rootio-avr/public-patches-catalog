maintainer="Celeste <cielesti@protonmail.com>"
pkgname=wget
pkgver=1.25.0
pkgrel=20072
# Security fixes:
# Patched for CVE-2026-58469, CVE-2026-58471, CVE-2026-58472
pkgdesc="Network utility to retrieve files from the Web"
url="https://www.gnu.org/software/wget/wget.html"
arch="all"
license="GPL-3.0-or-later WITH OpenSSL-Exception"
makedepends="
	libidn2-dev
	openssl-dev
	pcre2-dev
	perl
	zlib-dev
	"
checkdepends="perl-http-daemon"
subpackages="$pkgname-doc"
source="https://ftp.gnu.org/gnu/wget/wget-$pkgver.tar.gz CVE-2026-58469_CVE-2026-58469.patch CVE-2026-58471_CVE-2026-58471.patch CVE-2026-58472_CVE-2026-58472.patch"

# secfixes:
#   1.25.0-r0:
#     - CVE-2024-10524
#   1.20.3-r0:
#     - CVE-2019-5953
#   1.20.1-r0:
#     - CVE-2018-20483
#   1.19.5-r0:
#     - CVE-2018-0494
#   1.19.1-r1:
#     - CVE-2017-6508
#   1.19.2-r0:
#     - CVE-2017-13090

build() {
	CFLAGS="$CFLAGS -flto=auto" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--with-libidn \
		--with-ssl=openssl \
		--disable-nls
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}

