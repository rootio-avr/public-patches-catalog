+/*
+ * TIFF Library
+ *
+ * Regression test for CVE-2023-52356
+ * (upstream commit 51558511bdbbcffdce534db21dbaf5d54b31638a):
+ * "TIFFReadRGBAStrip/TIFFReadRGBATile: add more validation of col/row".
+ *
+ * Before the fix, passing a row (for TIFFReadRGBAStrip) or a col/row (for
+ * TIFFReadRGBATile) beyond the image dimensions was not rejected, which could
+ * lead to an out-of-bounds write into the caller-supplied raster buffer.
+ * The fixed code rejects such calls, returning 0.
+ *
+ * This test verifies:
+ *  - in-bounds calls succeed (return 1),
+ *  - out-of-bounds row/col calls are rejected (return 0),
+ * for both the strip and tile RGBA read paths.
+ */
+
+#include "tif_config.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef HAVE_UNISTD_H
+#include <unistd.h>
+#endif
+
+#include "tiffio.h"
+
+#define SPP 3 /* samples per pixel */
+#define BPS 8 /* bits per sample */
+#define IMG_WIDTH 8
+#define IMG_LENGTH 8
+#define TILE_DIM 16 /* tile is larger than the image on purpose */
+
+/*
+ * The raster passed to TIFFReadRGBATile() is filled with a *full* tile
+ * (TILE_DIM x TILE_DIM pixels), regardless of how much of it overlaps the
+ * image. It must therefore be sized for a whole tile, which is larger than
+ * the image itself. Undersizing it (e.g. IMG_WIDTH * IMG_LENGTH) causes a
+ * legitimate out-of-bounds write independent of the CVE being tested.
+ */
+#define RASTER_PIXELS (TILE_DIM * TILE_DIM)
+
+static int write_strip_image(const char *filename)
+{
+    TIFF *tif = TIFFOpen(filename, "w");
+    if (!tif)
+    {
+        fprintf(stderr, "Can't create %s\n", filename);
+        return -1;
+    }
+    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, (uint32_t)IMG_WIDTH);
+    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, (uint32_t)IMG_LENGTH);
+    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, BPS);
+    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, SPP);
+    TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, (uint32_t)IMG_LENGTH);
+    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
+    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_RGB);
+
+    unsigned char line[IMG_WIDTH * SPP];
+    memset(line, 0x7f, sizeof(line));
+    for (uint32_t r = 0; r < IMG_LENGTH; r++)
+    {
+        if (TIFFWriteScanline(tif, line, r, 0) < 0)
+        {
+            fprintf(stderr, "Can't write scanline %u\n", r);
+            TIFFClose(tif);
+            return -1;
+        }
+    }
+    TIFFClose(tif);
+    return 0;
+}
+
+static int write_tile_image(const char *filename)
+{
+    TIFF *tif = TIFFOpen(filename, "w");
+    if (!tif)
+    {
+        fprintf(stderr, "Can't create %s\n", filename);
+        return -1;
+    }
+    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, (uint32_t)IMG_WIDTH);
+    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, (uint32_t)IMG_LENGTH);
+    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, BPS);
+    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, SPP);
+    TIFFSetField(tif, TIFFTAG_TILEWIDTH, (uint32_t)TILE_DIM);
+    TIFFSetField(tif, TIFFTAG_TILELENGTH, (uint32_t)TILE_DIM);
+    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
+    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_RGB);
+
+    tmsize_t tsize = TIFFTileSize(tif);
+    unsigned char *tbuf = (unsigned char *)_TIFFmalloc(tsize);
+    if (!tbuf)
+    {
+        TIFFClose(tif);
+        return -1;
+    }
+    memset(tbuf, 0x7f, (size_t)tsize);
+    if (TIFFWriteEncodedTile(tif, 0, tbuf, tsize) < 0)
+    {
+        fprintf(stderr, "Can't write tile\n");
+        _TIFFfree(tbuf);
+        TIFFClose(tif);
+        return -1;
+    }
+    _TIFFfree(tbuf);
+    TIFFClose(tif);
+    return 0;
+}
+
+int main(void)
+{
+    const char *stripfile = "test_rgba_strip_bounds.tif";
+    const char *tilefile = "test_rgba_tile_bounds.tif";
+    int failures = 0;
+    uint32_t *raster = NULL;
+
+    if (write_strip_image(stripfile))
+        return 1;
+    if (write_tile_image(tilefile))
+        return 1;
+
+    /* Suppress the expected error messages emitted by the bounds checks. */
+    TIFFErrorHandler prev = TIFFSetErrorHandler(NULL);
+
+    /* Allocate a raster large enough for a full tile (the largest read). */
+    raster = (uint32_t *)_TIFFmalloc(sizeof(uint32_t) * RASTER_PIXELS);
+    if (!raster)
+    {
+        fprintf(stderr, "Can't allocate raster\n");
+        return 1;
+    }
+
+    /* ---- Strip path: TIFFReadRGBAStrip ---- */
+    {
+        TIFF *tif = TIFFOpen(stripfile, "r");
+        if (!tif)
+        {
+            fprintf(stderr, "Can't open %s\n", stripfile);
+            return 1;
+        }
+
+        /* In-bounds row must succeed. */
+        if (TIFFReadRGBAStrip(tif, 0, raster) != 1)
+        {
+            fprintf(stderr, "FAIL: TIFFReadRGBAStrip(row=0) should succeed\n");
+            failures++;
+        }
+
+        /* row == height and row > height must be rejected (CVE-2023-52356). */
+        if (TIFFReadRGBAStrip(tif, IMG_LENGTH, raster) != 0)
+        {
+            fprintf(stderr,
+                    "FAIL: TIFFReadRGBAStrip(row=height) must be rejected\n");
+            failures++;
+        }
+        if (TIFFReadRGBAStrip(tif, IMG_LENGTH + 100, raster) != 0)
+        {
+            fprintf(stderr,
+                    "FAIL: TIFFReadRGBAStrip(row>>height) must be rejected\n");
+            failures++;
+        }
+        TIFFClose(tif);
+    }
+
+    /* ---- Tile path: TIFFReadRGBATile ---- */
+    {
+        TIFF *tif = TIFFOpen(tilefile, "r");
+        if (!tif)
+        {
+            fprintf(stderr, "Can't open %s\n", tilefile);
+            return 1;
+        }
+
+        /* In-bounds col/row must succeed. */
+        if (TIFFReadRGBATile(tif, 0, 0, raster) != 1)
+        {
+            fprintf(stderr,
+                    "FAIL: TIFFReadRGBATile(col=0,row=0) should succeed\n");
+            failures++;
+        }
+
+        /* col >= width must be rejected (CVE-2023-52356). */
+        if (TIFFReadRGBATile(tif, IMG_WIDTH, 0, raster) != 0)
+        {
+            fprintf(stderr,
+                    "FAIL: TIFFReadRGBATile(col=width) must be rejected\n");
+            failures++;
+        }
+        /* row >= height must be rejected. */
+        if (TIFFReadRGBATile(tif, 0, IMG_LENGTH, raster) != 0)
+        {
+            fprintf(stderr,
+                    "FAIL: TIFFReadRGBATile(row=height) must be rejected\n");
+            failures++;
+        }
+        /* both far out of bounds must be rejected. */
+        if (TIFFReadRGBATile(tif, IMG_WIDTH + 100, IMG_LENGTH + 100, raster) !=
+            0)
+        {
+            fprintf(stderr,
+                    "FAIL: TIFFReadRGBATile(col,row>>) must be rejected\n");
+            failures++;
+        }
+        TIFFClose(tif);
+    }
+
+    if (prev != NULL)
+        TIFFSetErrorHandler(prev);
+
+    _TIFFfree(raster);
+    unlink(stripfile);
+    unlink(tilefile);
+
+    if (failures)
+    {
+        fprintf(stderr, "test_rgba_strip_tile_bounds: %d failure(s)\n",
+                failures);
+        return 1;
+    }
+    fprintf(stderr, "test_rgba_strip_tile_bounds: OK\n");
+    return 0;
+}
