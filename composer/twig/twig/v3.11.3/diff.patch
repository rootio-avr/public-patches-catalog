+++ b/src/Extension/CoreExtension.php
@@ -1908,7 +1908,25 @@ final class CoreExtension extends AbstractExtension
      */
     public static function checkArrowInSandbox(Environment $env, $arrow, $thing, $type)
     {
-        if (!$arrow instanceof \Closure && $env->hasExtension(SandboxExtension::class) && $env->getExtension(SandboxExtension::class)->isSandboxed()) {
+        if ($arrow instanceof \Closure) {
+            return;
+        }
+
+        if (!$env->hasExtension(SandboxExtension::class)) {
+            return;
+        }
+
+        // Recover the calling Template's Source by walking the PHP backtrace so
+        // that SourcePolicyInterface-based sandboxing is honored (CVE-2026-24425).
+        $source = null;
+        foreach (debug_backtrace(\DEBUG_BACKTRACE_PROVIDE_OBJECT | \DEBUG_BACKTRACE_IGNORE_ARGS) as $trace) {
+            if (isset($trace['object']) && $trace['object'] instanceof Template) {
+                $source = $trace['object']->getSourceContext();
+                break;
+            }
+        }
+
+        if ($env->getExtension(SandboxExtension::class)->isSandboxed($source)) {
             throw new RuntimeError(\sprintf('The callable passed to the "%s" %s must be a Closure in sandbox mode.', $thing, $type));
         }
     }
