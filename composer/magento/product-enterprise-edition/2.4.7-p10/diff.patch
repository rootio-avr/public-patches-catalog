+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+declare(strict_types=1);
+
+namespace Magento\Framework\Test\Unit;
+
+use Magento\Backend\Model\Widget\Grid\Row\GeneratorInterface;
+use Magento\Backend\Model\Widget\Grid\Row\UrlGeneratorFactory;
+use Magento\Email\Block\Adminhtml\Template\Preview as EmailPreview;
+use Magento\Email\Model\AbstractTemplate;
+use Magento\Framework\App\TemplateTypesInterface;
+use Magento\Framework\Exception\LocalizedException;
+use Magento\Framework\ObjectManager\ConfigInterface;
+use Magento\Framework\ObjectManagerInterface;
+use Magento\Framework\View\Element\BlockFactory;
+use Magento\Framework\View\Element\BlockInterface;
+use Magento\Framework\View\Layout\Generator\Block as LayoutBlockGenerator;
+use Magento\Framework\Webapi\ErrorProcessor;
+use Magento\Newsletter\Block\Adminhtml\Queue\Preview as QueuePreview;
+use Magento\Newsletter\Block\Adminhtml\Template\Preview as NewsletterPreview;
+use PHPUnit\Framework\TestCase;
+use ReflectionClass;
+use ReflectionMethod;
+
+/**
+ * CVE-2026-75650 (StyleSmuggler / VULN-39341) regression tests.
+ *
+ * Unit coverage checks each hardened method. Functional coverage renders an
+ * authorized preview and round-trips an error report. Security coverage checks
+ * that gadget classes are not constructed, structured template styles are
+ * dropped, and a report file cannot execute a planted PHP open tag.
+ */
+class Cve202675650StyleSmugglerTest extends TestCase
+{
+    private const REPORT_GUARD = '<?php exit; ?>';
+
+    private const PHP_MARKER = '<?php echo "CVE75650-WITNESS";';
+
+    public static function setUpBeforeClass(): void
+    {
+        require_once dirname(__DIR__, 6) . '/pub/errors/processor.php';
+    }
+
+    public function testLegitimateBlockIsStillCreated(): void
+    {
+        $block = new Cve202675650LegitimateBlock();
+        $objectManager = $this->objectManagerReturning($block);
+        $factory = $this->blockFactory($objectManager);
+
+        $created = $factory->createBlock(Cve202675650LegitimateBlock::class, ['data' => ['ok' => true]]);
+
+        $this->assertSame($block, $created);
+        $this->assertSame(1, $objectManager->createCount);
+    }
+
+    public function testNonBlockClassIsRejectedBeforeConstruction(): void
+    {
+        Cve202675650SideEffect::$constructed = false;
+        $objectManager = new Cve202675650RecordingObjectManager();
+        $factory = $this->blockFactory($objectManager);
+
+        try {
+            $factory->createBlock(Cve202675650SideEffect::class, ['path' => '../var/report/poisoned']);
+            $this->fail('A non-block class must be rejected');
+        } catch (\LogicException $exception) {
+            $this->assertStringContainsString('does not implement BlockInterface', $exception->getMessage());
+        }
+
+        $this->assertFalse(Cve202675650SideEffect::$constructed);
+        $this->assertSame(0, $objectManager->createCount);
+    }
+
+    public function testLayoutGeneratorCatchesLogicExceptionFromBlockFactory(): void
+    {
+        $factory = $this->createMock(BlockFactory::class);
+        $factory->method('createBlock')->willThrowException(new \LogicException('refused gadget'));
+        $logger = new Cve202675650Logger();
+        $generator = (new ReflectionClass(LayoutBlockGenerator::class))->newInstanceWithoutConstructor();
+        $this->setProperty($generator, 'blockFactory', $factory);
+        $this->setProperty($generator, 'logger', $logger);
+
+        $method = new ReflectionMethod(LayoutBlockGenerator::class, 'getBlockInstance');
+        $method->setAccessible(true);
+
+        try {
+            $method->invoke($generator, Cve202675650SideEffect::class, []);
+            $this->fail('An invalid block type must surface as LocalizedException');
+        } catch (LocalizedException $exception) {
+            $this->assertStringContainsString('Invalid block type', $exception->getMessage());
+        }
+
+        $this->assertSame(['refused gadget'], $logger->criticalMessages);
+    }
+
+    public function testLegitimateUrlGeneratorIsStillCreated(): void
+    {
+        $generator = new Cve202675650LegitimateGenerator();
+        $objectManager = $this->objectManagerReturning($generator);
+        $factory = new UrlGeneratorFactory($objectManager);
+
+        $created = $factory->createUrlGenerator(Cve202675650LegitimateGenerator::class, ['row' => 1]);
+
+        $this->assertSame($generator, $created);
+        $this->assertSame(1, $objectManager->createCount);
+    }
+
+    public function testUrlGeneratorRejectsNonGeneratorBeforeConstruction(): void
+    {
+        Cve202675650SideEffect::$constructed = false;
+        $objectManager = new Cve202675650RecordingObjectManager();
+        $factory = new UrlGeneratorFactory($objectManager);
+
+        try {
+            $factory->createUrlGenerator(
+                Cve202675650SideEffect::class,
+                ['first' => '../var/report/poisoned']
+            );
+            $this->fail('A non-generator class must be rejected');
+        } catch (\InvalidArgumentException $exception) {
+            $this->assertSame('Passed wrong parameters', $exception->getMessage());
+        }
+
+        $this->assertFalse(Cve202675650SideEffect::$constructed);
+        $this->assertSame(0, $objectManager->createCount);
+    }
+
+    public function testStringTemplateStylesAndTextArePreserved(): void
+    {
+        $template = $this->templateWithoutConstructor();
+        $css = "body { color: #000; }\n.header { padding: 10px; }";
+
+        $template->setTemplateStyles($css);
+        $template->setTemplateText('Hello {{var customer.name}}');
+
+        $this->assertSame($css, $template->getTemplateStyles());
+        $this->assertSame('Hello {{var customer.name}}', $template->getTemplateText());
+    }
+
+    /**
+     * @dataProvider structuredTemplateValueProvider
+     */
+    public function testStructuredTemplateValuesAreRejected($value): void
+    {
+        $template = $this->templateWithoutConstructor();
+
+        $template->setTemplateStyles($value);
+        $template->setTemplateText($value);
+
+        $this->assertSame('', $template->getTemplateStyles());
+        $this->assertSame('', $template->getTemplateText());
+    }
+
+    public function structuredTemplateValueProvider(): array
+    {
+        return [
+            'styles array gadget' => [[
+                'generatorClass' => Cve202675650SideEffect::class,
+                'first' => '../var/report/poisoned',
+            ]],
+            'nested array' => [[['<?php echo "CVE75650-WITNESS";']]],
+            'object' => [(object) ['first' => '../var/report/poisoned']],
+            'integer' => [1],
+            'null' => [null],
+        ];
+    }
+
+    public function testAuthorizedPreviewRendersLegitimateStyles(): void
+    {
+        $template = $this->templateWithoutConstructor();
+        $css = '.header { color: #111; }';
+        $preview = $this->emailPreview($template, [
+            'type' => (string) TemplateTypesInterface::TYPE_HTML,
+            'text' => 'Hello',
+            'styles' => $css,
+            'id' => null,
+        ], true);
+
+        $html = $this->invoke($preview, '_toHtml');
+
+        $this->assertSame('rendered:' . $css, $html);
+        $this->assertSame($css, $template->getTemplateStyles());
+        $this->assertSame('Hello', $template->getTemplateText());
+    }
+
+    public function testPreviewDropsStructuredStylesBeforeRendering(): void
+    {
+        $template = $this->templateWithoutConstructor();
+        $preview = $this->emailPreview($template, [
+            'type' => (string) TemplateTypesInterface::TYPE_HTML,
+            'text' => 'Hello',
+            'styles' => [
+                'generatorClass' => Cve202675650SideEffect::class,
+                'first' => '../var/report/poisoned',
+            ],
+            'id' => null,
+        ], true);
+
+        $html = $this->invoke($preview, '_toHtml');
+
+        $this->assertSame('rendered:', $html);
+        $this->assertSame('', $template->getTemplateStyles());
+    }
+
+    public function testEmailPreviewRequiresTemplateAcl(): void
+    {
+        $preview = $this->emailPreview($this->templateWithoutConstructor(), [], false);
+
+        $this->assertSame('', $this->invoke($preview, '_toHtml'));
+    }
+
+    public function testNewsletterPreviewRequiresTemplateAcl(): void
+    {
+        $preview = (new ReflectionClass(NewsletterPreview::class))->newInstanceWithoutConstructor();
+        $this->setProperty($preview, '_authorization', $this->authorization(false, 'Magento_Newsletter::template'));
+
+        $this->assertSame('', $this->invoke($preview, '_toHtml'));
+    }
+
+    public function testNewsletterQueuePreviewRequiresQueueAcl(): void
+    {
+        $preview = (new ReflectionClass(QueuePreview::class))->newInstanceWithoutConstructor();
+        $authorization = $this->authorization(false, 'Magento_Newsletter::queue');
+        $this->setProperty($preview, '_authorization', $authorization);
+
+        $this->assertSame('', $this->invoke($preview, '_toHtml'));
+        $this->assertSame(['Magento_Newsletter::queue'], $authorization->resources);
+    }
+
+    public function testBenignErrorReportRoundTrips(): void
+    {
+        $dir = $this->tempReportDir();
+        $processor = $this->reportProcessor($dir);
+
+        $processor->saveReport([
+            'report_id' => 'abc123',
+            'script_name' => '/checkout',
+        ]);
+
+        $contents = $this->readReport($processor, $dir . '/abc123');
+        $data = json_decode($contents, true);
+
+        $this->assertSame('/checkout', $data['script_name']);
+        $this->removeDir($dir);
+    }
+
+    public function testApiErrorReportNeutralizesPhpOpenTags(): void
+    {
+        $capture = new Cve202675650ReportWriter();
+        $processor = (new ReflectionClass(ErrorProcessor::class))->newInstanceWithoutConstructor();
+        $this->setProperty($processor, 'directoryWrite', $capture);
+        $this->setProperty($processor, 'serializer', new Cve202675650Json());
+
+        $method = new ReflectionMethod(ErrorProcessor::class, '_saveFatalErrorReport');
+        $method->setAccessible(true);
+        $method->invoke($processor, 'Fatal Error: ' . self::PHP_MARKER);
+
+        $this->assertStringStartsWith(self::REPORT_GUARD . "\n", $capture->content);
+        $body = substr($capture->content, strlen(self::REPORT_GUARD) + 1);
+        $this->assertStringNotContainsString('<?', $body);
+        $this->assertStringContainsString('< ?php echo', $body);
+    }
+
+    public function testStorefrontReportCannotExecutePlantedPhp(): void
+    {
+        $dir = $this->tempReportDir();
+        $processor = $this->reportProcessor($dir);
+        $processor->saveReport([
+            'report_id' => 'deadbeef',
+            'script_name' => self::PHP_MARKER,
+            'url' => '',
+        ]);
+
+        $file = $dir . '/deadbeef';
+        $raw = (string) file_get_contents($file);
+        $this->assertStringStartsWith(self::REPORT_GUARD, $raw);
+        $body = preg_replace('/^' . preg_quote(self::REPORT_GUARD, '/') . '\R/', '', $raw);
+        $this->assertStringNotContainsString('<?', $body);
+
+        $decoded = json_decode($this->readReport($processor, $file), true);
+        $this->assertSame(str_replace('<?', '< ?', self::PHP_MARKER), $decoded['script_name']);
+
+        $runner = tempnam(sys_get_temp_dir(), 'cve75650');
+        file_put_contents($runner, "<?php include " . var_export($file, true) . "; echo 'AFTER';");
+        $command = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($runner);
+        $output = [];
+        $exitCode = 0;
+        exec($command . ' 2>&1', $output, $exitCode);
+        @unlink($runner);
+
+        $printed = implode("\n", $output);
+        $this->assertSame(0, $exitCode);
+        $this->assertStringNotContainsString('CVE75650-WITNESS', $printed);
+        $this->assertStringNotContainsString('AFTER', $printed);
+        $this->removeDir($dir);
+    }
+
+    private function blockFactory(ObjectManagerInterface $objectManager): BlockFactory
+    {
+        $config = $this->createMock(ConfigInterface::class);
+        $config->method('getPreference')->willReturnArgument(0);
+        $config->method('getInstanceType')->willReturnArgument(0);
+
+        return new BlockFactory($objectManager, $config);
+    }
+
+    private function objectManagerReturning(object $instance): Cve202675650RecordingObjectManager
+    {
+        $objectManager = new Cve202675650RecordingObjectManager();
+        $objectManager->instance = $instance;
+
+        return $objectManager;
+    }
+
+    private function templateWithoutConstructor(): AbstractTemplate
+    {
+        return (new ReflectionClass(Cve202675650Template::class))->newInstanceWithoutConstructor();
+    }
+
+    private function emailPreview(AbstractTemplate $template, array $params, bool $allowed): EmailPreview
+    {
+        $preview = (new ReflectionClass(EmailPreview::class))->newInstanceWithoutConstructor();
+        $request = new Cve202675650Request($params);
+        $store = new Cve202675650Store();
+        $this->setProperty($preview, '_authorization', $this->authorization($allowed, 'Magento_Email::template'));
+        $this->setProperty($preview, '_request', $request);
