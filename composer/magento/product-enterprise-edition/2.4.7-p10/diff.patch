+use PHPUnit\Framework\TestCase;
+
+class RestrictedFieldsPluginTest extends TestCase
+{
+    /**
+     * @var RestrictedFieldsPlugin
+     */
+    private $plugin;
+
+    protected function setUp(): void
+    {
+        $this->plugin = new RestrictedFieldsPlugin(['password_hash', 'rp_token', 'confirmation']);
+    }
+
+    /**
+     * @param string|null $filterField
+     * @param string|null $sortField
+     * @return SearchCriteriaInterface
+     */
+    private function createCriteria(?string $filterField, ?string $sortField): SearchCriteriaInterface
+    {
+        $criteria = $this->createMock(SearchCriteriaInterface::class);
+        $groups = [];
+        if ($filterField !== null) {
+            $filter = $this->createMock(Filter::class);
+            $filter->method('getField')->willReturn($filterField);
+            $group = $this->createMock(FilterGroup::class);
+            $group->method('getFilters')->willReturn([$filter]);
+            $groups[] = $group;
+        }
+        $sorts = [];
+        if ($sortField !== null) {
+            $sort = $this->createMock(SortOrder::class);
+            $sort->method('getField')->willReturn($sortField);
+            $sorts[] = $sort;
+        }
+        $criteria->method('getFilterGroups')->willReturn($groups);
+        $criteria->method('getSortOrders')->willReturn($sorts);
+
+        return $criteria;
+    }
+
+    /**
+     * @return array
+     */
+    public static function restrictedProvider(): array
+    {
+        return [
+            'filter password_hash' => ['password_hash', null],
+            'filter rp_token mixed case' => ['RP_Token', null],
+            'filter confirmation' => ['confirmation', null],
+            'sort password_hash' => [null, 'password_hash'],
+            'sort rp_token' => [null, 'rp_token'],
+        ];
+    }
+
+    /**
+     * @dataProvider restrictedProvider
+     * @param string|null $filterField
+     * @param string|null $sortField
+     */
+    public function testRestrictedFieldsAreRejected(?string $filterField, ?string $sortField): void
+    {
+        $this->expectException(InputException::class);
+        $this->plugin->beforeGetList(
+            $this->createMock(CustomerRepositoryInterface::class),
+            $this->createCriteria($filterField, $sortField)
+        );
+    }
+
+    public function testAllowedFieldsPass(): void
+    {
+        $criteria = $this->createCriteria('email', 'lastname');
+        $result = $this->plugin->beforeGetList(
+            $this->createMock(CustomerRepositoryInterface::class),
+            $criteria
+        );
+        $this->assertSame([$criteria], $result);
+    }
+}
