+use Magento\Framework\View\Element\UiComponent\DataProvider\Sanitizer;
+use PHPUnit\Framework\TestCase;
+
+class SanitizerMultilineTest extends TestCase
+{
+    public function testTemplateSyntaxSpanningLinesIsDisabled(): void
+    {
+        $result = (new Sanitizer())->sanitize(['label' => '${' . "\n alert(1)\n" . '}']);
+        $this->assertSame(['label' => true], $result['__disableTmpl']);
+    }
+
+    public function testPlainValueIsLeftUntouched(): void
+    {
+        $data = ['label' => 'plain text'];
+        $this->assertSame($data, (new Sanitizer())->sanitize($data));
+    }
+}
