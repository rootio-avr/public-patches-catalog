+/**
+ * Regression test for CVE-2026-71362: session customer_form_data must not rebind the session customer id.
+ */
+class EditSessionIdentityTest extends TestCase
+{
+    /**
+     * @param array $formData
+     * @param array $expectedPopulated
+     * @dataProvider formDataProvider
+     */
+    public function testExecuteRestrictsFormDataAndKeepsSessionCustomerId(
+        array $formData,
+        array $expectedPopulated
+    ): void {
+        $sessionCustomerId = 5;
+
+        $request = $this->createMock(RequestInterface::class);
+        $context = $this->createMock(Context::class);
+        $context->method('getRequest')->willReturn($request);
+
+        $layout = $this->createMock(LayoutInterface::class);
+        $layout->method('getBlock')->willReturn(null);
+        $page = $this->createMock(Page::class);
+        $page->method('getLayout')->willReturn($layout);
+        $pageFactory = $this->createMock(PageFactory::class);
+        $pageFactory->method('create')->willReturn($page);
+        $request->method('getParam')->willReturn(null);
+
+        $session = $this->getMockBuilder(Session::class)
+            ->disableOriginalConstructor()
+            ->addMethods(['getCustomerFormData', 'setChangePassword'])
+            ->onlyMethods(['getCustomerId', 'setCustomerData'])
+            ->getMock();
+        $session->method('getCustomerFormData')->willReturn($formData);
+        $session->method('getCustomerId')->willReturn($sessionCustomerId);
+
+        $customer = $this->createMock(CustomerInterface::class);
+        $repository = $this->createMock(CustomerRepositoryInterface::class);
+        $repository->method('getById')->with($sessionCustomerId)->willReturn($customer);
+
+        $form = $this->createMock(Form::class);
+        $form->method('getAllowedAttributes')->willReturn(['firstname' => 1, 'lastname' => 1, 'email' => 1]);
+        $formFactory = $this->createMock(FormFactory::class);
+        $formFactory->method('create')->willReturn($form);
