Description: Fix AIKIDO-2026-248927 (StyleSmuggler) by rejecting structured
 template_styles data, sanitizing directive delimiters, and writing the safe
 value back to the AbstractTemplate object before its template text is filtered.
 This prevents template directives from retrieving the original attacker-
 controlled styles array through this.getTemplateStyles(). Caller-supplied
 template_styles values are normalized in both HTML and text modes, while
 legitimate string CSS is preserved.
Origin: ai-synthesized, AIKIDO-2026-248927
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-09-06

diff --git a/app/code/Magento/Email/Model/AbstractTemplate.php b/app/code/Magento/Email/Model/AbstractTemplate.php
index a3e328bb..de2be1fe 100644
--- a/app/code/Magento/Email/Model/AbstractTemplate.php
+++ b/app/code/Magento/Email/Model/AbstractTemplate.php
@@ -500,14 +500,39 @@ abstract class AbstractTemplate extends AbstractModel implements TemplateTypesIn
                 $store
             );
         }
-        // If template is text mode, don't include styles
-        if (!$this->isPlain() && !isset($variables['template_styles'])) {
-            $variables['template_styles'] = $this->getTemplateStyles();
+        $templateStyles = $this->sanitizeTemplateStyles($this->getTemplateStyles());
+        $this->setTemplateStyles($templateStyles);
+
+        if (isset($variables['template_styles'])) {
+            $variables['template_styles'] = $this->sanitizeTemplateStyles(
+                $variables['template_styles']
+            );
+        } elseif (!$this->isPlain()) {
+            // If template is text mode, don't include styles
+            $variables['template_styles'] = $templateStyles;
         }
 
         return $variables;
     }
 
+    /**
+     * @param mixed $styles
+     * @return string
+     */
+    private function sanitizeTemplateStyles($styles): string
+    {
+        if (!is_string($styles) || $styles === '') {
+            return '';
+        }
+
+        $sanitized = preg_replace('/\{\{.*?\}\}/s', '', $styles);
+        if ($sanitized === null) {
+            return '';
+        }
+
+        return str_replace(['{{', '}}'], '', $sanitized);
+    }
+
     /**
      * Apply design config so that emails are processed within the context of the appropriate area/store/theme.
      *
