diff -ruN a/lib/internal/Magento/Framework/Filter/Test/Unit/Template/DeferredDirectiveRegistryTest.php b/lib/internal/Magento/Framework/Filter/Test/Unit/Template/DeferredDirectiveRegistryTest.php
--- /dev/null
+++ b/lib/internal/Magento/Framework/Filter/Test/Unit/Template/DeferredDirectiveRegistryTest.php
@@ -0,0 +1,67 @@
+<?php
+/**
+ * Copyright 2026 Adobe
+ * All Rights Reserved.
+ */
+declare(strict_types=1);
+
+namespace Magento\Framework\Filter\Test\Unit\Template;
+
+use Magento\Framework\Filter\Template\DeferredDirectiveRegistry;
+use Magento\Framework\Math\Random;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Regression test: deferred directives are kept out-of-band behind unguessable placeholders.
+ */
+class DeferredDirectiveRegistryTest extends TestCase
+{
+    /**
+     * @return void
+     */
+    public function testDeferReturnsPlaceholderAndStoresDirective(): void
+    {
+        $random = $this->createMock(Random::class);
+        $random->expects($this->once())->method('getRandomString')->willReturn('salt-one');
+        $registry = new DeferredDirectiveRegistry($random);
+
+        $directive = '{{inlinecss file="css/email-inline.css"}}';
+        $placeholder = $registry->defer($directive);
+
+        $this->assertStringNotContainsString('inlinecss', $placeholder);
+        $this->assertSame($placeholder, $registry->defer($directive));
+        $this->assertSame([$placeholder => $directive], $registry->getAll());
+    }
+
+    /**
+     * @return void
+     */
+    public function testPlaceholderDependsOnPerRequestSalt(): void
+    {
+        $random = $this->createMock(Random::class);
+        $random->method('getRandomString')->willReturnOnConsecutiveCalls('salt-one', 'salt-two');
+        $registry = new DeferredDirectiveRegistry($random);
+
+        $directive = '{{inlinecss file="a.css"}}';
+        $first = $registry->defer($directive);
+        $registry->_resetState();
+        $second = $registry->defer($directive);
+
+        $this->assertNotSame($first, $second);
+    }
+
+    /**
+     * @return void
+     */
+    public function testClearForgetsDeferrals(): void
+    {
+        $random = $this->createMock(Random::class);
+        $random->method('getRandomString')->willReturn('salt');
+        $registry = new DeferredDirectiveRegistry($random);
+
+        $registry->defer('{{inlinecss file="a.css"}}');
+        $registry->clear();
+
+        $this->assertSame([], $registry->getAll());
+    }
+}
