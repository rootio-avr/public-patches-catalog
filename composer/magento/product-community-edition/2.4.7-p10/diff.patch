+namespace Magento\Customer\Test\Unit\Model\Plugin\CustomerRepository;
+
+use Magento\Customer\Api\CustomerRepositoryInterface;
+use Magento\Customer\Model\Plugin\CustomerRepository\RestrictedFieldsPlugin;
