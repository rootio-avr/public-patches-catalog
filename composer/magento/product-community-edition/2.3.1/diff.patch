diff -ruN a/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateNonStringInputTest.php b/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateNonStringInputTest.php
--- a/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateNonStringInputTest.php
+++ b/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateNonStringInputTest.php
@@ -0,0 +1,68 @@
+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+namespace Magento\Email\Test\Unit\Model;
+
+use Magento\Email\Model\AbstractTemplate;
+
+/**
+ * Regression test for CVE-2026-75650: template text/styles must reject non-string input.
+ */
+class AbstractTemplateNonStringInputTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @return AbstractTemplate
+     */
+    private function createTemplate()
+    {
+        return new class extends AbstractTemplate {
+            public function __construct()
+            {
+            }
+
+            protected function getFilterFactory()
+            {
+                return null;
+            }
+        };
+    }
+
+    public function testStringValuesArePreserved()
+    {
+        $template = $this->createTemplate();
+        $template->setTemplateStyles('body { color: #000; }');
+        $template->setTemplateText('Hello');
+
+        $this->assertSame('body { color: #000; }', $template->getTemplateStyles());
+        $this->assertSame('Hello', $template->getTemplateText());
+    }
+
+    /**
+     * @param mixed $value
+     * @dataProvider nonStringProvider
+     */
+    public function testNonStringValuesAreRejected($value)
+    {
+        $template = $this->createTemplate();
+        $template->setTemplateStyles($value);
+        $template->setTemplateText($value);
+
+        $this->assertSame('', $template->getTemplateStyles());
+        $this->assertSame('', $template->getTemplateText());
+    }
+
+    /**
+     * @return array
+     */
+    public function nonStringProvider()
+    {
+        return [
+            'array' => [['generatorClass' => 'AttackerChosenClass', 'first' => '../var/report/poisoned']],
+            'object' => [new \stdClass()],
+            'null' => [null],
+            'int' => [42],
+        ];
+    }
+}
diff -ruN a/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateStyleSmugglerTest.php b/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateStyleSmugglerTest.php
--- a/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateStyleSmugglerTest.php
+++ b/app/code/Magento/Email/Test/Unit/Model/AbstractTemplateStyleSmugglerTest.php
@@ -0,0 +1,144 @@
+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+declare(strict_types=1);
+
+namespace Magento\Email\Test\Unit\Model;
+
+use Magento\Email\Model\AbstractTemplate;
+use Magento\Framework\App\TemplateTypesInterface;
+use Magento\Store\Model\Store;
+use Magento\Store\Model\StoreManagerInterface;
+use PHPUnit\Framework\TestCase;
+use ReflectionClass;
+
+/**
+ * Regression test for AIKIDO-2026-248927 ("StyleSmuggler").
+ */
+class AbstractTemplateStyleSmugglerTest extends TestCase
+{
+    /**
+     * @param mixed $input
+     * @return string
+     */
+    private function sanitize($input): string
+    {
+        $reflection = new ReflectionClass(AbstractTemplate::class);
+        $instance = $this->createTemplate(TemplateTypesInterface::TYPE_HTML);
+        $method = $reflection->getMethod('sanitizeTemplateStyles');
+        $method->setAccessible(true);
+
+        return (string)$method->invoke($instance, $input);
+    }
+
+    private function createTemplate(int $templateType): AbstractTemplate
+    {
+        return new class ($templateType) extends AbstractTemplate {
+            /** @var int */
+            private $testTemplateType;
+
+            public function __construct(int $templateType)
+            {
+                $this->testTemplateType = $templateType;
+            }
+
+            protected function getFilterFactory()
+            {
+                return null;
+            }
+
+            public function getType()
+            {
+                return $this->testTemplateType;
+            }
+        };
+    }
+
+    /** @dataProvider maliciousStylesProvider */
+    public function testDirectiveConstructionsAreStripped(string $payload): void
+    {
+        $sanitized = $this->sanitize($payload);
+
+        $this->assertSame(false, strpos($sanitized, '{{'));
+        $this->assertSame(false, strpos($sanitized, '}}'));
+    }
+
+    public function maliciousStylesProvider(): array
+    {
+        return [
+            'var directive'      => ['{{var this.getData()}}'],
+            'block directive'    => ['{{block class="Some\\Evil\\Block"}}'],
+            'trans directive'    => ['p{color:red} {{trans "x"}}'],
+            'multiline directive' => ["a{color:#000}\n{{config path=\"web/unsecure/base_url\"}}"],
+            'split delimiters'   => ['{{ {{var x}} }}'],
+            'bare delimiters'    => ['body { color: red } }} {{'],
+        ];
+    }
+
+    public function testLegitimateCssIsPreserved(): void
+    {
+        $css = "body { color: #000; font-size: 14px; }\n"
+            . ".header { background: #fff; padding: 10px; }";
+
+        $this->assertSame($css, $this->sanitize($css));
+    }
+
+    /** @dataProvider templateTypesProvider */
+    public function testStructuredStylesAreRejectedAndRemovedFromTemplateObject(int $templateType): void
+    {
+        $reflection = new ReflectionClass(AbstractTemplate::class);
+        $instance = $this->createTemplate($templateType);
+        $instance->setTemplateStyles([
+            'generatorClass' => 'AttackerChosenClass',
+            'first' => '../var/report/poisoned',
+        ]);
+
+        $store = $this->getMockBuilder(Store::class)
+            ->setMethods(['getFormattedAddress', 'getFrontendName'])
+            ->disableOriginalConstructor()
+            ->getMock();
+        $store->method('getFormattedAddress')->willReturn('');
+        $store->method('getFrontendName')->willReturn('');
+
+        $storeManager = $this->createMock(StoreManagerInterface::class);
+        $storeManager->method('getStore')->willReturn($store);
+
+        $storeManagerProperty = $reflection->getProperty('storeManager');
+        $storeManagerProperty->setAccessible(true);
+        $storeManagerProperty->setValue($instance, $storeManager);
+
+        $addEmailVariables = $reflection->getMethod('addEmailVariables');
+        $addEmailVariables->setAccessible(true);
+        $variables = $addEmailVariables->invoke(
+            $instance,
+            [
+                'store' => $store,
+                'logo_url' => '',
+                'logo_alt' => '',
+                'logo_width' => '',
+                'logo_height' => '',
+                'store_phone' => '',
+                'store_hours' => '',
+                'store_email' => '',
+                'template_styles' => [
+                    'generatorClass' => 'AttackerChosenVariableClass',
+                    'first' => '../var/report/variable-poisoned',
+                ],
+            ],
+            0
+        );
+
+        $this->assertSame('', $variables['template_styles']);
+        $this->assertSame('', $instance->getTemplateStyles());
+    }
+
+    public function templateTypesProvider(): array
+    {
+        return [
+            'HTML template' => [TemplateTypesInterface::TYPE_HTML],
+            'text template' => [TemplateTypesInterface::TYPE_TEXT],
+        ];
+    }
+}
