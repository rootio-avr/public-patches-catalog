+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+
+namespace Magento\Framework\Filter\Test\Unit;
+
+/**
+ * Regression test for AIKIDO-2026-825761 (alias CVE-2026-103849, APSB26-153): data substituted by one
+ * directive must never be re-evaluated as template markup by a later directive in the same pass.
+ */
+class TemplateSinglePassInjectionTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @var \Magento\Framework\Filter\Template
+     */
+    private $templateFilter;
+
+    protected function setUp()
+    {
+        $objectManager = new \Magento\Framework\TestFramework\Unit\Helper\ObjectManager($this);
+        $this->templateFilter = $objectManager->getObject(\Magento\Framework\Filter\Template::class);
+    }
+
+    public function testSubstitutedDataIsNotReEvaluatedAsDirective()
+    {
+        $this->templateFilter->setVariables(
+            [
+                'secret' => 'LEAKED',
+                'name' => '{{var secret}}',
+            ]
+        );
+
+        $result = $this->templateFilter->filter('{{var name}}|{{var secret}}');
+
+        $this->assertEquals('{{var secret}}|LEAKED', $result);
+    }
+
+    public function testRepeatedDirectivesAreAllSubstituted()
+    {
+        $this->templateFilter->setVariables(['a' => 'one', 'b' => 'two']);
+
+        $result = $this->templateFilter->filter('{{var a}}-{{var b}}-{{var a}}');
+
+        $this->assertEquals('one-two-one', $result);
+    }
+
+    public function testUnknownDirectiveIsLeftUntouched()
+    {
+        $this->templateFilter->setVariables(['a' => 'one']);
+
+        $result = $this->templateFilter->filter('{{nosuchdirective x}} {{var a}}');
+
+        $this->assertEquals('{{nosuchdirective x}} one', $result);
+    }
+}
