+namespace Magento\Framework\Filter\Test\Unit;
+
+/**
+ * Regression test for CVE-2026-103849: template directives must not be re-evaluated from data
+ * substituted inside loops, and dangerous methods must not be callable from template markup.
+ */
+class TemplateDirectiveInjectionTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @var \Magento\Framework\Filter\Template
+     */
+    private $templateFilter;
+
+    protected function setUp()
+    {
+        $objectManager = new \Magento\Framework\TestFramework\Unit\Helper\ObjectManager($this);
+        $this->templateFilter = $objectManager->getObject(\Magento\Framework\Filter\Template::class);
+    }
+
+    public function testLoopValueIsNotReEvaluatedAsDirective()
+    {
+        $this->templateFilter->setVariables(
+            [
+                'secret' => 'LEAKED',
+                'items' => [['name' => '{{var secret}}']],
+            ]
+        );
+
+        $result = $this->templateFilter->filter('{{for item in items}}{{var item.name}}{{/for}}');
+
+        $this->assertNotContains('LEAKED', $result);
+        $this->assertNotContains('{{', $result);
+    }
+
+    public function testLoopRendersRegularValues()
+    {
+        $this->templateFilter->setVariables(
+            ['items' => [['name' => 'First'], ['name' => 'Second']]]
+        );
+
+        $result = $this->templateFilter->filter('{{for item in items}}[{{var item.name}}]{{/for}}');
+
+        $this->assertEquals('[First][Second]', $result);
+    }
+
+    public function testRestrictedMethodOnPlainObjectIsRejected()
+    {
+        $this->expectException(\InvalidArgumentException::class);
+
+        $subject = new class {
+            public function delete()
+            {
+                return 'deleted';
+            }
+        };
+        $this->templateFilter->setVariables(['subject' => $subject]);
+
+        $this->templateFilter->filter('{{var subject.delete()}}');
+    }
+
+    public function testRegularMethodOnPlainObjectStillWorks()
+    {
+        $subject = new class {
+            public function getName()
+            {
+                return 'Name';
+            }
+        };
+        $this->templateFilter->setVariables(['subject' => $subject]);
+
+        $this->assertEquals('Name', $this->templateFilter->filter('{{var subject.getName()}}'));
+    }
+}

