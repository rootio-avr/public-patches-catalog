+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+namespace Magento\Customer\Test\Unit\Controller\Account;
+
+use Magento\Customer\Api\CustomerRepositoryInterface;
+use Magento\Customer\Controller\Account\Edit;
+use Magento\Customer\Model\Metadata\Form;
+use Magento\Customer\Model\Metadata\FormFactory;
+use Magento\Customer\Model\Session;
+use Magento\Framework\Api\DataObjectHelper;
+use Magento\Framework\App\Action\Context;
+use Magento\Framework\TestFramework\Unit\Helper\ObjectManager as ObjectManagerHelper;
+use Magento\Framework\View\Result\PageFactory;
+
+/**
+ * Regression test for CVE-2026-71362: the account edit page must never let retained
+ * form data change the customer identity bound to the session.
+ */
+class EditIdentityPinningTest extends \PHPUnit\Framework\TestCase
+{
+    const SESSION_CUSTOMER_ID = 1001;
+
+    const VICTIM_CUSTOMER_ID = 2002;
+
+    /**
+     * @var \PHPUnit_Framework_MockObject_MockObject
+     */
+    private $session;
+
+    /**
+     * @var \PHPUnit_Framework_MockObject_MockObject
+     */
+    private $dataObjectHelper;
+
+    /**
+     * @var \PHPUnit_Framework_MockObject_MockObject
+     */
+    private $formFactory;
+
+    /**
+     * @var object
+     */
+    private $customer;
+
+    /**
+     * @var Edit
+     */
+    private $controller;
+
+    protected function setUp()
+    {
+        $this->customer = new class {
+            public $id = EditIdentityPinningTest::SESSION_CUSTOMER_ID;
+            public $firstname = 'Original';
+
+            public function getId()
+            {
+                return $this->id;
+            }
+
+            public function setId($id)
+            {
+                $this->id = $id;
+                return $this;
+            }
+        };
+
+        $this->session = $this->getMockBuilder(Session::class)
+            ->disableOriginalConstructor()
+            ->setMethods(['getCustomerFormData', 'getCustomerId', 'setCustomerData', 'setChangePassword'])
+            ->getMock();
+        $this->session->method('getCustomerId')->willReturn(self::SESSION_CUSTOMER_ID);
+
+        $customerRepository = $this->createMock(CustomerRepositoryInterface::class);
+        $customerRepository->method('getById')->with(self::SESSION_CUSTOMER_ID)->willReturn($this->customer);
+
+        $title = $this->getMockBuilder(\Magento\Framework\View\Page\Title::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+        $pageConfig = $this->getMockBuilder(\Magento\Framework\View\Page\Config::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+        $pageConfig->method('getTitle')->willReturn($title);
+        $layout = $this->createMock(\Magento\Framework\View\LayoutInterface::class);
+        $layout->method('getBlock')->willReturn(false);
+        $page = $this->getMockBuilder(\Magento\Framework\View\Result\Page::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+        $page->method('getLayout')->willReturn($layout);
+        $page->method('getConfig')->willReturn($pageConfig);
+        $pageFactory = $this->getMockBuilder(PageFactory::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+        $pageFactory->method('create')->willReturn($page);
+
+        $request = $this->createMock(\Magento\Framework\App\RequestInterface::class);
+        $context = $this->getMockBuilder(Context::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+        $context->method('getRequest')->willReturn($request);
+
+        $this->dataObjectHelper = $this->getMockBuilder(DataObjectHelper::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+        $this->formFactory = $this->getMockBuilder(FormFactory::class)
+            ->disableOriginalConstructor()
+            ->getMock();
+
+        $objectManager = new ObjectManagerHelper($this);
+        $this->controller = $objectManager->getObject(
+            Edit::class,
+            [
+                'context' => $context,
+                'customerSession' => $this->session,
+                'resultPageFactory' => $pageFactory,
+                'customerRepository' => $customerRepository,
+                'dataObjectHelper' => $this->dataObjectHelper,
+                'formFactory' => $this->formFactory,
+            ]
+        );
+    }
+
+    /**
+     * @return void
+     */
+    public function testRetainedIdentityFieldsAreNotPopulatedAndSessionIdentityIsKept()
+    {
+        $this->session->method('getCustomerFormData')->willReturn([
+            'id' => self::VICTIM_CUSTOMER_ID,
+            'entity_id' => self::VICTIM_CUSTOMER_ID,
+            'firstname' => 'Changed',
+        ]);
+
+        $form = $this->getMockBuilder(Form::class)->disableOriginalConstructor()->getMock();
+        $form->method('getAllowedAttributes')->willReturn(['firstname' => new \stdClass()]);
+        $this->formFactory->method('create')->willReturn($form);
+
+        $populated = null;
+        $this->dataObjectHelper->method('populateWithArray')->willReturnCallback(
+            function ($object, array $data) use (&$populated) {
+                $populated = $data;
+                // emulate the generic helper invoking every available setter
+                if (isset($data['id'])) {
+                    $object->setId($data['id']);
+                }
+            }
+        );
+
+        $saved = null;
+        $this->session->method('setCustomerData')->willReturnCallback(
+            function ($object) use (&$saved) {
+                $saved = $object->getId();
+            }
+        );
+
+        $this->controller->execute();
+
+        $this->assertSame(['firstname' => 'Changed'], $populated);
+        $this->assertSame(self::SESSION_CUSTOMER_ID, $saved);
+    }
+
+    /**
+     * @return void
+     */
+    public function testIdentityIsPinnedEvenIfPopulationChangesIt()
+    {
+        $this->session->method('getCustomerFormData')->willReturn(['id' => self::VICTIM_CUSTOMER_ID]);
+
+        $form = $this->getMockBuilder(Form::class)->disableOriginalConstructor()->getMock();
+        // misconfigured / extended form that (wrongly) allows the identity key
+        $form->method('getAllowedAttributes')->willReturn(['id' => new \stdClass()]);
+        $this->formFactory->method('create')->willReturn($form);
+
+        $this->dataObjectHelper->method('populateWithArray')->willReturnCallback(
+            function ($object, array $data) {
+                $object->setId($data['id']);
+            }
+        );
+
+        $saved = null;
+        $this->session->method('setCustomerData')->willReturnCallback(
+            function ($object) use (&$saved) {
+                $saved = $object->getId();
+            }
+        );
+
+        $this->controller->execute();
+
+        $this->assertSame(self::SESSION_CUSTOMER_ID, $saved);
+    }
+
+    /**
+     * @return void
+     */
+    public function testWithoutRetainedFormDataNothingIsPopulated()
+    {
+        $this->session->method('getCustomerFormData')->willReturn(null);
+        $this->formFactory->expects($this->never())->method('create');
+        $this->dataObjectHelper->expects($this->never())->method('populateWithArray');
+
+        $saved = null;
+        $this->session->method('setCustomerData')->willReturnCallback(
+            function ($object) use (&$saved) {
+                $saved = $object->getId();
+            }
+        );
+
+        $this->controller->execute();
+
+        $this->assertSame(self::SESSION_CUSTOMER_ID, $saved);
+    }
+}

