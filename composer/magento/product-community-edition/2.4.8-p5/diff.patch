+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+declare(strict_types=1);
+
+namespace Magento\Backend\Test\Unit\Model\Widget\Grid\Row;
+
+use Magento\Backend\Model\Widget\Grid\Row\GeneratorInterface;
+use Magento\Backend\Model\Widget\Grid\Row\UrlGeneratorFactory;
+use Magento\Framework\ObjectManagerInterface;
+use PHPUnit\Framework\MockObject\MockObject;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Regression test: the generator class must be validated before it is instantiated.
+ */
+class UrlGeneratorFactoryTest extends TestCase
+{
+    /**
+     * @var ObjectManagerInterface|MockObject
+     */
+    private $objectManagerMock;
+
+    /**
+     * @var UrlGeneratorFactory
+     */
+    private $factory;
+
+    protected function setUp(): void
+    {
+        $this->objectManagerMock = $this->getMockForAbstractClass(ObjectManagerInterface::class);
+        $this->factory = new UrlGeneratorFactory($this->objectManagerMock);
+    }
+
+    public function testCreateUrlGeneratorWithValidClass(): void
+    {
+        $generator = $this->getMockForAbstractClass(GeneratorInterface::class);
+        $this->objectManagerMock->expects($this->once())
+            ->method('create')
+            ->with(get_class($generator), ['a' => 'b'])
+            ->willReturn($generator);
+
+        $this->assertSame($generator, $this->factory->createUrlGenerator(get_class($generator), ['a' => 'b']));
+    }
+
+    public function testCreateUrlGeneratorRejectsWrongClassWithoutInstantiation(): void
+    {
+        $this->objectManagerMock->expects($this->never())->method('create');
+
+        $this->expectException(\InvalidArgumentException::class);
+        $this->factory->createUrlGenerator(\stdClass::class);
+    }
+}
