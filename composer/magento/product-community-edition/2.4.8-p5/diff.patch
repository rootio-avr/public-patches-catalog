+<?php
+/**
+ * Copyright © Magento, Inc. All rights reserved.
+ * See COPYING.txt for license details.
+ */
+declare(strict_types=1);
+
+namespace Magento\Customer\Test\Unit\Controller\Account;
+
+use Magento\Customer\Api\CustomerRepositoryInterface;
+use Magento\Customer\Api\Data\CustomerInterface;
+use Magento\Customer\Controller\Account\Edit;
+use Magento\Customer\Model\Session;
+use Magento\Framework\Api\DataObjectHelper;
+use Magento\Framework\App\Action\Context;
+use Magento\Framework\App\RequestInterface;
+use Magento\Framework\View\LayoutInterface;
+use Magento\Framework\View\Result\Page;
+use Magento\Framework\View\Result\PageFactory;
+use PHPUnit\Framework\MockObject\MockObject;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Regression test: retained account-edit form data must not rebind the session to another customer.
+ */
+class EditSessionIdentityTest extends TestCase
+{
+    private const SESSION_CUSTOMER_ID = 5;
+
+    /**
+     * @var MockObject|Session
+     */
+    private $session;
+
+    /**
+     * @var MockObject|DataObjectHelper
+     */
+    private $dataObjectHelper;
+
+    /**
+     * @var MockObject|CustomerInterface
+     */
+    private $customer;
+
+    /**
+     * @var Edit
+     */
+    private $controller;
+
+    protected function setUp(): void
+    {
+        $request = $this->getMockForAbstractClass(RequestInterface::class);
+        $context = $this->createMock(Context::class);
+        $context->method('getRequest')->willReturn($request);
+
+        $this->session = $this->getMockBuilder(Session::class)
+            ->disableOriginalConstructor()
+            ->onlyMethods(['getCustomerId', 'setCustomerData'])
+            ->addMethods(['getCustomerFormData', 'setChangePassword'])
+            ->getMock();
+        $this->session->method('getCustomerId')->willReturn(self::SESSION_CUSTOMER_ID);
+
+        $layout = $this->getMockForAbstractClass(LayoutInterface::class);
+        $layout->method('getBlock')->willReturn(null);
+        $page = $this->createMock(Page::class);
+        $page->method('getLayout')->willReturn($layout);
+        $pageFactory = $this->createMock(PageFactory::class);
+        $pageFactory->method('create')->willReturn($page);
+
+        $this->customer = $this->getMockForAbstractClass(CustomerInterface::class);
+        $repository = $this->getMockForAbstractClass(CustomerRepositoryInterface::class);
+        $repository->method('getById')->with(self::SESSION_CUSTOMER_ID)->willReturn($this->customer);
+
+        $this->dataObjectHelper = $this->createMock(DataObjectHelper::class);
+
+        $this->controller = new Edit(
+            $context,
+            $this->session,
+            $pageFactory,
+            $repository,
+            $this->dataObjectHelper
+        );
+    }
+
+    public function testIdentityFieldsInRetainedFormDataAreNotApplied(): void
+    {
+        $this->session->method('getCustomerFormData')->willReturn([
+            'id' => 99,
+            'entity_id' => 99,
+            'group_id' => 2,
+            'firstname' => 'Alice',
+        ]);
+
+        $this->dataObjectHelper->expects($this->once())
+            ->method('populateWithArray')
+            ->with($this->customer, ['firstname' => 'Alice'], CustomerInterface::class);
+        $this->customer->expects($this->once())->method('setId')->with(self::SESSION_CUSTOMER_ID);
+        $this->session->expects($this->once())->method('setCustomerData')->with($this->customer);
+
+        $this->controller->execute();
+    }
+
+    public function testRegularFormDataIsStillRestored(): void
+    {
+        $data = ['firstname' => 'Alice', 'lastname' => 'Smith', 'email' => 'alice@example.com'];
+        $this->session->method('getCustomerFormData')->willReturn($data);
+
+        $this->dataObjectHelper->expects($this->once())
+            ->method('populateWithArray')
+            ->with($this->customer, $data, CustomerInterface::class);
+
+        $this->controller->execute();
+    }
+}

Description: Fix CVE-2026-75650 (Adobe Commerce hotfix VULN-39341, APSB26-146).
 Validate class types before instantiation in UrlGeneratorFactory and
 BlockFactory (resolving DI preferences) to prevent arbitrary object
 instantiation, treat LogicException as a handled block-creation failure in
 the layout block generator, enforce ACL on email and newsletter template
 previews, reject non-string template text/styles, and prefix stored error
 reports with an exit guard while neutralizing PHP open tags so report files
 cannot be executed. Existing unit tests are updated for the new behavior and
 regression tests are added.
Origin: vendor, https://helpx.adobe.com/security/products/magento/apsb26-146.html
Author: Root.io Patcher <security@root.io>
