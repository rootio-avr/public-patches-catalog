+/**
+ * Regression test for CVE-2026-103849: deferred directives are exchanged out-of-band, so user-controlled
+ * template text cannot forge a value that the root template would treat as a deferred directive.
+ */
+class DeferredDirectiveRegistryTest extends TestCase
+{
+    public function testDeferReturnsPlaceholderAndStoresDirective(): void
+    {
+        $registry = new DeferredDirectiveRegistry($this->createRandomStub(['salt-one']));
+        $directive = '{{inlinecss file="css/email-inline.css"}}';
+
+        $placeholder = $registry->defer($directive);
+
+        $this->assertNotSame($directive, $placeholder);
+        $this->assertStringNotContainsString('{{', $placeholder);
+        $this->assertSame([$placeholder => $directive], $registry->getAll());
+    }
+
+    public function testPlaceholderIsDeterministicWithinRequestAndDependsOnSalt(): void
+    {
+        $registry = new DeferredDirectiveRegistry($this->createRandomStub(['salt-one', 'salt-two']));
+        $directive = '{{inlinecss file="a.css"}}';
+
+        $first = $registry->defer($directive);
+        $this->assertSame($first, $registry->defer($directive));
+
+        $registry->_resetState();
+        $this->assertNotSame($first, $registry->defer($directive));
+    }
+
+    public function testClearAndResetRemoveDeferrals(): void
+    {
+        $registry = new DeferredDirectiveRegistry($this->createRandomStub(['salt-one', 'salt-two']));
+
+        $registry->defer('{{inlinecss file="a.css"}}');
+        $registry->clear();
+        $this->assertSame([], $registry->getAll());
+
+        $registry->defer('{{inlinecss file="b.css"}}');
+        $registry->_resetState();
+        $this->assertSame([], $registry->getAll());
+    }
+
+    /**
+     * @param string[] $salts
+     * @return Random
+     */
+    private function createRandomStub(array $salts): Random
+    {
+        $random = $this->createMock(Random::class);
+        $calls = 0;
+        $random->method('getRandomString')->willReturnCallback(
+            function () use (&$calls, $salts) {
+                return $salts[min($calls++, count($salts) - 1)];
+            }
+        );
+
+        return $random;
+    }
+}
