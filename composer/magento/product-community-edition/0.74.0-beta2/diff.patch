diff -ruN a/app/code/Magento/Email/Test/Unit/Model/TemplateStyleSmugglerTest.php b/app/code/Magento/Email/Test/Unit/Model/TemplateStyleSmugglerTest.php
--- a/app/code/Magento/Email/Test/Unit/Model/TemplateStyleSmugglerTest.php
+++ b/app/code/Magento/Email/Test/Unit/Model/TemplateStyleSmugglerTest.php
@@ -0,0 +1,115 @@
+<?php
+/**
+ * Copyright © 2015 Magento. All rights reserved.
+ * See COPYING.txt for license details.
+ *
+ * Regression test for AIKIDO-2026-248927 ("StyleSmuggler", CWE-94).
+ *
+ * The <!--@styles ... @--> block of an email template is attacker-controllable
+ * and is re-merged into the template body by
+ * \Magento\Email\Model\Template::getPreparedTemplateText(). That body is then
+ * evaluated by \Magento\Framework\Filter\Template::filter(), which executes
+ * {{...}} directives (including arbitrary object-method invocation). This test
+ * verifies that template-directive delimiters smuggled through the styles field
+ * are neutralized before the styles are wrapped into the <style> tag, closing
+ * the code-injection path, while legitimate CSS is preserved.
+ */
+namespace Magento\Email\Test\Unit\Model;
+
+class TemplateStyleSmugglerTest extends \PHPUnit_Framework_TestCase
+{
+    /**
+     * @param mixed $styles
+     * @param string $templateText
+     * @return \Magento\Email\Model\Template
+     */
+    private function buildTemplate($styles, $templateText)
+    {
+        /** @var \Magento\Email\Model\Template $model */
+        $model = $this->getMockBuilder('Magento\Email\Model\Template')
+            ->setMethods(['_init', 'isPlain'])
+            ->setConstructorArgs(
+                [
+                    $this->getMock('Magento\Framework\Model\Context', [], [], '', false),
+                    $this->getMock('Magento\Theme\Model\View\Design', [], [], '', false),
+                    $this->getMock('Magento\Framework\Registry', [], [], '', false),
+                    $this->getMock('Magento\Store\Model\App\Emulation', [], [], '', false),
+                    $this->getMock('Magento\Store\Model\StoreManager', [], [], '', false),
+                    $this->getMock('Magento\Framework\Filesystem', [], [], '', false),
+                    $this->getMock('Magento\Framework\View\Asset\Repository', [], [], '', false),
+                    $this->getMock('Magento\Framework\View\FileSystem', [], [], '', false),
+                    $this->getMock('Magento\Framework\App\Config\ScopeConfigInterface'),
+                    $this->getMock('Magento\Email\Model\Template\FilterFactory', [], [], '', false),
+                    $this->getMockBuilder('Magento\Email\Model\Template\Config')
+                        ->disableOriginalConstructor()->getMock(),
+                    ['template_id' => 10],
+                ]
+            )->getMock();
+        $model->expects($this->any())->method('isPlain')->will($this->returnValue(false));
+        $model->setTemplateStyles($styles);
+        $model->setTemplateText($templateText);
+        return $model;
+    }
+
+    /**
+     * A directive smuggled through the styles field must not survive intact into
+     * the prepared template text (otherwise the directive filter would execute it).
+     *
+     * @dataProvider maliciousStylesProvider
+     */
+    public function testSmuggledDirectiveInStylesIsNeutralized($malicious)
+    {
+        $model = $this->buildTemplate($malicious, '<p>Hello</p>');
+
+        $prepared = $model->getPreparedTemplateText();
+
+        $this->assertNotContains(
+            '{{var this.getTemplateProcessor()',
+            $prepared,
+            'Smuggled template directive from styles must be neutralized'
+        );
+        // No intact "{{" / "}}" delimiter pair should remain from the styles block.
+        $this->assertNotContains('{{', $prepared, 'No intact opening directive delimiter may remain');
+        $this->assertNotContains('}}', $prepared, 'No intact closing directive delimiter may remain');
+        $this->assertSame(0, preg_match('/{{([a-z]{0,10})(.*?)}}/si', $prepared));
+    }
+
+    public function maliciousStylesProvider()
+    {
+        return [
+            'ordinary directive' => ['body{color:red}{{var this.getTemplateProcessor().filter($_GET)}}'],
+            'overlapping braces' => ['{{{block class="Magento\\Cms\\Block\\Block" id="x"}}}'],
+            'four braces' => ['{{{{block class="Magento\\Cms\\Block\\Block" id="x"}}}}'],
+            'unclosed opening delimiters' => ['body{color:red}{{{{'],
+            'unopened closing delimiters' => ['body{color:red}}}}}'],
+        ];
+    }
+
+    public function testStructuredStylesAreRejected()
+    {
+        $model = $this->buildTemplate(
+            ['class' => 'Magento\\Cms\\Block\\Block', 'id' => 'x'],
+            '<p>Hello</p>'
+        );
+
+        $this->assertSame('<p>Hello</p>', $model->getPreparedTemplateText());
+        $this->assertSame('', $model->getTemplateStyles());
+    }
+
+    /**
+     * Legitimate CSS (no directive delimiters) must pass through unchanged so the
+     * fix does not break normal styled emails.
+     */
+    public function testLegitimateStylesArePreserved()
+    {
+        $css = 'body{color:#333;font-size:14px}.btn{padding:5px}';
+        $model = $this->buildTemplate($css, '<p>Hello</p>');
+
+        $prepared = $model->getPreparedTemplateText();
+
+        $this->assertContains($css, $prepared, 'Legitimate CSS must be preserved verbatim');
+        $this->assertSame($css, $model->getTemplateStyles());
+        $this->assertContains('<style type="text/css">', $prepared);
+        $this->assertContains('<p>Hello</p>', $prepared);
+    }
+}
