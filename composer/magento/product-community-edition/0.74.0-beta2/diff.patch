Description: Fix AIKIDO-2026-248927 (StyleSmuggler) by normalizing email
 template styles before they are merged into filterable template text. Reject
 structured values, remove complete template directives and residual delimiter
 pairs, and write the safe string back to the template object. This prevents
 ordinary and overlapping-brace directive constructions while preserving valid
 CSS and plain-template behavior.
Origin: ai-synthesized, AIKIDO-2026-248927
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-09-06

diff --git a/app/code/Magento/Email/Model/Template.php b/app/code/Magento/Email/Model/Template.php
index 5a331546..01c5fcc8 100644
--- a/app/code/Magento/Email/Model/Template.php
+++ b/app/code/Magento/Email/Model/Template.php
@@ -451,12 +451,33 @@ class Template extends \Magento\Email\Model\AbstractTemplate implements \Magento
      */
     public function getPreparedTemplateText()
     {
-        if ($this->isPlain() || !$this->getTemplateStyles()) {
+        $templateStyles = $this->sanitizeTemplateStyles($this->getTemplateStyles());
+        $this->setTemplateStyles($templateStyles);
+
+        if ($this->isPlain() || $templateStyles === '') {
             return $this->getTemplateText();
         }
         // wrap styles into style tag
         $html = "<style type=\"text/css\">\n%s\n</style>\n%s";
-        return sprintf($html, $this->getTemplateStyles(), $this->getTemplateText());
+        return sprintf($html, $templateStyles, $this->getTemplateText());
+    }
+
+    /**
+     * @param mixed $styles
+     * @return string
+     */
+    protected function sanitizeTemplateStyles($styles)
+    {
+        if (!is_string($styles) || $styles === '') {
+            return '';
+        }
+
+        $sanitized = preg_replace('/\{\{.*?\}\}/s', '', $styles);
+        if ($sanitized === null) {
+            return '';
+        }
+
+        return str_replace(['{{', '}}'], '', $sanitized);
     }
 
