+  /**
+   * Tests that the region is not determined by an arbitrary row callback.
+   *
+   * @covers ::tablePreRender
+   */
+  public function testTablePreRenderIgnoresRegionCallback() {
+    $callback_invoked = FALSE;
+    $elements = [
+      '#regions' => [
+        'content' => [],
+        'hidden' => [],
+      ],
+      'valid' => [
+        'parent_wrapper' => ['parent' => ['#value' => '']],
+        'region' => ['#value' => 'content'],
+        'weight' => ['#value' => 0],
+        '#region_callback' => function () use (&$callback_invoked) {
+          $callback_invoked = TRUE;
+          return 'hidden';
+        },
+      ],
+      'unknown' => [
+        'parent_wrapper' => ['parent' => ['#value' => '']],
+        'region' => ['#value' => 'not_a_region'],
+        'weight' => ['#value' => 1],
+        '#region_callback' => function () use (&$callback_invoked) {
+          $callback_invoked = TRUE;
+          return 'content';
+        },
+      ],
+    ];
+
+    $result = FieldUiTable::tablePreRender($elements);
+
+    $this->assertFalse($callback_invoked);
+    $this->assertSame(['valid'], $result['#regions']['content']['rows_order']);
+    $this->assertSame(['unknown'], $result['#regions']['hidden']['rows_order']);
   }
 
