From 9843c42ef2c6bdbb6e7ba06167d6b1ab416a520a Mon Sep 17 00:00:00 2001
From: Amal C S <amal@infenia.com>
Date: Tue, 23 Sep 2025 10:17:14 +0530
Subject: [PATCH] FIX: CVE-2024-2236

---
 cipher/rsa-common.c | 43 +++++++++++++++++++++++++++++++------------
 1 file changed, 31 insertions(+), 12 deletions(-)

diff --git a/cipher/rsa-common.c b/cipher/rsa-common.c
index 29b7bc8..0fca7bf 100644
--- a/cipher/rsa-common.c
+++ b/cipher/rsa-common.c
@@ -28,6 +28,13 @@
 #include "cipher.h"
 #include "pubkey-internal.h"
 
+/* Constant-time comparison: returns 1 if a < b, 0 otherwise */
+static inline size_t
+ct_lt_s (size_t a, size_t b)
+{
+  return ((a ^ ((a ^ b) | ((a - b) ^ b))) >> (sizeof(size_t) * 8 - 1));
+}
+
 
 /* Turn VALUE into an octet string and store it in an allocated buffer
    at R_FRAME or - if R_RAME is NULL - copy it into the caller
@@ -172,7 +179,9 @@ _gcry_rsa_pkcs1_decode_for_enc (unsigned char **r_result, size_t *r_resultlen,
   gcry_error_t err;
   unsigned char *frame = NULL;
   size_t nframe = (nbits+7) / 8;
-  size_t n;
+  size_t n, n0;
+  unsigned int failed = 0;
+  unsigned int not_found = 1;
 
   *r_result = NULL;
 
@@ -196,28 +205,38 @@ _gcry_rsa_pkcs1_decode_for_enc (unsigned char **r_result, size_t *r_resultlen,
      leading zero bytes nevertheless.  We handle this by making the
      first zero byte optional.  */
   if (nframe < 4)
-    {
-      xfree (frame);
-      return GPG_ERR_ENCODING_PROBLEM;  /* Too short.  */
-    }
+    failed = 1;
+
   n = 0;
   if (!frame[0])
     n++;
-  if (frame[n++] != 0x02)
+
+  /* Check block type in constant time */
+  failed |= (frame[n++] != 0x02);
+
+  /* Find the terminating zero byte in constant time */
+  for (n0 = n; n0 < nframe; n0++)
     {
-      xfree (frame);
-      return GPG_ERR_ENCODING_PROBLEM;  /* Wrong block type.  */
+      unsigned int found_zero = (frame[n0] == 0x00);
+      not_found &= !found_zero;
     }
 
-  /* Skip the non-zero random bytes and the terminating zero byte.  */
+  failed |= not_found;
+
+  /* Find actual position of zero byte */
   for (; n < nframe && frame[n] != 0x00; n++)
     ;
-  if (n+1 >= nframe)
+  n++; /* Skip the zero byte.  */
+
+  /* CVE-2024-2236: The valid padding is at least 8 bytes --
+     the plaintext needs to start at index 11 or later */
+  failed |= ct_lt_s (n, 11);
+
+  if (failed)
     {
       xfree (frame);
-      return GPG_ERR_ENCODING_PROBLEM; /* No zero byte.  */
+      return GPG_ERR_ENCODING_PROBLEM;
     }
-  n++; /* Skip the zero byte.  */
 
   /* To avoid an extra allocation we reuse the frame buffer.  The only
      caller of this function will anyway free the result soon.  */
-- 
