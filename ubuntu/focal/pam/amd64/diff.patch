Description: CVE-2024-10041 - pam_unix: always use helper for shadow entries
 A vulnerability was found in PAM where secret information (password
 hashes from /etc/shadow) is stored in memory via pam_modutil_getspnam()
 during authentication. An attacker able to influence the victim process
 can exploit speculative execution to leak those hashes.
 .
 Upstream fix (b3020da): stop calling pam_modutil_getspnam() from
 pam_unix.so for shadowed accounts and always invoke the setuid helper
 instead, so hashes are not retained in the calling process address space.
 .
 Follow-up (b7b9636): always attempt setuid(0) before exec'ing the
 helper so credential checks still work when the caller has CAP_SETUID
 but geteuid() != 0.
 .
 Backport notes for Ubuntu focal (1.3.1-5ubuntu4.7):
 - passverify.c still has Debian/Ubuntu pam_unix_fix_sgid_shadow_auth
   logic (try getspnam first, helper only on failure); rewrite that
   path to match upstream always-helper semantics.
Origin: backport, https://github.com/linux-pam/linux-pam/commit/b3020da7da384d769f27a8713257fbe1001878be
Origin: backport, https://github.com/linux-pam/linux-pam/commit/b7b96362087414e52524d3d9d9b3faa21e1db620
Bug: https://github.com/linux-pam/linux-pam/issues/846
Last-Update: 2026-08-19

--- a/modules/pam_unix/passverify.c
+++ b/modules/pam_unix/passverify.c
@@ -196,17 +196,21 @@ PAMH_ARG_DECL(int get_account_info,
 			return PAM_UNIX_RUN_HELPER;
 #endif
 		} else if (is_pwd_shadowed(*pwd)) {
+#ifdef HELPER_COMPILE
 			/*
-			 * ...and shadow password file entry for this user,
+			 * shadow password file entry for this user,
 			 * if shadowing is enabled
 			 */
 			*spwdent = pam_modutil_getspnam(pamh, name);
-#ifndef HELPER_COMPILE
-			if (*spwdent == NULL && (geteuid() || SELINUX_ENABLED))
-				return PAM_UNIX_RUN_HELPER;
-#endif
 			if (*spwdent == NULL || (*spwdent)->sp_pwdp == NULL)
 				return PAM_AUTHINFO_UNAVAIL;
+#else
+			/*
+			 * The helper has to be invoked to deal with
+			 * the shadow password file entry (CVE-2024-10041).
+			 */
+			return PAM_UNIX_RUN_HELPER;
+#endif
 		}
 	} else {
 		return PAM_USER_UNKNOWN;
--- a/modules/pam_unix/pam_unix_acct.c
+++ b/modules/pam_unix/pam_unix_acct.c
@@ -111,14 +111,15 @@ int _unix_run_verify_binary(pam_handle_t *pamh, unsigned long long ctrl,
       _exit(PAM_AUTHINFO_UNAVAIL);
     }
 
-    if (geteuid() == 0) {
-      /* must set the real uid to 0 so the helper will not error
-         out if pam is called from setuid binary (su, sudo...) */
-      if (setuid(0) == -1) {
-          pam_syslog(pamh, LOG_ERR, "setuid failed: %m");
-          printf("-1\n");
-          fflush(stdout);
-          _exit(PAM_AUTHINFO_UNAVAIL);
+    /* must set the real uid to 0 so the helper will not error
+       out if pam is called from setuid binary (su, sudo...) */
+    if (setuid(0) == -1) {
+      uid_t euid = geteuid();
+      pam_syslog(pamh, euid == 0 ? LOG_ERR : LOG_DEBUG, "setuid failed: %m");
+      if (euid == 0) {
+	printf("-1\n");
+	fflush(stdout);
+	_exit(PAM_AUTHINFO_UNAVAIL);
       }
     }
 
--- a/modules/pam_unix/support.c
+++ b/modules/pam_unix/support.c
@@ -575,13 +575,13 @@ static int _unix_run_helper_binary(pam_handle_t *pamh, const char *passwd,
 		_exit(PAM_AUTHINFO_UNAVAIL);
 	}
 
-	if (geteuid() == 0) {
-          /* must set the real uid to 0 so the helper will not error
-	     out if pam is called from setuid binary (su, sudo...) */
-	  if (setuid(0) == -1) {
-             D(("setuid failed"));
-	     _exit(PAM_AUTHINFO_UNAVAIL);
-          }
+	/* must set the real uid to 0 so the helper will not error
+	   out if pam is called from setuid binary (su, sudo...) */
+	if (setuid(0) == -1) {
+	   D(("setuid failed"));
+	   if (geteuid() == 0) {
+	      _exit(PAM_AUTHINFO_UNAVAIL);
+	   }
 	}
 
 	/* exec binary helper */
Description: Remove extrausers and faillock references from libpam-modules-bin.install
 This patch removes references to non-existent files related to extrausers and faillock.
Author: RootIO <info@root.io>
Origin: other
Forwarded: no
Last-Update: 2024-03-26

--- a/debian/libpam-modules-bin.install
+++ b/debian/libpam-modules-bin.install
@@ -3,8 +3,4 @@
 sbin/pam_tally		sbin
 sbin/pam_tally2         sbin
 sbin/mkhomedir_helper	sbin
-sbin/pam_timestamp_check	usr/sbin
-sbin/pam_extrausers_chkpwd	sbin
-sbin/pam_extrausers_update	sbin
-sbin/faillock usr/sbin
-modules/pam_faillock/faillock.8 usr/share/man/man8
+sbin/pam_timestamp_check	usr/sbin
--- a/debian/rules
+++ b/debian/rules
@@ -30,7 +30,7 @@
		--libdir=/lib/$(DEB_HOST_MULTIARCH) \
		--enable-isadir=/lib/security \
		$(CONFIGURE_OPTS)
-	chmod 775 modules/pam_faillock/tst-pam_faillock
+	[ -f modules/pam_faillock/tst-pam_faillock ] && chmod 775 modules/pam_faillock/tst-pam_faillock || true
 
 # .install files don't have "except for" handling, so we need to exclude
 # our module that doesn't match right here
@@ -63,6 +63,4 @@
 ifneq (,$(findstring libpam-modules, $(shell dh_listpackages)))
	chgrp shadow $(d)/libpam-modules-bin/sbin/unix_chkpwd
	chmod 02755 $(d)/libpam-modules-bin/sbin/unix_chkpwd
-	chgrp shadow $(d)/libpam-modules-bin/sbin/pam_extrausers_chkpwd
-	chmod 02755 $(d)/libpam-modules-bin/sbin/pam_extrausers_chkpwd
 endif
