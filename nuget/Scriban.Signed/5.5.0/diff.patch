+using NUnit.Framework;
+using Scriban.Parsing;
+
+namespace Scriban.Tests
+{
+    [TestFixture]
+    public class TestExpressionDepthLimit
+    {
+        [Test]
+        public void TestDeeplyNestedParenthesesAreRejectedByDefault()
+        {
+            // GHSA-wgh7-7m3c-fx25: unbounded expression nesting could overflow the stack.
+            var depth = 100000;
+            var text = "{{ " + new string('(', depth) + "1" + new string(')', depth) + " }}";
+            var template = Template.Parse(text);
+            Assert.True(template.HasErrors);
+            StringAssert.Contains("The statement depth limit `250` was reached", template.Messages[0].Message);
+        }
+
+        [Test]
+        public void TestDefaultLimitsAreSafe()
+        {
+            Assert.AreEqual(1048576, new TemplateContext().LimitToString);
+            Assert.AreEqual(20, new TemplateContext().ObjectRecursionLimit);
+        }
+    }
+}

