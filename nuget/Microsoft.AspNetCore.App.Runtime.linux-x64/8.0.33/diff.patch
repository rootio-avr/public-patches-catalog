+
+                var context = MakeRequest("/foo", connection, services);
+                context.User = mallory;
+                var requestTask = dispatcher.ExecuteAsync(context, options, _ => application.Task);
+
+                const string payload = "payload-from-subsequent-long-poll";
+                await connection.Transport.Output.WriteAsync(
