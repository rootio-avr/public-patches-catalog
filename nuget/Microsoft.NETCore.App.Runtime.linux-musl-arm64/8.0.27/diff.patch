+                            if (value is null)
+                            {
+                                sanWriter.WriteNull();
+                            }
+                            else if (value is bool b)
+                            {
+                                sanWriter.WriteBoolean(b);
+                            }
+                            else if (value is int i)
+                            {
+                                sanWriter.WriteInteger(i);
