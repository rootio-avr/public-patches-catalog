@@ -32,6 +32,9 @@ type Resolver interface {
 	SetExtServers([]extDNSEntry)
 	// ResolverOptions returns resolv.conf options that should be set
 	ResolverOptions() []string
+	// SetForwardingPolicy re-configures the embedded DNS resolver to either
+	// enable or disable forwarding DNS queries to external servers.
+	SetForwardingPolicy(policy bool)
 }

 // DNSBackend represents a backend DNS resolver used for DNS name
@@ -196,6 +199,12 @@ func (r *resolver) SetExtServers(extDNS []extDNSEntry) {
 	}
 }

+// SetForwardingPolicy re-configures the embedded DNS resolver to either enable
+// or disable forwarding DNS queries to external servers.
+func (r *resolver) SetForwardingPolicy(policy bool) {
+	r.proxyDNS = policy
+}
+
 func (r *resolver) NameServer() string {
 	return r.listenAddress
 }
