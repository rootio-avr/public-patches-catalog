+/* Regression test for CVE-2026-63388: heap out-of-bounds write via an
+ * over-long connection address (e.g. a crafted AF_UNIX sockaddr coming in
+ * through evhttp) recorded by bufferevent_socket_set_conn_address_().
+ *
+ * Before the fix, conn_address was an undersized union and the length guard
+ * was an NDEBUG-gated EVUTIL_ASSERT, so an address larger than the union
+ * caused a heap overflow (or an abort() without NDEBUG).  After the fix,
+ * conn_address is a struct sockaddr_storage and the length is checked
+ * unconditionally at runtime: an over-long address must be rejected with
+ * EVUTIL_EAI_FAIL and must NOT be copied, while a normally sized address is
+ * still stored successfully. */
+static void
+test_bufferevent_set_conn_address_overflow(void *arg)
+{
+	struct basic_test_data *data = arg;
+	struct bufferevent *bev = NULL;
+	struct sockaddr_storage ok_addr;
+	struct sockaddr_in *sin;
+	/* A buffer larger than any address the destination can hold. */
+	char big[sizeof(struct sockaddr_storage) + 64];
+	int r;
+
+	bev = bufferevent_socket_new(data->base, -1, BEV_OPT_CLOSE_ON_FREE);
+	tt_assert(bev);
+
+	/* Over-long address: must be rejected, not copied (no heap overflow). */
+	memset(big, 0xab, sizeof(big));
