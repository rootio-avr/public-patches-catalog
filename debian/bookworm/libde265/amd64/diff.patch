Description: CVE-2026-88373 - validate passed NAL header length
 A NAL unit pushed via de265_push_NAL() must contain at least its two-byte
 NAL unit header. A shorter (zero/one-byte) or negative length was accepted
 and later turned into a memcpy() with a NULL/zero-length destination and,
 once queued, aborted decoding of the whole stream during header parsing.
 This backports upstream commit f8d324914e43d92af23614f22959cf9eee7bf9ea:
 add a new DE265_ERROR_INVALID_ARGUMENT error code, reject NAL units shorter
 than two bytes at the top of NAL_Parser::push_NAL() before any state is
 touched, and guard the two memcpy() calls in NAL_unit::append/set_data with
 an n > 0 check.
 .
 The new enum value is assigned numeric 21 to match upstream (values 19/20 are
 reserved upstream for IMAGE/NAL size-limit errors not present in this version,
 so 21 avoids a future collision).
Origin: upstream, https://github.com/strukturag/libde265/commit/f8d324914e43d92af23614f22959cf9eee7bf9ea
Author: Dirk Farin <dirk.farin@gmail.com>
Last-Update: 2026-09-26
---
--- a/libde265/de265.cc
+++ b/libde265/de265.cc
@@ -85,6 +85,7 @@ LIBDE265_API const char* de265_get_error_text(de265_error err)
   case DE265_ERROR_CANNOT_START_THREADPOOL: return "cannot start decoding threads";
   case DE265_ERROR_LIBRARY_INITIALIZATION_FAILED: return "global library initialization failed";
   case DE265_ERROR_LIBRARY_NOT_INITIALIZED: return "cannot free library data (not initialized";
+  case DE265_ERROR_INVALID_ARGUMENT: return "invalid argument";

   //case DE265_ERROR_MAX_THREAD_CONTEXTS_EXCEEDED:
   //  return "internal error: maximum number of thread contexts exceeded";
--- a/libde265/de265.h
+++ b/libde265/de265.h
@@ -103,6 +103,7 @@ typedef enum {
   DE265_ERROR_NO_INITIAL_SLICE_HEADER=16,
   DE265_ERROR_PREMATURE_END_OF_SLICE=17,
   DE265_ERROR_UNSPECIFIED_DECODING_ERROR=18,
+  DE265_ERROR_INVALID_ARGUMENT=21,

   // --- errors that should become obsolete in later libde265 versions ---

@@ -256,6 +257,9 @@ LIBDE265_API void        de265_push_end_of_frame(de265_decoder_context*);
 /* Push a complete NAL unit without startcode into the decoder. The data must still
    contain all stuffing-bytes.
    This function only pushes data into the decoder, nothing will be decoded.
+   The NAL unit must at least contain the two-byte NAL unit header. A shorter
+   (or negative) length is rejected with DE265_ERROR_INVALID_ARGUMENT and nothing
+   is pushed.
 */
 LIBDE265_API de265_error de265_push_NAL(de265_decoder_context*, const void* data, int length,
                                         de265_PTS pts, void* user_data);
--- a/libde265/nal-parser.cc
+++ b/libde265/nal-parser.cc
@@ -82,7 +82,9 @@ LIBDE265_CHECK_RESULT bool NAL_unit::append(const unsigned char* in_data, int n)
   if (!resize(data_size + n)) {
     return false;
   }
-  memcpy(nal_data + data_size, in_data, n);
+  if (n > 0) {
+    memcpy(nal_data + data_size, in_data, n);
+  }
   data_size += n;
   return true;
 }
@@ -92,7 +94,9 @@ bool LIBDE265_CHECK_RESULT NAL_unit::set_data(const unsigned char* in_data, int
   if (!resize(n)) {
     return false;
   }
-  memcpy(nal_data, in_data, n);
+  if (n > 0) {
+    memcpy(nal_data, in_data, n);
+  }
   data_size = n;
   return true;
 }
@@ -373,6 +377,14 @@ de265_error NAL_Parser::push_NAL(const unsigned char* data, int len,

   // Cannot use byte-stream input and NAL input at the same time.
   assert(pending_input_NAL == NULL);
+
+  // A NAL unit must at least contain its two-byte header. Reject anything shorter
+  // (including a negative length) before touching any state: a zero-length unit
+  // would otherwise end up as a memcpy() with a NULL destination and, once queued,
+  // would fail header parsing in decode_NAL() and abort decoding of the stream.
+  if (len < 2) {
+    return DE265_ERROR_INVALID_ARGUMENT;
+  }

   end_of_frame = false;

   NAL_unit* nal = alloc_NAL_unit(len);
Description: CVE-2025-61147 - Fix segmentation fault in decoder_context::compute_framedrop_table()
 Replace unsafe atoi() calls with validated parse_param() function that
 checks for invalid input, out-of-range values, and enforces bounds on
 integer command line parameters. This prevents segmentation faults caused
 by malformed command line arguments.
 Adapted for C++11 compatibility by replacing std::optional with sentinel
 values (-1 means no bound).
Origin: upstream, https://github.com/strukturag/libde265/commit/8b17e0930f77db07f55e0b89399a8f054ddbecf7
Author: Dirk Farin <dirk.farin@gmail.com>
Last-Update: 2026-03-31

--- a/dec265/dec265.cc
+++ b/dec265/dec265.cc
@@ -27,6 +27,10 @@
 #define DO_MEMORY_LOGGING 0
 
 #include "de265.h"
+#include <stdexcept>
+#include <iostream>
+#include <string>
+
 #ifdef HAVE_CONFIG_H
 #include "config.h"
 #endif
@@ -558,6 +561,40 @@
 #endif
 
 
+int parse_param(const char* arg, int lower_bound, int upper_bound, const char* arg_name)
+{
+  int value;
+
+  try {
+    size_t len;
+    value = std::stoi(arg, &len);
+    if (arg[len] != 0) {
+      std::cerr << "invalid argument to " << arg_name << "\n";
+      exit(5);
+    }
+  } catch (std::invalid_argument const& ex) {
+    std::cerr << "invalid argument to " << arg_name << "\n";
+    exit(5);
+  }
+  catch (std::out_of_range const& ex) {
+    std::cerr << "argument to " << arg_name << " is out of range\n";
+    exit(5);
+  }
+
+  if (lower_bound != -1 && value < lower_bound) {
+    std::cerr << "argument to " << arg_name << " may not be smaller than " << lower_bound << "\n";
+    exit(5);
+  }
+
+  if (upper_bound != -1 && value > upper_bound) {
+    std::cerr << "argument to " << arg_name << " may not be larger than " << upper_bound << "\n";
+    exit(5);
+  }
+
+  return value;
+}
+
+
 int main(int argc, char** argv)
 {
   while (1) {
@@ -573,9 +608,9 @@
 
     switch (c) {
     case 'q': quiet++; break;
-    case 't': nThreads=atoi(optarg); break;
+    case 't': nThreads=parse_param(optarg, 0, -1, "-t"); break;
     case 'c': check_hash=true; break;
-    case 'f': max_frames=atoi(optarg); break;
+    case 'f': max_frames=parse_param(optarg, 1, -1, "-f"); break;
     case 'o': write_yuv=true; output_filename=optarg; break;
     case 'h': show_help=true; break;
     case 'd': dump_headers=true; break;
@@ -587,7 +622,7 @@
     case 'm': measure_quality=true; reference_filename=optarg; break;
     case 's': show_ssim_map=true; break;
     case 'e': show_psnr_map=true; break;
-    case 'T': highestTID=atoi(optarg); break;
+    case 'T': highestTID=parse_param(optarg, 0, -1, "-T"); break;
     case 'v': verbosity++; break;
     }
   }
