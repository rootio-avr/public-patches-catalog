Description: CVE-2026-93546 - limit mod_dav property database namespaces
 Limit the number of distinct namespace URIs recorded in a single DAV
 property database (DAV_PROPDB_NS_MAX), reject an invalid (negative)
 namespace count when opening the database, bounds-check namespace ids in
 dav_get_ns_table_uri(), and propagate map_namespaces() errors in
 dav_prop_validate() instead of ignoring them.
Origin: upstream, commit:fa8c354189597453b2c8b38e081efa9b723abd3c
Author: Eric Covener <covener@apache.org>
Last-Update: 2026-10-12
---
--- a/modules/dav/fs/dbm.c
+++ b/modules/dav/fs/dbm.c
@@ -309,6 +309,12 @@ typedef struct {
 
 } dav_propdb_metadata;
 
+/* Upper bound on the number of distinct namespace URIs recorded in one
+ * property database.  Namespace ids are looked up by walking the table, so
+ * the cost of enumerating properties grows with this; it must also remain
+ * well within the range of the 16-bit ns_count field above. */
+#define DAV_PROPDB_NS_MAX       2048
+
 struct dav_deadprop_rollback {
     apr_datum_t key;
     apr_datum_t value;
@@ -488,6 +494,14 @@ static dav_error * dav_propdb_open(apr_pool_t *pool,
         }
         db->version = m.minor;
         db->ns_count = ntohs(m.ns_count);
+        if (db->ns_count < 0) {
+            dav_dbm_close(db);
+
+            return dav_new_error(pool, HTTP_INTERNAL_SERVER_ERROR,
+                                 DAV_ERR_PROP_OPENING, 0,
+                                 "Prop database namespace table is "
+                                 "invalid and cannot be used.");
+        }
 
         dav_dbm_freedatum(db, value);
 
@@ -614,6 +628,13 @@ static dav_error * dav_propdb_map_namespaces(
         long ns_id = (long)apr_hash_get(db->uri_index, uri, uri_len);
 
         if (ns_id == 0) {
+            if (db->ns_count >= DAV_PROPDB_NS_MAX) {
+                return dav_new_error(db->pool, HTTP_REQUEST_ENTITY_TOO_LARGE,
+                                     0, 0,
+                                     "Too many distinct namespaces in "
+                                     "property database.");
+            }
+
             dav_check_bufsize(db->pool, &db->ns_table, uri_len + 1);
             memcpy(db->ns_table.buf + db->ns_table.cur_len, uri, uri_len + 1);
             db->ns_table.cur_len += uri_len + 1;
