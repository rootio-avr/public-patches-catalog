Description: CVE-2026-63686 - mod_xml2enc: handle incomplete input
 xml2enc_ffunc() compared the apr_xlate_conv_buffer() result against
 APR_EINCOMPLETE (an errno-style value) instead of APR_INCOMPLETE, so
 incomplete multibyte sequences fell into the default branch. That branch
 cleared ctx->convset and kept looping, leading to a NULL pointer
 dereference. Handle APR_INCOMPLETE correctly, and on a hard conversion
 failure pass the remaining data through raw and remove the filter.
Origin: upstream, https://github.com/apache/httpd/commit/6fa059e4a270e0a66dd398e96875df86abff3a75
Author: Eric Covener <covener@apache.org>
Last-Update: 2026-10-12
---
--- a/modules/filters/mod_xml2enc.c
+++ b/modules/filters/mod_xml2enc.c
@@ -526,9 +526,10 @@
                     switch (rv) {
                     case APR_SUCCESS:
                         continue;
-                    case APR_EINCOMPLETE:
+                    case APR_INCOMPLETE:
                         ap_log_rerror(APLOG_MARK, APLOG_DEBUG, 0, f->r, APLOGNO(01443)
-                                      "INCOMPLETE");
+                                      "Incomplete byte sequence: %" APR_SIZE_T_FMT
+                                      " bytes unconverted", insz);
                         continue;     /* If outbuf too small, go round again.
                                        * If it was inbuf, we'll break out when
                                        * we test ctx->bytes == ctx->bblen
@@ -539,9 +540,7 @@
                         --insz;
                         continue;
                     default:
-                        /* Erk!  What's this?
-                         * Bail out, flush, and hope to eat the buf raw
-                         */
+                        /* Bail out, flush, and pass remaining data raw. */
                         ap_log_rerror(APLOG_MARK, APLOG_ERR, rv, f->r, APLOGNO(01445)
                                       "Failed to convert input; trying it raw") ;
                         ctx->convset = NULL;
@@ -550,6 +549,14 @@
                             ap_log_rerror(APLOG_MARK, APLOG_DEBUG, rv, f->r, APLOGNO(01446)
                                           "ap_fflush failed");
                         apr_brigade_cleanup(ctx->bbnext);
+                        if (insz) {
+                            b = apr_bucket_transient_create(
+                                    buf + (bytes - insz), insz,
+                                    bb->bucket_alloc);
+                            APR_BRIGADE_INSERT_HEAD(bb, b);
+                        }
+                        ap_remove_output_filter(f);
+                        return ap_pass_brigade(f->next, bb);
                     }
                 }
             } else {
@@ -558,7 +565,7 @@
             }
             if (bdestroy)
                 apr_bucket_destroy(bdestroy);
-            if (rv != APR_SUCCESS)
+            if (rv != APR_SUCCESS && rv != APR_INCOMPLETE)
                 return rv;
         }
     }
Description: CVE-2026-47360 - mod_session_cookie: remove session cookie consistently
 When SessionCookieRemove is enabled, the session note cached in the
 connection notes could be returned on an internal redirect without the
 cookie being removed, and util_cookies could build the stripped Cookie
 header with a leading separator. Drop the cached note when removal is
 requested so the cookie is re-read and removed, and avoid emitting a
 leading separator when rebuilding the Cookie header.
