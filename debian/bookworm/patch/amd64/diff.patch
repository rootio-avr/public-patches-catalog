Description: Fix CVE-2010-4651: Do not let a malicious patch create files above current directory
 Directory traversal in util.c allows creating/overwriting arbitrary files via
 filenames with ".." or absolute paths. Reject absolute file names and file
 names containing ".." in strip_leading_slashes().
Origin: https://cgit.git.savannah.gnu.org/cgit/patch.git/commit/?id=685a78b6052f4df6eac6d625a545cfb54a6ac0e1
Author: Jim Meyering <meyering@redhat.com>, Andreas Gruenbacher <agruen@linbit.com>
Last-Update: 2026-03-19

diff --git a/src/util.c b/src/util.c
--- a/src/util.c
+++ b/src/util.c
@@ -1415,6 +1415,17 @@ strip_leading_slashes (char *name, int strip_leading)
 	n = p+1;
       }
     }
+  if (IS_ABSOLUTE_FILE_NAME (n))
+    fatal ("rejecting absolute file name: %s", quotearg (n));
+  for (p = n; *p; )
+    {
+      if (*p == '.' && *++p == '.' && (!*++p || ISSLASH (*p)))
+	fatal ("rejecting file name with \"..\" component: %s", quotearg (n));
+      while (*p && ! ISSLASH (*p))
+	p++;
+      while (ISSLASH (*p))
+	p++;
+    }
   if ((strip_leading < 0 || s <= 0) && *n)
     {
       memmove (name, n, strlen (n) + 1);
Description: Fix CVE-2021-45261: Invalid Pointer in another_hunk() (incomplete fix for CVE-2018-6952)
 When 'old' lines are omitted from a context diff hunk, p_end is jumped
 forward without initializing intermediate p_line[] entries, leaving
 garbage pointers that crash when freed. Replace the direct assignment
 with a loop that NULLs each p_line[] entry as p_end advances.
Origin: https://savannah.gnu.org/bugs/?61685
Author: Petr Sumbera <petr.sumbera@oracle.com>
Last-Update: 2026-02-23

diff --git a/src/pch.c b/src/pch.c
--- a/src/pch.c
+++ b/src/pch.c
@@ -1336,7 +1336,8 @@ another_hunk (enum diff difftype, bool rev)
 			/* 'Old' lines were omitted.  Set up to fill
 			   them in from 'new' context lines.  */
 			ptrn_missing = true;
-			p_end = p_ptrn_lines + 1;
+			while (p_end < p_ptrn_lines + 1)
+			    p_line[p_end++] = NULL;
 			ptrn_prefix_context = ptrn_suffix_context = -1;
 			fillsrc = p_end + 1;
 			filldst = 1;
