+#include <time.h>
+#include <gnutls/gnutls.h>
+#include <gnutls/x509.h>
+
+#include "utils.h"
+
+#define SRV_OID "1.3.6.1.5.5.7.8.7"
+#define HOST "example.org"
+
+/* Builds a self-signed TLS server certificate with CN=example.org.
+ * If @san_data is not NULL, an SRV otherName SAN is added using @flags. */
+static void make_cert(gnutls_x509_crt_t *out, gnutls_x509_privkey_t key,
+		      const void *san_data, unsigned san_size,
+		      unsigned flags)
+{
+	gnutls_x509_crt_t crt;
+	gnutls_datum_t der;
+	time_t now = time(NULL);
+	unsigned char serial = 1;
+	int ret;
+
+	ret = gnutls_x509_crt_init(&crt);
+	if (ret < 0)
+		fail("%d: crt_init: %d\n", __LINE__, ret);
+
+	ret = gnutls_x509_crt_set_version(crt, 3);
+	if (ret < 0)
+		fail("%d: set_version: %d\n", __LINE__, ret);
+	ret = gnutls_x509_crt_set_key(crt, key);
+	if (ret < 0)
+		fail("%d: set_key: %d\n", __LINE__, ret);
+	ret = gnutls_x509_crt_set_dn_by_oid(crt, GNUTLS_OID_X520_COMMON_NAME,
+					    0, HOST, strlen(HOST));
+	if (ret < 0)
+		fail("%d: set_dn: %d\n", __LINE__, ret);
+	gnutls_x509_crt_set_activation_time(crt, now - 3600);
+	gnutls_x509_crt_set_expiration_time(crt, now + 3600);
+	gnutls_x509_crt_set_serial(crt, &serial, 1);
+	ret = gnutls_x509_crt_set_key_purpose_oid(crt,
+						  GNUTLS_KP_TLS_WWW_SERVER, 0);
+	if (ret < 0)
+		fail("%d: set_key_purpose: %d\n", __LINE__, ret);
+
+	if (san_data) {
+		ret = gnutls_x509_crt_set_subject_alt_othername(
+			crt, SRV_OID, san_data, san_size,
+			GNUTLS_FSAN_SET | flags);
+		if (ret < 0)
+			fail("%d: set_subject_alt_othername: %d\n", __LINE__,
+			     ret);
+	}
+
+	ret = gnutls_x509_crt_sign2(crt, crt, key, GNUTLS_DIG_SHA256, 0);
+	if (ret < 0)
+		fail("%d: sign: %d\n", __LINE__, ret);
+
+	/* round-trip through DER so that the SAN cache is populated */
+	ret = gnutls_x509_crt_export2(crt, GNUTLS_X509_FMT_DER, &der);
+	if (ret < 0)
+		fail("%d: export: %d\n", __LINE__, ret);
+	gnutls_x509_crt_deinit(crt);
+
+	ret = gnutls_x509_crt_init(&crt);
+	if (ret < 0)
+		fail("%d: crt_init: %d\n", __LINE__, ret);
+	ret = gnutls_x509_crt_import(crt, &der, GNUTLS_X509_FMT_DER);
+	if (ret < 0)
+		fail("%d: import: %d\n", __LINE__, ret);
+	gnutls_free(der.data);
+
+	*out = crt;
+}
+
+void doit(void)
+{
+	gnutls_x509_privkey_t key;
+	gnutls_x509_crt_t crt;
+	/* DER IA5String "_xmpp-client.example.org" (well-formed SRV value) */
+	static const char ia5[] = "\x16\x18_xmpp-client.example.org";
+	static const char name[] = "_xmpp-client.example.org";
+	int ret;
+
+	ret = global_init();
+	if (ret < 0)
+		fail("global_init: %d\n", ret);
+
+	ret = gnutls_x509_privkey_init(&key);
+	if (ret < 0)
+		fail("%d: privkey_init: %d\n", __LINE__, ret);
+	ret = gnutls_x509_privkey_generate(
+		key, GNUTLS_PK_ECDSA,
+		GNUTLS_CURVE_TO_BITS(GNUTLS_ECC_CURVE_SECP256R1), 0);
+	if (ret < 0)
+		fail("%d: privkey_generate: %d\n", __LINE__, ret);
+
+	/* Control: no SAN at all, the CN fallback must keep working. */
+	make_cert(&crt, key, NULL, 0, 0);
+	if (!gnutls_x509_crt_check_hostname(crt, HOST))
+		fail("%d: CN fallback broken for certificate without SAN\n",
+		     __LINE__);
+	gnutls_x509_crt_deinit(crt);
+
+	/* Well-formed SRV SAN (IA5String): no CN fallback. */
+	make_cert(&crt, key, ia5, sizeof(ia5) - 1, 0);
+	if (gnutls_x509_crt_check_hostname(crt, HOST))
+		fail("%d: CN fallback used despite IA5String SRV SAN\n",
+		     __LINE__);
+	gnutls_x509_crt_deinit(crt);
+
+	/* Malformed SRV SAN holding an OCTET STRING: no CN fallback. */
+	make_cert(&crt, key, name, sizeof(name) - 1,
+		  GNUTLS_FSAN_ENCODE_OCTET_STRING);
+	if (gnutls_x509_crt_check_hostname(crt, HOST))
+		fail("%d: CN fallback used despite OCTET STRING SRV SAN\n",
+		     __LINE__);
+	if (gnutls_x509_crt_check_hostname2(crt, HOST, 0))
+		fail("%d: check_hostname2 CN fallback with OCTET STRING SRV\n",
+		     __LINE__);
+	gnutls_x509_crt_deinit(crt);
+
+	gnutls_x509_privkey_deinit(key);
+	gnutls_global_deinit();
+
+	if (debug)
+		success("success\n");
+}
Description: Reject certificates with an empty Key Usage extension (CVE-2026-67693)
 A Key Usage extension with no bits set decodes to the same value (0) as an
 absent extension, so a critical, empty Key Usage combined with serverAuth in
 the Extended Key Usage was accepted as trusted. RFC 5280 requires at least one
 Key Usage bit to be set whenever the extension is present. Reject end-entity
 certificates carrying an empty Key Usage extension during chain verification
 (GNUTLS_CERT_INVALID | GNUTLS_CERT_PURPOSE_MISMATCH). A regression test is
 included.

Origin: ai-synthesized, CVE-2026-67693
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-11

--- a/lib/x509/verify.c
+++ b/lib/x509/verify.c
@@ -993,6 +993,28 @@
 		return status;
 	}
 
+	/* RFC 5280, 4.2.1.3: when the keyUsage extension is present, at
+	 * least one of its bits must be set. A keyUsage extension with no
+	 * bits set forbids every key operation, but it decodes to the same
+	 * value (0) as an absent extension, which consumers treat as
+	 * "unrestricted". Reject such end-entity certificates here rather
+	 * than letting them be trusted through their extended key usage. */
+	{
+		unsigned int ku = 0;
+
+		ret = gnutls_x509_crt_get_key_usage(certificate_list[0], &ku, NULL);
+		if (ret >= 0 && ku == 0) {
+			gnutls_assert();
+			status |= GNUTLS_CERT_INVALID;
+			status |= GNUTLS_CERT_PURPOSE_MISMATCH;
+
+			if (func)
+				func(certificate_list[0], certificate_list[0],
+				     NULL, status);
+			return status;
+		}
+	}
+
 	memset(&vparams, 0, sizeof(vparams));
 	vparams.now = now;
 	vparams.max_path = MAX_VERIFY_DEPTH;
