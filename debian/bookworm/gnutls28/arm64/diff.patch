 	 status-request status-request-ok rfc7633-missing sign-verify-ext \
 	 fallback-scsv pkcs8-key-decode urls dtls-rehandshake-cert rfc7633-ok \
-	 key-usage-rsa key-usage-ecdhe-rsa mini-session-verify-function auto-verify \
+	 key-usage-rsa key-usage-ecdhe-rsa x509-empty-key-usage mini-session-verify-function auto-verify \
 	 record-timeouts mini-dtls-hello-verify-48 set-default-prio \
 	 tls12-anon-upgrade tlsext-decoding rsa-psk-cb gnutls-ids \
 	 rehandshake-switch-cert rehandshake-switch-cert-allow rehandshake-switch-cert-client \
--- /dev/null
+++ b/tests/x509-empty-key-usage.c
@@ -0,0 +1,153 @@
+/*
+ * Regression test for CVE-2026-67693: an end-entity certificate with a
+ * critical, empty (no bits set) Key Usage extension and serverAuth in its
+ * Extended Key Usage must not be reported as trusted.
+ *
+ * This file is part of GnuTLS.
+ *
+ * GnuTLS is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <gnutls/gnutls.h>
+#include <gnutls/x509.h>
+
+#include "utils.h"
+
+static void tls_log_func(int level, const char *str)
+{
+	fprintf(stderr, "|<%d>| %s", level, str);
+}
+
+static void gen_key(gnutls_x509_privkey_t *key)
+{
+	int ret;
+
+	ret = gnutls_x509_privkey_init(key);
+	if (ret < 0)
+		fail("privkey_init: %s\n", gnutls_strerror(ret));
+
+	ret = gnutls_x509_privkey_generate(*key, GNUTLS_PK_ECDSA,
+					   GNUTLS_CURVE_TO_BITS(GNUTLS_ECC_CURVE_SECP256R1), 0);
+	if (ret < 0)
+		fail("privkey_generate: %s\n", gnutls_strerror(ret));
+}
+
+/* empty_ku: add a critical Key Usage extension with every bit cleared;
+ * otherwise add a normal digitalSignature Key Usage. */
+static void make_cert(gnutls_x509_crt_t *crt, gnutls_x509_privkey_t key,
+		      gnutls_x509_crt_t issuer, gnutls_x509_privkey_t issuer_key,
+		      unsigned is_ca, unsigned empty_ku, const char *cn)
+{
+	static const unsigned char empty_bitstring[] = { 0x03, 0x01, 0x00 };
+	time_t now = time(NULL);
+	int ret;
+
+	assert(gnutls_x509_crt_init(crt) >= 0);
+	assert(gnutls_x509_crt_set_key(*crt, key) >= 0);
+	assert(gnutls_x509_crt_set_version(*crt, 3) >= 0);
+	assert(gnutls_x509_crt_set_serial(*crt, is_ca ? "\x01" : "\x02", 1) >= 0);
+	assert(gnutls_x509_crt_set_activation_time(*crt, now - 3600) >= 0);
+	assert(gnutls_x509_crt_set_expiration_time(*crt, now + 3600) >= 0);
+	assert(gnutls_x509_crt_set_dn_by_oid(*crt, GNUTLS_OID_X520_COMMON_NAME,
+					     0, cn, strlen(cn)) >= 0);
+
+	if (is_ca) {
+		assert(gnutls_x509_crt_set_basic_constraints(*crt, 1, -1) >= 0);
+		assert(gnutls_x509_crt_set_key_usage(*crt, GNUTLS_KEY_KEY_CERT_SIGN) >= 0);
+	} else {
+		assert(gnutls_x509_crt_set_key_purpose_oid(*crt, GNUTLS_KP_TLS_WWW_SERVER, 0) >= 0);
+		if (empty_ku) {
+			ret = gnutls_x509_crt_set_extension_by_oid(*crt, "2.5.29.15",
+								   empty_bitstring,
+								   sizeof(empty_bitstring), 1);
+			if (ret < 0)
+				fail("set_extension_by_oid: %s\n", gnutls_strerror(ret));
+		} else {
+			assert(gnutls_x509_crt_set_key_usage(*crt, GNUTLS_KEY_DIGITAL_SIGNATURE) >= 0);
+		}
+	}
+
+	ret = gnutls_x509_crt_sign2(*crt, issuer ? issuer : *crt, issuer_key,
+				    GNUTLS_DIG_SHA256, 0);
+	if (ret < 0)
+		fail("crt_sign2: %s\n", gnutls_strerror(ret));
+}
+
+static unsigned verify(gnutls_x509_crt_t ca, gnutls_x509_crt_t ee, unsigned use_purpose)
+{
+	gnutls_x509_trust_list_t tl;
+	gnutls_typed_vdata_st vdata;
+	unsigned int status = 0;
+	int ret;
+
+	vdata.type = GNUTLS_DT_KEY_PURPOSE_OID;
+	vdata.data = (unsigned char *)GNUTLS_KP_TLS_WWW_SERVER;
+	vdata.size = strlen(GNUTLS_KP_TLS_WWW_SERVER);
+
+	assert(gnutls_x509_trust_list_init(&tl, 0) >= 0);
+	assert(gnutls_x509_trust_list_add_cas(tl, &ca, 1, 0) == 1);
+
+	ret = gnutls_x509_trust_list_verify_crt2(tl, &ee, 1,
+						 use_purpose ? &vdata : NULL,
+						 use_purpose ? 1 : 0, 0, &status, NULL);
+	if (ret < 0)
+		fail("verify_crt2: %s\n", gnutls_strerror(ret));
+
+	gnutls_x509_trust_list_deinit(tl, 0);
+	return status;
+}
+
+void doit(void)
+{
+	gnutls_x509_privkey_t ca_key, ee_key;
+	gnutls_x509_crt_t ca, ee_good, ee_empty;
+	unsigned int status;
+	unsigned p;
+
+	assert(gnutls_global_init() >= 0);
+	gnutls_global_set_log_function(tls_log_func);
+	if (debug)
+		gnutls_global_set_log_level(4711);
+
+	gen_key(&ca_key);
+	gen_key(&ee_key);
+
+	make_cert(&ca, ca_key, NULL, ca_key, 1, 0, "Test CA");
+	make_cert(&ee_good, ee_key, ca, ca_key, 0, 0, "good.example.com");
+	make_cert(&ee_empty, ee_key, ca, ca_key, 0, 1, "empty-ku.example.com");
+
+	for (p = 0; p <= 1; p++) {
+		/* normal certificate must remain trusted */
+		status = verify(ca, ee_good, p);
+		if (status != 0)
+			fail("valid certificate rejected (purpose=%u): status %x\n", p, status);
+
+		/* critical empty Key Usage + serverAuth EKU must be rejected */
+		status = verify(ca, ee_empty, p);
+		if (!(status & GNUTLS_CERT_INVALID))
+			fail("empty Key Usage certificate accepted (purpose=%u): status %x\n", p, status);
+		if (!(status & GNUTLS_CERT_PURPOSE_MISMATCH))
+			fail("empty Key Usage certificate: missing purpose mismatch (purpose=%u): status %x\n", p, status);
+	}
+
+	gnutls_x509_crt_deinit(ee_empty);
+	gnutls_x509_crt_deinit(ee_good);
+	gnutls_x509_crt_deinit(ca);
+	gnutls_x509_privkey_deinit(ee_key);
+	gnutls_x509_privkey_deinit(ca_key);
+	gnutls_global_deinit();
+
+	if (debug)
+		success("success");
+}
