+++ b/tests/name-constraints-unsupported.c
@@ -0,0 +1,77 @@
+/*
+ * Regression test for CVE-2026-95184: permitted subtrees of name types
+ * that GnuTLS cannot match (e.g. directoryName) must not be ignored.
+ *
+ * This file is part of GnuTLS.
+ *
+ * GnuTLS is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gnutls/gnutls.h>
+#include <gnutls/x509.h>
+
+#include "utils.h"
+
+static void set_name(const char *name, gnutls_datum_t *datum)
+{
+	datum->data = (unsigned char *)name;
+	datum->size = strlen(name);
+}
+
+void doit(void)
+{
+	gnutls_x509_name_constraints_t nc;
+	gnutls_datum_t name;
+	int ret;
+	unsigned res;
+
+	/* permitted directoryName: unsupported type, must fail closed */
+	ret = gnutls_x509_name_constraints_init(&nc);
+	if (ret < 0)
+		fail("init: %s\n", gnutls_strerror(ret));
+
+	set_name("permitted-dn", &name);
+	ret = gnutls_x509_name_constraints_add_permitted(nc, GNUTLS_SAN_DN,
+							 &name);
+	if (ret < 0)
+		fail("add_permitted: %s\n", gnutls_strerror(ret));
+
+	set_name("out-of-subtree-dn", &name);
+	res = gnutls_x509_name_constraints_check(nc, GNUTLS_SAN_DN, &name);
+	if (res != 0)
+		fail("name outside a permitted directoryName subtree was accepted\n");
+
+	/* a permitted constraint of another type must not affect DN checks */
+	gnutls_x509_name_constraints_deinit(nc);
+	ret = gnutls_x509_name_constraints_init(&nc);
+	if (ret < 0)
+		fail("init: %s\n", gnutls_strerror(ret));
+
+	set_name("example.com", &name);
+	ret = gnutls_x509_name_constraints_add_permitted(
+		nc, GNUTLS_SAN_DNSNAME, &name);
+	if (ret < 0)
+		fail("add_permitted: %s\n", gnutls_strerror(ret));
+
+	set_name("some-dn", &name);
+	res = gnutls_x509_name_constraints_check(nc, GNUTLS_SAN_DN, &name);
+	if (res == 0)
+		fail("DN rejected although only DNS constraints exist\n");
+
+	set_name("host.example.com", &name);
+	res = gnutls_x509_name_constraints_check(nc, GNUTLS_SAN_DNSNAME, &name);
+	if (res == 0)
+		fail("permitted DNS name was rejected\n");
+
+	gnutls_x509_name_constraints_deinit(nc);
+}
Description: x509/hostname-verify: SRV otherName must preclude CN fallback
 A certificate carrying an SRV otherName (OID 1.3.6.1.5.5.7.8.7) whose value
 is an OCTET STRING instead of an IA5String fails the virtual-SAN decoding in
 get_alt_name() and is reported as a generic GNUTLS_SAN_OTHERNAME. That type
 does not preclude the Common Name fallback in
 gnutls_x509_crt_check_hostname2(), so a hostname matching the CN is accepted
 despite the presence of an SRV-ID (RFC 6125, 6.4.4), bypassing the
 CVE-2026-42012 fix. Look up the otherName OID for generic otherName SANs and
 disable the CN fallback when it is the SRV OID (or cannot be determined).
 Adds a regression test, tests/hostname-check-srv-octet.c.

Origin: ai-synthesized, CVE-2026-88647
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-11

--- a/lib/x509/hostname-verify.c
+++ b/lib/x509/hostname-verify.c
@@ -235,6 +235,24 @@
 		if (PRECLUDES_CN_FALLBACK(ret))
 			cn_fallback_allowed = false;
 
+		if (ret == GNUTLS_SAN_OTHERNAME) {
+			/* An SRV-ID otherName whose value could not be decoded
+			 * as an IA5String (e.g., it holds an OCTET STRING) is
+			 * reported as a generic otherName; it must still
+			 * preclude the CN fallback (RFC 6125, 6.4.4). Be
+			 * conservative if the OID cannot be determined. */
+			char oid[MAX_OID_SIZE];
+			size_t oid_size = sizeof(oid);
+			int oid_ret;
+
+			oid_ret = gnutls_x509_crt_get_subject_alt_othername_oid(
+				cert, i, oid, &oid_size);
+			if (oid_ret < 0 || oid_ret == GNUTLS_SAN_OTHERNAME_SRV ||
+			    (oid_size == sizeof(SRV_OID) - 1 &&
+			     memcmp(oid, SRV_OID, oid_size) == 0))
+				cn_fallback_allowed = false;
+		}
+
 		if (ret == GNUTLS_SAN_DNSNAME) {
 			if (memchr(dnsname, '\0', dnsnamesize)) {
 				_gnutls_debug_log("certificate has %s with embedded null in name\n", dnsname);
