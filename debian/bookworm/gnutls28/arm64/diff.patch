+	"WC890rxP0P+Xjn3xfmM1mMwHlpPXR6Ab3zZqKqW21s9RpQqLDOFwm891DPHeTjWo\n"
+	"aRabe+de0bfqvBaXdpnQk4gIArGg6O6lSJ1YPbOZP6iAKcwyoobPq/sFxiirbfsu\n"
+	"tXPhKx7b3/K1ATVsX+RkuuSNGU5oUmSyBY5CbitUc5cpisYsBWX06rA+DqxiOElg\n"
+	"oXn4voXnr+rCOgMHSwTHIQtTI5Ap05N0SaE0iavwUM8CAwEAAaM9MDswDAYDVR0T\n"
+	"AQH/BAIwADAdBgNVHREEFjAUghJrbmNyaXQuZXhhbXBsZS5jb20wDAYDVR0PAQH/\n"
+	"BAIFADANBgkqhkiG9w0BAQsFAAOCAQEAtu7QAJiogBIVaTSenmyIY2l5pnUaLkWR\n"
+	"19CjAGqdmuWTCueYiUadoXOHm75AMEhxSHmgQojtewa6PmEb8fL18Qk2PJO6xVrL\n"
+	"Gf6K0viTRPyeiR/qrvSbLHq935RjYNvaHxNxyMcrvWq4aov6tZSOn37AWrweGqx7\n"
+	"hP16crOLdwMTvDmXOlaWD/9+ItWw1P3wOTwWRK2RbdvheISZZ/RgmB6MPF5A1keg\n"
+	"I6rvD95jreEjU0rXTMc6KaqKzICiPk4aE49rqbxNvowvKHQghQIYbOp4vYMxn3Gv\n"
+	"WWk+eZL8myRQATPwtru1RvJtnS2QHrRT0AMhX+ObuIX6VSsGppZ79g==\n"
+	"-----END CERTIFICATE-----\n";
+
+static gnutls_x509_crt_t load(const char *pem)
+{
+	gnutls_x509_crt_t crt;
+	gnutls_datum_t d;
+
+	d.data = (unsigned char *)pem;
+	d.size = strlen(pem);
+	if (gnutls_x509_crt_init(&crt) < 0)
+		fail("crt_init\n");
+	if (gnutls_x509_crt_import(crt, &d, GNUTLS_X509_FMT_PEM) < 0)
+		fail("crt_import\n");
+	return crt;
+}
+
+void doit(void)
+{
+	gnutls_x509_crt_t ca, leaf;
+	unsigned int status;
+	int ret;
+
+	global_init();
+
+	ca = load(ca_pem);
+	leaf = load(bad_leaf_pem);
+
+	/* the CA is a normal certificate and must still verify against itself */
+	ret = gnutls_x509_crt_verify(ca, &ca, 1,
+				     GNUTLS_VERIFY_DISABLE_TIME_CHECKS, &status);
+	if (ret < 0 || status != 0)
+		fail("normal CA rejected: ret=%d status=0x%x\n", ret, status);
+
+	/* the malformed critical extension must make verification fail */
+	ret = gnutls_x509_crt_verify(leaf, &ca, 1,
+				     GNUTLS_VERIFY_DISABLE_TIME_CHECKS, &status);
+	if (ret < 0)
+		fail("verify error: %d\n", ret);
+	if (!(status & GNUTLS_CERT_INVALID))
+		fail("certificate with unparseable critical keyUsage accepted\n");
+
+	gnutls_x509_crt_deinit(leaf);
+	gnutls_x509_crt_deinit(ca);
+	gnutls_global_deinit();
+}
Description: Fix CVE-2026-95184 - honour permitted subtrees of unsupported name types
 check_unsupported_constraint() only consulted the excluded subtrees. A CA
 carrying a permitted subtree for a name type that GnuTLS cannot match
 (notably directoryName) therefore had that constraint silently ignored
 during chain verification, so out-of-subtree certificates were accepted.
 Fail closed when a permitted constraint of the checked type exists. For
 directoryName the certificate subject DN is matched against the permitted
 subtrees (whole-RDN suffix match) so that certificates inside a permitted
 subtree keep verifying.
 A regression test is added.

Origin: ai-synthesized, CVE-2026-95184
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-10

--- a/lib/x509/name_constraints.c
+++ b/lib/x509/name_constraints.c
@@ -1315,6 +1315,22 @@
 
 	} while(ret == 0);
 
+	/* A permitted subtree of this type restricts the names the CA may
+	 * certify (RFC5280 4.2.1.10). As the name cannot be matched against
+	 * it here, fail closed instead of silently ignoring the constraint.
+	 */
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_permitted(nc, i++, &rtype, &rname);
+		if (ret >= 0) {
+			if (rtype != type)
+				continue;
+			else
+				return gnutls_assert_val(0);
+		}
+
+	} while(ret == 0);
+
 	return 1;
 }
 
@@ -1505,6 +1521,103 @@
 	return check_unsupported_constraint(nc, type);
 }
 
+/* Returns true if the textual DN @dn lies within the subtree rooted at
+ * @base, i.e. @base is a whole-RDN suffix of @dn (the textual form lists
+ * the most specific RDN first). The comparison is conservative: anything
+ * that cannot be positively matched is treated as outside the subtree.
+ */
+static unsigned dn_in_subtree(const gnutls_datum_t *dn,
+			      const gnutls_datum_t *base)
+{
+	size_t off, i, backslashes = 0;
+
+	if (base->size == 0)
+		return 1;	/* the empty DN covers every name */
+
+	if (dn->size < base->size)
+		return 0;
+
+	off = dn->size - base->size;
+	if (c_strncasecmp((const char *)dn->data + off,
+			  (const char *)base->data, base->size) != 0)
+		return 0;
+
+	if (off == 0)
+		return 1;
+
+	/* the match must start on an RDN boundary */
+	if (dn->data[off - 1] != ',')
+		return 0;
+
+	/* and that separator must not be an escaped comma */
+	for (i = off - 1; i > 0 && dn->data[i - 1] == '\\'; i--)
+		backslashes++;
+
+	return (backslashes % 2) == 0;
+}
+
+/* Checks the subject DN of @cert against the directoryName constraints.
+ * Excluded directoryName subtrees are still not evaluated and keep
+ * rejecting the certificate; permitted ones are matched against the
+ * subject DN so that names outside every permitted subtree are rejected.
+ *
+ * Returns: true if the certification is acceptable, and false otherwise.
+ */
+static unsigned check_dn_constraints(gnutls_x509_crt_t cert,
+				     gnutls_x509_name_constraints_t nc)
+{
+	unsigned i, permitted_found = 0, ok = 0;
+	int ret;
+	unsigned rtype;
+	gnutls_datum_t rname;
+	gnutls_datum_t dn = { NULL, 0 };
+
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_excluded(nc, i++, &rtype, &rname);
+		if (ret >= 0 && rtype == GNUTLS_SAN_DN)
+			return gnutls_assert_val(0);
+	} while(ret == 0);
+
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_permitted(nc, i++, &rtype, &rname);
+		if (ret >= 0 && rtype == GNUTLS_SAN_DN)
+			permitted_found = 1;
+	} while(ret == 0);
+
+	if (!permitted_found)
+		return 1;
+
+	ret = gnutls_x509_crt_get_dn3(cert, &dn, 0);
+	if (ret == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE)
+		return 1;	/* empty subject: no name of this type (RFC5280) */
+	if (ret < 0)
+		return gnutls_assert_val(0);
+
+	if (dn.size == 0) {
+		gnutls_free(dn.data);
+		return 1;
+	}
+
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_permitted(nc, i++, &rtype, &rname);
+		if (ret >= 0 && rtype == GNUTLS_SAN_DN &&
+		    dn_in_subtree(&dn, &rname)) {
+			ok = 1;
+			break;
+		}
+	} while(ret == 0);
+
+	gnutls_free(dn.data);
+
+	if (!ok)
+		return gnutls_assert_val(0);
+
+	return 1;
+}
+
 /* This function checks for unsupported constraints, that we also
  * know their structure. That is it will fail only if the constraint
  * is present in the CA, _and_ the name in the end certificate contains
@@ -1746,6 +1859,8 @@
 			}
 	} else if (type == GNUTLS_SAN_URI) {
 		return check_unsupported_constraint2(cert, nc, type);
+	} else if (type == GNUTLS_SAN_DN) {
+		return check_dn_constraints(cert, nc);
 	} else
 		return check_unsupported_constraint(nc, type);
 }
