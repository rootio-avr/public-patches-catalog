+/* critical keyUsage whose extnValue is 05 00 (NULL) */
+static const char bad_leaf_pem[] =
+	"-----BEGIN CERTIFICATE-----\n"
+	"MIIC9DCCAdygAwIBAgIULjc6t+WykhghQcoQgzsFV9lwaR8wDQYJKoZIhvcNAQEL\n"
+	"BQAwFzEVMBMGA1UEAwwMa25fY3JpdCBSb290MB4XDTI0MDEwMTAwMDAwMFoXDTM2\n"
+	"MDEwMTAwMDAwMFowEjEQMA4GA1UEAwwHa24tY3JpdDCCASIwDQYJKoZIhvcNAQEB\n"
