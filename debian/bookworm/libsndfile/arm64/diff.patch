Description: CVE-2024-50613 - Fix memory leak in mpeg_l3_encoder_init
 Move psf->codec_close assignment to ensure cleanup on early returns.
 The vulnerability involves a memory leak where the lame_t handle is not
 freed if an early return occurs after lame_init() succeeds but before
 the codec_close callback is registered.
Origin: upstream, commit:d9a35ea0d5c64c19dd635ae578e0028df8f66d6a
Author: Sisyphus-wang <43361974+Sisyphus-wang@users.noreply.github.com>
Last-Update: 2026-01-01
---
--- a/src/mpeg_l3_encode.c
+++ b/src/mpeg_l3_encode.c
@@ -87,7 +87,8 @@ mpeg_l3_encoder_init (SF_PRIVATE *psf, int info_tag)
 	if (! (pmpeg->lamef = lame_init ()))
 		return SFE_MALLOC_FAILED ;

-	pmpeg->compression = -1.0 ; /* Unset */
+	psf->codec_close	= mpeg_l3_encoder_close ; /* Set psf->codec_close early*/
+	pmpeg->compression = -1.0 ; /* Unset */

 	lame_set_in_samplerate (pmpeg->lamef, psf->sf.samplerate) ;
 	lame_set_num_channels (pmpeg->lamef, psf->sf.channels) ;
@@ -115,7 +116,6 @@ mpeg_l3_encoder_init (SF_PRIVATE *psf, int info_tag)
 		}

 	psf->sf.seekable	= 0 ;
-	psf->codec_close	= mpeg_l3_encoder_close ;
 	psf->byterate		= mpeg_l3_encoder_byterate ;
 	psf->datalength		= 0 ;
