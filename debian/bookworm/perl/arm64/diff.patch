@@ -0,0 +1,92 @@
+#!/usr/bin/perl -w
+#
+# Test Pod::Text and its subclasses with a pathological margin.
+#
+# If the margin (the sum of the indentations requested by =over and the
+# baseline text indentation) equals or exceeds the output width, the wrapping
+# regular expression could match zero characters and loop forever.  Formatting
+# the document below therefore used to hang.  After the fix, the formatters
+# instead report an error and force the margin to zero.  See CVE-2026-82560.
+#
+# Copyright 2026 Russ Allbery <rra@cpan.org>
+#
+# This program is free software; you may redistribute it and/or modify it
+# under the same terms as Perl itself.
+#
+# SPDX-License-Identifier: GPL-1.0-or-later OR Artistic-1.0-Perl
+
+use 5.008;
+use strict;
+use warnings;
+
+use Test::More tests => 24;
+
+BEGIN {
+    use_ok('Pod::Text');
+    use_ok('Pod::Text::Color');
+    use_ok('Pod::Text::Overstrike');
+    use_ok('Pod::Text::Termcap');
+}
+
+# A document whose =over indent, plus the default text indent of 4, exceeds
+# the (deliberately small) output width configured below.  This drives the
+# internal margin past the width so that the available wrapping width becomes
+# zero or negative, which used to make the wrapping regex loop forever.
+my $document = <<'END_POD';
+=over 30
+
+This paragraph cannot be wrapped because the total margin exceeds the maximum
+width.
+
+=back
+END_POD
+
+# Force a small output width for every formatter so the pathological margin is
+# reached regardless of the terminal width Pod::Text::Termcap would otherwise
+# derive from COLUMNS or Term::Cap.
+my $width = 20;
+
+# Ensure any warnings cause a test failure so a regression back to an infinite
+# loop or an uncaught warning is caught.
+## no critic (ErrorHandling::RequireCarping)
+local $SIG{__WARN__} = sub { die $_[0] };
+
+# Format $document with $class and confirm it terminates, produces output, and
+# reports the pathological-margin error in its POD ERRORS section.
+#
+# $class - Formatter class to exercise
+sub check_class {
+    my ($class) = @_;
+
+    my $parser = $class->new(name => 'TEST', width => $width);
+    isa_ok($parser, $class, "$class parser");
+
+    my $output = q{};
+    $parser->output_string(\$output);
+
+    my $result = eval { $parser->parse_string_document($document) };
+    ok($result, "$class formatted without hanging");
+    is($@, q{}, "$class produced no exception");
+
+    # The error text may itself be wrapped across several lines, so allow
+    # arbitrary whitespace (including newlines) between the words.
+    like(
+        $output,
+        qr{Margin \s+ is \s+ wider \s+ than \s+ the \s+ output \s+ width}xms,
+        "$class reported the pathological margin",
+    );
+
+    # The body text must still appear once the margin is forced to zero.
+    like(
+        $output,
+        qr{This \s+ paragraph \s+ cannot \s+ be \s+ wrapped}xms,
+        "$class still emitted the body text",
+    );
+
+    return;
+}
+
+check_class('Pod::Text');
+check_class('Pod::Text::Color');
+check_class('Pod::Text::Overstrike');
+check_class('Pod::Text::Termcap');
