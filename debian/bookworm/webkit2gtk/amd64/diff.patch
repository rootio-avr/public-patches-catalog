 template<typename Visitor>
Description: Fix CVE-2026-28953 — WebAssembly IPInt stack-check undercount
 IPIntGenerator::finalize() computed m_maxFrameSizeInV128 by dividing both
 roundUpToMultipleOf<2>(m_numLocals) and m_numAlignedRethrowSlots by 2. That
 division would only be correct if IPInt locals and rethrow slots were 64 bits
 wide, but every IPInt slot is 128 bits wide (LocalSize in
 InPlaceInterpreter.asm), so those counts are already expressed in units of
 V128. Dividing by 2 undercounts the interpreter frame size, so a WebAssembly
 module with a large number of locals (or rethrow slots) runs against an
 undersized, stack-checked frame — an out-of-bounds stack access
 (CWE-119 memory corruption) that leads to a process crash.
 .
 Remove the erroneous "/ 2" from the two m_maxFrameSizeInV128 assignments so
 the frame size is computed correctly in units of V128. This mirrors the
 upstream WebKit fix for bug 309628 ("WebAssembly IPInt Stack Check
 Undercount", commit b5a9b035e465), addressed in WebKitGTK/WPE WebKit 2.52.4.
Origin: backport, https://github.com/WebKit/WebKit/commit/b5a9b035e465
Bug: https://bugs.webkit.org/show_bug.cgi?id=309628
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-08-31

--- a/Source/JavaScriptCore/wasm/WasmIPIntGenerator.cpp
+++ b/Source/JavaScriptCore/wasm/WasmIPIntGenerator.cpp
@@ -3003,8 +3003,8 @@ std::unique_ptr<FunctionIPIntMetadataGenerator> IPIntGenerator::finalize()
     if (m_metadata->m_numLocals % 2)
         m_metadata->m_argumINTBytecode.append(0);

-    m_metadata->m_maxFrameSizeInV128 = roundUpToMultipleOf<2>(m_metadata->m_numLocals) / 2;
-    m_metadata->m_maxFrameSizeInV128 += m_metadata->m_numAlignedRethrowSlots / 2;
+    m_metadata->m_maxFrameSizeInV128 = roundUpToMultipleOf<2>(m_metadata->m_numLocals);
+    m_metadata->m_maxFrameSizeInV128 += m_metadata->m_numAlignedRethrowSlots;
     m_metadata->m_maxFrameSizeInV128 += m_maxStackSize;

     return WTFMove(m_metadata);
--- /dev/null
+++ b/JSTests/wasm/regress/309628.js
@@ -0,0 +1,64 @@
+// Regression test for CVE-2026-28953 (WebKit bug 309628):
+// WebAssembly IPInt Stack Check Undercount.
+//
+// IPIntGenerator::finalize() (Source/JavaScriptCore/wasm/WasmIPIntGenerator.cpp)
+// computed m_maxFrameSizeInV128 by dividing the local/rethrow slot counts by 2.
+// IPInt slots are 128 bits wide, so those counts are already in units of V128;
+// the division undersized the interpreter frame and a function with many locals
+// executed against a too-small, stack-checked frame -> out-of-bounds stack
+// access -> process crash. The fix removes the "/ 2".
+//
+// This test builds wasm functions with a large, varying number of i64 locals,
+// instantiates and runs them, and asserts that execution either completes or
+// throws a catchable RangeError (stack exhaustion) rather than crashing the
+// process. Before the fix, one of these frame sizes triggers memory corruption.
+"use strict";
+
+function leb(n) {
+    const out = [];
+    do {
+        let b = n & 0x7f;
+        n >>>= 7;
+        if (n) b |= 0x80;
+        out.push(b);
+    } while (n);
+    return out;
+}
+
+// (module (func (export "f") (local $0 i64) ;; numLocals times
+//               (drop (local.get 0))))
+function makeModule(numLocals) {
+    const body = [
+        0x01, ...leb(numLocals), 0x7e, // 1 local decl group: numLocals x i64
+        0x20, 0x00,                    // local.get 0
+        0x1a,                          // drop
+        0x0b,                          // end
+    ];
+    const code = [0x01, ...leb(body.length), ...body];
+    return new Uint8Array([
+        0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, // magic + version
+        0x01, 0x04, 0x01, 0x60, 0x00, 0x00,             // type: () -> ()
+        0x03, 0x02, 0x01, 0x00,                         // func section
+        0x07, 0x05, 0x01, 0x01, 0x66, 0x00, 0x00,       // export "f"
+        0x0a, ...leb(code.length), ...code,             // code section
+    ]);
+}
+
+// Sweep a range of local counts; each must instantiate and run without
+// corrupting the process. A RangeError (recursion/stack limit) is acceptable.
+for (let L = 35000; L >= 8000; L -= 2000) {
+    const bytes = makeModule(L);
+    const inst = new WebAssembly.Instance(new WebAssembly.Module(bytes));
+    try {
+        inst.exports.f();
+    } catch (e) {
+        if (!(e instanceof RangeError))
+            throw new Error("unexpected exception for L=" + L + ": " + e);
+    }
+}
+
+// Normal, small function still works.
+{
+    const inst = new WebAssembly.Instance(new WebAssembly.Module(makeModule(1)));
+    inst.exports.f();
+}
