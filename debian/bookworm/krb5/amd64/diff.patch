Description: CVE-2026-119079 - Avoid repeated reallocation when decoding ASN.1
 decode_sequence_of() grew the output array with realloc() once per decoded
 element, which allows a crafted ASN.1 SEQUENCE OF with many elements to cause
 quadratic reallocation work (denial of service).  Count the elements and
 check their tags first, allocate the array once with k5calloc(), then decode
 into it.
Origin: upstream, https://github.com/krb5/krb5/commit/782e5ac4fb1496a79de0b87e1fc485f897e97d6d
Author: Greg Hudson <ghudson@mit.edu>
Last-Update: 2026-11-11
---
--- a/src/lib/krb5/asn.1/asn1_encode.c
+++ b/src/lib/krb5/asn.1/asn1_encode.c
@@ -1460,40 +1460,42 @@
                    size_t *count_out)
 {
     krb5_error_code ret;
-    void *seq = NULL, *elem, *newseq;
-    const uint8_t *contents;
-    size_t clen, count = 0;
+    void *seq = NULL, *elem;
+    const uint8_t *p, *contents;
+    size_t l, clen, count = 0, n = 0;
     taginfo t;
 
     *seq_out = NULL;
     *count_out = 0;
-    while (len > 0) {
+
+    /* Count the elements in the sequence and check their tags. */
+    for (p = asn1, l = len, count = 0; l > 0; count++) {
+        ret = get_tag(p, l, &t, &contents, &clen, &p, &l);
+        if (ret)
+            return ret;
+        if (!check_atype_tag(elemtype, &t))
+            return ASN1_BAD_ID;
+    }
+
+    seq = k5calloc(count, elemtype->size, &ret);
+    if (seq == NULL)
+        return ret;
+
+    for (n = 0; n < count; n++) {
         ret = get_tag(asn1, len, &t, &contents, &clen, &asn1, &len);
         if (ret)
             goto error;
-        if (!check_atype_tag(elemtype, &t)) {
-            ret = ASN1_BAD_ID;
-            goto error;
-        }
-        newseq = realloc(seq, (count + 1) * elemtype->size);
-        if (newseq == NULL) {
-            ret = ENOMEM;
-            goto error;
-        }
-        seq = newseq;
-        elem = (char *)seq + count * elemtype->size;
-        memset(elem, 0, elemtype->size);
+        elem = (char *)seq + n * elemtype->size;
         ret = decode_atype(&t, contents, clen, elemtype, elem);
         if (ret)
             goto error;
-        count++;
     }
     *seq_out = seq;
     *count_out = count;
     return 0;
 
 error:
-    free_sequence_of(elemtype, seq, count);
+    free_sequence_of(elemtype, seq, n);
     free(seq);
     return ret;
 }
