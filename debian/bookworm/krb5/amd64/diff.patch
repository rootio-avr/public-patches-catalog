Description: CVE-2026-112318 - Prevent null dereferences in kadmind server stubs
 In server_stubs.c, the policy RPC stubs (create_policy, delete_policy,
 modify_policy, get_policy) did not reject a NULL policy name decoded by
 xdr_nullstring(), allowing an authenticated remote user to crash kadmind
 via a NULL pointer dereference in authorization checks or logging code.
 Return EINVAL when the policy name used as prime_arg is NULL.
 .
 Backported from upstream to krb5 1.20.1 (bookworm); offset-only changes.
Origin: upstream, https://github.com/krb5/krb5/commit/407e75e927c1870161305d3288cc0205e9ff067b
Author: Greg Hudson <ghudson@mit.edu>
Last-Update: 2026-11-17
---
--- a/src/kadmin/server/server_stubs.c
+++ b/src/kadmin/server/server_stubs.c
@@ -1195,6 +1195,10 @@
         goto exit_func;
 
     prime_arg = arg->rec.policy;
+    if (prime_arg == NULL) {
+        ret->code = EINVAL;
+        goto exit_func;
+    }
 
     if (CHANGEPW_SERVICE(rqstp) ||
         !stub_auth_pol(handle, OP_ADDPOL, arg->rec.policy,
@@ -1208,8 +1212,7 @@
         if (ret->code != 0)
             errmsg = krb5_get_error_message(handle->context, ret->code);
 
-        log_done("kadm5_create_policy",
-                 ((prime_arg == NULL) ? "(null)" : prime_arg), errmsg,
+        log_done("kadm5_create_policy", prime_arg, errmsg,
                  &client_name, &service_name, rqstp);
 
         if (errmsg != NULL)
@@ -1237,6 +1240,10 @@
         goto exit_func;
 
     prime_arg = arg->name;
+    if (prime_arg == NULL) {
+        ret->code = EINVAL;
+        goto exit_func;
+    }
 
     if (CHANGEPW_SERVICE(rqstp) ||
         !stub_auth(handle, OP_DELPOL, NULL, NULL, arg->name, NULL)) {
@@ -1248,8 +1255,7 @@
         if (ret->code != 0)
             errmsg = krb5_get_error_message(handle->context, ret->code);
 
-        log_done("kadm5_delete_policy",
-                 ((prime_arg == NULL) ? "(null)" : prime_arg), errmsg,
+        log_done("kadm5_delete_policy", prime_arg, errmsg,
                  &client_name, &service_name, rqstp);
 
         if (errmsg != NULL)
@@ -1277,6 +1283,10 @@
         goto exit_func;
 
     prime_arg = arg->rec.policy;
+    if (prime_arg == NULL) {
+        ret->code = EINVAL;
+        goto exit_func;
+    }
 
     if (CHANGEPW_SERVICE(rqstp) ||
         !stub_auth_pol(handle, OP_MODPOL, arg->rec.policy,
@@ -1289,8 +1299,7 @@
         if (ret->code != 0)
             errmsg = krb5_get_error_message(handle->context, ret->code);
 
-        log_done("kadm5_modify_policy",
-                 ((prime_arg == NULL) ? "(null)" : prime_arg), errmsg,
+        log_done("kadm5_modify_policy", prime_arg, errmsg,
                  &client_name, &service_name, rqstp);
 
         if (errmsg != NULL)
@@ -1324,6 +1333,10 @@
     funcname = "kadm5_get_policy";
 
     prime_arg = arg->name;
+    if (prime_arg == NULL) {
+        ret->code = EINVAL;
+        goto exit_func;
+    }
 
     /* Look up the client principal's policy value. */
     ret2 = kadm5_get_principal(handle->lhandle, handle->current_caller,
@@ -1342,9 +1355,8 @@
         if (ret->code != 0)
             errmsg = krb5_get_error_message(handle->context, ret->code);
 
-        log_done(funcname,
-                 ((prime_arg == NULL) ? "(null)" : prime_arg), errmsg,
-                 &client_name, &service_name, rqstp);
+        log_done(funcname, prime_arg, errmsg, &client_name, &service_name,
+                 rqstp);
         if (errmsg != NULL)
             krb5_free_error_message(handle->context, errmsg);
     }
Description: CVE-2026-107778 - Avoid null dereference in krb5_rd_cred()
 A malformed KRB-CRED message may have fewer entries in the encrypted
 ticket-info list than it has in the tickets list.  In each loop
 iteration of make_cred_list(), check if we unexpectedly reached the end
 of the ticket-info list to avoid a null dereference.
Origin: upstream, https://github.com/krb5/krb5/commit/48afa9abb89ab2176bb20624d87d010b9984fc08
Author: TristanInSec <tristan.mtn@gmail.com>
Last-Update: 2026-10-10
---
--- a/src/lib/krb5/krb/rd_cred.c
+++ b/src/lib/krb5/krb/rd_cred.c
@@ -98,6 +98,11 @@ make_cred_list(krb5_context context, krb5_cred *krbcred,
             goto cleanup;
 
         info = encpart->ticket_info[i];
+        if (info == NULL) {
+            /* We unexpectedly reached the end of the encrypted ticket info. */
+            ret = KRB5KRB_AP_ERR_MODIFIED;
+            goto cleanup;
+        }
         ret = krb5_copy_principal(context, info->client, &list[i]->client);
         if (ret)
             goto cleanup;
Description: CVE-2026-112323 - Disable GSSRPC AUTH_GSSAPI flavor by default
 The AUTH_GSSAPI authentication flavor has been superseded by RPCSEC_GSS
 since release 1.4 and lacks protections against unauthenticated resource
 exhaustion; repeated failed AUTH_GSSAPI_INIT requests allow remote
 attackers to exhaust memory in kadmind.  Reject AUTH_GSSAPI requests with
 AUTH_REJECTEDCRED unless the GSSRPC_ALLOW_AUTH_GSSAPI environment variable
 is set.  Also adjusts the t_rpc.py unit test to set the variable.
 Also addresses CVE-2026-112322.
Origin: upstream, https://github.com/krb5/krb5/commit/8aab893c6eb17125e1518f9926bc3593cf19303c
