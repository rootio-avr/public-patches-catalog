+import socket
+from k5test import *
+
+realm = K5Realm()
+
+# CVE-2026-107364 KDC out-of-bounds read with a specific ASN.1
+# encoding
+
+s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+a = (hostname, realm.portbase)
+
+# This AS-REQ packet fools the affected version of the KDC's
+# fetch_asn_field() into performing an indefinite length calculation,
+# reading far beyond the bounds of the packet.
+m = ('6A8185'                   # [APPLICATION 10]
+     '3F8010' '8180'            # SEQUENCE (with multi-byte tag identifier)
+     'A103' '0201' '05'         #  [1] pvno = 5
+     'A203' '0201' '0A'         #  [2] msg-type = 10
+     'A474' '3072'              #  [4] req_body = SEQUENCE
+     'A007' '0305' '0000000010' #   [0] kdc-options = 0
+     'A111' '300F'              #   [1] cname = SEQUENCE
+     'A003' '0201' '01'         #    [0] name-type = NT-PRINCIPAL
+     'A108' '3006'              #    [1] name-string = SEQUENCE-OF
+     '1B04' '75736572'          #     user
+     'A20D' '1B0B' '4B5242544553542E434F4D'
+                                #    [2] realm = KRBTEST.COM
+     'A320' '301E'              #    [3] sname = SEQUENCE
+     'A003' '0201' '02'         #     [0] name-type = NT-SRV-INST
+     'A117' '3015'              #      [1] name-string = SEQUENCE-OF
+     '1B06' '6B7262746774'      #       krbtgt
+     '1B0B' '4B5242544553542E434F4D'
+                                #       KRBTEST.COM
+     'A511' '180F' '32303337303130313030303030305A'
+                                #   [5] till = 20370101000000Z
+     'A706' '0204' '00BC614E'   #   [7] nonce = 12345678
+     'A808' '3006'              #   [8] etype = SEQUENCE OF
+     '020112' '020111'          #    aes256-cts aes128-cts
+     '0183FFFFFF')              # DER value of length 2^24-1
+
+s.sendto(bytes.fromhex(m), a)
+
+# Make sure kinit still works.
+realm.kinit(realm.user_princ, password('user'))
