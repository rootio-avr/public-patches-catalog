Description: CVE-2026-95619 - detect size_t overflow in aligned operator new
 Backport of upstream 59d235ffa5a69231eb42e5290d52dc8c90d28b7a onto
 gcc 12.2.0. Bookworm still prefers C11 aligned_alloc over posix_memalign,
 so the overflow check is placed on that path and the unchecked rounding
 in operator new is removed. The later posix_memalign preference
 (b255ab9) is not included. [[unlikely]] is written as __builtin_expect
 so libsupc++ keeps building without C++20 attributes.
 Includes the upstream regression test.
Origin: upstream, https://github.com/gcc-mirror/gcc/commit/59d235ffa5a69231eb42e5290d52dc8c90d28b7a
Bug-Debian: https://security-tracker.debian.org/tracker/CVE-2026-95619
Author: Jonathan Wakely <jwakely@redhat.com>
Last-Update: 2026-10-09

--- a/debian/patches/CVE-2026-95619.diff
+++ b/debian/patches/CVE-2026-95619.diff
@@ -0,0 +1,113 @@
+--- a/src/libstdc++-v3/libsupc++/new_opa.cc
++++ b/src/libstdc++-v3/libsupc++/new_opa.cc
+@@ -64,11 +64,36 @@
+ 
+ namespace __gnu_cxx {
+ #if _GLIBCXX_HAVE_ALIGNED_ALLOC
+-using ::aligned_alloc;
++// We have C11 aligned_alloc but we need to satisfy its preconditions.
++static inline void*
++aligned_alloc (std::size_t al, std::size_t sz)
++{
++# if defined _AIX || defined __APPLE__
++  /* AIX 7.2.0.0 aligned_alloc incorrectly has posix_memalign's requirement
++   * that alignment is a multiple of sizeof(void*).
++   * OS X 10.15 has the same requirement.  */
++  if (al < sizeof(void*))
++    al = sizeof(void*);
++# endif
++  /* C11: the value of size shall be an integral multiple of alignment.  */
++  if (__builtin_expect (__builtin_add_overflow (sz, al - 1, &sz), false))
++    return nullptr;
++  sz &= ~(al - 1);
++  return ::aligned_alloc (al, sz);
++}
+ #elif _GLIBCXX_HAVE__ALIGNED_MALLOC
++// Use Windows _aligned_malloc
+ static inline void*
+ aligned_alloc (std::size_t al, std::size_t sz)
+-{ return _aligned_malloc(sz, al); }
++{
++  // The Wine msvcrt.dll version of _aligned_malloc doesn't detect overflow
++  // so do it ourselves. We know al + 2 * sizeof(void*) won't overflow because
++  // has_single_bit(al) was already checked by the caller.
++  std::size_t check;
++  if (__builtin_expect (__builtin_add_overflow (sz, al + 2 * sizeof(void*), &check), false))
++    return nullptr;
++  return _aligned_malloc (sz, al);
++}
+ #elif _GLIBCXX_HAVE_POSIX_MEMALIGN
+ static inline void*
+ aligned_alloc (std::size_t al, std::size_t sz)
+@@ -100,7 +125,9 @@
+   // We need extra bytes to store the original value returned by malloc.
+   if (al < sizeof(void*))
+     al = sizeof(void*);
+-  void* const malloc_ptr = malloc(sz + al);
++  if (__builtin_expect (__builtin_add_overflow (sz, al, &sz), false))
++    return nullptr;
++  void* const malloc_ptr = malloc(sz);
+   if (!malloc_ptr)
+     return nullptr;
+   // Align to the requested value, leaving room for the original malloc value.
+@@ -128,18 +155,6 @@
+   if (__builtin_expect (sz == 0, false))
+     sz = 1;
+ 
+-#if _GLIBCXX_HAVE_ALIGNED_ALLOC
+-# if defined _AIX || defined __APPLE__
+-  /* AIX 7.2.0.0 aligned_alloc incorrectly has posix_memalign's requirement
+-   * that alignment is a multiple of sizeof(void*).
+-   * OS X 10.15 has the same requirement.  */
+-  if (align < sizeof(void*))
+-    align = sizeof(void*);
+-# endif
+-  /* C11: the value of size shall be an integral multiple of alignment.  */
+-  sz = (sz + align - 1) & ~(align - 1);
+-#endif
+-
+   void *p;
+ 
+   while ((p = __gnu_cxx::aligned_alloc (align, sz)) == nullptr)
+--- a/src/libstdc++-v3/testsuite/18_support/new_aligned_wrap.cc
++++ b/src/libstdc++-v3/testsuite/18_support/new_aligned_wrap.cc
+@@ -0,0 +1,39 @@
++// { dg-do run }
++
++#include <new>
++#include <stdint.h>
++#include <testsuite_hooks.h>
++
++#pragma GCC diagnostic ignored "-Walloc-size-larger-than="
++
++void
++check_aligned_new_overflow(std::size_t size, std::size_t align)
++{
++#if __cpp_aligned_new
++  std::align_val_t alignv = (std::align_val_t)align;
++  try
++    {
++      (void) ::operator new(size, alignv);
++      VERIFY(false);
++    }
++  catch (const std::bad_alloc&)
++    {
++    }
++
++  void* p = ::operator new(size, alignv, std::nothrow);
++  VERIFY(p == 0);
++#endif
++}
++
++int main()
++{
++  check_aligned_new_overflow(-9, 32);
++  check_aligned_new_overflow(SIZE_MAX, 8);
++  check_aligned_new_overflow(SIZE_MAX, 32);
++  check_aligned_new_overflow(SIZE_MAX, 1024);
++  check_aligned_new_overflow(SIZE_MAX, 65536);
++  check_aligned_new_overflow(SIZE_MAX -     1,    16);
++  check_aligned_new_overflow(SIZE_MAX -  1025,  1024);
++  check_aligned_new_overflow(SIZE_MAX -  1024,  1024);
++  check_aligned_new_overflow(SIZE_MAX - 65536, 65536);
++}
--- a/debian/rules.patch
+++ b/debian/rules.patch
@@ -246,6 +246,7 @@
 debian_patches += go-testsuite
 
 debian_patches += CVE-2023-4039
+debian_patches += CVE-2026-95619
 
 # don't remove, this is regularly overwritten, see PR sanitizer/63958.
 #debian_patches += libasan-sparc
Description: CVE-2026-102010 - Fix use-after-free in pbds binary heap
 After reallocating the storage in binary_heap erase_if, the m_a_entries
 pointer is left dangling (pointing at the deallocated old storage) and the
 newly allocated storage is leaked. Update m_a_entries after reallocation.
 Includes a regression test.
Origin: upstream, https://github.com/gcc-mirror/gcc/commit/aaa8351f4d2e636f9680a1f0a8ebc2f0a60611e6
Bug: https://gcc.gnu.org/bugzilla/show_bug.cgi?id=127656
Author: Jonathan Wakely <jwakely@redhat.com>
Last-Update: 2026-10-01

--- a/debian/patches/CVE-2026-102010.diff
+++ b/debian/patches/CVE-2026-102010.diff
@@ -0,0 +1,32 @@
+--- a/src/libstdc++-v3/include/ext/pb_ds/detail/binary_heap_/erase_fn_imps.hpp
++++ b/src/libstdc++-v3/include/ext/pb_ds/detail/binary_heap_/erase_fn_imps.hpp
+@@ -121,6 +121,7 @@ erase_if(Pred pred)
+       entry_pointer new_entries = s_entry_allocator.allocate(new_size);
+       std::copy(m_a_entries, m_a_entries + left, new_entries);
+       s_entry_allocator.deallocate(m_a_entries, m_actual_size);
++      m_a_entries = new_entries;
+       m_actual_size = new_size;
+       resize_policy::notify_arbitrary(m_actual_size);
+     }
+--- /dev/null
++++ b/src/libstdc++-v3/testsuite/ext/pb_ds/regression/priority_queues_erase_if.cc
+@@ -0,0 +1,19 @@
++// { dg-do run }
++
++// CVE-2026-201020 use-after-free in binary heap erase_if
++
++#include <ext/pb_ds/priority_queue.hpp>
++
++bool is_odd(int v) { return v & 1; }
++
++int main()
++{
++  using __gnu_pbds::priority_queue;
++  using __gnu_pbds::binary_heap_tag;
++  priority_queue<int, std::less<int>, binary_heap_tag> q;
++  q.push(1);
++  q.push(2);
++  q.push(3);
++  q.erase_if(&is_odd);
++  q.clear();
++}
--- a/debian/rules.patch
+++ b/debian/rules.patch
@@ -108,6 +108,8 @@
   debian_patches += pr39491
 endif
 
+debian_patches += CVE-2026-102010
+
 # Patches for non-core languages.
 
 debian_patches += gm2 gm2-info-no-headers
