Description: CVE-2024-29161 - Fix heap buffer overflow in H5A__attr_release_table
 HDF5 through 1.14.3 contains a heap buffer overflow in
 H5A__attr_release_table, resulting in the corruption of the
 instruction pointer and causing denial of service or potential
 code execution. This patch moves the H5FL_SEQ_FREE call inside
 the if(nattrs > 0) block to prevent freeing a NULL pointer when
 no attributes exist.
Origin: upstream, commit:136739b37a9e1ecefe83883f0f422d283ae497e5
Author: The HDF Group
Last-Update: 2026-01-28

--- a/src/H5Aint.c
+++ b/src/H5Aint.c
@@ -1895,13 +1895,14 @@ H5A__attr_release_table(H5A_attr_table_t *atable)
         /* Free attribute message information */
         for(u = 0; u < atable->nattrs; u++)
             if(atable->attrs[u] && H5A__close(atable->attrs[u]) < 0)
                 HGOTO_ERROR(H5E_ATTR, H5E_CANTFREE, FAIL, "unable to release attribute")
+
+        /* Release array */
+        atable->attrs = (H5A_t **)H5FL_SEQ_FREE(H5A_t_ptr, atable->attrs);
     } /* end if */
     else
         HDassert(atable->attrs == NULL);
 
-    atable->attrs = (H5A_t **)H5FL_SEQ_FREE(H5A_t_ptr, atable->attrs);
-
 done:
     FUNC_LEAVE_NOAPI(ret_value)
 } /* end H5A__attr_release_table() */
From 15233a43b381ece6131e0fa0288f730e97c0df99 Mon Sep 17 00:00:00 2001
From: Jordan Henderson <jhenderson@hdfgroup.org>
