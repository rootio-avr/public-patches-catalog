     size_t    tmp_buf_size = 0;    /*size of temporary bkg buffer         */
     hbool_t     nested = FALSE;         /*flag of nested VL case             */
-    size_t    elmtno;            /*element number counter         */
+    size_t    elmtno = 0;        /*element number counter         */
+    size_t    orig_d_stride = 0;    /*original destination stride (error handling) */
+    size_t    orig_nelmts = nelmts;    /*original element count (error handling) */
+    hbool_t    conversions_made = FALSE; /*flag for conversion tracking (error handling) */
