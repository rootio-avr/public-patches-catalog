     FUNC_ENTER_PACKAGE
@@ -3137,6 +3140,9 @@ H5T__conv_vlen(hid_t src_id, hid_t dst_id, H5T_cdata_t *cdata, size_t nelmts,
             if(write_to_file && parent_is_vlen && bkg != NULL)
                 nested = TRUE;
 
+            /* Save original destination stride for error cleanup */
+            orig_d_stride = (size_t)d_stride;
+
             /* The outer loop of the type conversion macro, controlling which */
             /* direction the buffer is walked */
             while(nelmts > 0) {
@@ -3292,6 +3298,9 @@ H5T__conv_vlen(hid_t src_id, hid_t dst_id, H5T_cdata_t *cdata, size_t nelmts,
                         } /* end if */
                     } /* end else */
 
+                    /* Mark that conversions have been performed */
+                    conversions_made = TRUE;
+
                     /* Advance pointers */
                     s += s_stride;
                     d += d_stride;
@@ -3315,6 +3324,35 @@ H5T__conv_vlen(hid_t src_id, hid_t dst_id, H5T_cdata_t *cdata, size_t nelmts,
     }   /* end switch */
 
 done:
+    /* Release converted elements on error to prevent heap corruption */
+    if(ret_value < 0 && conversions_made) {
+        size_t dest_count;
+        hbool_t convert_forward = !(orig_d_stride > 0 && (ssize_t)orig_d_stride > s_stride);
+
+        /* Clean up elements that were successfully converted before error */
+        if(nelmts < orig_nelmts || (convert_forward && elmtno > 0)) {
+            dest_count = orig_nelmts - nelmts;
+
+            /* Set pointer to correct location based on direction */
+            if(convert_forward) {
+                d = (uint8_t *)buf;
+                if(elmtno > 0)
+                    dest_count += elmtno; /* Include partial iteration */
+            }
+            else
+                d = (uint8_t *)buf + (nelmts * orig_d_stride);
+
+            /* Reclaim vlen elements that have already been converted */
+            while(dest_count > 0) {
+                /* Use H5T_vlen_reclaim_elmt to properly free the vlen data */
+                H5T_vlen_reclaim_elmt(d, dst); /* Ignore errors at this point */
+                d += orig_d_stride;
+                dest_count--;
+            }
+        }
+    }
+
+    /* Release temporary resources */
     /* If the conversion buffer doesn't need to be freed, reset its pointer */
     if(write_to_file && noop_conv)
         conv_buf = NULL;
