Description: CVE-2026-13757 - cap RPC attribute-array parsing recursion depth
 p11_rpc_buffer_get_attribute() and p11_rpc_buffer_get_attribute_array_value()
 form a mutually-recursive call chain when decoding CKA_WRAP_TEMPLATE,
 CKA_UNWRAP_TEMPLATE, and CKA_DERIVE_TEMPLATE attributes. A local, unauth-
 enticated attacker with access to the p11-kit RPC Unix domain socket can
 send a crafted request whose attribute array is nested arbitrarily deep,
 exhausting the server's stack and crashing it (denial of service).
 .
 This patch backports the fix concept from upstream commit
 4b5eb61213e8dbe3232e7cb4668834126405e9a2 (PR #768) to p11-kit 0.23.22, whose
 decoder architecture pre-dates the msg-aware decoder wrappers used upstream.
 Rather than threading a depth parameter through the p11_rpc_value_decoder
 signature (which would break the ABI of six buffer-level decoders), the
 backport uses a static file-scope recursion counter guarded around
 p11_rpc_buffer_get_attribute_array_value in rpc-message.c. When the counter
 reaches MAX_RECURSION_DEPTH (8), further recursion returns false and the
 request is rejected. The upstream rpc-server.c hunks are omitted because
 target's rpc-server.c has no proto_read_attribute_buffer_array recursion
 path (attribute-array reads on the server side are non-recursive at the
 rpc-server layer in 0.23.22 - the recursion is entirely inside
 rpc-message.c). The upstream new file test-rpc-message.c has no counterpart
 in target; the regression test test_attribute_recursion_limit is instead
 added to the existing p11-kit/test-rpc.c and registered as
 /rpc/attribute-recursion-limit.
Origin: backport, https://github.com/p11-glue/p11-kit/commit/4b5eb61213e8dbe3232e7cb4668834126405e9a2
Bug: https://github.com/p11-glue/p11-kit/pull/768
Author: Zoltan Fridrich <zfridric@redhat.com>
Last-Update: 2026-07-03
---
--- a/p11-kit/rpc-message.c
+++ b/p11-kit/rpc-message.c
@@ -48,6 +48,8 @@
 
 #define ELEMS(x) (sizeof (x) / sizeof (x[0]))
 
+#define MAX_RECURSION_DEPTH 8
+
 void
 p11_rpc_message_init (p11_rpc_message *msg,
                       p11_buffer *input,
@@ -1114,12 +1116,19 @@
 					  void *value,
 					  CK_ULONG *value_length)
 {
+	static size_t recursion_depth = 0;
 	uint32_t count, i;
 	CK_ATTRIBUTE *attr, temp;
+	bool ret = false;
 
-	if (!p11_rpc_buffer_get_uint32 (buffer, offset, &count))
+	if (recursion_depth >= MAX_RECURSION_DEPTH)
 		return false;
 
+	recursion_depth++;
+
+	if (!p11_rpc_buffer_get_uint32 (buffer, offset, &count))
+		goto out;
+
 	if (!value) {
 		memset (&temp, 0, sizeof (CK_ATTRIBUTE));
 		attr = &temp;
@@ -1128,7 +1137,7 @@
 
 	for (i = 0; i < count; i++) {
 		if (!p11_rpc_buffer_get_attribute (buffer, offset, attr))
-			return false;
+			goto out;
 		if (value)
 			attr++;
 	}
@@ -1136,7 +1145,10 @@
 	if (value_length)
 		*value_length = count * sizeof (CK_ATTRIBUTE);
 
-	return true;
+	ret = true;
+out:
+	recursion_depth--;
+	return ret;
 }
 
 bool
--- a/p11-kit/test-rpc.c
+++ b/p11-kit/test-rpc.c
@@ -691,6 +691,46 @@
 	p11_buffer_uninit (&buffer);
 }
 
+static void
+test_attribute_recursion_limit (void)
+{
+	bool ret;
+	p11_rpc_message msg;
+	p11_buffer buffer;
+	size_t offset = 0;
+	CK_BBOOL truev = CK_TRUE;
+	CK_ATTRIBUTE attr9 = { CKA_ENCRYPT, &truev, sizeof (CK_BBOOL) };
+	CK_ATTRIBUTE attr8 = { CKA_WRAP_TEMPLATE, &attr9, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr7 = { CKA_WRAP_TEMPLATE, &attr8, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr6 = { CKA_WRAP_TEMPLATE, &attr7, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr5 = { CKA_WRAP_TEMPLATE, &attr6, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr4 = { CKA_WRAP_TEMPLATE, &attr5, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr3 = { CKA_WRAP_TEMPLATE, &attr4, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr2 = { CKA_WRAP_TEMPLATE, &attr3, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr1 = { CKA_WRAP_TEMPLATE, &attr2, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attrs_in[] = {{ CKA_WRAP_TEMPLATE, &attr1, sizeof (CK_ATTRIBUTE) }};
+	CK_ULONG val_size = 0;
+
+	ret = p11_buffer_init (&buffer, 0);
+	assert_num_eq (true, ret);
+	p11_rpc_message_init (&msg, &buffer, &buffer);
+	ret = p11_rpc_message_write_attribute_array (&msg, attrs_in, ELEMS(attrs_in));
+	assert_num_eq (true, ret);
+
+	/* Skip the array count written by write_attribute_array so that the
+	 * subsequent get_attribute_array_value call parses the nested
+	 * attributes directly. */
+	ret = p11_rpc_buffer_get_uint32 (&buffer, &offset, NULL);
+	assert_num_eq (true, ret);
+
+	/* Nested >= MAX_RECURSION_DEPTH (8) levels: must be rejected. */
+	ret = p11_rpc_buffer_get_attribute_array_value (&buffer, &offset, NULL, &val_size);
+	assert_num_eq (false, ret);
+
+	p11_rpc_message_clear (&msg);
+	p11_buffer_uninit (&buffer);
+}
+
 static p11_virtual base;
 static unsigned int rpc_initialized = 0;
 
@@ -1384,6 +1424,7 @@
 	p11_test (test_byte_array_value, "/rpc/byte-array-value");
 	p11_test (test_mechanism_value, "/rpc/mechanism-value");
 	p11_test (test_message_write, "/rpc/message-write");
+	p11_test (test_attribute_recursion_limit, "/rpc/attribute-recursion-limit");
 
 	p11_test (test_initialize_fails_on_client, "/rpc/initialize-fails-on-client");
 	p11_test (test_initialize_fails_on_server, "/rpc/initialize-fails-on-server");
Description: CVE-2026-18938 - guard against overflow when decoding nested attributes
 A local attacker, or one with equivalent access to a reachable RPC channel,
 could exploit an integer overflow vulnerability. By sending specially crafted
 messages, the attacker can cause the system to miscalculate memory allocation
 for nested attributes (count * sizeof(CK_ATTRIBUTE) / CK_MECHANISM_TYPE). This
 leads to a memory corruption issue, specifically a heap out-of-bounds write,
 which can crash the p11-kit RPC parsing process, resulting in a Denial of
 Service (DoS). This vulnerability is only exploitable on 32 bit systems.
 .
 Backported to 0.23.22: upstream commit 3e64244e adds the guards to the
 recursive decoders p11_rpc_message_get_attribute_array_value and
 p11_rpc_message_get_mechanism_type_array_value, which do not exist in this
 branch. The equivalent vulnerable count * sizeof(...) computations live in
 p11_rpc_buffer_get_attribute_array_value and
 p11_rpc_buffer_get_mechanism_type_array_value; the same SIZE_MAX overflow
 guard is applied there before the multiplication.
 .
 Context is rebased onto the CVE-2026-13757 static recursion-depth helper:
 after that change, a failed overflow check in
 p11_rpc_buffer_get_attribute_array_value must goto out (not return false)
 so recursion_depth is decremented. The mechanism-type decoder is unchanged
 by CVE-2026-13757. Regression tests for each decoder are added to
 test-rpc.c.
Origin: upstream, https://github.com/p11-glue/p11-kit/commit/3e64244e538550c6a7fcf826fa8c50a4604416dc
Author: Zoltan Fridrich <zfridric@redhat.com>
Last-Update: 2026-09-08
---
--- a/p11-kit/rpc-message.c
+++ b/p11-kit/rpc-message.c
@@ -1127,6 +1127,10 @@ p11_rpc_buffer_get_attribute_array_value (p11_buffer *buffer,
 	if (!p11_rpc_buffer_get_uint32 (buffer, offset, &count))
 		goto out;
 
+	/* Guard against overflow */
+	if (count != 0 && (SIZE_MAX / count) < sizeof (CK_ATTRIBUTE))
+		goto out;
+
 	if (!value) {
 		memset (&temp, 0, sizeof (CK_ATTRIBUTE));
 		attr = &temp;
@@ -1161,6 +1165,10 @@ p11_rpc_buffer_get_mechanism_type_array_value (p11_buffer *buffer,
 	if (!p11_rpc_buffer_get_uint32 (buffer, offset, &count))
 		return false;
 
+	/* Guard against overflow */
+	if (count != 0 && (SIZE_MAX / count) < sizeof (CK_MECHANISM_TYPE))
+		return false;
+
 	if (!value) {
 		memset (&temp, 0, sizeof (CK_MECHANISM_TYPE));
 		mech = &temp;
--- a/p11-kit/test-rpc.c
+++ b/p11-kit/test-rpc.c
@@ -523,6 +523,50 @@ test_mechanism_type_array_value (void)
 
 	p11_buffer_uninit (&buffer);
 }
+
+static void
+test_attribute_array_value_overflow (void)
+{
+	p11_buffer buffer;
+	CK_ULONG val_size;
+	size_t offset = 0;
+	bool ret;
+
+	/* CVE-2026-18938: a crafted message with a huge element count must be
+	 * rejected instead of overflowing count * sizeof (CK_ATTRIBUTE). */
+	p11_buffer_init (&buffer, 0);
+
+	p11_rpc_buffer_add_uint32 (&buffer, 0xffffffff);
+	assert (!p11_buffer_failed (&buffer));
+
+	offset = 0;
+	ret = p11_rpc_buffer_get_attribute_array_value (&buffer, &offset, NULL, &val_size);
+	assert_num_eq (false, ret);
+
+	p11_buffer_uninit (&buffer);
+}
+
+static void
+test_mechanism_type_array_value_overflow (void)
+{
+	p11_buffer buffer;
+	CK_ULONG val_size;
+	size_t offset = 0;
+	bool ret;
+
+	/* CVE-2026-18938: a crafted message with a huge element count must be
+	 * rejected instead of overflowing count * sizeof (CK_MECHANISM_TYPE). */
+	p11_buffer_init (&buffer, 0);
+
+	p11_rpc_buffer_add_uint32 (&buffer, 0xffffffff);
+	assert (!p11_buffer_failed (&buffer));
+
+	offset = 0;
+	ret = p11_rpc_buffer_get_mechanism_type_array_value (&buffer, &offset, NULL, &val_size);
+	assert_num_eq (false, ret);
+
+	p11_buffer_uninit (&buffer);
+}
 
 static void
 test_date_value (void)
@@ -1418,6 +1462,8 @@ main (int argc,
 	p11_test (test_ulong_value, "/rpc/ulong-value");
 	p11_test (test_attribute_array_value, "/rpc/attribute-array-value");
 	p11_test (test_mechanism_type_array_value, "/rpc/mechanism-type-array-value");
+	p11_test (test_attribute_array_value_overflow, "/rpc/attribute-array-value-overflow");
+	p11_test (test_mechanism_type_array_value_overflow, "/rpc/mechanism-type-array-value-overflow");
 	p11_test (test_date_value, "/rpc/date-value");
 	p11_test (test_date_value_empty, "/rpc/date-value-empty");
 	p11_test (test_byte_array_value, "/rpc/byte-array-value");
