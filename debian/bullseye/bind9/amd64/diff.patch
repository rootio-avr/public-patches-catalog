Description: CVE-2025-40777 - Fix assertion when using stale-answer-client-timeout 0
 If a caching resolver is configured with stale-answer-enable yes and
 stale-answer-client-timeout 0, a CNAME chain involving a mix of cached
 and authoritative records could abort named with an assertion.
 .
 Backport of upstream 9.20 commit 9c7a6314 to BIND 9.16.50. In 9.16 the
 stalefirst state is the DNS_GETDB_STALEFIRST bit rather than a boolean.
 DNS_DBFIND_STALETIMEOUT is cleared at the start of query_lookup() and
 only re-set when looking up in the cache (!is_zone). The cachedb attach
 after qctx_clean() is kept: 9.16 still needs it (removing it leaves
 qctx->db NULL and trips db.c REQUIRE).
Origin: backport, https://gitlab.isc.org/isc-projects/bind9/-/commit/9c7a63142dacb2e16c64719f57d1191298af4393
Bug: https://kb.isc.org/docs/cve-2025-40777
Last-Update: 2026-08-20

--- a/lib/ns/query.c
+++ b/lib/ns/query.c
@@ -5618,16 +5618,16 @@
 		}
 	}
 
+	/*
+	 * If stale answers are enabled and stale-answer-client-timeout is zero,
+	 * then we can promptly answer with a stale RRset if one is available in
+	 * cache.
+	 */
 	if (!qctx->is_zone && (qctx->view->staleanswerclienttimeout == 0) &&
 	    dns_view_staleanswerenabled(qctx->view))
-	{
-		/*
-		 * If stale answers are enabled and
-		 * stale-answer-client-timeout is zero, then we can promptly
-		 * answer with a stale RRset if one is available in cache.
-		 */
 		qctx->options |= DNS_GETDB_STALEFIRST;
-	}
+	else
+		qctx->options &= ~DNS_GETDB_STALEFIRST;
 
 	result = query_lookup(qctx);
 
@@ -5820,7 +5820,9 @@
 		rpzqname = qctx->client->query.qname;
 	}
 
-	if ((qctx->options & DNS_GETDB_STALEFIRST) != 0) {
+	qctx->client->query.dboptions &= ~DNS_DBFIND_STALETIMEOUT;
+
+	if ((qctx->options & DNS_GETDB_STALEFIRST) != 0 && !qctx->is_zone) {
 		/*
 		 * If DNS_GETDB_STALEFIRST is set, it means that a stale
 		 * RRset may be returned as part of this lookup. An attempt
@@ -5964,8 +5966,6 @@
 				qctx_freedata(qctx);
 				dns_db_attach(qctx->client->view->cachedb,
 					      &qctx->db);
-				qctx->client->query.dboptions &=
-					~DNS_DBFIND_STALETIMEOUT;
 				qctx->options &= ~DNS_GETDB_STALEFIRST;
 				if (qctx->client->query.fetch != NULL) {
 					dns_resolver_destroyfetch(
@@ -8619,6 +8619,19 @@
 		dns_db_attach(qctx->view->cachedb, &qctx->db);
 		qctx->is_zone = false;
 
+		/*
+		 * If stale answers are enabled and stale-answer-client-timeout
+		 * is zero, then we can promptly answer with a stale RRset if one
+		 * is available in cache. We need to do this here, overriding
+		 * setting the 'stalefirst' option, which is usually set in
+		 * the beginning in ns__query_start().
+		 */
+		if (qctx->view->staleanswerclienttimeout == 0 &&
+		    dns_view_staleanswerenabled(qctx->view))
+			qctx->options |= DNS_GETDB_STALEFIRST;
+		else
+			qctx->options &= ~DNS_GETDB_STALEFIRST;
+
 		return (query_lookup(qctx));
 	}
 
