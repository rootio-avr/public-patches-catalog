+static const char *
+evhttp_find_unique_header(const struct evkeyvalq *headers, const char *key,
+    int *duplicate)
+{
+	const char *result = NULL;
+	struct evkeyval *header;
+
+	*duplicate = 0;
+
+	TAILQ_FOREACH(header, headers, next) {
+		if (evutil_ascii_strcasecmp(header->key, key) == 0) {
+			if (result == NULL) {
+				result = header->value;
+			} else {
+				*duplicate = 1;
+				break;
+			}
+		}
+	}
+
