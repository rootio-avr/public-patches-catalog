@@ -0,0 +1,127 @@
+--TEST--
+session rfc1867: the upload progress update does not run user code while decoding the session before RINIT
+--SKIPIF--
+<?php
+include('skipif.inc');
+if (!getenv('TEST_PHP_CGI_EXECUTABLE')) {
+    die('skip CGI not available');
+}
+?>
+--FILE--
+<?php
+
+$dir = __DIR__ . '/rfc1867_no_user_code';
+@mkdir($dir);
+$sid = 'rfc1867nousercode';
+$file = "$dir/sess_$sid";
+$worker = "$dir/worker.php";
+file_put_contents($worker, '<?php');
+
+/* Objects stored in the session must be kept as __PHP_Incomplete_Class while
+ * the upload progress handler runs: unserialize_callback_func (here the
+ * internal printf(), which would print the class name) must not be called, and
+ * both O: and C: values must be written back unchanged. */
+$cases = [
+    'O:' => 'x|O:3:"Foo":1:{s:1:"a";i:1;}',
+    'C:' => 'x|C:3:"Bar":3:{abc}',
+    'nested' => 'x|a:1:{i:0;O:3:"Baz":0:{}}',
+];
+
+$boundary = '---------------------------20896060251896012921717172737';
+$body = "--$boundary\r\n"
+      . "Content-Disposition: form-data; name=\"PHPSESSID\"\r\n\r\n$sid\r\n"
+      . "--$boundary\r\n"
+      . "Content-Disposition: form-data; name=\"PHP_SESSION_UPLOAD_PROGRESS\"\r\n\r\nkey\r\n"
+      . "--$boundary\r\n"
+      . "Content-Disposition: form-data; name=\"file1\"; filename=\"file1.txt\"\r\n\r\n1\r\n"
+      . "--$boundary--\r\n";
+
+$ini = [
+    'error_reporting' => 'E_ALL',
+    'display_errors' => '1',
+    'html_errors' => '0',
+    'file_uploads' => '1',
+    'upload_max_filesize' => '1024',
+    'unserialize_callback_func' => 'printf',
+    'session.save_path' => $dir,
+    'session.name' => 'PHPSESSID',
+    'session.use_strict_mode' => '0',
+    'session.use_cookies' => '0',
+    'session.use_only_cookies' => '0',
+    'session.cache_limiter' => '',
+    'session.save_handler' => 'files',
+    'session.serialize_handler' => 'php',
+    'session.upload_progress.enabled' => '1',
+    'session.upload_progress.cleanup' => '0',
+    'session.upload_progress.prefix' => 'upload_progress_',
+    'session.upload_progress.name' => 'PHP_SESSION_UPLOAD_PROGRESS',
+    'session.upload_progress.freq' => '1%',
+    'session.upload_progress.min_freq' => '0.000000001',
+];
+
+/* php-cgi is started with -n, so a shared session module has to be named again. */
+$extension_dir = ini_get('extension_dir');
+foreach (['session.' . PHP_SHLIB_SUFFIX, 'php_session.' . PHP_SHLIB_SUFFIX] as $module) {
+    if ($extension_dir !== false && file_exists("$extension_dir/$module")) {
+        $ini['extension_dir'] = $extension_dir;
+        $ini['extension'] = $module;
+        break;
+    }
+}
+
+$cmd = [getenv('TEST_PHP_CGI_EXECUTABLE'), '-n', '-q'];
+foreach ($ini as $name => $value) {
+    $cmd[] = '-d';
+    $cmd[] = "$name=$value";
+}
+$cmd[] = '-f';
+$cmd[] = $worker;
+
+$env = getenv();
+$env['REDIRECT_STATUS'] = '1';
+$env['REQUEST_METHOD'] = 'POST';
+$env['CONTENT_TYPE'] = "multipart/form-data; boundary=$boundary";
+$env['CONTENT_LENGTH'] = (string) strlen($body);
+$env['SCRIPT_FILENAME'] = $worker;
+$env['PATH_TRANSLATED'] = $worker;
+$env['QUERY_STRING'] = '';
+
+foreach ($cases as $label => $record) {
+    file_put_contents($file, $record);
+
+    $pipes = [];
+    $proc = proc_open(
+        $cmd,
+        [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
+        $pipes,
+        $dir,
+        $env
+    );
+    fwrite($pipes[0], $body);
+    fclose($pipes[0]);
+    $out = stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]);
+    fclose($pipes[1]);
+    fclose($pipes[2]);
+    proc_close($proc);
+
+    $data = file_exists($file) ? file_get_contents($file) : '';
+    printf("%-7s callback called: %-5s warnings: %d, record kept: %s\n", $label,
+        var_export(strpos($out, 'Foo') !== false || strpos($out, 'Bar') !== false || strpos($out, 'Baz') !== false, true),
+        substr_count($out, 'Warning:'),
+        var_export(strpos($data, $record) === 0, true));
+}
+
+?>
+--CLEAN--
+<?php
+$dir = __DIR__ . '/rfc1867_no_user_code';
+@unlink("$dir/worker.php");
+foreach (glob("$dir/sess_*") as $f) {
+    unlink($f);
+}
+@rmdir($dir);
+?>
+--EXPECT--
+O:      callback called: false warnings: 0, record kept: true
+C:      callback called: false warnings: 0, record kept: true
+nested  callback called: false warnings: 0, record kept: true
