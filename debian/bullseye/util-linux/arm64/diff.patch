+/*
+ * Open @path and reject symlinks at any path component (not only the last
+ * one). Uses openat2(RESOLVE_NO_SYMLINKS) if the kernel supports it
+ * (Linux >= 5.6), otherwise the path is walked component by component with
+ * O_NOFOLLOW. The syscall number and the structure are defined locally
+ * because old glibc (< 2.32) does not provide SYS_openat2 and old kernel
+ * headers may not provide <linux/openat2.h>.
+ */
+#ifndef __NR_openat2
+# define __NR_openat2 437
+#endif
+#define UL_RESOLVE_NO_SYMLINKS	0x04
+
+struct ul_open_how {
+	uint64_t flags;
+	uint64_t mode;
+	uint64_t resolve;
+};
+
+static int open_no_symlinks_walk(const char *path, int flags, mode_t mode)
+{
+	char *buf, *p;
+	int dirfd, fd = -1, err = 0;
+
+	if (!path || !*path) {
+		errno = ENOENT;
+		return -1;
+	}
+	buf = strdup(path);
+	if (!buf)
+		return -1;
+
+	dirfd = open(*path == '/' ? "/" : ".", O_PATH | O_DIRECTORY | O_CLOEXEC);
+	if (dirfd < 0) {
+		err = errno;
+		goto done;
+	}
+
+	p = buf;
+	while (*p == '/')
+		p++;
+
+	while (*p) {
+		char *comp = p, *next = strchr(p, '/');
+		int last, nfd;
+
+		if (next) {
+			*next++ = '\0';
+			while (*next == '/')
+				next++;
+		} else
+			next = p + strlen(p);
+		p = next;
+		last = (*p == '\0');
+
+		if (last)
+			nfd = openat(dirfd, comp, flags | O_NOFOLLOW | O_CLOEXEC, mode);
+		else
+			nfd = openat(dirfd, comp,
+				     O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		if (nfd < 0) {
+			err = errno;
+			goto done;
+		}
+		if (last && (flags & O_PATH)) {
+			struct stat st;
+
+			/* O_PATH|O_NOFOLLOW succeeds on symlinks */
+			if (fstat(nfd, &st) == 0 && S_ISLNK(st.st_mode)) {
+				close(nfd);
+				err = ELOOP;
+				goto done;
+			}
+		}
+		close(dirfd);
+		dirfd = nfd;
+		if (last) {
+			fd = nfd;
+			dirfd = -1;
+		}
+	}
+
+	if (fd < 0)	/* path without any component (e.g. "/") */
+		fd = openat(dirfd, ".", flags | O_NOFOLLOW | O_CLOEXEC, mode);
+	if (fd < 0)
+		err = errno;
+done:
+	if (dirfd >= 0)
+		close(dirfd);
+	free(buf);
+	if (fd < 0)
+		errno = err;
+	return fd;
+}
+
+int ul_open_no_symlinks(const char *path, int flags, mode_t mode)
+{
+	struct ul_open_how how = {
+		.flags = (uint64_t) flags,
+		.mode = (uint64_t) mode,
+		.resolve = UL_RESOLVE_NO_SYMLINKS,
+	};
+	int fd = syscall(__NR_openat2, AT_FDCWD, path, &how, sizeof(how));
+
+	/* only walk manually if the syscall is not available */
+	if (fd >= 0 || (errno != ENOSYS && errno != EPERM))
+		return fd;
+
+	return open_no_symlinks_walk(path, flags, mode);
+}
