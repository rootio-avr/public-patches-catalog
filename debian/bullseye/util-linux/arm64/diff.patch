+/* The target has to be pinned for restricted (non-root) mount(8) to avoid
+ * TOCTOU races between the target validation and mount(2). */
+int mnt_context_target_fd_required(struct libmnt_context *cxt)
+{
+	return mnt_context_is_restricted(cxt);
+}
+
+int mnt_context_get_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+
+	if (cxt->fd_target < 0) {
+		const char *target = cxt->fs ? mnt_fs_get_target(cxt->fs) : NULL;
+
+		if (target)
+			cxt->fd_target = ul_open_no_symlinks(target,
+						O_PATH | O_CLOEXEC, 0);
+	}
+	return cxt->fd_target;
+}
+
+void mnt_context_close_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+
+	if (cxt->fd_target >= 0)
+		close(cxt->fd_target);
+	cxt->fd_target = -1;
+}
+
+/* re-open the target to point to the mounted filesystem root */
+int mnt_context_reopen_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+
+	if (!mnt_context_target_fd_required(cxt))
+		return 0;
+	mnt_context_close_target_fd(cxt);
+	if (mnt_context_get_target_fd(cxt) < 0)
+		return -errno;
+	return 0;
+}
+
+/*
+ * Returns path that is safe for mount(2). For restricted mount it is
+ * /proc/self/fd/<fd_target>, which refers to the pinned target and cannot be
+ * redirected by modifying path components after the target validation. For
+ * unrestricted mount it returns @target. Returns NULL on error (errno is set).
+ */
+const char *mnt_context_get_pinned_target(struct libmnt_context *cxt,
+			const char *target, char *buf, size_t bufsz)
+{
+	int fd;
+
+	if (!mnt_context_target_fd_required(cxt))
+		return target;
+
+	fd = mnt_context_get_target_fd(cxt);
+	if (fd < 0)
+		return NULL;
+
+	if (snprintf(buf, bufsz, "/proc/self/fd/%d", fd) >= (int) bufsz) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	return buf;
+}
