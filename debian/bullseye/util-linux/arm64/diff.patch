+			/* data partition must be within the extended area */
+			if (abs < ex_start || abs + size > ex_end) {
+				DBG(LOWPROBE, ul_debug("#%d: EBR data partition outside "
+						"extended -- ignore", i + 1));
+				continue;
+			}
+			abs_start = (uint32_t) abs;
+
