Description: CVE-2026-42960 - Fix possible cache poisoning while following delegation
 In scrub_normalize() (iterator/iter_scrub.c) address records in the
 additional section were unconditionally marked as allowed glue for any
 RRset in the authority section. A malicious authoritative server could
 therefore attach address records as glue for non-delegation RR types
 (e.g. MX) in the authority section and have them cached as a side effect
 of the query, enabling a cache poisoning attack while following a
 delegation.
 .
 This patch only marks additional address records as allowed glue when the
 authority-section RRset is of type NS, matching the delegation semantics.
 It complements the earlier fix for CVE-2025-11411.
 .
 A regression test (testdata/iter_scrub_mx.rpl) is added; it is discovered
 automatically by the testbound replay runner (testdata/03-testbound.tdir)
 which globs testdata/*.rpl.
Origin: upstream, https://github.com/NLnetLabs/unbound/commit/8ae4b4545dccaaabd30b597b0dcb0d9640c8cc39
Author: NLnet Labs <unbound@nlnetlabs.nl>
Last-Update: 2026-08-18
---
--- a/iterator/iter_scrub.c
+++ b/iterator/iter_scrub.c
@@ -566,7 +566,13 @@ scrub_normalize(sldns_buffer* pkt, struct msg_parse* msg,
 			rrset->rrset_all_next = NULL;
 			return 1;
 		}
-		mark_additional_rrset(pkt, msg, rrset);
+		/* Only mark glue as allowed for type NS in the authority
+		 * section. Other RR types do not get glue for them, it
+		 * is allowed from the answer section, but not authority
+		 * so that a message can not have address records cached
+		 * as a side effect to the query. */
+		if(rrset->type==LDNS_RR_TYPE_NS)
+			mark_additional_rrset(pkt, msg, rrset);
 		prev = rrset;
 		rrset = rrset->rrset_all_next;
 	}
--- /dev/null
+++ b/testdata/iter_scrub_mx.rpl
@@ -0,0 +1,107 @@
+; config options
+server:
+	target-fetch-policy: "0 0 0 0 0"
+
+stub-zone:
+	name: "."
+	stub-addr: 193.0.14.129 	# K.ROOT-SERVERS.NET.
+
+stub-zone:
+	name: "example.com"
+	stub-addr: 1.2.3.4
+CONFIG_END
+
+SCENARIO_BEGIN Test scrubber does not cache glue for authority MX (CVE-2026-42960)
+
+; K.ROOT-SERVERS.NET.
+RANGE_BEGIN 0 100
+	ADDRESS 193.0.14.129
+ENTRY_BEGIN
+MATCH opcode qtype qname
+ADJUST copy_id
+REPLY QR NOERROR
+SECTION QUESTION
+. IN NS
+SECTION ANSWER
+. IN NS	K.ROOT-SERVERS.NET.
+SECTION ADDITIONAL
+K.ROOT-SERVERS.NET.	IN	A	193.0.14.129
+ENTRY_END
+RANGE_END
+
+; ns.example.com.
+RANGE_BEGIN 0 100
+	ADDRESS 1.2.3.4
+ENTRY_BEGIN
+MATCH opcode qtype qname
+ADJUST copy_id
+REPLY QR NOERROR
+SECTION QUESTION
+www.example.com. IN A
+SECTION ANSWER
+www.example.com. IN A	10.20.30.40
+SECTION AUTHORITY
+; MX in the authority section: its additional address glue must not be
+; kept and must not be cached as a side effect of this query.
+example.com.	IN MX	10 mail.attacker.com.
+SECTION ADDITIONAL
+mail.attacker.com.	IN 	A	6.6.6.6
+ENTRY_END
+
+; a follow-up query for the attacker glue name; if the scrubber wrongly
+; cached the additional A record above, this would be answered from cache.
+ENTRY_BEGIN
+MATCH opcode qtype qname
+ADJUST copy_id
+REPLY QR NOERROR
+SECTION QUESTION
+mail.attacker.com. IN A
+SECTION ANSWER
+mail.attacker.com.	IN A	1.2.3.4
+ENTRY_END
+
+RANGE_END
+
+STEP 1 QUERY
+ENTRY_BEGIN
+REPLY RD
+SECTION QUESTION
+www.example.com. IN A
+ENTRY_END
+
+; recursion happens here.
+STEP 10 CHECK_ANSWER
+ENTRY_BEGIN
+MATCH all
+REPLY QR RD RA NOERROR
+SECTION QUESTION
+www.example.com. IN A
+SECTION ANSWER
+www.example.com. IN A	10.20.30.40
+SECTION AUTHORITY
+SECTION ADDITIONAL
+ENTRY_END
+
+; the attacker glue must have been scrubbed and NOT cached, so this query
+; must be resolved from the authoritative server (returning 1.2.3.4), not
+; from the poisoned additional-section value (6.6.6.6).
+STEP 20 QUERY
+ENTRY_BEGIN
+REPLY RD
+SECTION QUESTION
+mail.attacker.com. IN A
+ENTRY_END
+
+STEP 30 CHECK_ANSWER
+ENTRY_BEGIN
+MATCH all
+REPLY QR RD RA NOERROR
+SECTION QUESTION
+mail.attacker.com. IN A
+SECTION ANSWER
+mail.attacker.com.	IN A	1.2.3.4
+SECTION AUTHORITY
+SECTION ADDITIONAL
+ENTRY_END
+
+SCENARIO_END
Description: Fix CVE-2026-33278 - use-after-free / RCE during DNSSEC validation.
 Upstream CVE-2026-33278 is a use-after-free in dns_msg_deepcopy_region()
 reached through the NSEC3 computational-budget suspend/resume path, both of
 which were introduced in unbound 1.19.1 and do not exist in this 1.13.1
 target. This backports the portable, applicable half of upstream fix commit
 6a31e470f80a6e5c559ebe7fd4cfc0582d3b6d0a: a defensive param_set_same() input
 check that rejects NSEC3 record sets whose members come from distinct NSEC3
 chains (mismatched algorithm, iteration count, or salt) or that are malformed,
 before running the expensive NSEC3 proofs. This mixed-chain/malformed NSEC3
 record set from a malicious signed zone is the attacker-controlled precondition
 that drives the excessive NSEC3 computation underlying the vulnerability. The
 guard is added at the entry of all five NSEC3 proof functions.
Origin: ai-synthesized, CVE-2026-33278
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-08-18

--- a/validator/val_nsec3.c
+++ b/validator/val_nsec3.c
@@ -443,6 +443,67 @@ filter_init(struct nsec3_filter* filter, struct ub_packed_rrset_key** list,
 	}
 }
 
+/** Check if the NSEC3s have the same parameter set. */
+static int
+param_set_same(struct nsec3_filter* flt, char** reason)
+{
+	size_t rrsetnum;
+	int rrnum;
+	struct ub_packed_rrset_key* rrset;
+	int have_params = 0;
+	int first_algo = 0;
+	size_t first_iter = 0;
+	uint8_t* first_salt = NULL;
+	size_t first_saltlen = 0;
+
+	/* If the NSEC3 parameter sets have distinct values, then they are
+	 * from different NSEC3 chains, and we do not want that. */
+	for(rrset=filter_first(flt, &rrsetnum, &rrnum); rrset;
+		rrset=filter_next(flt, &rrsetnum, &rrnum)) {
+		if(!have_params) {
+			first_algo = nsec3_get_algo(rrset, rrnum);
+			first_iter = nsec3_get_iter(rrset, rrnum);
+			if(!nsec3_get_salt(rrset, rrnum, &first_salt,
+				&first_saltlen)) {
+				verbose(VERB_ALGO, "NSEC3 salt malformed");
+				if(reason)
+					*reason = "NSEC3 salt malformed";
+				return 0;
+			}
+			have_params = 1;
+		} else {
+			uint8_t* salt = NULL;
+			size_t saltlen = 0;
+			if(nsec3_get_algo(rrset, rrnum) != first_algo) {
+				verbose(VERB_ALGO, "NSEC3 algorithm mismatch");
+				if(reason)
+					*reason = "NSEC3 algorithm mismatch";
+				return 0;
+			}
+			if(nsec3_get_iter(rrset, rrnum) != first_iter) {
+				verbose(VERB_ALGO, "NSEC3 iterations mismatch");
+				if(reason)
+					*reason = "NSEC3 iterations mismatch";
+				return 0;
+			}
+			if(!nsec3_get_salt(rrset, rrnum, &salt, &saltlen)) {
+				verbose(VERB_ALGO, "NSEC3 salt malformed");
+				if(reason)
+					*reason = "NSEC3 salt malformed";
+				return 0;
+			}
+			if(saltlen != first_saltlen ||
+				memcmp(salt, first_salt, saltlen) != 0) {
+				verbose(VERB_ALGO, "NSEC3 salt mismatch");
+				if(reason)
+					*reason = "NSEC3 salt mismatch";
+				return 0;
+			}
+		}
+	}
+	return 1;
+}
