+#include "util/data/msgparse.h"
+#include "util/data/msgencode.h"
+#include "util/regional.h"
+/** Regression test for CVE-2026-42944: the EDNS option size accounting must
+ * not truncate to 16 bits.  Multiple/large nsid, cookie or padding EDNS
+ * options previously wrapped a uint16_t accumulator, under-reserving buffer
+ * space and causing a heap overflow when the record was written out. */
+static void
+edns_encode_overflow_test(void)
+{
+	struct regional* region = regional_create();
+	struct edns_data edns;
+	struct edns_option* opts = NULL;
+	size_t i, field_size, total = 0;
+	unit_show_func("util/data/msgencode.c", "calc_edns_field_size");
+	unit_assert(region);
+	memset(&edns, 0, sizeof(edns));
+	edns.edns_present = 1;
+	edns.udp_size = 4096;
+	/* Build several large EDNS options whose combined rdata clearly
+	 * exceeds 65535 octets, so a 16-bit size accumulator would wrap. */
+	for(i=0; i<5; i++) {
+		struct edns_option* o = (struct edns_option*)
+			regional_alloc_zero(region, sizeof(*o));
+		unit_assert(o);
+		o->opt_code = LDNS_EDNS_NSID;
+		o->opt_len = 20000;
+		o->opt_data = NULL; /* size accounting does not read data */
+		o->next = opts;
+		opts = o;
+		total += 4 + o->opt_len;
+	}
+	edns.opt_list = opts;
+	field_size = calc_edns_field_size(&edns);
+	/* '.' + type + class + ttl + rdatalen == 11 octets of overhead. */
+	unit_assert(field_size == (size_t)11 + total);
+	/* The key property: the size must NOT be truncated to 16 bits. */
+	unit_assert(field_size > 65535);
+	regional_destroy(region);
+}
+
