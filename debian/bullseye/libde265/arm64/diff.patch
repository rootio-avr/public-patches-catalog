Description: Fix CVE-2026-49337 - free orphaned slice header when no active image unit
 A specially crafted sequence of H.265 NAL units causes
 decoder_context::read_slice_NAL() to attach slice headers to a completed
 picture object even when there is no active image unit to decode the
 slice. The retained headers persist on img->slices, and a crafted stream
 of non-first-slice NAL units can exploit this to grow the heap without
 bound (CWE-770: Allocation of Resources Without Limits or Throttling).
 .
 Only hand the slice header to the picture (which takes ownership) when
 an image unit is present; otherwise free both the NAL unit and the
 orphaned slice header.
Origin: upstream, commit:683cb9fa603e35840642f98765ab95cdb71cadf9
Author: Dirk Farin <dirk.farin@gmail.com>
Bug: https://github.com/strukturag/libde265/security/advisories/GHSA-g5hj-rf9f-7vxm
Last-Update: 2026-07-08

--- a/libde265/decctx.cc
+++ b/libde265/decctx.cc
@@ -653,8 +653,6 @@ de265_error decoder_context::read_slice_NAL(bitreader& reader, NAL_unit* nal, na
       return err;
     }

-  this->img->add_slice_segment_header(shdr);
-
   skip_bits(&reader,1); // TODO: why?
   prepare_for_CABAC(&reader);

@@ -682,6 +680,13 @@ de265_error decoder_context::read_slice_NAL(bitreader& reader, NAL_unit* nal, na

   if ( ! image_units.empty() ) {

+    // Hand the slice header to the picture (which takes ownership and frees it
+    // on release). Only do this when there is an active image unit to decode
+    // the slice; otherwise the header would be retained on img->slices forever,
+    // which a crafted stream of non-first slice NALs can exploit to grow memory
+    // without bound.
+    this->img->add_slice_segment_header(shdr);
+
     slice_unit* sliceunit = new slice_unit(this);
     sliceunit->nal = nal;
     sliceunit->shdr = shdr;
@@ -691,6 +696,10 @@ de265_error decoder_context::read_slice_NAL(bitreader& reader, NAL_unit* nal, na


     image_units.back()->slice_units.push_back(sliceunit);
+  }
+  else {
+    nal_parser.free_NAL_unit(nal);
+    delete shdr;
   }

   bool did_work;
