+#!/bin/sh
+
+# Copyright (C) 2026 by Andrew Tridgell
+
+# This program is distributable under the terms of the GNU GPL (see
+# COPYING).
+
+# Regression test for CVE-2026-53791: the off-by-one stack OOB write in
+# establish_proxy_connection() in socket.c when a malicious or
+# man-in-the-middle HTTP proxy returns a first response line of
+# 1023+ bytes without a '\n' terminator.
+#
+# Pre-fix: the read loop walked buffer[0..sizeof-2] one byte at a
+# time, then post-loop logic did "if (*cp != '\n') cp++; *cp-- =
+# '\0';".  If no newline arrived before the loop filled the buffer,
+# cp was left at &buffer[sizeof-1] (never written by the loop),
+# *cp held stale stack bytes, and cp++ pushed cp one past the array.
+# The null-termination then wrote one byte out of bounds on the
+# stack.  AddressSanitizer reports stack-buffer-overflow at the
+# null-termination site.
+#
+# Post-fix: the bound-exhaustion case is detected by position and
+# rejected with a "proxy response line too long" message, so no
+# OOB write occurs and rsync exits with a non-signal status.
+
+. "$suitedir/rsync.fns"
+
+command -v python3 >/dev/null 2>&1 || test_skipped "python3 not available"
+
+workdir="$scratchdir/workdir"
+mkdir -p "$workdir"
+cd "$workdir"
+
+port_file="$workdir/port"
+proxy_log="$workdir/proxy.log"
+
+# A minimal TCP listener: binds to an ephemeral port on 127.0.0.1,
+# writes the chosen port to $port_file *before* accept() so the test
+# can synchronise without a sleep, accepts one connection, reads
+# until end-of-headers or 64 KiB, sends exactly 1023 bytes of 'X'
+# with no '\n', then closes.
+python3 - "$port_file" >"$proxy_log" 2>&1 <<'PYEOF' &
+import socket, sys, os
+port_file = sys.argv[1]
+s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+s.bind(("127.0.0.1", 0))
+port = s.getsockname()[1]
+tmp = port_file + ".tmp"
+with open(tmp, "w") as fp:
+    fp.write("%d\n" % port)
+os.rename(tmp, port_file)   # atomic visibility to the shell side
+s.listen(1)
+conn, _ = s.accept()
+conn.settimeout(5)
+try:
+    data = b""
+    while b"\r\n\r\n" not in data and len(data) < 65536:
+        chunk = conn.recv(8192)
+        if not chunk:
+            break
+        data += chunk
+except socket.timeout:
+    pass
+conn.sendall(b"X" * 1023)    # exactly the buffer-1 trigger size
+try:
+    conn.shutdown(socket.SHUT_RDWR)
+except OSError:
+    pass
+conn.close()
+s.close()
+PYEOF
+proxy_pid=$!
+
+# Wait up to ~10s for the listener to publish its port.
+i=0
+while [ ! -s "$port_file" ] && [ $i -lt 10 ]; do
+    sleep 1
+    i=$((i + 1))
+done
+
+if [ ! -s "$port_file" ]; then
+    kill "$proxy_pid" 2>/dev/null
+    cat "$proxy_log" >&2 2>/dev/null
+    test_fail "proxy listener never published a port"
+fi
+
+port=`cat "$port_file"`
+case "$port" in
+    *[!0-9]*|"") kill "$proxy_pid" 2>/dev/null; test_fail "bogus port from listener: '$port'" ;;
+esac
+
+# Run rsync through the malicious proxy.  Any rsync:// URL works:
+# the proxy intercepts the CONNECT and never forwards anywhere.
+rsync_err="$workdir/rsync.err"
+
+# rsync MUST exit non-zero here (the proxy is misbehaving).
+# Use `|| status=$?` so we capture the real exit code under `sh -e`;
+# `if ! cmd; then status=$?` would only ever see 0 because the `!`
+# is the last command before `$?`.
+status=0
+RSYNC_PROXY="127.0.0.1:$port" \
+    $RSYNC rsync://example.invalid:873/whatever/ "$workdir/out/" \
+    >/dev/null 2>"$rsync_err" || status=$?
+
+# Reap the listener.
+wait "$proxy_pid" 2>/dev/null || true
+
+# 1. rsync must not have crashed (SIGSEGV/SIGABRT report >= 128).
+if [ "$status" -ge 128 ]; then
+    cat "$rsync_err" >&2
+    test_fail "rsync killed by signal (status=$status) -- possible stack OOB regression"
+fi
+
+# 2. rsync must have actually exited non-zero (i.e. saw the bad proxy).
+if [ "$status" -eq 0 ]; then
+    cat "$rsync_err" >&2
+    test_fail "rsync returned success despite malformed proxy response"
+fi
+
+# 3. The new error message must appear.
+if ! grep -q "proxy response line too long" "$rsync_err"; then
+    cat "$rsync_err" >&2
+    test_fail "expected 'proxy response line too long' in rsync stderr"
+fi
+
+echo "OK: over-long proxy response line rejected cleanly without crashing"
+exit 0
Description: CVE-2026-70453 - bound the hash_search() chain walk (issue #217)
 A weak (rolling) checksum that collides on a very long hash-table chain --
 common in disk/VM images, which contain large runs of identical blocks --
 made hash_search()'s inner loop walk the entire chain for every file offset.
 This is an O(file_size * chain_length) scan that pegs a CPU at 100% for hours
 with no visible progress (a denial of service against the sender).
 .
 This backport caps the number of same-weak-checksum candidates examined per
 offset at MAX_CHAIN_LEN (1024) in match.c. When the cap is reached the offset
 is treated as a non-match and the data is sent literally, so the transfer
 stays byte-for-byte correct. The change is sender-side only: it alters no
 checksum, emitted byte, or protocol field, so a capped sender interoperates
 with any receiver.
 .
 A shell regression test (testsuite/hashsearch-chain.test) is added in place of
 the upstream Python test (testsuite/hashsearch-chain_test.py), which targets a
 newer testsuite harness not present in this rsync version. It builds a
 pathological long-chain basis and asserts, via the --debug=deltasum1
 false_alarms/hash_hits ratio, that the per-offset chain walk stays bounded,
 while verifying the transferred file is identical to the source.
Origin: backport, https://github.com/RsyncProject/rsync/commit/e6956e0a30cb360b413ce2ad8df89204a1951059
Bug: https://github.com/RsyncProject/rsync/issues/217
Author: Wayne Davison <wayne@opencoder.net>
Last-Update: 2026-08-14
---
--- a/match.c
+++ b/match.c
@@ -42,6 +42,22 @@
 
 #define TRADITIONAL_TABLESIZE (1<<16)
 
+/* The maximum number of same-weak-checksum candidates we will compare
+ * against at a single file offset before giving up and rolling forward a
+ * byte.  A weak checksum that collides thousands of times (very common in
+ * disk/VM images, which contain large runs of identical blocks) would
+ * otherwise turn hash_search()'s inner loop into an O(file_size *
+ * chain_length) scan, pegging a CPU at 100% for hours with no apparent
+ * progress (issue #217).  Capping the per-offset work keeps the search
+ * bounded; any block we skip over is simply sent as literal data, so the
+ * result is always correct -- only the transfer size is (slightly) affected.
+ * This is purely a sender-side search limit: it changes no checksum, emitted
+ * byte, or protocol field, so a capped sender interoperates with any
+ * receiver. */
+#ifndef MAX_CHAIN_LEN
+#define MAX_CHAIN_LEN 1024
+#endif
+
 static uint32 tablesize;
 static int32 *hash_table;
 
@@ -177,6 +193,7 @@
 		int done_csum2 = 0;
 		uint32 hash_entry;
 		int32 i, *prev;
+		int32 chain_len = 0;
 
 		if (DEBUG_GTE(DELTASUM, 4)) {
 			rprintf(FINFO, "offset=%s sum=%04x%04x\n",
@@ -212,6 +229,14 @@
 
 			if (sum != s->sums[i].sum1)
 				continue;
+
+			/* Bound the work spent on a single pathological hash
+			 * bucket.  If this weak checksum matches more than
+			 * MAX_CHAIN_LEN records, stop scanning and treat this
+			 * offset as a non-match (issue #217).  The skipped data
+			 * is sent literally, never corrupted. */
+			if (++chain_len > MAX_CHAIN_LEN)
+				break;
 
 			/* also make sure the two blocks are the same length */
 			l = (int32)MIN((OFF_T)s->blength, len-offset);
--- /dev/null
+++ b/testsuite/hashsearch-chain.test
@@ -0,0 +1,91 @@
+#! /bin/sh
+
+# Regression test for CVE-2026-70453 / issue #217: hash_search() must not
+# blow up to O(N^2) when a weak (rolling) checksum collides on a very long
+# hash-table chain.
+#
+# A disk/VM image can contain a huge number of blocks that share the same
+# weak rolling checksum (e.g. long runs of identical bytes).  All such blocks
+# land on a single hash-table chain.  When the sender then rolls across a
+# region whose weak checksum keeps landing on that chain but never produces a
+# strong-checksum match, the inner loop of hash_search() used to walk the
+# *entire* chain for every single byte offset, pegging one CPU at 100% for
+# hours with no visible progress ("rsync hangs at 100% CPU").
+#
+# We reproduce a small, deterministic version of that pathology and count the
+# work directly.  rsync's `false_alarms` counter -- shown by
+# `--debug=deltasum1` -- is incremented once per strong-checksum comparison
+# that fails, i.e. exactly once per chain entry examined and rejected.  With
+# the per-offset cap in match.c the sender examines at most MAX_CHAIN_LEN
+# entries per hash hit, so false_alarms / hash_hits stays bounded no matter
+# how long the chain is; without the cap that ratio equals the full chain
+# length.  We assert the bound, which is the same integer on every machine.
+#
+# The fix is sender-only (it changes no checksum, byte, or protocol field), so
+# the transferred result must also still be byte-for-byte correct.
+
+. "$suitedir/rsync.fns"
+
+perl -e 'print "hi"' >/dev/null 2>&1 || test_skipped "perl is required for this test"
+
+BLOCK=256
+NBLOCKS=8000    # chain length -- much longer than match.c's cap (1024)
+RUN=3000        # length of the constant-byte region in the source
+C=100           # the constant source byte
+
+# A correct fix bounds the per-hash-hit chain walk to match.c's MAX_CHAIN_LEN
+# (1024).  Pick an assertion bound comfortably between that cap and the full
+# chain length so the test is insensitive to modest cap retuning but still
+# fails hard for the unbounded (pre-fix) walk of NBLOCKS per hit.
+MAX_FALSE_ALARMS_PER_HIT=`expr $NBLOCKS / 4`   # 2000: > cap(1024), << chain(8000)
+
+mkdir -p "$fromdir" "$todir"
+src="$fromdir/image.bin"
+dst="$todir/image.bin"
+
+# Basis: NBLOCKS identical decoy blocks -> one giant weak-checksum chain.
+# Each decoy is an all-C block whose first three bytes are perturbed by
+# (+1,-2,+1).  That perturbation leaves rsync's weak checksum (get_checksum1)
+# unchanged but changes the strong checksum, so every decoy shares one weak
+# checksum yet never strong-matches the source.
+# Source: a constant-byte run (constant weak checksum, no strong match).
+BLOCK=$BLOCK NBLOCKS=$NBLOCKS RUN=$RUN C=$C perl -e '
+    my $block = $ENV{BLOCK}; my $n = $ENV{NBLOCKS};
+    my $run = $ENV{RUN};     my $c = $ENV{C};
+    my $decoy = chr($c) x $block;
+    substr($decoy, 0, 3) = chr($c + 1) . chr($c - 2) . chr($c + 1);
+    open(my $d, ">", $ARGV[0]) or die "dst: $!";
+    binmode $d; print $d $decoy for (1 .. $n); close $d;
+    open(my $s, ">", $ARGV[1]) or die "src: $!";
+    binmode $s; print $s chr($c) x $run; close $s;
+' "$dst" "$src" || test_fail "could not build test images"
+
+out="$tmpdir/rsync.out"
+$RSYNC -a --no-whole-file --block-size=$BLOCK --no-compress \
+    --debug=deltasum1 "$src" "$dst" >"$out" 2>&1 \
+    || test_fail "rsync transfer failed: `cat "$out"`"
+
+stats=`grep -o 'hash_hits=[0-9]*  *false_alarms=[0-9]*' "$out" | tail -1`
+[ -n "$stats" ] || test_fail "could not find deltasum stats in rsync output: `cat "$out"`"
+
+hash_hits=`echo "$stats" | sed -e 's/.*hash_hits=\([0-9]*\).*/\1/'`
+false_alarms=`echo "$stats" | sed -e 's/.*false_alarms=\([0-9]*\).*/\1/'`
+
+[ "$hash_hits" -gt 0 ] 2>/dev/null \
+    || test_fail "expected the source to hit the decoy chain but hash_hits=$hash_hits"
+
+# ratio = false_alarms / hash_hits, must stay under the bound.
+ratio=`expr $false_alarms / $hash_hits`
+if [ "$ratio" -gt "$MAX_FALSE_ALARMS_PER_HIT" ]; then
+    test_fail "hash_search() walked ~$ratio chain entries per hash hit \
+(false_alarms=$false_alarms, hash_hits=$hash_hits); the chain of $NBLOCKS \
+entries is not being capped -- CVE-2026-70453 / issue #217 regression"
+fi
+
+# Correctness is non-negotiable: the cap only skips matches, never data.
+cmp "$src" "$dst" || test_fail "transferred file differs from source (data corruption)"
+
+echo "CVE-2026-70453: bounded at $ratio false alarms/hit (chain=$NBLOCKS, cap keeps it under $MAX_FALSE_ALARMS_PER_HIT)"
+
+# The script would have aborted on error, so getting here means we've won.
+exit 0
Description: CVE-2026-53803 - reject attacker-controlled symlinks on ancillary file writes
 rsync before 3.5.0 fails to reject symlinks during ancillary file writes
 (--log-file, --write-batch/--read-batch, and daemon-mode motd / early-input
 paths). A local attacker who can plant a symlink at a predictable output path
 (or a parent component) can redirect rsync's writes to overwrite arbitrary
 files (e.g. appending the log to /root/.ssh/authorized_keys), enabling local
 privilege escalation where rsync runs with elevated privileges. For
 --read-batch a planted symlink/FIFO/device can also feed chosen bytes to the
 protocol parser.
 .
 This backport routes the vulnerable opens through the
 open_no_attacker_symlinks() helper (a minimal backport of upstream's helper
 that walks the path component-by-component with fstatat(AT_SYMLINK_NOFOLLOW)
 + openat(O_NOFOLLOW), refusing to traverse any symlink not owned by uid 0 or
 the effective uid, while still following a trusted symlink) already added to
 syscall.c by the CVE-2026-53802 patch, which must be applied alongside this
 one: log.c logfile_open(), batch.c open_batch_files() (plus an S_ISREG guard
 rejecting a non-regular --read-batch file), and clientserver.c motd /
 early-input opens. The upstream v3.5.0 fix depends on a large new dirfd-stack
 resolver and an unrelated module-confinement framework that do not exist in
 3.2.3; only the CVE-relevant open() call sites are converted here, matching
 upstream semantics for these vectors without the rest of that framework.
 .
 A replacement regression test (testsuite/cve-2026-53803.test) is added because
 the upstream .py regression tests are not present in the 3.2.3 shell-based
 testsuite: it verifies the --read-batch non-regular-file rejection and (when
 run as root) that --log-file refuses an attacker-owned symlink.
Origin: backport, https://github.com/RsyncProject/rsync/commit/3eeedf8d08178ff2f354c09be64eb0f56fa8454f
Origin: backport, https://github.com/RsyncProject/rsync/commit/16048903011ba5dcb0cdb7215b41557cea8dae76
