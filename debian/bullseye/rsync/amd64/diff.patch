+/* Open a path that may transit attacker-controlled directory components
+ * (operator-supplied --exclude-from/--include-from/--filter merge files,
+ * per-directory .cvsignore-style merges, --files-from, the client
+ * --password-file, and the daemon "secrets file").  A privileged rsync must
+ * not be tricked into reading an arbitrary file because some component of the
+ * path -- the leaf OR any parent directory -- was replaced by a symlink owned
+ * by an untrusted user.
+ *
+ * We walk the path one component at a time with fstatat(AT_SYMLINK_NOFOLLOW)
+ * and openat(O_NOFOLLOW), refusing any symlink whose owner is neither uid 0
+ * nor our effective uid.  A symlink owned by a trusted uid (root or us) is
+ * followed by re-opening its resolved target with the same rules, so ordinary
+ * admin-managed symlinks keep working.  This is a narrower, self-contained
+ * backport of the upstream open_no_attacker_symlinks() confinement helper
+ * (rsync 3.5.0) that does not require the full fd-relative openat subsystem.
+ *
+ * On systems lacking openat()/O_NOFOLLOW this degrades to a plain open(). */
+int open_no_attacker_symlinks(const char *path, int flags, mode_t mode)
+{
+#if defined AT_FDCWD && defined O_NOFOLLOW
+	const uid_t trusted_uid = geteuid();
+	char remaining[MAXPATHLEN * 2];
+	int dfd = AT_FDCWD;
+	int dfd_owns = 0;
+	int loops = 40;		/* cap symlink-follow chains (SYMLOOP_MAX-ish) */
+	int retfd = -1;
+	int saved_errno = 0;
+
+	if (!path || !*path) {
+		errno = ENOENT;
+		return -1;
+	}
+	if (strlcpy(remaining, path, sizeof remaining) >= sizeof remaining) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+
+	/* Absolute path: pin "/" as the starting dfd. */
+	if (remaining[0] == '/') {
+		dfd = open("/", O_RDONLY | O_DIRECTORY
+#ifdef O_CLOEXEC
+			   | O_CLOEXEC
+#endif
+			   );
+		if (dfd < 0)
+			return -1;
+		dfd_owns = 1;
+		char *s = remaining;
+		while (*s == '/') s++;
+		memmove(remaining, s, strlen(s) + 1);
+	}
+
+	while (*remaining) {
+		char *slash = strchr(remaining, '/');
+		size_t comp_len = slash ? (size_t)(slash - remaining) : strlen(remaining);
+		char comp[MAXPATHLEN];
+		int is_last;
+		STRUCT_STAT lst;
+
+		if (comp_len == 0) {
+			/* collapse an empty component ("//") */
+			memmove(remaining, remaining + 1, strlen(remaining + 1) + 1);
+			continue;
+		}
+		if (comp_len >= sizeof comp) {
+			saved_errno = ENAMETOOLONG;
+			goto out;
+		}
+		memcpy(comp, remaining, comp_len);
+		comp[comp_len] = '\0';
+		is_last = (slash == NULL);
+
+		if (fstatat(dfd, comp, &lst, AT_SYMLINK_NOFOLLOW) < 0) {
+			/* Leaf may legitimately not exist yet (O_CREAT). */
+			if (is_last && errno == ENOENT && (flags & O_CREAT)) {
+				retfd = openat(dfd, comp, flags | O_NOFOLLOW, mode);
+				saved_errno = errno;
+				goto out;
+			}
+			saved_errno = errno;
+			goto out;
+		}
+
+		if (S_ISLNK(lst.st_mode)) {
+			char target[MAXPATHLEN];
+			char tail[MAXPATHLEN];
+			char rebuilt[MAXPATHLEN * 2];
+			ssize_t n;
+
+			/* Refuse a symlink owned by an untrusted user. */
+			if (lst.st_uid != 0 && lst.st_uid != trusted_uid) {
+				saved_errno = ELOOP;
+				goto out;
+			}
+			if (--loops < 0) {
+				saved_errno = ELOOP;
+				goto out;
+			}
+			n = readlinkat(dfd, comp, target, sizeof target - 1);
+			if (n < 0) {
+				saved_errno = errno;
+				goto out;
+			}
+			target[n] = '\0';
+
+			tail[0] = '\0';
+			if (slash)
+				strlcpy(tail, slash, sizeof tail);
+			if ((size_t)snprintf(rebuilt, sizeof rebuilt, "%s%s",
+					     target, tail) >= sizeof rebuilt) {
+				saved_errno = ENAMETOOLONG;
+				goto out;
+			}
+
+			if (target[0] == '/') {
+				int rootfd = open("/", O_RDONLY | O_DIRECTORY
+#ifdef O_CLOEXEC
+						  | O_CLOEXEC
+#endif
+						  );
+				if (rootfd < 0) {
+					saved_errno = errno;
+					goto out;
+				}
+				if (dfd_owns)
+					close(dfd);
+				dfd = rootfd;
+				dfd_owns = 1;
+				{
+					char *s = rebuilt;
+					while (*s == '/') s++;
+					strlcpy(remaining, s, sizeof remaining);
+				}
+			} else
+				strlcpy(remaining, rebuilt, sizeof remaining);
+			continue;
+		}
+
+		if (is_last) {
+			retfd = openat(dfd, comp, flags | O_NOFOLLOW, mode);
+			saved_errno = errno;
+			goto out;
+		}
+
+		if (!S_ISDIR(lst.st_mode)) {
+			saved_errno = ENOTDIR;
+			goto out;
+		}
+		{
+			int next = openat(dfd, comp, O_RDONLY | O_DIRECTORY | O_NOFOLLOW
+#ifdef O_CLOEXEC
+					  | O_CLOEXEC
+#endif
+					  );
+			if (next < 0) {
+				saved_errno = errno;
+				goto out;
+			}
+			if (dfd_owns)
+				close(dfd);
+			dfd = next;
+			dfd_owns = 1;
+		}
+
+		{
+			char *s = slash;
+			while (*s == '/') s++;
+			memmove(remaining, s, strlen(s) + 1);
+		}
+	}
+
+	/* Path resolved entirely to a directory with no leaf left. */
+	saved_errno = (flags & O_DIRECTORY) ? 0 : EISDIR;
+	if ((flags & O_DIRECTORY) && dfd_owns) {
+		retfd = dfd;
+		dfd_owns = 0;
+	}
+
+out:
+	if (dfd_owns)
+		close(dfd);
+	errno = saved_errno;
+	return retfd;
+#else
+	/* Pre-openat / no-O_NOFOLLOW systems: best-effort fallback. */
+	return open(path, flags, mode);
+#endif
