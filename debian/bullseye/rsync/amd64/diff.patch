+			/* An untrusted-owner symlink is the attack; refuse it. */
+			if (lst.st_uid != 0 && lst.st_uid != trusted_uid) {
+				close(dfd);
+				errno = ELOOP;
+				return -1;
+			}
+			if (--loops < 0) { /* break symlink cycles */
+				close(dfd);
+				errno = ELOOP;
+				return -1;
+			}
+			n = readlinkat(dfd, comp, target, sizeof target - 1);
+			if (n < 0) {
+				save_errno = errno;
+				close(dfd);
+				errno = save_errno;
+				return -1;
+			}
+			target[n] = '\0';
+			tail[0] = '\0';
+			if (slash)
