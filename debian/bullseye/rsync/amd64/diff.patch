@@ -0,0 +1,112 @@
+#!/bin/sh
+
+# Regression test for CVE-2026-53802 (symlink following in operator-supplied
+# input file paths).  Backport of the upstream v3.5.0 regression tests
+# excludefrom-symlink_test.py / files-from-leak_test.py, rewritten for this
+# tree's shell-based test harness (the pytest harness those tests use does not
+# exist in 3.2.3).
+#
+# Threat: a privileged rsync opens an operator-supplied path
+# (--exclude-from / --files-from / --filter merge file / --password-file /
+# daemon secrets file) whose leaf -- OR a parent directory component -- has
+# been replaced by a symlink owned by an untrusted (attacker) user.  Before
+# the fix rsync follows the planted symlink and reads its target as filter
+# rules / a file list, silently shaping the transfer or leaking file content.
+# After the fix open_no_attacker_symlinks() refuses any symlink not owned by
+# uid 0 or our effective uid, at every path component, so the open fails.
+#
+# This test must plant a symlink owned by a *different* uid to simulate the
+# attacker, which requires root; it skips otherwise.
+
+. "$suitedir/rsync.fns"
+
+if test x"`id -u`" != x0; then
+    test_skipped "must be root to plant a symlink owned by a non-self uid (the attacker simulation)"
+fi
+
+# Find an untrusted uid to own the planted symlinks (not root, not us).
+UNTRUSTED_UID=''
+for name in nobody nfsnobody daemon bin; do
+    u=`id -u "$name" 2>/dev/null`
+    if test -n "$u" && test x"$u" != x0; then
+	UNTRUSTED_UID="$u"
+	break
+    fi
+done
+if test -z "$UNTRUSTED_UID"; then
+    test_skipped "no untrusted-uid user available for the cross-uid symlink plant"
+fi
+
+base="$scratchdir/cve"
+src="$base/src"
+dest="$base/dest"
+outside="$base/outside"
+plants="$base/plants"
+
+rm -rf "$base"
+mkdir -p "$src" "$dest" "$outside" "$plants"
+
+# A canary we expect to be transferred unless a leaked exclude rule drops it.
+echo "would-be-transferred" >"$src/canary_file"
+echo "noise" >"$src/other_file"
+
+# Attacker-readable content: a filter/exclude pattern that matches the canary.
+echo "canary_file" >"$outside/exclude_list"
+
+# ---------------------------------------------------------------------------
+# 1. --exclude-from, LEAF plant: the exclude-from path itself is a symlink
+#    owned by the attacker pointing at attacker-controlled rules.
+# ---------------------------------------------------------------------------
+leaf_plant="$plants/exclude_leaf"
+ln -s "$outside/exclude_list" "$leaf_plant"
+lchown "$UNTRUSTED_UID" "$leaf_plant" 2>/dev/null || chown -h "$UNTRUSTED_UID" "$leaf_plant"
+
+rm -rf "$dest"; mkdir -p "$dest"
+$RSYNC -a --exclude-from="$leaf_plant" "$src/" "$dest/" 2>/dev/null
+rc=$?
+if test $rc = 0 && test ! -f "$dest/canary_file"; then
+    test_fail "--exclude-from followed a planted LEAF symlink owned by uid $UNTRUSTED_UID: rsync read the symlink target as filter rules and dropped src/canary_file. CVE-2026-53802 not fixed."
+fi
+
+# ---------------------------------------------------------------------------
+# 2. --exclude-from, PARENT-component plant: an intermediate directory of the
+#    path is an attacker-owned symlink.  Plain O_NOFOLLOW on the leaf does NOT
+#    defend against this; the fix walks every component.
+# ---------------------------------------------------------------------------
+real_target="$plants/parent_real_target"
+mkdir -p "$real_target"
+echo "canary_file" >"$real_target/exclude_list"
+parent_plant="$plants/parent_link"
+ln -s "$real_target" "$parent_plant"
+lchown "$UNTRUSTED_UID" "$parent_plant" 2>/dev/null || chown -h "$UNTRUSTED_UID" "$parent_plant"
+
+rm -rf "$dest"; mkdir -p "$dest"
+$RSYNC -a --exclude-from="$parent_plant/exclude_list" "$src/" "$dest/" 2>/dev/null
+rc=$?
+if test $rc = 0 && test ! -f "$dest/canary_file"; then
+    test_fail "--exclude-from followed a planted PARENT-component symlink ($parent_plant -> $real_target) owned by uid $UNTRUSTED_UID: the leaked exclude_list dropped canary_file. CVE-2026-53802 not fixed."
+fi
+
+# ---------------------------------------------------------------------------
+# 3. --files-from, LEAF plant: the file list is a symlink owned by the
+#    attacker.  With the leak rsync reads the planted list; the fix refuses
+#    the open and exits non-zero.
+# ---------------------------------------------------------------------------
+echo "other_file" >"$outside/file_list"
+ff_plant="$plants/filesfrom_leaf"
+ln -s "$outside/file_list" "$ff_plant"
+lchown "$UNTRUSTED_UID" "$ff_plant" 2>/dev/null || chown -h "$UNTRUSTED_UID" "$ff_plant"
+
+rm -rf "$dest"; mkdir -p "$dest"
+$RSYNC -a --files-from="$ff_plant" "$src/" "$dest/" 2>/dev/null
+rc=$?
+# The honest failure mode with the fix is a non-zero exit (open refused).
+# A leak would exit 0 having transferred exactly the attacker-listed file
+# (other_file) while never having been told to.  Detect that combination.
+if test $rc = 0 && test -f "$dest/other_file" && test ! -f "$dest/canary_file"; then
+    test_fail "--files-from followed a planted LEAF symlink owned by uid $UNTRUSTED_UID: rsync used the attacker's file list. CVE-2026-53802 not fixed."
+fi
+
+# The script aborts (via test_fail) on any detected leak, so reaching here
+# means the planted symlinks were refused: the fix is in place.
+exit 0
