@@ -0,0 +1,128 @@
+#!/bin/sh
+
+# Copyright (C) 2026 by Andrew Tridgell
+
+# This program is distributable under the terms of the GNU GPL (see
+# COPYING).
+
+# Regression test for CVE-2026-53791: the off-by-one stack OOB write in
+# establish_proxy_connection() in socket.c when a malicious or
+# man-in-the-middle HTTP proxy returns a first response line of
+# 1023+ bytes without a '\n' terminator.
+#
+# Pre-fix: the read loop walked buffer[0..sizeof-2] one byte at a
+# time, then post-loop logic did "if (*cp != '\n') cp++; *cp-- =
+# '\0';".  If no newline arrived before the loop filled the buffer,
+# cp was left at &buffer[sizeof-1] (never written by the loop),
+# *cp held stale stack bytes, and cp++ pushed cp one past the array.
+# The null-termination then wrote one byte out of bounds on the
+# stack.  AddressSanitizer reports stack-buffer-overflow at the
+# null-termination site.
+#
+# Post-fix: the bound-exhaustion case is detected by position and
+# rejected with a "proxy response line too long" message, so no
+# OOB write occurs and rsync exits with a non-signal status.
+
+. "$suitedir/rsync.fns"
+
+command -v python3 >/dev/null 2>&1 || test_skipped "python3 not available"
+
+workdir="$scratchdir/workdir"
+mkdir -p "$workdir"
+cd "$workdir"
+
+port_file="$workdir/port"
+proxy_log="$workdir/proxy.log"
+
+# A minimal TCP listener: binds to an ephemeral port on 127.0.0.1,
+# writes the chosen port to $port_file *before* accept() so the test
+# can synchronise without a sleep, accepts one connection, reads
+# until end-of-headers or 64 KiB, sends exactly 1023 bytes of 'X'
+# with no '\n', then closes.
+python3 - "$port_file" >"$proxy_log" 2>&1 <<'PYEOF' &
+import socket, sys, os
+port_file = sys.argv[1]
+s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+s.bind(("127.0.0.1", 0))
+port = s.getsockname()[1]
+tmp = port_file + ".tmp"
+with open(tmp, "w") as fp:
+    fp.write("%d\n" % port)
+os.rename(tmp, port_file)   # atomic visibility to the shell side
+s.listen(1)
+conn, _ = s.accept()
+conn.settimeout(5)
+try:
+    data = b""
+    while b"\r\n\r\n" not in data and len(data) < 65536:
+        chunk = conn.recv(8192)
+        if not chunk:
+            break
+        data += chunk
+except socket.timeout:
+    pass
+conn.sendall(b"X" * 1023)    # exactly the buffer-1 trigger size
+try:
+    conn.shutdown(socket.SHUT_RDWR)
+except OSError:
+    pass
+conn.close()
+s.close()
+PYEOF
+proxy_pid=$!
+
+# Wait up to ~10s for the listener to publish its port.
+i=0
+while [ ! -s "$port_file" ] && [ $i -lt 10 ]; do
+    sleep 1
+    i=$((i + 1))
+done
+
+if [ ! -s "$port_file" ]; then
+    kill "$proxy_pid" 2>/dev/null
+    cat "$proxy_log" >&2 2>/dev/null
+    test_fail "proxy listener never published a port"
+fi
+
+port=`cat "$port_file"`
+case "$port" in
+    *[!0-9]*|"") kill "$proxy_pid" 2>/dev/null; test_fail "bogus port from listener: '$port'" ;;
+esac
+
+# Run rsync through the malicious proxy.  Any rsync:// URL works:
+# the proxy intercepts the CONNECT and never forwards anywhere.
+rsync_err="$workdir/rsync.err"
+
+# rsync MUST exit non-zero here (the proxy is misbehaving).
+# Use `|| status=$?` so we capture the real exit code under `sh -e`;
+# `if ! cmd; then status=$?` would only ever see 0 because the `!`
+# is the last command before `$?`.
+status=0
+RSYNC_PROXY="127.0.0.1:$port" \
+    $RSYNC rsync://example.invalid:873/whatever/ "$workdir/out/" \
+    >/dev/null 2>"$rsync_err" || status=$?
+
+# Reap the listener.
+wait "$proxy_pid" 2>/dev/null || true
+
+# 1. rsync must not have crashed (SIGSEGV/SIGABRT report >= 128).
+if [ "$status" -ge 128 ]; then
+    cat "$rsync_err" >&2
+    test_fail "rsync killed by signal (status=$status) -- possible stack OOB regression"
+fi
+
+# 2. rsync must have actually exited non-zero (i.e. saw the bad proxy).
+if [ "$status" -eq 0 ]; then
+    cat "$rsync_err" >&2
+    test_fail "rsync returned success despite malformed proxy response"
+fi
+
+# 3. The new error message must appear.
+if ! grep -q "proxy response line too long" "$rsync_err"; then
+    cat "$rsync_err" >&2
+    test_fail "expected 'proxy response line too long' in rsync stderr"
+fi
+
+echo "OK: over-long proxy response line rejected cleanly without crashing"
+exit 0
Description: CVE-2026-53802 - refuse attacker-planted symlinks in operator-supplied input file paths
 rsync before 3.5.0 followed attacker-planted symlinks in operator-supplied
 input file paths -- --filter merge files (including per-directory merges and
 -C .cvsignore), --files-from/--include-from/--exclude-from, the client
 --password-file, and the daemon "secrets file".  A local user who controls a
 path component (or, for the daemon files-from variant, a remote client) can
 plant a symlink so a privileged rsync reads an arbitrary file, either silently
 shaping the transfer (disclosed under verbose/debug) or leaking the target
 file's content as the daemon/client authentication response.
 .
 This is a targeted backport of the upstream v3.5.0 hardening series
 (commits 3eeedf8d, d199b431, defd7110). Rather than porting the full
 fd-relative openat confinement subsystem -- which does not exist in 3.2.3 --
 it adds a self-contained open_no_attacker_symlinks() helper in syscall.c that
 walks the path one component at a time with fstatat(AT_SYMLINK_NOFOLLOW) and
 openat(O_NOFOLLOW), refusing any symlink (leaf or parent component) whose owner
 is neither uid 0 nor our effective uid, and follows trusted-owner symlinks.
 The vulnerable opens are routed through this helper:
 exclude.c parse_filter_file() (plus a MAX_MERGE_DEPTH recursion cap),
 authenticate.c check_secret()/getpassf() (fstat'ing the opened fd), and
 options.c --files-from. A backported shell regression test is added.
Origin: upstream, https://github.com/RsyncProject/rsync/commit/3eeedf8d08178ff2f354c09be64eb0f56fa8454f
Origin: upstream, https://github.com/RsyncProject/rsync/commit/d199b43149ef8850382e72d6145a5826db216f66
Origin: upstream, https://github.com/RsyncProject/rsync/commit/defd7110ac9bd60529b3d39cfd5cafe8cc5716de
Bug: https://github.com/RsyncProject/rsync/security/advisories/GHSA-4mfr-8jrv-49x4
Author: Patch Platoon <security@rootio>
Last-Update: 2026-08-14
---
--- a/syscall.c
+++ b/syscall.c
@@ -652,3 +652,192 @@
 
 	return fd;
 }
+
+/* Open a path that may transit attacker-controlled directory components
+ * (operator-supplied --exclude-from/--include-from/--filter merge files,
+ * per-directory .cvsignore-style merges, --files-from, the client
+ * --password-file, and the daemon "secrets file").  A privileged rsync must
+ * not be tricked into reading an arbitrary file because some component of the
+ * path -- the leaf OR any parent directory -- was replaced by a symlink owned
+ * by an untrusted user.
+ *
+ * We walk the path one component at a time with fstatat(AT_SYMLINK_NOFOLLOW)
+ * and openat(O_NOFOLLOW), refusing any symlink whose owner is neither uid 0
+ * nor our effective uid.  A symlink owned by a trusted uid (root or us) is
+ * followed by re-opening its resolved target with the same rules, so ordinary
+ * admin-managed symlinks keep working.  This is a narrower, self-contained
+ * backport of the upstream open_no_attacker_symlinks() confinement helper
+ * (rsync 3.5.0) that does not require the full fd-relative openat subsystem.
+ *
+ * On systems lacking openat()/O_NOFOLLOW this degrades to a plain open(). */
+int open_no_attacker_symlinks(const char *path, int flags, mode_t mode)
+{
+#if defined AT_FDCWD && defined O_NOFOLLOW
+	const uid_t trusted_uid = geteuid();
+	char remaining[MAXPATHLEN * 2];
+	int dfd = AT_FDCWD;
+	int dfd_owns = 0;
+	int loops = 40;		/* cap symlink-follow chains (SYMLOOP_MAX-ish) */
+	int retfd = -1;
+	int saved_errno = 0;
+
+	if (!path || !*path) {
+		errno = ENOENT;
+		return -1;
+	}
+	if (strlcpy(remaining, path, sizeof remaining) >= sizeof remaining) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+
+	/* Absolute path: pin "/" as the starting dfd. */
+	if (remaining[0] == '/') {
+		dfd = open("/", O_RDONLY | O_DIRECTORY
+#ifdef O_CLOEXEC
+			   | O_CLOEXEC
+#endif
+			   );
+		if (dfd < 0)
+			return -1;
+		dfd_owns = 1;
+		char *s = remaining;
+		while (*s == '/') s++;
+		memmove(remaining, s, strlen(s) + 1);
+	}
+
+	while (*remaining) {
+		char *slash = strchr(remaining, '/');
+		size_t comp_len = slash ? (size_t)(slash - remaining) : strlen(remaining);
+		char comp[MAXPATHLEN];
+		int is_last;
+		STRUCT_STAT lst;
+
+		if (comp_len == 0) {
+			/* collapse an empty component ("//") */
+			memmove(remaining, remaining + 1, strlen(remaining + 1) + 1);
+			continue;
+		}
+		if (comp_len >= sizeof comp) {
+			saved_errno = ENAMETOOLONG;
+			goto out;
+		}
+		memcpy(comp, remaining, comp_len);
+		comp[comp_len] = '\0';
+		is_last = (slash == NULL);
+
+		if (fstatat(dfd, comp, &lst, AT_SYMLINK_NOFOLLOW) < 0) {
