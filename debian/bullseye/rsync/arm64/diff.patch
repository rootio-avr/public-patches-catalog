--- a/match.c
+++ b/match.c
@@ -42,6 +42,22 @@
 
 #define TRADITIONAL_TABLESIZE (1<<16)
 
+/* The maximum number of same-weak-checksum candidates we will compare
+ * against at a single file offset before giving up and rolling forward a
+ * byte.  A weak checksum that collides thousands of times (very common in
+ * disk/VM images, which contain large runs of identical blocks) would
+ * otherwise turn hash_search()'s inner loop into an O(file_size *
+ * chain_length) scan, pegging a CPU at 100% for hours with no apparent
+ * progress (issue #217).  Capping the per-offset work keeps the search
+ * bounded; any block we skip over is simply sent as literal data, so the
+ * result is always correct -- only the transfer size is (slightly) affected.
+ * This is purely a sender-side search limit: it changes no checksum, emitted
+ * byte, or protocol field, so a capped sender interoperates with any
+ * receiver. */
+#ifndef MAX_CHAIN_LEN
+#define MAX_CHAIN_LEN 1024
+#endif
+
 static uint32 tablesize;
 static int32 *hash_table;
 
@@ -177,6 +193,7 @@
 		int done_csum2 = 0;
 		uint32 hash_entry;
 		int32 i, *prev;
+		int32 chain_len = 0;
 
 		if (DEBUG_GTE(DELTASUM, 4)) {
 			rprintf(FINFO, "offset=%s sum=%04x%04x\n",
@@ -212,6 +229,14 @@
 
 			if (sum != s->sums[i].sum1)
 				continue;
+
+			/* Bound the work spent on a single pathological hash
+			 * bucket.  If this weak checksum matches more than
+			 * MAX_CHAIN_LEN records, stop scanning and treat this
+			 * offset as a non-match (issue #217).  The skipped data
+			 * is sent literally, never corrupted. */
+			if (++chain_len > MAX_CHAIN_LEN)
+				break;
 
 			/* also make sure the two blocks are the same length */
 			l = (int32)MIN((OFF_T)s->blength, len-offset);
--- /dev/null
+++ b/testsuite/hashsearch-chain.test
@@ -0,0 +1,91 @@
+#! /bin/sh
+
+# Regression test for CVE-2026-70453 / issue #217: hash_search() must not
+# blow up to O(N^2) when a weak (rolling) checksum collides on a very long
+# hash-table chain.
+#
+# A disk/VM image can contain a huge number of blocks that share the same
+# weak rolling checksum (e.g. long runs of identical bytes).  All such blocks
+# land on a single hash-table chain.  When the sender then rolls across a
+# region whose weak checksum keeps landing on that chain but never produces a
+# strong-checksum match, the inner loop of hash_search() used to walk the
+# *entire* chain for every single byte offset, pegging one CPU at 100% for
+# hours with no visible progress ("rsync hangs at 100% CPU").
+#
+# We reproduce a small, deterministic version of that pathology and count the
+# work directly.  rsync's `false_alarms` counter -- shown by
+# `--debug=deltasum1` -- is incremented once per strong-checksum comparison
+# that fails, i.e. exactly once per chain entry examined and rejected.  With
+# the per-offset cap in match.c the sender examines at most MAX_CHAIN_LEN
+# entries per hash hit, so false_alarms / hash_hits stays bounded no matter
+# how long the chain is; without the cap that ratio equals the full chain
+# length.  We assert the bound, which is the same integer on every machine.
+#
+# The fix is sender-only (it changes no checksum, byte, or protocol field), so
+# the transferred result must also still be byte-for-byte correct.
+
+. "$suitedir/rsync.fns"
+
+perl -e 'print "hi"' >/dev/null 2>&1 || test_skipped "perl is required for this test"
+
+BLOCK=256
+NBLOCKS=8000    # chain length -- much longer than match.c's cap (1024)
+RUN=3000        # length of the constant-byte region in the source
+C=100           # the constant source byte
+
+# A correct fix bounds the per-hash-hit chain walk to match.c's MAX_CHAIN_LEN
+# (1024).  Pick an assertion bound comfortably between that cap and the full
+# chain length so the test is insensitive to modest cap retuning but still
+# fails hard for the unbounded (pre-fix) walk of NBLOCKS per hit.
+MAX_FALSE_ALARMS_PER_HIT=`expr $NBLOCKS / 4`   # 2000: > cap(1024), << chain(8000)
+
+mkdir -p "$fromdir" "$todir"
+src="$fromdir/image.bin"
+dst="$todir/image.bin"
+
+# Basis: NBLOCKS identical decoy blocks -> one giant weak-checksum chain.
+# Each decoy is an all-C block whose first three bytes are perturbed by
+# (+1,-2,+1).  That perturbation leaves rsync's weak checksum (get_checksum1)
+# unchanged but changes the strong checksum, so every decoy shares one weak
+# checksum yet never strong-matches the source.
+# Source: a constant-byte run (constant weak checksum, no strong match).
+BLOCK=$BLOCK NBLOCKS=$NBLOCKS RUN=$RUN C=$C perl -e '
+    my $block = $ENV{BLOCK}; my $n = $ENV{NBLOCKS};
+    my $run = $ENV{RUN};     my $c = $ENV{C};
+    my $decoy = chr($c) x $block;
+    substr($decoy, 0, 3) = chr($c + 1) . chr($c - 2) . chr($c + 1);
+    open(my $d, ">", $ARGV[0]) or die "dst: $!";
+    binmode $d; print $d $decoy for (1 .. $n); close $d;
+    open(my $s, ">", $ARGV[1]) or die "src: $!";
+    binmode $s; print $s chr($c) x $run; close $s;
+' "$dst" "$src" || test_fail "could not build test images"
+
+out="$tmpdir/rsync.out"
+$RSYNC -a --no-whole-file --block-size=$BLOCK --no-compress \
+    --debug=deltasum1 "$src" "$dst" >"$out" 2>&1 \
+    || test_fail "rsync transfer failed: `cat "$out"`"
+
+stats=`grep -o 'hash_hits=[0-9]*  *false_alarms=[0-9]*' "$out" | tail -1`
+[ -n "$stats" ] || test_fail "could not find deltasum stats in rsync output: `cat "$out"`"
+
+hash_hits=`echo "$stats" | sed -e 's/.*hash_hits=\([0-9]*\).*/\1/'`
+false_alarms=`echo "$stats" | sed -e 's/.*false_alarms=\([0-9]*\).*/\1/'`
+
+[ "$hash_hits" -gt 0 ] 2>/dev/null \
+    || test_fail "expected the source to hit the decoy chain but hash_hits=$hash_hits"
+
+# ratio = false_alarms / hash_hits, must stay under the bound.
+ratio=`expr $false_alarms / $hash_hits`
+if [ "$ratio" -gt "$MAX_FALSE_ALARMS_PER_HIT" ]; then
+    test_fail "hash_search() walked ~$ratio chain entries per hash hit \
+(false_alarms=$false_alarms, hash_hits=$hash_hits); the chain of $NBLOCKS \
+entries is not being capped -- CVE-2026-70453 / issue #217 regression"
+fi
+
+# Correctness is non-negotiable: the cap only skips matches, never data.
+cmp "$src" "$dst" || test_fail "transferred file differs from source (data corruption)"
+
+echo "CVE-2026-70453: bounded at $ratio false alarms/hit (chain=$NBLOCKS, cap keeps it under $MAX_FALSE_ALARMS_PER_HIT)"
+
+# The script would have aborted on error, so getting here means we've won.
+exit 0
Description: CVE-2026-53784 - confine the daemon module-root chdir to the served module
 A daemon module configured with "use chroot = no" changes directory into the
 operator-configured module path (module_chdir) with a plain chdir() that
 follows symlinks at every path component. If any component of that path is a
 symlink planted by an untrusted local user (for example an admin path such as
 /home/$user/share, or any /srv-style path under a non-root-owned parent), the
 planted symlink redirects the daemon's CWD out of the configured module
 before any transfer begins, letting a client read from and write to files
 outside the served module (a symlink-race / TOCTOU module escape).
 .
 The upstream fix (defd7110) relies on a large dirfd-stack secure-resolver
 subsystem (util1.c, the *_atfd wrappers, owner_walk_parent,
 secure_relative_open, PID_* macros) that does not exist in the 3.2.3 target
 tree. This is a scoped, target-native equivalent: for a non-chrooted daemon
 module the absolute module path is resolved one component at a time, refusing
 any symlink component not owned by uid 0 or our euid (the trusted operator
 identity) and descending with O_NOFOLLOW so a component cannot be swapped for
 a symlink between the ownership check and the descent, then the daemon
 fchdir()s into the safely-resolved directory. A symlink owned by a trusted
 uid is still followed, so legitimate operator-created links keep working. A
 chrooted module is left on its existing chdir path because chroot() has
 already confined its outer path.
 .
 A regression test (testsuite/daemon-module-chdir-symlink.test) is added,
 translating the upstream daemon-module-chdir-symlink threat model into the
 project's shell test idiom.
Origin: backport, https://github.com/RsyncProject/rsync/commit/defd7110ac9bd60529b3d39cfd5cafe8cc5716de
Author: Patch Platoon <security@example.com>
Last-Update: 2026-08-14
---
--- a/clientserver.c
+++ b/clientserver.c
@@ -618,6 +618,143 @@ static struct passwd *want_all_groups(int f_out, uid_t uid)
 }
 #endif
 
+#if defined AT_FDCWD && defined O_NOFOLLOW && defined O_DIRECTORY
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+/* CVE-2026-53784: When a daemon module is configured with "use chroot = no",
+ * the daemon chdir()s into the operator-configured module path (module_chdir)
+ * with a plain chdir() that follows symlinks at every path component.  If any
+ * component of that path is a symlink planted by an untrusted local user (for
+ * example an admin path such as /home/$user/share, or any /srv-style path
+ * under a non-root-owned parent), the planted symlink redirects the daemon's
+ * CWD out of the configured module before any transfer begins, letting the
+ * client read from and write to files outside the served module.
+ *
+ * Resolve the absolute module path one component at a time, refusing any
+ * symlink component that is NOT owned by uid 0 or our euid (the trusted
+ * operator identity), and descending with O_NOFOLLOW so a component cannot be
+ * swapped for a symlink between the ownership check and the descent (the
+ * TOCTOU race).  A symlink owned by a trusted uid is followed, so legitimate
+ * operator-created links (e.g. /var/run -> /run) keep working.  Returns an
+ * open O_DIRECTORY fd on the safely-resolved module root (the caller fchdir()s
+ * into it and closes it), or -1 with errno set on refusal or error. */
+static int daemon_secure_module_dirfd(const char *path)
+{
+	const uid_t trusted_uid = geteuid();
+	char remaining[MAXPATHLEN * 2];
+	char *p;
+	int dfd, loops = 40;
+
+	if (!path || *path != '/') {
+		errno = EINVAL;
+		return -1;
+	}
+	if (strlcpy(remaining, path, sizeof remaining) >= sizeof remaining) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	if ((dfd = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC)) < 0)
+		return -1;
+
+	for (p = remaining; *p == '/'; p++) {}
+	memmove(remaining, p, strlen(p) + 1);
+
+	while (*remaining) {
+		char *slash = strchr(remaining, '/');
+		size_t comp_len = slash ? (size_t)(slash - remaining) : strlen(remaining);
+		char comp[MAXPATHLEN];
+		STRUCT_STAT lst;
+		int next, save_errno;
+
+		if (comp_len == 0) { /* collapse repeated slashes */
+			memmove(remaining, remaining + 1, strlen(remaining));
+			continue;
+		}
+		if (comp_len >= sizeof comp) {
+			close(dfd);
+			errno = ENAMETOOLONG;
+			return -1;
+		}
+		memcpy(comp, remaining, comp_len);
+		comp[comp_len] = '\0';
+
+		if (fstatat(dfd, comp, &lst, AT_SYMLINK_NOFOLLOW) < 0) {
+			save_errno = errno;
+			close(dfd);
+			errno = save_errno;
+			return -1;
+		}
+
+		if (S_ISLNK(lst.st_mode)) {
+			char target[MAXPATHLEN], rebuilt[MAXPATHLEN * 2], tail[MAXPATHLEN];
+			ssize_t n;
+
+			/* An untrusted-owner symlink is the attack; refuse it. */
+			if (lst.st_uid != 0 && lst.st_uid != trusted_uid) {
+				close(dfd);
+				errno = ELOOP;
+				return -1;
+			}
+			if (--loops < 0) { /* break symlink cycles */
+				close(dfd);
+				errno = ELOOP;
+				return -1;
+			}
+			n = readlinkat(dfd, comp, target, sizeof target - 1);
+			if (n < 0) {
+				save_errno = errno;
+				close(dfd);
+				errno = save_errno;
+				return -1;
+			}
+			target[n] = '\0';
+			tail[0] = '\0';
+			if (slash)
+				strlcpy(tail, slash, sizeof tail);
+			if ((size_t)snprintf(rebuilt, sizeof rebuilt, "%s%s", target, tail) >= sizeof rebuilt) {
+				close(dfd);
+				errno = ENAMETOOLONG;
+				return -1;
+			}
+			if (target[0] == '/') { /* absolute target: restart from "/" */
+				close(dfd);
+				if ((dfd = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC)) < 0)
+					return -1;
+				for (p = rebuilt; *p == '/'; p++) {}
+				strlcpy(remaining, p, sizeof remaining);
+			} else
+				strlcpy(remaining, rebuilt, sizeof remaining);
+			continue;
+		}
+
+		if (!S_ISDIR(lst.st_mode)) {
+			close(dfd);
+			errno = ENOTDIR;
+			return -1;
+		}
+
+		next = openat(dfd, comp, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		if (next < 0) {
+			save_errno = errno;
+			close(dfd);
+			errno = save_errno;
+			return -1;
+		}
+		close(dfd);
+		dfd = next;
+
+		if (slash) {
+			for (p = slash; *p == '/'; p++) {}
+			memmove(remaining, p, strlen(p) + 1);
+		} else
+			remaining[0] = '\0';
+	}
+
+	return dfd; /* fd on the safely-resolved module root */
+}
