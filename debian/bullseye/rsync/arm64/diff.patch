+#!/bin/sh
+# Regression test for CVE-2026-53790 (CWE-78 command/argument injection via
+# unsanitized hostnames). Grounded in the synthesized fix: validates the
+# self-contained hardening primitives without building or running rsync.
+#
+# Checks:
+#   1. socket.c contains the host validation + single-quote primitives applied
+#      to the RSYNC_CONNECT_PROG %H expansion (the primary injection sink).
+#   2. socket.c rejects control bytes in the proxy CONNECT host.
+#   3. main.c refuses a remote-shell hostname beginning with '-'.
+#
+# rsync-ssl's own hostspec validation is covered by the CVE-2026-70454
+# regression test (testsuite/rsync-ssl-cert-validation.test), since that
+# patch is what adds validate_ssl_hostname() to rsync-ssl.
+
+set -e
+srcdir="${srcdir:-.}"
+fail=0
+
+# --- 1. socket.c RSYNC_CONNECT_PROG %H hardening ---------------------------
+if ! grep -q 'shell_unsafe_connect_host' "$srcdir/socket.c"; then
+    echo "FAIL: socket.c missing shell_unsafe_connect_host() guard"
+    fail=1
+fi
+if ! grep -q 'shell_quote_connect_host' "$srcdir/socket.c"; then
+    echo "FAIL: socket.c missing shell_quote_connect_host() quoting"
+    fail=1
+fi
+# The %H expansion must copy the *quoted* host, not the raw host.
+if ! grep -q 'memcpy(t, qhost, hlen)' "$srcdir/socket.c"; then
+    echo "FAIL: socket.c %H expansion still uses unquoted host"
+    fail=1
+fi
+
+# --- 2. proxy CONNECT control-byte rejection -------------------------------
+if ! grep -q 'invalid control character in proxy CONNECT host' "$srcdir/socket.c"; then
+    echo "FAIL: socket.c missing proxy CONNECT control-byte rejection"
+    fail=1
+fi
+
+# --- 3. main.c remote-shell leading-dash refusal ---------------------------
+if ! grep -q "hostnames may not start with '-'" "$srcdir/main.c"; then
+    echo "FAIL: main.c missing leading-dash remote-host refusal"
+    fail=1
+fi
+
+if [ "$fail" -ne 0 ]; then
+    echo "CVE-2026-53790 regression test: FAILED"
+    exit 1
+fi
+echo "CVE-2026-53790 regression test: PASSED"
+exit 0
