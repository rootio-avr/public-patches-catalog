+daemon_pid=$!
+trap 'ec=$?; set +e; kill $daemon_pid 2>/dev/null; if test -f "$pidfile"; then kill `cat "$pidfile"` 2>/dev/null; fi; exit $ec' EXIT
+
+# Wait for the daemon to come up.
+i=0
+while test $i -lt 50; do
+    test -s "$pidfile" && break
+    sleep 0.1
+    i=`expr $i + 1`
+done
+test -s "$pidfile" || test_skipped "test daemon did not start (no listening TCP available?)"
+
+connect() {
+    # $1 = module name; prints nothing, returns rsync's exit code.
+    $RSYNC -r "rsync://127.0.0.1:$port/$1/" >/dev/null 2>&1
