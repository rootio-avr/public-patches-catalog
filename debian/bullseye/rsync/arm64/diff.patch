--- /dev/null
+++ b/testsuite/daemon-refuse-delete-alias.test
@@ -0,0 +1,131 @@
+#!/bin/sh
+
+# Regression test for CVE-2026-70455 (options.c refuse-alias bypass).
+#
+# Grounded on the upstream test testsuite/daemon-refuse-delete-alias_test.py
+# added in commit c529163ef05458c1104999a363beac694cceb70f.  That commit is
+# reproduced here in the shell test idiom this rsync release ships, because
+# the upstream python testsuite does not exist in this tree.
+#
+# --del and --delete-during are the same capability written two ways, but the
+# popt table spells them differently: --del is POPT_ARG_NONE with a
+# destination (popt stores 1), --delete-during is POPT_ARG_VAL storing 1.
+# set_refuse_options() stopped after the first exact long-option match, so a
+# "refuse options" rule naming one spelling disabled only that spelling and
+# left the other one accepted -- the refused capability was still reachable
+# under its alias.  --remote-option (-M) puts the option in the daemon's argv
+# verbatim, which is the reach an ordinary daemon user already has.
+#
+# The fixed daemon must refuse BOTH spellings whichever one the rule names.
+
+. "$suitedir/rsync.fns"
+
+# --remote-option (-M) is required to place the option in the daemon argv.
+if ! $RSYNC --help 2>&1 | grep -q -- '--remote-option'; then
+    test_skipped "this rsync lacks --remote-option (-M)"
+fi
+
+conf="$scratchdir/test-refuse-alias.conf"
+pidfile="$scratchdir/rsyncd.pid"
+logfile="$scratchdir/rsyncd.log"
+
+srcd="$scratchdir/src"
+canon="$scratchdir/refuses_canonical"
+alias_d="$scratchdir/refuses_alias"
+opend="$scratchdir/open"
+makepath "$srcd" "$canon" "$alias_d" "$opend"
+echo KEEP >"$srcd/keep"
+
+my_uid=`get_testuid`
+root_uid=`get_rootuid`
+root_gid=`get_rootgid`
+uid_setting="uid = $root_uid"
+gid_setting="gid = $root_gid"
+if test x"$my_uid" != x"$root_uid"; then
+    uid_setting="#$uid_setting"
+    gid_setting="#$gid_setting"
+fi
+
+cat >"$conf" <<EOF
+pid file = $pidfile
+use chroot = no
+log file = $logfile
+$uid_setting
+$gid_setting
+
+[refuses_canonical]
+	path = $canon
+	read only = no
+	refuse options = delete-during
+
+[refuses_alias]
+	path = $alias_d
+	read only = no
+	refuse options = del
+
+[open]
+	path = $opend
+	read only = no
+EOF
+
+RSYNC_CONNECT_PROG="$RSYNC --config=$conf --daemon"
+export RSYNC_CONNECT_PROG
+
+# push MODULE OPT...  -> writes daemon stdout+stderr to $outfile, returns rc
+outfile="$scratchdir/push.out"
+push() {
+    module=$1
+    shift
+    $RSYNC -r "$@" "$srcd/" "localhost::$module/" >"$outfile" 2>&1
+}
+
+refused() {
+    # rc must be nonzero AND the daemon must name this exact spelling, so an
+    # unrelated failure cannot masquerade as the refusal under test.
+    test $push_rc -ne 0 && grep -q "configured to refuse --$1" "$outfile"
+}
+
+# Control: both spellings transfer where nothing refuses them, so a refusal
+# below is the rule firing rather than the push being broken.
+for opt in -M--del -M--delete-during; do
+    push_rc=0
+    push open --delete "$opt" || push_rc=$?
+    if test $push_rc -ne 0 || test ! -f "$opend/keep"; then
+        cat "$outfile"
+        test_fail "control failed: $opt could not push to an unrefusing module (rc=$push_rc)"
+    fi
+    rm -f "$opend/keep"
+done
+
+# Reported direction: rule names the canonical option, client sends the alias.
+push_rc=0
+push refuses_canonical --delete -M--del || push_rc=$?
+if ! refused del; then
+    cat "$outfile"
+    test_fail '"refuse options = delete-during" did not refuse its --del alias'
+fi
+
+# Mirror: rule names the alias, client sends the canonical option.
+push_rc=0
