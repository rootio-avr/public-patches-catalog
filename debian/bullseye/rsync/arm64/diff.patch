+#!/bin/sh
+
+# Regression test for CVE-2026-70464 (GHSA-hrwq-ccf7-rw5m).
+#
+# The rsync daemon used to arm an I/O timeout only at the very end of
+# rsync_module(); the pre-transfer handshake (greeting, authentication and the
+# argument list) was therefore read with no bound.  A peer that completed the
+# @RSYNCD greeting and then stalled -- e.g. sending an unterminated line, or
+# trickling bytes forever -- could pin a "max connections" slot indefinitely
+# and, in parallel, exhaust every slot without ever authenticating.
+#
+# set_daemon_handshake_timeout() now arms an absolute wall-clock deadline that
+# is re-checked in the read path, bounded at min(configured "timeout", 60s).
+# This test grounds on the upstream stall_greeting/built-in probe from
+# testsuite/daemon-handshake-timeout_test.py (which uses the Python rsyncfns.py
+# harness that does not exist in this rsync version, so it is re-expressed here
+# in the shell-based .test idiom): a stalled greeting must cause the daemon to
+# close the connection within the configured bound, not hang forever.
+
+. "$suitedir/rsync.fns"
+
+# We need a real listening daemon (not the fake-connect stdio path) so that a
+# raw stalled client can hold the socket open.  Skip if we lack the tools.
+python3 -c 'import socket, time' >/dev/null 2>&1 \
+    || test_skipped "python3 with socket support is required for this test"
+
+TIMEOUT=3           # configured handshake bound, in seconds
+SLOP=12             # generous allowance for scheduling/1s time() granularity
+dport=28730         # fixed high port for the test daemon (see readiness poll)
+
+conf="$scratchdir/handshake-timeout.conf"
+dpidfile="$scratchdir/handshake-timeout.pid"
+dlogfile="$scratchdir/handshake-timeout.log"
+
+makepath "$fromdir/mod"
+echo data >"$fromdir/mod/f"
+
+cat >"$conf" <<EOF
+pid file = $dpidfile
+log file = $dlogfile
+use chroot = no
+port = $dport
+timeout = $TIMEOUT
+
+[mod]
+	path = $fromdir/mod
+	read only = yes
+EOF
+
+# Start a real listening daemon on a fixed port.  A real listener (not the
+# fake-connect stdio path used by the other daemon tests) is required so that
+# a raw stalled client can hold the socket open.
+$RSYNC --daemon --no-detach --port="$dport" --config="$conf" &
+dpid=$!
+
+# Ensure the daemon is torn down no matter how we exit.
+trap 'kill $dpid >/dev/null 2>&1; wait $dpid 2>/dev/null' EXIT INT TERM
+
+# Wait until the daemon is accepting connections on the port.
+ready=no
+i=0
+while test $i -lt 50; do
+    if python3 -c 'import socket,sys
+s=socket.socket()
+s.settimeout(1)
+try:
+    s.connect(("127.0.0.1", int(sys.argv[1])))
+    s.close()
+except OSError:
+    sys.exit(1)
+' "$dport" >/dev/null 2>&1; then
+        ready=yes
+        break
+    fi
+    sleep 0.2
+    i=`expr $i + 1`
+done
+
+if test "$ready" != yes; then
+    cat "$dlogfile" >&2 2>/dev/null
+    test_skipped "test daemon never started listening on port $dport"
+fi
+
+# Drive a stalled greeting from a raw socket and measure how long the daemon
+# keeps the connection open.  The client sends the @RSYNCD greeting WITHOUT a
+# terminating newline and then trickles a byte at a time; a correctly bounded
+# daemon must close the connection within TIMEOUT (+ slop), while the old,
+# unbounded code would keep the slot open until the client gave up.
+result=`python3 - "$dport" "$SLOP" <<'PYEOF'
+import socket, sys, time
+
+port = int(sys.argv[1])
+slop = float(sys.argv[2])
+
+try:
+    s = socket.create_connection(('127.0.0.1', port), timeout=slop)
+except OSError as e:
+    print("CONNECT_FAIL %s" % e)
+    sys.exit(0)
+
+# Read the daemon's own @RSYNCD greeting line first.
+s.settimeout(slop)
+try:
+    s.recv(4096)
+except OSError as e:
+    print("GREETING_FAIL %s" % e)
+    sys.exit(0)
+
+# Deliberately unterminated greeting, then trickle to prove it is an absolute
+# deadline and not merely an idle timeout.
+try:
+    s.sendall(b'@RSYNCD: 31.0')
+except OSError as e:
+    print("SEND_FAIL %s" % e)
+    sys.exit(0)
+
+start = time.monotonic()
+deadline = start + slop
+closed = None
+while time.monotonic() < deadline:
+    left = deadline - time.monotonic()
+    s.settimeout(max(0.1, left))
+    try:
+        data = s.recv(4096)
+    except OSError:
+        closed = time.monotonic() - start
+        break
+    if not data:
+        closed = time.monotonic() - start
+        break
+    try:
+        s.sendall(b'x')
+    except OSError:
+        # Do not infer closure from the write side; the recv path confirms it.
+        pass
+    time.sleep(0.2)
+
+s.close()
+if closed is None:
+    print("OPEN")
+else:
+    print("CLOSED %.2f" % closed)
+PYEOF
+`
+
+echo "handshake probe result: $result"
+
+case "$result" in
+CLOSED*)
+    took=`echo "$result" | awk '{print $2}'`
+    # It closed -- make sure it was the deadline, not an instant refusal.
+    awk -v t="$took" 'BEGIN { exit !(t + 0 >= 0) }' \
+        || test_fail "unexpected close time: $result"
+    ;;
+OPEN)
+    test_fail "daemon kept the stalled handshake open past ${SLOP}s -- the handshake timeout is not enforced (CVE-2026-70464)"
+    ;;
+CONNECT_FAIL*|GREETING_FAIL*)
+    test_skipped "could not talk to the test daemon: $result"
+    ;;
+*)
+    test_fail "unexpected probe result: $result"
+    ;;
+esac
+
+exit 0
Description: CVE-2026-53783 - rrsync directory-escape via symlink TOCTOU
 rrsync (the ssh-restricted rsync wrapper) only performed a textual check for
 ".." components when confining a client to a restricted subdirectory. A
 malicious or compromised peer could supply a path that resolves, via a
 symlink (optionally flipped into place as a time-of-check/time-of-use race),
 to a location outside the restricted directory, letting it read or write
 files anywhere the rrsync user can reach (CWE-59 / CWE-88).
 .
 The upstream fix (RsyncProject/rsync 88cee089..41f411d6, released in v3.5.0)
 targets the python3 rewrite of rrsync introduced in rsync 3.2.4 and closes
 the race with a Linux /proc/self/fd inode-pin. Debian 11 (bullseye) still
 ships the legacy Perl implementation of rrsync, to which that Linux-specific
 mechanism does not apply, so this patch backports the portable security
 semantics of the upstream series to the Perl script:
 .
   * Resolve every transfer argument and every checked path option
     (--backup-dir, --compare-dest, --copy-dest, --link-dest, --partial-dir,
     --temp-dir, --files-from, --log-file, ...) with abs_path() and fail
     closed unless the result lies within the restricted directory. Paths
     whose leaf does not yet exist are validated against the deepest existing
     ancestor so a symlinked parent cannot pivot the transfer out of the tree.
   * While the session is restricted, disable the options that make rsync
     follow symlinks (short -K/-L/-k and --copy-links/--copy-dirlinks/
     --copy-unsafe-links/--keep-dirlinks), mirroring the upstream
     short_disabled_subdir='KLk' and copy-unsafe-links hardening.
 .
 A regression test (testsuite/rrsync.test) is added that drives the Perl
 rrsync directly and asserts that in-tree paths are accepted while symlink
 escapes, "..", escaping --backup-dir, and symlink-following options are all
 rejected. The upstream python regression tests
 (testsuite/rrsync-alt-dest-inband-pivot_test.py and
 testsuite/rrsync-backup-dir-inband-pivot_test.py) target the python rewrite
 not shipped in this version and are therefore not applicable.
Origin: backport, https://github.com/RsyncProject/rsync/commit/88cee089637ac30f3af7b4797e978fffc2cc45f5
