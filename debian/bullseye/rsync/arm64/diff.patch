+makepath "$fromdir/foo"
+echo one >"$fromdir/foo/one"
+
+port=12894
+pidfile="$scratchdir/rsyncd.pid"
+logfile="$scratchdir/rsyncd.log"
+conf="$scratchdir/deny-dns.conf"
+
+# `.invalid` is reserved (RFC 6761) to never resolve, so gethostbyname() on the
+# deny token fails deterministically -- exactly the fail-open trigger.
+cat >"$conf" <<EOF
+pid file = $pidfile
+use chroot = no
+log file = $logfile
+
+[plain]
+	path = $fromdir
+	read only = yes
+
+[deny-match]
+	path = $fromdir
+	read only = yes
+	hosts deny = 127.0.0.0/8
+
+[deny-nomatch]
+	path = $fromdir
+	read only = yes
+	hosts deny = 10.0.0.0/8
+
+[deny-unresolvable]
+	path = $fromdir
+	read only = yes
+	hosts deny = nope.nonexistent.invalid
