@@ -0,0 +1,75 @@
+#!/bin/sh
+
+# Regression test for CVE-2026-70460 (CWE-59 link-following / path-confinement
+# bypass).  A served daemon module only confined operator-supplied directory
+# paths (--backup-dir / --temp-dir / --partial-dir / alt-dest basis) LEXICALLY
+# via sanitize_path(); an in-module symlink component was then followed by the
+# physical write, escaping the module root.  The fix adds a realpath()-based
+# confinement check (path_is_module_confined()) wired into the daemon's
+# sanitize_paths sites, which rejects such paths.
+#
+# This test drives a real daemon push into a read/write module whose tree
+# contains a symlink ("escape") pointing outside the module, and asks for a
+# --backup-dir that traverses that symlink.  A vulnerable rsync writes the
+# backup outside the module (RED); the patched rsync rejects the options and
+# nothing is created outside the module root (GREEN).  A control run with an
+# in-module backup-dir must still succeed.
+
+. "$suitedir/rsync.fns"
+
+build_rsyncd_conf
+
+# A directory that lives OUTSIDE any module -- the confinement target.
+outside="$scratchdir/outside-module"
+mkdir -p "$outside"
+
+# The test-to module root is $todir.  Plant a trusted-looking in-module
+# symlink whose target is outside the module.
+mkdir -p "$todir"
+rm -f "$todir/escape"
+ln -s "$outside" "$todir/escape"
+
+# Something to transfer.
+echo payload >"$fromdir/onefile" 2>/dev/null || {
+    mkdir -p "$fromdir"
+    echo payload >"$fromdir/onefile"
+}
+
+RSYNC_CONNECT_PROG="$RSYNC --config=$conf --daemon"
+export RSYNC_CONNECT_PROG
+
+# --- Case 1: escaping --backup-dir must be refused, nothing escapes. ---
+# Route the backup dir through the in-module symlink so the physical path
+# resolves outside the module root.
+$RSYNC -a --backup --backup-dir=escape/bak \
+    "$fromdir/onefile" localhost::test-to/onefile >"$scratchdir/out1" 2>&1
+status1=$?
+
+if test -e "$outside/bak"; then
+    cat "$scratchdir/out1" >&2
+    test_fail "CVE-2026-70460: backup escaped the module into $outside/bak"
+fi
+# A non-zero status is expected (options rejected); a zero status is only OK
+# if the backup stayed inside the module (i.e. escape was not followed).
+if test "$status1" = 0 && test ! -e "$todir/escape" ; then
+    : # tolerable
+fi
+
+# --- Case 2: a legitimate in-module --backup-dir must still work. ---
+echo payload2 >"$fromdir/twofile"
+# Pre-populate a destination file so a backup is actually produced.
+echo old >"$todir/twofile"
+$RSYNC -a --backup --backup-dir=bak-in \
+    "$fromdir/twofile" localhost::test-to/twofile >"$scratchdir/out2" 2>&1
+status2=$?
+if test "$status2" != 0; then
+    cat "$scratchdir/out2" >&2
+    test_fail "CVE-2026-70460: legitimate in-module --backup-dir was rejected"
+fi
+if test ! -f "$todir/twofile"; then
+    cat "$scratchdir/out2" >&2
+    test_fail "CVE-2026-70460: normal in-module transfer did not complete"
+fi
+
+# Confinement held and normal operation still works.
+exit 0
