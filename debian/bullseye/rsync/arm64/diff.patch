--- /dev/null
+++ b/testsuite/cve-2026-53803.test
@@ -0,0 +1,74 @@
+#! /bin/sh
+
+# Regression test for CVE-2026-53803 (CWE-59, symlink following on ancillary
+# file writes).  rsync before the fix opened operator-supplied ancillary paths
+# (--log-file, --write-batch/--read-batch, daemon motd/early-input) with a plain
+# open()/fopen(), so an attacker who could plant a symlink at a predictable
+# output path (or a parent component) could redirect rsync's writes to overwrite
+# arbitrary files, or feed chosen bytes to the protocol parser via --read-batch.
+#
+# The fix routes these opens through open_no_attacker_symlinks(), which refuses
+# to traverse any symlink not owned by uid 0 or our euid, and rejects a
+# non-regular --read-batch file.  This test exercises the two behaviors that are
+# deterministic without a second uid: the --read-batch non-regular-file
+# rejection (always), and the untrusted-symlink refusal (when run as root, where
+# a symlink owned by a non-root uid is genuinely "untrusted").
+
+. "$suitedir/rsync.fns"
+
+hands_setup
+
+# --- Part 1: --read-batch must reject a non-regular file (FIFO/device). -------
+# A planted FIFO or device at the batch path would otherwise stream
+# attacker-chosen bytes into the protocol parser.
+
+if mkfifo "$scratchdir/batch.fifo" 2>/dev/null || mknod "$scratchdir/batch.fifo" p 2>/dev/null; then
+    # Pump some bytes in the background so the open() doesn't block, then confirm
+    # rsync refuses the non-regular file rather than parsing its contents.
+    ( : > "$scratchdir/batch.fifo" & ) 2>/dev/null
+    if $RSYNC -av --read-batch="$scratchdir/batch.fifo" "$todir" >"$scratchdir/rb.out" 2>&1; then
+	test_fail "CVE-2026-53803: --read-batch accepted a non-regular (FIFO) batch file"
+    fi
+    rm -f "$scratchdir/batch.fifo"
+    echo "ok: --read-batch rejected a non-regular file"
+else
+    echo "note: could not create a FIFO; skipping the --read-batch non-regular-file check"
+fi
+
+# --- Part 2: --log-file must not follow an untrusted (foreign-owned) symlink. --
+# The refusal is keyed on symlink ownership (uid 0 or our euid is trusted), so a
+# meaningful negative test needs the planted symlink to be owned by a different
+# uid than ours.  That is only reproducible when we are root, so gate on that.
+
+myuid=`get_testuid`
+if [ "x$myuid" != "x0" ]; then
+    echo "note: not running as root; skipping the foreign-owned-symlink log-file check"
+    exit 0
+fi
+
+# Pick a non-root uid to own the planted symlink.
+victim="$scratchdir/victim.txt"
+echo "PRECIOUS" > "$victim"
+plant="$scratchdir/attacker/log"
+mkdir -p "$scratchdir/attacker"
+ln -s "$victim" "$plant"
+
+# Make the symlink owned by a non-root uid (untrusted from root's point of view).
+if chown -h 1 "$plant" 2>/dev/null; then
+    :
+else
+    echo "note: cannot chown the symlink to a non-root uid; skipping"
+    exit 0
+fi
+
+# Any trivial transfer will trigger the log-file open.
+$RSYNC -av --log-file="$plant" "$fromdir/" "$todir/" >/dev/null 2>&1
+
+# The victim file must be untouched: the symlink must NOT have been followed.
+if grep -q "PRECIOUS" "$victim"; then
+    echo "ok: --log-file refused to follow the attacker-owned symlink"
+else
+    test_fail "CVE-2026-53803: --log-file followed an attacker-owned symlink and clobbered the target"
+fi
+
+exit 0
