+/* CVE-2026-70460: physically confine an operator-/peer-supplied directory
+ * path to the served daemon module.  sanitize_path() only confines a path
+ * LEXICALLY (leading-slash clamp + ".." stripping); it does not resolve
+ * symlink components, so an in-module symlink that the ownership/filter
+ * rules already trust could redirect a later symlink()/open()/mknod()/
+ * rename() write outside the module root (a link-following bypass).
+ *
+ * This helper is a no-op unless sanitize_paths is set (i.e. a confined
+ * daemon module), so local, non-daemon transfers keep their legacy
+ * behavior.  For a confined module the daemon has already change_dir()'d
+ * into the module root, so realpath(".") is the confinement anchor.  We
+ * canonicalize the deepest existing ancestor of "path" (the leaf need not
+ * exist yet) and require the result to be the module root or to lie
+ * strictly beneath it.  Returns 1 when confined (or when the check does
+ * not apply), 0 when the path escapes the module. */
+int path_is_module_confined(const char *path)
+{
+	char *root, *dup, *slash, *resolved;
+	char rootbuf[MAXPATHLEN];
+	unsigned int rootlen;
+	int ok = 0;
+
+	if (!sanitize_paths || !path || !*path)
+		return 1;
+
+	if (!(root = realpath(".", NULL)))
+		return 0;
+	rootlen = strlcpy(rootbuf, root, sizeof rootbuf);
+	free(root);
+	if (rootlen >= sizeof rootbuf)
+		return 0;
+	/* Strip a lone trailing slash (but keep "/" itself). */
+	while (rootlen > 1 && rootbuf[rootlen-1] == '/')
+		rootbuf[--rootlen] = '\0';
+
+	if (!(dup = strdup(path)))
+		return 0;
+
+	/* Resolve the deepest existing prefix of the requested path. */
+	for (;;) {
+		if ((resolved = realpath(dup, NULL)) != NULL)
+			break;
+		/* Trim the last component and retry with the parent. */
+		slash = strrchr(dup, '/');
+		if (!slash) { /* relative leaf with no existing parent: use "." */
+			free(dup);
+			if (!(dup = strdup(".")))
+				return 0;
+			resolved = realpath(dup, NULL);
+			break;
+		}
+		if (slash == dup) /* parent is "/" */
+			slash[1] = '\0';
+		else
+			slash[0] = '\0';
+	}
+	free(dup);
+	if (!resolved)
+		return 0;
+
+	/* Confined if resolved == root, or resolved is under root/ . */
+	if (strcmp(resolved, rootbuf) == 0)
+		ok = 1;
+	else if (rootlen == 1 && rootbuf[0] == '/') /* module root is "/" */
+		ok = resolved[0] == '/';
+	else if (strncmp(resolved, rootbuf, rootlen) == 0 && resolved[rootlen] == '/')
+		ok = 1;
+
+	free(resolved);
+	return ok;
+}
