--- /dev/null
+++ b/testsuite/rsync-ssl-cert-validation.test
@@ -0,0 +1,133 @@
+#! /bin/sh
+
+# Regression test for CVE-2026-70454 (CWE-295, improper certificate
+# validation in rsync-ssl).  This is a backported, shell-idiom replacement
+# for the upstream python testsuite cases rsync-ssl-stunnel-ca-required,
+# rsync-ssl-stunnel-hostname-check and rsync-ssl-openssl-hostname-check,
+# which do not ship in this (3.2.3) tree.
+#
+# It exercises the rsync-ssl helper script directly with fake openssl/stunnel
+# backends and asserts that:
+#   * stunnel mode refuses to run without a CA (unless explicitly opted out);
+#   * a CA-configured stunnel config binds the cert to the hostname (checkHost);
+#   * the openssl backend passes -verify_hostname by default and
+#     RSYNC_SSL_SKIP_HOSTNAME_CHECK=1 drops only the identity check;
+#   * an invalid hostname is rejected fail-closed.
+
+. "$suitedir/rsync.fns"
+
+rsync_ssl="$srcdir/rsync-ssl"
+test -f "$rsync_ssl" || test_skipped "rsync-ssl helper script not present in srcdir"
+
+# rsync-ssl feeds the generated stunnel config on fd 10 and requires bash for
+# the fd>9 redirection; skip cleanly where bash is unavailable.
+bash_prog=`command -v bash 2>/dev/null`
+test -n "$bash_prog" || test_skipped "bash is required to run the rsync-ssl helper"
+
+base="$scratchdir/rsync-ssl-cve"
+rm -rf "$base"
+mkdir -p "$base" || test_fail "could not create $base"
+
+cap="$base/capture"
+ca="$base/ca.pem"
+echo "dummy-ca" > "$ca"
+
+fake_stunnel="$base/fake_stunnel"
+cat > "$fake_stunnel" <<EOF
+#!/usr/bin/env bash
+cat <&10 > "$cap" 2>/dev/null
+exit 0
+EOF
+chmod 755 "$fake_stunnel"
+
+fake_openssl="$base/fake_openssl"
+cat > "$fake_openssl" <<EOF
+#!/bin/sh
+echo "\$@" > "$cap"
+exit 0
+EOF
+chmod 755 "$fake_openssl"
+
+helper_args='--HELPER localhost rsync --server --daemon .'
+
+# --- stunnel: refuses to run without a CA ---------------------------------
+out=$(env -u RSYNC_SSL_CA_CERT -u RSYNC_SSL_ALLOW_INSECURE_STUNNEL \
+	RSYNC_SSL_TYPE=stunnel RSYNC_SSL_STUNNEL="$fake_stunnel" \
+	"$bash_prog" "$rsync_ssl" $helper_args 2>&1) && rc=0 || rc=$?
+case "$out" in
+    *"stunnel requires RSYNC_SSL_CA_CERT"*) ;;
+    *) test_fail "rsync-ssl did NOT refuse insecure stunnel mode without a CA: $out" ;;
+esac
+test $rc -ne 0 || test_fail "rsync-ssl exited 0 for insecure stunnel mode"
+
+# --- stunnel: CA configured -> chain AND hostname are verified ------------
+rm -f "$cap"
+env -u RSYNC_SSL_ALLOW_INSECURE_STUNNEL -u RSYNC_SSL_SKIP_HOSTNAME_CHECK \
+	RSYNC_SSL_TYPE=stunnel RSYNC_SSL_STUNNEL="$fake_stunnel" \
+	RSYNC_SSL_CA_CERT="$ca" \
+	"$bash_prog" "$rsync_ssl" $helper_args >/dev/null 2>&1
+test -f "$cap" || test_fail "premise: fake stunnel did not capture a config"
+cfg=`cat "$cap"`
+case "$cfg" in
+    *"verifyChain = yes"*) ;;
+    *) test_fail "CA-configured stunnel config must verify the chain: $cfg" ;;
+esac
+case "$cfg" in
+    *"checkHost = localhost"*) ;;
+    *) test_fail "CA-configured stunnel config is missing checkHost = localhost: $cfg" ;;
+esac
+
+# --- stunnel: chain-only opt-out -> chain verified, no hostname binding ---
+rm -f "$cap"
+env -u RSYNC_SSL_ALLOW_INSECURE_STUNNEL \
+	RSYNC_SSL_TYPE=stunnel RSYNC_SSL_STUNNEL="$fake_stunnel" \
+	RSYNC_SSL_CA_CERT="$ca" RSYNC_SSL_SKIP_HOSTNAME_CHECK=1 \
+	"$bash_prog" "$rsync_ssl" $helper_args >/dev/null 2>&1
+cfg=`cat "$cap"`
+case "$cfg" in
+    *checkHost*) test_fail "SKIP_HOSTNAME_CHECK=1 must drop checkHost: $cfg" ;;
+esac
+
+# --- openssl: binds the hostname by default -------------------------------
+rm -f "$cap"
+env -u RSYNC_SSL_SKIP_HOSTNAME_CHECK \
+	RSYNC_SSL_TYPE=openssl RSYNC_SSL_OPENSSL="$fake_openssl" \
+	RSYNC_SSL_CA_CERT="$ca" \
+	"$bash_prog" "$rsync_ssl" $helper_args >/dev/null 2>&1
+test -f "$cap" || test_fail "premise: fake openssl did not capture argv"
+args=`cat "$cap"`
+case "$args" in
+    *"-verify_hostname localhost"*) ;;
+    *) test_fail "openssl backend is missing -verify_hostname localhost: $args" ;;
+esac
+
+# --- openssl: chain-only opt-out drops -verify_hostname, keeps SNI + CA ----
+rm -f "$cap"
+env RSYNC_SSL_TYPE=openssl RSYNC_SSL_OPENSSL="$fake_openssl" \
+	RSYNC_SSL_CA_CERT="$ca" RSYNC_SSL_SKIP_HOSTNAME_CHECK=1 \
+	"$bash_prog" "$rsync_ssl" $helper_args >/dev/null 2>&1
+args=`cat "$cap"`
+case "$args" in
+    *-verify_hostname*) test_fail "SKIP_HOSTNAME_CHECK=1 must drop -verify_hostname: $args" ;;
+esac
+case "$args" in
+    *"-servername localhost"*) ;;
+    *) test_fail "SKIP_HOSTNAME_CHECK must keep SNI (-servername): $args" ;;
+esac
+case "$args" in
+    *-CAfile*) ;;
+    *) test_fail "SKIP_HOSTNAME_CHECK must keep chain verification (-CAfile): $args" ;;
+esac
+
+# --- invalid hostname is rejected fail-closed -----------------------------
+out=$(env RSYNC_SSL_TYPE=openssl RSYNC_SSL_OPENSSL="$fake_openssl" \
+	RSYNC_SSL_CA_CERT="$ca" \
+	"$bash_prog" "$rsync_ssl" --HELPER 'ev;il`whoami`' rsync --server --daemon . 2>&1) && rc=0 || rc=$?
+case "$out" in
+    *"invalid rsync-ssl hostname"*) ;;
+    *) test_fail "rsync-ssl did NOT reject an injection-shaped hostname: $out" ;;
+esac
+test $rc -ne 0 || test_fail "rsync-ssl exited 0 for an invalid hostname"
+
+# hooray
+exit 0
Description: CVE-2026-70464 - bound the daemon pre-transfer handshake with a timeout
 The rsync daemon only armed an I/O timeout at the very end of rsync_module(),
 so the pre-transfer handshake (the @RSYNCD greeting, authentication, and the
 whole argument list read via read_args()) was performed with no I/O timeout.
 Because claim_connection() runs before authentication, an unauthenticated
 remote attacker could complete the greeting and then stall indefinitely --
 sending an unterminated line, or trickling NUL-terminated arguments one byte
 at a time -- pinning a module's "max connections" slot. Parallel stalled
 connections exhaust all slots and deny service to legitimate clients
 (CWE-770).
 .
 This backport re-expresses the upstream fix against rsync 3.2.3, whose
 safe_read() uses select()/fd_set rather than the poll()/struct pollfd loop of
 the upstream (post-3.5.0dev) tree. An absolute wall-clock deadline
 (daemon_handshake_deadline), armed by set_daemon_handshake_timeout() and
 re-checked on every select() iteration, bounds each peer-driven handshake
 phase at min(configured "timeout", 60s). The deadline is armed before any
 peer input is read (including the PROXY-protocol header), tightened once the
 module is known, disarmed around local setup and operator hooks so forked
 children never inherit it, and re-armed across both read_args() calls. This
 matches upstream commit 4d7c243ca6b6f3a2126fd2863312ac01194578a5.
 .
 The upstream regression test (testsuite/daemon-handshake-timeout_test.py)
 depends on the Python rsyncfns.py harness that does not exist in 3.2.3, so a
 minimal equivalent shell test (testsuite/daemon-handshake-timeout.test) is
 provided in the project's own .test idiom, grounded in the upstream
 stall-greeting probe.
