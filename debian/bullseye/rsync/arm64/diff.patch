+++ b/testsuite/daemon-module-chdir-symlink.test
@@ -0,0 +1,92 @@
+#!/bin/sh
+
+# Regression test for CVE-2026-53784.
+#
+# A daemon module configured with `use chroot = no` calls change_dir() into the
+# operator-configured `path =`.  Historically that chdir followed symlinks at
+# every path component with a plain chdir().  If any component of the configured
+# path is a symlink planted by an untrusted local user, the planted symlink
+# redirects the daemon's CWD out of the served module before any transfer
+# begins, so the client is served files from the escape target instead.
+#
+# This is a shell translation of the upstream daemon-module-chdir-symlink_test.py
+# threat model: configure `path = $plant`, where $plant is a symlink (owned by an
+# untrusted uid) pointing at an escape directory that holds a unique canary file
+# the real module never has.  List the module; if the canary appears the daemon
+# followed the planted symlink (VULNERABLE).  With the fix the owned-by-trusted-
+# uid path walk refuses the untrusted symlink and the module listing fails.
+#
+# Requires root, so the plant can be owned by a different (untrusted) uid.
+
+. "$suitedir/rsync.fns"
+
+CANARY="audit_escape_canary"
+
+my_uid=`get_testuid`
+root_uid=`get_rootuid`
+
+if test x"$my_uid" != x"$root_uid"; then
+    test_skipped "requires root to plant a symlink owned by an untrusted uid"
+fi
+
+# Find an untrusted uid (not 0, not us) to own the planted symlink.
+untrusted_uid=''
+for name in nobody nfsnobody daemon bin; do
+    u=`id -u "$name" 2>/dev/null || true`
+    case "$u" in
+	[0-9]*)
+	    if test x"$u" != x0 && test x"$u" != x"$my_uid"; then
+		untrusted_uid="$u"
+		break
+	    fi
+	    ;;
+    esac
+done
+if test x"$untrusted_uid" = x; then
+    test_skipped "no untrusted-uid user available for the cross-uid plant"
+fi
+
+base="$scratchdir/modchdir"
+rm -rf "$base"
+mkdir -p "$base" || test_fail "mkdir $base failed"
+
+# The "escape" directory the attacker wants the daemon to serve from.  Owned by
+# us, with a canary file that the legitimate module does not have.
+escape_target="$base/escape_target"
+mkdir -p "$escape_target" || test_fail "mkdir $escape_target failed"
+echo "you-should-not-see-this" >"$escape_target/$CANARY"
+
+# The planted symlink: it appears at the daemon-configured 'path =' and
+# redirects to the escape target.  The link itself is owned by an untrusted
+# uid, so the fix's owned-by-trusted-uid path walk must refuse to follow it.
+plant="$base/plant"
+ln -s "$escape_target" "$plant" || test_fail "could not create planted symlink"
+chown -h "$untrusted_uid" "$plant" || test_skipped "cannot chown the plant to an untrusted uid"
+
+conf="$scratchdir/test-rsyncd.conf"
+pidfile="$scratchdir/rsyncd.pid"
+logfile="$scratchdir/rsyncd.log"
+cat >"$conf" <<EOF
+pid file = $pidfile
+use chroot = no
+log file = $logfile
+[mod]
+	path = $plant
+	read only = yes
+EOF
+
+RSYNC_CONNECT_PROG="$RSYNC --config=$conf --daemon"
+export RSYNC_CONNECT_PROG
+
+outfile="$scratchdir/rsync.out"
+# List the module contents; capture output but never fail the test on rsync's
+# own non-zero exit (a refused chdir legitimately fails the connection).
+$RSYNC localhost::mod/ >"$outfile" 2>&1 || true
+
+if grep "$CANARY" "$outfile" >/dev/null 2>&1; then
+    test_fail "daemon module-root chdir followed a planted untrusted symlink ($plant -> $escape_target); the escape-target canary '$CANARY' appeared in the module listing (CVE-2026-53784)"
+fi
+
+# Passed: the canary was NOT served, so the planted symlink did not redirect the
+# daemon out of the configured module.
+exit 0
Description: CVE-2026-70458 - rsync hard-link protocol robustness against malicious peers
 A malicious rsync sender can drive out-of-bounds heap access on the
 receiver through the hard-link handling of the file-list protocol:
 .
  * recv_file_entry() (flist.c) set FLAG_HLINKED straight from the peer's
    XMIT_HLINKED xflag, even when the receiver was not invoked with -H
    (preserve_hard_links off) and even for directory entries. Because the
    hard-link extra slots (including F_SUM) are only reserved when
    preserve_hard_links is set, HLINK_BUMP() then offsets F_SUM() past the
    start of the pool_alloc()'d region and the subsequent checksum read/write
    corrupts the heap below the allocation. Gate FLAG_HLINKED on
    preserve_hard_links and exclude directory entries.
 .
  * match_gnums() (hlink.c) asserted that a hard-link generation number was
    not before the current flist's ndx_start. A peer sending an out-of-range
    back-reference on the first flist could trip the assert (or, without
    assertions, index out of bounds). Replace the assert with a controlled
    protocol error that exits cleanly with RERR_PROTOCOL.
 .
  * hard_link_check() (hlink.c) called the content-based basis match
    (unchanged_file(), FT_REG semantics) which reads F_SUM() for any
    hard-linked entry, including symlinks/devices/specials that never had
    SUM_EXTRA_CNT space allocated. Guard the call with S_ISREG(file->mode).
 .
