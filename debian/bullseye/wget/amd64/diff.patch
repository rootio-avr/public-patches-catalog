Description: Fix CVE-2026-58470 integer overflow in parse_content_range
 GNU Wget's parse_content_range() function in src/http.c parses byte
 values from a server-supplied Content-Range header using a manual
 digit-by-digit multiplication loop (num = 10 * num + digit) into a
 signed wgint. A crafted Content-Range header with sufficiently large
 numeric fields causes signed integer overflow (CWE-190), which is
 undefined behavior and can lead to download desynchronization on the
 client.
 .
 Upstream replaces the manual accumulator loops with strtol() calls
 guarded by errno == ERANGE checks, so overflowing values are rejected
 as parse failures. Advances of the header pointer are folded into the
 delimiter checks, keeping the parser's semantics unchanged for
 well-formed input.
Origin: upstream, https://gitlab.com/gnuwget/wget/-/commit/43d3ba9336bc94937e6fae2365c6ffd30c34ffcf
Author: Tim Rühsen <tim.ruehsen@gmx.de>
Bug: https://security-tracker.debian.org/tracker/CVE-2026-58470
Last-Update: 2026-07-11

--- a/src/http.c
+++ b/src/http.c
@@ -914,6 +914,7 @@ parse_content_range (const char *hdr, wgint *first_byte_ptr,
                      wgint *last_byte_ptr, wgint *entity_length_ptr)
 {
   wgint num;
+  char *end;

   /* Ancient versions of Netscape proxy server, presumably predating
      rfc2068, sent out `Content-Range' without the "bytes"
@@ -932,27 +933,39 @@ parse_content_range (const char *hdr, wgint *first_byte_ptr,
     }
   if (!c_isdigit (*hdr))
     return false;
-  for (num = 0; c_isdigit (*hdr); hdr++)
-    num = 10 * num + (*hdr - '0');
-  if (*hdr != '-' || !c_isdigit (*(hdr + 1)))
+
+  errno = 0;
+  num = strtol(hdr, &end, 10);
+  if (errno == ERANGE)
+    return false;
+  hdr = end;
+
+  if (*hdr++ != '-' || !c_isdigit (*hdr))
     return false;
   *first_byte_ptr = num;
-  ++hdr;
-  for (num = 0; c_isdigit (*hdr); hdr++)
-    num = 10 * num + (*hdr - '0');
-  if (*hdr != '/')
+
+  errno = 0;
+  num = strtol(hdr, &end, 10);
+  if (errno == ERANGE)
+    return false;
+  hdr = end;
+
+  if (*hdr++ != '/')
     return false;
   *last_byte_ptr = num;
-  if (!(c_isdigit (*(hdr + 1)) || *(hdr + 1) == '*'))
+  if (!(c_isdigit (*hdr) || *hdr == '*'))
     return false;
   if (*last_byte_ptr < *first_byte_ptr)
     return false;
-  ++hdr;
   if (*hdr == '*')
     num = -1;
   else
-    for (num = 0; c_isdigit (*hdr); hdr++)
-      num = 10 * num + (*hdr - '0');
+    {
+      errno = 0;
+      num = strtol(hdr, NULL, 10);
+      if (errno == ERANGE)
+        return false;
+    }
   *entity_length_ptr = num;
   if ((*entity_length_ptr <= *last_byte_ptr) && *entity_length_ptr != -1)
     return false;
Description: CVE-2026-58472 - Fix integer and buffer overflow in html_quote_string()
 The html_quote_string() function in src/convert.c computed the size of the
 output buffer using a plain 'int' counter that could overflow when processing
 sufficiently large input strings.  The resulting undersized allocation was
 then written past its end during the second pass, leading to a heap buffer
 overflow.
 .
 This patch changes the counter to size_t and performs each accumulation
 through the gnulib INT_ADD_OK() checked-arithmetic macro.  Any detected
 overflow aborts the process with a DEBUGP diagnostic instead of continuing
 with a corrupt size.  The final "+1" for the terminating NUL is also
 performed via INT_ADD_OK, and xmalloc() is now called with the exact byte
 count (which already includes the extra byte).
Origin: upstream, https://gitlab.com/gnuwget/wget/-/commit/dd692d9cea5335b181d877ae917fe6e75587a812
Author: Tim Rühsen <tim.ruehsen@gmx.de>
Last-Update: 2026-07-12

--- a/src/convert.c
+++ b/src/convert.c
@@ -36,6 +36,7 @@ as that of the covered work.  */
 #include <unistd.h>
 #include <errno.h>
 #include <assert.h>
+#include <intprops.h>
 #include "convert.h"
 #include "url.h"
 #include "recur.h"
@@ -1178,21 +1179,37 @@ html_quote_string (const char *s)
 {
   const char *b = s;
   char *p, *res;
-  int i;
+  size_t i;
+  int ok;
 
   /* Pass through the string, and count the new size.  */
-  for (i = 0; *s; s++, i++)
+  for (i = 0; *s; s++)
     {
       if (*s == '&')
-        i += 4;                 /* `amp;' */
+        ok = INT_ADD_OK (i, 4, &i);     /* `amp;' */
       else if (*s == '<' || *s == '>')
-        i += 3;                 /* `lt;' and `gt;' */
+        ok = INT_ADD_OK (i, 3, &i);     /* `lt;' and `gt;' */
       else if (*s == '\"')
-        i += 5;                 /* `quot;' */
+        ok = INT_ADD_OK (i, 5, &i);     /* `quot;' */
       else if (*s == ' ')
-        i += 4;                 /* #32; */
+        ok = INT_ADD_OK (i, 4, &i);     /* #32; */
+      else
+        ok = INT_ADD_OK (i, 1, &i);
+
+      if (!ok)
+        {
+          DEBUGP (("Overflow detected in html_quote_string().\n"));
+          abort();
+        }
     }
-  res = xmalloc (i + 1);
+
+  if (!INT_ADD_OK (i, 1, &i))
+    {
+      DEBUGP (("Overflow detected in html_quote_string().\n"));
+      abort();
+    }
+
+  res = xmalloc (i);
   s = b;
   for (p = res; *s; s++)
     {
