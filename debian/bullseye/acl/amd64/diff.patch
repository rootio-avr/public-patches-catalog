+		if (fstatat(dirfd, path_p, &st, at_flags) != 0)
+			goto out;
+
+		if (S_ISLNK(st.st_mode)) {
+			errno = ENOTSUP;
+			goto out;
+		}
+		if (type == ACL_TYPE_DEFAULT) {
+			if (S_ISDIR(st.st_mode))
+				acl = acl_init(0);
+			else
+				errno = EACCES;
+		} else
+			acl = acl_from_mode(st.st_mode);
+	}
+
