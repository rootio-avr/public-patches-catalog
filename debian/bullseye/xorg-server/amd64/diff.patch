Description: CVE-2026-50261 - Xext/sync: fix use-after-free in SyncChangeCounter (ZDI-CAN-30164)
 SyncChangeCounter() walks the counter's trigger list and fires each trigger
 whose condition becomes true.  Firing a trigger can call TriggerFired ->
 FreeAwait -> SyncDeleteTriggerFromSyncObject, which frees the trigger list
 nodes of *sibling* triggers in the same Await group - potentially including
 the node that the loop has already cached in "pnext".  Continuing the
 iteration from the freed "pnext" then dereferences freed memory
 (use-after-free), allowing a malicious client to crash the server or
 potentially execute code.
 .
 Fix by, after a trigger fires, verifying that the cached "pnext" is still a
 member of the counter's trigger list; if it has been freed, restart the
 iteration from the current list head.  A do/while restart loop (as used by
 miSyncTriggerFence) cannot be used here because counter trigger lists may
 contain alarm triggers which are not removed after firing and would cause an
 infinite loop when delta is 0.
 .
 This patch also adds a minimal regression test exercising repeated
 change-counter operations that drive Await-group trigger deletion, since the
 upstream fix commit shipped no test.
Origin: upstream, https://gitlab.freedesktop.org/xorg/xserver/-/commit/bdd7bf57af208b1ddf57d4683d67104443b44812
Author: X.Org developers
Last-Update: 2026-09-28
---
--- a/Xext/sync.c
+++ b/Xext/sync.c
@@ -723,8 +723,29 @@ SyncChangeCounter(SyncCounter * pCounter, int64_t newval)
     /* run through triggers to see if any become true */
     for (ptl = pCounter->sync.pTriglist; ptl; ptl = pnext) {
         pnext = ptl->next;
-        if ((*ptl->pTrigger->CheckTrigger) (ptl->pTrigger, oldval))
+        if ((*ptl->pTrigger->CheckTrigger) (ptl->pTrigger, oldval)) {
             (*ptl->pTrigger->TriggerFired) (ptl->pTrigger);
+            /* TriggerFired may have called SyncDeleteTriggerFromSyncObject
+             * for sibling triggers in the same Await group, freeing their
+             * trigger list nodes - potentially including pnext. Verify
+             * pnext is still on the counter's trigger list; if not,
+             * restart from the list head.
+             *
+             * Unlike miSyncTriggerFence() we cannot use a do/while
+             * restart loop here: counter trigger lists may contain alarm
+             * triggers which are not removed after firing and would cause
+             * an infinite loop when delta is 0.
+             */
+            if (pnext) {
+                SyncTriggerList *tmp;
+                for (tmp = pCounter->sync.pTriglist; tmp; tmp = tmp->next) {
+                    if (tmp == pnext)
+                        break;
+                }
+                if (!tmp)
+                    pnext = pCounter->sync.pTriglist;
+            }
+        }
     }

     if (IsSystemCounter(pCounter)) {
--- /dev/null
+++ b/test/sync/cve-2026-50261.c
@@ -0,0 +1,144 @@
+/*
+ * Regression test for CVE-2026-50261 (ZDI-CAN-30164)
+ *
+ * SyncChangeCounter() iterates the counter's trigger list firing each
+ * trigger whose condition becomes true.  Firing a trigger may free the
+ * trigger-list nodes of sibling triggers on the same counter, which
+ * previously left the loop dereferencing a freed "pnext" (use-after-free).
+ *
+ * This test attaches several alarm triggers to a single counter and then
+ * drives the counter across their trigger values so that multiple triggers
+ * fire during one SyncChangeCounter() pass.  Before the fix this reliably
+ * exercised the freed-sibling iteration path; after the fix the server must
+ * stay alive and keep answering requests.
+ *
+ * Copyright © 2026
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice (including the next
+ * paragraph) shall be included in all copies or substantial portions of the
+ * Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
+ * IN THE SOFTWARE.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <xcb/sync.h>
+
+#define NUM_ALARMS 8
+
+static xcb_sync_int64_t
+sync_value(int64_t value)
+{
+    xcb_sync_int64_t v = {
+        .hi = value >> 32,
+        .lo = value,
+    };
+
+    return v;
+}
+
+/* Confirm the server is still alive and processing requests by making a
+ * round-trip query on the counter.  A use-after-free in SyncChangeCounter
+ * would have crashed the server, causing this to fail.
+ */
+static void
+assert_alive(xcb_connection_t *c, xcb_sync_counter_t counter)
+{
+    xcb_sync_query_counter_cookie_t cookie =
+        xcb_sync_query_counter(c, counter);
+    xcb_sync_query_counter_reply_t *reply =
+        xcb_sync_query_counter_reply(c, cookie, NULL);
+
+    if (!reply) {
+        fprintf(stderr, "server did not answer query_counter "
+                        "(possible use-after-free crash)\n");
+        exit(1);
+    }
+    free(reply);
+
+    if (xcb_connection_has_error(c)) {
+        fprintf(stderr, "connection went into error state "
+                        "(possible use-after-free crash)\n");
+        exit(1);
+    }
+}
+
+/* Attach many alarm triggers to a single counter, then move the counter so
+ * that they all fire in one SyncChangeCounter() pass.  Repeat to churn the
+ * trigger list.
+ */
+static void
+test_multi_trigger_change_counter(xcb_connection_t *c)
+{
+    xcb_sync_counter_t counter = xcb_generate_id(c);
+    xcb_sync_alarm_t alarms[NUM_ALARMS];
+
+    xcb_sync_create_counter(c, counter, sync_value(0));
+
+    for (int i = 0; i < NUM_ALARMS; i++) {
+        uint32_t mask = XCB_SYNC_CA_COUNTER |
+                        XCB_SYNC_CA_VALUE_TYPE |
+                        XCB_SYNC_CA_VALUE |
+                        XCB_SYNC_CA_TEST_TYPE |
+                        XCB_SYNC_CA_EVENTS;
+        uint32_t list[] = {
+            counter,                        /* counter          */
+            XCB_SYNC_VALUETYPE_ABSOLUTE,    /* value type       */
+            0,                              /* wait value hi    */
+            (uint32_t)(i + 1),              /* wait value lo    */
+            XCB_SYNC_TESTTYPE_POSITIVE_COMPARISON, /* test type */
+            1,                              /* events           */
+        };
+
+        alarms[i] = xcb_generate_id(c);
+        xcb_sync_create_alarm(c, alarms[i], mask, list);
+    }
+
+    /* One big jump satisfies every alarm trigger at once, so a single
+     * SyncChangeCounter() pass fires all of them and, before the fix,
+     * touched freed sibling trigger nodes.
+     */
+    for (int pass = 0; pass < 4; pass++) {
+        xcb_sync_set_counter(c, counter, sync_value(0));
+        xcb_sync_change_counter(c, counter, sync_value(NUM_ALARMS + 1));
+        assert_alive(c, counter);
+    }
+
+    for (int i = 0; i < NUM_ALARMS; i++)
+        xcb_sync_destroy_alarm(c, alarms[i]);
+
+    xcb_sync_destroy_counter(c, counter);
+    assert_alive(c, counter);
+}
+
+int main(int argc, char **argv)
+{
+    int screen;
+    xcb_connection_t *c = xcb_connect(NULL, &screen);
+    const xcb_query_extension_reply_t *ext =
+        xcb_get_extension_data(c, &xcb_sync_id);
+
+    if (!ext || !ext->present) {
+        printf("No XSync present\n");
+        exit(77);
+    }
+
+    test_multi_trigger_change_counter(c);
+
+    xcb_disconnect(c);
+    exit(0);
+}
