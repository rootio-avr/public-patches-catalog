--- /dev/null
+++ b/tests/hostname-check-srv-octet.c
@@ -0,0 +1,134 @@
+/*
+ * Regression test for CVE-2026-88647: an SRV otherName whose value is not a
+ * valid IA5String (here an OCTET STRING) must still preclude the Common Name
+ * fallback in gnutls_x509_crt_check_hostname2().
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+#include <gnutls/gnutls.h>
+#include <gnutls/x509.h>
+
+#include "utils.h"
+
+#define SRV_OID "1.3.6.1.5.5.7.8.7"
+#define HOST "target.example"
+
+static gnutls_x509_crt_t make_cert(gnutls_x509_privkey_t key, int mode)
+{
+	gnutls_x509_crt_t crt;
+	int ret;
+
+	ret = gnutls_x509_crt_init(&crt);
+	if (ret < 0)
+		fail("crt_init: %s\n", gnutls_strerror(ret));
+
+	ret = gnutls_x509_crt_set_dn_by_oid(crt, GNUTLS_OID_X520_COMMON_NAME, 0,
+					    HOST, strlen(HOST));
+	if (ret < 0)
+		fail("set_dn_by_oid: %s\n", gnutls_strerror(ret));
+
+	if (mode == 1) {
+		/* SRV otherName carrying an OCTET STRING */
+		ret = gnutls_x509_crt_set_subject_alt_othername(
+			crt, SRV_OID, HOST, strlen(HOST),
+			GNUTLS_FSAN_SET | GNUTLS_FSAN_ENCODE_OCTET_STRING);
+		if (ret < 0)
+			fail("set_subject_alt_othername: %s\n",
+			     gnutls_strerror(ret));
+	} else if (mode == 2) {
+		/* well-formed SRV otherName (IA5String) */
+		ret = gnutls_x509_crt_set_subject_alt_name(
+			crt, GNUTLS_SAN_OTHERNAME_SRV, "_ldap." HOST,
+			strlen("_ldap." HOST), GNUTLS_FSAN_SET);
+		if (ret < 0)
+			fail("set_subject_alt_name: %s\n", gnutls_strerror(ret));
+	}
+
+	gnutls_x509_crt_set_version(crt, 3);
+	gnutls_x509_crt_set_serial(crt, "\x01", 1);
+	gnutls_x509_crt_set_activation_time(crt, 1000000000);
+	gnutls_x509_crt_set_expiration_time(crt, 2000000000);
+
+	ret = gnutls_x509_crt_set_key(crt, key);
+	if (ret < 0)
+		fail("set_key: %s\n", gnutls_strerror(ret));
+
+	ret = gnutls_x509_crt_sign2(crt, crt, key, GNUTLS_DIG_SHA256, 0);
+	if (ret < 0)
+		fail("sign2: %s\n", gnutls_strerror(ret));
+
+	return crt;
+}
+
+/* The SAN list consulted by gnutls_x509_crt_check_hostname2() is only
+ * populated when a certificate is imported, so round-trip the freshly
+ * built certificate through DER before checking it. */
+static gnutls_x509_crt_t reimport(gnutls_x509_crt_t in)
+{
+	gnutls_x509_crt_t out;
+	gnutls_datum_t der = { NULL, 0 };
+	int ret;
+
+	ret = gnutls_x509_crt_export2(in, GNUTLS_X509_FMT_DER, &der);
+	if (ret < 0)
+		fail("export2: %s\n", gnutls_strerror(ret));
+
+	ret = gnutls_x509_crt_init(&out);
+	if (ret < 0)
+		fail("crt_init: %s\n", gnutls_strerror(ret));
+
+	ret = gnutls_x509_crt_import(out, &der, GNUTLS_X509_FMT_DER);
+	if (ret < 0)
+		fail("import: %s\n", gnutls_strerror(ret));
+
+	gnutls_free(der.data);
+	gnutls_x509_crt_deinit(in);
+	return out;
+}
+
+void doit(void)
+{
+	gnutls_x509_privkey_t key;
+	gnutls_x509_crt_t crt;
+	int ret;
+
+	ret = global_init();
+	if (ret < 0)
+		fail("global_init: %s\n", gnutls_strerror(ret));
+
+	gnutls_x509_privkey_init(&key);
+	ret = gnutls_x509_privkey_generate(
+		key, GNUTLS_PK_ECDSA,
+		GNUTLS_CURVE_TO_BITS(GNUTLS_ECC_CURVE_SECP256R1), 0);
+	if (ret < 0)
+		fail("privkey_generate: %s\n", gnutls_strerror(ret));
+
+	/* control: only a CN, no SAN -> CN fallback still works */
+	crt = reimport(make_cert(key, 0));
+	if (!gnutls_x509_crt_check_hostname2(crt, HOST, 0))
+		fail("CN-only certificate should match\n");
+	gnutls_x509_crt_deinit(crt);
+
+	/* well-formed SRV otherName precludes CN fallback */
+	crt = reimport(make_cert(key, 2));
+	if (gnutls_x509_crt_check_hostname2(crt, HOST, 0))
+		fail("IA5String SRV otherName must disable CN fallback\n");
+	gnutls_x509_crt_deinit(crt);
+
+	/* malformed (OCTET STRING) SRV otherName must also preclude it */
+	crt = reimport(make_cert(key, 1));
+	if (gnutls_x509_crt_check_hostname2(crt, HOST, 0))
+		fail("OCTET STRING SRV otherName must disable CN fallback\n");
+	gnutls_x509_crt_deinit(crt);
+
+	gnutls_x509_privkey_deinit(key);
+	gnutls_global_deinit();
+
+	if (debug)
+		success("success\n");
+}
Description: Fix CVE-2026-95210 - reject malformed critical keyUsage/basicConstraints
 Path validation only checked that the OID of a critical extension was
 recognized, never that its value could be parsed. A certificate with a
 critical keyUsage whose value is an ASN.1 NULL (05 00) was reported as
 trusted although gnutls_x509_crt_get_key_usage() fails with
 GNUTLS_E_ASN1_TAG_ERROR. Parse the critical keyUsage and basicConstraints
 extensions in check_for_unknown_exts() and flag the certificate with
 GNUTLS_CERT_UNKNOWN_CRIT_EXTENSIONS when they cannot be decoded
 (RFC 5280, section 4.2).

Origin: ai-synthesized, CVE-2026-95210
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-11

--- a/lib/x509/verify.c
+++ b/lib/x509/verify.c
@@ -128,6 +128,38 @@
 				"Unsupported critical extension: %s\n", oid);
 			return 1;
 		}
+
+		/* RFC 5280, 4.2: a critical extension that cannot be
+		 * processed must cause the certificate to be rejected. Being
+		 * a recognized OID is not enough; make sure the value of the
+		 * critical extensions we rely upon is actually well formed.
+		 */
+		if (strcmp(oid, GNUTLS_X509EXT_OID_KEY_USAGE) == 0) {
+			unsigned int ku;
+
+			ret = gnutls_x509_crt_get_key_usage(cert, &ku, NULL);
+			if (ret < 0) {
+				gnutls_assert();
+				_gnutls_debug_log(
+					"Malformed critical extension: %s\n",
+					oid);
+				return 1;
+			}
+		} else if (strcmp(oid, GNUTLS_X509EXT_OID_BASIC_CONSTRAINTS) ==
+			   0) {
+			unsigned int is_ca;
+			int pathlen;
+
+			ret = gnutls_x509_crt_get_basic_constraints(
+				cert, NULL, &is_ca, &pathlen);
+			if (ret < 0) {
+				gnutls_assert();
+				_gnutls_debug_log(
+					"Malformed critical extension: %s\n",
+					oid);
+				return 1;
+			}
+		}
 	}
 
 	return 0;
