Description: Fix CVE-2026-67693 - reject certificates with an all-zero Key Usage
 A Key Usage extension that is present but has no bits set forbids every
 use of the certificate's key (RFC 5280, section 4.2.1.3 requires at least
 one bit to be set). The chain verifier never inspected Key Usage of the
 end-entity certificate, and only the EKU OIDs were compared in
 _gnutls_check_key_purpose(), so a leaf with an empty (critical) KU and
 EKU serverAuth was reported as trusted. Reject any certificate of the
 candidate chain whose Key Usage extension is present and empty, keeping
 the "extension absent" case unchanged.

Origin: ai-synthesized, CVE-2026-67693
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-11

--- a/lib/x509/verify.c
+++ b/lib/x509/verify.c
@@ -1027,6 +1027,26 @@
 		return status;
 	}
 
+	/* A Key Usage extension that is present but has no bits set forbids
+	 * any use of the key; it must not be treated like an absent
+	 * extension (which means "no restriction"). Reject such
+	 * certificates, as well as ones with an unparsable extension. */
+	for (i = 0; i < clist_size; i++) {
+		unsigned int ku_usage = 0;
+
+		ret = gnutls_x509_crt_get_key_usage(certificate_list[i],
+						    &ku_usage, NULL);
+		if (ret == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE)
+			continue;
+
+		if (ret < 0 || ku_usage == 0) {
+			gnutls_assert();
+			status |= GNUTLS_CERT_INVALID;
+			status |= GNUTLS_CERT_PURPOSE_MISMATCH;
+			return status;
+		}
+	}
+
 	memset(&vparams, 0, sizeof(vparams));
 	vparams.now = now;
 	vparams.max_path = MAX_VERIFY_DEPTH;
Description: Fix CVE-2026-95184 - enforce permitted name constraints of unsupported types
 check_unsupported_constraint() only consulted the excluded subtrees, so a
 critical permitted directoryName (or URI) name constraint was ignored and an
 end-entity outside the permitted subtree was accepted.
 .
 For directoryName, evaluate real subtree membership: the subject DN (or the
 DN passed to gnutls_x509_name_constraints_check()) must lie within at least
 one permitted directoryName subtree, otherwise it is rejected. Certificates
 that legitimately sit below a permitted DN keep verifying. For the remaining
 types GnuTLS cannot evaluate subtree membership, so fail closed when a
 permitted constraint of the checked type exists (URI only when the
 certificate carries a URI name).

Origin: ai-synthesized, CVE-2026-95184
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-11

--- a/lib/x509/name_constraints.c
+++ b/lib/x509/name_constraints.c
@@ -1314,9 +1314,123 @@
 
 	} while (ret == 0);
 
+	/* A permitted subtree of a type that cannot be evaluated here can
+	 * never be shown to contain the name, so fail closed rather than
+	 * silently accepting names outside of it (RFC5280, 4.2.1.10).
+	 */
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_permitted(
+			nc, i++, &rtype, &rname);
+		if (ret >= 0) {
+			if (rtype != type)
+				continue;
+			else
+				return gnutls_assert_val(0);
+		}
+
+	} while (ret == 0);
+
 	return 1;
 }
 
+/* Returns true if the RFC4514 string @dn lies within the directoryName
+ * subtree @base. Both strings are produced by the same formatter, which
+ * lists the most specific RDN first, so @base must be a suffix of @dn that
+ * starts on an RDN boundary (the whole string, or right after an unescaped
+ * comma). An empty @base covers every name.
+ */
+static unsigned dn_in_subtree(const gnutls_datum_t *dn,
+			      const gnutls_datum_t *base)
+{
+	size_t i, off, backslashes;
+	unsigned char a, b;
+
+	if (base->size == 0)
+		return 1;
+	if (dn->size < base->size)
+		return 0;
+
+	off = dn->size - base->size;
+	for (i = 0; i < base->size; i++) {
+		a = dn->data[off + i];
+		b = base->data[i];
+		if (a >= 'A' && a <= 'Z')
+			a += 'a' - 'A';
+		if (b >= 'A' && b <= 'Z')
+			b += 'a' - 'A';
+		if (a != b)
+			return 0;
+	}
+
+	if (off == 0)
+		return 1;
+
+	if (dn->data[off - 1] != ',')
+		return 0;
+
+	/* the comma must not be escaped */
+	backslashes = 0;
+	for (i = off - 1; i > 0 && dn->data[i - 1] == '\\'; i--)
+		backslashes++;
+
+	return (backslashes % 2) == 0;
+}
+
+/* Checks a directoryName against the DN constraints. @name is the RFC4514
+ * string of the name, or NULL when the certificate carries no subject DN
+ * (in which case only the historical excluded-subtree rejection applies).
+ *
+ * Returns: true if the name is acceptable, and false otherwise.
+ */
+static unsigned check_dn_constraints(gnutls_x509_name_constraints_t nc,
+				     const gnutls_datum_t *name)
+{
+	unsigned i;
+	int ret;
+	unsigned rtype;
+	unsigned permitted_found = 0;
+	gnutls_datum_t rname;
+
+	/* an excluded directoryName rejects, as for other unsupported types */
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_excluded(nc, i++, &rtype,
+								&rname);
+		if (ret >= 0) {
+			if (rtype != GNUTLS_SAN_DN)
+				continue;
+			else
+				return gnutls_assert_val(0);
+		}
+
+	} while (ret == 0);
+
+	if (name == NULL)
+		return 1;
+
+	/* the name must lie within at least one permitted subtree */
+	i = 0;
+	do {
+		ret = gnutls_x509_name_constraints_get_permitted(
+			nc, i++, &rtype, &rname);
+		if (ret >= 0) {
+			if (rtype != GNUTLS_SAN_DN)
+				continue;
+
+			permitted_found = 1;
+			if (dn_in_subtree(name, &rname))
+				return 1;
+		}
+
+	} while (ret == 0);
+
+	if (permitted_found != 0)
+		return gnutls_assert_val(0);
+
+	return 1;
+}
+
 static unsigned check_dns_constraints(gnutls_x509_name_constraints_t nc,
 				      const gnutls_datum_t *name)
 {
@@ -1507,6 +1621,9 @@
 	if (type == GNUTLS_SAN_IPADDRESS)
 		return check_ip_constraints(nc, name);
 
+	if (type == GNUTLS_SAN_DN)
+		return check_dn_constraints(nc, name);
+
 	return check_unsupported_constraint(nc, type);
 }
 
@@ -1762,6 +1879,20 @@
 		}
 	} else if (type == GNUTLS_SAN_URI) {
 		return check_unsupported_constraint2(cert, nc, type);
+	} else if (type == GNUTLS_SAN_DN) {
+		gnutls_datum_t dn = { NULL, 0 };
+
+		ret = gnutls_x509_crt_get_dn3(cert, &dn, 0);
+		if (ret == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE) {
+			/* no subject DN to check */
+			return check_dn_constraints(nc, NULL);
+		} else if (ret < 0) {
+			return gnutls_assert_val(0);
+		}
+
+		t = check_dn_constraints(nc, &dn);
+		gnutls_free(dn.data);
+		return t;
 	} else
 		return check_unsupported_constraint(nc, type);
 }
Description: Fix CVE-2026-88647 - SRV otherName with non-IA5String value fails to suppress CN fallback
 gnutls_x509_crt_check_hostname2() only treated otherNames that were
 successfully decoded into the virtual type GNUTLS_SAN_OTHERNAME_SRV as
 precluding the Common Name fallback. An SRV otherName (OID 1.3.6.1.5.5.7.8.7)
 carrying a value that is not a valid IA5String (e.g. an OCTET STRING) is
 reported as a generic GNUTLS_SAN_OTHERNAME, so the CN was still consulted and
 could match the requested hostname. Detect the SRV OID for generic otherNames
 and disable the CN fallback (failing closed if the OID cannot be read).
 A regression test is included.

Origin: ai-synthesized, CVE-2026-88647
Author: Root.io Novel Patcher <security@root.io>
Last-Update: 2026-10-12

--- a/lib/x509/hostname-verify.c
+++ b/lib/x509/hostname-verify.c
@@ -230,6 +230,26 @@
 		if (PRECLUDES_CN_FALLBACK(ret))
 			cn_fallback_allowed = false;
 
+		if (ret == GNUTLS_SAN_OTHERNAME) {
+			/* An SRV otherName whose value could not be decoded as
+			 * an IA5String (e.g., an OCTET STRING) is reported as
+			 * a generic otherName; it must still preclude the CN
+			 * fallback, as a well-formed SRV otherName does. If the
+			 * OID cannot be determined, fail closed. */
+			char oid[MAX_OID_SIZE];
+			size_t oid_size = sizeof(oid);
+			int oid_ret;
+
+			oid_ret = gnutls_x509_crt_get_subject_alt_othername_oid(
+				cert, i, oid, &oid_size);
+			if (oid_ret < 0 || oid_ret == GNUTLS_SAN_OTHERNAME_SRV ||
+			    strcmp(oid, SRV_OID) == 0) {
+				_gnutls_debug_log(
+					"SRV otherName present, disabling CN fallback\n");
+				cn_fallback_allowed = false;
+			}
+		}
+
 		if (ret == GNUTLS_SAN_DNSNAME) {
 			if (memchr(dnsname, '\0', dnsnamesize)) {
 				_gnutls_debug_log(
