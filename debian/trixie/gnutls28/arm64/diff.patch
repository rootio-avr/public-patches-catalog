+	"hP16crOLdwMTvDmXOlaWD/9+ItWw1P3wOTwWRK2RbdvheISZZ/RgmB6MPF5A1keg\n"
+	"I6rvD95jreEjU0rXTMc6KaqKzICiPk4aE49rqbxNvowvKHQghQIYbOp4vYMxn3Gv\n"
+	"WWk+eZL8myRQATPwtru1RvJtnS2QHrRT0AMhX+ObuIX6VSsGppZ79g==\n"
+	"-----END CERTIFICATE-----\n";
+
+static gnutls_x509_crt_t load(const char *pem)
+{
+	gnutls_x509_crt_t crt;
+	gnutls_datum_t d;
+
+	d.data = (unsigned char *)pem;
+	d.size = strlen(pem);
+	if (gnutls_x509_crt_init(&crt) < 0)
+		exit(1);
+	if (gnutls_x509_crt_import(crt, &d, GNUTLS_X509_FMT_PEM) < 0) {
+		fprintf(stderr, "import failed\n");
+		exit(1);
+	}
+	return crt;
+}
+
+int main(void)
+{
+	gnutls_x509_crt_t ca = load(ca_pem);
+	gnutls_x509_crt_t leaf = load(leaf_pem);
+	unsigned int status = 0;
+	unsigned int ku;
+	int ret;
+
+	/* sanity: the accessor reports the malformed value */
+	ret = gnutls_x509_crt_get_key_usage(leaf, &ku, NULL);
+	if (ret >= 0) {
+		fprintf(stderr, "expected key usage parse error\n");
+		return 1;
+	}
+
+	/* (a) the malformed critical keyUsage must not verify as trusted */
+	ret = gnutls_x509_crt_verify(leaf, &ca, 1, 0, &status);
+	if (ret < 0 || status == 0 ||
+	    !(status & GNUTLS_CERT_INVALID) ||
+	    !(status & GNUTLS_CERT_UNKNOWN_CRIT_EXTENSIONS)) {
+		fprintf(stderr, "malformed critical keyUsage accepted (%u)\n",
+			status);
+		return 1;
+	}
+
+	/* (b) a well-formed certificate (the CA) still verifies */
+	status = 0;
+	ret = gnutls_x509_crt_verify(ca, &ca, 1, 0, &status);
+	if (ret < 0 || status != 0) {
+		fprintf(stderr, "valid self-signed CA rejected (%u)\n", status);
+		return 1;
+	}
+
+	gnutls_x509_crt_deinit(leaf);
+	gnutls_x509_crt_deinit(ca);
+	return 0;
+}
