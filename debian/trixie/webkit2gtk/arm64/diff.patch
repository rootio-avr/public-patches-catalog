@@ -895,7 +897,32 @@
     JSC::JSLockHolder locker(globalObject);
 
     JSValueRef exception = nullptr;
-    Vector<JSValueRef> arguments;
+
+    // The JSValueRef values produced while converting the variadic parameters must stay
+    // reachable by the garbage collector for the whole duration of the call: converting a
+    // later parameter can allocate and trigger a collection that would otherwise free an
+    // earlier, still-referenced argument (CVE-2026-78376, use-after-free). Accumulate the
+    // arguments in a JSC::MarkedJSValueRefArray, which roots every slot for the GC. That
+    // container needs its element count up front, so first walk a copy of the va_list to
+    // count the parameters (advancing past each collected value with G_VALUE_COLLECT_SKIP)
+    // and only then collect and convert them into the rooted buffer.
+    unsigned parameterCount = 0;
+    {
+        va_list argsCopy;
+        va_copy(argsCopy, args);
+        GType countType = firstParameterType;
+        WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN // GLib port
+        while (countType != G_TYPE_NONE) {
+            G_VALUE_COLLECT_SKIP(countType, argsCopy);
+            ++parameterCount;
+            countType = va_arg(argsCopy, GType);
+        }
+        WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+        va_end(argsCopy);
+    }
+
+    JSC::MarkedJSValueRefArray arguments(jsContext, parameterCount);
+    unsigned argumentIndex = 0;
     GType parameterType = firstParameterType;
     while (parameterType != G_TYPE_NONE) {
