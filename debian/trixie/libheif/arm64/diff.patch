+void ImageItem_uncompressed::remember_prototype_configuration(const std::shared_ptr<const HeifPixelImage>& prototype,
+                                                              uint32_t tile_width, uint32_t tile_height)
+{
+  m_prototype_configuration_known = true;
+  m_prototype_colorspace = prototype->get_colorspace();
+  m_prototype_chroma = prototype->get_chroma_format();
+  m_prototype_tile_width = tile_width;
+  m_prototype_tile_height = tile_height;
+
+  m_prototype_channels.clear();
+  for (heif_channel channel : prototype->get_channel_set()) {
+    prototype_channel pc{};
+    pc.channel = channel;
+    pc.width = prototype->get_width(channel);
+    pc.height = prototype->get_height(channel);
+    pc.bits_per_pixel = prototype->get_bits_per_pixel(channel);
+    m_prototype_channels.push_back(pc);
+  }
+}
