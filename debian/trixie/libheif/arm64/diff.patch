+Error ImageItem_uncompressed::check_component_sizes(const std::shared_ptr<const HeifPixelImage>& image)
+{
+  // The tile encoder (encode_image_tile()) sizes its output buffer from the primary image
+  // dimensions, but copies each component plane using that plane's actual size. If a component
+  // plane is larger than implied by the image dimensions (e.g. an alpha plane that does not match
+  // the color planes), this writes out of bounds. Reject any image whose component planes are
+  // inconsistent with its own dimensions. Chroma (Cb/Cr) planes are legitimately subsampled, so
+  // they are checked against the subsampled size.
+
+  uint32_t image_width = image->get_width();
+  uint32_t image_height = image->get_height();
+  heif_chroma chroma = image->get_chroma_format();
+
+  for (heif_channel channel : image->get_channel_set()) {
+    uint32_t expected_width = image_width;
+    uint32_t expected_height = image_height;
+
+    if (channel == heif_channel_Cb || channel == heif_channel_Cr) {
+      if (chroma == heif_chroma_420) {
+        expected_width = (image_width + 1) / 2;
+        expected_height = (image_height + 1) / 2;
+      }
+      else if (chroma == heif_chroma_422) {
+        expected_width = (image_width + 1) / 2;
+      }
+    }
+
+    if (image->get_width(channel) != expected_width ||
+        image->get_height(channel) != expected_height) {
+      return {heif_error_Invalid_input,
+              heif_suberror_Unspecified,
+              "Image component plane size does not match the image dimensions"};
+    }
+  }
+
+  return Error::Ok;
+}
+
+
+Error ImageItem_uncompressed::check_tile_image_compatibility(const std::shared_ptr<const HeifPixelImage>& image) const
+{
+  // encode_image_tile() derives the layout of the encoded tile (which planes to copy, their
+  // subsampling and their bytes-per-pixel) from the configuration that was frozen when this item
+  // was created from the prototype image. The tiled writing path hands us independently
+  // constructed images, so every one of them has to be validated against that frozen
+  // configuration. Otherwise the encoder sizes its output buffer according to the prototype while
+  // copying from planes with a different layout, which writes outside the buffer (GHSA-j264-xvrp-5v7q).
+
+  auto incompatible = []() {
+    return Error{heif_error_Invalid_input,
+                 heif_suberror_Unspecified,
+                 "Image does not match the component configuration of the uncompressed image it is added to"};
+  };
+
+  if (!m_prototype_configuration_known) {
+    // The item was not created through add_unci_item() (e.g. loaded from a file). We cannot know
+    // the intended configuration, so fall back to a self-consistency check only.
+    return check_component_sizes(image);
+  }
+
+  // The subsampling factors and the number of bytes per pixel are taken from the prototype image.
+  if (image->get_colorspace() != m_prototype_colorspace ||
+      image->get_chroma_format() != m_prototype_chroma) {
+    return incompatible();
+  }
+
+  // Reject tiles whose size differs from the tile size of the image. The write offset is computed
+  // from the size of the passed image, so a differently sized tile would end up at a wrong offset
+  // and be silently truncated by Box_iloc::replace_data.
+  if (image->get_width() != m_prototype_tile_width ||
+      image->get_height() != m_prototype_tile_height) {
+    return incompatible();
+  }
+
+  // The encoder addresses the component planes by channel and uses the prototype's bit depths to
+  // compute the output size. The tile has to carry exactly the same channels with the same bit
+  // depths and no extra ones that would be silently dropped.
+  std::set<heif_channel> tile_channels = image->get_channel_set();
+
+  if (tile_channels.size() != m_prototype_channels.size()) {
+    return incompatible();
+  }
+
+  for (const prototype_channel& pc : m_prototype_channels) {
+    if (!image->has_channel(pc.channel) ||
+        image->get_bits_per_pixel(pc.channel) != pc.bits_per_pixel) {
+      return incompatible();
+    }
+  }
+
+  // Finally make sure the tile's planes are consistent with its own dimensions.
+  return check_component_sizes(image);
+}
