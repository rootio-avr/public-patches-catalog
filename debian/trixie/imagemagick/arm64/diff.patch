+++ b/MagickCore/fx.c
@@ -871,7 +871,7 @@ static char * SetPtrShortExp (FxInfo * p
   *pfx->ShortExp = '\0';

   if (pExp && len) {
-    slen = CopyMagickString (pfx->ShortExp, pExp, len);
+    slen = CopyMagickString (pfx->ShortExp, pExp, MagickPathExtent);
     if (slen > MaxLen) { 
       (void) CopyMagickString (pfx->ShortExp+MaxLen, "...", 4);
     }
