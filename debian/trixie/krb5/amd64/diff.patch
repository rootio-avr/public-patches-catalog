Description: CVE-2026-112320 - Fix RPC leak when client switches from RPCSEC_GSS
 svc_do_xprt() retains xp_auth across calls for RPCSEC_GSS.  If the client
 switches to a different auth flavor on the same connection, the previous
 RPCSEC_GSS auth context must be destroyed or the new auth handler will
 overwrite it and leak its contents, allowing remote memory exhaustion of
 kadmind.
Origin: upstream, https://github.com/krb5/krb5/commit/c4288c4a2fd477f60b9390ca5a7db442055e679b
Author: Julien Rische <jrische@redhat.com>
Last-Update: 2026-11-12
---
--- a/src/lib/rpc/svc_auth.c
+++ b/src/lib/rpc/svc_auth.c
@@ -39,6 +39,8 @@
 
 #include <gssrpc/rpc.h>
 
+extern struct svc_auth_ops svc_auth_gss_ops;
+
 /*
  * Server side authenticators are called from authenticate by
  * using the client auth struct flavor field to index into svcauthsw.
@@ -93,6 +95,16 @@ gssrpc__authenticate(
 	rqst->rq_xprt->xp_verf.oa_length = 0;
 	cred_flavor = rqst->rq_cred.oa_flavor;
 	*no_dispatch = FALSE;
+
+	/* xp_auth is currently retained across calls for RPCSEC_GSS.  If the
+	 * client switched to a different auth flavor, destroy it. */
+	if (rqst->rq_xprt->xp_auth != NULL &&
+	    rqst->rq_xprt->xp_auth->svc_ah_ops == &svc_auth_gss_ops &&
+	    cred_flavor != RPCSEC_GSS) {
+	    SVCAUTH_DESTROY(rqst->rq_xprt->xp_auth);
+	    rqst->rq_xprt->xp_auth = NULL;
+	}
+
 	for (i = 0; i < svcauthnum; i++) {
 	     if (cred_flavor == svcauthsw[i].flavor &&
 		 svcauthsw[i].authenticator != NULL) {
Description: CVE-2026-11850 - Prevent read overrun in libkdb_ldap berval2tl_data
 In berval2tl_data(), reject inputs of length less than 2 to prevent an
 integer underflow and subsequent read overrun. When bv_len is 0 or 1,
 the unsigned subtraction (bv_len - 2) wraps to a large value which is
 then truncated to uint16_t, causing a subsequent malloc to succeed
 while memcpy reads up to 65534 bytes from a 0-1 byte buffer - a heap
 out-of-bounds read. (The security impact is negligible as the attacker
 would have to control the KDB LDAP server.)
Origin: upstream, https://github.com/krb5/krb5/commit/2a5fd83d4436583f2ddc0e193269a4d800ee45c4
Author: Sebastián Alba <sebasjosue84@gmail.com>
Last-Update: 2026-07-14

--- a/src/plugins/kdb/ldap/libkdb_ldap/ldap_principal2.c
+++ b/src/plugins/kdb/ldap/libkdb_ldap/ldap_principal2.c
@@ -80,6 +80,9 @@ getstringtime(krb5_timestamp);
 krb5_error_code
 berval2tl_data(struct berval *in, krb5_tl_data **out)
 {
+    if (in->bv_len < 2)
+        return EINVAL;
+
     *out = (krb5_tl_data *) malloc (sizeof (krb5_tl_data));
     if (*out == NULL)
         return ENOMEM;
Description: CVE-2026-119079 - Avoid repeated reallocation when decoding ASN.1
 In decode_sequence_of(), make a first pass over the tags to count and
 validate the elements, allowing the array to be allocated once instead
 of reallocated for each element.  Previously an unauthenticated attacker
 could cause the KDC or an application server to consume a large amount
 of CPU time decoding ASN.1 protocol elements by sending a long sequence.
Origin: upstream, https://github.com/krb5/krb5/commit/782e5ac4fb1496a79de0b87e1fc485f897e97d6d
Author: Greg Hudson <ghudson@mit.edu>
Last-Update: 2026-11-11
---
--- a/src/lib/krb5/asn.1/asn1_encode.c
+++ b/src/lib/krb5/asn.1/asn1_encode.c
@@ -1460,40 +1460,42 @@ decode_sequence_of(const uint8_t *asn1,
                    size_t *count_out)
 {
     krb5_error_code ret;
-    void *seq = NULL, *elem, *newseq;
-    const uint8_t *contents;
-    size_t clen, count = 0;
+    void *seq = NULL, *elem;
+    const uint8_t *p, *contents;
+    size_t l, clen, count = 0, n = 0;
     taginfo t;
 
     *seq_out = NULL;
     *count_out = 0;
-    while (len > 0) {
+
+    /* Count the elements in the sequence and check their tags. */
+    for (p = asn1, l = len, count = 0; l > 0; count++) {
+        ret = get_tag(p, l, &t, &contents, &clen, &p, &l);
+        if (ret)
+            return ret;
+        if (!check_atype_tag(elemtype, &t))
+            return ASN1_BAD_ID;
+    }
+
+    seq = k5calloc(count, elemtype->size, &ret);
+    if (seq == NULL)
+        return ret;
+
+    for (n = 0; n < count; n++) {
         ret = get_tag(asn1, len, &t, &contents, &clen, &asn1, &len);
         if (ret)
             goto error;
-        if (!check_atype_tag(elemtype, &t)) {
-            ret = ASN1_BAD_ID;
-            goto error;
-        }
-        newseq = realloc(seq, (count + 1) * elemtype->size);
-        if (newseq == NULL) {
-            ret = ENOMEM;
-            goto error;
-        }
-        seq = newseq;
-        elem = (char *)seq + count * elemtype->size;
-        memset(elem, 0, elemtype->size);
+        elem = (char *)seq + n * elemtype->size;
         ret = decode_atype(&t, contents, clen, elemtype, elem);
         if (ret)
             goto error;
-        count++;
     }
     *seq_out = seq;
     *count_out = count;
     return 0;
 
 error:
-    free_sequence_of(elemtype, seq, count);
+    free_sequence_of(elemtype, seq, n);
     free(seq);
     return ret;
 }
Description: CVE-2026-112314 - Fix leak in RPC client on mismatched ID
 In clnttcp_call(), before decoding a reply, free the verifier in
 reply_msg if one was allocated when decoding a previous reply.  This
 prevents a memory leak in GSS-RPC client programs when RPC replies with
 mismatched XIDs are received or authentication retries are triggered.
Origin: upstream, https://github.com/krb5/krb5/commit/aac40ec59fd4ffa126e19749e85ddb913892fe53
Author: Julien Rische <jrische@redhat.com>
Last-Update: 2026-11-05
---
--- a/src/lib/rpc/clnt_tcp.c
+++ b/src/lib/rpc/clnt_tcp.c
@@ -254,7 +254,7 @@ clnttcp_call(
 {
 	struct ct_data *ct = h->cl_private;
 	XDR *xdrs = &ct->ct_xdrs;
-	struct rpc_msg reply_msg;
+	struct rpc_msg reply_msg = { 0 };
 	uint32_t x_id;
 	uint32_t *msg_x_id = &ct->ct_u.ct_mcalli;	/* yuk */
 	bool_t shipnow;
@@ -299,6 +299,11 @@ call_again:
 	 */
 	xdrs->x_op = XDR_DECODE;
 	while (TRUE) {
+		/* Free verifier buffer if set from previous decode. */
+		if (reply_msg.rm_reply.rp_stat == MSG_ACCEPTED) {
+		    xdr_free((xdrproc_t)xdr_opaque_auth,
+			     &reply_msg.acpted_rply.ar_verf);
+		}
 		reply_msg.acpted_rply.ar_verf = gssrpc__null_auth;
 		reply_msg.acpted_rply.ar_results.where = NULL;
 		reply_msg.acpted_rply.ar_results.proc = xdr_void;
