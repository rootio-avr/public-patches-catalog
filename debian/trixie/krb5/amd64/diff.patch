Description: CVE-2026-112321 - Free call_arg on all AUTH_GSSAPI exit paths
 In gssrpc__svcauth_gssapi(), ensure that call_arg is released along
 all exit paths by zero-initializing it at function entry and freeing it
 in the error handler.  Previously, decoded arguments leaked on certain
 error paths, allowing remote attackers to exhaust kadmind memory via
 crafted AUTH_GSSAPI_INIT requests that trigger authentication failures.
Origin: upstream, https://github.com/krb5/krb5/commit/89ea06778fe893a8fdad483f7716fe8309521603
Author: Julien Rische <jrische@redhat.com>
Last-Update: 2026-11-11
---
--- a/src/lib/rpc/svc_auth_gssapi.c
+++ b/src/lib/rpc/svc_auth_gssapi.c
@@ -181,6 +181,7 @@
      /* use AUTH_NONE until there is a client_handle */
      rqst->rq_xprt->xp_auth = &svc_auth_none;
 
+     memset(&call_arg, 0, sizeof(call_arg));
      memset(&call_res, 0, sizeof(call_res));
      creds.client_handle.length = 0;
      creds.client_handle.value = NULL;
@@ -305,7 +306,6 @@
 	  }
 
 	  /* call is for us, deserialize arguments */
-	  memset(&call_arg, 0, sizeof(call_arg));
 	  if (! svc_getargs(rqst->rq_xprt, xdr_authgssapi_init_arg,
 			    &call_arg)) {
 	       PRINTF(("svcauth_gssapi: cannot decode args\n"));
@@ -445,8 +445,9 @@
 	  gssstat = call_res.gss_major;
 	  minor_stat = call_res.gss_minor;
 
-	  /* done with call args */
+	  /* Done with call_arg (it may be reused for AUTH_GSSAPI_MSG). */
 	  xdr_free(xdr_authgssapi_init_arg, &call_arg);
+	  memset(&call_arg, 0, sizeof(call_arg));
 
 	  PRINTF(("svcauth_gssapi: accept_sec_context returned %#x %#x\n",
 		  call_res.gss_major, call_res.gss_minor));
@@ -582,12 +583,10 @@
 	       switch (rqst->rq_proc) {
 	       case AUTH_GSSAPI_MSG:
 		    PRINTF(("svcauth_gssapi: GSSAPI_MSG, getting args\n"));
-		    memset(&call_arg, 0, sizeof(call_arg));
 		    if (! svc_getargs(rqst->rq_xprt, xdr_authgssapi_init_arg,
 				      &call_arg)) {
 			 PRINTF(("svcauth_gssapi: cannot decode args\n"));
 			 LOG_MISCERR("protocol error in call arguments");
-			 xdr_free(xdr_authgssapi_init_arg, &call_arg);
 			 ret = AUTH_BADCRED;
 			 goto error;
 		    }
@@ -648,6 +647,7 @@
      return AUTH_OK;
 
 error:
+     xdr_free(xdr_authgssapi_init_arg, &call_arg);
      if (creds.client_handle.length != 0) {
 	  PRINTF(("svcauth_gssapi: freeing client_handle len %d\n",
 		  (int) creds.client_handle.length));
Description: CVE-2026-107778 - Avoid null dereference in krb5_rd_cred()
 A malformed KRB-CRED message may have fewer entries in the encrypted
 ticket-info list than it has in the tickets list.  In each loop
 iteration of make_cred_list(), check whether the end of the ticket-info
 list was unexpectedly reached to avoid a null pointer dereference.
Origin: upstream, https://github.com/krb5/krb5/commit/48afa9abb89ab2176bb20624d87d010b9984fc08
Author: TristanInSec <tristan.mtn@gmail.com>
Last-Update: 2026-10-11
---
--- a/src/lib/krb5/krb/rd_cred.c
+++ b/src/lib/krb5/krb/rd_cred.c
@@ -98,6 +98,11 @@ make_cred_list(krb5_context context, krb5_cred *krbcred,
             goto cleanup;
 
         info = encpart->ticket_info[i];
+        if (info == NULL) {
+            /* We unexpectedly reached the end of the encrypted ticket info. */
+            ret = KRB5KRB_AP_ERR_MODIFIED;
+            goto cleanup;
+        }
         ret = krb5_copy_principal(context, info->client, &list[i]->client);
         if (ret)
             goto cleanup;
Description: CVE-2026-112323 - Disable GSSRPC AUTH_GSSAPI flavor by default
 The AUTH_GSSAPI handler in lib/rpc/svc_auth_gssapi.c allows remote attackers
 to cause a denial of service (memory exhaustion in kadmind) by sending
 repeated failed AUTH_GSSAPI_INIT requests, since each failed request
 allocates client state that is only freed after a 15-minute timeout.
 AUTH_GSSAPI has been superseded by RPCSEC_GSS since release 1.4, so reject
 it with AUTH_REJECTEDCRED unless GSSRPC_ALLOW_AUTH_GSSAPI is set in the
 environment. Also covers CVE-2026-112322.
Origin: upstream, https://github.com/krb5/krb5/commit/8aab893c6eb17125e1518f9926bc3593cf19303c
Author: Julien Rische <jrische@redhat.com>
Last-Update: 2026-11-11
