@@ -273,7 +273,7 @@ struct LEX_USER: public AUTHID
   USER_AUTH *auth;
   bool has_auth()
   {
-    return auth && (auth->plugin.length || auth->auth_str.length || auth->pwtext.length);
+    return auth;
   }
 };
 
