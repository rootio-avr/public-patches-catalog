+static bool is_legacy_server_option(const LEX_CSTRING *name)
+{
+  static const LEX_CSTRING legacy[]=
+  {
+    { STRING_WITH_LEN("user") },     { STRING_WITH_LEN("host") },
+    { STRING_WITH_LEN("database") }, { STRING_WITH_LEN("owner") },
+    { STRING_WITH_LEN("password") }, { STRING_WITH_LEN("socket") },
+    { STRING_WITH_LEN("port") }
+  };
+  for (size_t i= 0; i < array_elements(legacy); i++)
+  {
+    if (name->length == legacy[i].length &&
+        !my_strnncoll(&my_charset_latin1, (const uchar*) name->str, name->length,
+                      (const uchar*) legacy[i].str, legacy[i].length))
+      return true;
+  }
+  return false;
+}
