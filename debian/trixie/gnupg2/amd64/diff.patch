Description: CVE-2025-68972 - Fix form feed detection in cleartext signature verification
 In GnuPG through 2.4.8, if a signed message has \f (form feed) at the end
 of a plaintext line, an adversary can construct a modified message that
 places additional text after the signed material, such that signature
 verification succeeds. This occurs because armor.c inserts form feed to
 mark truncated lines (commit 976e9d608, Nov 2022) but plaintext.c does not
 detect it during signature hash calculation.
 .
 This patch adds form feed detection in the cleartext signature hash
 calculation in plaintext.c. When form feed is encountered (indicating a
 truncated line from armor.c), it is included in the hash calculation to
 ensure that any modification after the truncated line will cause signature
 verification to fail.
Origin: upstream, mailing list submission (http://www.mail-archive.com/gnupg-devel@gnupg.org/msg00710.html)
Author: Werner Koch <wk@gnupg.org>
Last-Update: 2026-01-15

--- a/g10/plaintext.c
+++ b/g10/plaintext.c
@@ -439,7 +439,9 @@ handle_plaintext (PKT_plaintext * pt, md_filter_context_t * mfx,
 	}
       pt->buf = NULL;
     }
-  else /* Clear text signature - don't hash the last CR,LF.   */
+  else /* Clear text signature - don't hash the last CR,LF.
+        * Also detect form feed which indicates a truncated line
+        * inserted by armor.c for overlong lines.  */
     {
       int state = 0;

@@ -476,6 +478,14 @@ handle_plaintext (PKT_plaintext * pt, md_filter_context_t * mfx,
 		state = 1;
 	      else if (c == '\n')
 		state = 2;
+	      else if (c == '\f')
+		{
+		  /* Form feed indicates a truncated line from armor.c.
+		   * Include it in the hash to ensure signature verification
+		   * fails if content after the truncated line is modified.  */
+		  gcry_md_putc (mfx->md, c);
+		  state = 2;  /* Treat as end of line */
+		}
 	      else
 		gcry_md_putc (mfx->md, c);
 	    }
@@ -483,6 +493,13 @@ handle_plaintext (PKT_plaintext * pt, md_filter_context_t * mfx,
 	    {
 	      if (c == '\n')
 		state = 2;
+	      else if (c == '\f')
+		{
+		  /* Form feed after CR - hash both CR and FF */
+		  gcry_md_putc (mfx->md, '\r');
+		  gcry_md_putc (mfx->md, c);
+		  state = 2;  /* Treat as end of line */
+		}
 	      else
 		{
 		  gcry_md_putc (mfx->md, '\r');
Description: CVE-2026-24882 - Fix possible buffer overflow in PKDECRYPT
 The tpm2_ecc_decrypt and tpm2_rsa_decrypt functions did not properly
 validate the length of the ciphertext parameter before processing,
 which could lead to a buffer overflow. This patch adds bounds checking
 to both functions to ensure the ciphertext length does not exceed the
 maximum key size supported by the TPM2 stack.
Origin: upstream, commit:93fa34d9a346020355cd51d54102d30d4f177323
Author: Werner Koch <wk@gnupg.org>
Last-Update: 2026-01-30

--- a/tpm2d/tpm2.c
+++ b/tpm2d/tpm2.c
@@ -917,10 +917,20 @@ tpm2_ecc_decrypt (ctrl_t ctrl, TSS_CONTEXT *tssc, TPM_HANDLE key,
   size_t len;
   int ret;

+#if defined(TPM2_MAX_ECC_KEY_BYTES) /* Intel stack */
+  if (ciphertext_len > 2*TPM2_MAX_ECC_KEY_BYTES + 1)
+    return GPG_ERR_TOO_LARGE;
+#elif defined(MAX_ECC_KEY_BYTES)    /* IBM stack */
+  if (ciphertext_len > 2*MAX_ECC_KEY_BYTES + 1)
+    return GPG_ERR_TOO_LARGE;
+#else
+# error TMP2 header are not correctly installed
+#endif
+
   /* This isn't really a decryption per se.  The ciphertext actually
    * contains an EC Point which we must multiply by the private key number.
    *
-   * The reason is to generate a diffe helman agreement on a shared
+   * The reason is to generate a diffie-hellman agreement on a shared
    * point.  This shared point is then used to generate the per
    * session encryption key.
    */
@@ -976,6 +986,16 @@ tpm2_rsa_decrypt (ctrl_t ctrl, TSS_CONTEXT *tssc, TPM_HANDLE key,
   TPM_HANDLE ah;
   char *auth;

+#if defined(TPM2_MAX_RSA_KEY_BYTES)  /* Intel stack */
+  if (ciphertext_len > TPM2_MAX_RSA_KEY_BYTES)
+    return GPG_ERR_TOO_LARGE;
+#elif defined(MAX_RSA_KEY_BYTES)     /* IBM stack */
+  if (ciphertext_len > MAX_RSA_KEY_BYTES)
+    return GPG_ERR_TOO_LARGE;
+#else
+# error TMP2 header are not correctly installed
+#endif
+
   inScheme.scheme = TPM_ALG_RSAES;
