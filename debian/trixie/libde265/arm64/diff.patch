Description: CVE-2026-88373 - validate passed NAL header length
 A NAL unit pushed via de265_push_NAL() / NAL_Parser::push_NAL() was not
 validated to contain at least its two-byte NAL unit header. A zero-length
 (or negative) NAL unit resulted in a memcpy() with a NULL destination
 pointer (CWE-476) and, once queued, would fail header parsing in
 decode_NAL() and abort decoding of the stream. This fix rejects any NAL
 shorter than two bytes in push_NAL() with the new
 DE265_ERROR_INVALID_ARGUMENT error before touching any state, and guards
 the NAL_unit::append() / NAL_unit::set_data() memcpy() calls against a
 zero-length copy.
 .
 Backport note: target v1.0.15 does not carry the later
 DE265_ERROR_IMAGE_SIZE_EXCEEDS_SECURITY_LIMIT / _NAL_SIZE_ error values,
 so the new DE265_ERROR_INVALID_ARGUMENT enumerator is appended as the
 trailing value =19 (upstream appends it as =21) and its de265_get_error_text()
 case is placed after DE265_ERROR_IMAGE_BUFFER_FULL. The behaviour is
 identical to upstream commit f8d3249.
Origin: upstream, https://github.com/strukturag/libde265/commit/f8d324914e43d92af23614f22959cf9eee7bf9ea
Author: Dirk Farin <dirk.farin@gmail.com>
Last-Update: 2026-09-27
---
--- a/libde265/de265.cc
+++ b/libde265/de265.cc
@@ -82,6 +82,7 @@
   case DE265_ERROR_OUT_OF_MEMORY: return "out of memory";
   case DE265_ERROR_CODED_PARAMETER_OUT_OF_RANGE: return "coded parameter out of range";
   case DE265_ERROR_IMAGE_BUFFER_FULL: return "DPB/output queue full";
+  case DE265_ERROR_INVALID_ARGUMENT: return "invalid argument";
   case DE265_ERROR_CANNOT_START_THREADPOOL: return "cannot start decoding threads";
   case DE265_ERROR_LIBRARY_INITIALIZATION_FAILED: return "global library initialization failed";
   case DE265_ERROR_LIBRARY_NOT_INITIALIZED: return "cannot free library data (not initialized";
--- a/libde265/de265.h
+++ b/libde265/de265.h
@@ -103,6 +103,7 @@
   DE265_ERROR_NO_INITIAL_SLICE_HEADER=16,
   DE265_ERROR_PREMATURE_END_OF_SLICE=17,
   DE265_ERROR_UNSPECIFIED_DECODING_ERROR=18,
+  DE265_ERROR_INVALID_ARGUMENT=19,

   // --- errors that should become obsolete in later libde265 versions ---

@@ -257,6 +258,9 @@
 /* Push a complete NAL unit without startcode into the decoder. The data must still
    contain all stuffing-bytes.
    This function only pushes data into the decoder, nothing will be decoded.
+   The NAL unit must at least contain the two-byte NAL unit header. A shorter
+   (or negative) length is rejected with DE265_ERROR_INVALID_ARGUMENT and nothing
+   is pushed.
 */
 LIBDE265_API de265_error de265_push_NAL(de265_decoder_context*, const void* data, int length,
                                         de265_PTS pts, void* user_data);
--- a/libde265/nal-parser.cc
+++ b/libde265/nal-parser.cc
@@ -82,7 +82,9 @@
   if (!resize(data_size + n)) {
     return false;
   }
-  memcpy(nal_data + data_size, in_data, n);
+  if (n > 0) {
+    memcpy(nal_data + data_size, in_data, n);
+  }
   data_size += n;
   return true;
 }
@@ -92,7 +94,9 @@
   if (!resize(n)) {
     return false;
   }
-  memcpy(nal_data, in_data, n);
+  if (n > 0) {
+    memcpy(nal_data, in_data, n);
+  }
   data_size = n;
   return true;
 }
@@ -373,6 +377,14 @@

   // Cannot use byte-stream input and NAL input at the same time.
   assert(pending_input_NAL == NULL);
+
+  // A NAL unit must at least contain its two-byte header. Reject anything shorter
+  // (including a negative length) before touching any state: a zero-length unit
+  // would otherwise end up as a memcpy() with a NULL destination and, once queued,
+  // would fail header parsing in decode_NAL() and abort decoding of the stream.
+  if (len < 2) {
+    return DE265_ERROR_INVALID_ARGUMENT;
+  }

   end_of_frame = false;
