+/*
+ * CVE-2026-11856 regression test (backport of upstream test 1686 to the
+ * curl 8.14.1 libtest framework).
+ *
+ * Verifies that a Digest Authorization: header computed against host A
+ * (first.test) is NOT replayed against host B (second.test), and that
+ * switching credentials on the same host also flushes the cached
+ * Digest state.
+ */
+#include "test.h"
+
+#include "memdebug.h"
+
+static size_t devnull_1686(char *p, size_t s, size_t n, void *u)
+{
+  (void)p;
+  (void)u;
+  return s * n;
+}
+
+#define FIRSTHOST "first.test"
+#define SECONDHOST "second.test"
+
+CURLcode test(char *URL)
+{
+  CURL *curl = NULL;
+  CURLcode res = CURLE_OK;
+  const char *hostip = URL;
+  const char *httpport = libtest_arg2;
+  char firsturl[100];
+  char secondurl[100];
+  char firstres[100];
+  char secondres[100];
+  struct curl_slist *host = NULL;
+  struct curl_slist *host2 = NULL;
+
+  if(!httpport) {
+    curl_mfprintf(stderr, "Usage: lib1686 [hostip] [httpport]\n");
+    return TEST_ERR_USAGE;
+  }
+
+  if(curl_global_init(CURL_GLOBAL_ALL) != CURLE_OK) {
+    curl_mfprintf(stderr, "curl_global_init() failed\n");
+    return TEST_ERR_MAJOR_BAD;
+  }
+
+  /* CURLOPT_RESOLVE entries: map first.test/second.test -> hostip */
+  curl_msnprintf(firstres, sizeof(firstres), "%s:%s:%s",
+                 FIRSTHOST, httpport, hostip);
+  curl_msnprintf(secondres, sizeof(secondres), "%s:%s:%s",
+                 SECONDHOST, httpport, hostip);
+
+  curl_msnprintf(firsturl, sizeof(firsturl), "http://%s:%s/api",
+                 FIRSTHOST, httpport);
+  curl_msnprintf(secondurl, sizeof(secondurl), "http://%s:%s/hook",
+                 SECONDHOST, httpport);
+
+  host = curl_slist_append(NULL, firstres);
+  if(!host)
+    goto test_cleanup;
+  host2 = curl_slist_append(host, secondres);
+  if(!host2)
+    goto test_cleanup;
+  host = host2;
+
+  curl = curl_easy_init();
+  if(curl) {
+    easy_setopt(curl, CURLOPT_RESOLVE, host);
+    easy_setopt(curl, CURLOPT_HTTPAUTH, (long)CURLAUTH_DIGEST);
+    easy_setopt(curl, CURLOPT_USERPWD, "alice:bond");
+    easy_setopt(curl, CURLOPT_WRITEFUNCTION, devnull_1686);
+
+    easy_setopt(curl, CURLOPT_URL, firsturl);
+    res = curl_easy_perform(curl);
+
+    easy_setopt(curl, CURLOPT_URL, secondurl);
+    res = curl_easy_perform(curl);
+
+    easy_setopt(curl, CURLOPT_USERPWD, "bob:secret");
+    easy_setopt(curl, CURLOPT_URL, secondurl);
+    res = curl_easy_perform(curl);
+  }
+
+test_cleanup:
+  curl_easy_cleanup(curl);
+  curl_global_cleanup();
+  curl_slist_free_all(host);
+  return res;
+}
Description: Fix CVE-2026-8458 - tie SASL/GSS-API service name to the connection
 libcurl could reuse the wrong connection for Negotiate-authenticated transfers
 even when CURLOPT_SERVICE_NAME / CURLOPT_PROXY_SERVICE_NAME differed, because the
 SASL service name was not part of the credentials tied to a connection. A
 connection authenticated for one service name could therefore be wrongly reused
 for a transfer requesting a different service name (CWE-488, Exposure of Data
 Element to Wrong Session).
 .
 This is a manual backport of upstream commit
 5e99b73cf441d9c369768b9cd48b5389b9a2503d ("creds: add sasl service name",
 released in curl 8.21.0). The upstream fix builds on the struct Curl_creds
 abstraction (lib/creds.c / lib/creds.h) which does not exist in 8.14.1; there
 the per-connection credential state lives inline in struct connectdata. This
 backport reproduces the same behavioural fix against the 8.14.1 structure: it
 stores the requested SASL service name (host and proxy) on the connection and
 makes connection reuse require the service name to match, so a connection is no
 longer reused across transfers that request different service names. The
 per-transfer service-name resolution at the auth call sites (http_negotiate.c,
 http_ntlm.c, curl_sasl.c, socks*.c, vauth/*) is already correct in 8.14.1; only
 the reuse-gating was missing, so only that gap is closed here.
Origin: upstream, commit:5e99b73cf441d9c369768b9cd48b5389b9a2503d
Author: Stefan Eissing <stefan@eissing.org>
Last-Update: 2026-07-27

