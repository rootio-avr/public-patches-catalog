--- a/lib/http_digest.c
+++ b/lib/http_digest.c
@@ -109,6 +109,47 @@
     userp = data->state.aptr.user;
     passwdp = data->state.aptr.passwd;
     authp = &data->state.authhost;
+
+    /* CVE-2026-11856: flush stored Digest state if the origin
+       (scheme://host:port) or the credentials have changed since we last
+       computed an Authorization: header on this handle. Without this, a
+       captured Digest response computed for hostA could be replayed
+       against hostB. Re-engineered backport of upstream
+       5c6b4880357ab3e72967c1c45cae0f96ffabc535 using data->conn (8.14.1
+       has no Curl_peer_* / Curl_creds_* abstraction). */
+    {
+      struct digestdata *hd = digest;
+      char *neworigin = aprintf("%s://%s:%d",
+                                data->conn->handler->scheme,
+                                data->conn->host.name,
+                                data->conn->remote_port);
+      const char *cur_user = userp ? userp : "";
+      const char *cur_passwd = passwdp ? passwdp : "";
+      bool flush = FALSE;
+
+      if(!neworigin)
+        return CURLE_OUT_OF_MEMORY;
+
+      if(hd->origin && strcmp(hd->origin, neworigin))
+        flush = TRUE;
+      else if(hd->cuser && strcmp(hd->cuser, cur_user))
+        flush = TRUE;
+      else if(hd->cpasswd && strcmp(hd->cpasswd, cur_passwd))
+        flush = TRUE;
+
+      if(flush)
+        /* flush host Digest state -- also frees origin/cuser/cpasswd */
+        Curl_auth_digest_cleanup(hd);
+
+      Curl_safefree(hd->origin);
+      hd->origin = neworigin;
+      Curl_safefree(hd->cuser);
+      hd->cuser = strdup(cur_user);
+      Curl_safefree(hd->cpasswd);
+      hd->cpasswd = strdup(cur_passwd);
+      if(!hd->cuser || !hd->cpasswd)
+        return CURLE_OUT_OF_MEMORY;
+    }
   }
 
