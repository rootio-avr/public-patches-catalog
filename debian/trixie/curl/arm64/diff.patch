+                                   struct url_conn_match *m)
+{
+#ifdef USE_SPNEGO
+  if((conn->http_negotiate_state != GSS_AUTHNONE) &&
+     !url_no_ambient_reuse(conn, m->data, conn->user))
+    return FALSE;
+#ifndef CURL_DISABLE_PROXY
+  if((conn->proxy_negotiate_state != GSS_AUTHNONE) &&
+     !url_no_ambient_reuse(conn, m->data, conn->http_proxy.user))
+    return FALSE;
+#endif
+#endif
+#ifdef USE_NTLM
+  if((conn->http_ntlm_state != NTLMSTATE_NONE) &&
+     !url_no_ambient_reuse(conn, m->data, conn->user))
+    return FALSE;
+#ifndef CURL_DISABLE_PROXY
+  if((conn->proxy_ntlm_state != NTLMSTATE_NONE) &&
+     !url_no_ambient_reuse(conn, m->data, conn->http_proxy.user))
+    return FALSE;
+#endif
+#endif
+  return TRUE;
+}
+#else
+#define url_match_auth_ambient(c,m) ((void)c, (void)m, TRUE)
+#endif
