Description: Fix CVE-2026-9079 - clear proxy auth properly on NULL
 libcurl did not honor requests to clear proxy authentication
 credentials. When CURLOPT_PROXYUSERPWD was set to NULL (or
 CURLOPT_PROXYUSERNAME / CURLOPT_PROXYPASSWORD via the userpwd parser
 returned NULL components), the previously-stored proxy username and
 password strings were left in place and leaked into subsequent
 transfers on the same easy handle.
 .
 The upstream fix moves the safefree() of STRING_PROXYUSERNAME and
 STRING_PROXYPASSWORD out of the "u != NULL" / "p != NULL" guarded
 blocks so the old credentials are unconditionally cleared once
 setstropt_userpwd() has succeeded; Curl_urldecode() is then only
 invoked when the new component is non-NULL.
 .
 This backport adapts the upstream hunk to curl 8.14.1, where the
 CURLOPT_PROXYUSERPWD case still lives inline in Curl_vsetopt() (no
 setopt_cptr_proxy() helper) and uses Curl_safefree()/free() instead
 of the curlx_safefree()/curlx_free() symbols introduced after 8.14.1.
 The upstream regression test (tests/libtest/lib1648.c +
 tests/data/test1648) is not backported because it depends on the
 newer first.h test harness and a different tests/data/Makefile.am
 layout that 8.14.1 does not have.
Origin: upstream, https://github.com/curl/curl/commit/88c7e16cceec816a2df45c899d49b1e85513f193
Author: Daniel Stenberg <daniel@haxx.se>
Last-Update: 2026-06-25
---
--- a/lib/setopt.c
+++ b/lib/setopt.c
@@ -2151,16 +2151,16 @@
     result = setstropt_userpwd(ptr, &u, &p);

     /* URL decode the components */
-    if(!result && u) {
+    if(!result) {
       Curl_safefree(data->set.str[STRING_PROXYUSERNAME]);
-      result = Curl_urldecode(u, 0, &data->set.str[STRING_PROXYUSERNAME], NULL,
-                              REJECT_ZERO);
-    }
-    if(!result && p) {
       Curl_safefree(data->set.str[STRING_PROXYPASSWORD]);
+      if(u)
+        result = Curl_urldecode(u, 0, &data->set.str[STRING_PROXYUSERNAME],
+                                NULL, REJECT_ZERO);
+    }
+    if(!result && p)
       result = Curl_urldecode(p, 0, &data->set.str[STRING_PROXYPASSWORD], NULL,
