+#include "test.h"
+
+#include "memdebug.h"
+
+/* Verify that curl_mime_free() handles deeply nested multipart structures
+   without recursing (and thus without exhausting the stack). */
+CURLcode test(char *URL)
+{
+  CURLcode res = CURLE_OK;
+  curl_mime *root = NULL;
+  curl_mime *current;
+  int i;
+
+  (void)URL;
+
+  if(curl_global_init(CURL_GLOBAL_ALL) != CURLE_OK) {
+    curl_mfprintf(stderr, "curl_global_init() failed\n");
+    return TEST_ERR_MAJOR_BAD;
+  }
+
+  root = curl_mime_init(NULL);
+  if(!root) {
+    res = TEST_ERR_MAJOR_BAD;
+    goto cleanup;
+  }
+  current = root;
+
+  for(i = 0; i < 100000; i++) {
+    curl_mimepart *part = curl_mime_addpart(current);
+    curl_mime *sub;
+    if(!part) {
+      res = TEST_ERR_MAJOR_BAD;
+      goto cleanup;
+    }
+    sub = curl_mime_init(NULL);
+    if(!sub) {
+      res = TEST_ERR_MAJOR_BAD;
+      goto cleanup;
+    }
+    if(curl_mime_subparts(part, sub)) {
+      curl_mime_free(sub);
+      res = TEST_ERR_MAJOR_BAD;
+      goto cleanup;
+    }
+    current = sub;
+  }
+
+cleanup:
+  curl_mime_free(root);
+  curl_global_cleanup();
+  return res;
+}
Description: CVE-2026-12064 - config2setopts: use default protocol properly
 The curl command-line tool skipped SSH host key verification setup when
 invoked with a schemeless URL together with --proto-default sftp (or scp).
 The tool layer inferred the scheme independently of libcurl, so libcurl
 honoured CURLOPT_DEFAULT_PROTOCOL and connected over SFTP/SCP while the
 tool never installed CURLOPT_SSH_HOST_PUBLIC_KEY_SHA256 or
 CURLOPT_SSH_KNOWNHOSTS, allowing a silent connection to an unverified
 SSH host. This patch reworks url_proto_and_rewrite() in
 src/config2setopts.c so that when --proto-default is set the tool uses
 CURLU_NO_GUESS_SCHEME and applies the configured default protocol via
 proto_token(), keeping the tool's protocol view in sync with libcurl.
 Also refreshes the --proto-default documentation and adds tests 1724,
 1725 and 2036.
Origin: upstream, https://github.com/curl/curl/commit/ab3bb8cd8be8f9d4acb97da0418abc279182041e
Author: Daniel Stenberg <daniel@haxx.se>
Bug: https://curl.se/docs/CVE-2026-12064.html
Last-Update: 2026-07-08
---
--- a/docs/cmdline-opts/proto-default.md
+++ b/docs/cmdline-opts/proto-default.md
@@ -16,7 +16,8 @@
 
 # `--proto-default`
 
-Use *protocol* for any provided URL missing a scheme.
+Use *protocol* for any provided URL missing a scheme. The case-insensitive
+name should be given without any `://` suffix.
 
 An unknown or unsupported protocol causes error *CURLE_UNSUPPORTED_PROTOCOL*.
 
@@ -24,3 +25,6 @@
 
 Without this option set, curl guesses protocol based on the hostname, see
 --url for details.
+
+The default protocol cannot be set to `ipfs` or `ipns`. Those schemes need to
+be used explicitly in the URL.
--- a/src/config2setopts.c
+++ b/src/config2setopts.c
@@ -138,15 +138,31 @@
