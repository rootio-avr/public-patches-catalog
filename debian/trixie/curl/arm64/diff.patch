--- a/src/tool_cb_hdr.c
+++ b/src/tool_cb_hdr.c
@@ -79,6 +79,28 @@
   return rc;
 }
 
+/* Store a header until the output filename has been decided. Since the header
+   is not null-terminated, we need an extra dance. */
+static size_t buffer_header(struct HdrCbData *hdrcbdata,
+                            const char *str, size_t cb)
+{
+  char *clone = aprintf("%.*s", (int)cb, str);
+  if(clone) {
+    struct curl_slist *old = hdrcbdata->headlist;
+    hdrcbdata->headlist = curl_slist_append(old, clone);
+    free(clone);
+    if(!hdrcbdata->headlist) {
+      curl_slist_free_all(old);
+      return CURL_WRITEFUNC_ERROR;
+    }
+  }
+  else {
+    curl_slist_free_all(hdrcbdata->headlist);
+    hdrcbdata->headlist = NULL;
+    return CURL_WRITEFUNC_ERROR;
+  }
+  return cb;
+}
 
