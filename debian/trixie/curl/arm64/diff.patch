Description: CVE-2026-92391 - mime: do curl_mime_free() non-recursively
 curl_mime_free() recursed through nested multipart mime structures, so a
 deeply nested structure (for example built via curl_mime_subparts()) could
 exhaust the stack and crash the application. Free the nested structure
 iteratively instead. Adds libtest 3595 as a regression test.
Origin: upstream, https://github.com/curl/curl/commit/d7546809d5bd548b69ec49fca26565c8f6f0d344
Author: Daniel Stenberg <daniel@haxx.se>
Last-Update: 2026-11-01
---
--- a/lib/mime.c
+++ b/lib/mime.c
@@ -1179,20 +1179,36 @@
   }
 }
 
-/* Recursively delete a mime handle and its parts. */
+/* Non-recursively delete a mime handle and its parts. */
 void curl_mime_free(curl_mime *mime)
 {
   curl_mimepart *part;
 
-  if(mime) {
-    mime_subparts_unbind(mime);  /* Be sure it is not referenced anymore. */
-    while(mime->firstpart) {
-      part = mime->firstpart;
+  if(!mime)
+    return;
+
+  mime_subparts_unbind(mime);  /* Be sure it is not referenced anymore. */
+
+  while(mime) {
+    part = mime->firstpart;
+    if(part) {
       mime->firstpart = part->nextpart;
+      if(part->kind == MIMEKIND_MULTIPART && part->arg &&
+         part->freefunc == mime_subparts_free) {
+        curl_mime *subparts = (curl_mime *)part->arg;
+        part->freefunc = NULL;
+        cleanup_part_content(part);
+        subparts->parent = mime->parent;
+        mime->parent = (curl_mimepart *)subparts;
+      }
       Curl_mime_cleanpart(part);
       free(part);
     }
-    free(mime);
+    else {
+      curl_mime *parent = (curl_mime *)mime->parent;
+      free(mime);
+      mime = parent;
+    }
   }
 }
 
