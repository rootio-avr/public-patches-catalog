   curlx_dyn_free(&token);
+  /*
+   * CVE-2026-8926: if a specific login was requested but never matched
+   * any of the machine blocks we traversed, do not report success.
+   * Otherwise a password collected from the last matched machine block
+   * (which is stored eagerly by the state machine before it knows
+   * whether the login will ever match) would leak to the caller as if
+   * it belonged to the requested login.
+   */
+  if(!retcode && specific_login && !our_login)
+    retcode = NETRC_NO_MATCH;
+
