+ * SPDX-License-Identifier: curl
+ *
+ ***************************************************************************/
+/*
+ * CVE-2026-11856 regression test (backport of upstream test 1686 to the
+ * curl 8.14.1 libtest framework).
+ *
+ * Verifies that a Digest Authorization: header computed against host A
+ * (first.test) is NOT replayed against host B (second.test), and that
+ * switching credentials on the same host also flushes the cached
+ * Digest state.
+ */
+#include "test.h"
+
+#include "memdebug.h"
+
+static size_t devnull_1686(char *p, size_t s, size_t n, void *u)
+{
+  (void)p;
+  (void)u;
+  return s * n;
+}
+
+#define FIRSTHOST "first.test"
+#define SECONDHOST "second.test"
+
+CURLcode test(char *URL)
+{
+  CURL *curl = NULL;
+  CURLcode res = CURLE_OK;
+  const char *hostip = URL;
+  const char *httpport = libtest_arg2;
+  char firsturl[100];
+  char secondurl[100];
+  char firstres[100];
+  char secondres[100];
+  struct curl_slist *host = NULL;
+  struct curl_slist *host2 = NULL;
+
+  if(!httpport) {
+    curl_mfprintf(stderr, "Usage: lib1686 [hostip] [httpport]\n");
+    return TEST_ERR_USAGE;
+  }
+
+  if(curl_global_init(CURL_GLOBAL_ALL) != CURLE_OK) {
+    curl_mfprintf(stderr, "curl_global_init() failed\n");
+    return TEST_ERR_MAJOR_BAD;
+  }
+
+  /* CURLOPT_RESOLVE entries: map first.test/second.test -> hostip */
+  curl_msnprintf(firstres, sizeof(firstres), "%s:%s:%s",
+                 FIRSTHOST, httpport, hostip);
+  curl_msnprintf(secondres, sizeof(secondres), "%s:%s:%s",
+                 SECONDHOST, httpport, hostip);
+
+  curl_msnprintf(firsturl, sizeof(firsturl), "http://%s:%s/api",
+                 FIRSTHOST, httpport);
+  curl_msnprintf(secondurl, sizeof(secondurl), "http://%s:%s/hook",
+                 SECONDHOST, httpport);
+
+  host = curl_slist_append(NULL, firstres);
+  if(!host)
+    goto test_cleanup;
+  host2 = curl_slist_append(host, secondres);
+  if(!host2)
+    goto test_cleanup;
+  host = host2;
+
+  curl = curl_easy_init();
+  if(curl) {
+    easy_setopt(curl, CURLOPT_RESOLVE, host);
+    easy_setopt(curl, CURLOPT_HTTPAUTH, (long)CURLAUTH_DIGEST);
+    easy_setopt(curl, CURLOPT_USERPWD, "alice:bond");
+    easy_setopt(curl, CURLOPT_WRITEFUNCTION, devnull_1686);
+
+    easy_setopt(curl, CURLOPT_URL, firsturl);
+    res = curl_easy_perform(curl);
+
+    easy_setopt(curl, CURLOPT_URL, secondurl);
+    res = curl_easy_perform(curl);
+
+    easy_setopt(curl, CURLOPT_USERPWD, "bob:secret");
+    easy_setopt(curl, CURLOPT_URL, secondurl);
+    res = curl_easy_perform(curl);
+  }
+
+test_cleanup:
+  curl_easy_cleanup(curl);
+  curl_global_cleanup();
+  curl_slist_free_all(host);
+  return res;
+}
Description: CVE-2026-18924 - http2: make server push transfers inherit share from parent
 A coding error in libcurl's handling of HTTP/2 Server Push streams causes a
 use-after-free. curl_easy_duphandle(), used to clone the parent easy handle
 for a pushed transfer, does not copy the parent's share object. When the
 parent handle is set to share connections with other handles
 (CURL_LOCK_DATA_CONNECT) and the application uses CURLMOPT_PUSHFUNCTION to
 accept a server push over HTTP/2, the pushed transfer's handle does not
 inherit the parent's share. During transfer cleanup this leads to a
 use-after-free (CWE-416).
 .
 The upstream fix calls the helper Curl_share_easy_link() (added by a later
 refactor together with lib/curl_share.{c,h}), which does not exist in this
 8.14.1 tree. This backport re-expresses the same effect inline in
 h2_duphandle() using the target's own share API, mirroring the existing
 CURLOPT_SHARE handling in lib/setopt.c: attach the duplicated handle to the
 parent's share, bump the share dirty counter under the share lock, and adopt
 the shared cookie, HSTS and PSL objects.
 .
 Only libcurl is affected; the curl command-line tool is not exposed.
Origin: backport, https://github.com/curl/curl/commit/90325ff0444cbdff368bda5d26d6405a0bb6ee43
Bug: https://curl.se/docs/CVE-2026-18924.html
Author: Daniel Stenberg <daniel@haxx.se>
Last-Update: 2026-09-09
---
--- a/lib/http2.c
+++ b/lib/http2.c
@@ -48,6 +48,8 @@
 #include "transfer.h"
 #include "curlx/dynbuf.h"
 #include "headers.h"
+#include "share.h"
+#include "hsts.h"
 /* The last 3 #include files should be in this order */
 #include "curl_printf.h"
 #include "curl_memory.h"
@@ -911,6 +913,41 @@ static struct Curl_easy *h2_duphandle(struct Curl_cfilter *cf,
     struct h2_stream_ctx *second_stream;
     http2_data_setup(cf, second, &second_stream);
     second->state.priority.weight = data->state.priority.weight;
+
+    /* CVE-2026-18924: curl_easy_duphandle() does not copy the share object,
+       so a server-pushed transfer would not inherit the parent's share. When
+       the parent shares connections (CURL_LOCK_DATA_CONNECT), the pushed
+       handle would then reference freed shared data during cleanup
+       (use-after-free). Link the duplicated handle to the parent's share here,
+       mirroring the CURLOPT_SHARE logic in lib/setopt.c. */
+    if(data->share && GOOD_SHARE_HANDLE(data->share)) {
+      second->share = data->share;
+
+      Curl_share_lock(second, CURL_LOCK_DATA_SHARE, CURL_LOCK_ACCESS_SINGLE);
+
+      second->share->dirty++;
+
+#if !defined(CURL_DISABLE_HTTP) && !defined(CURL_DISABLE_COOKIES)
+      if(second->share->cookies) {
+        /* use shared cookie list, first free own one if any */
+        Curl_cookie_cleanup(second->cookies);
+        second->cookies = second->share->cookies;
+      }
+#endif
+#ifndef CURL_DISABLE_HSTS
+      if(second->share->hsts) {
+        /* first free the private one if any */
+        Curl_hsts_cleanup(&second->hsts);
+        second->hsts = second->share->hsts;
+      }
+#endif
+#ifdef USE_LIBPSL
+      if(second->share->specifier & (1 << CURL_LOCK_DATA_PSL))
+        second->psl = &second->share->psl;
+#endif
+
+      Curl_share_unlock(second, CURL_LOCK_DATA_SHARE);
+    }
   }
   return second;
 }
