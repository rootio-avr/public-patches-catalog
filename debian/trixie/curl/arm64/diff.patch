 #endif
 
+#if defined(USE_SPNEGO) || defined(USE_NTLM)
+/* To avoid leaking one user's authenticated session to another
+ * (CVE-2026-19931), do not reuse a connection whose Negotiate/NTLM
+ * handshake was performed with an empty (ambient) username, unless it is
+ * the exact connection this transfer used before. The ambient identity
+ * (SSPI SecurityToken on Windows, GSSAPI credential cache elsewhere) can be
+ * switched outside libcurl's knowledge between requests. We are therefore
+ * not able to find out reliably which identity the connection really used,
+ * nor which the next request would use, so such a connection must not be
+ * handed to a different transfer (TOCTOU). */
+static bool url_no_ambient_reuse(struct connectdata *conn,
+                                 struct Curl_easy *data,
+                                 const char *user)
+{
+  return (user && user[0]) ||
+         (data->state.lastconnect_id == conn->connection_id);
