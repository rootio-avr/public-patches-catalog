Description: CVE-2026-13757 - Fix recursion depth in RPC attribute parsing
 A flaw in p11-kit: p11_rpc_message_get_attribute() and
 p11_rpc_message_get_attribute_array_value() form a mutually-recursive
 call chain lacking any recursion depth limit when handling nested
 CKA_WRAP_TEMPLATE, CKA_UNWRAP_TEMPLATE, and CKA_DERIVE_TEMPLATE
 attributes. proto_read_attribute_buffer_array() in rpc-server.c has the
 same issue for IS_ATTRIBUTE_ARRAY types. A local unauthenticated
 attacker with access to the p11-kit RPC Unix domain socket can send a
 crafted C_CreateObject request with deeply nested templates to cause
 stack exhaustion and crash the p11-kit server (SIGSEGV/SIGBUS) along
 with dependent services.
 .
 This patch introduces MAX_RECURSION_DEPTH=8 in both rpc-message.c and
 rpc-server.c, threads a size_t depth parameter through the attribute
 decoders, wraps p11_rpc_message_get_attribute() with a static recursive
 helper, and rejects requests that exceed the limit. It also adds
 test_attribute_recursion_limit in test-rpc-message.c to exercise the
 new guard.
Origin: upstream, https://github.com/p11-glue/p11-kit/commit/4b5eb61213e8dbe3232e7cb4668834126405e9a2
Author: Zoltan Fridrich <zfridric@redhat.com>
Last-Update: 2026-07-03
---
--- a/p11-kit/rpc-message.c
+++ b/p11-kit/rpc-message.c
@@ -56,6 +56,8 @@

 #define ELEMS(x) (sizeof (x) / sizeof (x[0]))

+#define MAX_RECURSION_DEPTH 8
+
 void
 p11_rpc_message_init (p11_rpc_message *msg,
                       p11_buffer *input,
@@ -930,7 +932,8 @@ p11_rpc_message_get_byte_value (p11_rpc_message *msg,
 			        p11_buffer *buffer,
 			        size_t *offset,
 			        void *value,
-			        CK_ULONG *value_length)
+			        CK_ULONG *value_length,
+			        size_t depth)
 {
 	return p11_rpc_buffer_get_byte_value (buffer, offset, value, value_length);
 }
@@ -940,21 +943,33 @@ p11_rpc_message_get_ulong_value (p11_rpc_message *msg,
 			         p11_buffer *buffer,
 			         size_t *offset,
 			         void *value,
-			         CK_ULONG *value_length)
+			         CK_ULONG *value_length,
+			         size_t depth)
 {
 	return p11_rpc_buffer_get_ulong_value (buffer, offset, value, value_length);
 }

+static bool
+p11_rpc_message_get_attribute_recursive (p11_rpc_message *msg,
+					 p11_buffer *buffer,
+					 size_t *offset,
+					 CK_ATTRIBUTE *attr,
+					 size_t depth);
+
 static bool
 p11_rpc_message_get_attribute_array_value (p11_rpc_message *msg,
 					   p11_buffer *buffer,
 					   size_t *offset,
 					   void *value,
-					   CK_ULONG *value_length)
+					   CK_ULONG *value_length,
+					   size_t depth)
 {
 	uint32_t count, i;
 	CK_ATTRIBUTE *attr = value;

+	if (depth >= MAX_RECURSION_DEPTH)
+		return false;
+
 	if (!p11_rpc_buffer_get_uint32 (buffer, offset, &count))
 		return false;

@@ -965,7 +980,8 @@ p11_rpc_message_get_attribute_array_value (p11_rpc_message *msg,
 		return true;

 	for (i = 0; i < count; ++i)
-		if (!p11_rpc_message_get_attribute (msg, buffer, offset, attr + i))
+		if (!p11_rpc_message_get_attribute_recursive (msg, buffer, offset,
+							      attr + i, depth + 1))
 			return false;

 	return true;
@@ -976,7 +992,8 @@ p11_rpc_message_get_mechanism_type_array_value (p11_rpc_message *msg,
 					        p11_buffer *buffer,
 					        size_t *offset,
 					        void *value,
-					        CK_ULONG *value_length)
+					        CK_ULONG *value_length,
+					        size_t depth)
 {
 	return p11_rpc_buffer_get_mechanism_type_array_value (buffer, offset, value, value_length);
 }
@@ -986,7 +1003,8 @@ p11_rpc_message_get_date_value (p11_rpc_message *msg,
 			        p11_buffer *buffer,
 			        size_t *offset,
 			        void *value,
-			        CK_ULONG *value_length)
+			        CK_ULONG *value_length,
+			        size_t depth)
 {
 	return p11_rpc_buffer_get_date_value (buffer, offset, value, value_length);
 }
@@ -996,7 +1014,8 @@ p11_rpc_message_get_byte_array_value (p11_rpc_message *msg,
 				      p11_buffer *buffer,
 				      size_t *offset,
 				      void *value,
-				      CK_ULONG *value_length)
+				      CK_ULONG *value_length,
+				      size_t depth)
 {
 	return p11_rpc_buffer_get_byte_array_value (buffer, offset, value, value_length);
 }
@@ -1004,7 +1023,7 @@ p11_rpc_message_get_byte_array_value (p11_rpc_message *msg,
 typedef struct {
 	p11_rpc_value_type type;
 	p11_rpc_value_encoder encode;
-	p11_rpc_message_decoder decode;
+	p11_rpc_message_decoder_recursive decode;
 } p11_rpc_attribute_serializer;

 static p11_rpc_attribute_serializer p11_rpc_attribute_serializers[] = {
@@ -1248,7 +1267,7 @@ p11_rpc_buffer_get_attribute_array_value (p11_buffer *buffer,
 					  void *value,
 					  CK_ULONG *value_length)
 {
-	return p11_rpc_message_get_attribute_array_value (NULL, buffer, offset, value, value_length);
+	return p11_rpc_message_get_attribute_array_value (NULL, buffer, offset, value, value_length, 0);
 }

 bool
@@ -1333,11 +1352,12 @@ p11_rpc_buffer_get_byte_array_value (p11_buffer *buffer,
 	return true;
 }

-bool
-p11_rpc_message_get_attribute (p11_rpc_message *msg,
-			       p11_buffer *buffer,
-			       size_t *offset,
-			       CK_ATTRIBUTE *attr)
+static bool
+p11_rpc_message_get_attribute_recursive (p11_rpc_message *msg,
+					 p11_buffer *buffer,
+					 size_t *offset,
+					 CK_ATTRIBUTE *attr,
+					 size_t depth)
 {
 	uint32_t type, length;
 	CK_ULONG decode_length;
@@ -1380,7 +1400,7 @@ p11_rpc_message_get_attribute (p11_rpc_message *msg,

 	/* Get the attribute value length */
 	saved_offset = *offset;
-	if (!serializer->decode (NULL, buffer, offset, NULL, &decode_length))
+	if (!serializer->decode (NULL, buffer, offset, NULL, &decode_length, depth))
 		return false;

 	/* Decode the attribute value */
@@ -1389,7 +1409,7 @@ p11_rpc_message_get_attribute (p11_rpc_message *msg,
 			return false;

 		*offset = saved_offset;
-		if (!serializer->decode (msg, buffer, offset, attr->pValue, NULL))
+		if (!serializer->decode (msg, buffer, offset, attr->pValue, NULL, depth))
 			return false;
 	}

@@ -1398,6 +1418,15 @@ p11_rpc_message_get_attribute (p11_rpc_message *msg,
 	return true;
 }

+bool
+p11_rpc_message_get_attribute (p11_rpc_message *msg,
+			       p11_buffer *buffer,
+			       size_t *offset,
+			       CK_ATTRIBUTE *attr)
+{
+	return p11_rpc_message_get_attribute_recursive (msg, buffer, offset, attr, 0);
+}
+
 bool
 p11_rpc_buffer_get_attribute (p11_buffer *buffer,
 			      size_t *offset,
--- a/p11-kit/rpc-message.h
+++ b/p11-kit/rpc-message.h
@@ -298,6 +298,7 @@ typedef struct {
 typedef void (*p11_rpc_value_encoder) (p11_buffer *, const void *, CK_ULONG);
 typedef bool (*p11_rpc_value_decoder) (p11_buffer *, size_t *, void *, CK_ULONG *);
 typedef bool (*p11_rpc_message_decoder) (p11_rpc_message *msg, p11_buffer *, size_t *, void *, CK_ULONG *);
+typedef bool (*p11_rpc_message_decoder_recursive) (p11_rpc_message *msg, p11_buffer *, size_t *, void *, CK_ULONG *, size_t);

 void             p11_rpc_message_init                    (p11_rpc_message *msg,
                                                           p11_buffer *input,
--- a/p11-kit/rpc-server.c
+++ b/p11-kit/rpc-server.c
@@ -71,6 +71,8 @@
 #define PARSE_ERROR CKR_DEVICE_ERROR
 #define PREP_ERROR  CKR_DEVICE_MEMORY

+#define MAX_RECURSION_DEPTH 8
+
 typedef struct {
 	p11_virtual virt;
 	uint8_t version;
@@ -250,7 +252,8 @@ proto_write_ulong_array (p11_rpc_message *msg,
 static CK_RV
 proto_read_attribute_buffer_array (p11_rpc_message *msg,
 				   CK_ATTRIBUTE_PTR *result,
-				   CK_ULONG *n_result)
+				   CK_ULONG *n_result,
+				   size_t depth)
 {
 	CK_RV rv;
 	CK_ATTRIBUTE_PTR attrs, array;
@@ -258,6 +261,9 @@ proto_read_attribute_buffer_array (p11_rpc_message *msg,
 	uint32_t n_attrs, i;
 	uint32_t type, length;

+	if (depth >= MAX_RECURSION_DEPTH)
+		return PARSE_ERROR;
+
 	/* Read the number of attributes */
 	if (!p11_rpc_buffer_get_uint32 (msg->input, &msg->parsed, &n_attrs))
 		return PARSE_ERROR;
@@ -284,7 +290,7 @@ proto_read_attribute_buffer_array (p11_rpc_message *msg,
 			attrs[i].pValue = NULL;
 			attrs[i].ulValueLen = 0;
 		} else if (IS_ATTRIBUTE_ARRAY (attrs + i)) {
-			rv = proto_read_attribute_buffer_array (msg, &array, &n_array);
+			rv = proto_read_attribute_buffer_array (msg, &array, &n_array, depth + 1);
 			if (rv != CKR_OK)
 				return rv;
 			if ((n_array != 0 && ULONG_MAX / n_array < sizeof (CK_ATTRIBUTE)) ||
@@ -318,7 +324,7 @@ proto_read_attribute_buffer (p11_rpc_message *msg,
 	/* Make sure this is in the right order */
 	assert (!msg->signature || p11_rpc_message_verify_part (msg, "fA"));

-	return proto_read_attribute_buffer_array (msg, result, n_result);
+	return proto_read_attribute_buffer_array (msg, result, n_result, 0);
 }

 static CK_RV
--- a/p11-kit/test-rpc-message.c
+++ b/p11-kit/test-rpc-message.c
@@ -806,6 +806,44 @@ test_message_write (void)
 	p11_buffer_uninit (&buffer);
 }

+static void
+test_attribute_recursion_limit (void)
+{
+	bool ret;
+	p11_rpc_message msg;
+	p11_buffer buffer;
+	size_t offset = 0;
+	CK_BBOOL truev = CK_TRUE;
+	CK_ATTRIBUTE attr9 = { CKA_ENCRYPT, &truev, sizeof (CK_BBOOL) };
+	CK_ATTRIBUTE attr8 = { CKA_WRAP_TEMPLATE, &attr9, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr7 = { CKA_WRAP_TEMPLATE, &attr8, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr6 = { CKA_WRAP_TEMPLATE, &attr7, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr5 = { CKA_WRAP_TEMPLATE, &attr6, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr4 = { CKA_WRAP_TEMPLATE, &attr5, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr3 = { CKA_WRAP_TEMPLATE, &attr4, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr2 = { CKA_WRAP_TEMPLATE, &attr3, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attr1 = { CKA_WRAP_TEMPLATE, &attr2, sizeof (CK_ATTRIBUTE) };
+	CK_ATTRIBUTE attrs_in[] = {{ CKA_WRAP_TEMPLATE, &attr1, sizeof (CK_ATTRIBUTE) }};
+	CK_ATTRIBUTE attrs_out;
+
+	ret = p11_buffer_init (&buffer, 0);
+	assert_num_eq (true, ret);
+	p11_rpc_message_init (&msg, &buffer, &buffer);
+	ret = p11_rpc_message_write_attribute_array (&msg, attrs_in, ELEMS(attrs_in));
+	assert_num_eq (true, ret);
+
+	/* Skip the array count */
+	ret = p11_rpc_buffer_get_uint32(&buffer, &offset, NULL);
+	assert_num_eq (true, ret);
+
+	/* Hits recursion limit */
+	ret = p11_rpc_message_get_attribute(&msg, &buffer, &offset, &attrs_out);
+	assert_num_eq (false, ret);
+
+	p11_rpc_message_clear (&msg);
+	p11_buffer_uninit (&buffer);
+}
+
 #include "test-mock.c"

 static CK_MECHANISM_TYPE mechanisms[] = {
@@ -848,6 +886,7 @@ main (int argc,
 	p11_test (test_byte_array_value, "/rpc-message/byte-array-value");
 	p11_test (test_mechanism_value, "/rpc-message/mechanism-value");
 	p11_test (test_message_write, "/rpc-message/message-write");
+	p11_test (test_attribute_recursion_limit, "/rpc-message/attribute-recursion-limit");

 	test_mock_add_tests ("/rpc-message", NULL);

