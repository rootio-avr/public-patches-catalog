Description: CVE-2026-40691 - Packet of death for DNSCrypt over TCP
 A crafted DNSCrypt query received over TCP could cause unbound to write
 the encrypted reply past the end of the dnscrypt reply buffer, leading to
 a buffer overflow (packet of death / denial of service).
 .
 The fix bounds-checks the reply length against the buffer capacity in
 dnscrypt_server_curve() before curving, clamps max_len to the buffer
 capacity and to 65535, and correctly flips the buffer before setting its
 limit. For TCP DNSCrypt replies the EDNS udp_size is limited to the
 dnscrypt buffer capacity minus the reply header instead of 65535, and
 dnsc_handle_uncurved_request() now takes the source buffer explicitly so
 the correct (TCP spool) buffer is curved.
 .
 The two upstream worker.c hunks that add sldns_buffer_copy() to the
 FORMERR/SERVFAIL query_error paths, and the upstream testdata/*.test
 changes, are not applicable to this version: this version drops the reply
 (comm_point_drop_reply/return 0) on those cleartext-over-dnscrypt paths
 rather than returning a query_error, so those code paths and the SERVFAIL
 test expectations do not exist here.
Origin: upstream, https://github.com/NLnetLabs/unbound/commit/f54e0791ba4488284d9f6059014640a3d0bd30da
Author: W.C.A. Wijngaards <wouter@nlnetlabs.nl>
Last-Update: 2026-07-28
---
--- a/dnscrypt/dnscrypt.c
+++ b/dnscrypt/dnscrypt.c
@@ -474,10 +474,18 @@ dnscrypt_server_curve(const dnsccert *ce
     uint8_t *const buf = sldns_buffer_begin(buffer);
     size_t len = sldns_buffer_limit(buffer);

+    if(len + DNSCRYPT_REPLY_HEADER_SIZE > sldns_buffer_capacity(buffer))
+	return -1;
+    sldns_buffer_clear(buffer);
+
     if(udp){
         if (max_len > max_reply_size)
             max_len = max_reply_size;
     }
+    if(max_len > sldns_buffer_capacity(buffer))
+	max_len = sldns_buffer_capacity(buffer);
+    if(max_len > 65535)
+	    max_len = 65535;


     memcpy(nonce, client_nonce, crypto_box_HALF_NONCEBYTES);
@@ -520,6 +528,7 @@ dnscrypt_server_curve(const dnsccert *ce
                           DNSCRYPT_MAGIC_HEADER_LEN,
                           nonce,
                           crypto_box_NONCEBYTES);
+    sldns_buffer_flip(buffer);
     sldns_buffer_set_limit(buffer, len + DNSCRYPT_REPLY_HEADER_SIZE);
     return 0;
 }
@@ -912,12 +921,13 @@ dnsc_handle_curved_request(struct dnsc_e
 }

 int
-dnsc_handle_uncurved_request(struct comm_reply *repinfo)
+dnsc_handle_uncurved_request(struct comm_reply *repinfo,
+	struct sldns_buffer* buffer)
 {
     if(!repinfo->c->dnscrypt) {
         return 1;
     }
-    sldns_buffer_copy(repinfo->c->dnscrypt_buffer, repinfo->c->buffer);
+    sldns_buffer_copy(repinfo->c->dnscrypt_buffer, buffer);
     if(!repinfo->is_dnscrypted) {
         return 1;
     }
