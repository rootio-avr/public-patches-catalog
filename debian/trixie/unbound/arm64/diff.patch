Description: CVE-2026-44621 - Fix libunbound abrupt termination with 'unwanted-reply-threshold'
 Libunbound applications configured with 'unwanted-reply-threshold' could
 eventually be abruptly terminated. When the unwanted-reply-threshold was
 reached, libunbound calls the alloc id cleanup callback via a function
 pointer. That function pointer (libworker_alloc_cleanup) was not present
 in the function-pointer whitelist (fptr_whitelist_alloc_cleanup), causing
 the fptr assertion to fail and the application to abort. This patch adds
 the missing libworker_alloc_cleanup stubs to the non-libunbound worker
 callback translation units and whitelists the function pointer so the
 cleanup callback is accepted.
Origin: upstream, https://github.com/NLnetLabs/unbound/commit/f52a9e864bfa0f10d8816b64130586b1d224c474
Author: W.C.A. Wijngaards <wouter@nlnetlabs.nl>
Last-Update: 2026-07-28
---
--- a/daemon/worker.c
+++ b/daemon/worker.c
@@ -2477,6 +2477,11 @@ void libworker_event_done_cb(void* ATTR_
 	log_assert(0);
 }

+void libworker_alloc_cleanup(void* ATTR_UNUSED(arg))
+{
+	log_assert(0);
+}
+
 int context_query_cmp(const void* ATTR_UNUSED(a), const void* ATTR_UNUSED(b))
 {
 	log_assert(0);
--- a/dnstap/unbound-dnstap-socket.c
+++ b/dnstap/unbound-dnstap-socket.c
@@ -1724,6 +1724,11 @@ void libworker_event_done_cb(void* ATTR_
 	log_assert(0);
 }

+void libworker_alloc_cleanup(void* ATTR_UNUSED(arg))
+{
+	log_assert(0);
+}
+
 int context_query_cmp(const void* ATTR_UNUSED(a), const void* ATTR_UNUSED(b))
 {
 	log_assert(0);
--- a/smallapp/worker_cb.c
+++ b/smallapp/worker_cb.c
@@ -128,6 +128,12 @@ worker_alloc_cleanup(void* ATTR_UNUSED(a
 	log_assert(0);
 }

+void
+libworker_alloc_cleanup(void* ATTR_UNUSED(arg))
+{
+	log_assert(0);
+}
+
 struct outbound_entry* libworker_send_query(
 	struct query_info* ATTR_UNUSED(qinfo), uint16_t ATTR_UNUSED(flags),
 	int ATTR_UNUSED(dnssec), int ATTR_UNUSED(want_dnssec),
--- a/testcode/doqclient.c
+++ b/testcode/doqclient.c
@@ -2622,6 +2622,11 @@ void libworker_event_done_cb(void* ATTR_
 	log_assert(0);
 }

+void libworker_alloc_cleanup(void* ATTR_UNUSED(arg))
+{
+	log_assert(0);
+}
+
