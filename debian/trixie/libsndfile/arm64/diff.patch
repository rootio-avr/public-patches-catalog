Description: CVE-2026-88372 - mat4: reject negative channel counts and size the payload safely
 mat4_read_header() takes the channel count (rows) and frame count (cols)
 straight from the file header and uses them to compare the header against the
 file length. The channel count was only checked for zero and for exceeding
 SF_MAX_CHANNELS, so a negative value read from the 32 bit header field passed
 both checks. With channels and frames both coming from 32 bit fields, the
 product psf->sf.channels * psf->sf.frames * psf->bytewidth could exceed the
 range of sf_count_t, triggering a signed integer overflow
 (UBSan: "signed integer overflow: N * 8 cannot be represented in type long")
 in src/mat4.c.
 .
 Reject a negative channel count the same way the other format handlers do
 (SFE_CHANNEL_COUNT_BAD), and compute the expected payload size once into an
 sf_count_t so the truncation comparison and the dataend calculation cannot
 disagree. With the channel count limited to [1, SF_MAX_CHANNELS] the
 multiplication is bounded by 1024 * 2^31 * 8 and cannot overflow.
Origin: upstream, https://github.com/libsndfile/libsndfile/commit/c45de8ed8b1d98ca532e94a00dbfb0e49eb9bb8a
Bug: https://github.com/libsndfile/libsndfile/issues/1151
Author: iceray-Li <108821718+iceray00@users.noreply.github.com>
Last-Update: 2026-09-27
---
--- a/src/mat4.c
+++ b/src/mat4.c
@@ -206,6 +206,7 @@
 {	char	buffer [256] ;
 	uint32_t marker, namesize ;
 	int		rows, cols, imag ;
+	sf_count_t	datasize ;
 	double	value ;
 	const char *marker_str ;
 	char	name [64] ;
@@ -276,6 +277,10 @@
 	{	psf_log_printf (psf, "*** Error : zero channel count.\n") ;
 		return SFE_CHANNEL_COUNT_ZERO ;
 		}
+	else if (rows < 0)
+	{	psf_log_printf (psf, "*** Error : negative channel count %d.\n", rows) ;
+		return SFE_CHANNEL_COUNT_BAD ;
+		}
 	else if (rows > SF_MAX_CHANNELS)
 	{	psf_log_printf (psf, "*** Error : channel count %d > SF_MAX_CHANNELS.\n", rows) ;
 		return SFE_CHANNEL_COUNT ;
@@ -315,12 +320,17 @@
 				return SFE_UNIMPLEMENTED ;
 		} ;
 
-	if ((psf->filelength - psf->dataoffset) < psf->sf.channels * psf->sf.frames * psf->bytewidth)
+	/* rows and cols are 32 bit values taken from the file. Now that rows has
+	** been checked to be in the range [1, SF_MAX_CHANNELS] the product cannot
+	** overflow sf_count_t. */
+	datasize = (sf_count_t) rows * (sf_count_t) cols * psf->bytewidth ;
+
+	if ((psf->filelength - psf->dataoffset) < datasize)
 	{	psf_log_printf (psf, "*** File seems to be truncated. %D <--> %D\n",
-				psf->filelength - psf->dataoffset, psf->sf.channels * psf->sf.frames * psf->bytewidth) ;
+				psf->filelength - psf->dataoffset, datasize) ;
 		}
-	else if ((psf->filelength - psf->dataoffset) > psf->sf.channels * psf->sf.frames * psf->bytewidth)
-		psf->dataend = psf->dataoffset + (sf_count_t) rows * (sf_count_t) cols * psf->bytewidth ;
+	else if ((psf->filelength - psf->dataoffset) > datasize)
+		psf->dataend = psf->dataoffset + datasize ;
 
 	psf->datalength = psf->filelength - psf->dataoffset - psf->dataend ;
 
Description: CVE-2026-37555 - Fix integer overflow in WAV IMA-ADPCM paths
 Commit 9a82911 cast samplesperblock to sf_count_t in the AIFF branch but
 not in the adjacent WAV branch or in ima_close. Both sites still compute
 int*int before assignment to psf->sf.frames and overflow on attacker-
 controlled WAV header values, leading to heap buffer overflow during decode.
 Apply the same cast to the WAV and close paths.
Origin: upstream, https://github.com/libsndfile/libsndfile/commit/cdadf9a65fdc1f28da9d235eb443d5f5e57010d2
Author: Lukas Johannes Moeller <git@johannes-moeller.dev>
Last-Update: 2026-06-30
---
--- a/src/ima_adpcm.c
+++ b/src/ima_adpcm.c
@@ -164,7 +164,7 @@ ima_close (SF_PRIVATE *psf)
 		if (pima->samplecount && pima->samplecount < pima->samplesperblock)
 			pima->encode_block (psf, pima) ;
 
-		psf->sf.frames = pima->samplesperblock * pima->blockcount / psf->sf.channels ;
+		psf->sf.frames = (sf_count_t) pima->samplesperblock * pima->blockcount / psf->sf.channels ;
 		} ;
 
 	return 0 ;
@@ -232,7 +232,7 @@ ima_reader_init (SF_PRIVATE *psf, int blockalign, int samplesperblock)
 
 				pima->decode_block = wavlike_ima_decode_block ;
 
-				psf->sf.frames = pima->samplesperblock * pima->blocks ;
+				psf->sf.frames = (sf_count_t) pima->samplesperblock * pima->blocks ;
 				break ;
 
 		case SF_FORMAT_AIFF :
