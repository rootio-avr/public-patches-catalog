Description: CVE-2026-39919 - heap buffer overflow in the JPXDecode output adapter
 A crafted PDF with a JPEG 2000 image that has mismatched component
 subsampling and a sub-8-bit depth makes process_one_trunk() write past
 a heap row buffer sized for packed output.
 .
 Count samples in the inner loop and stop once the row width is reached,
 and reject bit depths other than 1, 2, 4, 8, and 16 in decode_image().
 Backported to Ghostscript 10.05.1: the guard is inserted before the
 rowbytes calculation. Upstream 10.08.0 uses a later bps assignment that
 is not present in this tree. The process_one_trunk() hunk matches.
Origin: upstream, https://github.com/ArtifexSoftware/ghostpdl/commit/0a8bf88e39db07b0751a58d6ec1cf992073e4dc1
Bug: https://bugs.ghostscript.com/show_bug.cgi?id=709666
Author: Ken Sharp <Ken.Sharp@artifex.com>
Last-Update: 2026-09-28

--- a/base/sjpx_openjpeg.c
+++ b/base/sjpx_openjpeg.c
@@ -490,6 +490,9 @@ static int decode_image(stream_jpxd_state * const state)
     if (state->bpp == 12)
         state->bpp = 16;
 
+    if (state->bpp != 1 && state->bpp != 2 && state->bpp != 4 && state->bpp != 8 && state->bpp != 16)
+        return ERRC;
+
     /* calculate  total data */
     rowbytes =  (state->width*state->bpp*state->out_numcomps+7)/8;
     state->totalbytes = (ulong)rowbytes*state->height;
@@ -657,13 +660,14 @@ static int process_one_trunk(stream_jpxd_state * const state, stream_cursor_write * pw)
-                for (i = 0; i < state->width; i++)
+                for (i = 0; i < state->width; )
                 {
-                    for (b=0; b<ppbyte1; b++)
+                    for (b=0; b<ppbyte1; b++, i++)
                     {
                         int dx = state->image->comps[compno].dx;
                         int dy = state->image->comps[compno].dy;
                         int w = state->image->comps[compno].w;
                         int in_offset_scaled = (y_offset/dy * w) + i / dx;
                         bt = bt<<state->bpp;
-                        bt += state->image->comps[compno].data[in_offset_scaled] + state->sign_comps[compno];
+                        if (i < state->width)
+                            bt += state->image->comps[compno].data[in_offset_scaled] + state->sign_comps[compno];
                     }
                     *row++ = bt;
                 }
